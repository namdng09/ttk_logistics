<?php

/**
 * @file
 * Ví OPS độc lập: sổ cái, số dư và lịch sử giao dịch.
 */


/**
 * Implements hook_menu().
 */
function ops_wallet_menu() {
  $items = array();

  $items['giao-dich-ops'] = array(
    'title' => 'Giao dịch OPS',
    'page callback' => 'ops_wallet_transactions_page',
    'access callback' => 'ops_wallet_transactions_page_access',
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

function ops_wallet_transactions_page_access() {
  return ops_wallet_can_view_all_transactions() || ops_wallet_can_view_own_transactions();
}

/**
 * Người được xem toàn bộ giao dịch ví của mọi OPS.
 */
function ops_wallet_can_view_all_transactions($account = NULL) {
  if ($account === NULL) {
    global $user;
    $account = $user;
  }
  return user_access('administer ops wallet', $account) ||
    user_access('administer nodes', $account) ||
    user_access('view all ops wallet transactions', $account);
}

/**
 * Người OPS chỉ được xem giao dịch của chính mình nếu không có quyền xem tất cả.
 */
function ops_wallet_can_view_own_transactions($account = NULL) {
  if ($account === NULL) {
    global $user;
    $account = $user;
  }
  if (user_access('view own ops wallet transactions', $account)) {
    return TRUE;
  }
  if (!empty($account->roles) && is_array($account->roles)) {
    if (isset($account->roles[15])) {
      return TRUE;
    }
    foreach ($account->roles as $role_name) {
      if (trim((string) $role_name) === 'OPS') {
        return TRUE;
      }
    }
  }
  return FALSE;
}

function ops_wallet_transactions_page() {
  global $user;
  ops_wallet_ensure_storage();

  $limit = isset($_GET['limit']) ? (int) $_GET['limit'] : 200;
  $limit = max(20, min(500, $limit));
  $view_all = ops_wallet_can_view_all_transactions($user);

  if ($view_all) {
    $wallet = ops_wallet_build_all_transactions_summary($limit);
    $page_title = 'Toàn bộ giao dịch ví OPS';
    $scope_label = 'Tất cả OPS';
    $kpi_cards = array(
      array('label' => 'Tổng giao dịch', 'value' => number_format((int) $wallet['transaction_count'], 0, ',', '.'), 'icon' => 'tabler-list-details', 'tone' => 'primary'),
      array('label' => 'Tổng thu', 'value' => '+' . number_format((int) $wallet['total_credit'], 0, ',', '.') . ' đ', 'icon' => 'tabler-trending-up', 'tone' => 'success'),
      array('label' => 'Tổng chi', 'value' => '-' . number_format((int) $wallet['total_debit'], 0, ',', '.') . ' đ', 'icon' => 'tabler-trending-down', 'tone' => 'danger'),
      array('label' => 'Số OPS có giao dịch', 'value' => number_format((int) $wallet['ops_count'], 0, ',', '.'), 'icon' => 'tabler-users', 'tone' => 'info'),
    );
  }
  else {
    ops_api_wallet_ensure_opening_balance($user);
    $wallet = ops_api_wallet_build_summary((int) $user->uid, $limit);
    $page_title = 'Giao dịch ví OPS của tôi';
    $scope_label = 'Ví của tôi';
    $kpi_cards = array(
      array('label' => 'Số dư ví OPS', 'value' => number_format((int) $wallet['balance'], 0, ',', '.') . ' đ', 'icon' => 'tabler-wallet', 'tone' => 'primary'),
      array('label' => 'Số giao dịch', 'value' => number_format(count($wallet['transactions']), 0, ',', '.'), 'icon' => 'tabler-list-details', 'tone' => 'info'),
      array('label' => 'Đường dẫn', 'value' => 'giao-dich-ops', 'icon' => 'tabler-link', 'tone' => 'secondary'),
    );
  }

  drupal_set_title($page_title);

  $transaction_rows = array();
  foreach ($wallet['transactions'] as $transaction) {
    $direction = !empty($transaction['direction']) ? $transaction['direction'] : '';
    $is_debit = $direction === 'debit';
    $amount_prefix = $is_debit ? '-' : '+';

    if ($view_all) {
      $ops_label = !empty($transaction['opsName']) ? $transaction['opsName'] : ('UID ' . (int) $transaction['uid']);
      $ops_uid = !empty($transaction['uid']) ? (int) $transaction['uid'] : 0;
    }
    else {
      $ops_label = check_plain(ops_wallet_user_display_name($user));
      $ops_uid = (int) $user->uid;
    }

    $transaction_rows[] = array(
      'ops' => $ops_label,
      'ops_uid' => $ops_uid,
      'code' => check_plain($transaction['transactionCode']),
      'direction_badge' => ops_wallet_transaction_direction_badge($direction),
      'type_badge' => ops_wallet_transaction_type_badge($transaction['transactionType']),
      'amount_html' => '<span class="fw-bold ' . ($is_debit ? 'ops-wallet-text-danger' : 'ops-wallet-text-success') . '">' . $amount_prefix . number_format((int) $transaction['amount'], 0, ',', '.') . ' đ</span>',
      'balance_after' => number_format((int) $transaction['balanceAfter'], 0, ',', '.') . ' đ',
      'booking' => check_plain($transaction['bookingNo']),
      'description' => check_plain($transaction['description']),
      'created' => !empty($transaction['createdTimestamp']) ? format_date((int) $transaction['createdTimestamp'], 'custom', 'd/m/Y H:i:s') : '',
    );
  }

  $build = array();
  $build['content'] = array(
    '#type' => 'markup',
    '#markup' => ops_wallet_transactions_page_markup($page_title, $scope_label, $kpi_cards, $transaction_rows, $limit, $view_all),
  );

  return $build;
}

/**
 * Giao diện trang giao dịch OPS theo layout Bootstrap/card của hệ thống.
 */
function ops_wallet_transactions_page_markup($page_title, $scope_label, array $kpi_cards, array $transaction_rows, $limit, $view_all) {
  $header = '<div class="ops-wallet-page">'
    . '<style>' . ops_wallet_transactions_page_css() . '</style>'
    . '<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">'
    . '<div>'
    . '<h4 class="mb-1 fw-bold">' . check_plain($page_title) . '</h4>'
    . '<div class="text-muted small">Tài chính / Giao dịch OPS / <span class="fw-semibold">giao-dich-ops</span></div>'
    . '</div>'
    . '<span class="badge bg-label-primary rounded-pill ops-wallet-scope"><i class="icon-base ti tabler-shield-check me-1"></i>' . check_plain($scope_label) . '</span>'
    . '</div>';

  $summary = '<div class="row g-3 mb-4">';
  foreach ($kpi_cards as $card) {
    $summary .= ops_wallet_kpi_card_markup($card['label'], $card['value'], $card['icon'], $card['tone']);
  }
  $summary .= '</div>';

  $filter = '<div class="card mb-4 ops-wallet-filter-card">'
    . '<div class="card-body py-3">'
    . '<form method="get" class="row g-3 align-items-end">'
    . '<div class="col-12 col-md-3 col-lg-2">'
    . '<label class="form-label mb-1">Số dòng</label>'
    . '<select name="limit" class="form-select form-select-sm">'
    . ops_wallet_limit_options_markup($limit)
    . '</select>'
    . '</div>'
    . '<div class="col-12 col-md-auto">'
    . '<button type="submit" class="btn btn-primary btn-sm"><i class="icon-base ti tabler-filter me-1"></i>Lọc</button> '
    . '<a href="' . check_url(url('giao-dich-ops')) . '" class="btn btn-label-secondary btn-sm"><i class="icon-base ti tabler-refresh me-1"></i>Làm mới</a>'
    . '</div>'
    . '<div class="col-12 col-md text-md-end text-muted small">Hiển thị tối đa ' . number_format((int) $limit, 0, ',', '.') . ' giao dịch mới nhất' . ($view_all ? ' của tất cả OPS' : ' của ví hiện tại') . '.</div>'
    . '</form>'
    . '</div>'
    . '</div>';

  $table = '<div class="card ops-wallet-table-card">'
    . '<div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">'
    . '<div>'
    . '<h5 class="card-title mb-0">Danh sách giao dịch</h5>'
    . '<small class="text-muted">Theo dõi thu/chi ví OPS, số dư sau giao dịch và tham chiếu nghiệp vụ.</small>'
    . '</div>'
    . '<span class="badge bg-label-secondary rounded-pill">' . number_format(count($transaction_rows), 0, ',', '.') . ' giao dịch</span>'
    . '</div>'
    . '<div class="table-responsive text-nowrap">'
    . '<table class="table table-hover align-middle mb-0 ops-wallet-system-table">'
    . '<thead><tr>'
    . '<th>OPS</th><th>Mã GD</th><th>Hướng</th><th>Loại</th><th class="text-end">Số tiền</th><th class="text-end">Số dư sau</th><th>Booking</th><th>Nội dung</th><th>Thời gian</th>'
    . '</tr></thead><tbody>';

  if (empty($transaction_rows)) {
    $table .= '<tr><td colspan="9" class="text-center text-muted py-5">' . ($view_all ? 'Chưa có giao dịch ví OPS trong hệ thống.' : 'Ví OPS chưa có giao dịch.') . '</td></tr>';
  }
  else {
    foreach ($transaction_rows as $row) {
      $table .= '<tr>'
        . '<td><div class="fw-semibold text-heading">' . $row['ops'] . '</div>' . (!empty($row['ops_uid']) ? '<div class="text-muted small">UID #' . (int) $row['ops_uid'] . '</div>' : '') . '</td>'
        . '<td><span class="ops-wallet-code">' . $row['code'] . '</span></td>'
        . '<td>' . $row['direction_badge'] . '</td>'
        . '<td>' . $row['type_badge'] . '</td>'
        . '<td class="text-end">' . $row['amount_html'] . '</td>'
        . '<td class="text-end fw-semibold">' . $row['balance_after'] . '</td>'
        . '<td>' . ($row['booking'] !== '' ? '<span class="badge bg-label-dark">' . $row['booking'] . '</span>' : '<span class="text-muted">-</span>') . '</td>'
        . '<td class="ops-wallet-desc">' . ($row['description'] !== '' ? $row['description'] : '<span class="text-muted">-</span>') . '</td>'
        . '<td><span class="text-muted small">' . check_plain($row['created']) . '</span></td>'
        . '</tr>';
    }
  }

  $table .= '</tbody></table></div></div></div>';

  return $header . $summary . $filter . $table;
}

function ops_wallet_kpi_card_markup($label, $value, $icon, $tone) {
  return '<div class="col-12 col-sm-6 col-xl-3">'
    . '<div class="card h-100 ops-wallet-kpi ops-wallet-kpi-' . check_plain($tone) . '">'
    . '<div class="card-body">'
    . '<div class="d-flex align-items-center justify-content-between gap-3">'
    . '<div>'
    . '<div class="text-muted small mb-1">' . check_plain($label) . '</div>'
    . '<div class="h5 mb-0 fw-bold">' . check_plain($value) . '</div>'
    . '</div>'
    . '<span class="avatar rounded-circle ops-wallet-kpi-icon"><i class="icon-base ti ' . check_plain($icon) . '"></i></span>'
    . '</div>'
    . '</div>'
    . '</div>'
    . '</div>';
}

function ops_wallet_limit_options_markup($current) {
  $current = (int) $current;
  $options = array(20, 50, 100, 200, 500);
  $markup = '';
  foreach ($options as $option) {
    $markup .= '<option value="' . (int) $option . '"' . ($current === (int) $option ? ' selected="selected"' : '') . '>' . (int) $option . '</option>';
  }
  return $markup;
}

function ops_wallet_transaction_direction_badge($direction) {
  if ($direction === 'debit') {
    return '<span class="badge bg-label-danger rounded-pill"><i class="icon-base ti tabler-arrow-down me-1"></i>Chi</span>';
  }
  return '<span class="badge bg-label-success rounded-pill"><i class="icon-base ti tabler-arrow-up me-1"></i>Thu</span>';
}

function ops_wallet_transaction_type_badge($type) {
  $label = ops_wallet_transaction_type_label($type);
  $tone = 'secondary';
  switch ($type) {
    case 'container_deposit':
      $tone = 'danger';
      break;

    case 'ops_advance':
    case 'advance_approved':
    case 'ops_advance_approved':
      $tone = 'success';
      break;

    case 'opening_balance':
      $tone = 'info';
      break;
  }
  return '<span class="badge bg-label-' . $tone . '">' . check_plain($label) . '</span>';
}

function ops_wallet_transactions_page_css() {
  return '.ops-wallet-page{font-size:14px}.ops-wallet-page .card{border-radius:12px;box-shadow:0 .125rem .375rem rgba(67,89,113,.08)}'
    . '.ops-wallet-page .bg-label-primary{background:#f4efff!important;color:#7367f0!important}.ops-wallet-page .bg-label-success{background:#e8fadf!important;color:#28c76f!important}.ops-wallet-page .bg-label-danger{background:#ffe2e3!important;color:#ea5455!important}.ops-wallet-page .bg-label-info{background:#d9f8fc!important;color:#00bad1!important}.ops-wallet-page .bg-label-secondary{background:#f1f1f2!important;color:#6d6b77!important}.ops-wallet-page .bg-label-dark{background:#e9ecef!important;color:#495057!important}'
    . '.ops-wallet-kpi{border:0}.ops-wallet-kpi .card-body{padding:1rem 1.125rem}.ops-wallet-kpi-icon{width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center;font-size:22px}.ops-wallet-kpi-primary .ops-wallet-kpi-icon{background:#f4efff;color:#7367f0}.ops-wallet-kpi-success .ops-wallet-kpi-icon{background:#e8fadf;color:#28c76f}.ops-wallet-kpi-danger .ops-wallet-kpi-icon{background:#ffe2e3;color:#ea5455}.ops-wallet-kpi-info .ops-wallet-kpi-icon{background:#d9f8fc;color:#00bad1}.ops-wallet-kpi-secondary .ops-wallet-kpi-icon{background:#f1f1f2;color:#6d6b77}'
    . '.ops-wallet-filter-card .form-label{font-size:.78rem;font-weight:700;color:#6d6b77}.ops-wallet-system-table th{font-size:.75rem;text-transform:uppercase;letter-spacing:.02em;color:#6d6b77;background:#f6f7fb}.ops-wallet-system-table td{vertical-align:middle}.ops-wallet-code{font-family:monospace;font-size:12px;color:#4b465c}.ops-wallet-desc{white-space:normal;min-width:240px;max-width:520px}.ops-wallet-text-success{color:#28c76f}.ops-wallet-text-danger{color:#ea5455}.ops-wallet-scope{font-size:.85rem}.text-heading{color:#4b465c}@media(max-width:767px){.ops-wallet-desc{min-width:220px}.ops-wallet-kpi .h5{font-size:1rem}}';
}

/**
 * Build danh sách giao dịch của tất cả OPS trong hệ thống.
 */
function ops_wallet_build_all_transactions_summary($limit = 200) {
  ops_api_wallet_assert_storage_available();
  $limit = max(20, min(500, (int) $limit));

  $transactions = array();
  $uids = array();
  $total_credit = 0;
  $total_debit = 0;

  $query = db_select('ops_api_wallet_ledger', 'w')
    ->fields('w')
    ->orderBy('created', 'DESC')
    ->orderBy('id', 'DESC')
    ->range(0, $limit);

  foreach ($query->execute() as $record) {
    $uid = (int) $record->uid;
    if ($uid > 0) {
      $uids[$uid] = $uid;
    }
    if ($record->direction === 'debit') {
      $total_debit += (int) $record->amount;
    }
    else {
      $total_credit += (int) $record->amount;
    }
    $transactions[] = array(
      'id' => (int) $record->id,
      'uid' => $uid,
      'transactionNid' => (int) $record->transaction_nid,
      'transactionCode' => $record->transaction_code,
      'direction' => $record->direction,
      'transactionType' => $record->transaction_type,
      'amount' => (int) $record->amount,
      'balanceBefore' => (int) $record->balance_before,
      'balanceAfter' => (int) $record->balance_after,
      'referenceType' => $record->reference_type,
      'referenceId' => $record->reference_id,
      'bookingNo' => $record->booking_no,
      'description' => $record->description,
      'details' => ops_wallet_json_decode($record->details),
      'createdTimestamp' => (int) $record->created,
      'createdText' => format_date((int) $record->created, 'custom', 'd/m/Y H:i:s'),
    );
  }

  $names = ops_wallet_load_user_display_names($uids);
  foreach ($transactions as &$transaction) {
    $uid = (int) $transaction['uid'];
    $transaction['opsName'] = !empty($names[$uid]) ? check_plain($names[$uid]) : ('UID ' . $uid);
  }
  unset($transaction);

  return array(
    'transaction_count' => count($transactions),
    'ops_count' => count($uids),
    'total_credit' => $total_credit,
    'total_debit' => $total_debit,
    'transactions' => $transactions,
  );
}

/**
 * Load tên hiển thị của nhiều user OPS.
 */
function ops_wallet_load_user_display_names($uids) {
  $uids = array_values(array_unique(array_filter(array_map('intval', (array) $uids))));
  if (empty($uids)) {
    return array();
  }

  $accounts = user_load_multiple($uids);
  $names = array();
  foreach ($accounts as $uid => $account) {
    $names[(int) $uid] = ops_wallet_user_display_name($account);
  }
  return $names;
}

function ops_wallet_user_display_name($account) {
  if (!$account || empty($account->uid)) {
    return '';
  }
  foreach (array('field_ho_ten', 'field_full_name', 'field_ten_nhan_vien', 'field_name') as $field_name) {
    if (!field_info_field($field_name)) {
      continue;
    }
    $items = field_get_items('user', $account, $field_name);
    if (!empty($items[0]['value'])) {
      return trim((string) $items[0]['value']);
    }
  }
  return !empty($account->name) ? $account->name : ('UID ' . (int) $account->uid);
}

function ops_wallet_transaction_type_label($type) {
  $labels = array(
    'container_deposit' => 'Cược vỏ',
    'ops_advance' => 'Ứng tiền OPS',
    'advance_approved' => 'Ứng tiền OPS',
    'ops_advance_approved' => 'Ứng tiền OPS',
    'refund' => 'Hoàn ứng',
    'opening_balance' => 'Số dư đầu kỳ',
  );
  return isset($labels[$type]) ? $labels[$type] : $type;
}

/**
 * Implements hook_permission().
 */
function ops_wallet_permission() {
  return array(
    'administer ops wallet' => array(
      'title' => t('Quản trị ví OPS'),
      'description' => t('Xem và quản trị toàn bộ giao dịch ví OPS.'),
      'restrict access' => TRUE,
    ),
    'view own ops wallet transactions' => array(
      'title' => t('Xem giao dịch ví OPS của chính mình'),
    ),
    'view all ops wallet transactions' => array(
      'title' => t('Xem toàn bộ giao dịch ví OPS'),
      'description' => t('Cho phép xem trang giao-dich-ops với toàn bộ giao dịch của tất cả OPS.'),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Chặn truy cập trực tiếp vào node lịch sử tài chính.
 */
function ops_wallet_node_access($node, $op, $account) {
  if (!is_object($node) || empty($node->type) || $node->type !== 'giao_dich_vi_ops') {
    return NODE_ACCESS_IGNORE;
  }

  if (user_access('administer ops wallet', $account) || user_access('administer nodes', $account)) {
    return NODE_ACCESS_ALLOW;
  }

  if ($op === 'view' && user_access('view own ops wallet transactions', $account) && (int) $node->uid === (int) $account->uid) {
    return NODE_ACCESS_ALLOW;
  }

  return NODE_ACCESS_DENY;
}

/**
 * Định nghĩa bảng sổ cái. Không dùng hook_schema để module có thể nhận bảng
 * đã tồn tại từ bản ops_api cũ mà không lỗi khi bật module.
 */
function ops_wallet_ledger_schema_definition() {
  return array(
    'description' => 'Sổ giao dịch và số dư ví OPS theo từng tài khoản.',
    'fields' => array(
      'id' => array('type' => 'serial', 'not null' => TRUE),
      'transaction_nid' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'uid' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'transaction_code' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'direction' => array('type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'default' => ''),
      'transaction_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'amount' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0, 'unsigned' => TRUE),
      'balance_before' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'balance_after' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'reference_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'reference_id' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''),
      'booking_no' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''),
      'description' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''),
      'details' => array('type' => 'text', 'size' => 'big', 'not null' => FALSE),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('id'),
    'unique keys' => array('transaction_code' => array('transaction_code')),
    'indexes' => array(
      'uid_created' => array('uid', 'created'),
      'transaction_nid' => array('transaction_nid'),
      'reference' => array(array('reference_type', 32), array('reference_id', 64)),
      'booking_no' => array(array('booking_no', 64)),
    ),
  );
}

/**
 * Tạo bảng nếu chưa có; giữ nguyên dữ liệu từ ops_api bản cũ nếu đã tồn tại.
 */
function ops_wallet_ensure_storage() {
  if (!db_table_exists('ops_api_wallet_ledger')) {
    db_create_table('ops_api_wallet_ledger', ops_wallet_ledger_schema_definition());
  }
}

/**
 * Tạo content type và field lịch sử giao dịch.
 */
function ops_wallet_ensure_content_type() {
  $type = node_type_get_type('giao_dich_vi_ops');
  if (!$type) {
    $type = new stdClass();
    $type->type = 'giao_dich_vi_ops';
    $type->name = 'Giao dịch ví OPS';
    $type->base = 'node_content';
    $type->module = 'node';
    $type->description = 'Lịch sử thu, chi và số dư sau mỗi giao dịch của ví OPS.';
    $type->help = '';
    $type->has_title = 1;
    $type->title_label = 'Mã giao dịch';
    $type->custom = 1;
    $type->modified = 1;
    $type->locked = 0;
    $type->disabled = 0;
    node_type_save($type);
  }

  if (!field_info_instance('node', 'body', 'giao_dich_vi_ops')) {
    node_add_body_field($type, 'Dữ liệu giao dịch đầy đủ');
  }

  $definitions = array(
    'field_gd_vi_ma' => array('label' => 'Mã giao dịch', 'type' => 'text', 'widget' => 'text_textfield', 'required' => TRUE),
    'field_gd_vi_huong' => array(
      'label' => 'Hướng giao dịch', 'type' => 'list_text', 'widget' => 'options_select', 'required' => TRUE,
      'settings' => array('allowed_values' => array('credit' => 'Thu', 'debit' => 'Chi')),
    ),
    'field_gd_vi_loai' => array('label' => 'Loại giao dịch', 'type' => 'text', 'widget' => 'text_textfield', 'required' => TRUE),
    'field_gd_vi_so_tien' => array('label' => 'Số tiền', 'type' => 'number_decimal', 'widget' => 'number', 'required' => TRUE, 'settings' => array('precision' => 20, 'scale' => 0, 'decimal_separator' => '.')),
    'field_gd_vi_so_du_truoc' => array('label' => 'Số dư trước giao dịch', 'type' => 'number_decimal', 'widget' => 'number', 'required' => TRUE, 'settings' => array('precision' => 20, 'scale' => 0, 'decimal_separator' => '.')),
    'field_gd_vi_so_du_sau' => array('label' => 'Số dư sau giao dịch', 'type' => 'number_decimal', 'widget' => 'number', 'required' => TRUE, 'settings' => array('precision' => 20, 'scale' => 0, 'decimal_separator' => '.')),
    'field_gd_vi_uid' => array('label' => 'UID chủ ví OPS', 'type' => 'number_integer', 'widget' => 'number', 'required' => TRUE),
    'field_gd_vi_booking' => array('label' => 'Số booking', 'type' => 'text', 'widget' => 'text_textfield', 'required' => FALSE),
    'field_gd_vi_tham_chieu' => array('label' => 'Tham chiếu nghiệp vụ', 'type' => 'text', 'widget' => 'text_textfield', 'required' => FALSE),
    'field_gd_vi_mo_ta' => array('label' => 'Nội dung giao dịch', 'type' => 'text_long', 'widget' => 'text_textarea', 'required' => FALSE),
    'field_gd_vi_chi_tiet' => array('label' => 'Chi tiết giao dịch JSON', 'type' => 'text_long', 'widget' => 'text_textarea', 'required' => FALSE),
  );

  $weight = 1;
  foreach ($definitions as $field_name => $definition) {
    if (!field_info_field($field_name)) {
      $field = array('field_name' => $field_name, 'type' => $definition['type'], 'cardinality' => 1, 'translatable' => FALSE);
      if (!empty($definition['settings'])) {
        $field['settings'] = $definition['settings'];
      }
      field_create_field($field);
    }
    if (!field_info_instance('node', $field_name, 'giao_dich_vi_ops')) {
      field_create_instance(array(
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'giao_dich_vi_ops',
        'label' => $definition['label'],
        'required' => !empty($definition['required']),
        'widget' => array('type' => $definition['widget'], 'weight' => $weight),
        'display' => array(
          'default' => array(
            'label' => 'above',
            'type' => $definition['type'] === 'list_text' ? 'list_default' : ($definition['type'] === 'number_integer' ? 'number_integer' : ($definition['type'] === 'number_decimal' ? 'number_decimal' : 'text_default')),
            'weight' => $weight,
          ),
          'teaser' => array('label' => 'hidden', 'type' => 'hidden'),
        ),
      ));
    }
    $weight++;
  }

  variable_set('node_options_giao_dich_vi_ops', array());
  variable_set('comment_giao_dich_vi_ops', 0);
  field_info_cache_clear();
}

/**
 * Kiểm tra storage trước khi thực hiện giao dịch.
 * Giữ tên ops_api_wallet_* để không phải thay Flutter/API và module tích hợp cũ.
 */
function ops_api_wallet_assert_storage_available() {
  if (!db_table_exists('ops_api_wallet_ledger')) {
    if (function_exists('ops_api_error')) {
      ops_api_error('Chưa có bảng lịch sử ví OPS. Vui lòng bật module ops_wallet và chạy update.php hoặc drush updb.', 500);
    }
    throw new Exception('Chưa có bảng lịch sử ví OPS.');
  }
}

function ops_api_wallet_current_balance($uid) {
  ops_api_wallet_assert_storage_available();
  $value = db_select('ops_api_wallet_ledger', 'w')
    ->fields('w', array('balance_after'))
    ->condition('uid', (int) $uid)
    ->orderBy('id', 'DESC')
    ->range(0, 1)
    ->execute()->fetchField();
  return $value === FALSE ? 0 : (int) $value;
}

function ops_api_wallet_ensure_opening_balance($account) {
  if (!$account || empty($account->uid)) return;
  ops_api_wallet_assert_storage_available();
  $lock_name = 'ops_api_wallet_opening_' . (int) $account->uid;
  if (!lock_acquire($lock_name, 10.0)) return;
  try {
    $exists = db_select('ops_api_wallet_ledger', 'w')->fields('w', array('id'))->condition('uid', (int) $account->uid)->range(0, 1)->execute()->fetchField();
    if ($exists) return;

    $opening_balance = (int) variable_get('ops_wallet_opening_balance_' . (int) $account->uid,
      variable_get('ops_api_wallet_opening_balance_' . (int) $account->uid, 0));
    foreach (array('field_so_du_vi_ops', 'field_so_du_vi', 'field_so_du') as $field_name) {
      if ($opening_balance > 0 || !field_info_field($field_name)) continue;
      $items = field_get_items('user', $account, $field_name);
      if (empty($items[0])) continue;
      foreach (array('value', 'amount', 'decimal') as $column) {
        if (isset($items[0][$column]) && is_numeric($items[0][$column])) {
          $opening_balance = (int) round($items[0][$column]);
          break 2;
        }
      }
    }
    if ($opening_balance > 0) {
      ops_api_wallet_create_transaction(array(
        'account' => $account, 'direction' => 'credit', 'amount' => $opening_balance,
        'transaction_type' => 'opening_balance', 'reference_type' => 'user',
        'reference_id' => (string) $account->uid, 'booking_no' => '',
        'description' => 'Số dư đầu kỳ ví OPS.',
        'details' => array('source' => 'legacy_wallet_balance'), 'balance_before' => 0,
      ));
    }
  }
  finally {
    lock_release($lock_name);
  }
}

function ops_wallet_json_encode($data) {
  return drupal_json_encode($data);
}

function ops_wallet_json_decode($value) {
  if (is_array($value)) return $value;
  if (!is_string($value) || trim($value) === '') return array();
  $decoded = drupal_json_decode($value);
  return is_array($decoded) ? $decoded : array();
}

function ops_api_wallet_set_transaction_node_fields(&$node, array $payload) {
  $lang = LANGUAGE_NONE;
  $details_json = ops_wallet_json_encode(!empty($payload['details']) && is_array($payload['details']) ? $payload['details'] : array());
  $reference = trim((!empty($payload['reference_type']) ? $payload['reference_type'] : '') . (!empty($payload['reference_id']) ? ':' . $payload['reference_id'] : ''));
  $values = array(
    'field_gd_vi_ma' => isset($payload['transaction_code']) ? $payload['transaction_code'] : '',
    'field_gd_vi_huong' => isset($payload['direction']) ? $payload['direction'] : '',
    'field_gd_vi_loai' => isset($payload['transaction_type']) ? $payload['transaction_type'] : '',
    'field_gd_vi_so_tien' => isset($payload['amount']) ? (string) $payload['amount'] : '0',
    'field_gd_vi_so_du_truoc' => isset($payload['balance_before']) ? (string) $payload['balance_before'] : '0',
    'field_gd_vi_so_du_sau' => isset($payload['balance_after']) ? (string) $payload['balance_after'] : '0',
    'field_gd_vi_uid' => isset($payload['uid']) ? (int) $payload['uid'] : 0,
    'field_gd_vi_booking' => isset($payload['booking_no']) ? $payload['booking_no'] : '',
    'field_gd_vi_tham_chieu' => $reference,
  );
  foreach ($values as $field_name => $value) {
    if (field_info_instance('node', $field_name, 'giao_dich_vi_ops')) {
      $node->{$field_name}[$lang][0] = array('value' => $value);
    }
  }
  if (field_info_instance('node', 'field_gd_vi_mo_ta', 'giao_dich_vi_ops')) {
    $node->field_gd_vi_mo_ta[$lang][0] = array('value' => isset($payload['description']) ? $payload['description'] : '', 'format' => NULL);
  }
  if (field_info_instance('node', 'field_gd_vi_chi_tiet', 'giao_dich_vi_ops')) {
    $node->field_gd_vi_chi_tiet[$lang][0] = array('value' => $details_json, 'format' => NULL);
  }
}

function ops_api_wallet_migrate_transaction_node($node) {
  if (!$node || empty($node->nid) || $node->type !== 'giao_dich_vi_ops') return FALSE;
  $payload = array();
  $body = field_get_items('node', $node, 'body');
  if (!empty($body[0]['value'])) $payload = ops_wallet_json_decode($body[0]['value']);
  if (db_table_exists('ops_api_wallet_ledger')) {
    $record = db_select('ops_api_wallet_ledger', 'w')->fields('w')->condition('transaction_nid', (int) $node->nid)->range(0, 1)->execute()->fetchObject();
    if ($record) {
      $ledger_payload = array(
        'transaction_code' => $record->transaction_code, 'uid' => (int) $record->uid,
        'direction' => $record->direction, 'transaction_type' => $record->transaction_type,
        'amount' => (int) $record->amount, 'balance_before' => (int) $record->balance_before,
        'balance_after' => (int) $record->balance_after, 'reference_type' => $record->reference_type,
        'reference_id' => $record->reference_id, 'booking_no' => $record->booking_no,
        'description' => $record->description, 'details' => ops_wallet_json_decode($record->details),
        'created' => (int) $record->created,
      );
      $payload = $payload + $ledger_payload;
    }
  }
  if (empty($payload['transaction_code'])) return FALSE;
  ops_api_wallet_set_transaction_node_fields($node, $payload);
  field_attach_presave('node', $node);
  field_attach_update('node', $node);
  return TRUE;
}

function ops_wallet_migrate_transaction_nodes_batch(&$sandbox) {
  ops_wallet_ensure_storage();
  ops_wallet_ensure_content_type();
  if (!isset($sandbox['initialized'])) {
    $sandbox['initialized'] = TRUE; $sandbox['last_nid'] = 0; $sandbox['processed'] = 0;
    $sandbox['total'] = (int) db_query("SELECT COUNT(nid) FROM {node} WHERE type = :type", array(':type' => 'giao_dich_vi_ops'))->fetchField();
  }
  $result = db_select('node', 'n')->fields('n', array('nid'))->condition('n.type', 'giao_dich_vi_ops')->condition('n.nid', (int) $sandbox['last_nid'], '>')->orderBy('n.nid', 'ASC')->range(0, 50)->execute();
  $found = 0;
  foreach ($result as $record) {
    $found++; $sandbox['last_nid'] = (int) $record->nid;
    $node = node_load($record->nid, NULL, TRUE);
    if ($node) ops_api_wallet_migrate_transaction_node($node);
    $sandbox['processed']++;
  }
  $sandbox['#finished'] = ($sandbox['total'] <= 0 || $found === 0 || $sandbox['processed'] >= $sandbox['total']) ? 1 : $sandbox['processed'] / $sandbox['total'];
  if ($sandbox['#finished'] >= 1) return t('Đã migrate @count giao dịch ví OPS.', array('@count' => $sandbox['processed']));
}

function ops_api_wallet_create_transaction($params) {
  ops_api_wallet_assert_storage_available();
  ops_wallet_ensure_content_type();
  $account = !empty($params['account']) ? $params['account'] : FALSE;
  $uid = $account && !empty($account->uid) ? (int) $account->uid : (!empty($params['uid']) ? (int) $params['uid'] : 0);
  $direction = !empty($params['direction']) && $params['direction'] === 'debit' ? 'debit' : 'credit';
  $amount = !empty($params['amount']) ? (int) $params['amount'] : 0;
  $balance_before = isset($params['balance_before']) ? (int) $params['balance_before'] : ops_api_wallet_current_balance($uid);
  $balance_after = $direction === 'debit' ? $balance_before - $amount : $balance_before + $amount;
  if ($uid <= 0 || $amount <= 0) throw new Exception('Thông tin giao dịch ví không hợp lệ.');
  if ($balance_after < 0) throw new Exception('Số dư ví OPS không đủ để thực hiện giao dịch.');

  $transaction_code = 'OPS-' . date('YmdHis', REQUEST_TIME) . '-' . $uid . '-' . strtoupper(substr(drupal_random_key(), 0, 6));
  $details = !empty($params['details']) && is_array($params['details']) ? $params['details'] : array();
  $payload = array(
    'transaction_code' => $transaction_code, 'uid' => $uid, 'direction' => $direction,
    'transaction_type' => !empty($params['transaction_type']) ? trim((string) $params['transaction_type']) : 'other',
    'amount' => $amount, 'balance_before' => $balance_before, 'balance_after' => $balance_after,
    'reference_type' => !empty($params['reference_type']) ? trim((string) $params['reference_type']) : '',
    'reference_id' => !empty($params['reference_id']) ? trim((string) $params['reference_id']) : '',
    'booking_no' => !empty($params['booking_no']) ? trim((string) $params['booking_no']) : '',
    'description' => !empty($params['description']) ? trim((string) $params['description']) : '',
    'details' => $details, 'created' => REQUEST_TIME,
    'created_text' => format_date(REQUEST_TIME, 'custom', 'd/m/Y H:i:s'),
  );

  $node = new stdClass();
  $node->type = 'giao_dich_vi_ops'; node_object_prepare($node);
  $node->title = $transaction_code . ' - ' . ($direction === 'debit' ? 'Chi' : 'Thu') . ' ' . number_format($amount, 0, ',', '.') . ' đ';
  $node->uid = $uid; $node->status = 0; $node->language = LANGUAGE_NONE;
  $node->body[LANGUAGE_NONE][0] = array('value' => ops_wallet_json_encode($payload), 'summary' => $payload['description'], 'format' => function_exists('filter_default_format') ? filter_default_format($uid) : NULL);
  ops_api_wallet_set_transaction_node_fields($node, $payload);
  node_save($node);

  $id = db_insert('ops_api_wallet_ledger')->fields(array(
    'transaction_nid' => !empty($node->nid) ? (int) $node->nid : 0, 'uid' => $uid,
    'transaction_code' => $transaction_code, 'direction' => $direction,
    'transaction_type' => $payload['transaction_type'], 'amount' => $amount,
    'balance_before' => $balance_before, 'balance_after' => $balance_after,
    'reference_type' => $payload['reference_type'], 'reference_id' => $payload['reference_id'],
    'booking_no' => $payload['booking_no'], 'description' => $payload['description'],
    'details' => ops_wallet_json_encode($details), 'created' => REQUEST_TIME,
  ))->execute();
  $payload['id'] = (int) $id;
  $payload['transaction_nid'] = !empty($node->nid) ? (int) $node->nid : 0;
  return $payload;
}

function ops_api_wallet_credit($uid, $amount, $transaction_type, $reference_id, $description, $details = array()) {
  $account = user_load((int) $uid);
  if (!$account) throw new Exception('Không tìm thấy tài khoản OPS cần cộng tiền.');
  ops_api_wallet_ensure_opening_balance($account);
  $lock_name = 'ops_api_wallet_uid_' . (int) $uid;
  if (!lock_acquire($lock_name, 30.0)) throw new Exception('Ví OPS đang có giao dịch khác. Vui lòng thử lại.');
  try {
    return ops_api_wallet_create_transaction(array('account' => $account, 'direction' => 'credit', 'amount' => (int) $amount, 'transaction_type' => $transaction_type, 'reference_type' => 'external', 'reference_id' => (string) $reference_id, 'description' => $description, 'details' => $details, 'balance_before' => ops_api_wallet_current_balance((int) $uid)));
  }
  finally { lock_release($lock_name); }
}

function ops_api_wallet_debit($uid, $amount, $transaction_type, $reference_id, $description, $details = array()) {
  $account = user_load((int) $uid);
  if (!$account) throw new Exception('Không tìm thấy tài khoản OPS cần trừ tiền.');
  ops_api_wallet_ensure_opening_balance($account);
  $lock_name = 'ops_api_wallet_uid_' . (int) $uid;
  if (!lock_acquire($lock_name, 30.0)) throw new Exception('Ví OPS đang có giao dịch khác. Vui lòng thử lại.');
  try {
    return ops_api_wallet_create_transaction(array('account' => $account, 'direction' => 'debit', 'amount' => (int) $amount, 'transaction_type' => $transaction_type, 'reference_type' => 'external', 'reference_id' => (string) $reference_id, 'description' => $description, 'details' => $details, 'balance_before' => ops_api_wallet_current_balance((int) $uid)));
  }
  finally { lock_release($lock_name); }
}

function ops_api_wallet_build_summary($uid, $limit = 50) {
  ops_api_wallet_assert_storage_available();
  $transactions = array();
  $query = db_select('ops_api_wallet_ledger', 'w')->fields('w')->condition('uid', (int) $uid)->orderBy('id', 'DESC')->range(0, max(1, min(200, (int) $limit)));
  foreach ($query->execute() as $record) {
    $transactions[] = array(
      'id' => (int) $record->id, 'transactionNid' => (int) $record->transaction_nid,
      'transactionCode' => $record->transaction_code, 'direction' => $record->direction,
      'transactionType' => $record->transaction_type, 'amount' => (int) $record->amount,
      'balanceBefore' => (int) $record->balance_before, 'balanceAfter' => (int) $record->balance_after,
      'referenceType' => $record->reference_type, 'referenceId' => $record->reference_id,
      'bookingNo' => $record->booking_no, 'description' => $record->description,
      'details' => ops_wallet_json_decode($record->details), 'createdTimestamp' => (int) $record->created,
      'createdText' => format_date((int) $record->created, 'custom', 'd/m/Y H:i:s'),
    );
  }
  return array('uid' => (int) $uid, 'balance' => ops_api_wallet_current_balance((int) $uid), 'transactions' => $transactions);
}
