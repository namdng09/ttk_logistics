<?php

function khach_hang_schema() {
  $schema['khach_hang'] = array(
    'description' => 'Khách hàng (Doanh nghiệp, Cá nhân, NCC, Đối tác, Khác).',
    'fields' => array(
      'nid' => array(
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'ten' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ),
      'ma_kh' => array(
        'type' => 'varchar',
        'length' => 50,
        'not null' => FALSE,
      ),
      'phan_loai' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ),
      'cccd_mst' => array(
        'type' => 'varchar',
        'length' => 50,
        'not null' => FALSE,
      ),
      'sdt' => array(
        'type' => 'varchar',
        'length' => 20,
        'not null' => FALSE,
      ),
      'dia_chi' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ),
      'thong_tin_ngan_hang' => array(
        'type' => 'text',
        'not null' => FALSE,
      ),
      'nv_kinh_doanh' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ),
      'dob' => array(
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ),
      'ghi_chu' => array(
        'type' => 'text',
        'not null' => FALSE,
      ),
      'hoat_dong' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ),
      'created' => array(
        'type' => 'varchar',
        'length' => 19,
        'not null' => FALSE,
      ),
      'changed' => array(
        'type' => 'varchar',
        'length' => 19,
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('nid'),
    'indexes' => array(
      'hoat_dong' => array('hoat_dong'),
      'phan_loai' => array('phan_loai'),
      'nv_kinh_doanh' => array('nv_kinh_doanh'),
    ),
  );

  $schema['nhan_vien_khach_hang'] = array(
    'description' => 'Quan hệ N-N giữa khách hàng và nhân viên kinh doanh (junction table, có lịch sử).',
    'fields' => array(
      'id' => array(
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'hoat_dong' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ),
      'created' => array(
        'type' => 'varchar',
        'length' => 19,
        'not null' => FALSE,
      ),
      'changed' => array(
        'type' => 'varchar',
        'length' => 19,
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('id'),
    'indexes' => array(
      'uid_nid' => array('uid', 'nid'),
      'nid' => array('nid'),
      'uid' => array('uid'),
    ),
  );

  return $schema;
}

function khach_hang_update_7001() {
  drupal_install_schema('khach_hang');
}

function khach_hang_update_7002() {
  $schema = array();
  $schema['nhan_vien_khach_hang'] = array(
    'description' => 'Quan hệ N-N giữa khách hàng và nhân viên kinh doanh.',
    'fields' => array(
      'id' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'uid' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'nid' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'hoat_dong' => array('type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1),
      'created' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'changed' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
    ),
    'primary key' => array('id'),
    'indexes' => array('uid_nid' => array('uid', 'nid'), 'nid' => array('nid'), 'uid' => array('uid')),
  );
  db_create_table('nhan_vien_khach_hang', $schema['nhan_vien_khach_hang']);

  // Migrate existing nv_kinh_doanh from khach_hang table to junction table
  $old = db_query("SELECT nid, nv_kinh_doanh FROM {khach_hang} WHERE nv_kinh_doanh IS NOT NULL AND nv_kinh_doanh > 0");
  foreach ($old as $row) {
    $exists = db_query("SELECT id FROM {nhan_vien_khach_hang} WHERE uid = :uid AND nid = :nid AND hoat_dong = 1", array(
      ':uid' => $row->nv_kinh_doanh,
      ':nid' => $row->nid,
    ))->fetchField();
    if (!$exists) {
      db_insert('nhan_vien_khach_hang')->fields(array(
        'uid' => $row->nv_kinh_doanh,
        'nid' => $row->nid,
        'hoat_dong' => 1,
        'created' => date('Y-m-d H:i:s'),
        'changed' => date('Y-m-d H:i:s'),
      ))->execute();
    }
  }
}