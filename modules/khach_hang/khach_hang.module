<?php

/**
 * @file
 * Khách Hàng — Customer management.
 * RESTful API + Modal CRUD.
 */

/**
 * Implements hook_permission().
 */
function khach_hang_permission() {
  return array(
    'khach_hang_view' => array('title' => t('Xem khách hàng')),
    'khach_hang_create' => array('title' => t('Tạo/sửa khách hàng')),
    'khach_hang_delete' => array('title' => t('Xoá khách hàng')),
  );
}

/**
 * Implements hook_init() — CORS for API routes.
 */
function khach_hang_init() {
  $path = current_path();
  if (strpos($path, 'api/khach-hang') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function khach_hang_menu() {
  $items = array();

  $items['api/khach-hang'] = array(
    'page callback' => 'khach_hang_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/khach-hang/%/dinh-muc'] = array(
    'page callback' => 'khach_hang_dinh_muc_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/khach-hang/%'] = array(
    'page callback' => 'khach_hang_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['khach-hang'] = array(
    'title' => 'Danh sách khách hàng',
    'page callback' => 'khach_hang_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

/**
 * Implements hook_theme().
 */
function khach_hang_theme() {
  $path = drupal_get_path('module', 'khach_hang') . '/templates';
  return array(
    'khach_hang_list_page' => array(
      'template' => 'khach-hang-list',
      'path' => $path,
    ),
    'khach_hang_modal' => array(
      'template' => 'khach-hang-modal',
      'path' => $path,
    ),
  );
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _khach_hang_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

