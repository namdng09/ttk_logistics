function _khach_hang_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _khach_hang_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _khach_hang_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _khach_hang_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _khach_hang_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _khach_hang_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

function _khach_hang_now() {
  return date('Y-m-d H:i:s', REQUEST_TIME);
}

function _khach_hang_num_or_null($value) {
  if ($value === '' || $value === NULL) return NULL;
  return is_numeric($value) ? $value : NULL;
}

function _khach_hang_int_value($value) {
  if ($value === '' || $value === NULL) return 0;
  return (int) preg_replace('/[^0-9]/', '', (string) $value);
}

function _khach_hang_bang_gia_decode($json) {
  if (empty($json)) {
    return array('bang_gia_cuoc' => array(), 'dinh_muc' => array('routes' => array()));
  }
  $decoded = json_decode($json, TRUE);
  if (!is_array($decoded)) {
    $decoded = array();
  }
  return array(
    'bang_gia_cuoc' => !empty($decoded['bang_gia_cuoc']) && is_array($decoded['bang_gia_cuoc']) ? $decoded['bang_gia_cuoc'] : array(),
    'dinh_muc' => !empty($decoded['dinh_muc']) && is_array($decoded['dinh_muc']) ? array(
      'routes' => !empty($decoded['dinh_muc']['routes']) && is_array($decoded['dinh_muc']['routes']) ? $decoded['dinh_muc']['routes'] : array(),
    ) : array('routes' => array()),
  );
}

function _khach_hang_bang_gia_encode(array $bang_gia_cuoc = array(), array $dinh_muc = array()) {
  return array(
    'bang_gia_cuoc' => $bang_gia_cuoc,
    'dinh_muc' => array(
      'routes' => !empty($dinh_muc['routes']) && is_array($dinh_muc['routes']) ? $dinh_muc['routes'] : array(),
    ),
  );
}

/**
 * Allowed phan_loai values.
 */
function _khach_hang_phan_loai_options() {
  return array('Doanh nghiệp', 'Cá nhân', 'Khách hàng', 'Nhà cung cấp', 'Đối tác', 'Khác');
}

/**
 * Check unique ma_kh (active only).
 */
function _khach_hang_check_unique_ma($value, $exclude_nid = NULL) {
  $value = trim($value);
  if ($value === '') return NULL;
  $query = db_select('khach_hang', 'kh');
  $query->fields('kh', array('nid', 'hoat_dong'));
  $query->condition('kh.ma_kh', $value);
  if ($exclude_nid !== NULL) {
    $query->condition('kh.nid', $exclude_nid, '<>');
  }
  $query->range(0, 1);
  $exists = $query->execute()->fetchObject();
  if ($exists && $exists->hoat_dong) {
    return _khach_hang_fail('Mã khách hàng "' . $value . '" đã tồn tại');
  }
  return NULL;
}

/**
 * Normalize SĐT: strip spaces, dashes, dots → digits only.
 */
function _khach_hang_normalize_sdt($sdt) {
  return preg_replace('/[^0-9]/', '', $sdt);
}

/**
 * Check unique sdt using normalized comparison.
 */
function _khach_hang_check_unique_sdt($input, $exclude_nid = NULL) {
  if (!isset($input['sdt'])) return NULL;
  $raw = trim($input['sdt']);
  if ($raw === '') return NULL;
  $norm = _khach_hang_normalize_sdt($raw);

  $sql = "SELECT nid FROM {khach_hang}
    WHERE REPLACE(REPLACE(REPLACE(REPLACE(sdt, ' ', ''), '.', ''), '-', ''), '/', '') = :norm
    AND hoat_dong = 1";
  $args = array(':norm' => $norm);
  if ($exclude_nid !== NULL) {
    $sql .= " AND nid <> :ex";
    $args[':ex'] = $exclude_nid;
  }
  $sql .= " LIMIT 1";
  $exists = db_query($sql, $args)->fetchField();
  if ($exists) {
    return _khach_hang_fail('Số điện thoại "' . $raw . '" đã tồn tại');
  }
  return NULL;
}

/**
 * Check unique cccd_mst (active only).
 */
function _khach_hang_check_unique_cccd($input, $exclude_nid = NULL) {
  if (!isset($input['cccd_mst'])) return NULL;
  $value = trim($input['cccd_mst']);
  if ($value === '') return NULL;

  $query = db_select('khach_hang', 'kh');
  $query->fields('kh', array('nid', 'hoat_dong'));
  $query->condition('kh.cccd_mst', $value);
  if ($exclude_nid !== NULL) {
    $query->condition('kh.nid', $exclude_nid, '<>');
  }
  $query->range(0, 1);
  $exists = $query->execute()->fetchObject();
  if ($exists && $exists->hoat_dong) {
    return _khach_hang_fail('CCCD/MST "' . $value . '" đã tồn tại');
  }
  return NULL;
}

/**
 * Normalize phan_loai: accept array or string, store as comma-separated string.
 */
function _khach_hang_normalize_phan_loai($input) {
  if (is_array($input)) {
    return implode(', ', $input);
  }
  return $input;
}

/**
 * Sync junction table nhan_vien_khach_hang.
 * Soft-deletes old active records and inserts new ones.
 */
function _khach_hang_sync_nv_kinh_doanh($nid, $uids) {
  if (!is_array($uids)) {
    $uids = array();
  }
  $uids = array_unique(array_map('intval', $uids));
  $uids = array_filter($uids);

  // Soft-delete old active records
  db_update('nhan_vien_khach_hang')
    ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
    ->condition('nid', $nid)
    ->condition('hoat_dong', 1)
    ->execute();

  // Insert new records
  $now = date('Y-m-d H:i:s', REQUEST_TIME);
  foreach ($uids as $uid) {
    $exists = db_query("SELECT id FROM {nhan_vien_khach_hang} WHERE uid = :uid AND nid = :nid AND hoat_dong = 1", array(
      ':uid' => $uid,
      ':nid' => $nid,
    ))->fetchField();
    if (!$exists) {
      db_insert('nhan_vien_khach_hang')
        ->fields(array(
          'uid' => $uid,
          'nid' => $nid,
          'hoat_dong' => 1,
          'created' => $now,
          'changed' => $now,
        ))
        ->execute();
    }
  }
}

/**
 * Build row with joins (nv_kinh_doanh array + formatted fields).
 * @param bool $include_bang_gia  When FALSE (list mode), omit heavy detail fields from response.
 */
function _khach_hang_load_row($nid, $include_bang_gia = FALSE) {
  $kh = db_query("SELECT * FROM {khach_hang} WHERE nid = :nid", array(':nid' => $nid))->fetch();
  if (!$kh) return NULL;

  // Get active nv_kinh_doanh array from junction table
  $nv_kinh_doanh = array();
  $nv_rows = db_query("SELECT nv.uid, u.name, u.ten, u.ma_nhan_vien FROM {nhan_vien_khach_hang} nv INNER JOIN {users} u ON u.uid = nv.uid WHERE nv.nid = :nid AND nv.hoat_dong = 1 ORDER BY nv.id ASC", array(':nid' => $nid));
  foreach ($nv_rows as $nv) {
    $nv_kinh_doanh[] = array(
      'uid' => (int) $nv->uid,
      'ten' => isset($nv->ten) ? $nv->ten : $nv->name,
      'username' => $nv->name,
      'ma_nhan_vien' => isset($nv->ma_nhan_vien) ? $nv->ma_nhan_vien : '',
    );
  }

  $ngan_hang = array();
  if ($include_bang_gia && !empty($kh->thong_tin_ngan_hang)) {
    $decoded = json_decode($kh->thong_tin_ngan_hang, TRUE);
    if (is_array($decoded)) {
      $ngan_hang = $decoded;
    }
  }

  $bang_gia_cuoc = array();
  if ($include_bang_gia && !empty($kh->bang_gia_cuoc)) {
    $bang_gia_cuoc = _khach_hang_bang_gia_decode($kh->bang_gia_cuoc);
  }
  $lien_he = array();
  if (!empty($kh->thong_tin_lien_he)) {
    $decoded_lien_he = json_decode($kh->thong_tin_lien_he, TRUE);
    if (is_array($decoded_lien_he)) $lien_he = $decoded_lien_he;
  }

  return array(
    'nid' => (int) $kh->nid,
    'ten' => $kh->ten,
    'ma_kh' => $kh->ma_kh ? $kh->ma_kh : '',
    'phan_loai' => $kh->phan_loai,
    'cccd_mst' => $kh->cccd_mst ? $kh->cccd_mst : '',
    'sdt' => $kh->sdt ? $kh->sdt : '',
    'email' => !empty($kh->email) ? $kh->email : '',
    'thong_tin_lien_he' => $lien_he,
    'dia_chi' => $kh->dia_chi ? $kh->dia_chi : '',
    'thong_tin_ngan_hang' => $ngan_hang,
    'bang_gia_cuoc' => $bang_gia_cuoc,
    'nv_kinh_doanh' => !empty($nv_kinh_doanh) ? $nv_kinh_doanh[0] : NULL,
    'dob' => $kh->dob ? $kh->dob : '',
    'ghi_chu' => $kh->ghi_chu ? $kh->ghi_chu : '',
    'hoat_dong' => (int) $kh->hoat_dong,
  );
}

/*******************************************************************************
 * REST: COLLECTION — GET /api/khach-hang, POST /api/khach-hang
 ******************************************************************************/

function khach_hang_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _khach_hang_rest_list();
    case 'POST':
      return _khach_hang_rest_create();
    default:
      return _khach_hang_method_not_allowed('GET, POST');
  }
}

function _khach_hang_rest_list() {
  if (!user_access('khach_hang_view')) {
    return _khach_hang_unauthorized('Bạn không có quyền xem khách hàng');
  }

  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('khach_hang', 'kh');
  $query->fields('kh');

  $query->condition('kh.hoat_dong', 1);
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('kh.ten', $like, 'LIKE')
      ->condition('kh.ma_kh', $like, 'LIKE')
      ->condition('kh.cccd_mst', $like, 'LIKE')
      ->condition('kh.sdt', $like, 'LIKE')
      ->condition('kh.phan_loai', $like, 'LIKE');
    $query->condition($or);
  }
  if (!empty($_GET['phan_loai'])) {
    $query->condition('kh.phan_loai', '%' . db_like($_GET['phan_loai']) . '%', 'LIKE');
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('kh.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $items = array();
  foreach ($rows as $kh) {
    $row = _khach_hang_load_row($kh->nid, FALSE);
    $items[] = $row;
  }

  $total_pages = (int) ceil($total / $limit);

  return _khach_hang_success(array(
    'items' => $items,
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _khach_hang_rest_create() {
  if (!user_access('khach_hang_create')) {
    return _khach_hang_unauthorized('Bạn không có quyền tạo khách hàng');
  }

  $input = _khach_hang_input();

  if (empty($input['ten'])) {
    return _khach_hang_fail('Tên khách hàng bắt buộc');
  }
  $input['ma_kh'] = isset($input['ma_kh']) ? trim((string) $input['ma_kh']) : '';
  if ($input['ma_kh'] === '') {
    return _khach_hang_fail('Tên ngắn gọn bắt buộc');
  }
  if (empty($input['phan_loai'])) {
    return _khach_hang_fail('Phân loại bắt buộc');
  }

  $dupMa = _khach_hang_check_unique_ma(isset($input['ma_kh']) ? $input['ma_kh'] : '');
  if ($dupMa) return $dupMa;

  $dupSdt = _khach_hang_check_unique_sdt($input);
  if ($dupSdt) return $dupSdt;

  $dupCccd = _khach_hang_check_unique_cccd($input);
  if ($dupCccd) return $dupCccd;

  $phan_loai = _khach_hang_normalize_phan_loai($input['phan_loai']);
  $ngan_hang_json = '';
  if (!empty($input['thong_tin_ngan_hang']) && is_array($input['thong_tin_ngan_hang'])) {
    $ngan_hang_json = json_encode($input['thong_tin_ngan_hang']);
  }
  $bang_gia_cuoc_json = '';
  if (!empty($input['bang_gia_cuoc']) && is_array($input['bang_gia_cuoc'])) {
    $bang_gia_items = !empty($input['bang_gia_cuoc']['bang_gia_cuoc']) && is_array($input['bang_gia_cuoc']['bang_gia_cuoc']) ? $input['bang_gia_cuoc']['bang_gia_cuoc'] : array();
    $dinh_muc = !empty($input['bang_gia_cuoc']['dinh_muc']) && is_array($input['bang_gia_cuoc']['dinh_muc']) ? $input['bang_gia_cuoc']['dinh_muc'] : array();
    $bang_gia_cuoc_json = json_encode(_khach_hang_bang_gia_encode($bang_gia_items, $dinh_muc));
  }
  $lien_he_json = !empty($input['thong_tin_lien_he']) && is_array($input['thong_tin_lien_he']) ? json_encode($input['thong_tin_lien_he']) : '';

  $transaction = db_transaction();
  try {
    $nid = db_insert('khach_hang')
      ->fields(array(
        'ten' => $input['ten'],
        'ma_kh' => !empty($input['ma_kh']) ? $input['ma_kh'] : NULL,
        'phan_loai' => $phan_loai,
        'cccd_mst' => !empty($input['cccd_mst']) ? $input['cccd_mst'] : NULL,
        'sdt' => !empty($input['sdt']) ? $input['sdt'] : NULL,
        'email' => !empty($input['email']) ? $input['email'] : NULL,
        'thong_tin_lien_he' => $lien_he_json ? $lien_he_json : NULL,
        'dia_chi' => !empty($input['dia_chi']) ? $input['dia_chi'] : NULL,
        'thong_tin_ngan_hang' => $ngan_hang_json ? $ngan_hang_json : NULL,
        'bang_gia_cuoc' => $bang_gia_cuoc_json ? $bang_gia_cuoc_json : NULL,
        'dob' => !empty($input['dob']) ? $input['dob'] : NULL,
        'ghi_chu' => !empty($input['ghi_chu']) ? $input['ghi_chu'] : NULL,
        'hoat_dong' => 1,
        'created' => date('Y-m-d H:i:s', REQUEST_TIME),
        'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
      ))
      ->execute();

    // Sync nv_kinh_doanh junction table
    _khach_hang_sync_nv_kinh_doanh($nid, isset($input['nv_kinh_doanh']) ? $input['nv_kinh_doanh'] : array());

    watchdog('khach_hang', 'Tạo khách hàng #%id: %ten', array(
      '%id' => $nid,
      '%ten' => $input['ten'],
    ));

    return _khach_hang_success(_khach_hang_load_row($nid, TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('khach_hang', 'Lỗi tạo khách hàng: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _khach_hang_error('Lỗi hệ thống khi tạo khách hàng');
  }
}

/*******************************************************************************
 * REST: ITEM — GET /api/khach-hang/{id}, PUT, DELETE
 ******************************************************************************/

function khach_hang_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _khach_hang_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _khach_hang_rest_get($id);
    case 'PUT':
      return _khach_hang_rest_update($id);
    case 'DELETE':
      return _khach_hang_rest_delete($id);
    default:
      return _khach_hang_method_not_allowed('GET, PUT, DELETE');
  }
}

function _khach_hang_rest_get($id) {
  if (!user_access('khach_hang_view')) {
    return _khach_hang_unauthorized('Bạn không có quyền xem khách hàng');
  }

  $row = _khach_hang_load_row($id, TRUE);
  if (!$row) {
    return _khach_hang_not_found('Khách hàng không tồn tại');
  }
  return _khach_hang_success($row);
}

function _khach_hang_rest_update($id) {
  if (!user_access('khach_hang_create')) {
    return _khach_hang_unauthorized('Bạn không có quyền sửa khách hàng');
  }

  $existing = db_query("SELECT nid FROM {khach_hang} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _khach_hang_not_found('Khách hàng không tồn tại');
  }

  $input = _khach_hang_input();

  if (empty($input['ten'])) {
    return _khach_hang_fail('Tên khách hàng bắt buộc');
  }
  $input['ma_kh'] = isset($input['ma_kh']) ? trim((string) $input['ma_kh']) : '';
  if ($input['ma_kh'] === '') {
    return _khach_hang_fail('Tên ngắn gọn bắt buộc');
  }
  if (empty($input['phan_loai'])) {
    return _khach_hang_fail('Phân loại bắt buộc');
  }

  $dupMa = _khach_hang_check_unique_ma(isset($input['ma_kh']) ? $input['ma_kh'] : '', $id);
  if ($dupMa) return $dupMa;

  $dupSdt = _khach_hang_check_unique_sdt($input, $id);
  if ($dupSdt) return $dupSdt;

  $dupCccd = _khach_hang_check_unique_cccd($input, $id);
  if ($dupCccd) return $dupCccd;

  $phan_loai = _khach_hang_normalize_phan_loai($input['phan_loai']);
  $ngan_hang_json = '';
  if (isset($input['thong_tin_ngan_hang']) && is_array($input['thong_tin_ngan_hang'])) {
    $ngan_hang_json = json_encode($input['thong_tin_ngan_hang']);
  }
  $bang_gia_cuoc_json = '';
  if (isset($input['bang_gia_cuoc']) && is_array($input['bang_gia_cuoc'])) {
    $current_config = _khach_hang_bang_gia_decode(db_query("SELECT bang_gia_cuoc FROM {khach_hang} WHERE nid = :id", array(':id' => $id))->fetchField());
    $bang_gia_items = !empty($input['bang_gia_cuoc']['bang_gia_cuoc']) && is_array($input['bang_gia_cuoc']['bang_gia_cuoc']) ? $input['bang_gia_cuoc']['bang_gia_cuoc'] : array();
    $dinh_muc = !empty($input['bang_gia_cuoc']['dinh_muc']) && is_array($input['bang_gia_cuoc']['dinh_muc']) ? $input['bang_gia_cuoc']['dinh_muc'] : $current_config['dinh_muc'];
    $bang_gia_cuoc_json = json_encode(_khach_hang_bang_gia_encode($bang_gia_items, $dinh_muc));
  }
  $lien_he_json = '';
  if (isset($input['thong_tin_lien_he']) && is_array($input['thong_tin_lien_he'])) $lien_he_json = json_encode($input['thong_tin_lien_he']);

  $update = array(
    'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
    'ten' => $input['ten'],
    'phan_loai' => $phan_loai,
  );

  $fields = array('ma_kh', 'cccd_mst', 'sdt', 'email', 'dia_chi', 'dob', 'ghi_chu');
  foreach ($fields as $f) {
    if (array_key_exists($f, $input)) {
      $update[$f] = !empty($input[$f]) ? $input[$f] : NULL;
    }
  }
  if (isset($input['thong_tin_ngan_hang'])) {
    $update['thong_tin_ngan_hang'] = $ngan_hang_json ? $ngan_hang_json : NULL;
  }
  if (isset($input['bang_gia_cuoc'])) {
    $update['bang_gia_cuoc'] = $bang_gia_cuoc_json ? $bang_gia_cuoc_json : NULL;
  }
  if (isset($input['thong_tin_lien_he'])) $update['thong_tin_lien_he'] = $lien_he_json ? $lien_he_json : NULL;

  $transaction = db_transaction();
  try {
    db_update('khach_hang')
      ->fields($update)
      ->condition('nid', $id)
      ->execute();

    // Sync nv_kinh_doanh junction table
    if (array_key_exists('nv_kinh_doanh', $input)) {
      _khach_hang_sync_nv_kinh_doanh($id, $input['nv_kinh_doanh'] ? $input['nv_kinh_doanh'] : array());
    }

    watchdog('khach_hang', 'Cập nhật khách hàng #%id', array('%id' => $id));

    return _khach_hang_success(_khach_hang_load_row($id, TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('khach_hang', 'Lỗi cập nhật khách hàng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _khach_hang_error('Lỗi hệ thống khi cập nhật khách hàng');
  }
}

function _khach_hang_rest_delete($id) {
  if (!user_access('khach_hang_delete')) {
    return _khach_hang_unauthorized('Bạn không có quyền xoá khách hàng');
  }

  $existing = db_query("SELECT nid, ten FROM {khach_hang} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _khach_hang_not_found('Khách hàng không tồn tại');
  }

  $transaction = db_transaction();
  try {
    db_update('khach_hang')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('nid', $id)
      ->execute();

    // Soft-delete junction records
    db_update('nhan_vien_khach_hang')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('nid', $id)
      ->condition('hoat_dong', 1)
      ->execute();

    watchdog('khach_hang', 'Xoá (soft) khách hàng #%id: %ten', array(
      '%id' => $id,
      '%ten' => $existing->ten,
    ));

    return _khach_hang_success(array('nid' => (int) $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('khach_hang', 'Lỗi xoá khách hàng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _khach_hang_error('Lỗi hệ thống khi xoá khách hàng');
  }
}

/*******************************************************************************
 * REST: ĐỊNH MỨC KHÁCH HÀNG — GET/PUT /api/khach-hang/{id}/dinh-muc
 ******************************************************************************/

function khach_hang_dinh_muc_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _khach_hang_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _khach_hang_dinh_muc_rest_get($id);
    case 'PUT':
      return _khach_hang_dinh_muc_rest_update($id);
    default:
      return _khach_hang_method_not_allowed('GET, PUT');
  }
}

function _khach_hang_dinh_muc_customer($id) {
  return db_query("SELECT nid, ten, ma_kh FROM {khach_hang} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
}

function _khach_hang_dinh_muc_load($id) {
  $json = db_query("SELECT bang_gia_cuoc FROM {khach_hang} WHERE nid = :id", array(':id' => $id))->fetchField();
  $bang_gia_cuoc = _khach_hang_bang_gia_decode($json);
  $data = $bang_gia_cuoc['dinh_muc'];
  $routes = !empty($data['routes']) && is_array($data['routes']) ? $data['routes'] : array();

  return array(
    'routes' => $routes,
  );
}

function _khach_hang_dinh_muc_rest_get($id) {
  if (!user_access('khach_hang_view')) {
    return _khach_hang_unauthorized('Bạn không có quyền xem khách hàng');
  }

  $customer = _khach_hang_dinh_muc_customer($id);
  if (!$customer) {
    return _khach_hang_not_found('Khách hàng không tồn tại');
  }

  $data = _khach_hang_dinh_muc_load($id);
  return _khach_hang_success(array(
    'khach_hang' => array(
      'nid' => (int) $customer->nid,
      'ten' => $customer->ten,
      'ma_kh' => $customer->ma_kh ? $customer->ma_kh : '',
    ),
    'routes' => $data['routes'],
  ));
}

function _khach_hang_dinh_muc_rest_update($id) {
  if (!user_access('khach_hang_create')) {
    return _khach_hang_unauthorized('Bạn không có quyền cấu hình định mức khách hàng');
  }

  $customer = _khach_hang_dinh_muc_customer($id);
  if (!$customer) {
    return _khach_hang_not_found('Khách hàng không tồn tại');
  }

  $input = _khach_hang_input();
  $routes = !empty($input['routes']) && is_array($input['routes']) ? $input['routes'] : array();

  $transaction = db_transaction();
  try {
    $now = _khach_hang_now();
    $clean_routes = array();
    $seen_pairs = array();
    foreach ($routes as $route) {
      if (!is_array($route)) continue;
      $from = !empty($route['from']) && is_array($route['from']) ? $route['from'] : array();
      $to = !empty($route['to']) && is_array($route['to']) ? $route['to'] : array();
      $clean_from = array();
      $clean_to = array();

      foreach ($from as $name) {
        $name = trim((string) $name);
        if ($name !== '' && !in_array($name, $clean_from, TRUE)) {
          $clean_from[] = $name;
        }
      }
      foreach ($to as $name) {
        $name = trim((string) $name);
        if ($name !== '' && !in_array($name, $clean_to, TRUE)) {
          $clean_to[] = $name;
        }
      }
      if (empty($clean_from) || empty($clean_to)) continue;

      $km = _khach_hang_num_or_null(isset($route['km']) ? $route['km'] : NULL);
      $t = _khach_hang_int_value(isset($route['t']) ? $route['t'] : 0);
      $v = _khach_hang_int_value(isset($route['v']) ? $route['v'] : 0);
      $h = _khach_hang_int_value(isset($route['h']) ? $route['h'] : 0);

      $has_duplicate_pair = FALSE;
      foreach ($clean_from as $from_name) {
        foreach ($clean_to as $to_name) {
          $pair_key = drupal_strtolower($from_name) . '=>' . drupal_strtolower($to_name);
          if (!empty($seen_pairs[$pair_key])) {
            $has_duplicate_pair = TRUE;
            break 2;
          }
        }
      }
      if ($has_duplicate_pair) continue;

      foreach ($clean_from as $from_name) {
        foreach ($clean_to as $to_name) {
          $seen_pairs[drupal_strtolower($from_name) . '=>' . drupal_strtolower($to_name)] = TRUE;
        }
      }

      $clean_routes[] = array(
        'from' => $clean_from,
        'to' => $clean_to,
        'km' => $km === NULL ? 0 : (float) $km,
        't' => $t,
        'v' => $v,
        'h' => $h,
      );
    }

    $current_config = _khach_hang_bang_gia_decode(db_query("SELECT bang_gia_cuoc FROM {khach_hang} WHERE nid = :id", array(':id' => $id))->fetchField());
    $next_config = _khach_hang_bang_gia_encode($current_config['bang_gia_cuoc'], array('routes' => $clean_routes));
    db_update('khach_hang')
      ->fields(array(
        'bang_gia_cuoc' => json_encode($next_config),
        'changed' => $now,
      ))
      ->condition('nid', $id)
      ->execute();

    watchdog('khach_hang', 'Cập nhật định mức khách hàng #%id', array('%id' => $id));
    $data = _khach_hang_dinh_muc_load($id);
    return _khach_hang_success(array(
      'khach_hang' => array(
        'nid' => (int) $customer->nid,
        'ten' => $customer->ten,
        'ma_kh' => $customer->ma_kh ? $customer->ma_kh : '',
      ),
      'routes' => $data['routes'],
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('khach_hang', 'Lỗi cập nhật định mức khách hàng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _khach_hang_error('Lỗi hệ thống khi cập nhật định mức');
  }
}

/*******************************************************************************
 * UI PAGE CALLBACKS
 ******************************************************************************/

function khach_hang_page_list() {
  khach_hang_add_modal_assets(FALSE, TRUE);
  return theme('khach_hang_list_page');
}

function khach_hang_add_modal_assets($with_modal_html = TRUE, $with_xlsx = FALSE) {
  $module_path = drupal_get_path('module', 'khach_hang');
  $css_path = $module_path . '/assets/css/khach_hang.css';
  $xlsx_path = $module_path . '/assets/vendor/xlsx.full.min.js';
  $js_path = $module_path . '/assets/js/khach_hang.js';
  $css_version = file_exists($css_path) ? filemtime($css_path) . '-' . filesize($css_path) : REQUEST_TIME;
  $xlsx_version = file_exists($xlsx_path) ? filemtime($xlsx_path) . '-' . filesize($xlsx_path) : REQUEST_TIME;
  $js_version = file_exists($js_path) ? filemtime($js_path) . '-' . filesize($js_path) : REQUEST_TIME;

  drupal_add_css($css_path, array(
    'type' => 'file',
    'group' => CSS_THEME,
    'weight' => 100,
    'preprocess' => FALSE,
    'version' => $css_version,
  ));
  if ($with_xlsx) {
    drupal_add_js($xlsx_path, array(
      'type' => 'file',
      'scope' => 'footer',
      'weight' => -10,
      'preprocess' => FALSE,
      'version' => $xlsx_version,
    ));
  }
  drupal_add_js($js_path, array(
    'type' => 'file',
    'group' => JS_THEME,
    'scope' => 'footer',
    'weight' => 1,
    'preprocess' => FALSE,
    'version' => $js_version,
  ));

  drupal_add_js(array('khach_hang' => array(
    'modal_html' => $with_modal_html ? khach_hang_modal_html() : '',
    'permissions' => array(
      'khach_hang_view' => user_access('khach_hang_view'),
      'khach_hang_create' => user_access('khach_hang_create'),
      'khach_hang_delete' => user_access('khach_hang_delete'),
    ),
  )), 'setting');
}
