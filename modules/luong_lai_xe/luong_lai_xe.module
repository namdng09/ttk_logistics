<?php

// Tiện ích dùng chung (khuôn phản hồi, xác thực bằng token, phân trang): module api_common. Nạp thẳng file khi module chưa bật để
// API không hỏng nếu quên bật (bật module vẫn cần để xác thực bằng token hoạt động ở hook_init).
if (!function_exists('api_response_success')) {
  require_once dirname(__FILE__) . '/../api_common/api_common.module';
}

/**
 * @file
 * Lương lái xe - report from kế hoạch, định mức khoán and chi phí.
 */

function luong_lai_xe_permission() {
  return array(
    'luong_lai_xe_view' => array('title' => t('Xem lương lái xe')),
    'luong_lai_xe_create' => array('title' => t('Tạo/sửa lương lái xe')),
    'luong_lai_xe_delete' => array('title' => t('Xoá lương lái xe')),
    'luong_lai_xe_pay' => array('title' => t('Thanh toán lương lái xe')),
  );
}

function luong_lai_xe_init() {
  $path = current_path();
  if (strpos($path, 'api/luong-lai-xe') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

function luong_lai_xe_menu() {
  $items = array();

  $items['api/luong-lai-xe'] = array(
    'page callback' => 'luong_lai_xe_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/luong-lai-xe/%'] = array(
    'page callback' => 'luong_lai_xe_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/luong-lai-xe/%/tam-ung'] = array(
    'page callback' => 'luong_lai_xe_tam_ung_api',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/luong-lai-xe/%/thanh-toan'] = array(
    'page callback' => 'luong_lai_xe_thanh_toan_api',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/luong-lai-xe/%/khau-tru'] = array(
    'page callback' => 'luong_lai_xe_khau_tru_api',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/luong-lai-xe/%/lich-su-tam-ung'] = array(
    'page callback' => 'luong_lai_xe_lich_su_tam_ung_api',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['luong-lai-xe'] = array(
    'title' => 'Lương lái xe',
    'page callback' => 'luong_lai_xe_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['luong-lai-xe/pdf/%'] = array(
    'title' => 'Phiếu lương lái xe',
    'page callback' => 'luong_lai_xe_print',
    'page arguments' => array(2),
    'access callback' => 'user_is_logged_in',
    'type' => MENU_CALLBACK,
  );

  return $items;
}

function luong_lai_xe_theme() {
  $path = drupal_get_path('module', 'luong_lai_xe') . '/templates';
  return array(
    'luong_lai_xe_list_page' => array(
      'template' => 'luong-lai-xe-list',
      'path' => $path,
    ),
  );
}

function luong_lai_xe_page_list() {
  if (!api_has_permission('luong_lai_xe_view') && !api_has_permission('administer permissions')) {
    return api_denied_page('Bạn không có quyền xem lương lái xe');
  }
  // version theo thời điểm sửa file: nạp bản mới là URL đổi, trình duyệt không giữ JS/CSS cũ.
  $llx_path = drupal_get_path('module', 'luong_lai_xe');
  $llx_css = $llx_path . '/assets/css/luong_lai_xe.css';
  $llx_js = $llx_path . '/assets/js/luong_lai_xe.js';
  drupal_add_css($llx_css, array('preprocess' => FALSE, 'version' => file_exists($llx_css) ? filemtime($llx_css) . '-' . filesize($llx_css) : REQUEST_TIME));
  drupal_add_js($llx_js, array('group' => JS_THEME, 'weight' => 2, 'preprocess' => FALSE, 'version' => file_exists($llx_js) ? filemtime($llx_js) . '-' . filesize($llx_js) : REQUEST_TIME));
  drupal_add_js(array('luong_lai_xe' => array(
    'permissions' => array(
      'view' => api_has_permission('luong_lai_xe_view'),
      'create' => api_has_permission('luong_lai_xe_create'),
      'delete' => api_has_permission('luong_lai_xe_delete'),
      // Khớp _luong_lai_xe_require_permission(): server cho cả 'administer permissions'.
      'pay' => api_has_permission('luong_lai_xe_pay') || api_has_permission('administer permissions'),
    ),
  )), 'setting');

  return theme('luong_lai_xe_list_page');
}

function luong_lai_xe_tam_ung_api($nid_lai_xe) {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _luong_lai_xe_tam_ung_history($nid_lai_xe);
    case 'POST':
      return _luong_lai_xe_tam_ung_create($nid_lai_xe);
    default:
      return _luong_lai_xe_method_not_allowed('GET, POST');
  }
}

function luong_lai_xe_thanh_toan_api($nid_lai_xe) {
  if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    return _luong_lai_xe_method_not_allowed('POST');
  }
  return _luong_lai_xe_thanh_toan_luong($nid_lai_xe);
}

function luong_lai_xe_khau_tru_api($nid_lai_xe) {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _luong_lai_xe_khau_tru_form($nid_lai_xe);
    case 'POST':
      return _luong_lai_xe_khau_tru_save($nid_lai_xe);
    default:
      return _luong_lai_xe_method_not_allowed('GET, POST');
  }
}

function luong_lai_xe_lich_su_tam_ung_api($nid_lai_xe) {
  if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
    return _luong_lai_xe_method_not_allowed('GET');
  }
  return _luong_lai_xe_lich_su_tam_ung($nid_lai_xe);
}

function _luong_lai_xe_input() {
  return api_request_input();
}

function luong_lai_xe_rest_collection() {
  if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
    return _luong_lai_xe_method_not_allowed('GET');
  }
  return _luong_lai_xe_rest_list();
}

function luong_lai_xe_rest_item($nid_lai_xe) {
  if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
    return _luong_lai_xe_method_not_allowed('GET');
  }
  $account = _luong_lai_xe_require_permission('luong_lai_xe_view');
  if (is_array($account)) {
    return $account;
  }
  $nid_lai_xe = (int) $nid_lai_xe;
  if (!$nid_lai_xe) {
    return _luong_lai_xe_fail('ID lái xe không hợp lệ');
  }
  return _luong_lai_xe_success(_luong_lai_xe_driver_detail($nid_lai_xe, _luong_lai_xe_filters()));
}

function _luong_lai_xe_rest_list() {
  $account = _luong_lai_xe_require_permission('luong_lai_xe_view');
  if (is_array($account)) {
    return $account;
  }

  $filters = _luong_lai_xe_filters();
  $rows = _luong_lai_xe_plan_rows($filters);
  $grouped = array();
  // Nạp sẵn cho cả danh sách: lái xe + hoàn chi phí (mỗi loại 1 truy vấn), tránh truy vấn theo từng chuyến.
  $plan_ids = $driver_ids = array();
  foreach ($rows as $row) {
    $plan_ids[] = (int) $row->nid;
    $driver_ids[] = (int) $row->nid_lai_xe;
  }
  _luong_lai_xe_preload_drivers($driver_ids);
  $hoan_map = _luong_lai_xe_hoan_chi_phi_map($plan_ids);

  foreach ($rows as $row) {
    $record = _luong_lai_xe_plan_salary_record($row, TRUE, $hoan_map);
    if (empty($record['lai_xe']['nid'])) {
      continue;
    }
    $ky_luong = _luong_lai_xe_plan_ky_luong($row);
    if (!$ky_luong) {
      continue;
    }
    $key = (int) $record['lai_xe']['nid'] . ':' . $ky_luong;
    if (!isset($grouped[$key])) {
      $grouped[$key] = _luong_lai_xe_empty_driver_summary($record['lai_xe']);
      $grouped[$key]['ky_luong'] = $ky_luong;
      $grouped[$key]['ky_luong_display'] = _luong_lai_xe_ky_luong_display($ky_luong);
    }
    _luong_lai_xe_add_plan_to_summary($grouped[$key], $record);
  }

  // Tạm ứng (đã chi), khấu trừ, đã thanh toán (trừ phiếu huỷ) theo (lái xe, kỳ): mỗi loại 1 truy vấn cho cả danh sách.
  $g_drivers = $g_periods = array();
  foreach ($grouped as $summary) {
    $g_drivers[] = (int) $summary['lai_xe']['nid'];
    $g_periods[] = (string) $summary['ky_luong'];
  }
  $tam_ung_map = _luong_lai_xe_sum_by_driver_period('bcllx_tam_ung_lai_xe', $g_drivers, $g_periods, array('=', 'da_chi'));
  $khau_tru_map = _luong_lai_xe_sum_by_driver_period('bcllx_tam_ung_khau_tru', $g_drivers, $g_periods, array('=', 'da_chi'));
  $thanh_toan_map = _luong_lai_xe_sum_by_driver_period('llx_thanh_toan_luong', $g_drivers, $g_periods, array('<>', 'huy'));

  foreach ($grouped as &$summary) {
    $gk = (int) $summary['lai_xe']['nid'] . ':' . $summary['ky_luong'];
    $summary['tam_ung_da_chi'] = isset($tam_ung_map[$gk]) ? $tam_ung_map[$gk] : 0;
    $summary['khau_tru_da_tru'] = isset($khau_tru_map[$gk]) ? $khau_tru_map[$gk] : 0;
    $summary['khau_tru_tam_ung'] = min((int) $summary['luong_tam_tinh'], (int) $summary['khau_tru_da_tru']);
    $summary['luong_chot'] = (int) $summary['luong_tam_tinh'];
    $summary['thuc_lanh'] = max(0, (int) $summary['luong_chot'] - (int) $summary['khau_tru_tam_ung']);
    $summary['da_thanh_toan'] = isset($thanh_toan_map[$gk]) ? $thanh_toan_map[$gk] : 0;
    $summary['luong_phai_tra'] = max(0, (int) $summary['thuc_lanh'] - (int) $summary['da_thanh_toan']);
    $summary['tra_thua'] = max(0, (int) $summary['da_thanh_toan'] - (int) $summary['thuc_lanh']);
    unset($summary['plans'], $summary['tam_ung_items'], $summary['khau_tru_items']);
  }
  unset($summary);

  $items = array_values($grouped);
  usort($items, '_luong_lai_xe_sort_summary');

  // Trạng thái trả lương từng dòng (lái xe + kỳ) + số lượng theo trạng thái (tab) + dải tổng — tính trên cả danh sách đã lọc,
  // trước khi lọc theo tab và cắt trang.
  $counts = array('all' => 0, 'chua_tra' => 0, 'tra_mot_phan' => 0, 'da_tra' => 0, 'tra_thua' => 0);
  $tong = array('tong_luong' => 0, 'tam_ung' => 0, 'khau_tru' => 0, 'thuc_lanh' => 0, 'da_thanh_toan' => 0, 'con_phai_tra' => 0, 'tra_thua' => 0, 'cho_hoan' => 0);
  foreach ($items as &$item) {
    $item['trang_thai_tra'] = _luong_lai_xe_payment_status($item);
    $counts['all']++;
    $counts[$item['trang_thai_tra']]++;
    $tong['tong_luong'] += (int) $item['luong_chot'];
    $tong['tam_ung'] += (int) $item['tam_ung_da_chi'];
    $tong['khau_tru'] += (int) $item['khau_tru_tam_ung'];
    $tong['thuc_lanh'] += (int) $item['thuc_lanh'];
    $tong['da_thanh_toan'] += (int) $item['da_thanh_toan'];
    $tong['con_phai_tra'] += (int) $item['luong_phai_tra'];
    $tong['tra_thua'] += (int) $item['tra_thua'];
    $tong['cho_hoan'] += (int) $item['hoan_chi_phi_cho_hoan'];
  }
  unset($item);
  $tab = isset($_GET['trang_thai_tra']) ? (string) $_GET['trang_thai_tra'] : '';
  if (isset($counts[$tab]) && $tab !== 'all') {
    $items = array_values(array_filter($items, function ($i) use ($tab) { return $i['trang_thai_tra'] === $tab; }));
  }

  $page = api_page_number();
  $limit = api_page_limit(20, 100);
  $total = count($items);
  $items = array_slice($items, ($page - 1) * $limit, $limit);

  return _luong_lai_xe_success(array(
    'items' => $items,
    'total' => $total,
    'current_page' => $total ? $page : 0,
    'total_pages' => $total ? (int) ceil($total / $limit) : 0,
    'limit' => $limit,
    'status_counts' => $counts,
    'tong' => $tong,
  ));
}

function luong_lai_xe_print($nid_lai_xe) {
  if (!api_has_permission('luong_lai_xe_view')) {
    drupal_access_denied();
    return;
  }
  $detail = _luong_lai_xe_driver_detail((int) $nid_lai_xe, _luong_lai_xe_filters());
  $html = _luong_lai_xe_print_html($detail);
  $driver = !empty($detail['lai_xe']['ten']) ? $detail['lai_xe']['ten'] : 'lai-xe';
  $ky_luong = !empty($detail['filters']['ky_luong']) ? $detail['filters']['ky_luong'] : date('Ym', REQUEST_TIME);
  $filename = 'luong-lai-xe-' . preg_replace('/[^A-Za-z0-9\-_]/', '-', $driver) . '-' . $ky_luong . '.pdf';
  $library = _luong_lai_xe_load_pdf_library();

  if ($library === 'dompdf') {
    $options = new \Dompdf\Options();
    $options->set('isRemoteEnabled', TRUE);
    $options->set('isHtml5ParserEnabled', TRUE);
    $options->set('defaultFont', 'DejaVu Sans');
    $options->set('tempDir', file_directory_temp());
    $dompdf = new \Dompdf\Dompdf($options);
    $dompdf->loadHtml($html, 'UTF-8');
    $dompdf->setPaper('A4', 'portrait');
    $dompdf->render();
    drupal_add_http_header('Content-Type', 'application/pdf');
    drupal_add_http_header('Content-Disposition', 'attachment; filename="' . $filename . '"');
    print $dompdf->output();
    drupal_exit();
  }

  if ($library === 'mpdf') {
    $mpdf = new \Mpdf\Mpdf(array(
      'mode' => 'utf-8',
      'format' => 'A4',
      'default_font' => 'dejavusans',
      'margin_left' => 8,
      'margin_right' => 8,
      'margin_top' => 8,
      'margin_bottom' => 8,
    ));
    $mpdf->WriteHTML($html);
    $mpdf->Output($filename, \Mpdf\Output\Destination::DOWNLOAD);
    drupal_exit();
  }

  drupal_add_http_header('Content-Type', 'text/html; charset=utf-8');
  print '<div style="padding:12px;background:#fff3cd;border:1px solid #ffe69c;margin-bottom:12px;font-family:Arial">Máy chủ chưa có thư viện Dompdf hoặc mPDF. Có thể dùng chức năng in của trình duyệt để lưu PDF.</div>';
  print $html;
  drupal_exit();
}

function _luong_lai_xe_filters() {
  $now = date('Y-m-d', REQUEST_TIME);
  $ky_luong = !empty($_GET['ky_luong']) ? _luong_lai_xe_normalize_ky_luong($_GET['ky_luong']) : '';
  if ($ky_luong) {
    $bounds = _luong_lai_xe_month_bounds($ky_luong);
    $from = $bounds['date_from'];
    $to = $bounds['date_to'];
  }
  else {
    $from = !empty($_GET['date_from']) ? _luong_lai_xe_date_only($_GET['date_from']) : date('Y-m-01', REQUEST_TIME);
    $to = !empty($_GET['date_to']) ? _luong_lai_xe_date_only($_GET['date_to']) : $now;
    $ky_luong = str_replace('-', '', substr($from, 0, 7));
  }
  if ($from && $to && $from > $to) {
    $tmp = $from;
    $from = $to;
    $to = $tmp;
  }
  return array(
    'date_from' => $from,
    'date_to' => $to,
    'ky_luong' => $ky_luong,
    'nid_lai_xe' => !empty($_GET['nid_lai_xe']) ? (int) $_GET['nid_lai_xe'] : 0,
    'keyword' => !empty($_GET['keyword']) ? trim((string) $_GET['keyword']) : '',
    'only_completed' => isset($_GET['only_completed']) ? (int) $_GET['only_completed'] : 1,
  );
}

function _luong_lai_xe_plan_rows(array $filters) {
  if (!db_table_exists('ke_hoach_xep_xe')) {
    return array();
  }
  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->fields('kh');
  $query->condition('kh.hoat_dong', 1);
  if (db_table_exists('lai_xe')) {
    $query->leftJoin('lai_xe', 'lx', 'lx.nid = kh.nid_lai_xe');
  }
  if (!isset($filters['only_completed']) || !empty($filters['only_completed'])) {
    $query->condition('kh.trang_thai_van_chuyen', 'Hoàn thành');
  }
  if (!empty($filters['nid_lai_xe'])) {
    $query->condition('kh.nid_lai_xe', (int) $filters['nid_lai_xe']);
  }
  if (!empty($filters['keyword'])) {
    $like = '%' . db_like($filters['keyword']) . '%';
    $or = db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.dia_chi_kho', $like, 'LIKE')
      ->condition('kh.bai_lay_cont', $like, 'LIKE')
      ->condition('kh.bai_ha_cont', $like, 'LIKE');
    if (db_table_exists('lai_xe')) {
      $or->condition('lx.ten', $like, 'LIKE')
        ->condition('lx.ma_nhan_vien', $like, 'LIKE')
        ->condition('lx.sdt', $like, 'LIKE')
        ->condition('lx.thong_tin_ngan_hang', $like, 'LIKE');
    }
    $query->condition($or);
  }
  // Lọc kỳ lương ngay trong SQL (trước đây tải mọi chuyến hoàn thành rồi lọc bằng PHP) — cùng thứ tự ưu tiên ngày với
  // _luong_lai_xe_plan_date(): ngày kết thúc → cut-off → ngày bắt đầu → ngày tạo.
  $date_sql = _luong_lai_xe_plan_date_sql('kh');
  if (!empty($filters['date_from'])) {
    $query->where("$date_sql >= :llx_from", array(':llx_from' => $filters['date_from']));
  }
  if (!empty($filters['date_to'])) {
    $query->where("$date_sql <= :llx_to", array(':llx_to' => $filters['date_to']));
  }
  $query->orderBy('kh.created', 'DESC');
  return $query->execute()->fetchAll();
}

/** Biểu thức SQL "ngày tính kỳ lương" của kế hoạch — khớp _luong_lai_xe_plan_date(). */
function _luong_lai_xe_plan_date_sql($alias = 'kh') {
  return "COALESCE(NULLIF($alias.ngay_ket_thuc, ''), NULLIF(SUBSTRING($alias.cut_off, 1, 10), ''), NULLIF($alias.ngay_bat_dau, ''), SUBSTRING($alias.created, 1, 10))";
}

/**
 * Lương 1 chuyến. $light: dùng cho danh sách (không tính chi phí từng dòng, không dựng thông tin kế hoạch).
 * $hoan_map: kết quả _luong_lai_xe_hoan_chi_phi_map() đã tính sẵn cho cả trang (NULL = tự tính riêng chuyến này).
 */
function _luong_lai_xe_plan_salary_record($row, $light = FALSE, $hoan_map = NULL) {
  $json = _luong_lai_xe_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '');
  $mode = _luong_lai_xe_salary_mode($row, $json);
  $dinh_muc = _luong_lai_xe_dinh_muc_total($json);
  $luong_chuyen = _luong_lai_xe_trip_salary($json);
  $salary = $mode === 'khoan' ? $dinh_muc : $luong_chuyen;
  if ($hoan_map === NULL) {
    $hoan_map = _luong_lai_xe_hoan_chi_phi_map(array((int) $row->nid));
  }
  $hoan = isset($hoan_map[(int) $row->nid]) ? (int) $hoan_map[(int) $row->nid]['da_hoan'] : 0;
  $cho_hoan = isset($hoan_map[(int) $row->nid]) ? (int) $hoan_map[(int) $row->nid]['cho_hoan'] : 0;

  $record = array(
    'salary_base' => $salary,
    'luong_ke_hoach' => $salary,
    'salary_estimate' => $salary,
    'dinh_muc_khoan' => $dinh_muc,
    'luong_chuyen' => $luong_chuyen,
    'chi_phi' => $light ? array('items' => array(), 'tong' => 0) : _luong_lai_xe_plan_costs((int) $row->nid, FALSE),
    // Hoàn chi phí: tiền công ty đã trả lại cho lái xe qua đề nghị thanh toán (chỉ đối chiếu, không cộng vào lương).
    'de_nghi' => array('da_thanh_toan' => $hoan, 'tong' => $hoan, 'cho_hoan' => $cho_hoan, 'items' => array()),
  );
  if (!$light) {
    $record['ke_hoach'] = _luong_lai_xe_plan_object($row, $json);
  }
  $record['lai_xe'] = _luong_lai_xe_driver_object((int) $row->nid_lai_xe);
  return $record;
}

function _luong_lai_xe_plan_costs($nid_ke_hoach, $light = FALSE) {
  $result = array(
    'lai_xe_tu_chiu' => 0,
    'tong' => 0,
    'items' => array(),
  );
  if (!db_table_exists('ke_hoach_chi_phi')) {
    return $result;
  }
  if ($light) {
    $rows = db_select('ke_hoach_chi_phi', 'c')
      ->fields('c', array('loai_chi_phi', 'tong_sau_vat'))
      ->condition('c.nid_ke_hoach', (int) $nid_ke_hoach)
      ->condition('c.hoat_dong', 1)
      ->execute()
      ->fetchAll();
    foreach ($rows as $row) {
      $amount = (int) $row->tong_sau_vat;
      $type = (string) $row->loai_chi_phi;
      if ($type === 'tinh_cho_khach' || $type === 'cong_ty_chi_tra') {
        $type = 'bo_qua_luong';
      }
      if ($type !== 'bo_qua_luong') {
        if (!isset($result[$type])) {
          $result[$type] = 0;
        }
        $result[$type] += $amount;
        $result['tong'] += $amount;
      }
    }
    return $result;
  }
  $rows = db_select('ke_hoach_chi_phi', 'c')
    ->fields('c')
    ->condition('c.nid_ke_hoach', (int) $nid_ke_hoach)
    ->condition('c.hoat_dong', 1)
    ->orderBy('c.created', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $amount = (int) $row->tong_sau_vat;
    $type = (string) $row->loai_chi_phi;
    if ($type === 'tinh_cho_khach' || $type === 'cong_ty_chi_tra') {
      $type = 'bo_qua_luong';
    }
    if ($type !== 'bo_qua_luong' && !isset($result[$type])) {
      $result[$type] = 0;
    }
    if ($type !== 'bo_qua_luong') {
      $result[$type] += $amount;
      $result['tong'] += $amount;
    }
    $item = (array) $row;
    $item['loai_chi_phi'] = $type;
    $result['items'][] = $item;
  }
  return $result;
}

/**
 * Hoàn chi phí theo từng kế hoạch (chỉ đối chiếu, không cộng vào lương), 1 truy vấn cho cả danh sách kế hoạch:
 *   da_hoan:  dòng chi phí nằm trong đề nghị thanh toán ĐÃ HOÀN THÀNH mà bên nhận tiền là chính lái xe của chuyến
 *             (loại `lai_xe` = nid lái xe, hoặc `nhan_vien` = tài khoản của lái xe đó).
 *   cho_hoan: dòng KH/CT có bên nhận tiền (trên dòng) là chính lái xe đó nhưng chưa có đề nghị hoặc đề nghị chưa hoàn thành
 *             — công ty còn nợ lái xe khoản này.
 * Trả về map nid kế hoạch => array('da_hoan' => int, 'cho_hoan' => int).
 */
function _luong_lai_xe_hoan_chi_phi_map(array $plan_ids) {
  $plan_ids = array_values(array_unique(array_filter(array_map('intval', $plan_ids))));
  $map = array();
  if (!$plan_ids || !db_table_exists('de_nghi_thanh_toan') || !db_table_exists('ke_hoach_chi_phi') || !db_field_exists('ke_hoach_chi_phi', 'nid_de_nghi_chi_phi')) {
    return $map;
  }
  $line_payee = db_field_exists('ke_hoach_chi_phi', 'loai_ben_nhan_tien')
    ? "((c.loai_ben_nhan_tien = 'lai_xe' AND c.id_ben_nhan_tien = k.nid_lai_xe)
        OR (c.loai_ben_nhan_tien = 'nhan_vien' AND lx.uid_nguoi_dung > 0 AND c.id_ben_nhan_tien = lx.uid_nguoi_dung))"
    : '0 = 1';
  $dn_payee = "((d.loai_ben_nhan_tien = 'lai_xe' AND d.id_ben_nhan_tien = k.nid_lai_xe)
        OR (d.loai_ben_nhan_tien = 'nhan_vien' AND lx.uid_nguoi_dung > 0 AND d.id_ben_nhan_tien = lx.uid_nguoi_dung))";
  $da = "d.nid IS NOT NULL AND d.trang_thai = 'hoan_thanh' AND $dn_payee";
  $cho = "(d.nid IS NULL OR d.trang_thai <> 'hoan_thanh') AND c.loai_chi_phi IN ('tinh_cho_khach', 'cong_ty_chi_tra') AND $line_payee";
  $rows = db_query("SELECT c.nid_ke_hoach AS pid,
      SUM(CASE WHEN $da THEN c.tong_sau_vat ELSE 0 END) AS da_hoan,
      SUM(CASE WHEN $cho THEN c.tong_sau_vat ELSE 0 END) AS cho_hoan
    FROM {ke_hoach_chi_phi} c
    INNER JOIN {ke_hoach_xep_xe} k ON k.nid = c.nid_ke_hoach
    LEFT JOIN {lai_xe} lx ON lx.nid = k.nid_lai_xe
    LEFT JOIN {de_nghi_thanh_toan} d ON d.nid = c.nid_de_nghi_chi_phi AND d.hoat_dong = 1
    WHERE c.hoat_dong = 1 AND c.nid_ke_hoach IN (:ids) AND (($da) OR ($cho))
    GROUP BY c.nid_ke_hoach", array(':ids' => $plan_ids));
  foreach ($rows as $r) $map[(int) $r->pid] = array('da_hoan' => (int) $r->da_hoan, 'cho_hoan' => (int) $r->cho_hoan);
  return $map;
}

/**
 * Lý do khoá sửa định mức khoán của 1 kế hoạch (NULL = được sửa): chuyến Hoàn thành thuộc kỳ lương (lái xe + tháng) đã có phiếu
 * trả lương chưa huỷ (chờ duyệt hoặc đã chi). ke_hoach_xep_xe gọi khi lưu định mức hàng cảng. Phiếu còn chờ duyệt thì
 * "Không duyệt" ở Thu chi (phiếu trả lương về `huy`) là mở khoá.
 */
function luong_lai_xe_dinh_muc_lock_reason($plan_row) {
  if (!$plan_row || empty($plan_row->nid_lai_xe) || !db_table_exists('llx_thanh_toan_luong')) return NULL;
  if ((string) (isset($plan_row->trang_thai_van_chuyen) ? $plan_row->trang_thai_van_chuyen : '') !== 'Hoàn thành') return NULL;
  $ky = _luong_lai_xe_plan_ky_luong($plan_row);
  if (!$ky) return NULL;
  $statuses = db_query("SELECT DISTINCT trang_thai FROM {llx_thanh_toan_luong} WHERE nid_lai_xe = :lx AND thang_luong = :ky AND trang_thai <> 'huy'",
    array(':lx' => (int) $plan_row->nid_lai_xe, ':ky' => $ky))->fetchCol();
  if (!$statuses) return NULL;
  $msg = 'Kỳ lương ' . _luong_lai_xe_ky_luong_display($ky) . ' của lái xe ' . _luong_lai_xe_driver_label((int) $plan_row->nid_lai_xe);
  if (in_array('cho_duyet', $statuses, TRUE)) {
    return $msg . ' đang có phiếu trả lương chờ duyệt nên không sửa được định mức. Muốn sửa thì "Không duyệt" phiếu đó ở Thu chi trước.';
  }
  return $msg . ' đã trả lương nên không sửa được định mức chuyến này.';
}

/**
 * Trạng thái trả lương của 1 dòng (lái xe + kỳ): tra_thua (đã trả quá thực lĩnh — vd giảm định mức sau khi trả), da_tra (vừa đủ),
 * chua_tra (chưa trả đồng nào), tra_mot_phan.
 */
function _luong_lai_xe_payment_status(array $summary) {
  if (!empty($summary['tra_thua'])) return 'tra_thua';
  if ((int) $summary['luong_phai_tra'] <= 0) return 'da_tra';
  return (int) $summary['da_thanh_toan'] > 0 ? 'tra_mot_phan' : 'chua_tra';
}

function _luong_lai_xe_empty_driver_summary(array $driver) {
  return array(
    'lai_xe' => $driver,
    'so_ke_hoach' => 0,
    'tong_luong_ke_hoach' => 0,
    'hoan_chi_phi_da_thanh_toan' => 0,
    'hoan_chi_phi_cho_hoan' => 0,
    'tam_ung_da_chi' => 0,
    'khau_tru_tam_ung' => 0,
    'luong_tam_tinh' => 0,
    'luong_chot' => 0,
    'thuc_lanh' => 0,
    'plans' => array(),
    'tam_ung_items' => array(),
    'khau_tru_items' => array(),
    'khau_tru_da_tru' => 0,
    'da_thanh_toan' => 0,
    'luong_phai_tra' => 0,
    'tra_thua' => 0,
    'thanh_toan_items' => array(),
  );
}

function _luong_lai_xe_add_plan_to_summary(array &$summary, array $record) {
  $summary['so_ke_hoach']++;
  $summary['tong_luong_ke_hoach'] += (int) $record['luong_ke_hoach'];
  $summary['hoan_chi_phi_da_thanh_toan'] += (int) $record['de_nghi']['da_thanh_toan'];
  $summary['hoan_chi_phi_cho_hoan'] += (int) $record['de_nghi']['cho_hoan'];
  $summary['luong_tam_tinh'] += (int) $record['luong_ke_hoach'];
  $summary['plans'][] = $record;
}

function _luong_lai_xe_driver_detail($nid_lai_xe, array $filters) {
  $filters['nid_lai_xe'] = $nid_lai_xe;
  $summary = _luong_lai_xe_empty_driver_summary(_luong_lai_xe_driver_object($nid_lai_xe));
  $plan_rows = _luong_lai_xe_plan_rows($filters);
  $plan_ids = array();
  foreach ($plan_rows as $row) $plan_ids[] = (int) $row->nid;
  $hoan_map = _luong_lai_xe_hoan_chi_phi_map($plan_ids);
  foreach ($plan_rows as $row) {
    _luong_lai_xe_add_plan_to_summary($summary, _luong_lai_xe_plan_salary_record($row, FALSE, $hoan_map));
  }
  $summary['tam_ung_items'] = _luong_lai_xe_tam_ung_rows($nid_lai_xe, $filters);
  $summary['tam_ung_da_chi'] = _luong_lai_xe_sum_ledgers($summary['tam_ung_items']);
  $summary['khau_tru_items'] = _luong_lai_xe_khau_tru_rows($nid_lai_xe, $filters);
  $summary['khau_tru_da_tru'] = _luong_lai_xe_sum_khau_tru($summary['khau_tru_items']);
  $summary['khau_tru_tam_ung'] = min((int) $summary['luong_tam_tinh'], (int) $summary['khau_tru_da_tru']);
  $summary['luong_chot'] = (int) $summary['luong_tam_tinh'];
  $summary['thuc_lanh'] = max(0, (int) $summary['luong_chot'] - (int) $summary['khau_tru_tam_ung']);
  $ky_luong = !empty($filters['ky_luong']) ? (string) $filters['ky_luong'] : '';
  $summary['da_thanh_toan'] = _luong_lai_xe_thanh_toan_sum($nid_lai_xe, $ky_luong);
  $summary['luong_phai_tra'] = max(0, (int) $summary['thuc_lanh'] - (int) $summary['da_thanh_toan']);
  $summary['tra_thua'] = max(0, (int) $summary['da_thanh_toan'] - (int) $summary['thuc_lanh']);
  $summary['trang_thai_tra'] = _luong_lai_xe_payment_status($summary);
  $summary['thanh_toan_items'] = _luong_lai_xe_thanh_toan_rows($nid_lai_xe, $ky_luong);
  $summary['filters'] = $filters;
  $summary['ky_luong'] = $ky_luong;
  $summary['ky_luong_display'] = _luong_lai_xe_period_display($filters);
  return $summary;
}

function _luong_lai_xe_plan_ky_luong($row) {
  $date = _luong_lai_xe_plan_date($row);
  if (preg_match('/^(\d{4})-(\d{2})-\d{2}$/', $date, $m)) {
    return $m[1] . $m[2];
  }
  return '';
}

function _luong_lai_xe_salary_mode($row, array $json = NULL) {
  $json = $json === NULL ? _luong_lai_xe_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '') : $json;
  $value = '';
  foreach (array('hinh_thuc_luong_lai_xe', 'hinh_thuc_luong', 'loai_luong_lai_xe') as $key) {
    if (!empty($json[$key])) {
      $value = trim((string) $json[$key]);
      break;
    }
  }
  if (!in_array($value, array('khoan', 'chuyen'), TRUE)) {
    $value = _luong_lai_xe_dinh_muc_total($json) > 0 ? 'khoan' : 'chuyen';
  }
  return $value;
}

function _luong_lai_xe_tam_ung_history($nid_lai_xe) {
  $account = _luong_lai_xe_require_permission('luong_lai_xe_view');
  if (is_array($account)) {
    return $account;
  }
  $nid_lai_xe = (int) $nid_lai_xe;
  if (!$nid_lai_xe) {
    return _luong_lai_xe_fail('ID lái xe không hợp lệ');
  }
  $filters = _luong_lai_xe_filters();
  $items = _luong_lai_xe_tam_ung_rows($nid_lai_xe, $filters);
  return _luong_lai_xe_success(array(
    'items' => $items,
    'total' => count($items),
    'tong_tam_ung' => _luong_lai_xe_sum_ledgers($items),
    'filters' => $filters,
  ));
}

function _luong_lai_xe_tam_ung_create($nid_lai_xe) {
  $account = _luong_lai_xe_require_permission('luong_lai_xe_pay');
  if (is_array($account)) {
    return $account;
  }
  $nid_lai_xe = (int) $nid_lai_xe;
  if (!$nid_lai_xe) {
    return _luong_lai_xe_fail('ID lái xe không hợp lệ');
  }
  $input = _luong_lai_xe_input();
  $amount = (int) round(_luong_lai_xe_money_value(isset($input['so_tien']) ? $input['so_tien'] : 0));
  if ($amount <= 0) {
    return _luong_lai_xe_fail('Số tiền tạm ứng không hợp lệ');
  }
  $ky_luong = !empty($input['ky_luong']) ? _luong_lai_xe_normalize_ky_luong($input['ky_luong']) : _luong_lai_xe_filters()['ky_luong'];
  if (!$ky_luong) {
    return _luong_lai_xe_fail('Kỳ lương không hợp lệ');
  }
  $ngay_ung = isset($input['ngay_ung']) ? trim((string) $input['ngay_ung']) : date('d/m/Y');
  if (!preg_match('/^\d{1,2}\/\d{1,2}\/\d{4}$/', $ngay_ung)) {
    return _luong_lai_xe_fail('Ngày ứng tiền không hợp lệ. Vui lòng nhập dạng dd/mm/YYYY');
  }
  $hinh_thuc_chi = in_array(isset($input['hinh_thuc_chi']) ? $input['hinh_thuc_chi'] : '', array('tien_mat', 'chuyen_khoan', 'khac'), TRUE) ? $input['hinh_thuc_chi'] : 'tien_mat';
  $quy_chi = intval(isset($input['quy_chi']) ? $input['quy_chi'] : 0);
  if ($quy_chi <= 0) {
    return _luong_lai_xe_fail('Vui lòng chọn quỹ chi');
  }
  $ghi_chu = trim(isset($input['ghi_chu']) ? (string) $input['ghi_chu'] : '');

  if (!module_exists('thu_chi') || !function_exists('thu_chi_giao_dich_save_values')) {
    return _luong_lai_xe_fail('Chưa bật module Thu chi. Không thể tạo phiếu ứng tiền.');
  }
  if (!db_table_exists('bcllx_tam_ung_lai_xe')) {
    return _luong_lai_xe_fail('Bảng tạm ứng lái xe chưa sẵn sàng.');
  }

  $transaction = db_transaction();
  try {
    $voucher = _luong_lai_xe_create_thu_chi_advance_voucher($nid_lai_xe, array(
      'so_tien' => $amount,
      'ky_luong' => $ky_luong,
      'ngay_ung' => $ngay_ung,
      'quy_chi' => $quy_chi,
    ));
    if (empty($voucher['success'])) {
      return _luong_lai_xe_fail(!empty($voucher['message']) ? $voucher['message'] : 'Không tạo được phiếu chi tạm ứng.');
    }

    $nid_phieu = !empty($voucher['gd_id']) ? (int) $voucher['gd_id'] : 0;
    $ma_phieu = !empty($voucher['ma_giao_dich']) ? (string) $voucher['ma_giao_dich'] : '';
    $luong_nid = 0;
    $snapshot = _luong_lai_xe_load_salary_snapshot($nid_lai_xe, $ky_luong);
    if ($snapshot && !empty($snapshot->nid)) {
      $luong_nid = (int) $snapshot->nid;
    }

    $ngay_ts = _luong_lai_xe_parse_date_to_ts($ngay_ung);
    $id = db_insert('bcllx_tam_ung_lai_xe')->fields(array(
      'ma_phieu' => $ma_phieu,
      'line_index' => 1,
      'nid_phieu_thu_chi' => $nid_phieu,
      'nid_lai_xe' => $nid_lai_xe,
      'nid_luong_lai_xe' => $luong_nid,
      'thang_luong' => $ky_luong,
      'so_tien' => $amount,
      'ngay_ung' => $ngay_ts,
      'quy_chi' => $quy_chi,
      'hinh_thuc_chi' => $hinh_thuc_chi,
      'trang_thai' => 'cho_duyet',
      'ghi_chu' => $ghi_chu,
      'uid' => (int) $account->uid,
      'created' => REQUEST_TIME,
      'updated' => REQUEST_TIME,
    ))->execute();

    _luong_lai_xe_append_advance_to_voucher($nid_phieu, $nid_lai_xe, $amount, $luong_nid, $ky_luong);

    return _luong_lai_xe_success(array(
      'id' => (int) $id,
      'nid_phieu_thu_chi' => $nid_phieu,
      'ma_phieu' => $ma_phieu,
      'nid_lai_xe' => $nid_lai_xe,
      'thang_luong' => $ky_luong,
      'so_tien' => $amount,
      'ngay_ung' => $ngay_ung,
      'hinh_thuc_chi' => $hinh_thuc_chi,
      'quy_chi' => $quy_chi,
      'trang_thai' => 'cho_duyet',
      'ghi_chu' => $ghi_chu,
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('luong_lai_xe', 'Lỗi tạo tạm ứng lương: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _luong_lai_xe_error($e->getMessage());
  }
}

function _luong_lai_xe_create_thu_chi_advance_voucher($nid_lai_xe, array $values) {
  if (!module_exists('thu_chi') || !function_exists('thu_chi_giao_dich_save_values')) {
    return array('success' => FALSE, 'message' => 'Chưa bật module Thu chi hoặc thiếu hàm tạo phiếu chi.');
  }
  $so_tien = (int) round(_luong_lai_xe_money_value(isset($values['so_tien']) ? $values['so_tien'] : 0));
  if ($so_tien <= 0) {
    return array('success' => FALSE, 'message' => 'Số tiền tạm ứng không hợp lệ.');
  }
  $thang_key = _luong_lai_xe_normalize_ky_luong(isset($values['ky_luong']) ? $values['ky_luong'] : '');
  if (!$thang_key) {
    return array('success' => FALSE, 'message' => 'Kỳ lương không hợp lệ.');
  }
  $ngay_ung = isset($values['ngay_ung']) ? trim((string) $values['ngay_ung']) : date('d/m/Y');
  $nid_quy = intval(isset($values['quy_chi']) ? $values['quy_chi'] : 0);
  if ($nid_quy <= 0) {
    return array('success' => FALSE, 'message' => 'Vui lòng chọn quỹ chi.');
  }
  global $user;
  $uid = !empty($user->uid) ? intval($user->uid) : 0;

  $driver = _luong_lai_xe_driver_object((int) $nid_lai_xe);
  $driver_label = trim(($driver['ten'] !== '' ? $driver['ten'] : '') . ($driver['ma_nhan_vien'] !== '' ? ' - ' . $driver['ma_nhan_vien'] : ''));
  $driver_label = $driver_label !== '' ? $driver_label : 'Lái xe #' . intval($nid_lai_xe);

  $ngay_text = $ngay_ung;
  if (function_exists('thu_chi_parse_date')) {
    $ngay_ts = thu_chi_parse_date($ngay_ung);
    if ($ngay_ts) {
      $ngay_text = date('d/m/Y', $ngay_ts);
    }
  }

  return thu_chi_giao_dich_save_values(array(
    'loai_phieu' => 'chi',
    'loai_giao_dich' => array('Chi phí lương'),
    'nid_quy' => $nid_quy,
    'nid_quy_nhan' => 0,
    'ngay_giao_dich' => $ngay_text,
    'thang_luong' => $thang_key,
    'uid_nguoi_de_xuat' => $uid,
    'nhom_giao_dich' => 'tam_ung_lai_xe',
    'ref_type' => 'bcllx_tam_ung_lai_xe',
    'nid_ref' => 0,
    'chi_tiet' => array(
      array(
        'noi_dung' => 'Ứng tiền lái xe ' . $driver_label . ' - kỳ ' . $thang_key,
        'don_gia' => $so_tien,
        'so_luong' => 1,
        'don_vi_tinh' => 'phiếu',
        'vat' => 0,
      ),
    ),
  ), 0);
}

/** Ghi thông tin lái xe / kỳ lương vào JSON phiếu chi tạm ứng (bảng qltc_phieu_thu_chi) để xem lại ở Thu chi. */
function _luong_lai_xe_append_advance_to_voucher($nid_phieu, $nid_lai_xe, $so_tien, $nid_luong_lai_xe, $thang_key) {
  $driver = _luong_lai_xe_driver_object((int) $nid_lai_xe);
  return _luong_lai_xe_merge_voucher_json($nid_phieu, array(
    'nid_lai_xe' => (int) $nid_lai_xe,
    'tam_ung_lai_xe' => array(array(
      'nid_lai_xe' => (int) $nid_lai_xe,
      'lai_xe' => $driver['ten'] !== '' ? $driver['ten'] : 'Lái xe #' . (int) $nid_lai_xe,
      'so_tien' => (int) $so_tien,
      'nid_luong_lai_xe' => (int) $nid_luong_lai_xe,
      'thang_luong' => (string) $thang_key,
    )),
  ));
}

/** Gộp thêm khoá vào thong_tin_json của 1 phiếu thu chi (không đụng các khoá khác, giữ ref_type do lúc tạo phiếu đặt). */
function _luong_lai_xe_merge_voucher_json($nid_phieu, array $extra) {
  $nid_phieu = intval($nid_phieu);
  if ($nid_phieu <= 0 || !db_table_exists('qltc_phieu_thu_chi')) {
    return FALSE;
  }
  $raw = db_query("SELECT thong_tin_json FROM {qltc_phieu_thu_chi} WHERE nid = :nid", array(':nid' => $nid_phieu))->fetchField();
  if ($raw === FALSE) {
    return FALSE;
  }
  $json = json_decode((string) $raw, TRUE);
  $json = is_array($json) ? array_merge($json, $extra) : $extra;
  db_update('qltc_phieu_thu_chi')->fields(array('thong_tin_json' => json_encode($json), 'changed' => REQUEST_TIME))->condition('nid', $nid_phieu)->execute();
  return TRUE;
}

function _luong_lai_xe_parse_date_to_ts($value) {
  $value = trim((string) $value);
  if (preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $value, $m)) {
    return mktime(0, 0, 0, intval($m[2]), intval($m[1]), intval($m[3]));
  }
  $ts = strtotime($value);
  return $ts ? $ts : REQUEST_TIME;
}

function _luong_lai_xe_thanh_toan_luong($nid_lai_xe) {
  $account = _luong_lai_xe_require_permission('luong_lai_xe_pay');
  if (is_array($account)) {
    return $account;
  }
  $nid_lai_xe = (int) $nid_lai_xe;
  if (!$nid_lai_xe) {
    return _luong_lai_xe_fail('ID lái xe không hợp lệ');
  }
  $input = _luong_lai_xe_input();
  $ky_luong = !empty($input['ky_luong']) ? _luong_lai_xe_normalize_ky_luong($input['ky_luong']) : _luong_lai_xe_filters()['ky_luong'];
  if (!$ky_luong) {
    return _luong_lai_xe_fail('Kỳ lương không hợp lệ');
  }
  $filters = _luong_lai_xe_month_bounds($ky_luong);
  $filters['ky_luong'] = $ky_luong;
  $detail = _luong_lai_xe_driver_detail($nid_lai_xe, $filters);
  if (empty($detail['so_ke_hoach'])) {
    return _luong_lai_xe_fail('Không có kế hoạch để thanh toán lương kỳ này');
  }

  $ngay_chi = isset($input['ngay_thanh_toan']) ? trim((string) $input['ngay_thanh_toan']) : date('d/m/Y');
  if (!preg_match('/^\d{1,2}\/\d{1,2}\/\d{4}$/', $ngay_chi)) {
    return _luong_lai_xe_fail('Ngày thanh toán không hợp lệ. Vui lòng nhập dạng dd/mm/YYYY');
  }
  $ngay_ts = _luong_lai_xe_parse_date_to_ts($ngay_chi);
  $hinh_thuc_chi = in_array(isset($input['hinh_thuc_chi']) ? $input['hinh_thuc_chi'] : '', array('tien_mat', 'chuyen_khoan', 'khac'), TRUE) ? $input['hinh_thuc_chi'] : 'tien_mat';
  $quy_chi = intval(isset($input['quy_chi']) ? $input['quy_chi'] : 0);
  if ($quy_chi <= 0) {
    return _luong_lai_xe_fail('Vui lòng chọn quỹ chi');
  }
  $ghi_chu = trim(isset($input['ghi_chu']) ? (string) $input['ghi_chu'] : '');

  $luong_chot = (int) $detail['luong_chot'];
  $khau_tru_tam_ung = (int) $detail['khau_tru_tam_ung'];
  $da_thanh_toan = _luong_lai_xe_thanh_toan_sum($nid_lai_xe, $ky_luong);
  $thuc_lanh = max(0, $luong_chot - $khau_tru_tam_ung);
  $luong_phai_tra = max(0, $thuc_lanh - $da_thanh_toan);
  if ($luong_phai_tra <= 0) {
    return _luong_lai_xe_fail('Lương kỳ này đã thanh toán đủ.');
  }

  $so_tien = (int) round(_luong_lai_xe_money_value(isset($input['so_tien']) ? $input['so_tien'] : $luong_phai_tra));
  if ($so_tien <= 0) {
    return _luong_lai_xe_fail('Số tiền thanh toán phải lớn hơn 0');
  }
  if ($so_tien > $luong_phai_tra) {
    return _luong_lai_xe_fail('Số tiền thanh toán không được lớn hơn lương phải trả còn lại (' . _luong_lai_xe_format_money($luong_phai_tra) . ')');
  }

  if (function_exists('quan_ly_tai_chinh_quy_load')) {
    $quy = quan_ly_tai_chinh_quy_load($quy_chi);
    if (!$quy) {
      return _luong_lai_xe_fail('Quỹ chi không hợp lệ.');
    }
    $so_du_quy = (int) round(_luong_lai_xe_money_value(isset($quy->so_du_hien_tai) ? $quy->so_du_hien_tai : 0));
    if ($so_tien > $so_du_quy) {
      $ten_quy = isset($quy->ten_quy) ? trim((string) $quy->ten_quy) : '';
      return _luong_lai_xe_fail('Số dư quỹ ' . ($ten_quy !== '' ? $ten_quy : '') . ' không đủ để thanh toán. Số dư hiện tại: ' . _luong_lai_xe_format_money($so_du_quy));
    }
  }

  if (!module_exists('thu_chi') || !function_exists('thu_chi_giao_dich_save_values')) {
    return _luong_lai_xe_fail('Chưa bật module Thu chi. Không thể tạo phiếu chi thanh toán lương.');
  }
  if (!db_table_exists('llx_thanh_toan_luong')) {
    return _luong_lai_xe_fail('Bảng thanh toán lương chưa sẵn sàng.');
  }

  $transaction = db_transaction();
  try {
    $voucher = _luong_lai_xe_create_thu_chi_salary_payment_voucher($nid_lai_xe, array(
      'so_tien' => $so_tien,
      'ky_luong' => $ky_luong,
      'ngay_chi' => $ngay_chi,
      'quy_chi' => $quy_chi,
      'ghi_chu' => $ghi_chu,
    ));
    if (empty($voucher['success'])) {
      return _luong_lai_xe_fail(!empty($voucher['message']) ? $voucher['message'] : 'Không tạo được phiếu chi thanh toán lương.');
    }
    $nid_phieu = !empty($voucher['gd_id']) ? (int) $voucher['gd_id'] : 0;
    $ma_phieu = !empty($voucher['ma_giao_dich']) ? (string) $voucher['ma_giao_dich'] : '';

    $salary_id = _luong_lai_xe_save_salary_snapshot($detail, array(
      'ky_luong' => $ky_luong,
      'luong_chot' => $luong_chot,
      'khau_tru_tam_ung' => $khau_tru_tam_ung,
      'thuc_lanh' => $thuc_lanh,
      'trang_thai' => 'da_thanh_toan',
      'ghi_chu' => $ghi_chu,
      'nid_ledger_thanh_toan' => 0,
    ));

    $tam_ung_con_lai = max(0, (int) $detail['tam_ung_da_chi'] - (int) $detail['khau_tru_da_tru']);
    $id = db_insert('llx_thanh_toan_luong')->fields(array(
      'ma_phieu' => $ma_phieu,
      'line_index' => 1,
      'nid_phieu_thu_chi' => $nid_phieu,
      'nid_lai_xe' => $nid_lai_xe,
      'nid_luong_lai_xe' => (int) $salary_id,
      'thang_luong' => $ky_luong,
      'luong_phai_tra' => $luong_phai_tra,
      'tam_ung_con_lai' => $tam_ung_con_lai,
      'khau_tru_tam_ung' => $khau_tru_tam_ung,
      'so_tien' => $so_tien,
      'ngay_chi' => $ngay_ts,
      'quy_chi' => $quy_chi,
      'hinh_thuc_chi' => $hinh_thuc_chi,
      'trang_thai' => 'cho_duyet',
      'ghi_chu' => $ghi_chu,
      'uid' => (int) $account->uid,
      'created' => REQUEST_TIME,
      'updated' => REQUEST_TIME,
    ))->execute();

    if (db_table_exists('bcllx_tam_ung_khau_tru')) {
      db_update('bcllx_tam_ung_khau_tru')
        ->fields(array('nid_luong_lai_xe' => (int) $salary_id, 'updated' => REQUEST_TIME))
        ->condition('nid_lai_xe', (int) $nid_lai_xe)
        ->condition('thang_luong', (string) $ky_luong)
        ->execute();
      watchdog('luong_lai_xe', 'Đã gắn bảng lương @salary cho các dòng khấu trừ tạm ứng của lái xe @driver kỳ @ky.', array('@salary' => $salary_id, '@driver' => $nid_lai_xe, '@ky' => $ky_luong), WATCHDOG_INFO);
    }

    _luong_lai_xe_append_salary_payment_to_voucher($nid_phieu, $nid_lai_xe, $so_tien, $salary_id, $ky_luong, $luong_chot, $khau_tru_tam_ung, $ghi_chu);

    return _luong_lai_xe_success(array(
      'id' => (int) $id,
      'nid_phieu_thu_chi' => $nid_phieu,
      'ma_phieu' => $ma_phieu,
      'nid_lai_xe' => $nid_lai_xe,
      'nid_luong_lai_xe' => (int) $salary_id,
      'thang_luong' => $ky_luong,
      'so_tien' => $so_tien,
      'ngay_chi' => $ngay_chi,
      'hinh_thuc_chi' => $hinh_thuc_chi,
      'quy_chi' => $quy_chi,
      'trang_thai' => 'cho_duyet',
      'luong_phai_tra' => $luong_phai_tra,
      'da_thanh_toan' => $da_thanh_toan + $so_tien,
      'ghi_chu' => $ghi_chu,
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('luong_lai_xe', 'Lỗi thanh toán lương: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _luong_lai_xe_error($e->getMessage());
  }
}

/**
 * Tổng tiền đã thanh toán lương của lái xe trong một kỳ.
 *
 * Tính theo các phiếu chi đã tạo (không gồm phiếu bị hủy), không phụ thuộc
 * trạng thái duyệt để tránh trả lương trùng khi phiếu chi còn chờ duyệt.
 */
function _luong_lai_xe_thanh_toan_sum($nid_lai_xe, $thang_key = NULL) {
  if (!db_table_exists('llx_thanh_toan_luong')) {
    return 0;
  }
  $query = db_select('llx_thanh_toan_luong', 'tt');
  $query->addExpression('COALESCE(SUM(tt.so_tien), 0)', 'tong');
  $query->condition('tt.nid_lai_xe', (int) $nid_lai_xe);
  $query->condition('tt.trang_thai', 'huy', '<>');
  if ($thang_key !== NULL) {
    $query->condition('tt.thang_luong', (string) $thang_key);
  }
  return (int) $query->execute()->fetchField();
}

/**
 * Danh sách phiếu thanh toán lương của lái xe.
 */
function _luong_lai_xe_thanh_toan_rows($nid_lai_xe, $thang_key = NULL) {
  if (!db_table_exists('llx_thanh_toan_luong')) {
    return array();
  }
  $query = db_select('llx_thanh_toan_luong', 'tt');
  $query->fields('tt');
  $query->condition('tt.nid_lai_xe', (int) $nid_lai_xe);
  if ($thang_key !== NULL) {
    $query->condition('tt.thang_luong', (string) $thang_key);
  }
  $rows = $query->orderBy('tt.ngay_chi', 'DESC')->orderBy('tt.id', 'DESC')->execute()->fetchAll(PDO::FETCH_ASSOC);
  foreach ($rows as &$row) {
    $row['id'] = (int) $row['id'];
    $row['nid_phieu_thu_chi'] = (int) $row['nid_phieu_thu_chi'];
    $row['so_tien'] = (int) $row['so_tien'];
    $row['ngay_chi'] = (int) $row['ngay_chi'];
    $row['ngay_chi_display'] = $row['ngay_chi'] ? date('d/m/Y', $row['ngay_chi']) : '';
    $row['created_display'] = $row['created'] ? date('d/m/Y', (int) $row['created']) : '';
    $row['quy_chi_label'] = _luong_lai_xe_quy_label($row['quy_chi']);
    $row['hinh_thuc_chi_label'] = _luong_lai_xe_hinh_thuc_chi_label((string) $row['hinh_thuc_chi']);
    $row['trang_thai_label'] = _luong_lai_xe_tam_ung_status_label((string) $row['trang_thai']);
  }
  return $rows;
}

function _luong_lai_xe_create_thu_chi_salary_payment_voucher($nid_lai_xe, array $values) {
  if (!module_exists('thu_chi') || !function_exists('thu_chi_giao_dich_save_values')) {
    return array('success' => FALSE, 'message' => 'Chưa bật module Thu chi hoặc thiếu hàm tạo phiếu chi.');
  }
  $so_tien = (int) round(_luong_lai_xe_money_value(isset($values['so_tien']) ? $values['so_tien'] : 0));
  if ($so_tien <= 0) {
    return array('success' => FALSE, 'message' => 'Số tiền thanh toán không hợp lệ.');
  }
  $thang_key = _luong_lai_xe_normalize_ky_luong(isset($values['ky_luong']) ? $values['ky_luong'] : '');
  if (!$thang_key) {
    return array('success' => FALSE, 'message' => 'Kỳ lương không hợp lệ.');
  }
  $ngay_chi = isset($values['ngay_chi']) ? trim((string) $values['ngay_chi']) : date('d/m/Y');
  $nid_quy = intval(isset($values['quy_chi']) ? $values['quy_chi'] : 0);
  if ($nid_quy <= 0) {
    return array('success' => FALSE, 'message' => 'Vui lòng chọn quỹ chi.');
  }
  $ghi_chu = trim(isset($values['ghi_chu']) ? (string) $values['ghi_chu'] : '');
  global $user;
  $uid = !empty($user->uid) ? intval($user->uid) : 0;

  $driver = _luong_lai_xe_driver_object((int) $nid_lai_xe);
  $driver_label = trim(($driver['ten'] !== '' ? $driver['ten'] : '') . ($driver['ma_nhan_vien'] !== '' ? ' - ' . $driver['ma_nhan_vien'] : ''));
  $driver_label = $driver_label !== '' ? $driver_label : 'Lái xe #' . intval($nid_lai_xe);

  $noi_dung = 'Thanh toán lương lái xe - ' . $driver_label . ' - kỳ ' . $thang_key;

  $ngay_text = $ngay_chi;
  if (function_exists('thu_chi_parse_date')) {
    $ngay_ts = thu_chi_parse_date($ngay_chi);
    if ($ngay_ts) {
      $ngay_text = date('d/m/Y', $ngay_ts);
    }
  }

  return thu_chi_giao_dich_save_values(array(
    'loai_phieu' => 'chi',
    'loai_giao_dich' => array('Chi phí lương'),
    'nid_quy' => $nid_quy,
    'nid_quy_nhan' => 0,
    'ngay_giao_dich' => $ngay_text,
    'thang_luong' => $thang_key,
    'uid_nguoi_de_xuat' => $uid,
    'nhom_giao_dich' => 'thanh_toan_luong_lai_xe',
    'ref_type' => 'llx_thanh_toan_luong',
    'nid_ref' => 0,
    'chi_tiet' => array(
      array(
        'noi_dung' => $noi_dung,
        'don_gia' => $so_tien,
        'so_luong' => 1,
        'don_vi_tinh' => 'phiếu',
        'vat' => 0,
      ),
    ),
  ), 0);
}

/** Ghi thông tin lái xe / kỳ lương / lương chốt / khấu trừ vào JSON phiếu chi trả lương để xem lại ở Thu chi. */
function _luong_lai_xe_append_salary_payment_to_voucher($nid_phieu, $nid_lai_xe, $so_tien, $nid_luong_lai_xe, $thang_key, $luong_chot = 0, $khau_tru_tam_ung = 0, $ghi_chu = '') {
  $driver = _luong_lai_xe_driver_object((int) $nid_lai_xe);
  return _luong_lai_xe_merge_voucher_json($nid_phieu, array(
    'nid_lai_xe' => (int) $nid_lai_xe,
    'thanh_toan_luong_lai_xe' => array(array(
      'nid_lai_xe' => (int) $nid_lai_xe,
      'lai_xe' => $driver['ten'] !== '' ? $driver['ten'] : 'Lái xe #' . (int) $nid_lai_xe,
      'so_tien' => (int) $so_tien,
      'nid_luong_lai_xe' => (int) $nid_luong_lai_xe,
      'thang_luong' => (string) $thang_key,
      'luong_chot' => (int) $luong_chot,
      'khau_tru_tam_ung' => (int) $khau_tru_tam_ung,
    )),
  ));
}

/**
 * Đồng bộ trạng thái thanh toán lương khi phiếu chi được duyệt/không duyệt.
 */
function luong_lai_xe_sync_thanh_toan_luong_status_from_phieu($node, $duyet_status) {
  if (!$node || !is_object($node) || empty($node->nid) || !db_table_exists('llx_thanh_toan_luong')) {
    return FALSE;
  }
  $json = array();
  if (function_exists('thu_chi_get_field_value')) {
    $json = json_decode(thu_chi_get_field_value($node, 'field_thong_tin_json', '{}'), TRUE);
  }
  if (empty($json) && !empty($node->thong_tin_json)) {
    $decoded = json_decode((string) $node->thong_tin_json, TRUE);
    $json = is_array($decoded) ? $decoded : array();
  }
  if (!is_array($json)) {
    $json = array();
  }
  $ref_type = isset($json['ref_type']) ? trim((string) $json['ref_type']) : '';
  if ($ref_type !== 'llx_thanh_toan_luong' && empty($json['thanh_toan_luong_lai_xe'])) {
    return FALSE;
  }

  if ($duyet_status === 'da_duyet' || $duyet_status === 'yeu_cau_dieu_chinh') {
    $payment_status = 'da_chi';
  }
  elseif ($duyet_status === 'khong_duyet') {
    $payment_status = 'huy';
  }
  else {
    $payment_status = 'cho_duyet';
  }

  $count = db_update('llx_thanh_toan_luong')
    ->fields(array('trang_thai' => $payment_status, 'updated' => REQUEST_TIME))
    ->condition('nid_phieu_thu_chi', intval($node->nid))
    ->execute();
  return $count > 0;
}

function _luong_lai_xe_tam_ung_rows($nid_lai_xe, array $filters) {
  if (!db_table_exists('bcllx_tam_ung_lai_xe')) {
    return array();
  }
  $query = db_select('bcllx_tam_ung_lai_xe', 'tu');
  $query->fields('tu');
  $query->condition('tu.nid_lai_xe', (int) $nid_lai_xe);
  if (!empty($filters['ky_luong'])) {
    $query->condition('tu.thang_luong', (string) $filters['ky_luong']);
  }
  else {
    if (!empty($filters['date_from'])) $query->condition('tu.ngay_ung', strtotime($filters['date_from'] . ' 00:00:00'), '>=');
    if (!empty($filters['date_to'])) $query->condition('tu.ngay_ung', strtotime($filters['date_to'] . ' 23:59:59'), '<=');
  }
  $rows = $query->orderBy('tu.ngay_ung', 'DESC')->orderBy('tu.id', 'DESC')->execute()->fetchAll(PDO::FETCH_ASSOC);
  foreach ($rows as &$row) {
    $row['id'] = (int) $row['id'];
    $row['nid_phieu_thu_chi'] = (int) $row['nid_phieu_thu_chi'];
    $row['nid_luong_lai_xe'] = (int) $row['nid_luong_lai_xe'];
    $row['so_tien'] = (int) $row['so_tien'];
    $row['ngay_ung'] = (int) $row['ngay_ung'];
    $row['created'] = $row['ngay_ung'] ? date('d/m/Y', (int) $row['ngay_ung']) : '';
    $row['ma_giao_dich'] = (string) $row['ma_phieu'];
    $row['noi_dung'] = $row['ghi_chu'] !== '' ? (string) $row['ghi_chu'] : 'Tạm ứng lương kỳ ' . (string) $row['thang_luong'];
    $row['trang_thai_label'] = _luong_lai_xe_tam_ung_status_label((string) $row['trang_thai']);
    $row['quy_chi_label'] = _luong_lai_xe_quy_label($row['quy_chi']);
    $row['hinh_thuc_chi_label'] = _luong_lai_xe_hinh_thuc_chi_label((string) $row['hinh_thuc_chi']);
  }
  return $rows;
}

function _luong_lai_xe_sum_ledgers(array $items) {
  $total = 0;
  foreach ($items as $item) {
    if (isset($item['trang_thai']) && $item['trang_thai'] !== 'da_chi') {
      continue;
    }
    $total += !empty($item['so_tien']) ? (int) $item['so_tien'] : 0;
  }
  return $total;
}

function _luong_lai_xe_tam_ung_status_label($status) {
  $labels = array(
    'cho_duyet' => 'Chờ duyệt',
    'da_chi' => 'Đã chi',
    'huy' => 'Không duyệt',
  );
  return isset($labels[$status]) ? $labels[$status] : $status;
}

function _luong_lai_xe_khau_tru_status_label($status) {
  $labels = array(
    'cho_duyet' => 'Chờ thu',
    'da_chi' => 'Đã thu',
    'huy' => 'Không duyệt',
  );
  return isset($labels[$status]) ? $labels[$status] : $status;
}

function _luong_lai_xe_quy_label($quy_value) {
  $quy_value = trim((string) $quy_value);
  if ($quy_value === '') {
    return '-';
  }
  if (function_exists('thu_chi_quy_label')) {
    return thu_chi_quy_label($quy_value);
  }
  $nid_quy = (int) round(_luong_lai_xe_money_value($quy_value));
  if ($nid_quy <= 0) {
    return $quy_value;
  }
  static $cache = array();
  if (!isset($cache[$nid_quy])) {
    $cache[$nid_quy] = '';
    $table = NULL;
    if (db_table_exists('qltc_quy')) {
      $table = 'qltc_quy';
    }
    elseif (db_table_exists('quy')) {
      $table = 'quy';
    }
    elseif (db_table_exists('quan_ly_quy')) {
      $table = 'quan_ly_quy';
    }
    if ($table) {
      $row = db_query("SELECT nid, ten_quy, ma_quy FROM {" . $table . "} WHERE nid = :nid", array(':nid' => $nid_quy))->fetch();
      if ($row) {
        $label = trim((string) $row->ten_quy);
        if ((string) $row->ma_quy !== '') {
          $label .= ' (' . (string) $row->ma_quy . ')';
        }
        $cache[$nid_quy] = $label;
      }
    }
  }
  return $cache[$nid_quy] !== '' ? $cache[$nid_quy] : ('#' . $nid_quy);
}

function _luong_lai_xe_hinh_thuc_chi_label($value) {
  $labels = array(
    'tien_mat' => 'Tiền mặt',
    'chuyen_khoan' => 'Chuyển khoản',
    'khac' => 'Khác',
  );
  return isset($labels[$value]) ? $labels[$value] : $value;
}

function _luong_lai_xe_khau_tru_rows($nid_lai_xe, array $filters) {
  if (!db_table_exists('bcllx_tam_ung_khau_tru')) {
    return array();
  }
  $query = db_select('bcllx_tam_ung_khau_tru', 'kt');
  $query->fields('kt');
  $query->condition('kt.nid_lai_xe', (int) $nid_lai_xe);
  if (db_field_exists('bcllx_tam_ung_khau_tru', 'trang_thai')) {
    $query->condition('kt.trang_thai', 'da_chi');
  }
  if (!empty($filters['ky_luong'])) {
    $query->condition('kt.thang_luong', (string) $filters['ky_luong']);
  }
  else {
    if (!empty($filters['date_from'])) $query->condition('kt.created', strtotime($filters['date_from'] . ' 00:00:00'), '>=');
    if (!empty($filters['date_to'])) $query->condition('kt.created', strtotime($filters['date_to'] . ' 23:59:59'), '<=');
  }
  $rows = $query->orderBy('kt.ngay_khau_tru', 'DESC')->orderBy('kt.id', 'DESC')->execute()->fetchAll(PDO::FETCH_ASSOC);

  $ma_by_phieu = array();
  $quy_by_phieu = array();
  if (!empty($rows) && db_table_exists('qltc_phieu_thu_chi')) {
    $phieu_nids = array();
    foreach ($rows as $row) {
      $nid = (int) $row['nid_phieu_thu_khau_tru'];
      if ($nid > 0) {
        $phieu_nids[] = $nid;
      }
    }
    if (!empty($phieu_nids)) {
      $phieu_cols = array('nid');
      if (db_field_exists('qltc_phieu_thu_chi', 'ma_giao_dich')) {
        $phieu_cols[] = 'ma_giao_dich';
      }
      if (db_field_exists('qltc_phieu_thu_chi', 'nid_quy')) {
        $phieu_cols[] = 'nid_quy';
      }
      foreach (db_select('qltc_phieu_thu_chi', 'p')->fields('p', $phieu_cols)->condition('nid', $phieu_nids, 'IN')->execute()->fetchAll() as $p) {
        if (isset($p->ma_giao_dich)) {
          $ma_by_phieu[(int) $p->nid] = (string) $p->ma_giao_dich;
        }
        if (isset($p->nid_quy)) {
          $quy_by_phieu[(int) $p->nid] = (int) $p->nid_quy;
        }
      }
    }
  }

  foreach ($rows as &$row) {
    $row['id'] = (int) $row['id'];
    $row['nid_luong_lai_xe'] = (int) $row['nid_luong_lai_xe'];
    $row['nid_phieu_thu_khau_tru'] = (int) $row['nid_phieu_thu_khau_tru'];
    $row['so_tien'] = (int) $row['so_tien'];
    $row['ngay_khau_tru'] = (int) $row['ngay_khau_tru'];
    $row['created'] = $row['ngay_khau_tru'] ? date('d/m/Y', (int) $row['ngay_khau_tru']) : '';
    $row['ma_giao_dich'] = !empty($ma_by_phieu[$row['nid_phieu_thu_khau_tru']]) ? $ma_by_phieu[$row['nid_phieu_thu_khau_tru']] : '';
    $row['quy_chi_label'] = !empty($quy_by_phieu[$row['nid_phieu_thu_khau_tru']]) ? _luong_lai_xe_quy_label($quy_by_phieu[$row['nid_phieu_thu_khau_tru']]) : '';
    $row['trang_thai'] = isset($row['trang_thai']) && (string) $row['trang_thai'] !== '' ? (string) $row['trang_thai'] : 'da_chi';
    $row['trang_thai_label'] = _luong_lai_xe_khau_tru_status_label($row['trang_thai']);
    $ghi_chu = isset($row['ghi_chu']) ? trim((string) $row['ghi_chu']) : '';
    $row['noi_dung'] = $ghi_chu !== '' ? $ghi_chu : ('Khấu trừ tạm ứng lương kỳ ' . (string) $row['thang_luong']);
  }
  return $rows;
}

function _luong_lai_xe_sum_khau_tru(array $items) {
  $total = 0;
  foreach ($items as $item) {
    $total += !empty($item['so_tien']) ? (int) $item['so_tien'] : 0;
  }
  return $total;
}

function _luong_lai_xe_tam_ung_sum($nid_lai_xe, array $filters) {
  if (!db_table_exists('bcllx_tam_ung_lai_xe')) {
    return 0;
  }
  $query = db_select('bcllx_tam_ung_lai_xe', 'tu');
  $query->condition('tu.nid_lai_xe', (int) $nid_lai_xe);
  $query->condition('tu.trang_thai', 'da_chi');
  if (!empty($filters['ky_luong'])) {
    $query->condition('tu.thang_luong', (string) $filters['ky_luong']);
  }
  else {
    if (!empty($filters['date_from'])) $query->condition('tu.ngay_ung', strtotime($filters['date_from'] . ' 00:00:00'), '>=');
    if (!empty($filters['date_to'])) $query->condition('tu.ngay_ung', strtotime($filters['date_to'] . ' 23:59:59'), '<=');
  }
  $query->addExpression('COALESCE(SUM(tu.so_tien), 0)', 'tong');
  return (int) $query->execute()->fetchField();
}

