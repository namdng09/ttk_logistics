<?php

/**
 * @file
 * Install hooks for Lương lái xe.
 */

function luong_lai_xe_schema() {
  $schema['luong_lai_xe'] = array(
    'description' => 'Bảng tổng hợp kỳ lương lái xe.',
    'fields' => array(
      'nid' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'ma_bang_luong' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'nid_lai_xe' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'ky_luong' => array('type' => 'varchar', 'length' => 6, 'not null' => TRUE, 'default' => ''),
      'so_ke_hoach' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'tong_luong_ke_hoach' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'hoan_chi_phi_da_thanh_toan' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'tam_ung_da_chi' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'khau_tru_tam_ung' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'luong_tam_tinh' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'luong_chot' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'thuc_lanh' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
      'nid_ledger_thanh_toan' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'trang_thai' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'nhap'),
      'ghi_chu' => array('type' => 'text', 'not null' => FALSE),
      'thong_tin_json' => array('type' => 'text', 'size' => 'big', 'not null' => FALSE),
      'created' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'changed' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'hoat_dong' => array('type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1),
    ),
    'primary key' => array('nid'),
    'unique keys' => array(
      'ma_bang_luong' => array('ma_bang_luong'),
    ),
    'indexes' => array(
      'nid_lai_xe' => array('nid_lai_xe'),
      'ky_luong' => array('ky_luong'),
      'trang_thai' => array('trang_thai'),
      'nid_ledger_thanh_toan' => array('nid_ledger_thanh_toan'),
      'hoat_dong' => array('hoat_dong'),
      'created' => array('created'),
    ),
  );

  return $schema;
}

function luong_lai_xe_update_7001() {
  $schema = luong_lai_xe_schema();
  if (!db_table_exists('luong_lai_xe')) {
    db_create_table('luong_lai_xe', $schema['luong_lai_xe']);
  }

  return 'Đã tạo bảng luong_lai_xe.';
}

function luong_lai_xe_update_7002() {
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'chi_ho_khach_hang')) {
    db_drop_field('luong_lai_xe', 'chi_ho_khach_hang');
  }

  return 'Đã xoá field chi_ho_khach_hang khỏi bảng lương lái xe nếu tồn tại.';
}

function luong_lai_xe_update_7003() {
  if (db_table_exists('luong_lai_xe_chi_tiet')) {
    db_drop_table('luong_lai_xe_chi_tiet');
  }
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'tu_ngay')) {
    db_drop_field('luong_lai_xe', 'tu_ngay');
  }
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'den_ngay')) {
    db_drop_field('luong_lai_xe', 'den_ngay');
  }

  return 'Đã bỏ bảng chi tiết lương và field tu_ngay/den_ngay.';
}

function luong_lai_xe_update_7004() {
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'chi_phi_cong_ty_chi_tra')) {
    db_drop_field('luong_lai_xe', 'chi_phi_cong_ty_chi_tra');
  }
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'de_nghi_da_thanh_toan') && !db_field_exists('luong_lai_xe', 'hoan_chi_phi_da_thanh_toan')) {
    db_change_field('luong_lai_xe', 'de_nghi_da_thanh_toan', 'hoan_chi_phi_da_thanh_toan', array(
      'type' => 'int',
      'size' => 'big',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  elseif (db_table_exists('luong_lai_xe') && !db_field_exists('luong_lai_xe', 'hoan_chi_phi_da_thanh_toan')) {
    db_add_field('luong_lai_xe', 'hoan_chi_phi_da_thanh_toan', array(
      'type' => 'int',
      'size' => 'big',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  if (db_table_exists('luong_lai_xe') && db_field_exists('luong_lai_xe', 'de_nghi_da_thanh_toan') && db_field_exists('luong_lai_xe', 'hoan_chi_phi_da_thanh_toan')) {
    db_drop_field('luong_lai_xe', 'de_nghi_da_thanh_toan');
  }

  return 'Đã bỏ field chi_phi_cong_ty_chi_tra và đổi de_nghi_da_thanh_toan thành hoan_chi_phi_da_thanh_toan.';
}

function luong_lai_xe_update_7005() {
  $fields = array(
    'tam_ung_da_chi' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
    'khau_tru_tam_ung' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
    'thuc_lanh' => array('type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0),
    'nid_ledger_thanh_toan' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
  );
  if (!db_table_exists('luong_lai_xe')) {
    $schema = luong_lai_xe_schema();
    db_create_table('luong_lai_xe', $schema['luong_lai_xe']);
    return 'Đã tạo bảng luong_lai_xe với field tạm ứng/thanh toán lương.';
  }
  foreach ($fields as $name => $definition) {
    if (!db_field_exists('luong_lai_xe', $name)) {
      db_add_field('luong_lai_xe', $name, $definition);
    }
  }
  if (!db_index_exists('luong_lai_xe', 'nid_ledger_thanh_toan')) {
    db_add_index('luong_lai_xe', 'nid_ledger_thanh_toan', array('nid_ledger_thanh_toan'));
  }

  return 'Đã bổ sung field tạm ứng, khấu trừ và thanh toán lương.';
}

function luong_lai_xe_update_7006() {
  if (!db_table_exists('luong_lai_xe')) {
    $schema = luong_lai_xe_schema();
    db_create_table('luong_lai_xe', $schema['luong_lai_xe']);
    return 'Đã tạo bảng luong_lai_xe theo schema lương tháng.';
  }

  if (!db_field_exists('luong_lai_xe', 'tong_luong_ke_hoach')) {
    db_add_field('luong_lai_xe', 'tong_luong_ke_hoach', array(
      'type' => 'int',
      'size' => 'big',
      'not null' => TRUE,
      'default' => 0,
    ));
  }

  if (db_field_exists('luong_lai_xe', 'luong_tam_tinh')) {
    db_query("UPDATE {luong_lai_xe} SET tong_luong_ke_hoach = luong_tam_tinh WHERE tong_luong_ke_hoach = 0");
  }

  foreach (array('so_chuyen_khoan', 'so_chuyen_theo_chuyen', 'tong_khoan', 'tong_luong_chuyen', 'chi_phi_lai_xe_tu_chiu') as $field) {
    if (db_field_exists('luong_lai_xe', $field)) {
      db_drop_field('luong_lai_xe', $field);
    }
  }

  return 'Đã gom schema lương lái xe về lương tháng, không tách khoán/chuyến/tuyến xa.';
}
