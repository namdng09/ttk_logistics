/**
 * Đổi tên field khoá ngoại theo quy tắc nid_<entity> (VD: lai_xe_nid -> nid_lai_xe).
 */
function luong_lai_xe_update_7008() {
  $spec = array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0);

  $renames = array(
    'bcllx_tam_ung_lai_xe' => array(
      'phieu_thu_chi_nid' => 'nid_phieu_thu_chi',
      'lai_xe_nid' => 'nid_lai_xe',
      'luong_lai_xe_nid' => 'nid_luong_lai_xe',
    ),
    'bcllx_tam_ung_khau_tru' => array(
      'lai_xe_nid' => 'nid_lai_xe',
      'luong_lai_xe_nid' => 'nid_luong_lai_xe',
      'phieu_thu_khau_tru_nid' => 'nid_phieu_thu_khau_tru',
    ),
  );

  $indexes = array(
    'bcllx_tam_ung_lai_xe' => array(
      'phieu_thu_chi' => array('nid_phieu_thu_chi'),
      'lai_xe_thang' => array('nid_lai_xe', 'thang_luong'),
      'luong_lai_xe' => array('nid_luong_lai_xe'),
    ),
    'bcllx_tam_ung_khau_tru' => array(
      'lai_xe_thang' => array('nid_lai_xe', 'thang_luong'),
      'luong_lai_xe' => array('nid_luong_lai_xe'),
      'phieu_thu_khau_tru' => array('nid_phieu_thu_khau_tru'),
    ),
  );

  $renamed = 0;
  foreach ($renames as $table => $fields) {
    if (!db_table_exists($table)) {
      continue;
    }
    foreach ($fields as $old => $new) {
      if (db_field_exists($table, $old) && !db_field_exists($table, $new)) {
        db_change_field($table, $old, $new, $spec);
        $renamed++;
      }
    }
  }

  foreach ($indexes as $table => $defs) {
    if (!db_table_exists($table)) {
      continue;
    }
    foreach ($defs as $name => $columns) {
      if (!db_index_exists($table, $name)) {
        db_add_index($table, $name, $columns);
      }
    }
  }

  return 'Đã đổi tên ' . intval($renamed) . ' cột của bảng bcllx_tam_ung_lai_xe / bcllx_tam_ung_khau_tru theo quy tắc nid_<entity>.';
}

function luong_lai_xe_update_7009() {
  $schema = luong_lai_xe_schema();
  if (!db_table_exists('llx_thanh_toan_luong') && isset($schema['llx_thanh_toan_luong'])) {
    db_create_table('llx_thanh_toan_luong', $schema['llx_thanh_toan_luong']);
  }

  return 'Đã tạo bảng llx_thanh_toan_luong cho phiếu chi thanh toán lương lái xe.';
}

/**
 * Thêm cột trang_thai cho bảng khấu trừ tạm ứng để đồng bộ khi phiếu thu
 * được duyệt/không duyệt trong screen Thu chi.
 */
function luong_lai_xe_update_7010() {
  if (db_table_exists('bcllx_tam_ung_khau_tru') && !db_field_exists('bcllx_tam_ung_khau_tru', 'trang_thai')) {
    db_add_field('bcllx_tam_ung_khau_tru', 'trang_thai', array(
      'type' => 'varchar',
      'length' => 50,
      'not null' => TRUE,
      'default' => 'da_chi',
      'description' => 'Trạng thái khấu trừ: da_chi / cho_duyet / huy.',
    ));
  }
  if (db_table_exists('bcllx_tam_ung_khau_tru') && !db_index_exists('bcllx_tam_ung_khau_tru', 'trang_thai')) {
    db_add_index('bcllx_tam_ung_khau_tru', 'trang_thai', array('trang_thai'));
  }

  return 'Đã thêm cột trang_thai cho bảng bcllx_tam_ung_khau_tru để đồng bộ trạng thái khi duyệt/không duyệt phiếu thu.';
}
