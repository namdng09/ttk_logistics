<?php

/**
 * @file
 * Schema đề nghị thanh toán chi phí kế hoạch.
 *
 * - de_nghi_thanh_toan: 1 đề nghị = 1 hoá đơn của 1 bên phát hành (nid_ncc), gom nhiều dòng
 *   ke_hoach_chi_phi (dòng trỏ về đây bằng nid_de_nghi_chi_phi). Tổng tiền KHÔNG lưu cột riêng,
 *   luôn tính động từ các dòng chi phí để không lệch số.
 * - de_nghi_thanh_toan_thanh_toan: lịch sử trả từng đợt.
 */

/**
 * Implements hook_schema().
 */
function de_nghi_thanh_toan_schema() {
  $schema['de_nghi_thanh_toan'] = array(
    'description' => 'Đề nghị thanh toán: 1 hoá đơn của 1 bên phát hành, gom nhiều dòng chi phí kế hoạch.',
    'fields' => array(
      'nid' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'ma_de_nghi' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''),
      // Bên phát hành hoá đơn: khach_hang có phân loại Nhà cung cấp.
      'nid_ncc' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      // Bên nhận tiền: luôn lưu đủ, kể cả khi trùng bên phát hành ('ncc' + nid_ncc).
      // 'ncc' => id_ben_nhan_tien là nid khach_hang; 'nhan_vien' => id_ben_nhan_tien là uid Drupal.
      'loai_ben_nhan_tien' => array('type' => 'varchar', 'length' => 20, 'not null' => TRUE, 'default' => 'ncc'),
      'id_ben_nhan_tien' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'so_hoa_don' => array('type' => 'varchar', 'length' => 50, 'not null' => TRUE, 'default' => ''),
      'ngay_hoa_don' => array('type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'default' => ''),
      'han_thanh_toan' => array('type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'default' => ''),
      'hinh_thuc_tt' => array('type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'default' => ''),
      'ghi_chu' => array('type' => 'text', 'not null' => FALSE),
      // Mảng JSON ảnh chứng từ (dành chỗ; chưa có giao diện tải lên).
      'hinh_anh_chung_tu' => array('type' => 'text', 'size' => 'big', 'not null' => FALSE),
      'trang_thai' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'nhap'),
      'ly_do_tu_choi' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''),
      'uid_nguoi_duyet' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'ngay_duyet' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'uid_nguoi_duyet_tt' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'ngay_duyet_tt' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      // Nhật ký các bước (mảng JSON {at, uid, text}) để hiện "Lịch sử duyệt".
      'lich_su_json' => array('type' => 'text', 'size' => 'big', 'not null' => FALSE),
      'uid_nguoi_tao' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'created' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'changed' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
      'hoat_dong' => array('type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1),
    ),
    'primary key' => array('nid'),
    'unique keys' => array(
      'ma_de_nghi' => array('ma_de_nghi'),
    ),
    'indexes' => array(
      'nid_ncc' => array('nid_ncc'),
      'ben_nhan_tien' => array('loai_ben_nhan_tien', 'id_ben_nhan_tien'),
      'trang_thai' => array('trang_thai'),
      'uid_nguoi_tao' => array('uid_nguoi_tao'),
      'han_thanh_toan' => array('han_thanh_toan'),
      'hoat_dong' => array('hoat_dong'),
      'created' => array('created'),
    ),
  );

  $schema['de_nghi_thanh_toan_thanh_toan'] = array(
    'description' => 'Lịch sử thanh toán từng đợt của đề nghị thanh toán.',
    'fields' => array(
      'nid' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'nid_de_nghi' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'so_tien' => array('type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'hinh_thuc_tt' => array('type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'default' => ''),
      // Quỹ đã chi (node quỹ của quan_ly_tai_chinh). Chỉ lưu tham chiếu, chưa tạo giao dịch/trừ số dư quỹ.
      'nid_quy' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'ghi_chu' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''),
      'uid_nguoi_thanh_toan' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'created' => array('type' => 'varchar', 'length' => 19, 'not null' => FALSE),
    ),
    'primary key' => array('nid'),
    'indexes' => array(
      'nid_de_nghi' => array('nid_de_nghi'),
      'nid_quy' => array('nid_quy'),
    ),
  );

  return $schema;
}
