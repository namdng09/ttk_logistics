function phuong_tien_update_7003() {
  db_query("ALTER TABLE {phuong_tien} MODIFY COLUMN hoat_dong TINYINT NOT NULL DEFAULT 1");
}

function phuong_tien_update_7004() {
  $check = db_query("SHOW INDEX FROM {phuong_tien} WHERE Key_name = 'bks'")->fetch();
  if ($check) {
    db_query("ALTER TABLE {phuong_tien} DROP INDEX `bks`");
  }
}

function phuong_tien_update_7005() {
  if (!db_field_exists('phuong_tien', 'thong_tin_json')) {
    db_add_field('phuong_tien', 'thong_tin_json', array(
      'type' => 'text',
      'size' => 'big',
      'not null' => FALSE,
    ));
  }
}

function phuong_tien_update_7006() {
