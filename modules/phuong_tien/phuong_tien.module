<?php

/**
 * @file
 * Phương Tiện — Vehicle management. Custom schema, RESTful API + UI.
 */

/**
 * Implements hook_permission().
 */
function phuong_tien_permission() {
  return array(
    'phuong_tien_view' => array('title' => t('Xem phương tiện')),
    'phuong_tien_create' => array('title' => t('Tạo/sửa phương tiện')),
    'phuong_tien_delete' => array('title' => t('Xoá phương tiện')),
  );
}

/**
 * Implements hook_init() — CORS for API routes.
 */
function phuong_tien_init() {
  $path = current_path();
  if (strpos($path, 'api/phuong-tien') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function phuong_tien_menu() {
  $items = array();

  // --- RESTful API ---
  $items['api/phuong-tien'] = array(
    'page callback' => 'phuong_tien_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/phuong-tien/%/file'] = array(
    'page callback' => 'phuong_tien_rest_file_collection',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/phuong-tien/%/file/%'] = array(
    'page callback' => 'phuong_tien_rest_file_item',
    'page arguments' => array(2, 4),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/phuong-tien/%'] = array(
    'page callback' => 'phuong_tien_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  // --- UI List (modal CRUD, single page) ---
  $items['phuong-tien'] = array(
    'title' => 'Danh sách phương tiện',
    'page callback' => 'phuong_tien_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );

  // --- UI Hạn (expiry notification screens) ---
  $expiry_types = array('dang-kiem', 'bao-hiem-than-vo', 'tnds', 'phu-hieu', 'giay-phep-lien-van');
  $expiry_titles = array(
    'dang-kiem' => 'Đăng kiểm',
    'bao-hiem-than-vo' => 'Bảo hiểm thân vỏ',
    'tnds' => 'Bảo hiểm TNDS',
    'phu-hieu' => 'Phù hiệu',
    'giay-phep-lien-van' => 'Giấy phép liên vận',
  );
  foreach ($expiry_types as $type) {
    $items['phuong-tien/' . $type] = array(
      'title' => $expiry_titles[$type],
      'page callback' => 'phuong_tien_page_han',
      'page arguments' => array($type),
      'access callback' => 'user_is_logged_in',
      'type' => MENU_NORMAL_ITEM,
    );
  }

  return $items;
}

/**
 * Implements hook_theme().
 */
function phuong_tien_theme() {
  $path = drupal_get_path('module', 'phuong_tien') . '/templates';
  return array(
    'phuong_tien_list_page' => array(
      'template' => 'phuong-tien-list',
      'path' => $path,
    ),
    'phuong_tien_han_page' => array(
      'template' => 'phuong-tien-han',
      'path' => $path,
    ),
  );
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _phuong_tien_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

function _phuong_tien_require_auth() {
  $token = NULL;
  if (function_exists('getallheaders')) {
    $headers = getallheaders();
    if (!empty($headers['Authorization'])) {
      $token = str_replace('Bearer ', '', $headers['Authorization']);
    }
  }
  if (!$token && !empty($_GET['token'])) {
    $token = $_GET['token'];
  }
  if (!$token) {
    drupal_add_http_header('Status', '401 Unauthorized');
    return array('status' => 'fail', 'message' => 'Thiếu token xác thực');
  }
  module_load_include('module', 'user_login_api', 'user_login_api');
  if (!function_exists('api_validate_token')) {
    drupal_add_http_header('Status', '500 Internal Server Error');
    return array('status' => 'error', 'message' => 'Hệ thống xác thực chưa sẵn sàng');
  }
  $user = api_validate_token($token);
  if (!$user) {
    drupal_add_http_header('Status', '401 Unauthorized');
    return array('status' => 'fail', 'message' => 'Token không hợp lệ');
  }
  return $user;
}

function _phuong_tien_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _phuong_tien_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _phuong_tien_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

function _phuong_tien_json_decode($raw) {
  if (is_array($raw)) return $raw;
  if (!is_string($raw) || trim($raw) === '') return array();
  $decoded = json_decode($raw, TRUE);
  return is_array($decoded) ? $decoded : array();
}

function _phuong_tien_json_encode($data) {
  return json_encode(is_array($data) ? $data : array(), JSON_UNESCAPED_UNICODE);
}

function _phuong_tien_numeric_only($value) {
  return preg_replace('/[^\d]/', '', (string) $value);
}

function _phuong_tien_ensure_thong_tin_json_field() {
  if (db_table_exists('phuong_tien') && !db_field_exists('phuong_tien', 'thong_tin_json')) {
    db_add_field('phuong_tien', 'thong_tin_json', array(
      'type' => 'text',
      'size' => 'big',
      'not null' => FALSE,
    ));
  }
}

function _phuong_tien_ensure_extended_fields() {
  if (!db_table_exists('phuong_tien')) return;
  _phuong_tien_ensure_thong_tin_json_field();
  $fields = array(
    'mau_sac' => array('type' => 'varchar', 'length' => 50, 'not null' => FALSE),
    'tai_trong' => array('type' => 'numeric', 'precision' => 12, 'scale' => 2, 'not null' => FALSE),
    'tu_trong' => array('type' => 'numeric', 'precision' => 12, 'scale' => 2, 'not null' => FALSE),
    'so_cau' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE),
    'loai_mooc' => array('type' => 'varchar', 'length' => 50, 'not null' => FALSE),
    'so_truc' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE),
    'chieu_dai_mooc' => array('type' => 'varchar', 'length' => 20, 'not null' => FALSE),
    'so_giay_phep_lien_van' => array('type' => 'varchar', 'length' => 100, 'not null' => FALSE),
    'han_giay_phep_lien_van' => array('type' => 'varchar', 'length' => 10, 'not null' => FALSE),
  );
  foreach ($fields as $field => $spec) {
    if (!db_field_exists('phuong_tien', $field)) {
      db_add_field('phuong_tien', $field, $spec);
    }
  }
}

function _phuong_tien_normalize_record($row) {
  if (!$row) return $row;
  $json = _phuong_tien_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '');
  if (empty($json['files']) || !is_array($json['files'])) {
    $json['files'] = array();
  }
  foreach ($json['files'] as &$file) {
    if (!empty($file['uri'])) {
      $file['url'] = file_create_url($file['uri']);
    }
  }
  unset($file);
  $row->thong_tin_json = $json;
  $row->files = $json['files'];
  return $row;
}

function _phuong_tien_file_type_label($type) {
  $labels = array(
    'dang_ky_xe' => 'Đăng ký xe',
    'dang_kiem' => 'Đăng kiểm',
    'bao_hiem_than_vo' => 'Bảo hiểm thân vỏ',
    'bao_hiem_tnds' => 'Bảo hiểm TNDS',
    'phu_hieu' => 'Phù hiệu',
    'khac' => 'Khác',
  );
  return isset($labels[$type]) ? $labels[$type] : 'Khác';
}

function _phuong_tien_file_index($files, $file_id) {
  foreach ($files as $index => $file) {
    if (!empty($file['id']) && (string) $file['id'] === (string) $file_id) {
      return $index;
    }
  }
  return -1;
}

function _phuong_tien_save_uploaded_file($field, $dir) {
  if (empty($_FILES[$field]) || empty($_FILES[$field]['name'])) return NULL;

  $upload = $_FILES[$field];
  if (!empty($upload['error'])) return NULL;

  $max_size = 10 * 1024 * 1024;
  $size = isset($upload['size']) ? (int) $upload['size'] : 0;
  if ($size <= 0 || $size > $max_size) return FALSE;

  $original = drupal_basename($upload['name']);
  $ext = strtolower(pathinfo($original, PATHINFO_EXTENSION));
  $allowed_ext = array('jpg', 'jpeg', 'png', 'webp', 'pdf');
  if (!in_array($ext, $allowed_ext)) return FALSE;
  if (!is_uploaded_file($upload['tmp_name'])) return FALSE;

  $safe_name = file_munge_filename($original, 'jpg jpeg png webp pdf', FALSE);
  $destination = file_unmanaged_save_data(file_get_contents($upload['tmp_name']), $dir . '/' . $safe_name, FILE_EXISTS_RENAME);
  if (!$destination) return FALSE;

  $mime = file_get_mimetype($destination);
  $allowed_mime = array('image/jpeg', 'image/png', 'image/webp', 'application/pdf');
  if ($mime && !in_array($mime, $allowed_mime)) {
    file_unmanaged_delete($destination);
    return FALSE;
  }

  global $user;
  $file = new stdClass();
  $file->uid = isset($user->uid) ? (int) $user->uid : 0;
  $file->filename = $original;
  $file->uri = $destination;
  $file->filemime = $mime ?: 'application/octet-stream';
  $file->filesize = filesize($destination);
  $file->status = FILE_STATUS_PERMANENT;
  return file_save($file);
}

/**
 * Normalize BKS: strip spaces, dots, dashes, special chars → uppercase alphanumeric only.
 * "15-h 555.55" → "15H55555"
 */
function _phuong_tien_normalize_bks($bks) {
  return strtoupper(preg_replace('/[^a-zA-Z0-9]/', '', $bks));
}

/**
 * Check unique BKS using normalized value.
 */
function _phuong_tien_check_unique($input, $exclude_nid = NULL) {
  if (!isset($input['bks'])) return NULL;
  $raw = trim($input['bks']);
  if ($raw === '') return NULL;
  $norm = _phuong_tien_normalize_bks($raw);

  $sql = "SELECT nid FROM {phuong_tien}
    WHERE UPPER(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(bks, ' ', ''), '.', ''), '-', ''), '/', ''), ',', '')) = :norm
    AND hoat_dong = 1";
  $args = array(':norm' => $norm);
  if ($exclude_nid !== NULL) {
    $sql .= " AND nid <> :ex";
    $args[':ex'] = $exclude_nid;
  }
  $sql .= " LIMIT 1";
  $exists = db_query($sql, $args)->fetchField();
  if ($exists) {
    return _phuong_tien_fail('Biển kiểm soát "' . $raw . '" đã tồn tại');
  }
  return NULL;
}

/**
 * Check unique ma_tai_san, skip empty values and soft-deleted records.
 */
function _phuong_tien_check_unique_ma_tai_san($input, $exclude_nid = NULL) {
  if (!isset($input['ma_tai_san'])) return NULL;
  $value = trim($input['ma_tai_san']);
  if ($value === '') return NULL;

  $query = db_select('phuong_tien', 'pt');
  $query->fields('pt', array('nid', 'hoat_dong'));
  $query->condition('pt.ma_tai_san', $value);
  if ($exclude_nid !== NULL) {
    $query->condition('pt.nid', $exclude_nid, '<>');
  }
  $query->range(0, 1);
  $exists = $query->execute()->fetchObject();
  if ($exists && $exists->hoat_dong) {
    return _phuong_tien_fail('Mã tài sản "' . $value . '" đã tồn tại');
  }
  return NULL;
}

/**
 * Validate han_phu_hieu >= ngay_phu_hieu (dd/mm/yyyy).
 */
function _phuong_tien_validate_phu_hieu_dates($input) {
  $ngay = isset($input['ngay_phu_hieu']) ? trim($input['ngay_phu_hieu']) : '';
  $han  = isset($input['han_phu_hieu'])  ? trim($input['han_phu_hieu'])  : '';
  if ($ngay === '' || $han === '') return NULL;

  $d1 = DateTime::createFromFormat('d/m/Y', $ngay);
  $d2 = DateTime::createFromFormat('d/m/Y', $han);
  if (!$d1 || !$d2) {
    return _phuong_tien_fail('Ngày phù hiệu không hợp lệ');
  }
  if ($d2 < $d1) {
    return _phuong_tien_fail('Hạn phù hiệu không được trước ngày phù hiệu');
  }
  return NULL;
}

/**
 * Generic unique check for a nullable field.
 */
function _phuong_tien_check_unique_field($field, $label, $input, $exclude_nid = NULL) {
  if (!isset($input[$field])) return NULL;
  $value = trim($input[$field]);
  if ($value === '') return NULL;

  $query = db_select('phuong_tien', 'pt');
  $query->fields('pt', array('nid', 'hoat_dong'));
  $query->condition('pt.' . $field, $value);
  if ($exclude_nid !== NULL) {
    $query->condition('pt.nid', $exclude_nid, '<>');
  }
  $query->range(0, 1);
  $exists = $query->execute()->fetchObject();
  if ($exists && $exists->hoat_dong) {
    return _phuong_tien_fail($label . ' "' . $value . '" đã tồn tại');
  }
  return NULL;
}

/*******************************************************************************
 * REST: COLLECTION — GET /api/phuong-tien, POST /api/phuong-tien
 ******************************************************************************/

function phuong_tien_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _phuong_tien_rest_list();
    case 'POST':
      return _phuong_tien_rest_create();
    default:
      return _phuong_tien_method_not_allowed('GET, POST');
  }
}

function _phuong_tien_rest_list() {
  _phuong_tien_ensure_extended_fields();
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(500, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('phuong_tien', 'pt');
  $query->fields('pt');

  // Join active driver assignment
  $query->leftJoin('phuong_tien_lai_xe', 'ptlx', 'pt.nid = ptlx.nid_phuong_tien AND ptlx.hoat_dong = 1');
  $query->addField('ptlx', 'id', 'ptlx_id');
  $query->addField('ptlx', 'nid_lai_xe', 'nid_lai_xe');

  // Join lai_xe for name
  $query->leftJoin('lai_xe', 'lx', 'ptlx.nid_lai_xe = lx.nid');
  $query->addField('lx', 'ten', 'lai_xe_ten');
  $query->addField('lx', 'sdt', 'lai_xe_sdt');
  $query->addField('lx', 'so_bang_lai', 'lai_xe_bang_lai');

  $query->condition('pt.hoat_dong', 1);
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('pt.bks', $like, 'LIKE')
      ->condition('pt.ma_tai_san', $like, 'LIKE')
      ->condition('pt.hang_xe', $like, 'LIKE')
      ->condition('pt.mau_sac', $like, 'LIKE')
      ->condition('pt.so_giay_phep_lien_van', $like, 'LIKE')
      ->condition('pt.loai_phuong_tien', $like, 'LIKE');
    $query->condition($or);
  }
  if (!empty($_GET['loai_phuong_tien'])) {
    $query->condition('pt.loai_phuong_tien', $_GET['loai_phuong_tien']);
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('pt.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  // Build nested lai_xe object
  foreach ($rows as &$row) {
    if (!empty($row->nid_lai_xe)) {
      $row->lai_xe = (object) array(
        'nid' => (int) $row->nid_lai_xe,
        'ten' => $row->lai_xe_ten,
        'sdt' => $row->lai_xe_sdt,
        'so_bang_lai' => $row->lai_xe_bang_lai,
      );
    } else {
      $row->lai_xe = NULL;
    }
    unset($row->ptlx_id);
    unset($row->nid_lai_xe);
    unset($row->lai_xe_ten);
    unset($row->lai_xe_sdt);
    unset($row->lai_xe_bang_lai);
    _phuong_tien_normalize_record($row);
  }
  unset($row);

  $total_pages = (int) ceil($total / $limit);

  return _phuong_tien_success(array(
    'items' => $rows ?: array(),
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _phuong_tien_rest_create() {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền tạo phương tiện');
  }

  $input = _phuong_tien_input();

  if (empty($input['bks'])) {
    return _phuong_tien_fail('Biển kiểm soát (bks) bắt buộc');
  }

  $dup = _phuong_tien_check_unique($input);
  if ($dup) return $dup;

  $dup_ms = _phuong_tien_check_unique_ma_tai_san($input);
  if ($dup_ms) return $dup_ms;

  $date_err = _phuong_tien_validate_phu_hieu_dates($input);
  if ($date_err) return $date_err;

  $unique_fields = array(
    'so_dang_kiem' => 'Số đăng kiểm',
    'so_bao_hiem_than_vo' => 'Số bảo hiểm thân vỏ',
    'so_bao_hiem_tnds' => 'Số bảo hiểm TNDS',
  );
  foreach ($unique_fields as $field => $label) {
    $err = _phuong_tien_check_unique_field($field, $label, $input);
    if ($err) return $err;
  }

  _phuong_tien_ensure_extended_fields();

  $transaction = db_transaction();
  try {
    $nid = db_insert('phuong_tien')
      ->fields(array(
        'bks' => $input['bks'],
        'ma_tai_san' => isset($input['ma_tai_san']) && trim($input['ma_tai_san']) !== '' ? $input['ma_tai_san'] : NULL,
        'loai_phuong_tien' => isset($input['loai_phuong_tien']) ? $input['loai_phuong_tien'] : '',
        'hang_xe' => isset($input['hang_xe']) ? $input['hang_xe'] : '',
        'mau_sac' => isset($input['mau_sac']) ? $input['mau_sac'] : '',
        'nam_san_xuat' => isset($input['nam_san_xuat']) && $input['nam_san_xuat'] !== '' ? (int) $input['nam_san_xuat'] : NULL,
        'tai_trong' => isset($input['tai_trong']) && $input['tai_trong'] !== '' ? $input['tai_trong'] : NULL,
        'tu_trong' => isset($input['tu_trong']) && $input['tu_trong'] !== '' ? $input['tu_trong'] : NULL,
        'so_cau' => isset($input['so_cau']) && $input['so_cau'] !== '' ? (int) $input['so_cau'] : NULL,
        'loai_mooc' => isset($input['loai_mooc']) ? $input['loai_mooc'] : '',
        'so_truc' => isset($input['so_truc']) && $input['so_truc'] !== '' ? (int) $input['so_truc'] : NULL,
        'chieu_dai_mooc' => isset($input['chieu_dai_mooc']) ? _phuong_tien_numeric_only($input['chieu_dai_mooc']) : '',
        'gia_mua' => isset($input['gia_mua']) && $input['gia_mua'] !== '' ? $input['gia_mua'] : NULL,
        'ngay_mua' => isset($input['ngay_mua']) ? $input['ngay_mua'] : '',
        'so_dang_kiem' => isset($input['so_dang_kiem']) ? $input['so_dang_kiem'] : '',
        'han_dang_kiem' => isset($input['han_dang_kiem']) ? $input['han_dang_kiem'] : '',
        'so_bao_hiem_than_vo' => isset($input['so_bao_hiem_than_vo']) ? $input['so_bao_hiem_than_vo'] : '',
        'han_bao_hiem_than_vo' => isset($input['han_bao_hiem_than_vo']) ? $input['han_bao_hiem_than_vo'] : '',
        'so_bao_hiem_tnds' => isset($input['so_bao_hiem_tnds']) ? $input['so_bao_hiem_tnds'] : '',
        'han_bao_hiem_tnds' => isset($input['han_bao_hiem_tnds']) ? $input['han_bao_hiem_tnds'] : '',
        'ngay_phu_hieu' => isset($input['ngay_phu_hieu']) ? $input['ngay_phu_hieu'] : '',
        'han_phu_hieu' => isset($input['han_phu_hieu']) ? $input['han_phu_hieu'] : '',
        'so_giay_phep_lien_van' => isset($input['so_giay_phep_lien_van']) ? $input['so_giay_phep_lien_van'] : '',
        'han_giay_phep_lien_van' => isset($input['han_giay_phep_lien_van']) ? $input['han_giay_phep_lien_van'] : '',
        'thong_tin_json' => _phuong_tien_json_encode(array('files' => array())),
        'hoat_dong' => isset($input['hoat_dong']) ? (int) $input['hoat_dong'] : 1,
        'created' => date('Y-m-d H:i:s', REQUEST_TIME),
        'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
      ))
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $nid))->fetch();
    _phuong_tien_normalize_record($row);

    watchdog('phuong_tien', 'Tạo phương tiện #%id: %bks', array(
      '%id' => $nid,
      '%bks' => $input['bks'],
    ));

    return _phuong_tien_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi tạo phương tiện: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _phuong_tien_error('Lỗi hệ thống khi tạo phương tiện');
  }
}

/*******************************************************************************
 * REST: ITEM — GET /api/phuong-tien/{id}, PUT, DELETE
 ******************************************************************************/

function phuong_tien_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _phuong_tien_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _phuong_tien_rest_get($id);
    case 'PUT':
      return _phuong_tien_rest_update($id);
    case 'DELETE':
      return _phuong_tien_rest_delete($id);
    default:
      return _phuong_tien_method_not_allowed('GET, PUT, DELETE');
  }
}

function _phuong_tien_rest_get($id) {
  _phuong_tien_ensure_extended_fields();
  $query = db_select('phuong_tien', 'pt');
  $query->fields('pt');
  $query->leftJoin('phuong_tien_lai_xe', 'ptlx', 'pt.nid = ptlx.nid_phuong_tien AND ptlx.hoat_dong = 1');
  $query->addField('ptlx', 'id', 'ptlx_id');
  $query->addField('ptlx', 'nid_lai_xe', 'nid_lai_xe');
  $query->leftJoin('lai_xe', 'lx', 'ptlx.nid_lai_xe = lx.nid');
  $query->addField('lx', 'ten', 'lai_xe_ten');
  $query->addField('lx', 'sdt', 'lai_xe_sdt');
  $query->addField('lx', 'so_bang_lai', 'lai_xe_bang_lai');
  $query->condition('pt.nid', $id);
  $row = $query->execute()->fetch();

  if (!$row) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  if (!empty($row->nid_lai_xe)) {
    $row->lai_xe = (object) array(
      'nid' => (int) $row->nid_lai_xe,
      'ten' => $row->lai_xe_ten,
      'sdt' => $row->lai_xe_sdt,
      'so_bang_lai' => $row->lai_xe_bang_lai,
    );
  } else {
    $row->lai_xe = NULL;
  }
  unset($row->ptlx_id);
  unset($row->nid_lai_xe);
  unset($row->lai_xe_ten);
  unset($row->lai_xe_sdt);
  unset($row->lai_xe_bang_lai);
  _phuong_tien_normalize_record($row);

  return _phuong_tien_success($row);
}

function _phuong_tien_rest_update($id) {
  _phuong_tien_ensure_extended_fields();
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền sửa phương tiện');
  }

  $existing = db_query("SELECT nid FROM {phuong_tien} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $input = _phuong_tien_input();

  if (empty($input['bks'])) {
    return _phuong_tien_fail('Biển kiểm soát (bks) bắt buộc');
  }

  $dup = _phuong_tien_check_unique($input, $id);
  if ($dup) return $dup;

  $dup_ms = _phuong_tien_check_unique_ma_tai_san($input, $id);
  if ($dup_ms) return $dup_ms;

  $date_err = _phuong_tien_validate_phu_hieu_dates($input);
  if ($date_err) return $date_err;

  $unique_fields = array(
    'so_dang_kiem' => 'Số đăng kiểm',
    'so_bao_hiem_than_vo' => 'Số bảo hiểm thân vỏ',
    'so_bao_hiem_tnds' => 'Số bảo hiểm TNDS',
  );
  foreach ($unique_fields as $field => $label) {
    $err = _phuong_tien_check_unique_field($field, $label, $input, $id);
    if ($err) return $err;
  }

  $fields = array(
    'bks', 'ma_tai_san', 'loai_phuong_tien', 'hang_xe', 'nam_san_xuat',
    'mau_sac', 'tai_trong', 'tu_trong', 'so_cau', 'loai_mooc', 'so_truc',
    'chieu_dai_mooc', 'gia_mua', 'ngay_mua', 'so_dang_kiem', 'han_dang_kiem',
    'so_bao_hiem_than_vo', 'han_bao_hiem_than_vo', 'so_bao_hiem_tnds',
    'han_bao_hiem_tnds', 'ngay_phu_hieu', 'han_phu_hieu',
    'so_giay_phep_lien_van', 'han_giay_phep_lien_van', 'hoat_dong',
  );
  $nullable = array('ma_tai_san', 'nam_san_xuat', 'gia_mua', 'tai_trong', 'tu_trong', 'so_cau', 'so_truc');

  $update = array('changed' => date('Y-m-d H:i:s', REQUEST_TIME));
  foreach ($fields as $f) {
    if (array_key_exists($f, $input)) {
      $val = $input[$f];
      if (in_array($f, $nullable) && is_string($val) && trim($val) === '') {
        $val = NULL;
      }
      if ($f === 'chieu_dai_mooc') {
        $val = _phuong_tien_numeric_only($val);
      }
      $update[$f] = $val;
    }
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien')
      ->fields($update)
      ->condition('nid', $id)
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $id))->fetch();
    _phuong_tien_normalize_record($row);

    watchdog('phuong_tien', 'Cập nhật phương tiện #%id', array('%id' => $id));

    return _phuong_tien_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi cập nhật phương tiện #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _phuong_tien_error('Lỗi hệ thống khi cập nhật phương tiện');
  }
}

function _phuong_tien_rest_delete($id) {
  if (!user_access('phuong_tien_delete')) {
    return _phuong_tien_unauthorized('Bạn không có quyền xoá phương tiện');
  }

  $existing = db_query("SELECT nid, bks FROM {phuong_tien} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('nid', $id)
      ->execute();

    watchdog('phuong_tien', 'Xoá (soft) phương tiện #%id: %bks', array(
      '%id' => $id,
      '%bks' => $existing->bks,
    ));

    return _phuong_tien_success(array('nid' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi xoá phương tiện #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _phuong_tien_error('Lỗi hệ thống khi xoá phương tiện');
  }
}

/*******************************************************************************
 * REST: VEHICLE FILES — POST /api/phuong-tien/{id}/file, PUT/DELETE /file/{file_id}
 ******************************************************************************/

function phuong_tien_rest_file_collection($id) {
  $id = (int) $id;
  if (!$id) {
    return _phuong_tien_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'POST':
      return _phuong_tien_rest_file_upload($id);
    default:
      return _phuong_tien_method_not_allowed('POST');
  }
}

function phuong_tien_rest_file_item($id, $file_id) {
  $id = (int) $id;
  $file_id = trim((string) $file_id);
  if (!$id || $file_id === '') {
    return _phuong_tien_fail('Thông tin file không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'PUT':
      return _phuong_tien_rest_file_update($id, $file_id);
    case 'DELETE':
      return _phuong_tien_rest_file_delete($id, $file_id);
    default:
      return _phuong_tien_method_not_allowed('PUT, DELETE');
  }
}

function _phuong_tien_load_file_context($id) {
  _phuong_tien_ensure_thong_tin_json_field();
  $row = db_query("SELECT nid, bks, thong_tin_json FROM {phuong_tien} WHERE nid = :id AND hoat_dong = 1", array(':id' => (int) $id))->fetch();
  if (!$row) return NULL;
  $json = _phuong_tien_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '');
  if (empty($json['files']) || !is_array($json['files'])) {
    $json['files'] = array();
  }
  $row->thong_tin_json = $json;
  return $row;
}

function _phuong_tien_save_file_context($id, $json) {
  db_update('phuong_tien')
    ->fields(array(
      'thong_tin_json' => _phuong_tien_json_encode($json),
      'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
    ))
    ->condition('nid', (int) $id)
    ->execute();
}

function _phuong_tien_rest_file_upload($id) {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền upload hồ sơ phương tiện');
  }

  $context = _phuong_tien_load_file_context($id);
  if (!$context) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  if (empty($_FILES['vehicle_file'])) {
    return _phuong_tien_fail('Vui lòng chọn file cần upload');
  }

  $dir = 'public://phuong_tien_files/' . (int) $id;
  if (!file_prepare_directory($dir, FILE_CREATE_DIRECTORY | FILE_MODIFY_PERMISSIONS)) {
    return _phuong_tien_error('Không thể tạo thư mục lưu hồ sơ phương tiện');
  }

  $file = _phuong_tien_save_uploaded_file('vehicle_file', $dir);
  if (!$file) {
    return _phuong_tien_fail('File không hợp lệ. Chỉ hỗ trợ ảnh JPG, JPEG, PNG, WEBP hoặc PDF tối đa 10MB');
  }

  global $user;
  $loai = !empty($_POST['loai']) ? trim($_POST['loai']) : 'khac';
  $title = !empty($_POST['ten_hien_thi']) ? trim($_POST['ten_hien_thi']) : $file->filename;
  $item = array(
    'id' => 'file_' . REQUEST_TIME . '_' . (int) $file->fid,
    'loai' => $loai,
    'loai_label' => _phuong_tien_file_type_label($loai),
    'ten_hien_thi' => $title,
    'fid' => (int) $file->fid,
    'filename' => $file->filename,
    'uri' => $file->uri,
    'url' => file_create_url($file->uri),
    'mime' => $file->filemime,
    'size' => (int) $file->filesize,
    'uploaded' => REQUEST_TIME,
    'uploaded_text' => date('d/m/Y H:i', REQUEST_TIME),
    'uid' => isset($user->uid) ? (int) $user->uid : 0,
  );

  $json = $context->thong_tin_json;
  $json['files'][] = $item;
  _phuong_tien_save_file_context($id, $json);

  watchdog('phuong_tien', 'Upload hồ sơ phương tiện #%id: %file', array('%id' => $id, '%file' => $file->filename));

  return _phuong_tien_success(array(
    'nid' => $id,
    'file' => $item,
    'files' => $json['files'],
  ));
}

function _phuong_tien_rest_file_update($id, $file_id) {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền sửa hồ sơ phương tiện');
  }

  $context = _phuong_tien_load_file_context($id);
  if (!$context) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $json = $context->thong_tin_json;
  $index = _phuong_tien_file_index($json['files'], $file_id);
  if ($index < 0) {
    return _phuong_tien_not_found('File không tồn tại');
  }

  $input = _phuong_tien_input();
  if (isset($input['loai'])) {
    $json['files'][$index]['loai'] = trim($input['loai']) ?: 'khac';
    $json['files'][$index]['loai_label'] = _phuong_tien_file_type_label($json['files'][$index]['loai']);
  }
  if (isset($input['ten_hien_thi'])) {
    $title = trim($input['ten_hien_thi']);
    $json['files'][$index]['ten_hien_thi'] = $title !== '' ? $title : (isset($json['files'][$index]['filename']) ? $json['files'][$index]['filename'] : '');
  }

  _phuong_tien_save_file_context($id, $json);

  return _phuong_tien_success(array(
    'nid' => $id,
    'file' => $json['files'][$index],
    'files' => $json['files'],
  ));
}

function _phuong_tien_rest_file_delete($id, $file_id) {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền xoá hồ sơ phương tiện');
  }

  $context = _phuong_tien_load_file_context($id);
  if (!$context) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $json = $context->thong_tin_json;
  $index = _phuong_tien_file_index($json['files'], $file_id);
  if ($index < 0) {
    return _phuong_tien_not_found('File không tồn tại');
  }

  $deleted = $json['files'][$index];
  if (!empty($deleted['fid'])) {
    $file = file_load((int) $deleted['fid']);
    if ($file) {
      file_delete($file, TRUE);
    }
  }

  array_splice($json['files'], $index, 1);
  _phuong_tien_save_file_context($id, $json);

  watchdog('phuong_tien', 'Xoá hồ sơ phương tiện #%id: %file', array(
    '%id' => $id,
    '%file' => !empty($deleted['filename']) ? $deleted['filename'] : $file_id,
  ));

  return _phuong_tien_success(array(
    'nid' => $id,
    'deleted' => TRUE,
    'files' => $json['files'],
  ));
}

/*******************************************************************************
 * UI PAGE CALLBACKS
 ******************************************************************************/

function phuong_tien_page_list() {
  drupal_add_css(drupal_get_path('module', 'phuong_tien') . '/assets/css/phuong_tien.css');
  drupal_add_js(drupal_get_path('module', 'phuong_tien') . '/assets/js/phuong_tien.js');

  // Load phuong_tien_lai_xe assets for assign driver feature
  $ptlx_path = drupal_get_path('module', 'phuong_tien_lai_xe');
  if ($ptlx_path) {
    drupal_add_css($ptlx_path . '/assets/css/phuong_tien_lai_xe.css');
    drupal_add_js($ptlx_path . '/assets/js/phuong_tien_lai_xe.js');
  }

  drupal_add_js(array('phuong_tien' => array(
    'permissions' => array(
      'phuong_tien_view' => user_access('phuong_tien_view'),
      'phuong_tien_create' => user_access('phuong_tien_create'),
      'phuong_tien_delete' => user_access('phuong_tien_delete'),
    ),
  )), 'setting');

  return theme('phuong_tien_list_page');
}

function phuong_tien_page_han($type) {
  $valid_types = array('dang-kiem', 'bao-hiem-than-vo', 'tnds', 'phu-hieu', 'giay-phep-lien-van');
  if (!in_array($type, $valid_types)) {
    drupal_not_found();
    return;
  }

  drupal_add_css(drupal_get_path('module', 'phuong_tien') . '/assets/css/phuong_tien_han.css');
  drupal_add_js(drupal_get_path('module', 'phuong_tien') . '/assets/js/phuong_tien_han.js');

  drupal_add_js(array('phuong_tien_han' => array(
    'type' => $type,
    'permissions' => array(
      'phuong_tien_view' => user_access('phuong_tien_view'),
    ),
  )), 'setting');

  return theme('phuong_tien_han_page');
}
