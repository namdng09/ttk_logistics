<?php

/**
 * @file
 * Phương Tiện — Vehicle management. Custom schema, RESTful API + UI.
 */

/**
 * Implements hook_permission().
 */
function phuong_tien_permission() {
  return array(
    'phuong_tien_view' => array('title' => t('Xem phương tiện')),
    'phuong_tien_create' => array('title' => t('Tạo/sửa phương tiện')),
    'phuong_tien_delete' => array('title' => t('Xoá phương tiện')),
  );
}

/**
 * Implements hook_init() — CORS for API routes.
 */
function phuong_tien_init() {
  $path = current_path();
  if (strpos($path, 'api/phuong-tien') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function phuong_tien_menu() {
  $items = array();

  // --- RESTful API ---
  $items['api/phuong-tien'] = array(
    'page callback' => 'phuong_tien_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/phuong-tien/%'] = array(
    'page callback' => 'phuong_tien_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  // --- UI Pages ---
  $items['phuong-tien'] = array(
    'title' => 'Danh sách phương tiện',
    'page callback' => 'phuong_tien_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['phuong-tien/them-moi'] = array(
    'title' => 'Thêm phương tiện',
    'page callback' => 'phuong_tien_page_form',
    'access arguments' => array('phuong_tien_create'),
    'type' => MENU_CALLBACK,
  );
  $items['phuong-tien/%'] = array(
    'title' => 'Chi tiết phương tiện',
    'page callback' => 'phuong_tien_page_form',
    'page arguments' => array(1),
    'access callback' => 'user_is_logged_in',
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Implements hook_theme().
 */
function phuong_tien_theme() {
  $path = drupal_get_path('module', 'phuong_tien') . '/templates';
  return array(
    'phuong_tien_list_page' => array(
      'template' => 'phuong-tien-list',
      'path' => $path,
    ),
    'phuong_tien_form_page' => array(
      'template' => 'phuong-tien-form',
      'path' => $path,
      'variables' => array('nid' => NULL),
    ),
  );
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _phuong_tien_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

function _phuong_tien_require_auth() {
  $token = NULL;
  if (function_exists('getallheaders')) {
    $headers = getallheaders();
    if (!empty($headers['Authorization'])) {
      $token = str_replace('Bearer ', '', $headers['Authorization']);
    }
  }
  if (!$token && !empty($_GET['token'])) {
    $token = $_GET['token'];
  }
  if (!$token) {
    drupal_add_http_header('Status', '401 Unauthorized');
    return array('status' => 'fail', 'message' => 'Thiếu token xác thực');
  }
  module_load_include('module', 'user_login_api', 'user_login_api');
  if (!function_exists('api_validate_token')) {
    drupal_add_http_header('Status', '500 Internal Server Error');
    return array('status' => 'error', 'message' => 'Hệ thống xác thực chưa sẵn sàng');
  }
  $user = api_validate_token($token);
  if (!$user) {
    drupal_add_http_header('Status', '401 Unauthorized');
    return array('status' => 'fail', 'message' => 'Token không hợp lệ');
  }
  return $user;
}

function _phuong_tien_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _phuong_tien_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _phuong_tien_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _phuong_tien_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

/*******************************************************************************
 * REST: COLLECTION — GET /api/phuong-tien, POST /api/phuong-tien
 ******************************************************************************/

function phuong_tien_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _phuong_tien_rest_list();
    case 'POST':
      return _phuong_tien_rest_create();
    default:
      return _phuong_tien_method_not_allowed('GET, POST');
  }
}

function _phuong_tien_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('phuong_tien', 'pt');
  $query->fields('pt');

  if (isset($_GET['hoat_dong'])) {
    $query->condition('pt.hoat_dong', (int) $_GET['hoat_dong']);
  }
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('pt.bks', $like, 'LIKE')
      ->condition('pt.ma_tai_san', $like, 'LIKE')
      ->condition('pt.hang_xe', $like, 'LIKE');
    $query->condition($or);
  }
  if (!empty($_GET['loai_phuong_tien'])) {
    $query->condition('pt.loai_phuong_tien', $_GET['loai_phuong_tien']);
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('pt.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $total_pages = (int) ceil($total / $limit);

  return _phuong_tien_success(array(
    'items' => $rows ?: array(),
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
  ));
}

function _phuong_tien_rest_create() {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền tạo phương tiện');
  }

  $input = _phuong_tien_input();

  if (empty($input['bks'])) {
    return _phuong_tien_fail('Biển kiểm soát (bks) bắt buộc');
  }

  $transaction = db_transaction();
  try {
    $nid = db_insert('phuong_tien')
      ->fields(array(
        'bks' => $input['bks'],
        'ma_tai_san' => isset($input['ma_tai_san']) ? $input['ma_tai_san'] : '',
        'loai_phuong_tien' => isset($input['loai_phuong_tien']) ? $input['loai_phuong_tien'] : '',
        'hang_xe' => isset($input['hang_xe']) ? $input['hang_xe'] : '',
        'nam_san_xuat' => isset($input['nam_san_xuat']) ? (int) $input['nam_san_xuat'] : NULL,
        'gia_mua' => isset($input['gia_mua']) ? $input['gia_mua'] : NULL,
        'ngay_mua' => isset($input['ngay_mua']) ? $input['ngay_mua'] : '',
        'so_dang_kiem' => isset($input['so_dang_kiem']) ? $input['so_dang_kiem'] : '',
        'han_dang_kiem' => isset($input['han_dang_kiem']) ? $input['han_dang_kiem'] : '',
        'so_bao_hiem_than_vo' => isset($input['so_bao_hiem_than_vo']) ? $input['so_bao_hiem_than_vo'] : '',
        'han_bao_hiem_than_vo' => isset($input['han_bao_hiem_than_vo']) ? $input['han_bao_hiem_than_vo'] : '',
        'so_bao_hiem_tnds' => isset($input['so_bao_hiem_tnds']) ? $input['so_bao_hiem_tnds'] : '',
        'han_bao_hiem_tnds' => isset($input['han_bao_hiem_tnds']) ? $input['han_bao_hiem_tnds'] : '',
        'ngay_phu_hieu' => isset($input['ngay_phu_hieu']) ? $input['ngay_phu_hieu'] : '',
        'han_phu_hieu' => isset($input['han_phu_hieu']) ? $input['han_phu_hieu'] : '',
        'hoat_dong' => isset($input['hoat_dong']) ? (int) $input['hoat_dong'] : 1,
        'created' => date('Y-m-d H:i:s', REQUEST_TIME),
        'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
      ))
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $nid))->fetch();

    watchdog('phuong_tien', 'Tạo phương tiện #%id: %bks', array(
      '%id' => $nid,
      '%bks' => $input['bks'],
    ));

    return _phuong_tien_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi tạo phương tiện: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    if (strpos($e->getMessage(), 'Duplicate entry') !== FALSE) {
      return _phuong_tien_fail('Biển kiểm soát "' . $input['bks'] . '" đã tồn tại');
    }
    return _phuong_tien_error('Lỗi hệ thống khi tạo phương tiện');
  }
}

/*******************************************************************************
 * REST: ITEM — GET /api/phuong-tien/{id}, PUT, DELETE
 ******************************************************************************/

function phuong_tien_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _phuong_tien_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _phuong_tien_rest_get($id);
    case 'PUT':
      return _phuong_tien_rest_update($id);
    case 'DELETE':
      return _phuong_tien_rest_delete($id);
    default:
      return _phuong_tien_method_not_allowed('GET, PUT, DELETE');
  }
}

function _phuong_tien_rest_get($id) {
  $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $id))->fetch();
  if (!$row) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }
  return _phuong_tien_success($row);
}

function _phuong_tien_rest_update($id) {
  if (!user_access('phuong_tien_create')) {
    return _phuong_tien_unauthorized('Bạn không có quyền sửa phương tiện');
  }

  $existing = db_query("SELECT nid FROM {phuong_tien} WHERE nid = :id", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $input = _phuong_tien_input();
  $fields = array(
    'bks', 'ma_tai_san', 'loai_phuong_tien', 'hang_xe', 'nam_san_xuat',
    'gia_mua', 'ngay_mua', 'so_dang_kiem', 'han_dang_kiem',
    'so_bao_hiem_than_vo', 'han_bao_hiem_than_vo', 'so_bao_hiem_tnds',
    'han_bao_hiem_tnds', 'ngay_phu_hieu', 'han_phu_hieu', 'hoat_dong',
  );

  $update = array('changed' => date('Y-m-d H:i:s', REQUEST_TIME));
  foreach ($fields as $f) {
    if (array_key_exists($f, $input)) {
      $update[$f] = $input[$f];
    }
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien')
      ->fields($update)
      ->condition('nid', $id)
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $id))->fetch();

    watchdog('phuong_tien', 'Cập nhật phương tiện #%id', array('%id' => $id));

    return _phuong_tien_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi cập nhật phương tiện #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    if (strpos($e->getMessage(), 'Duplicate entry') !== FALSE) {
      return _phuong_tien_fail('Biển kiểm soát "' . $input['bks'] . '" đã tồn tại');
    }
    return _phuong_tien_error('Lỗi hệ thống khi cập nhật phương tiện');
  }
}

function _phuong_tien_rest_delete($id) {
  if (!user_access('phuong_tien_delete')) {
    return _phuong_tien_unauthorized('Bạn không có quyền xoá phương tiện');
  }

  $existing = db_query("SELECT nid, bks FROM {phuong_tien} WHERE nid = :id", array(':id' => $id))->fetch();
  if (!$existing) {
    return _phuong_tien_not_found('Phương tiện không tồn tại');
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('nid', $id)
      ->execute();

    watchdog('phuong_tien', 'Xoá (soft) phương tiện #%id: %bks', array(
      '%id' => $id,
      '%bks' => $existing->bks,
    ));

    return _phuong_tien_success(array('nid' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien', 'Lỗi xoá phương tiện #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _phuong_tien_error('Lỗi hệ thống khi xoá phương tiện');
  }
}

/*******************************************************************************
 * UI PAGE CALLBACKS
 ******************************************************************************/

function phuong_tien_page_list() {
  drupal_add_css(drupal_get_path('module', 'phuong_tien') . '/assets/css/phuong_tien.css');
  drupal_add_js(drupal_get_path('module', 'phuong_tien') . '/assets/js/phuong_tien.js');

  drupal_add_js(array('phuong_tien' => array(
    'permissions' => array(
      'phuong_tien_view' => user_access('phuong_tien_view'),
      'phuong_tien_create' => user_access('phuong_tien_create'),
      'phuong_tien_delete' => user_access('phuong_tien_delete'),
    ),
  )), 'setting');

  return theme('phuong_tien_list_page');
}

function phuong_tien_page_form($nid = NULL) {
  drupal_add_css(drupal_get_path('module', 'phuong_tien') . '/assets/css/phuong_tien.css');
  drupal_add_js(drupal_get_path('module', 'phuong_tien') . '/assets/js/phuong_tien.js');

  $is_edit = FALSE;
  $data = NULL;

  if ($nid) {
    $nid = (int) $nid;
    $row = db_query("SELECT * FROM {phuong_tien} WHERE nid = :id", array(':id' => $nid))->fetch();
    if (!$row) {
      drupal_not_found();
      return;
    }
    $data = $row;
    $is_edit = TRUE;
  }

  drupal_add_js(array('phuong_tien' => array(
    'nid' => $nid,
    'is_edit' => $is_edit,
    'data' => $data,
  )), 'setting');

  return theme('phuong_tien_form_page', array('nid' => $nid));
}
