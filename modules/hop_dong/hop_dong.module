<?php

/**
 * @file
 * Hợp Đồng — Contract management.
 * RESTful API + Modal CRUD. Files stored as JSON in hop_dong.files column.
 */

/**
 * Implements hook_permission().
 */
function hop_dong_permission() {
  return array(
    'hop_dong_view' => array('title' => t('Xem hợp đồng')),
    'hop_dong_create' => array('title' => t('Tạo/sửa hợp đồng')),
    'hop_dong_delete' => array('title' => t('Xoá hợp đồng')),
  );
}

/**
 * Implements hook_init() — CORS for API routes.
 */
function hop_dong_init() {
  $path = current_path();
  if (strpos($path, 'api/hop-dong') === 0 || strpos($path, 'api/hop-dong-nhan-vien') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function hop_dong_menu() {
  $items = array();

  $items['api/hop-dong'] = array(
    'page callback' => 'hop_dong_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/hop-dong/%'] = array(
    'page callback' => 'hop_dong_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );
  $items['api/hop-dong-nhan-vien'] = array(
    'page callback' => 'hop_dong_nhan_vien_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/hop-dong-nhan-vien/%'] = array(
    'page callback' => 'hop_dong_nhan_vien_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  $items['hop-dong'] = array(
    'title' => 'Danh sách hợp đồng',
    'page callback' => 'hop_dong_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['hop-dong-nhan-vien'] = array(
    'title' => 'Hợp đồng nhân viên',
    'page callback' => 'hop_dong_nhan_vien_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

/**
 * Implements hook_theme().
 */
function hop_dong_theme() {
  $path = drupal_get_path('module', 'hop_dong') . '/templates';
  return array(
    'hop_dong_list_page' => array(
      'template' => 'hop-dong-list',
      'path' => $path,
      'variables' => array('is_employee_contract' => FALSE),
    ),
  );
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _hop_dong_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

function _hop_dong_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _hop_dong_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _hop_dong_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _hop_dong_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _hop_dong_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _hop_dong_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

/**
 * Check unique so_hop_dong (active only).
 */
function _hop_dong_check_unique_so($value, $exclude_nid = NULL) {
  $value = trim($value);
  if ($value === '') return NULL;
  $query = db_select('hop_dong', 'hd');
  $query->fields('hd', array('nid', 'hoat_dong'));
  $query->condition('hd.so_hop_dong', $value);
  $query->condition('hd.loai_doi_tuong', 'khach_hang');
  if ($exclude_nid !== NULL) {
    $query->condition('hd.nid', $exclude_nid, '<>');
  }
  $query->range(0, 1);
  $exists = $query->execute()->fetchObject();
  if ($exists && $exists->hoat_dong) {
    return _hop_dong_fail('Số hợp đồng "' . $value . '" đã tồn tại');
  }
  return NULL;
}

/** Load the employee reference used by an employee contract. */
function _hop_dong_load_nhan_vien($uid) {
  $uid = (int) $uid;
  if (!$uid) return NULL;
  // Employee records are stored in Drupal's users table; this installation
  // does not have an `sdt` column on that table.
  $row = db_query("SELECT uid, name, ten, ma_nhan_vien, mail FROM {users} WHERE uid = :uid AND status = 1", array(':uid' => $uid))->fetch();
  if (!$row) return NULL;
  return array(
    'uid' => (int) $row->uid,
    'ten' => !empty($row->ten) ? $row->ten : $row->name,
    'ma_nhan_vien' => !empty($row->ma_nhan_vien) ? $row->ma_nhan_vien : '',
    'mail' => !empty($row->mail) ? $row->mail : '',
  );
}

function _hop_dong_validate_nhan_vien($uid) {
  if (!(int) $uid || !_hop_dong_load_nhan_vien($uid)) {
    return _hop_dong_fail('Nhân viên không hợp lệ hoặc đã ngừng hoạt động');
  }
  return NULL;
}

/**
 * Load khach_hang data for nesting in response.
 */
function _hop_dong_load_khach_hang($nid) {
  if (!$nid) return NULL;
  $kh = db_query("SELECT * FROM {khach_hang} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $nid))->fetch();
  if (!$kh) return NULL;

  $nv_kinh_doanh = array();
  $nv_rows = db_query("SELECT nv.uid, u.name, u.ten, u.ma_nhan_vien FROM {nhan_vien_khach_hang} nv INNER JOIN {users} u ON u.uid = nv.uid WHERE nv.nid = :nid AND nv.hoat_dong = 1 ORDER BY nv.id ASC", array(':nid' => $nid));
  foreach ($nv_rows as $nv) {
    $nv_kinh_doanh[] = array(
      'uid' => (int) $nv->uid,
      'ten' => isset($nv->ten) ? $nv->ten : $nv->name,
      'username' => $nv->name,
      'ma_nhan_vien' => isset($nv->ma_nhan_vien) ? $nv->ma_nhan_vien : '',
    );
  }

  $ngan_hang = array();
  if (!empty($kh->thong_tin_ngan_hang)) {
    $decoded = json_decode($kh->thong_tin_ngan_hang, TRUE);
    if (is_array($decoded)) {
      $ngan_hang = $decoded;
    }
  }

  return array(
    'nid' => (int) $kh->nid,
    'ten' => $kh->ten,
    'ma_kh' => $kh->ma_kh ? $kh->ma_kh : '',
    'phan_loai' => $kh->phan_loai,
    'cccd_mst' => $kh->cccd_mst ? $kh->cccd_mst : '',
    'sdt' => $kh->sdt ? $kh->sdt : '',
    'dia_chi' => $kh->dia_chi ? $kh->dia_chi : '',
    'thong_tin_ngan_hang' => $ngan_hang,
    'nv_kinh_doanh' => !empty($nv_kinh_doanh) ? $nv_kinh_doanh[0] : NULL,
    'dob' => $kh->dob ? $kh->dob : '',
    'ghi_chu' => $kh->ghi_chu ? $kh->ghi_chu : '',
  );
}

/**
 * Decode files JSON from hop_dong row.
 */
function _hop_dong_decode_files($hd) {
  if (empty($hd->files)) return array();
  $decoded = json_decode($hd->files, TRUE);
  if (!is_array($decoded)) return array();
  foreach ($decoded as &$f) {
    if (!isset($f['file_url']) && !empty($f['file_path'])) {
      $f['file_url'] = file_create_url(file_default_scheme() . '://' . $f['file_path']);
    }
  }
  return $decoded;
}

/**
 * Build row with nested khach_hang data.
 * $with_files = TRUE only for GET detail (not list).
 */
function _hop_dong_load_row($nid, $with_files = FALSE) {
  $hd = db_query("SELECT * FROM {hop_dong} WHERE nid = :nid AND loai_doi_tuong = :type", array(':nid' => $nid, ':type' => 'khach_hang'))->fetch();
  if (!$hd) return NULL;

  $kh_data = NULL;
  if ($hd->khach_hang) {
    $kh_data = _hop_dong_load_khach_hang($hd->khach_hang);
  }

  $row = array(
    'nid' => (int) $hd->nid,
    'so_hop_dong' => $hd->so_hop_dong,
    'ngay_hop_dong' => $hd->ngay_hop_dong ? $hd->ngay_hop_dong : '',
    'han_hop_dong' => $hd->han_hop_dong ? $hd->han_hop_dong : '',
    'khach_hang' => $kh_data,
    'ghi_chu' => $hd->ghi_chu ? $hd->ghi_chu : '',
    'hoat_dong' => (int) $hd->hoat_dong,
  );

  if ($with_files) {
    $row['files'] = _hop_dong_decode_files($hd);
  }

  return $row;
}

/**
 * Allowed MIME types for file upload.
 */
function _hop_dong_allowed_types() {
  return array(
    'application/pdf',
    'image/jpeg',
    'image/png',
    'image/gif',
  );
}

/**
 * Read current files JSON from DB for a hop_dong.
 */
function _hop_dong_get_files($hop_dong_id) {
  $hd = db_query("SELECT files FROM {hop_dong} WHERE nid = :nid", array(':nid' => $hop_dong_id))->fetch();
  if (!$hd) return NULL;
  return _hop_dong_decode_files($hd);
}

/**
 * Write files JSON back to DB for a hop_dong.
 */
function _hop_dong_set_files($hop_dong_id, $files) {
  db_update('hop_dong')
    ->fields(array(
      'files' => json_encode($files),
      'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
    ))
    ->condition('nid', $hop_dong_id)
    ->execute();
}

/**
 * Validate and save uploaded file for a hop_dong.
 * Appends to the files JSON array.
 */
function _hop_dong_save_file($hop_dong_id) {
  $raw = file_get_contents('php://input');
  $input = drupal_json_decode($raw);

  if (empty($input['file']) || empty($input['filename'])) {
    return _hop_dong_fail('Dữ liệu file không hợp lệ');
  }

  $data_url = $input['file'];
  $original_name = $input['filename'];
  $client_size = isset($input['filesize']) ? (int) $input['filesize'] : 0;
  $client_type = isset($input['filetype']) ? $input['filetype'] : '';

  if (strpos($data_url, 'base64,') === FALSE) {
    return _hop_dong_fail('Dữ liệu file không đúng định dạng base64');
  }

  $parts = explode('base64,', $data_url, 2);
  $binary = base64_decode($parts[1]);
  if ($binary === FALSE) {
    return _hop_dong_fail('Không thể giải mã file');
  }

  $actual_size = strlen($binary);
  if ($client_size > 0 && $client_size !== $actual_size) {
    watchdog('hop_dong_dbg', 'Size mismatch: client=@c actual=@a', array('@c' => $client_size, '@a' => $actual_size), WATCHDOG_WARNING);
  }

  $max_size = 10 * 1024 * 1024;
  if ($actual_size > $max_size) {
    return _hop_dong_fail('File vượt quá 10MB');
  }

  $finfo = finfo_open(FILEINFO_MIME_TYPE);
  $mime = finfo_buffer($finfo, $binary);
  finfo_close($finfo);

  if (!in_array($mime, _hop_dong_allowed_types())) {
    return _hop_dong_fail('Định dạng file không được hỗ trợ. Chỉ chấp nhận PDF, JPG, PNG, GIF');
  }

  $dest_dir = file_default_scheme() . '://hop_dong_files/' . $hop_dong_id;
  file_prepare_directory($dest_dir, FILE_CREATE_DIRECTORY);

  $ext = pathinfo($original_name, PATHINFO_EXTENSION);
  $safe_name = 'file_' . REQUEST_TIME . '_' . uniqid() . '.' . $ext;
  $dest = $dest_dir . '/' . $safe_name;

  if (file_put_contents($dest, $binary) === FALSE) {
    return _hop_dong_error('Không thể lưu file lên server');
  }

  $relative_path = 'hop_dong_files/' . $hop_dong_id . '/' . $safe_name;
  $file_id = uniqid('f_', TRUE);

  $file_entry = array(
    'id' => $file_id,
    'file_name' => $original_name,
    'file_path' => $relative_path,
    'file_url' => file_create_url(file_default_scheme() . '://' . $relative_path),
    'file_size' => $actual_size,
    'file_type' => $mime,
    'created' => date('Y-m-d H:i:s', REQUEST_TIME),
  );

  $files = _hop_dong_get_files($hop_dong_id);
  $files[] = $file_entry;
  _hop_dong_set_files($hop_dong_id, $files);

  watchdog('hop_dong', 'Upload file %id cho hợp đồng #%hd: %name', array(
    '%id' => $file_id,
    '%hd' => $hop_dong_id,
    '%name' => $original_name,
  ));

  return $file_entry;
}

/**
 * Delete a file from the JSON array + physical file.
 */
function _hop_dong_delete_file($hop_dong_id, $file_id) {
  $files = _hop_dong_get_files($hop_dong_id);
  if ($files === NULL) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }

  $found = FALSE;
  $new_files = array();
  foreach ($files as $f) {
    if ($f['id'] === $file_id) {
      $full_path = file_default_scheme() . '://' . $f['file_path'];
      if (file_exists($full_path)) {
        file_unmanaged_delete($full_path);
      }
      $found = TRUE;
      continue;
    }
    $new_files[] = $f;
  }

  if (!$found) {
    return _hop_dong_not_found('File không tồn tại');
  }

  _hop_dong_set_files($hop_dong_id, $new_files);

  watchdog('hop_dong', 'Xoá file %id từ hợp đồng #%hd', array(
    '%id' => $file_id,
    '%hd' => $hop_dong_id,
  ));

  return TRUE;
}

/*******************************************************************************
 * REST: COLLECTION — GET /api/hop-dong, POST /api/hop-dong
 ******************************************************************************/

function hop_dong_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _hop_dong_rest_list();
    case 'POST':
      return _hop_dong_rest_create();
    default:
      return _hop_dong_method_not_allowed('GET, POST');
  }
}

function _hop_dong_rest_list() {
  if (!user_access('hop_dong_view')) {
    return _hop_dong_unauthorized('Bạn không có quyền xem hợp đồng');
  }

  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('hop_dong', 'hd');
  $query->fields('hd');
  $query->condition('hd.hoat_dong', 1);
  $query->condition('hd.loai_doi_tuong', 'khach_hang');

  if (!empty($_GET['khach_hang'])) {
    $query->condition('hd.khach_hang', (int) $_GET['khach_hang']);
  }

  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('hd.so_hop_dong', $like, 'LIKE');
    $kh_ids = db_select('khach_hang', 'kh')
      ->fields('kh', array('nid'))
      ->condition('kh.hoat_dong', 1)
      ->condition('kh.ten', $like, 'LIKE')
      ->execute()->fetchCol();
    if (!empty($kh_ids)) {
      $or->condition('hd.khach_hang', $kh_ids, 'IN');
    }
    $query->condition($or);
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('hd.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $items = array();
  foreach ($rows as $hd) {
    $items[] = _hop_dong_load_row($hd->nid);
  }

  $total_pages = (int) ceil($total / $limit);

  return _hop_dong_success(array(
    'items' => $items,
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _hop_dong_rest_create() {
  if (!user_access('hop_dong_create')) {
    return _hop_dong_unauthorized('Bạn không có quyền tạo hợp đồng');
  }

  $input = _hop_dong_input();

  if (empty($input['so_hop_dong'])) {
    return _hop_dong_fail('Số hợp đồng bắt buộc');
  }

  $dupSo = _hop_dong_check_unique_so($input['so_hop_dong']);
  if ($dupSo) return $dupSo;

  $transaction = db_transaction();
  try {
    $nid = db_insert('hop_dong')
      ->fields(array(
        'so_hop_dong' => $input['so_hop_dong'],
        'ngay_hop_dong' => !empty($input['ngay_hop_dong']) ? $input['ngay_hop_dong'] : NULL,
        'han_hop_dong' => !empty($input['han_hop_dong']) ? $input['han_hop_dong'] : NULL,
        'khach_hang' => !empty($input['khach_hang']) ? (int) $input['khach_hang'] : NULL,
        'ghi_chu' => !empty($input['ghi_chu']) ? $input['ghi_chu'] : NULL,
        'hoat_dong' => 1,
        'created' => date('Y-m-d H:i:s', REQUEST_TIME),
        'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
      ))
      ->execute();

    watchdog('hop_dong', 'Tạo hợp đồng #%id: %so', array(
      '%id' => $nid,
      '%so' => $input['so_hop_dong'],
    ));

    return _hop_dong_success(_hop_dong_load_row($nid));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('hop_dong', 'Lỗi tạo hợp đồng: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _hop_dong_error('Lỗi hệ thống khi tạo hợp đồng');
  }
}

/*******************************************************************************
 * REST: ITEM — GET /api/hop-dong/{id}, PUT, DELETE
 ******************************************************************************/

function hop_dong_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    drupal_json_output(_hop_dong_fail('ID không hợp lệ'));
    return;
  }

  if (arg(3) === 'file') {
    $file_id = arg(4);
    $result = NULL;
    if ($_SERVER['REQUEST_METHOD'] === 'POST' && empty($file_id)) {
      $result = _hop_dong_rest_file_upload($id);
    }
    elseif ($_SERVER['REQUEST_METHOD'] === 'DELETE' && !empty($file_id)) {
      $result = _hop_dong_rest_file_delete($id, $file_id);
    }
    else {
      $result = _hop_dong_method_not_allowed('POST, DELETE');
    }
    drupal_json_output($result);
    return;
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      drupal_json_output(_hop_dong_rest_get($id));
      break;
    case 'PUT':
      drupal_json_output(_hop_dong_rest_update($id));
      break;
    case 'DELETE':
      drupal_json_output(_hop_dong_rest_delete($id));
      break;
    default:
      drupal_json_output(_hop_dong_method_not_allowed('GET, PUT, DELETE'));
      break;
  }
}

function _hop_dong_rest_get($id) {
  if (!user_access('hop_dong_view')) {
    return _hop_dong_unauthorized('Bạn không có quyền xem hợp đồng');
  }

  $row = _hop_dong_load_row($id, TRUE);
  if (!$row) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }
  return _hop_dong_success($row);
}

function _hop_dong_rest_update($id) {
  if (!user_access('hop_dong_create')) {
    return _hop_dong_unauthorized('Bạn không có quyền sửa hợp đồng');
  }

  $existing = db_query("SELECT nid FROM {hop_dong} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }

  $input = _hop_dong_input();

  if (empty($input['so_hop_dong'])) {
    return _hop_dong_fail('Số hợp đồng bắt buộc');
  }

  $dupSo = _hop_dong_check_unique_so($input['so_hop_dong'], $id);
  if ($dupSo) return $dupSo;

  $transaction = db_transaction();
  try {
    $fields = array(
      'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
      'so_hop_dong' => $input['so_hop_dong'],
    );

    $optional = array('ngay_hop_dong', 'han_hop_dong', 'ghi_chu');
    foreach ($optional as $f) {
      if (array_key_exists($f, $input)) {
        $fields[$f] = !empty($input[$f]) ? $input[$f] : NULL;
      }
    }
    if (array_key_exists('khach_hang', $input)) {
      $fields['khach_hang'] = !empty($input['khach_hang']) ? (int) $input['khach_hang'] : NULL;
    }

    db_update('hop_dong')
      ->fields($fields)
      ->condition('nid', $id)
      ->execute();

    watchdog('hop_dong', 'Cập nhật hợp đồng #%id', array('%id' => $id));

    return _hop_dong_success(_hop_dong_load_row($id, TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('hop_dong', 'Lỗi cập nhật hợp đồng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _hop_dong_error('Lỗi hệ thống khi cập nhật hợp đồng');
  }
}

function _hop_dong_rest_delete($id) {
  if (!user_access('hop_dong_delete')) {
    return _hop_dong_unauthorized('Bạn không có quyền xoá hợp đồng');
  }

  $existing = db_query("SELECT nid, so_hop_dong FROM {hop_dong} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }

  $transaction = db_transaction();
  try {
    db_update('hop_dong')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('nid', $id)
      ->execute();

    watchdog('hop_dong', 'Xoá (soft) hợp đồng #%id: %so', array(
      '%id' => $id,
      '%so' => $existing->so_hop_dong,
    ));

    return _hop_dong_success(array('nid' => (int) $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('hop_dong', 'Lỗi xoá hợp đồng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _hop_dong_error('Lỗi hệ thống khi xoá hợp đồng');
  }
}

/*******************************************************************************
 * REST: FILE — POST /api/hop-dong/{id}/file, DELETE /api/hop-dong/{id}/file/{fid}
 ******************************************************************************/

function _hop_dong_rest_file_upload($id) {
  if (!user_access('hop_dong_create')) {
    return _hop_dong_unauthorized('Bạn không có quyền tải file lên');
  }

  $existing = db_query("SELECT nid FROM {hop_dong} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }

  $result = _hop_dong_save_file($id);
  if (isset($result['status']) && $result['status'] !== 'success') {
    return $result;
  }

  return _hop_dong_success($result);
}

function _hop_dong_rest_file_delete($id, $file_id) {
  if (!user_access('hop_dong_create')) {
    return _hop_dong_unauthorized('Bạn không có quyền xoá file');
  }

  $existing = db_query("SELECT nid FROM {hop_dong} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _hop_dong_not_found('Hợp đồng không tồn tại');
  }

  $result = _hop_dong_delete_file($id, $file_id);
  if ($result === TRUE) {
    return _hop_dong_success(array('deleted' => TRUE));
  }
  return $result;
}

/*******************************************************************************
 * EMPLOYEE CONTRACT API — /api/hop-dong-nhan-vien
 * Uses the same contract table but is isolated by loai_doi_tuong = nhan_vien.
 ******************************************************************************/

function _hop_dong_nhan_vien_load_row($id, $with_files = FALSE) {
  $hd = db_query("SELECT * FROM {hop_dong} WHERE nid = :nid AND loai_doi_tuong = :type", array(':nid' => (int) $id, ':type' => 'nhan_vien'))->fetch();
  if (!$hd) return NULL;
  $row = array(
    'nid' => (int) $hd->nid,
    'so_hop_dong' => $hd->so_hop_dong,
    'ngay_hop_dong' => !empty($hd->ngay_hop_dong) ? $hd->ngay_hop_dong : '',
    'han_hop_dong' => !empty($hd->han_hop_dong) ? $hd->han_hop_dong : '',
    'nhan_vien' => _hop_dong_load_nhan_vien($hd->nhan_vien),
    'ghi_chu' => !empty($hd->ghi_chu) ? $hd->ghi_chu : '',
    'hoat_dong' => (int) $hd->hoat_dong,
  );
  if ($with_files) $row['files'] = _hop_dong_decode_files($hd);
  return $row;
}

function _hop_dong_nhan_vien_check_unique_so($value, $exclude_nid = NULL) {
  $query = db_select('hop_dong', 'hd')->fields('hd', array('nid'))
    ->condition('so_hop_dong', trim($value))->condition('loai_doi_tuong', 'nhan_vien')->condition('hoat_dong', 1);
  if ($exclude_nid !== NULL) $query->condition('nid', (int) $exclude_nid, '<>');
  if ($query->range(0, 1)->execute()->fetchField()) return _hop_dong_fail('Số hợp đồng "' . trim($value) . '" đã tồn tại');
  return NULL;
}

function hop_dong_nhan_vien_rest_collection() {
  if ($_SERVER['REQUEST_METHOD'] === 'GET') return _hop_dong_nhan_vien_rest_list();
  if ($_SERVER['REQUEST_METHOD'] === 'POST') return _hop_dong_nhan_vien_rest_create();
  return _hop_dong_method_not_allowed('GET, POST');
}

function _hop_dong_nhan_vien_rest_list() {
  if (!user_access('hop_dong_view')) return _hop_dong_unauthorized('Bạn không có quyền xem hợp đồng');
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $query = db_select('hop_dong', 'hd')->fields('hd')->condition('hd.hoat_dong', 1)->condition('hd.loai_doi_tuong', 'nhan_vien');
  if (!empty($_GET['nhan_vien'])) $query->condition('hd.nhan_vien', (int) $_GET['nhan_vien']);
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()->condition('hd.so_hop_dong', $like, 'LIKE');
    $uids = db_select('users', 'u')->fields('u', array('uid'))->condition('u.status', 1)
      ->condition(db_or()->condition('u.ten', $like, 'LIKE')->condition('u.name', $like, 'LIKE')->condition('u.ma_nhan_vien', $like, 'LIKE'))
      ->execute()->fetchCol();
    if ($uids) $or->condition('hd.nhan_vien', $uids, 'IN');
    $query->condition($or);
  }
  $total = (clone $query)->countQuery()->execute()->fetchField();
  $query->orderBy('hd.nid', 'DESC')->range(($page - 1) * $limit, $limit);
  $items = array();
  foreach ($query->execute() as $row) $items[] = _hop_dong_nhan_vien_load_row($row->nid);
  $pages = (int) ceil($total / $limit);
  return _hop_dong_success(array('items' => $items, 'total' => (int) $total, 'current_page' => $pages ? $page : 0, 'total_pages' => $pages, 'limit' => $limit));
}

function _hop_dong_nhan_vien_rest_create() {
  if (!user_access('hop_dong_create')) return _hop_dong_unauthorized('Bạn không có quyền tạo hợp đồng');
  $input = _hop_dong_input();
  if (empty($input['so_hop_dong'])) return _hop_dong_fail('Số hợp đồng bắt buộc');
  if (empty($input['nhan_vien'])) return _hop_dong_fail('Vui lòng chọn nhân viên');
  if ($error = _hop_dong_validate_nhan_vien($input['nhan_vien'])) return $error;
  if ($error = _hop_dong_nhan_vien_check_unique_so($input['so_hop_dong'])) return $error;
  try {
    $id = db_insert('hop_dong')->fields(array(
      'so_hop_dong' => trim($input['so_hop_dong']), 'nhan_vien' => (int) $input['nhan_vien'], 'loai_doi_tuong' => 'nhan_vien',
      'ngay_hop_dong' => !empty($input['ngay_hop_dong']) ? $input['ngay_hop_dong'] : NULL,
      'han_hop_dong' => !empty($input['han_hop_dong']) ? $input['han_hop_dong'] : NULL,
      'ghi_chu' => !empty($input['ghi_chu']) ? $input['ghi_chu'] : NULL, 'hoat_dong' => 1,
      'created' => date('Y-m-d H:i:s', REQUEST_TIME), 'changed' => date('Y-m-d H:i:s', REQUEST_TIME),
    ))->execute();
    return _hop_dong_success(_hop_dong_nhan_vien_load_row($id));
  } catch (Exception $e) { watchdog('hop_dong', 'Lỗi tạo hợp đồng nhân viên: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR); return _hop_dong_error('Lỗi hệ thống khi tạo hợp đồng'); }
}

function hop_dong_nhan_vien_rest_item($id) {
  $id = (int) $id;
  if (!$id) { drupal_json_output(_hop_dong_fail('ID không hợp lệ')); return; }
  if (arg(3) === 'file') {
    $result = $_SERVER['REQUEST_METHOD'] === 'POST' && !arg(4) ? _hop_dong_nhan_vien_file_upload($id) : ($_SERVER['REQUEST_METHOD'] === 'DELETE' && arg(4) ? _hop_dong_nhan_vien_file_delete($id, arg(4)) : _hop_dong_method_not_allowed('POST, DELETE'));
    drupal_json_output($result); return;
  }
  $result = $_SERVER['REQUEST_METHOD'] === 'GET' ? _hop_dong_nhan_vien_rest_get($id) : ($_SERVER['REQUEST_METHOD'] === 'PUT' ? _hop_dong_nhan_vien_rest_update($id) : ($_SERVER['REQUEST_METHOD'] === 'DELETE' ? _hop_dong_nhan_vien_rest_delete($id) : _hop_dong_method_not_allowed('GET, PUT, DELETE')));
  drupal_json_output($result);
}

function _hop_dong_nhan_vien_exists($id) { return (bool) db_query("SELECT nid FROM {hop_dong} WHERE nid = :id AND hoat_dong = 1 AND loai_doi_tuong = 'nhan_vien'", array(':id' => (int) $id))->fetchField(); }
function _hop_dong_nhan_vien_rest_get($id) { if (!user_access('hop_dong_view')) return _hop_dong_unauthorized('Bạn không có quyền xem hợp đồng'); $row = _hop_dong_nhan_vien_load_row($id, TRUE); return $row ? _hop_dong_success($row) : _hop_dong_not_found('Hợp đồng không tồn tại'); }
function _hop_dong_nhan_vien_rest_update($id) {
  if (!user_access('hop_dong_create')) return _hop_dong_unauthorized('Bạn không có quyền sửa hợp đồng');
  if (!_hop_dong_nhan_vien_exists($id)) return _hop_dong_not_found('Hợp đồng không tồn tại');
  $input = _hop_dong_input(); if (empty($input['so_hop_dong'])) return _hop_dong_fail('Số hợp đồng bắt buộc');
  if ($error = _hop_dong_nhan_vien_check_unique_so($input['so_hop_dong'], $id)) return $error;
  $fields = array('so_hop_dong' => trim($input['so_hop_dong']), 'changed' => date('Y-m-d H:i:s', REQUEST_TIME));
  foreach (array('ngay_hop_dong', 'han_hop_dong', 'ghi_chu') as $field) if (array_key_exists($field, $input)) $fields[$field] = !empty($input[$field]) ? $input[$field] : NULL;
  if (array_key_exists('nhan_vien', $input)) { if ($error = _hop_dong_validate_nhan_vien($input['nhan_vien'])) return $error; $fields['nhan_vien'] = (int) $input['nhan_vien']; }
  db_update('hop_dong')->fields($fields)->condition('nid', $id)->execute(); return _hop_dong_success(_hop_dong_nhan_vien_load_row($id, TRUE));
}
function _hop_dong_nhan_vien_rest_delete($id) { if (!user_access('hop_dong_delete')) return _hop_dong_unauthorized('Bạn không có quyền xoá hợp đồng'); if (!_hop_dong_nhan_vien_exists($id)) return _hop_dong_not_found('Hợp đồng không tồn tại'); db_update('hop_dong')->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))->condition('nid', $id)->execute(); return _hop_dong_success(array('nid' => (int) $id, 'deleted' => TRUE)); }
function _hop_dong_nhan_vien_file_upload($id) { if (!user_access('hop_dong_create')) return _hop_dong_unauthorized('Bạn không có quyền tải file lên'); if (!_hop_dong_nhan_vien_exists($id)) return _hop_dong_not_found('Hợp đồng không tồn tại'); $result = _hop_dong_save_file($id); return isset($result['status']) && $result['status'] !== 'success' ? $result : _hop_dong_success($result); }
function _hop_dong_nhan_vien_file_delete($id, $file_id) { if (!user_access('hop_dong_create')) return _hop_dong_unauthorized('Bạn không có quyền xoá file'); if (!_hop_dong_nhan_vien_exists($id)) return _hop_dong_not_found('Hợp đồng không tồn tại'); $result = _hop_dong_delete_file($id, $file_id); return $result === TRUE ? _hop_dong_success(array('deleted' => TRUE)) : $result; }

/*******************************************************************************
 * UI PAGE CALLBACKS
 ******************************************************************************/

function hop_dong_page_list() {
  return _hop_dong_page_list(FALSE);
}

function hop_dong_nhan_vien_page_list() {
  return _hop_dong_page_list(TRUE);
}

function _hop_dong_page_list($is_employee) {
  drupal_add_css(drupal_get_path('module', 'hop_dong') . '/assets/css/hop_dong.css');
  drupal_add_js(drupal_get_path('module', 'hop_dong') . '/assets/js/hop_dong.js');

  drupal_add_js(array('hop_dong' => array(
    'permissions' => array(
      'hop_dong_view' => user_access('hop_dong_view'),
      'hop_dong_create' => user_access('hop_dong_create'),
      'hop_dong_delete' => user_access('hop_dong_delete'),
    ),
    'is_employee_contract' => (bool) $is_employee,
    'api_base' => $is_employee ? '/api/hop-dong-nhan-vien' : '/api/hop-dong',
  )), 'setting');

  return theme('hop_dong_list_page', array('is_employee_contract' => (bool) $is_employee));
}
