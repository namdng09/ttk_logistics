<?php

/**
 * @file
 * OPS API - API đăng nhập cho app OPS Mobile sử dụng trực tiếp user Drupal 7.
 *
 * Điều kiện đăng nhập OPS:
 * - Tài khoản Drupal user đang hoạt động.
 * - Đúng username/email và mật khẩu.
 * - User bắt buộc có role OPS với rid = 15.
 */

define('OPS_API_ROLE_OPS_RID', 15);

