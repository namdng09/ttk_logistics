/**
 * Callback cố định cho route ghép cont - seal.
 *
 * Tách callback khỏi hàm xử lý để bảo đảm Drupal luôn tìm thấy tên callback.
 */
function ops_api_assign_container_seal_pairs() {
  // Giữ callback cũ để các bản ghi cache_menu chưa rebuild vẫn hoạt động.
  module_load_include('inc', 'ops_api', 'includes/ops_api.assign_container_seal_pairs');

  if (function_exists('ops_api_assign_container_seal_pairs_page')) {
    return ops_api_assign_container_seal_pairs_page();
  }

  // Fallback cuối cùng khi file include chưa được nạp do cache cũ.
  return ops_api_assign_container_seal_pairs_process();
}

/**
 * API đăng nhập.
 *
 * POST /ops-api/login
 * Content-Type: application/json
 *
 * Body khuyến nghị:
 * {
 *   "username": "ops_username",
 *   "password": "123456",
 *   "rememberLogin": true
 * }
 *
 * Vẫn hỗ trợ email/login để tương thích bản cũ:
 * {
 *   "email": "ops@example.com",
 *   "password": "123456"
 * }
 */
function ops_api_login() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng POST.', 405);
  }

  $data = ops_api_get_request_data();

  $username = !empty($data['username']) ? trim($data['username']) : '';
  $email = !empty($data['email']) ? trim($data['email']) : '';
  $login = !empty($data['login']) ? trim($data['login']) : '';
  $password = !empty($data['password']) ? (string) $data['password'] : '';

  // Ưu tiên username theo yêu cầu mới, sau đó fallback email/login để không vỡ app cũ.
  $login_name = $username ? $username : ($email ? $email : $login);

  if ($login_name == '' || $password == '') {
    ops_api_error('Vui lòng nhập tên đăng nhập và mật khẩu.', 400);
  }

  $account = ops_api_load_user_by_login($login_name);

  if (!$account) {
    ops_api_error('Tài khoản hoặc mật khẩu không chính xác.', 401);
  }

  if (empty($account->status)) {
    ops_api_error('Tài khoản đã bị khóa.', 403);
  }

  // Chỉ cho phép user có vai trò OPS rid = 15 đăng nhập app.
  if (!ops_api_account_has_ops_role($account)) {
    watchdog(
      'ops_api',
      'User @name bị từ chối đăng nhập OPS vì không có role rid @rid.',
      array('@name' => $account->name, '@rid' => OPS_API_ROLE_OPS_RID),
      WATCHDOG_WARNING
    );
    ops_api_error('Tài khoản không có quyền truy cập ứng dụng OPS.', 403);
  }

  // Drupal 7 user_authenticate đăng nhập bằng username, không đăng nhập trực tiếp bằng email.
  $uid = user_authenticate($account->name, $password);

  if (!$uid) {
    ops_api_error('Tài khoản hoặc mật khẩu không chính xác.', 401);
  }

  global $user;
  $user = user_load($uid, TRUE);

  if (!$user || empty($user->uid) || empty($user->status)) {
    ops_api_error('Không thể khởi tạo phiên đăng nhập.', 500);
  }

  // Kiểm tra lại role sau khi authenticate để đảm bảo dữ liệu user mới nhất.
  if (!ops_api_account_has_ops_role($user)) {
    ops_api_error('Tài khoản không có quyền truy cập ứng dụng OPS.', 403);
  }

  // Tạo phiên đăng nhập chuẩn Drupal.
  user_login_finalize();

  $session_id = session_id();
  $session_name = session_name();

  $response = array(
    'success' => TRUE,
    'message' => 'Đăng nhập thành công.',

    // Các field này khớp với model UserSession bên Flutter.
    'email' => $user->mail,
    'fullName' => ops_api_get_user_full_name($user),
    'department' => ops_api_get_user_department($user),
    'token' => $session_id,

    // Thông tin bổ sung.
    'uid' => (int) $user->uid,
    'username' => $user->name,
    'sessionName' => $session_name,
    'tokenType' => 'Bearer',
    'opsRoleRid' => OPS_API_ROLE_OPS_RID,
    'roles' => array_values($user->roles),
  );

  watchdog('ops_api', 'User @name đăng nhập OPS mobile.', array('@name' => $user->name), WATCHDOG_NOTICE);

  ops_api_response($response, 200);
}

/**
 * API lấy thông tin tài khoản hiện tại theo Bearer token.
 *
 * GET /ops-api/me
 * Authorization: Bearer TOKEN
 */
function ops_api_me() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  $account = ops_api_get_account_from_token();

  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_response(array(
    'success' => TRUE,
    'uid' => (int) $account->uid,
    'username' => $account->name,
    'email' => $account->mail,
    'fullName' => ops_api_get_user_full_name($account),
    'department' => ops_api_get_user_department($account),
    'tokenType' => 'Bearer',
    'opsRoleRid' => OPS_API_ROLE_OPS_RID,
    'roles' => array_values($account->roles),
  ), 200);
}

/**
 * API đăng xuất. Xóa Drupal session tương ứng với token.
 *
 * POST /ops-api/logout
 * Authorization: Bearer TOKEN
 */
function ops_api_logout() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  $token = ops_api_get_bearer_token();

  if ($token) {
    $or = db_or()
      ->condition('sid', $token)
      ->condition('ssid', $token);

    db_delete('sessions')
      ->condition($or)
      ->execute();
  }

  ops_api_response(array(
    'success' => TRUE,
    'message' => 'Đăng xuất thành công.',
  ), 200);
}

/**
 * API yêu cầu đặt lại mật khẩu theo username/email.
 *
 * POST /ops-api/request-password-reset
 * Content-Type: application/json
 *
 * Body:
 * {
 *   "username": "ops_username"
 * }
 */
function ops_api_request_password_reset() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng POST.', 405);
  }

  $data = ops_api_get_request_data();
  $username = !empty($data['username']) ? trim($data['username']) : '';
  $email = !empty($data['email']) ? trim($data['email']) : '';
  $login = !empty($data['login']) ? trim($data['login']) : '';
  $login_name = $username ? $username : ($email ? $email : $login);

  if ($login_name == '') {
    ops_api_error('Vui lòng nhập tên đăng nhập hoặc email.', 400);
  }

  $account = ops_api_load_user_by_login($login_name);

  // Không tiết lộ tài khoản có tồn tại hay không.
  // Chỉ gửi mail reset nếu tài khoản đang hoạt động và thuộc OPS rid = 15.
  if ($account && !empty($account->status) && ops_api_account_has_ops_role($account)) {
    if (function_exists('_user_mail_notify')) {
      _user_mail_notify('password_reset', $account);
    }
  }

  ops_api_response(array(
    'success' => TRUE,
    'message' => 'Nếu tài khoản tồn tại và có quyền OPS, hướng dẫn đặt lại mật khẩu sẽ được gửi tới email tương ứng.',
  ), 200);
}

/**
 * Load user bằng username hoặc email.
 */
function ops_api_load_user_by_login($login_name) {
  $login_name = trim($login_name);

  if ($login_name == '') {
    return FALSE;
  }

  if (valid_email_address($login_name)) {
    $uid = db_select('users', 'u')
      ->fields('u', array('uid'))
      ->condition('mail', $login_name)
      ->range(0, 1)
      ->execute()
      ->fetchField();

    return $uid ? user_load($uid, TRUE) : FALSE;
  }

  $uid = db_select('users', 'u')
    ->fields('u', array('uid'))
    ->condition('name', $login_name)
    ->range(0, 1)
    ->execute()
    ->fetchField();

  return $uid ? user_load($uid, TRUE) : FALSE;
}

/**
 * Kiểm tra user có role OPS rid = 15 hay không.
 */
function ops_api_account_has_ops_role($account) {
  if (!$account || empty($account->uid)) {
    return FALSE;
  }

  // user_load() trong Drupal 7 trả roles dạng rid => role name.
  if (!empty($account->roles) && is_array($account->roles) && isset($account->roles[OPS_API_ROLE_OPS_RID])) {
    return TRUE;
  }

  // Fallback kiểm tra trực tiếp bảng users_roles.
  $has_role = db_select('users_roles', 'ur')
    ->fields('ur', array('uid'))
    ->condition('uid', $account->uid)
    ->condition('rid', OPS_API_ROLE_OPS_RID)
    ->range(0, 1)
    ->execute()
    ->fetchField();

  return !empty($has_role);
}

/**
 * Lấy user từ Bearer token. Token ở đây là Drupal session id.
 */
function ops_api_get_account_from_token() {
  $token = ops_api_get_bearer_token();

  if (!$token) {
    return FALSE;
  }

  $or = db_or()
    ->condition('sid', $token)
    ->condition('ssid', $token);

  $record = db_select('sessions', 's')
    ->fields('s', array('uid', 'timestamp'))
    ->condition($or)
    ->condition('uid', 0, '>')
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  if (!$record || empty($record->uid)) {
    return FALSE;
  }

  // Tôn trọng lifetime phiên đăng nhập của Drupal nếu site có cấu hình gc_maxlifetime.
  $session_lifetime = (int) ini_get('session.gc_maxlifetime');
  if ($session_lifetime > 0 && !empty($record->timestamp) && $record->timestamp + $session_lifetime < REQUEST_TIME) {
    return FALSE;
  }

  $account = user_load($record->uid, TRUE);

  if (!$account || empty($account->status)) {
    return FALSE;
  }

  // Nếu user bị gỡ role OPS sau khi đã đăng nhập thì token không còn hợp lệ cho app OPS.
  if (!ops_api_account_has_ops_role($account)) {
    return FALSE;
  }

  // Cập nhật timestamp để phiên đang dùng không bị coi là không hoạt động.
  db_update('sessions')
    ->fields(array('timestamp' => REQUEST_TIME))
    ->condition($or)
    ->execute();

  return $account;
}

/**
 * Lấy Bearer token từ Authorization header.
 */
function ops_api_get_bearer_token() {
  $header = '';

  if (!empty($_SERVER['HTTP_AUTHORIZATION'])) {
    $header = $_SERVER['HTTP_AUTHORIZATION'];
  }
  elseif (!empty($_SERVER['REDIRECT_HTTP_AUTHORIZATION'])) {
    $header = $_SERVER['REDIRECT_HTTP_AUTHORIZATION'];
  }
  elseif (function_exists('apache_request_headers')) {
    $headers = apache_request_headers();

    if (!empty($headers['Authorization'])) {
      $header = $headers['Authorization'];
    }
    elseif (!empty($headers['authorization'])) {
      $header = $headers['authorization'];
    }
  }

  if (preg_match('/Bearer\s+(.*)$/i', $header, $matches)) {
    return trim($matches[1]);
  }

  return '';
}

/**
 * Đọc dữ liệu request JSON hoặc form-data.
 */
function ops_api_get_request_data() {
  $raw = file_get_contents('php://input');
  $data = array();

  if ($raw) {
    $json = drupal_json_decode($raw);

    if (is_array($json)) {
      $data = $json;
    }
  }

  if (empty($data) && !empty($_POST)) {
    $data = $_POST;
  }

  return $data;
}

/**
 * Lấy họ tên user từ field user Drupal.
 */
function ops_api_get_user_full_name($account) {
  $value = ops_api_get_user_field_value($account, array(
    'field_ho_ten',
    'field_hoten',
    'field_full_name',
  ));

  return $value ? $value : $account->name;
}

/**
 * Lấy phòng ban/bộ phận user từ field user Drupal.
 */
function ops_api_get_user_department($account) {
  $value = ops_api_get_user_field_value($account, array(
    'field_bo_phan',
    'field_phong_ban',
    'field_department',
  ));

  return $value ? $value : '';
}

/**
 * Đọc field user linh hoạt: text, taxonomy term reference, node reference.
 */
function ops_api_get_user_field_value($account, $field_names = array()) {
  foreach ($field_names as $field_name) {
    if (empty($account->{$field_name})) {
      continue;
    }

    $items = field_get_items('user', $account, $field_name);

    if (empty($items[0])) {
      continue;
    }

    $item = $items[0];

    if (isset($item['value']) && trim($item['value']) !== '') {
      return trim($item['value']);
    }

    if (isset($item['safe_value']) && trim($item['safe_value']) !== '') {
      return trim($item['safe_value']);
    }

    if (!empty($item['tid'])) {
      $term = taxonomy_term_load($item['tid']);
      if ($term) {
        return $term->name;
      }
    }

    if (!empty($item['target_id'])) {
      $node = node_load($item['target_id']);
      if ($node) {
        return $node->title;
      }
    }
  }

  return '';
}

/**
 * API danh sách booking còn cần nhập vỏ.
 *
 * GET /ops-api/container-bookings
 * Authorization: Bearer TOKEN
 *
 * Chỉ lấy node don_hang có trạng thái Đang thực hiện, tong_so_cont > 0 và chưa chọn hết cont.
 */
function ops_api_container_bookings() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'GET') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng GET.', 405);
  }

  $account = ops_api_get_account_from_token();
  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_assert_chua_chon_het_field_available();

  $query = db_select('node', 'n');
  $query->leftJoin(
    'field_data_field_khach_hang',
    'fkh',
    "fkh.entity_type = 'node' AND fkh.entity_id = n.nid AND fkh.bundle = 'don_hang' AND fkh.deleted = 0 AND fkh.delta = 0"
  );
  $query->leftJoin('node', 'kh', 'kh.nid = fkh.field_khach_hang_target_id');
  $query->innerJoin(
    'field_data_field_noi_dung_json',
    'fj',
    "fj.entity_type = 'node' AND fj.entity_id = n.nid AND fj.bundle = 'don_hang' AND fj.deleted = 0 AND fj.delta = 0"
  );
  $query->innerJoin(
    'field_data_field_chua_chon_het',
    'fcch',
    "fcch.entity_type = 'node' AND fcch.entity_id = n.nid AND fcch.bundle = 'don_hang' AND fcch.deleted = 0 AND fcch.delta = 0"
  );
  $query->fields('n', array('nid', 'title', 'created', 'changed', 'status'));
  $query->addField('fkh', 'field_khach_hang_target_id', 'khach_hang_nid');
  $query->addField('kh', 'title', 'khach_hang_title');
  $query->addField('fj', 'field_noi_dung_json_value', 'noi_dung_json');
  $query->addField('fcch', 'field_chua_chon_het_value', 'chua_chon_het');
  $query->condition('n.type', 'don_hang');
  $query->condition('fcch.field_chua_chon_het_value', 1);
  $query->orderBy('n.created', 'DESC');

  $bookings = array();

  foreach ($query->execute() as $record) {
    $data = ops_api_decode_order_json($record->noi_dung_json);

    if (empty($data) || empty($data['so_booking'])) {
      continue;
    }

    // Chọn vỏ chỉ áp dụng cho đơn hàng xuất khẩu.
    if (!ops_api_is_export_order($data)) {
      continue;
    }

    $order_status = isset($data['trang_thai_don_hang']) ? trim((string) $data['trang_thai_don_hang']) : '';
    if ($order_status !== 'Đang thực hiện') {
      continue;
    }

    $tong_so_cont = ops_api_count_total_containers($data);
    if ($tong_so_cont <= 0) {
      continue;
    }

    $bookings[] = ops_api_build_booking_response($record, $data);
  }

  ops_api_response(array(
    'success' => TRUE,
    'bookings' => $bookings,
  ), 200);
}

/**
 * API danh sách booking đã chọn đủ vỏ cont.
 *
 * GET /ops-api/completed-container-bookings
 * Authorization: Bearer TOKEN
 *
 * Chỉ lấy node don_hang có trạng thái Đang thực hiện, tong_so_cont > 0
 * và field_chua_chon_het = 0.
 */
function ops_api_completed_container_bookings() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'GET') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng GET.', 405);
  }

  $account = ops_api_get_account_from_token();
  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_assert_chua_chon_het_field_available();

  $query = db_select('node', 'n');
  $query->leftJoin(
    'field_data_field_khach_hang',
    'fkh',
    "fkh.entity_type = 'node' AND fkh.entity_id = n.nid AND fkh.bundle = 'don_hang' AND fkh.deleted = 0 AND fkh.delta = 0"
  );
  $query->leftJoin('node', 'kh', 'kh.nid = fkh.field_khach_hang_target_id');
  $query->innerJoin(
    'field_data_field_noi_dung_json',
    'fj',
    "fj.entity_type = 'node' AND fj.entity_id = n.nid AND fj.bundle = 'don_hang' AND fj.deleted = 0 AND fj.delta = 0"
  );
  $query->innerJoin(
    'field_data_field_chua_chon_het',
    'fcch',
    "fcch.entity_type = 'node' AND fcch.entity_id = n.nid AND fcch.bundle = 'don_hang' AND fcch.deleted = 0 AND fcch.delta = 0"
  );
  $query->fields('n', array('nid', 'title', 'created', 'changed', 'status'));
  $query->addField('fkh', 'field_khach_hang_target_id', 'khach_hang_nid');
  $query->addField('kh', 'title', 'khach_hang_title');
  $query->addField('fj', 'field_noi_dung_json_value', 'noi_dung_json');
  $query->addField('fcch', 'field_chua_chon_het_value', 'chua_chon_het');
  $query->condition('n.type', 'don_hang');
  $query->condition('fcch.field_chua_chon_het_value', 0);
  $query->orderBy('n.created', 'DESC');

  $bookings = array();

  foreach ($query->execute() as $record) {
    $data = ops_api_decode_order_json($record->noi_dung_json);

    if (empty($data) || empty($data['so_booking'])) {
      continue;
    }

    // Chọn vỏ chỉ áp dụng cho đơn hàng xuất khẩu.
    if (!ops_api_is_export_order($data)) {
      continue;
    }

    $order_status = isset($data['trang_thai_don_hang']) ? trim((string) $data['trang_thai_don_hang']) : '';
    if ($order_status !== 'Đang thực hiện') {
      continue;
    }

    $tong_so_cont = ops_api_count_total_containers($data);
    if ($tong_so_cont <= 0) {
      continue;
    }

    $bookings[] = ops_api_build_booking_response($record, $data);
  }

  ops_api_response(array(
    'success' => TRUE,
    'bookings' => $bookings,
  ), 200);
}

/**
 * API nhập vỏ bằng hình ảnh.
 *
 * POST /ops-api/import-container-image
 * Authorization: Bearer TOKEN
 *
 * Body:
 * {
 *   "nid": 123,
 *   "bookingNo": "BW772183",
 *   "imageName": "file1.jpg",
 *   "so_cont": "TEMU1234567",
 *   "so_seal": "SL123456"
 * }
 *
 * so_cont/so_seal có thể bỏ trống nếu app chưa OCR thật, API sẽ sinh mã tạm.
 */
function ops_api_import_container_image() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng POST.', 405);
  }

  $account = ops_api_get_account_from_token();
  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_assert_chua_chon_het_field_available();

  $request = ops_api_get_request_data();
  $nid = !empty($request['nid']) ? (int) $request['nid'] : 0;
  $booking_no = !empty($request['bookingNo']) ? trim($request['bookingNo']) : '';
  if ($booking_no == '' && !empty($request['booking_no'])) {
    $booking_no = trim($request['booking_no']);
  }

  $node = ops_api_load_order_node_for_import($nid, $booking_no);
  if (!$node) {
    ops_api_error('Không tìm thấy đơn hàng/booking cần nhập vỏ.', 404);
  }

  $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
  $data = ops_api_decode_order_json($json_value);
  if (empty($data)) {
    ops_api_error('Dữ liệu field_noi_dung_json của đơn hàng không hợp lệ.', 400);
  }

  if (!ops_api_order_has_incomplete_containers($node)) {
    ops_api_error('Booking này đã chọn đủ số lượng cont.', 400);
  }

  $slot = ops_api_find_next_container_slot($data);
  if (!$slot) {
    $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
    $data['tong_so_cont'] = ops_api_count_total_containers($data);
    ops_api_remove_legacy_container_status_keys($data);
    ops_api_sync_order_incomplete_field($node, $data);
    ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
    node_save($node);
    ops_api_error('Booking này không còn cont nào cần nhập vỏ.', 400);
  }

  $type_index = $slot['type_index'];
  $cont_index = $slot['cont_index'];
  $container_type = !empty($data['loai_xe'][$type_index]['ma']) ? $data['loai_xe'][$type_index]['ma'] : '';
  $order_no = ops_api_container_order_number($data, $type_index, $cont_index);

  $so_cont = !empty($request['so_cont']) ? trim($request['so_cont']) : '';
  $so_seal = !empty($request['so_seal']) ? trim($request['so_seal']) : '';
  $image_name = !empty($request['imageName']) ? trim($request['imageName']) : '';
  if ($image_name == '' && !empty($request['image_name'])) {
    $image_name = trim($request['image_name']);
  }

  if ($so_cont == '') {
    $so_cont = ops_api_generate_container_no($node->nid, $order_no);
  }
  if ($so_seal == '') {
    $so_seal = 'SL' . str_pad((string) (($node->nid * 97 + $order_no * 131) % 1000000), 6, '0', STR_PAD_LEFT);
  }
  if ($image_name == '') {
    $image_name = 'vo-cont-' . $node->nid . '-' . REQUEST_TIME . '.jpg';
  }

  $so_cont = ops_api_normalize_container_number($so_cont);
  $so_seal = ops_api_normalize_seal_number($so_seal);
  $existing_duplicates = ops_api_find_containers_in_pending_orders(array($so_cont));
  if (!empty($existing_duplicates)) {
    $duplicate = reset($existing_duplicates);
    $duplicate_booking = !empty($duplicate['so_booking']) ? ' tại booking ' . $duplicate['so_booking'] : '';
    ops_api_error('Số cont ' . $so_cont . ' đã tồn tại trong đơn hàng có field_chua_chon_het = 1' . $duplicate_booking . '.', 400);
  }

  if (empty($data['hinh_anh_conts']) || !is_array($data['hinh_anh_conts'])) {
    $data['hinh_anh_conts'] = array();
  }
  $data['hinh_anh_conts'][] = $image_name;

  $full_name = ops_api_get_user_full_name($account);
  $now_text = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');

  $data['loai_xe'][$type_index]['conts'][$cont_index]['so_cont'] = $so_cont;
  $data['loai_xe'][$type_index]['conts'][$cont_index]['so_seal'] = $so_seal;
  $data['loai_xe'][$type_index]['conts'][$cont_index]['ngay_chon_vo'] = $now_text;
  $data['loai_xe'][$type_index]['conts'][$cont_index]['nguoi_chon_vo'] = (int) $account->uid;
  $data['loai_xe'][$type_index]['conts'][$cont_index]['nguoi_chon_vo_text'] = $full_name;
  $data['loai_xe'][$type_index]['conts'][$cont_index]['hinh_anh_chon_vo'] = $image_name;

  $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
  $data['tong_so_cont'] = ops_api_count_total_containers($data);
  ops_api_remove_legacy_container_status_keys($data);
  ops_api_sync_order_incomplete_field($node, $data);

  if (empty($data['lich_su_nhap_vo']) || !is_array($data['lich_su_nhap_vo'])) {
    $data['lich_su_nhap_vo'] = array();
  }
  $data['lich_su_nhap_vo'][] = array(
    'thoi_gian' => $now_text,
    'uid' => (int) $account->uid,
    'nguoi_thuc_hien' => $full_name,
    'so_booking' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
    'so_cont' => $so_cont,
    'so_seal' => $so_seal,
    'loai_cont' => $container_type,
    'hinh_anh' => $image_name,
  );

  ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
  node_save($node);

  $container = array(
    'bookingNo' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
    'containerOrder' => $order_no,
    'containerNo' => $so_cont,
    'sealNo' => $so_seal,
    'containerType' => $container_type,
    'depositAmount' => 0,
    'isDeposited' => FALSE,
    'selectedBy' => $full_name,
    'depositedBy' => '',
  );

  watchdog(
    'ops_api',
    'User @user nhập vỏ @cont cho booking @booking.',
    array('@user' => $account->name, '@cont' => $so_cont, '@booking' => $container['bookingNo']),
    WATCHDOG_NOTICE
  );

  ops_api_response(array(
    'success' => TRUE,
    'message' => 'Đã nhập vỏ cho booking.',
    'container' => $container,
    'booking' => ops_api_build_booking_response(ops_api_build_order_record_from_node($node), $data),
  ), 200);
}


/**
 * Ghép và phân bổ danh sách số cont - số seal theo từng cặp vào đơn hàng.
 *
 * POST /ops-api/assign-container-seal-pairs
 * Authorization: Bearer TOKEN
 * Content-Type: application/json
 *
 * Body:
 * {
 *   "nid": 123,
 *   "bookingNo": "BW772183",
 *   "so_cont_json": ["TEMU1234567", "TLLU7654321"],
 *   "so_seal_json": ["SL001", "SL002"],
 *   "image_names": ["anh-1.jpg", "anh-2.jpg"]
 * }
 */
function ops_api_assign_container_seal_pairs_process() {
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng POST.', 405);
  }

  $account = ops_api_get_account_from_token();
  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_assert_chua_chon_het_field_available();

  $request = ops_api_get_request_data();
  $ai_scan_success = isset($request['ai_scan_success'])
    ? filter_var($request['ai_scan_success'], FILTER_VALIDATE_BOOLEAN)
    : TRUE;
  $nid = !empty($request['nid']) ? (int) $request['nid'] : 0;
  if ($nid <= 0 && !empty($request['don_hang_nid'])) {
    $nid = (int) $request['don_hang_nid'];
  }
  if ($nid <= 0 && !empty($request['order_nid'])) {
    $nid = (int) $request['order_nid'];
  }

  $booking_no = !empty($request['bookingNo']) ? trim((string) $request['bookingNo']) : '';
  if ($booking_no === '' && !empty($request['booking_no'])) {
    $booking_no = trim((string) $request['booking_no']);
  }

  $container_source = isset($request['so_cont_json']) ? $request['so_cont_json'] : array();
  if (empty($container_source) && isset($request['container_numbers'])) {
    $container_source = $request['container_numbers'];
  }

  $seal_source = isset($request['so_seal_json']) ? $request['so_seal_json'] : array();
  if (empty($seal_source) && isset($request['seal_numbers'])) {
    $seal_source = $request['seal_numbers'];
  }

  $cont_nids_source = isset($request['cont_nids_json']) ? $request['cont_nids_json'] : array();
  if (empty($cont_nids_source) && isset($request['cont_nids'])) {
    $cont_nids_source = $request['cont_nids'];
  }

  $seal_nids_source = isset($request['seal_nids_json']) ? $request['seal_nids_json'] : array();
  if (empty($seal_nids_source) && isset($request['seal_nids'])) {
    $seal_nids_source = $request['seal_nids'];
  }

  $container_types_source = isset($request['loai_cont_json']) ? $request['loai_cont_json'] : array();
  $iso_type_codes_source = isset($request['iso_type_code_json']) ? $request['iso_type_code_json'] : array();

  if (empty($container_source) && !empty($request['pairs']) && is_array($request['pairs'])) {
    $container_source = array();
    $seal_source = array();

    foreach ($request['pairs'] as $pair) {
      if (!is_array($pair)) {
        continue;
      }

      $container_source[] = isset($pair['so_cont'])
        ? $pair['so_cont']
        : (isset($pair['containerNo']) ? $pair['containerNo'] : '');

      if (isset($pair['sealNumbers']) && is_array($pair['sealNumbers'])) {
        foreach ($pair['sealNumbers'] as $seal_number) {
          $seal_source[] = $seal_number;
        }
      }
      else {
        $seal_source[] = isset($pair['so_seal'])
          ? $pair['so_seal']
          : (isset($pair['sealNo']) ? $pair['sealNo'] : '');
      }
    }
  }

  $container_numbers = ops_api_parse_recognized_number_list($container_source, 'cont');
  $seal_numbers = ops_api_parse_recognized_number_list($seal_source, 'seal');
  $cont_nids = ops_api_parse_positive_integer_list($cont_nids_source);
  $seal_nids = ops_api_parse_positive_integer_list($seal_nids_source);
  $container_types = ops_api_parse_text_list($container_types_source);
  $iso_type_codes = ops_api_parse_text_list($iso_type_codes_source);
  $image_names = ops_api_parse_image_name_list(isset($request['image_names']) ? $request['image_names'] : array());

  if (empty($container_numbers)) {
    ops_api_error('AI chưa nhận diện được số cont. Dữ liệu chưa được lưu.', 400);
  }

  $request_duplicates = ops_api_find_duplicate_values($container_numbers, 'cont');
  if (!empty($request_duplicates)) {
    ops_api_error(
      'Danh sách ảnh có số cont bị trùng: ' . implode(', ', $request_duplicates) . '. Dữ liệu chưa được lưu.',
      400
    );
  }

  // Ghép theo thứ tự. Cont dư để trống seal; seal dư được ghép vào cont cuối.
  $pairing_plan = array();
  $container_count = count($container_numbers);
  $seal_count = count($seal_numbers);

  foreach ($container_numbers as $index => $so_cont) {
    $pairing_plan[$index] = array(
      'so_cont' => $so_cont,
      'seal_numbers' => array(),
      'provided_cont_nid' => !empty($cont_nids[$index]) ? (int) $cont_nids[$index] : 0,
      'provided_seal_nids' => array(),
      'loai_cont' => !empty($container_types[$index]) ? trim((string) $container_types[$index]) : '',
      'iso_type_code' => !empty($iso_type_codes[$index]) ? trim((string) $iso_type_codes[$index]) : '',
    );

    if (isset($seal_numbers[$index]) && $seal_numbers[$index] !== '') {
      $pairing_plan[$index]['seal_numbers'][] = $seal_numbers[$index];
      $pairing_plan[$index]['provided_seal_nids'][] = !empty($seal_nids[$index]) ? (int) $seal_nids[$index] : 0;
    }
  }

  if ($seal_count > $container_count && $container_count > 0) {
    $last_container_index = $container_count - 1;
    for ($seal_index = $container_count; $seal_index < $seal_count; $seal_index++) {
      if ($seal_numbers[$seal_index] !== '') {
        $pairing_plan[$last_container_index]['seal_numbers'][] = $seal_numbers[$seal_index];
        $pairing_plan[$last_container_index]['provided_seal_nids'][] = !empty($seal_nids[$seal_index]) ? (int) $seal_nids[$seal_index] : 0;
      }
    }
  }

  $lock_name = 'ops_api_assign_container_seal_pairs';
  if (!lock_acquire($lock_name, 10.0)) {
    ops_api_error('Hệ thống đang xử lý một yêu cầu chọn vỏ khác. Vui lòng thực hiện lại.', 400);
  }

  $transaction = db_transaction();
  $node = NULL;
  $data = array();

  try {
    $node = ops_api_load_order_node_for_import($nid, $booking_no);
    if (!$node) {
      throw new Exception('Không tìm thấy đơn hàng/booking cần phân bổ số cont - số seal.');
    }

    $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
    $data = ops_api_decode_order_json($json_value);
    if (empty($data)) {
      throw new Exception('Dữ liệu field_noi_dung_json của đơn hàng không hợp lệ.');
    }

    // Một số đơn hàng cũ chỉ có loai_xe[].so_luong và tong_so_cont,
    // chưa có loai_xe[].conts. Chuẩn hóa slot trong bộ nhớ trước khi kiểm tra.
    ops_api_prepare_container_slots($data);

    // Số slot luôn được tính theo so_cont_json. Seal chỉ được ghép vào cont,
    // không làm tăng số slot cần sử dụng.
    $existing_container_locations = ops_api_find_container_locations_in_order($data, $container_numbers);
    $new_container_count = 0;
    foreach ($pairing_plan as $plan_index => &$plan_item) {
      $container_key = ops_api_container_compare_key($plan_item['so_cont']);
      if ($container_key !== '' && isset($existing_container_locations[$container_key])) {
        $plan_item['existing_location'] = $existing_container_locations[$container_key];
        $plan_item['is_existing'] = TRUE;
      }
      else {
        $plan_item['existing_location'] = NULL;
        $plan_item['is_existing'] = FALSE;
        $new_container_count++;
      }
    }
    unset($plan_item);

    // Không chỉ dựa vào field_chua_chon_het vì field có thể chưa đồng bộ ở
    // dữ liệu cũ. Trạng thái slot được tính trực tiếp từ JSON sau chuẩn hóa.
    $current_total_count = ops_api_count_total_containers($data);
    $current_selected_count = ops_api_count_selected_containers($data);
    if ($new_container_count > 0 && $current_total_count > 0 && $current_selected_count >= $current_total_count) {
      throw new Exception('Booking này đã đủ số lượng cont cho phép, không thể upload thêm vỏ cont mới.');
    }

    $empty_slots = ops_api_get_empty_container_slots($data);
    if ($new_container_count > count($empty_slots)) {
      throw new Exception(
        'Booking chỉ còn ' . count($empty_slots) . ' vị trí cont chưa chọn nhưng cần thêm ' . $new_container_count . ' cont mới từ so_cont_json. Dữ liệu chưa được lưu.'
      );
    }

    // Chỉ kiểm tra trùng ở các đơn hàng khác; cont đã có trong chính booking hiện tại
    // được coi là yêu cầu cập nhật seal/idempotent, không phải dữ liệu trùng lỗi.
    $existing_duplicates = ops_api_find_containers_in_pending_orders($container_numbers, (int) $node->nid);
    if (!empty($existing_duplicates)) {
      $duplicate_messages = array();
      foreach ($existing_duplicates as $duplicate) {
        $label = $duplicate['so_cont'];
        if (!empty($duplicate['so_booking'])) {
          $label .= ' (booking ' . $duplicate['so_booking'] . ')';
        }
        elseif (!empty($duplicate['don_hang_nid'])) {
          $label .= ' (đơn hàng #' . $duplicate['don_hang_nid'] . ')';
        }
        $duplicate_messages[] = $label;
      }

      throw new Exception(
        'Số cont đã tồn tại trong đơn hàng có field_chua_chon_het = 1: ' . implode(', ', $duplicate_messages) . '. Dữ liệu chưa được lưu.'
      );
    }

    // Chỉ bắt đầu ghi sau khi toàn bộ kiểm tra đã hoàn tất.
    $full_name = ops_api_get_user_full_name($account);
    $now_text = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');
    $saved_pairs = array();

    if (empty($data['hinh_anh_conts']) || !is_array($data['hinh_anh_conts'])) {
      $data['hinh_anh_conts'] = array();
    }

    foreach ($image_names as $image_name) {
      if ($image_name !== '' && !in_array($image_name, $data['hinh_anh_conts'])) {
        $data['hinh_anh_conts'][] = $image_name;
      }
    }

    if (empty($data['lich_su_nhap_vo']) || !is_array($data['lich_su_nhap_vo'])) {
      $data['lich_su_nhap_vo'] = array();
    }

    $empty_slot_pointer = 0;
    $reused_container_count = 0;

    foreach ($pairing_plan as $index => $plan) {
      $is_existing = !empty($plan['is_existing']) && !empty($plan['existing_location']);
      if ($is_existing) {
        $slot = $plan['existing_location'];
        $reused_container_count++;
      }
      else {
        $slot = $empty_slots[$empty_slot_pointer];
        $empty_slot_pointer++;
      }

      $type_index = $slot['type_index'];
      $cont_index = $slot['cont_index'];
      $so_cont = $plan['so_cont'];
      $incoming_pair_seals = array_values(array_filter($plan['seal_numbers'], 'strlen'));
      $existing_cont_data = !empty($data['loai_xe'][$type_index]['conts'][$cont_index]) && is_array($data['loai_xe'][$type_index]['conts'][$cont_index])
        ? $data['loai_xe'][$type_index]['conts'][$cont_index]
        : array();
      $existing_seals = ops_api_get_container_seal_numbers($existing_cont_data);
      $pair_seals = ops_api_merge_unique_number_lists($existing_seals, $incoming_pair_seals, 'seal');
      $so_seal = implode(', ', $pair_seals);
      $container_type = !empty($plan['loai_cont'])
        ? trim((string) $plan['loai_cont'])
        : (!empty($data['loai_xe'][$type_index]['ma'])
          ? trim((string) $data['loai_xe'][$type_index]['ma'])
          : '');
      $iso_type_code = !empty($plan['iso_type_code']) ? trim((string) $plan['iso_type_code']) : '';
      $order_no = ops_api_container_order_number($data, $type_index, $cont_index);
      $image_name = !empty($image_names[$index])
        ? $image_names[$index]
        : (!empty($image_names[0]) ? $image_names[0] : '');

      $cont_nid = !empty($existing_cont_data['cont_nid']) ? (int) $existing_cont_data['cont_nid'] : 0;
      if ($cont_nid <= 0 && !empty($plan['provided_cont_nid'])) {
        $cont_nid = ops_api_validate_reusable_cont_seal_node(
          (int) $plan['provided_cont_nid'],
          $so_cont,
          'cont',
          (int) $node->nid
        );
      }
      if ($cont_nid <= 0) {
        $cont_nid = ops_api_create_cont_seal_node(array(
          'number' => $so_cont,
          'kind' => 'cont',
          'don_hang_nid' => (int) $node->nid,
          'booking_no' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
          'image_name' => $image_name,
          'account' => $account,
        ));
      }

      $existing_seal_nids = array();
      if (!empty($existing_cont_data['seal_nids']) && is_array($existing_cont_data['seal_nids'])) {
        foreach ($existing_cont_data['seal_nids'] as $existing_seal_nid) {
          if ((int) $existing_seal_nid > 0) {
            $existing_seal_nids[] = (int) $existing_seal_nid;
          }
        }
      }
      elseif (!empty($existing_cont_data['seal_nid'])) {
        $existing_seal_nids[] = (int) $existing_cont_data['seal_nid'];
      }

      $seal_nids = array_values($existing_seal_nids);
      $existing_seal_keys = array();
      foreach ($existing_seals as $existing_seal_number) {
        $existing_seal_key = ops_api_container_compare_key($existing_seal_number);
        if ($existing_seal_key !== '') {
          $existing_seal_keys[$existing_seal_key] = TRUE;
        }
      }

      foreach ($incoming_pair_seals as $seal_offset => $seal_number) {
        $seal_key = ops_api_container_compare_key($seal_number);
        if ($seal_key !== '' && isset($existing_seal_keys[$seal_key])) {
          continue;
        }

        $seal_image_name = !empty($image_names[$index + $seal_offset])
          ? $image_names[$index + $seal_offset]
          : $image_name;

        $created_seal_nid = 0;
        if (!empty($plan['provided_seal_nids'][$seal_offset])) {
          $created_seal_nid = ops_api_validate_reusable_cont_seal_node(
            (int) $plan['provided_seal_nids'][$seal_offset],
            $seal_number,
            'seal',
            (int) $node->nid
          );
        }

        if ($created_seal_nid <= 0) {
          $created_seal_nid = ops_api_create_cont_seal_node(array(
            'number' => $seal_number,
            'kind' => 'seal',
            'don_hang_nid' => (int) $node->nid,
            'booking_no' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
            'image_name' => $seal_image_name,
            'account' => $account,
          ));
        }

        if ($created_seal_nid > 0) {
          $seal_nids[] = (int) $created_seal_nid;
        }
        if ($seal_key !== '') {
          $existing_seal_keys[$seal_key] = TRUE;
        }
      }

      $seal_nids = array_values(array_unique(array_filter(array_map('intval', $seal_nids))));
      $first_seal_nid = !empty($seal_nids) ? (int) reset($seal_nids) : 0;

      $data['loai_xe'][$type_index]['conts'][$cont_index]['so_cont'] = $so_cont;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['so_seal'] = $so_seal;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['danh_sach_seal'] = $pair_seals;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['loai_cont'] = $container_type;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['iso_type_code'] = $iso_type_code;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['ngay_chon_vo'] = $now_text;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['nguoi_chon_vo'] = (int) $account->uid;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['nguoi_chon_vo_text'] = $full_name;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['hinh_anh_chon_vo'] = $image_name;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['cont_nid'] = (int) $cont_nid;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['seal_nid'] = $first_seal_nid;
      $data['loai_xe'][$type_index]['conts'][$cont_index]['seal_nids'] = $seal_nids;

      $saved_pairs[] = array(
        'containerOrder' => (int) $order_no,
        'containerNo' => $so_cont,
        'sealNo' => $so_seal,
        'sealNumbers' => $pair_seals,
        'so_cont' => $so_cont,
        'so_seal' => $so_seal,
        'containerType' => $container_type,
        'isoTypeCode' => $iso_type_code,
        'iso_type_code' => $iso_type_code,
        'imageName' => $image_name,
        'contNid' => (int) $cont_nid,
        'sealNid' => $first_seal_nid,
        'sealNids' => $seal_nids,
        'loaiXeIndex' => (int) $type_index,
        'contIndex' => (int) $cont_index,
        'reusedExistingContainer' => $is_existing ? TRUE : FALSE,
      );

      $data['lich_su_nhap_vo'][] = array(
        'thoi_gian' => $now_text,
        'uid' => (int) $account->uid,
        'nguoi_thuc_hien' => $full_name,
        'so_booking' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
        'so_cont' => $so_cont,
        'so_seal' => $so_seal,
        'danh_sach_seal' => $pair_seals,
        'loai_cont' => $container_type,
        'iso_type_code' => $iso_type_code,
        'hinh_anh' => $image_name,
        'url' => $image_name !== '' ? array($image_name) : array(),
        'cont_nid' => (int) $cont_nid,
        'seal_nid' => $first_seal_nid,
        'seal_nids' => $seal_nids,
      );
    }

    $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
    $data['tong_so_cont'] = ops_api_count_total_containers($data);
    ops_api_remove_legacy_container_status_keys($data);
    ops_api_sync_order_incomplete_field($node, $data);
    $data['ngay_cap_nhat_chon_vo'] = $now_text;
    $data['uid_cap_nhat_chon_vo'] = (int) $account->uid;

    ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
    node_save($node);

    $missing_seal_count = max(0, $container_count - $seal_count);
    $extra_seal_count = max(0, $seal_count - $container_count);
    $message = 'Đã xử lý ' . $container_count . ' số cont';
    if ($reused_container_count > 0) {
      $message .= ' (' . $reused_container_count . ' cont đã có trong booking được cập nhật seal)';
    }

    if ($seal_count === $container_count) {
      $message .= ' với ' . $seal_count . ' số seal.';
    }
    elseif ($seal_count < $container_count) {
      $message .= ' và ' . $seal_count . ' số seal; có ' . $missing_seal_count . ' cont được để trống seal.';
    }
    else {
      $message .= ' và ghép đủ ' . $seal_count . ' số seal; ' . $extra_seal_count . ' seal dư đã được ghép vào cont cuối.';
    }

    lock_release($lock_name);

    ops_api_response(array(
      'success' => TRUE,
      'message' => $message,
      'pairs' => $saved_pairs,
      'so_cont_json' => array_values($container_numbers),
      'so_seal_json' => array_values($seal_numbers),
      'pairing_summary' => array(
        'container_count' => (int) $container_count,
        'seal_count' => (int) $seal_count,
        'slot_count_source' => 'so_cont_json',
        'new_container_count' => (int) $new_container_count,
        'reused_existing_container_count' => (int) $reused_container_count,
        'missing_seal_count' => (int) $missing_seal_count,
        'extra_seal_count' => (int) $extra_seal_count,
        'strategy' => $seal_count > $container_count
          ? 'extra_seals_attached_to_last_container'
          : 'pair_by_index_keep_missing_seal_blank',
        'available_slot_count_before_save' => (int) count($empty_slots),
        'slot_structure_normalized' => TRUE,
      ),
      'order_update' => array(
        'don_hang_nid' => (int) $node->nid,
        'so_cont_da_chon' => (int) $data['so_cont_da_chon'],
        'tong_so_cont' => (int) $data['tong_so_cont'],
        'field_chua_chon_het' => ops_api_get_order_incomplete_value($node),
        'trang_thai_chon_vo_cont' => ops_api_get_container_selection_status($node),
      ),
      'booking' => ops_api_build_booking_response(ops_api_build_order_record_from_node($node), $data),
    ), 200);
  }
  catch (Exception $e) {
    $transaction->rollback();
    lock_release($lock_name);

    if (function_exists('entity_get_controller')) {
      $controller = entity_get_controller('node');
      if ($controller && method_exists($controller, 'resetCache')) {
        $controller->resetCache();
      }
    }

    // Một số phiên bản API AI vẫn tự ghi cont vào đơn hàng dù app đã gửi
    // only_detect/save_result=0. Nếu bước OPS thất bại, hoàn tác đúng các node
    // mà AI vừa trả về để bảo đảm nguyên tắc: response lỗi => đơn hàng không đổi.
    $ai_prewrite_rollback = array();
    if (!$ai_scan_success && !empty($node->nid) && !empty($cont_nids)) {
      $ai_prewrite_rollback = ops_api_rollback_ai_prewrite_after_failed_assignment(
        (int) $node->nid,
        $container_numbers,
        $cont_nids,
        $seal_nids
      );

      // Dùng dữ liệu sau rollback để response lỗi phản ánh đúng số cont còn
      // lại, tránh app hiển thị giới hạn dựa trên snapshot trước khi hoàn tác.
      if (!empty($ai_prewrite_rollback['rolled_back'])) {
        $fresh_node = node_load((int) $node->nid, NULL, TRUE);
        if ($fresh_node && $fresh_node->type === 'don_hang') {
          $node = $fresh_node;
          $fresh_json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
          $fresh_data = ops_api_decode_order_json($fresh_json_value);
          if (is_array($fresh_data) && !empty($fresh_data)) {
            $data = $fresh_data;
          }
        }
      }
    }

    watchdog(
      'ops_api',
      'Lỗi phân bổ cont - seal cho booking @booking: @message',
      array('@booking' => $booking_no, '@message' => $e->getMessage()),
      WATCHDOG_ERROR
    );

    $error_content = array();
    if (!empty($node) && !empty($data) && is_array($data)) {
      $selected_count = ops_api_count_selected_containers($data);
      $total_count = ops_api_count_total_containers($data);
      $remaining_count = max(0, $total_count - $selected_count);

      $error_content['order_limit'] = array(
        'success' => TRUE,
        'don_hang_nid' => !empty($node->nid) ? (int) $node->nid : 0,
        'so_cont_da_chon' => (int) $selected_count,
        'tong_so_cont' => (int) $total_count,
        'remaining' => (int) $remaining_count,
        'field_chua_chon_het' => ops_api_get_order_incomplete_value($node),
        'trang_thai_chon_vo_cont' => ops_api_get_container_selection_status($node),
      );
    }

    if (!empty($ai_prewrite_rollback)) {
      $error_content['ai_prewrite_rollback'] = $ai_prewrite_rollback;
    }

    ops_api_error($e->getMessage(), 400, $error_content);
  }
}

/**
 * Hoàn tác dữ liệu cont/seal mà API AI cũ đã ghi trước khi OPS API xác nhận.
 *
 * Chỉ xóa slot có cont_nid nằm trong danh sách node AI vừa trả về, vì vậy
 * không ảnh hưởng tới những cont hợp lệ đã tồn tại từ trước trong booking.
 */
function ops_api_rollback_ai_prewrite_after_failed_assignment($don_hang_nid, $container_numbers, $cont_nids, $seal_nids = array()) {
  $result = array(
    'attempted' => TRUE,
    'rolled_back' => FALSE,
    'removed_container_count' => 0,
    'deactivated_node_count' => 0,
  );

  $don_hang_nid = (int) $don_hang_nid;
  $cont_nids = array_values(array_unique(array_filter(array_map('intval', (array) $cont_nids))));
  $seal_nids = array_values(array_unique(array_filter(array_map('intval', (array) $seal_nids))));
  if ($don_hang_nid <= 0 || empty($cont_nids)) {
    return $result;
  }

  $node = node_load($don_hang_nid, NULL, TRUE);
  if (!$node || $node->type !== 'don_hang') {
    return $result;
  }

  $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
  $data = ops_api_decode_order_json($json_value);
  if (empty($data) || empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return $result;
  }

  $wanted_numbers = array();
  foreach ((array) $container_numbers as $number) {
    $key = ops_api_container_compare_key($number);
    if ($key !== '') {
      $wanted_numbers[$key] = TRUE;
    }
  }

  $nodes_to_deactivate = array_merge($cont_nids, $seal_nids);
  $removed = 0;
  foreach ($data['loai_xe'] as $type_index => &$type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }

    foreach ($type['conts'] as $cont_index => &$cont) {
      if (!is_array($cont)) {
        continue;
      }

      $stored_cont_nid = !empty($cont['cont_nid']) ? (int) $cont['cont_nid'] : 0;
      $stored_number_key = !empty($cont['so_cont'])
        ? ops_api_container_compare_key($cont['so_cont'])
        : '';

      // Phải khớp node AI vừa tạo. Số cont là điều kiện bổ sung khi có dữ liệu.
      if ($stored_cont_nid <= 0 || !in_array($stored_cont_nid, $cont_nids, TRUE)) {
        continue;
      }
      if (!empty($wanted_numbers) && ($stored_number_key === '' || !isset($wanted_numbers[$stored_number_key]))) {
        continue;
      }

      if (!empty($cont['seal_nids']) && is_array($cont['seal_nids'])) {
        $nodes_to_deactivate = array_merge($nodes_to_deactivate, $cont['seal_nids']);
      }
      if (!empty($cont['seal_nid'])) {
        $nodes_to_deactivate[] = (int) $cont['seal_nid'];
      }

      foreach (array(
        'so_cont', 'so_seal', 'danh_sach_seal', 'loai_cont', 'iso_type_code',
        'ngay_chon_vo', 'nguoi_chon_vo', 'nguoi_chon_vo_text',
        'hinh_anh_chon_vo', 'cont_nid', 'seal_nid', 'seal_nids',
      ) as $key) {
        unset($cont[$key]);
      }
      $removed++;
    }
    unset($cont);
  }
  unset($type);

  if ($removed <= 0) {
    return $result;
  }

  $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
  $data['tong_so_cont'] = ops_api_count_total_containers($data);
  ops_api_remove_legacy_container_status_keys($data);
  ops_api_sync_order_incomplete_field($node, $data);
  $data['ngay_cap_nhat_chon_vo'] = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');
  $data['rollback_ai_prewrite'] = array(
    'thoi_gian' => $data['ngay_cap_nhat_chon_vo'],
    'so_cont' => array_values((array) $container_numbers),
    'cont_nids' => $cont_nids,
  );

  ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
  if (!ops_api_fast_save_order_container_fields($node)) {
    return $result;
  }

  $deactivated = ops_api_fast_deactivate_cont_seal_nodes($nodes_to_deactivate);
  $result['rolled_back'] = TRUE;
  $result['removed_container_count'] = (int) $removed;
  $result['deactivated_node_count'] = (int) $deactivated;
  return $result;
}

/**
 * API xóa cont đã upload khỏi field_noi_dung_json của đơn hàng.
 *
 * POST /ops-api/delete-uploaded-container
 * Authorization: Bearer TOKEN
 * Content-Type: application/json
 *
 * Body:
 * {
 *   "nid": 123,
 *   "bookingNo": "BW772183",
 *   "containerOrder": 1,
 *   "containerNo": "TEMU9329498",
 *   "cont_nid": 57815
 * }
 */
function ops_api_delete_uploaded_container() {
  $started_at = microtime(TRUE);
  ops_api_send_headers();

  if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    ops_api_response(array('success' => TRUE), 200);
  }

  if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    ops_api_error('Phương thức không hợp lệ. Vui lòng sử dụng POST.', 405);
  }

  $account = ops_api_get_account_from_token();
  if (!$account) {
    ops_api_error('Token không hợp lệ hoặc phiên đăng nhập đã hết hạn.', 401);
  }

  ops_api_assert_chua_chon_het_field_available();

  $request = ops_api_get_request_data();
  $nid = !empty($request['nid']) ? (int) $request['nid'] : 0;
  if ($nid <= 0 && !empty($request['don_hang_nid'])) {
    $nid = (int) $request['don_hang_nid'];
  }
  if ($nid <= 0 && !empty($request['order_nid'])) {
    $nid = (int) $request['order_nid'];
  }

  $booking_no = !empty($request['bookingNo']) ? trim($request['bookingNo']) : '';
  if ($booking_no == '' && !empty($request['booking_no'])) {
    $booking_no = trim($request['booking_no']);
  }

  $container_order = !empty($request['containerOrder']) ? (int) $request['containerOrder'] : 0;
  if ($container_order <= 0 && !empty($request['container_order'])) {
    $container_order = (int) $request['container_order'];
  }

  $container_no = !empty($request['containerNo']) ? trim($request['containerNo']) : '';
  if ($container_no == '' && !empty($request['container_no'])) {
    $container_no = trim($request['container_no']);
  }
  if ($container_no == '' && !empty($request['so_cont'])) {
    $container_no = trim($request['so_cont']);
  }

  $cont_nid = !empty($request['contNid']) ? (int) $request['contNid'] : 0;
  if ($cont_nid <= 0 && !empty($request['cont_nid'])) {
    $cont_nid = (int) $request['cont_nid'];
  }

  $seal_nid = !empty($request['sealNid']) ? (int) $request['sealNid'] : 0;
  if ($seal_nid <= 0 && !empty($request['seal_nid'])) {
    $seal_nid = (int) $request['seal_nid'];
  }

  $loai_xe_index = isset($request['loaiXeIndex']) ? (int) $request['loaiXeIndex'] : NULL;
  if ($loai_xe_index === NULL && isset($request['loai_xe_index'])) {
    $loai_xe_index = (int) $request['loai_xe_index'];
  }
  $cont_index = isset($request['contIndex']) ? (int) $request['contIndex'] : NULL;
  if ($cont_index === NULL && isset($request['cont_index'])) {
    $cont_index = (int) $request['cont_index'];
  }

  $node = ops_api_load_order_node_for_import($nid, $booking_no);
  if (!$node) {
    ops_api_error('Không tìm thấy đơn hàng/booking cần xóa cont.', 404);
  }

  $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
  $data = ops_api_decode_order_json($json_value);
  if (empty($data)) {
    ops_api_error('Dữ liệu field_noi_dung_json của đơn hàng không hợp lệ.', 400);
  }

  $slot = ops_api_find_uploaded_container_slot($data, array(
    'container_order' => $container_order,
    'container_no' => $container_no,
    'cont_nid' => $cont_nid,
    'loai_xe_index' => $loai_xe_index,
    'cont_index' => $cont_index,
  ));

  if (!$slot) {
    ops_api_error('Không tìm thấy cont cần xóa trong booking.', 404);
  }

  $type_index = $slot['type_index'];
  $slot_cont_index = $slot['cont_index'];
  $cont = $data['loai_xe'][$type_index]['conts'][$slot_cont_index];

  if (!empty($cont['nguoi_cuoc_vo']) || !empty($cont['ngay_cuoc_vo'])) {
    ops_api_error('Cont này đã cược vỏ, không thể xóa khỏi booking.', 400);
  }

  $stored_seal_nids = array();
  if (!empty($cont['seal_nids']) && is_array($cont['seal_nids'])) {
    foreach ($cont['seal_nids'] as $stored_seal_nid) {
      $stored_seal_nid = (int) $stored_seal_nid;
      if ($stored_seal_nid > 0) {
        $stored_seal_nids[] = $stored_seal_nid;
      }
    }
  }

  $first_stored_seal_nid = !empty($cont['seal_nid']) ? (int) $cont['seal_nid'] : $seal_nid;
  if ($first_stored_seal_nid > 0 && !in_array($first_stored_seal_nid, $stored_seal_nids)) {
    $stored_seal_nids[] = $first_stored_seal_nid;
  }

  $deleted = array(
    'so_cont' => !empty($cont['so_cont']) ? $cont['so_cont'] : '',
    'so_seal' => !empty($cont['so_seal']) ? $cont['so_seal'] : '',
    'danh_sach_seal' => !empty($cont['danh_sach_seal']) && is_array($cont['danh_sach_seal']) ? $cont['danh_sach_seal'] : array(),
    'loai_cont' => !empty($cont['loai_cont']) ? $cont['loai_cont'] : '',
    'cont_nid' => !empty($cont['cont_nid']) ? (int) $cont['cont_nid'] : $cont_nid,
    'seal_nid' => $first_stored_seal_nid,
    'seal_nids' => $stored_seal_nids,
    'container_order' => ops_api_container_order_number($data, $type_index, $slot_cont_index),
    'loai_xe_index' => (int) $type_index,
    'cont_index' => (int) $slot_cont_index,
  );

  // Xóa hẳn toàn bộ dữ liệu lựa chọn vỏ khỏi slot. Không gán mảng thành
  // chuỗi rỗng vì dữ liệu sai kiểu có thể làm các API sau hiểu nhầm slot vẫn
  // còn thông tin cont/seal cũ.
  foreach (array(
    'so_cont',
    'so_seal',
    'danh_sach_seal',
    'loai_cont',
    'iso_type_code',
    'ngay_chon_vo',
    'nguoi_chon_vo',
    'nguoi_chon_vo_text',
    'hinh_anh_chon_vo',
    'cont_nid',
    'seal_nid',
    'seal_nids',
  ) as $key) {
    unset($data['loai_xe'][$type_index]['conts'][$slot_cont_index][$key]);
  }

  // Cập nhật cont/seal theo lô bằng Field API, tránh 2 lần node_save()
  // và toàn bộ hook node không cần thiết cho thao tác xóa.
  $node_ids_to_deactivate = array_merge(
    array($deleted['cont_nid']),
    $deleted['seal_nids']
  );
  ops_api_fast_deactivate_cont_seal_nodes($node_ids_to_deactivate);

  $now_text = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');
  $full_name = ops_api_get_user_full_name($account);

  if (empty($data['lich_su_xoa_vo']) || !is_array($data['lich_su_xoa_vo'])) {
    $data['lich_su_xoa_vo'] = array();
  }
  $data['lich_su_xoa_vo'][] = array(
    'thoi_gian' => $now_text,
    'uid' => (int) $account->uid,
    'nguoi_thuc_hien' => $full_name,
    'so_booking' => !empty($data['so_booking']) ? $data['so_booking'] : $booking_no,
    'deleted_cont' => $deleted,
  );

  $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
  $data['tong_so_cont'] = ops_api_count_total_containers($data);
  ops_api_remove_legacy_container_status_keys($data);
  ops_api_sync_order_incomplete_field($node, $data);
  $data['ngay_cap_nhat_chon_vo'] = $now_text;
  $data['uid_cap_nhat_chon_vo'] = (int) $account->uid;

  ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
  if (!ops_api_fast_save_order_container_fields($node)) {
    ops_api_error('Không thể cập nhật dữ liệu đơn hàng sau khi xóa cont.', 500);
  }

  ops_api_response(array(
    'success' => TRUE,
    'message' => 'Đã xóa cont đã upload và cập nhật lại số cont đã chọn.',
    'deleted' => $deleted,
    'order_update' => array(
      'don_hang_nid' => (int) $node->nid,
      'so_cont_da_chon' => (int) $data['so_cont_da_chon'],
      'tong_so_cont' => (int) $data['tong_so_cont'],
      'field_chua_chon_het' => ops_api_get_order_incomplete_value($node),
      'trang_thai_chon_vo_cont' => ops_api_get_container_selection_status($node),
    ),
    'booking' => ops_api_build_booking_response(ops_api_build_order_record_from_node($node), $data),
    'performance' => array(
      'processing_ms' => (int) round((microtime(TRUE) - $started_at) * 1000),
      'reload_required' => FALSE,
    ),
  ), 200);
}

/**
 * Build dữ liệu booking cho Flutter từ field_noi_dung_json.
 */

function ops_api_get_container_selection_status($order) {
  return ops_api_order_has_incomplete_containers($order) ? 'chua_chon_het' : 'da_chon_het';
}

/**
 * Kiểm tra field trạng thái mới đã được tạo và gắn vào content type don_hang.
 */
function ops_api_assert_chua_chon_het_field_available() {
  $field = field_info_field('field_chua_chon_het');
  $instance = field_info_instance('node', 'field_chua_chon_het', 'don_hang');

  if (!$field || !$instance) {
    ops_api_error(
      'Chưa có field_chua_chon_het trên content type don_hang. Vui lòng chạy update.php hoặc drush updb sau khi cập nhật module ops_api.',
      500
    );
  }
}

/**
 * Lấy giá trị field_chua_chon_het từ node hoặc record truy vấn.
 *
 * 1 = chưa chọn hết, 0 = đã chọn hết.
 */
function ops_api_get_order_incomplete_value($order) {
  if (is_numeric($order)) {
    $order = node_load((int) $order);
  }

  if (!is_object($order)) {
    return 1;
  }

  if (isset($order->chua_chon_het)) {
    return !empty($order->chua_chon_het) ? 1 : 0;
  }

  if (isset($order->field_chua_chon_het_value)) {
    return !empty($order->field_chua_chon_het_value) ? 1 : 0;
  }

  if (!empty($order->field_chua_chon_het) && is_array($order->field_chua_chon_het)) {
    foreach ($order->field_chua_chon_het as $items) {
      if (isset($items[0]['value'])) {
        return !empty($items[0]['value']) ? 1 : 0;
      }
    }
  }

  if (!empty($order->nid)) {
    $loaded = node_load((int) $order->nid);
    if ($loaded && $loaded !== $order) {
      return ops_api_get_order_incomplete_value($loaded);
    }
  }

  // An toàn cho dữ liệu chưa migrate: coi là chưa chọn hết để không bỏ lọt booking.
  return 1;
}

function ops_api_order_has_incomplete_containers($order) {
  return ops_api_get_order_incomplete_value($order) === 1;
}


/**
 * Gán trực tiếp giá trị field_chua_chon_het vào node.
 */
function ops_api_set_order_incomplete_value(&$node, $value) {
  $value = !empty($value) ? 1 : 0;
  $lang = LANGUAGE_NONE;

  if (!empty($node->field_chua_chon_het) && is_array($node->field_chua_chon_het)) {
    $langs = array_keys($node->field_chua_chon_het);
    if (!empty($langs[0])) {
      $lang = $langs[0];
    }
  }

  $node->field_chua_chon_het[$lang][0]['value'] = $value;
}

/**
 * Đồng bộ field theo số lượng cont thực tế trong field_noi_dung_json.
 */
function ops_api_sync_order_incomplete_field(&$node, $data) {
  $total = ops_api_count_total_containers($data);
  $selected = ops_api_count_selected_containers($data);
  $incomplete = ($total > 0 && $selected < $total) ? 1 : 0;

  ops_api_set_order_incomplete_value($node, $incomplete);
  return $incomplete;
}

/**
 * Không tiếp tục lưu trạng thái chọn vỏ trong JSON.
 */
function ops_api_remove_legacy_container_status_keys(&$data) {
  foreach (array('trang_thai_chon_vo_cont', 'trang_thai_chon_vo', 'da_chon_het_cont') as $key) {
    if (array_key_exists($key, $data)) {
      unset($data[$key]);
    }
  }
}

/**
 * Tạo record tương thích cho hàm build response từ node vừa cập nhật.
 */
function ops_api_build_order_record_from_node($node) {
  return (object) array(
    'nid' => !empty($node->nid) ? (int) $node->nid : 0,
    'title' => !empty($node->title) ? $node->title : '',
    'khach_hang_nid' => 0,
    'khach_hang_title' => '',
    'chua_chon_het' => ops_api_get_order_incomplete_value($node),
  );
}

/**
 * Implements hook_node_presave().
 *
 * Mọi lần lưu don_hang đều đồng bộ field_chua_chon_het và dọn trạng thái cũ khỏi JSON.
 */
function ops_api_node_presave($node) {
  if (empty($node->type) || $node->type !== 'don_hang') {
    return;
  }

  if (!field_info_field('field_chua_chon_het') || !field_info_instance('node', 'field_chua_chon_het', 'don_hang')) {
    return;
  }

  $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
  $data = ops_api_decode_order_json($json_value);
  if (empty($data) || !is_array($data)) {
    return;
  }

  ops_api_prepare_container_slots($data);
  $data['tong_so_cont'] = ops_api_count_total_containers($data);
  $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);
  ops_api_remove_legacy_container_status_keys($data);
  ops_api_sync_order_incomplete_field($node, $data);
  ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($data));
}

function ops_api_is_container_selection_completed($order) {
  return !ops_api_order_has_incomplete_containers($order);
}

function ops_api_build_booking_response($record, $data) {
  ops_api_prepare_container_slots($data);
  $tau_chuyen = ops_api_json_value($data, 'tau_chuyen');
  $vessel_voyage = ops_api_parse_vessel_voyage($tau_chuyen);

  $customer_name = !empty($record->khach_hang_title)
    ? $record->khach_hang_title
    : ops_api_json_value($data, 'khach_hang');

  $shipping_line = ops_api_first_json_value($data, array(
    'hang_tau',
    'hang_tau_name',
    'hang_tau_title',
    'shipping_line',
    'shippingLine',
  ));

  $vessel_name = ops_api_first_json_value($data, array('ten_tau', 'vessel_name', 'vesselName'));
  if ($vessel_name == '') {
    $vessel_name = $vessel_voyage['vessel'];
  }

  $voyage_no = ops_api_first_json_value($data, array('so_chuyen', 'voyage_no', 'voyageNo'));
  if ($voyage_no == '') {
    $voyage_no = $vessel_voyage['voyage'];
  }

  $eta = ops_api_json_value($data, 'eta');
  $eta_timestamp = is_numeric($eta) && (int) $eta > 0 ? (int) $eta : 0;
  $eta_text = $eta_timestamp > 0 ? format_date($eta_timestamp, 'custom', 'd/m/Y H:i') : '';

  $total = ops_api_count_total_containers($data);
  $selected = ops_api_count_selected_containers($data);

  $field_chua_chon_het = ops_api_get_order_incomplete_value($record);
  $selection_status = ops_api_get_container_selection_status($record);

  $response = array(
    'nid' => (int) $record->nid,
    'title' => !empty($record->title) ? $record->title : '',
    'bookingNo' => ops_api_json_value($data, 'so_booking'),
    'loaiXnk' => ops_api_json_value($data, 'loai_xnk'),
    'loai_xnk' => ops_api_json_value($data, 'loai_xnk'),
    'customerName' => $customer_name,
    'shippingLine' => $shipping_line,
    'vesselName' => $vessel_name,
    'voyageNo' => $voyage_no,
    'etaTimestamp' => $eta_timestamp,
    'etaText' => $eta_text,
    'containerQuantity' => $total,
    'selectedContainerCount' => $selected,
    'isContainerSelectionCompleted' => ops_api_is_container_selection_completed($record),
    'field_chua_chon_het' => $field_chua_chon_het,
    'trang_thai_chon_vo_cont' => $selection_status,
    'trang_thai_chon_vo' => $selection_status,
    'containerTypeSummary' => ops_api_container_type_summary($data),
    'containerNoSummary' => ops_api_container_no_summary($data),
    'uploadedImageUrls' => ops_api_order_image_urls($data),
    'uploaded_image_urls' => ops_api_order_image_urls($data),
    'imageUrls' => ops_api_order_image_urls($data),
    'hinh_anh_conts' => ops_api_order_image_urls($data),
    'invoiceInfo' => array(
      'companyName' => $customer_name,
      'taxCode' => '',
      'address' => '',
      'representativeName' => '',
      'phone' => '',
      'representativePosition' => '',
    ),
    'containers' => ops_api_selected_containers_for_response($data, (int) $record->nid),
  );

  return $response;
}



/**
 * Danh sách URL ảnh vỏ cont đã upload trong field_noi_dung_json.
 */
function ops_api_order_image_urls($data) {
  $urls = array();

  if (!empty($data['hinh_anh_conts']) && is_array($data['hinh_anh_conts'])) {
    foreach ($data['hinh_anh_conts'] as $url) {
      $url = trim((string) $url);
      if ($url !== '' && !in_array($url, $urls)) {
        $urls[] = $url;
      }
    }
  }

  if (!empty($data['lich_su_nhap_vo']) && is_array($data['lich_su_nhap_vo'])) {
    foreach ($data['lich_su_nhap_vo'] as $history) {
      if (empty($history['url']) || !is_array($history['url'])) {
        continue;
      }
      foreach ($history['url'] as $url) {
        $url = trim((string) $url);
        if ($url !== '' && !in_array($url, $urls)) {
          $urls[] = $url;
        }
      }
    }
  }

  return $urls;
}

/**
 * Danh sách số cont trong JSON để Flutter hiển thị trên dropdown.
 */
function ops_api_container_no_summary($data) {
  $items = array();

  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return '';
  }

  foreach ($data['loai_xe'] as $type_index => $type) {
    $container_type = !empty($type['ma']) ? trim((string) $type['ma']) : '';

    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }

    foreach ($type['conts'] as $cont) {
      $so_cont = !empty($cont['so_cont']) ? trim((string) $cont['so_cont']) : '';

      if ($so_cont === '') {
        continue;
      }

      $items[] = $container_type !== '' ? $so_cont . ' (' . $container_type . ')' : $so_cont;
    }
  }

  return implode(', ', $items);
}

/**
 * Các cont đã chọn trong JSON để Flutter hiển thị tiến độ.
 */
function ops_api_selected_containers_for_response($data, $don_hang_nid = 0) {
  $items = array();
  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return $items;
  }

  $order = 0;
  foreach ($data['loai_xe'] as $type_index => $type) {
    $container_type = !empty($type['ma']) ? $type['ma'] : '';
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }
    foreach ($type['conts'] as $cont_index => $cont) {
      $order++;
      if (!ops_api_is_container_selected($cont)) {
        continue;
      }
      $item_container_type = !empty($cont['loai_cont']) ? $cont['loai_cont'] : $container_type;

      $items[] = array(
        'donHangNid' => (int) $don_hang_nid,
        'don_hang_nid' => (int) $don_hang_nid,
        'bookingNo' => ops_api_json_value($data, 'so_booking'),
        'containerOrder' => $order,
        'containerNo' => !empty($cont['so_cont']) ? $cont['so_cont'] : '',
        'sealNo' => !empty($cont['so_seal']) ? $cont['so_seal'] : '',
        'containerType' => $item_container_type,
        'contNid' => !empty($cont['cont_nid']) ? (int) $cont['cont_nid'] : 0,
        'cont_nid' => !empty($cont['cont_nid']) ? (int) $cont['cont_nid'] : 0,
        'sealNid' => !empty($cont['seal_nid']) ? (int) $cont['seal_nid'] : 0,
        'seal_nid' => !empty($cont['seal_nid']) ? (int) $cont['seal_nid'] : 0,
        'loaiXeIndex' => (int) $type_index,
        'loai_xe_index' => (int) $type_index,
        'contIndex' => (int) $cont_index,
        'cont_index' => (int) $cont_index,
        'depositAmount' => !empty($cont['tong_tien_cuoc_vo'])
          ? (int) $cont['tong_tien_cuoc_vo']
          : (!empty($cont['tien_cuoc_vo']) ? (int) $cont['tien_cuoc_vo'] : 0),
        'depositUnitPrice' => !empty($cont['tien_cuoc_vo']) ? (int) $cont['tien_cuoc_vo'] : 0,
        'depositExtraCosts' => !empty($cont['chi_phi_khac_cuoc_vo']) && is_array($cont['chi_phi_khac_cuoc_vo'])
          ? $cont['chi_phi_khac_cuoc_vo']
          : array(),
        'isDeposited' => !empty($cont['nguoi_cuoc_vo']) || !empty($cont['ngay_cuoc_vo']) || !empty($cont['giao_dich_vi_nid']),
        'selectedBy' => ops_api_container_user_text($cont, 'nguoi_chon_vo'),
        'depositedBy' => ops_api_container_user_text($cont, 'nguoi_cuoc_vo'),
        'depositDate' => !empty($cont['ngay_cuoc_vo']) ? $cont['ngay_cuoc_vo'] : '',
        'depositDateTimestamp' => !empty($cont['ngay_cuoc_vo_timestamp']) ? (int) $cont['ngay_cuoc_vo_timestamp'] : 0,
        'walletTransactionCode' => !empty($cont['ma_giao_dich_vi']) ? $cont['ma_giao_dich_vi'] : '',
        'walletTransactionNid' => !empty($cont['giao_dich_vi_nid']) ? (int) $cont['giao_dich_vi_nid'] : 0,
        'billDepositImage' => !empty($cont['bill_cuoc_vo']) ? $cont['bill_cuoc_vo'] : '',
        'selectedAt' => !empty($cont['ngay_chon_vo']) ? $cont['ngay_chon_vo'] : '',
        'ngay_chon_vo' => !empty($cont['ngay_chon_vo']) ? $cont['ngay_chon_vo'] : '',
        'imageUrl' => !empty($cont['hinh_anh_chon_vo']) ? $cont['hinh_anh_chon_vo'] : '',
        'hinh_anh_chon_vo' => !empty($cont['hinh_anh_chon_vo']) ? $cont['hinh_anh_chon_vo'] : '',
      );
    }
  }

  return $items;
}

function ops_api_container_user_text($cont, $key) {
  $text_key = $key . '_text';
  if (!empty($cont[$text_key])) {
    return $cont[$text_key];
  }
  if (empty($cont[$key])) {
    return '';
  }
  if (is_numeric($cont[$key])) {
    $account = user_load((int) $cont[$key]);
    return $account ? ops_api_get_user_full_name($account) : (string) $cont[$key];
  }
  return (string) $cont[$key];
}


function ops_api_find_uploaded_container_slot($data, $criteria) {
  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return FALSE;
  }

  $container_order = !empty($criteria['container_order']) ? (int) $criteria['container_order'] : 0;
  $container_no = !empty($criteria['container_no']) ? strtoupper(trim((string) $criteria['container_no'])) : '';
  $cont_nid = !empty($criteria['cont_nid']) ? (int) $criteria['cont_nid'] : 0;
  $target_type_index = isset($criteria['loai_xe_index']) ? $criteria['loai_xe_index'] : NULL;
  $target_cont_index = isset($criteria['cont_index']) ? $criteria['cont_index'] : NULL;

  if ($target_type_index !== NULL && $target_cont_index !== NULL) {
    if (isset($data['loai_xe'][$target_type_index]['conts'][$target_cont_index]) && is_array($data['loai_xe'][$target_type_index]['conts'][$target_cont_index])) {
      $candidate = $data['loai_xe'][$target_type_index]['conts'][$target_cont_index];
      if (ops_api_is_container_selected($candidate)) {
        return array(
          'type_index' => (int) $target_type_index,
          'cont_index' => (int) $target_cont_index,
          'mode' => 'index',
        );
      }
    }
  }

  $order = 0;
  foreach ($data['loai_xe'] as $type_index => $type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }

    foreach ($type['conts'] as $cont_index => $cont) {
      $order++;
      if (!is_array($cont) || !ops_api_is_container_selected($cont)) {
        continue;
      }

      if ($cont_nid > 0 && !empty($cont['cont_nid']) && (int) $cont['cont_nid'] === $cont_nid) {
        return array('type_index' => (int) $type_index, 'cont_index' => (int) $cont_index, 'mode' => 'cont_nid');
      }

      $current_container_no = !empty($cont['so_cont']) ? strtoupper(trim((string) $cont['so_cont'])) : '';
      if ($container_no !== '' && $current_container_no !== '' && $current_container_no === $container_no) {
        return array('type_index' => (int) $type_index, 'cont_index' => (int) $cont_index, 'mode' => 'container_no');
      }

      if ($container_order > 0 && $order === $container_order) {
        return array('type_index' => (int) $type_index, 'cont_index' => (int) $cont_index, 'mode' => 'container_order');
      }
    }
  }

  return FALSE;
}

/**
 * Lưu nhanh hai field dùng cho nghiệp vụ chọn vỏ của don_hang.
 *
 * Không dùng node_save() để tránh kích hoạt toàn bộ hook_node_presave/update
 * của website. Các giá trị JSON và field_chua_chon_het đã được đồng bộ trước
 * khi gọi hàm này.
 */
function ops_api_fast_save_order_container_fields(&$node) {
  if (!$node || empty($node->nid) || $node->type !== 'don_hang') {
    return FALSE;
  }

  try {
    field_attach_presave('node', $node);
    field_attach_update('node', $node);

    db_update('node')
      ->fields(array('changed' => REQUEST_TIME))
      ->condition('nid', (int) $node->nid)
      ->execute();

    $controller = entity_get_controller('node');
    if ($controller) {
      $controller->resetCache(array((int) $node->nid));
    }
    return TRUE;
  }
  catch (Exception $e) {
    watchdog_exception('ops_api', $e, 'Lỗi lưu nhanh đơn hàng @nid sau khi xóa cont.', array(
      '@nid' => !empty($node->nid) ? (int) $node->nid : 0,
    ));
    return FALSE;
  }
}

/**
 * Đánh dấu nhiều node cont_seal không còn hoạt động trong một lượt tải.
 */
function ops_api_fast_deactivate_cont_seal_nodes($nids) {
  $nids = array_values(array_unique(array_filter(array_map('intval', (array) $nids))));
  if (empty($nids)) {
    return 0;
  }

  $nodes = node_load_multiple($nids);
  if (empty($nodes)) {
    return 0;
  }

  $updated_nids = array();
  $now_text = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');
  $has_active_field = field_info_field('field_hoat_dong') && field_info_instance('node', 'field_hoat_dong', 'cont_seal');
  $has_json_field = field_info_field('field_noi_dung_json') && field_info_instance('node', 'field_noi_dung_json', 'cont_seal');

  foreach ($nodes as $node) {
    if (!$node || empty($node->nid) || $node->type !== 'cont_seal') {
      continue;
    }

    if ($has_active_field) {
      $node->field_hoat_dong[LANGUAGE_NONE][0]['value'] = 0;
    }

    if ($has_json_field) {
      $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
      $json = ops_api_decode_order_json($json_value);
      if (!is_array($json)) {
        $json = array();
      }
      $json['hoat_dong'] = FALSE;
      $json['da_xoa_khoi_booking'] = TRUE;
      $json['thoi_gian_xoa_khoi_booking'] = $now_text;
      ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($json));
    }

    field_attach_presave('node', $node);
    field_attach_update('node', $node);
    $updated_nids[] = (int) $node->nid;
  }

  if (!empty($updated_nids)) {
    db_update('node')
      ->fields(array('changed' => REQUEST_TIME))
      ->condition('nid', $updated_nids, 'IN')
      ->execute();

    $controller = entity_get_controller('node');
    if ($controller) {
      $controller->resetCache($updated_nids);
    }
  }

  return count($updated_nids);
}

function ops_api_deactivate_cont_seal_node($nid) {
  $nid = (int) $nid;
  if ($nid <= 0) {
    return FALSE;
  }

  $node = node_load($nid);
  if (!$node || empty($node->nid) || $node->type !== 'cont_seal') {
    return FALSE;
  }

  if (field_info_field('field_hoat_dong')) {
    $node->field_hoat_dong[LANGUAGE_NONE][0]['value'] = 0;
  }

  $json_value = ops_api_get_node_field_first_value($node, 'field_noi_dung_json');
  $json = ops_api_decode_order_json($json_value);
  if (!is_array($json)) {
    $json = array();
  }
  $json['da_xoa_khoi_booking'] = TRUE;
  $json['thoi_gian_xoa_khoi_booking'] = format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s');
  ops_api_set_node_field_first_value($node, 'field_noi_dung_json', ops_api_json_encode($json));

  node_save($node);
  return TRUE;
}

function ops_api_load_order_node_for_import($nid, $booking_no) {
  if ($nid > 0) {
    $node = node_load($nid);
    if ($node && $node->type == 'don_hang') {
      return $node;
    }
  }

  if ($booking_no == '') {
    return FALSE;
  }

  $query = db_select('node', 'n');
  $query->innerJoin(
    'field_data_field_noi_dung_json',
    'fj',
    "fj.entity_type = 'node' AND fj.entity_id = n.nid AND fj.bundle = 'don_hang' AND fj.deleted = 0 AND fj.delta = 0"
  );
  $query->fields('n', array('nid'));
  $query->condition('n.type', 'don_hang');
  $query->condition('fj.field_noi_dung_json_value', '%' . db_like($booking_no) . '%', 'LIKE');
  $query->orderBy('n.created', 'DESC');
  $query->range(0, 1);

  $found_nid = $query->execute()->fetchField();
  return $found_nid ? node_load($found_nid) : FALSE;
}

/**
 * Chuẩn hóa dữ liệu AI trả về thành danh sách chuỗi số cont hoặc số seal.
 */
function ops_api_parse_recognized_number_list($source, $kind) {
  if (is_string($source)) {
    $trimmed = trim($source);
    if ($trimmed === '') {
      return array();
    }

    $decoded = drupal_json_decode($trimmed);
    if (is_array($decoded)) {
      $source = $decoded;
    }
    else {
      $source = preg_split('/[\r\n,;|]+/u', $trimmed);
    }
  }

  if (!is_array($source)) {
    $source = array($source);
  }

  $values = array();
  foreach ($source as $item) {
    $value = ops_api_extract_recognized_number($item, $kind);
    if ($value === '') {
      continue;
    }

    $value = $kind === 'cont'
      ? ops_api_normalize_container_number($value)
      : ops_api_normalize_seal_number($value);

    if ($value !== '') {
      $values[] = $value;
    }
  }

  return array_values($values);
}

function ops_api_extract_recognized_number($item, $kind) {
  if (is_scalar($item)) {
    return trim((string) $item);
  }

  if (!is_array($item)) {
    return '';
  }

  $keys = $kind === 'cont'
    ? array('so_cont', 'containerNo', 'container_no', 'container', 'number', 'value', 'text', 'title')
    : array('so_seal', 'sealNo', 'seal_no', 'seal', 'number', 'value', 'text', 'title');

  foreach ($keys as $key) {
    if (isset($item[$key]) && is_scalar($item[$key]) && trim((string) $item[$key]) !== '') {
      return trim((string) $item[$key]);
    }
  }

  if (count($item) === 1) {
    $first = reset($item);
    return ops_api_extract_recognized_number($first, $kind);
  }

  return '';
}

function ops_api_normalize_container_number($value) {
  $value = strtoupper(trim((string) $value));
  $value = preg_replace('/\s+/u', '', $value);

  // Chuẩn hiển thị: ABCD1234567. Chỉ bỏ dấu phân cách, không tự sửa ký tự AI đọc được.
  $canonical = preg_replace('/[^A-Z0-9]/', '', $value);
  return trim($canonical);
}

function ops_api_normalize_seal_number($value) {
  $value = strtoupper(trim((string) $value));
  return preg_replace('/\s+/u', '', $value);
}

function ops_api_container_compare_key($value) {
  return preg_replace('/[^A-Z0-9]/', '', strtoupper(trim((string) $value)));
}


/**
 * Chuẩn hóa cấu trúc slot cont cho dữ liệu đơn hàng cũ.
 *
 * Dữ liệu cũ có thể chỉ có loai_xe[].so_luong hoặc tong_so_cont nhưng chưa
 * tạo loai_xe[].conts. Hàm này chỉ bổ sung slot trống, không xóa dữ liệu cũ.
 */
function ops_api_prepare_container_slots(&$data) {
  if (!is_array($data)) {
    return FALSE;
  }

  $changed = FALSE;
  $target_total = ops_api_count_total_containers($data);
  if ($target_total <= 0) {
    return FALSE;
  }

  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    $data['loai_xe'] = array(
      array(
        'stt' => 1,
        'loai_xe' => '',
        'ma' => '',
        'so_luong' => $target_total,
        'conts' => array(),
      ),
    );
    $changed = TRUE;
  }

  $allocated = 0;
  foreach ($data['loai_xe'] as $type_index => &$type) {
    if (!is_array($type)) {
      $type = array();
      $changed = TRUE;
    }

    if (empty($type['conts']) || !is_array($type['conts'])) {
      $type['conts'] = array();
      $changed = TRUE;
    }

    $desired = count($type['conts']);
    if (isset($type['so_luong']) && is_numeric($type['so_luong']) && (int) $type['so_luong'] > 0) {
      $desired = max($desired, (int) $type['so_luong']);
    }

    while (count($type['conts']) < $desired) {
      $type['conts'][] = array();
      $changed = TRUE;
    }

    $allocated += count($type['conts']);
  }
  unset($type);

  // Trường hợp tong_so_cont lớn hơn tổng so_luong: thêm phần thiếu vào nhóm đầu.
  if ($allocated < $target_total) {
    $keys = array_keys($data['loai_xe']);
    $first_index = !empty($keys) ? reset($keys) : NULL;
    if ($first_index === NULL) {
      $first_index = 0;
      $data['loai_xe'][$first_index] = array(
        'stt' => 1,
        'loai_xe' => '',
        'ma' => '',
        'so_luong' => 0,
        'conts' => array(),
      );
    }

    if (empty($data['loai_xe'][$first_index]['conts']) || !is_array($data['loai_xe'][$first_index]['conts'])) {
      $data['loai_xe'][$first_index]['conts'] = array();
    }

    while ($allocated < $target_total) {
      $data['loai_xe'][$first_index]['conts'][] = array();
      $allocated++;
      $changed = TRUE;
    }
  }

  // Không để tổng nhỏ hơn số slot thực tế đã tồn tại.
  $data['tong_so_cont'] = max($target_total, $allocated);
  $data['so_cont_da_chon'] = ops_api_count_selected_containers($data);

  return $changed;
}

/**
 * Parse danh sách nid dương, giữ nguyên thứ tự.
 */
function ops_api_parse_positive_integer_list($source) {
  if (is_string($source)) {
    $decoded = drupal_json_decode($source);
    $source = is_array($decoded) ? $decoded : preg_split('/[\r\n,;|]+/u', $source);
  }
  if (!is_array($source)) {
    return array();
  }

  $result = array();
  foreach ($source as $value) {
    $result[] = is_numeric($value) && (int) $value > 0 ? (int) $value : 0;
  }
  return array_values($result);
}

/**
 * Parse danh sách chuỗi, giữ nguyên thứ tự và vị trí.
 */
function ops_api_parse_text_list($source) {
  if (is_string($source)) {
    $decoded = drupal_json_decode($source);
    $source = is_array($decoded) ? $decoded : preg_split('/[\r\n,;|]+/u', $source);
  }
  if (!is_array($source)) {
    return array();
  }

  $result = array();
  foreach ($source as $value) {
    $result[] = is_scalar($value) ? trim((string) $value) : '';
  }
  return array_values($result);
}

/**
 * Kiểm tra node cont_seal do API AI đã tạo có thể tái sử dụng hay không.
 */
function ops_api_validate_reusable_cont_seal_node($nid, $expected_number, $kind, $don_hang_nid) {
  $nid = (int) $nid;
  if ($nid <= 0) {
    return 0;
  }

  $node = node_load($nid);
  if (!$node || empty($node->type) || $node->type !== 'cont_seal') {
    return 0;
  }

  $actual_number = !empty($node->title) ? trim((string) $node->title) : '';
  if ($actual_number === '') {
    foreach (array('field_so_cont_seal', $kind === 'cont' ? 'field_so_cont' : 'field_so_seal') as $field_name) {
      $items = field_get_items('node', $node, $field_name);
      if (!empty($items[0]['value'])) {
        $actual_number = trim((string) $items[0]['value']);
        break;
      }
    }
  }

  if (ops_api_container_compare_key($actual_number) !== ops_api_container_compare_key($expected_number)) {
    return 0;
  }

  $order_items = field_get_items('node', $node, 'field_don_hang');
  if (!empty($order_items[0])) {
    $linked_nid = !empty($order_items[0]['target_id'])
      ? (int) $order_items[0]['target_id']
      : (!empty($order_items[0]['nid']) ? (int) $order_items[0]['nid'] : 0);
    if ($linked_nid > 0 && $don_hang_nid > 0 && $linked_nid !== (int) $don_hang_nid) {
      return 0;
    }
  }

  return $nid;
}

function ops_api_find_duplicate_values($values, $kind) {
  $seen = array();
  $duplicates = array();

  foreach ($values as $value) {
    $key = $kind === 'cont'
      ? ops_api_container_compare_key($value)
      : strtoupper(trim((string) $value));

    if ($key === '') {
      continue;
    }
    if (isset($seen[$key])) {
      $duplicates[$key] = $value;
    }
    else {
      $seen[$key] = TRUE;
    }
  }

  return array_values($duplicates);
}

function ops_api_parse_image_name_list($source) {
  if (is_string($source)) {
    $decoded = drupal_json_decode($source);
    $source = is_array($decoded) ? $decoded : preg_split('/[\r\n,;|]+/u', $source);
  }
  if (!is_array($source)) {
    return array();
  }

  $result = array();
  foreach ($source as $item) {
    if (!is_scalar($item)) {
      continue;
    }
    $name = trim((string) $item);
    if ($name !== '') {
      $result[] = $name;
    }
  }
  return array_values($result);
}


/**
 * Tìm vị trí các số cont đã tồn tại trong chính đơn hàng hiện tại.
 *
 * Trả về mảng theo khóa chuẩn hóa số cont. Việc này giúp API có tính
 * idempotent khi dịch vụ AI đã ghi cont vào đơn hàng trước khi OPS API chạy.
 */
function ops_api_find_container_locations_in_order($data, $container_numbers) {
  $wanted = array();
  foreach ($container_numbers as $number) {
    $key = ops_api_container_compare_key($number);
    if ($key !== '') {
      $wanted[$key] = TRUE;
    }
  }

  $locations = array();
  if (empty($wanted) || empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return $locations;
  }

  foreach ($data['loai_xe'] as $type_index => $type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }

    foreach ($type['conts'] as $cont_index => $cont) {
      if (empty($cont['so_cont'])) {
        continue;
      }

      $key = ops_api_container_compare_key($cont['so_cont']);
      if ($key !== '' && isset($wanted[$key]) && !isset($locations[$key])) {
        $locations[$key] = array(
          'type_index' => $type_index,
          'cont_index' => $cont_index,
        );
      }
    }
  }

  return $locations;
}

/**
 * Lấy đầy đủ danh sách seal đang gắn với một cont, tương thích dữ liệu cũ.
 */
function ops_api_get_container_seal_numbers($cont) {
  $source = array();
  if (!empty($cont['danh_sach_seal']) && is_array($cont['danh_sach_seal'])) {
    $source = $cont['danh_sach_seal'];
  }
  elseif (!empty($cont['so_seal'])) {
    $source = $cont['so_seal'];
  }

  return ops_api_parse_recognized_number_list($source, 'seal');
}

/**
 * Gộp hai danh sách số, giữ thứ tự và loại trùng theo khóa chuẩn hóa.
 */
function ops_api_merge_unique_number_lists($first, $second, $kind = 'seal') {
  $merged = array();
  $seen = array();
  foreach (array_merge((array) $first, (array) $second) as $number) {
    if (!is_scalar($number)) {
      continue;
    }
    $normalized_list = ops_api_parse_recognized_number_list(array($number), $kind);
    if (empty($normalized_list)) {
      continue;
    }
    $normalized = reset($normalized_list);
    $key = ops_api_container_compare_key($normalized);
    if ($key === '' || isset($seen[$key])) {
      continue;
    }
    $seen[$key] = TRUE;
    $merged[] = $normalized;
  }
  return $merged;
}

function ops_api_get_empty_container_slots($data) {
  ops_api_prepare_container_slots($data);
  $slots = array();
  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return $slots;
  }

  foreach ($data['loai_xe'] as $type_index => $type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }
    foreach ($type['conts'] as $cont_index => $cont) {
      if (!is_array($cont) || !ops_api_is_container_selected($cont)) {
        $slots[] = array(
          'type_index' => $type_index,
          'cont_index' => $cont_index,
        );
      }
    }
  }

  return $slots;
}

/**
 * Tìm số cont đã có trong các đơn hàng đang chua_chon_het.
 */
function ops_api_find_containers_in_pending_orders($container_numbers, $exclude_nid = 0) {
  $wanted = array();
  foreach ($container_numbers as $number) {
    $key = ops_api_container_compare_key($number);
    if ($key !== '') {
      $wanted[$key] = $number;
    }
  }
  if (empty($wanted)) {
    return array();
  }

  $query = db_select('node', 'n');
  $query->innerJoin(
    'field_data_field_noi_dung_json',
    'fj',
    "fj.entity_type = 'node' AND fj.entity_id = n.nid AND fj.bundle = 'don_hang' AND fj.deleted = 0 AND fj.delta = 0"
  );
  $query->innerJoin(
    'field_data_field_chua_chon_het',
    'fcch',
    "fcch.entity_type = 'node' AND fcch.entity_id = n.nid AND fcch.bundle = 'don_hang' AND fcch.deleted = 0 AND fcch.delta = 0"
  );
  $query->fields('n', array('nid', 'title'));
  $query->addField('fj', 'field_noi_dung_json_value', 'noi_dung_json');
  $query->condition('n.type', 'don_hang');
  $query->condition('fcch.field_chua_chon_het_value', 1);

  // Rất quan trọng: bỏ qua chính đơn hàng đang được nhập vỏ. API AI cũ có
  // thể đã ghi số cont vào đúng booking hiện tại trước khi OPS API chạy bước
  // kiểm tra/phân bổ. Trường hợp đó phải được xử lý idempotent (cập nhật seal),
  // không được coi là cont trùng ở một đơn hàng khác.
  if ((int) $exclude_nid > 0) {
    $query->condition('n.nid', (int) $exclude_nid, '<>');
  }

  $duplicates = array();
  $seen = array();

  foreach ($query->execute() as $record) {
    // Lớp bảo vệ thứ hai nếu query bị alter bởi module khác.
    if ((int) $exclude_nid > 0 && (int) $record->nid === (int) $exclude_nid) {
      continue;
    }

    $data = ops_api_decode_order_json($record->noi_dung_json);
    if (empty($data) || empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
      continue;
    }

    foreach ($data['loai_xe'] as $type) {
      if (empty($type['conts']) || !is_array($type['conts'])) {
        continue;
      }
      foreach ($type['conts'] as $cont) {
        if (empty($cont['so_cont'])) {
          continue;
        }

        $existing_number = trim((string) $cont['so_cont']);
        $key = ops_api_container_compare_key($existing_number);
        if ($key === '' || !isset($wanted[$key])) {
          continue;
        }

        $unique_key = $record->nid . ':' . $key;
        if (isset($seen[$unique_key])) {
          continue;
        }
        $seen[$unique_key] = TRUE;

        $duplicates[] = array(
          'so_cont' => $wanted[$key],
          'don_hang_nid' => (int) $record->nid,
          'so_booking' => !empty($data['so_booking']) ? trim((string) $data['so_booking']) : trim((string) $record->title),
        );
      }
    }
  }

  return $duplicates;
}

/**
 * Tạo node cont_seal nếu content type có tồn tại; trả 0 nếu hệ thống chưa khai báo type.
 */
function ops_api_create_cont_seal_node($params) {
  $number = !empty($params['number']) ? trim((string) $params['number']) : '';
  if ($number === '') {
    return 0;
  }

  $node_type = node_type_get_type('cont_seal');
  if (!$node_type) {
    return 0;
  }

  $account = !empty($params['account']) ? $params['account'] : NULL;
  $kind = !empty($params['kind']) ? trim((string) $params['kind']) : '';
  $don_hang_nid = !empty($params['don_hang_nid']) ? (int) $params['don_hang_nid'] : 0;
  $booking_no = !empty($params['booking_no']) ? trim((string) $params['booking_no']) : '';
  $image_name = !empty($params['image_name']) ? trim((string) $params['image_name']) : '';

  $node = new stdClass();
  $node->type = 'cont_seal';
  node_object_prepare($node);
  $node->title = $number;
  $node->language = LANGUAGE_NONE;
  $node->uid = $account && !empty($account->uid) ? (int) $account->uid : 0;
  $node->status = 1;

  ops_api_set_reference_field_if_exists($node, 'field_don_hang', $don_hang_nid);
  ops_api_set_text_field_if_exists($node, 'field_phan_loai', $kind);
  ops_api_set_text_field_if_exists($node, 'field_loai', $kind);
  ops_api_set_text_field_if_exists($node, 'field_so_cont_seal', $number);
  ops_api_set_text_field_if_exists($node, 'field_so_cont', $kind === 'cont' ? $number : '');
  ops_api_set_text_field_if_exists($node, 'field_so_seal', $kind === 'seal' ? $number : '');
  ops_api_set_text_field_if_exists($node, 'field_hoat_dong', 1);

  $json = array(
    'phan_loai' => $kind,
    'so_cont_seal' => $number,
    'so_cont' => $kind === 'cont' ? $number : '',
    'so_seal' => $kind === 'seal' ? $number : '',
    'don_hang_nid' => $don_hang_nid,
    'so_booking' => $booking_no,
    'hinh_anh' => $image_name,
    'hoat_dong' => TRUE,
    'created_uid' => $node->uid,
    'created_at' => format_date(REQUEST_TIME, 'custom', 'Y-m-d H:i:s'),
  );
  ops_api_set_text_field_if_exists($node, 'field_noi_dung_json', ops_api_json_encode($json));

  node_save($node);
  return !empty($node->nid) ? (int) $node->nid : 0;
}

function ops_api_set_reference_field_if_exists(&$entity, $field_name, $target_id) {
  $field = field_info_field($field_name);
  $bundle = !empty($entity->type) ? $entity->type : '';
  $instance = $bundle !== '' ? field_info_instance('node', $field_name, $bundle) : FALSE;
  if (!$field || !$instance || $target_id <= 0) {
    return;
  }

  $column = $field['type'] === 'node_reference' ? 'nid' : 'target_id';
  $entity->{$field_name}[LANGUAGE_NONE][0][$column] = (int) $target_id;
}

function ops_api_set_text_field_if_exists(&$entity, $field_name, $value) {
  $field = field_info_field($field_name);
  $bundle = !empty($entity->type) ? $entity->type : '';
  $instance = $bundle !== '' ? field_info_instance('node', $field_name, $bundle) : FALSE;
  if (!$field || !$instance || $value === '') {
    return;
  }
  $entity->{$field_name}[LANGUAGE_NONE][0]['value'] = $value;
}

function ops_api_find_next_container_slot($data) {
  ops_api_prepare_container_slots($data);
  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return FALSE;
  }

  foreach ($data['loai_xe'] as $type_index => $type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }
    foreach ($type['conts'] as $cont_index => $cont) {
      if (!ops_api_is_container_selected($cont)) {
        return array(
          'type_index' => $type_index,
          'cont_index' => $cont_index,
        );
      }
    }
  }

  return FALSE;
}

function ops_api_is_container_selected($cont) {
  if (!empty($cont['so_cont'])) return TRUE;
  if (!empty($cont['ngay_chon_vo'])) return TRUE;
  if (!empty($cont['nguoi_chon_vo'])) return TRUE;
  return FALSE;
}

function ops_api_count_total_containers($data) {
  if (isset($data['tong_so_cont']) && is_numeric($data['tong_so_cont']) && (int) $data['tong_so_cont'] > 0) {
    return (int) $data['tong_so_cont'];
  }

  $total = 0;
  if (!empty($data['loai_xe']) && is_array($data['loai_xe'])) {
    foreach ($data['loai_xe'] as $type) {
      if (!empty($type['conts']) && is_array($type['conts'])) {
        $total += count($type['conts']);
      }
      elseif (isset($type['so_luong']) && is_numeric($type['so_luong'])) {
        $total += (int) $type['so_luong'];
      }
    }
  }
  return $total;
}

function ops_api_count_selected_containers($data) {
  $selected = 0;
  if (!empty($data['loai_xe']) && is_array($data['loai_xe'])) {
    foreach ($data['loai_xe'] as $type) {
      if (empty($type['conts']) || !is_array($type['conts'])) {
        continue;
      }
      foreach ($type['conts'] as $cont) {
        if (ops_api_is_container_selected($cont)) {
          $selected++;
        }
      }
    }
  }
  return $selected;
}

function ops_api_container_type_summary($data) {
  $parts = array();
  if (!empty($data['loai_xe']) && is_array($data['loai_xe'])) {
    foreach ($data['loai_xe'] as $type) {
      $ma = !empty($type['ma']) ? $type['ma'] : '';
      $so_luong = isset($type['so_luong']) ? (int) $type['so_luong'] : 0;
      if ($so_luong <= 0 && !empty($type['conts']) && is_array($type['conts'])) {
        $so_luong = count($type['conts']);
      }
      if ($ma != '') {
        $parts[] = $ma . ' x ' . $so_luong;
      }
    }
  }
  return implode(', ', $parts);
}

function ops_api_container_order_number($data, $target_type_index, $target_cont_index) {
  $order = 0;
  if (empty($data['loai_xe']) || !is_array($data['loai_xe'])) {
    return 1;
  }
  foreach ($data['loai_xe'] as $type_index => $type) {
    if (empty($type['conts']) || !is_array($type['conts'])) {
      continue;
    }
    foreach ($type['conts'] as $cont_index => $cont) {
      $order++;
      if ((string) $type_index === (string) $target_type_index && (string) $cont_index === (string) $target_cont_index) {
        return $order;
      }
    }
  }
  return $order + 1;
}

function ops_api_generate_container_no($nid, $order_no) {
  $prefixes = array('TEMU', 'WHLU', 'FFAU', 'YMLU', 'EISU', 'BMOU');
  $prefix = $prefixes[($order_no - 1) % count($prefixes)];
  $number = str_pad((string) (($nid * 1009 + $order_no * 137) % 1000000), 6, '0', STR_PAD_LEFT);
  $check_digit = ($nid + $order_no) % 10;
  return $prefix . ' ' . $number . '-' . $check_digit;
}


/**
 * Chuẩn hóa chuỗi tiếng Việt để so sánh nghiệp vụ XNK ổn định.
 */
function ops_api_normalize_vietnamese_text($value) {
  $value = trim((string) $value);
  if ($value === '') {
    return '';
  }

  $map = array(
    'À'=>'A','Á'=>'A','Ạ'=>'A','Ả'=>'A','Ã'=>'A','Â'=>'A','Ầ'=>'A','Ấ'=>'A','Ậ'=>'A','Ẩ'=>'A','Ẫ'=>'A','Ă'=>'A','Ằ'=>'A','Ắ'=>'A','Ặ'=>'A','Ẳ'=>'A','Ẵ'=>'A',
    'È'=>'E','É'=>'E','Ẹ'=>'E','Ẻ'=>'E','Ẽ'=>'E','Ê'=>'E','Ề'=>'E','Ế'=>'E','Ệ'=>'E','Ể'=>'E','Ễ'=>'E',
    'Ì'=>'I','Í'=>'I','Ị'=>'I','Ỉ'=>'I','Ĩ'=>'I',
    'Ò'=>'O','Ó'=>'O','Ọ'=>'O','Ỏ'=>'O','Õ'=>'O','Ô'=>'O','Ồ'=>'O','Ố'=>'O','Ộ'=>'O','Ổ'=>'O','Ỗ'=>'O','Ơ'=>'O','Ờ'=>'O','Ớ'=>'O','Ợ'=>'O','Ở'=>'O','Ỡ'=>'O',
    'Ù'=>'U','Ú'=>'U','Ụ'=>'U','Ủ'=>'U','Ũ'=>'U','Ư'=>'U','Ừ'=>'U','Ứ'=>'U','Ự'=>'U','Ử'=>'U','Ữ'=>'U',
    'Ỳ'=>'Y','Ý'=>'Y','Ỵ'=>'Y','Ỷ'=>'Y','Ỹ'=>'Y','Đ'=>'D',
    'à'=>'A','á'=>'A','ạ'=>'A','ả'=>'A','ã'=>'A','â'=>'A','ầ'=>'A','ấ'=>'A','ậ'=>'A','ẩ'=>'A','ẫ'=>'A','ă'=>'A','ằ'=>'A','ắ'=>'A','ặ'=>'A','ẳ'=>'A','ẵ'=>'A',
    'è'=>'E','é'=>'E','ẹ'=>'E','ẻ'=>'E','ẽ'=>'E','ê'=>'E','ề'=>'E','ế'=>'E','ệ'=>'E','ể'=>'E','ễ'=>'E',
    'ì'=>'I','í'=>'I','ị'=>'I','ỉ'=>'I','ĩ'=>'I',
    'ò'=>'O','ó'=>'O','ọ'=>'O','ỏ'=>'O','õ'=>'O','ô'=>'O','ồ'=>'O','ố'=>'O','ộ'=>'O','ổ'=>'O','ỗ'=>'O','ơ'=>'O','ờ'=>'O','ớ'=>'O','ợ'=>'O','ở'=>'O','ỡ'=>'O',
    'ù'=>'U','ú'=>'U','ụ'=>'U','ủ'=>'U','ũ'=>'U','ư'=>'U','ừ'=>'U','ứ'=>'U','ự'=>'U','ử'=>'U','ữ'=>'U',
    'ỳ'=>'Y','ý'=>'Y','ỵ'=>'Y','ỷ'=>'Y','ỹ'=>'Y','đ'=>'D',
  );

  $value = strtr($value, $map);
  $value = function_exists('mb_strtoupper') ? mb_strtoupper($value, 'UTF-8') : strtoupper($value);
  return preg_replace('/\s+/u', ' ', $value);
}

function ops_api_order_trade_direction($data) {
  $value = ops_api_normalize_vietnamese_text(ops_api_json_value($data, 'loai_xnk'));
  if ($value === '') {
    return '';
  }

  // Chỉ áp dụng cho hai loại hình được dùng trong ứng dụng OPS.
  if (strpos($value, 'SEA') === FALSE && strpos($value, 'AIR') === FALSE) {
    return '';
  }

  if (strpos($value, 'XUAT') !== FALSE) {
    return 'export';
  }
  if (strpos($value, 'NHAP') !== FALSE) {
    return 'import';
  }
  return '';
}

function ops_api_is_export_order($data) {
  return ops_api_order_trade_direction($data) === 'export';
}

function ops_api_is_import_order($data) {
  return ops_api_order_trade_direction($data) === 'import';
}

function ops_api_parse_vessel_voyage($tau_chuyen) {
  $tau_chuyen = trim((string) $tau_chuyen);
  $result = array('vessel' => $tau_chuyen, 'voyage' => '');
  if ($tau_chuyen == '') {
    return $result;
  }
  if (preg_match('/^(.*)\s+([A-Za-z0-9\-\/]+)$/u', $tau_chuyen, $matches)) {
    $result['vessel'] = trim($matches[1]);
    $result['voyage'] = trim($matches[2]);
  }
  return $result;
}

function ops_api_first_json_value($data, $keys) {
  foreach ($keys as $key) {
    $value = ops_api_json_value($data, $key);
    if ($value !== '') {
      return $value;
    }
  }
  return '';
}

function ops_api_json_value($data, $key, $default = '') {
  if (isset($data[$key]) && $data[$key] !== NULL && $data[$key] !== '') {
    return $data[$key];
  }
  return $default;
}

function ops_api_decode_order_json($json) {
  $json = trim((string) $json);
  if ($json == '') {
    return array();
  }

  $data = drupal_json_decode($json);
  if (is_array($data)) {
    return $data;
  }

  $json = html_entity_decode($json, ENT_QUOTES, 'UTF-8');
  $data = json_decode($json, TRUE);
  if (is_array($data)) {
    return $data;
  }

  $json = stripslashes($json);
  $data = json_decode($json, TRUE);
  return is_array($data) ? $data : array();
}

function ops_api_json_encode($data) {
  if (function_exists('drupal_json_encode')) {
    return drupal_json_encode($data);
  }
  return json_encode($data);
}

function ops_api_get_node_field_first_value($node, $field_name) {
  if (empty($node->{$field_name}) || !is_array($node->{$field_name})) {
    return '';
  }
  foreach ($node->{$field_name} as $lang => $items) {
    if (isset($items[0]['value'])) {
      return $items[0]['value'];
    }
  }
  return '';
}

function ops_api_set_node_field_first_value(&$node, $field_name, $value) {
  $lang = LANGUAGE_NONE;
  if (!empty($node->{$field_name}) && is_array($node->{$field_name})) {
    $langs = array_keys($node->{$field_name});
    if (!empty($langs[0])) {
      $lang = $langs[0];
    }
  }
  $node->{$field_name}[$lang][0]['value'] = $value;
}


/**
 * Header JSON + CORS.
 */
function ops_api_send_headers() {
  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');
  drupal_add_http_header('Access-Control-Allow-Origin', variable_get('ops_api_cors_origin', '*'));
  drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
}

/**
 * Trả JSON response.
 */
function ops_api_response($data = array(), $status_code = 200) {
  ops_api_set_status_header($status_code);

  // Dọn output buffer trước khi trả JSON để app Flutter không gặp lỗi
  // "API trả về dữ liệu không hợp lệ" do HTML/warning/khoảng trắng lẫn vào response.
  if (function_exists('ob_get_length') && ob_get_length()) {
    @ob_clean();
  }

  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');
  drupal_json_output($data);
  drupal_exit();
}

/**
 * Trả JSON lỗi.
 */
function ops_api_error($message, $status_code = 400, $content = array()) {
  $response = array(
    'success' => FALSE,
    'message' => $message,
    'error' => $message,
  );

  if (!empty($content)) {
    $response['content'] = $content;
  }

  ops_api_response($response, $status_code);
}

/**
 * Set HTTP status.
 */
function ops_api_set_status_header($status_code) {
  $messages = array(
    200 => 'OK',
    400 => 'Bad Request',
    401 => 'Unauthorized',
    403 => 'Forbidden',
    405 => 'Method Not Allowed',
    500 => 'Internal Server Error',
  );

  $text = isset($messages[$status_code]) ? $messages[$status_code] : 'OK';
  drupal_add_http_header('Status', $status_code . ' ' . $text);
}
