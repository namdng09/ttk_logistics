}

/**
 * Danh mục chi phí mặc định dùng chung cho bảng chi phí kế hoạch.
 */
function ke_hoach_xep_xe_update_7019() {
  $schema = ke_hoach_xep_xe_schema();
  if (!db_table_exists('ke_hoach_chi_phi_mau')) {
    db_create_table('ke_hoach_chi_phi_mau', $schema['ke_hoach_chi_phi_mau']);
  }

  $existing = (int) db_query("SELECT COUNT(*) FROM {ke_hoach_chi_phi_mau}")->fetchField();
  if ($existing) return 'Đã tạo bảng danh mục chi phí mặc định.';

  $items = array(
    'Số tiền hạ', 'Số tiền hạ sớm', 'Kiểm hóa', 'Số tiền phát sinh',
    'Thưởng lễ', 'Neo xe', 'Vé cầu đường', 'Mua đồ xe+ sửa chửa',
    'Lấp vỏ', 'Hạ cảng đổi biển số', 'Phát sinh thêm', 'Đổ dầu ngoài',
    'Xét xe+mooc', 'Vá vỏ+ Rửa xe', 'Công an', 'Qua cửa khẩu',
  );
  $now = date('Y-m-d H:i:s', REQUEST_TIME);
  foreach ($items as $index => $ten) {
    db_insert('ke_hoach_chi_phi_mau')->fields(array(
      'ten' => $ten,
      'loai_chi_phi' => $ten === 'Qua cửa khẩu' ? 'lai_xe_tu_chiu' : 'cong_ty_chi_tra',
      'thu_tu' => $index + 1,
      'created' => $now,
      'changed' => $now,
      'hoat_dong' => 1,
    ))->execute();
  }
  return 'Đã tạo và nạp danh mục chi phí mặc định.';
}

