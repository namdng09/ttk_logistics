function ke_hoach_xep_xe_update_7009() {
  $schema = ke_hoach_xep_xe_schema();
  $tables = array('ke_hoach_tuyen_xa_chang', 'ke_hoach_tuyen_xa_dau');
  foreach ($tables as $table) {
    if (!db_table_exists($table)) {
      db_create_table($table, $schema[$table]);
    }
  }

  return 'Đã tạo các bảng con cho kế hoạch tuyến xa.';
}

function ke_hoach_xep_xe_update_7010() {
  $date_fields = array(
    'ke_hoach_xep_xe' => array('ngay_bat_dau', 'ngay_ket_thuc', 'cut_off'),
    'ke_hoach_tuyen_xa_chang' => array('ngay_di', 'ngay_den'),
    'ke_hoach_tuyen_xa_chi_phi' => array('ngay'),
    'ke_hoach_tuyen_xa_dau' => array('ngay'),
  );

  foreach ($date_fields as $table => $fields) {
    if (!db_table_exists($table)) {
      continue;
    }
    foreach ($fields as $field) {
      if (db_field_exists($table, $field)) {
        db_query("UPDATE {" . $table . "} SET {" . $field . "} = SUBSTRING({" . $field . "}, 1, 10) WHERE {" . $field . "} IS NOT NULL AND {" . $field . "} <> ''");
      }
    }
  }

  if (db_field_exists('ke_hoach_xep_xe', 'ngay_bat_dau')) {
    db_change_field('ke_hoach_xep_xe', 'ngay_bat_dau', 'ngay_bat_dau', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_xep_xe', 'ngay_ket_thuc')) {
    db_change_field('ke_hoach_xep_xe', 'ngay_ket_thuc', 'ngay_ket_thuc', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_xep_xe', 'cut_off')) {
    db_change_field('ke_hoach_xep_xe', 'cut_off', 'cut_off', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_tuyen_xa_chang', 'ngay_di')) {
    db_change_field('ke_hoach_tuyen_xa_chang', 'ngay_di', 'ngay_di', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_tuyen_xa_chang', 'ngay_den')) {
    db_change_field('ke_hoach_tuyen_xa_chang', 'ngay_den', 'ngay_den', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_tuyen_xa_chi_phi', 'ngay')) {
    db_change_field('ke_hoach_tuyen_xa_chi_phi', 'ngay', 'ngay', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }
  if (db_field_exists('ke_hoach_tuyen_xa_dau', 'ngay')) {
    db_change_field('ke_hoach_tuyen_xa_dau', 'ngay', 'ngay', array('type' => 'varchar', 'length' => 10, 'not null' => FALSE));
  }

  return 'Đã chuẩn hoá toàn bộ ngày của kế hoạch tuyến xa về định dạng date-only.';
}

