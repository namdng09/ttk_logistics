function ke_hoach_xep_xe_update_7016() {
  $schema = ke_hoach_xep_xe_schema();
  if (!db_table_exists('ke_hoach_chi_phi')) {
    db_create_table('ke_hoach_chi_phi', $schema['ke_hoach_chi_phi']);
  }

  if (!db_table_exists('ke_hoach_tuyen_xa_chi_phi')) {
    return 'Đã tạo bảng ke_hoach_chi_phi. Không có bảng chi phí tuyến xa cũ để migrate.';
  }

  $count_new = db_query("SELECT COUNT(*) FROM {ke_hoach_chi_phi}")->fetchField();
  if ((int) $count_new > 0) {
    db_drop_table('ke_hoach_tuyen_xa_chi_phi');
    return 'Đã tạo bảng ke_hoach_chi_phi. Bỏ qua migrate vì bảng mới đã có dữ liệu.';
  }

  $rows = db_query("
    SELECT c.*, kh.loai_ke_hoach, kh.nid_lai_xe
    FROM {ke_hoach_tuyen_xa_chi_phi} c
    LEFT JOIN {ke_hoach_xep_xe} kh ON kh.nid = c.ke_hoach_id
    WHERE c.hoat_dong = 1
    ORDER BY c.id ASC
  ")->fetchAll();

  $now = date('Y-m-d H:i:s', REQUEST_TIME);
  $migrated = 0;
  foreach ($rows as $row) {
    $amount = !empty($row->so_tien) ? (int) $row->so_tien : 0;
    $legacy_json = array(
      'legacy_table' => 'ke_hoach_tuyen_xa_chi_phi',
      'legacy_id' => !empty($row->id) ? (int) $row->id : 0,
      'legacy_chang_id' => !empty($row->chang_id) ? (int) $row->chang_id : 0,
      'ngay' => !empty($row->ngay) ? (string) $row->ngay : '',
      'is_co_dinh' => !empty($row->is_co_dinh) ? 1 : 0,
    );
    if (!empty($row->thong_tin_json)) {
      $decoded = json_decode((string) $row->thong_tin_json, TRUE);
      $legacy_json['legacy_thong_tin_json'] = is_array($decoded) ? $decoded : (string) $row->thong_tin_json;
    }

    db_insert('ke_hoach_chi_phi')
      ->fields(array(
        'nid_ke_hoach' => !empty($row->ke_hoach_id) ? (int) $row->ke_hoach_id : 0,
        'loai_ke_hoach' => !empty($row->loai_ke_hoach) ? (string) $row->loai_ke_hoach : 'tuyen_xa',
        'nid_lai_xe' => !empty($row->nid_lai_xe) ? (int) $row->nid_lai_xe : 0,
        'loai_chi_phi' => !empty($row->loai_chi_phi) ? (string) $row->loai_chi_phi : '',
        'ten_chi_phi' => !empty($row->ten_chi_phi) ? (string) $row->ten_chi_phi : '',
        'don_gia' => $amount,
        'so_luong' => 1,
        'tong_truoc_vat' => $amount,
        'vat_percent' => 0,
        'tong_sau_vat' => $amount,
        'trang_thai_duyet' => 'khong_can_duyet',
        'nid_de_nghi_chi_phi' => 0,
        'nid_ledger' => 0,
        'ghi_chu' => '',
        'thong_tin_json' => json_encode($legacy_json),
        'created' => !empty($row->created) ? (string) $row->created : $now,
        'changed' => !empty($row->changed) ? (string) $row->changed : $now,
        'hoat_dong' => 1,
      ))
      ->execute();
    $migrated++;
  }

  db_drop_table('ke_hoach_tuyen_xa_chi_phi');

  return 'Đã tạo bảng ke_hoach_chi_phi, migrate ' . $migrated . ' chi phí tuyến xa cũ và xoá bảng ke_hoach_tuyen_xa_chi_phi.';
}

