function ke_hoach_xep_xe_theme() {
  $path = drupal_get_path('module', 'ke_hoach_xep_xe') . '/templates';
  return array(
    'ke_hoach_xep_xe_list_page' => array(
      'template' => 'ke-hoach-xep-xe-list',
      'path' => $path,
    ),
    'ke_hoach_xep_xe_form_page' => array(
      'template' => 'ke-hoach-xep-xe-form',
      'path' => $path,
      'variables' => array('mode' => 'create', 'data' => NULL),
    ),
    'ke_hoach_xep_xe_edit_page' => array(
      'template' => 'ke-hoach-xep-xe-edit',
      'path' => $path,
      'variables' => array('mode' => 'edit', 'data' => NULL),
    ),
    'ke_hoach_xep_xe_detail_page' => array(
      'template' => 'ke-hoach-xep-xe-detail',
      'path' => $path,
      'variables' => array('mode' => 'detail', 'data' => NULL),
    ),
    'ke_hoach_cont_list_page' => array(
      'template' => 'ke-hoach-cont-list',
      'path' => $path,
      'variables' => array('mode' => 'overall'),
    ),
    'ke_hoach_cont_overall_page' => array(
      'template' => 'ke-hoach-cont-overall-list',
      'path' => $path,
      'variables' => array('mode' => 'overall'),
    ),
  );
}

function _ke_hoach_xep_xe_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

function _ke_hoach_xep_xe_now() {
  return date('Y-m-d H:i:s', REQUEST_TIME);
}

function _ke_hoach_xep_xe_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _ke_hoach_xep_xe_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _ke_hoach_xep_xe_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

function _ke_hoach_xep_xe_hinh_thuc_options() {
  return array('cat_keo', 'cat_keo_cheo', 'tha_mooc', 'rut_mooc', 'dong_hang_trong_ngay');
}

function _ke_hoach_xep_xe_default_record() {
  return array(
    'ngay' => '',
    'nid_khach_hang' => 0,
    'nid_lai_xe' => 0,
    'so_bkg' => '',
    'dia_chi_kho' => '',
    'loai_cont' => '',
    'so_cont' => '',
    'nid_phuong_tien' => 0,
    'nid_mooc' => 0,
    'so_seal_chinh' => '',
    'so_seal_tam' => '',
    'trang_thai_van_chuyen' => 'Chưa xếp xe',
    'bai_lay_cont' => '',
    'bai_ha_cont' => '',
    'cang_xuat' => '',
    'cut_off' => '',
    'hinh_thuc_van_tai' => '',
    'ke_hoach_cont_ref_nid' => 0,
    'da_cat_mooc' => 0,
    'da_du_hang' => 0,
    'ha_bai_ngoai' => 0,
    'ha_cang' => 0,
    'thong_tin_json' => '',
  );
}

function _ke_hoach_xep_xe_json_decode($value) {
  $data = json_decode((string) $value, TRUE);
  return is_array($data) ? $data : array();
}

function _ke_hoach_xep_xe_json_encode(array $data) {
  $options = defined('JSON_UNESCAPED_UNICODE') ? JSON_UNESCAPED_UNICODE : 0;
  return json_encode($data, $options);
}

function _ke_hoach_xep_xe_build_record($common, $line) {
  $record = _ke_hoach_xep_xe_default_record();
  $record['ngay'] = !empty($common['ngay']) ? trim($common['ngay']) : '';
  $record['nid_khach_hang'] = !empty($common['nid_khach_hang']) ? (int) $common['nid_khach_hang'] : 0;
  $record['so_bkg'] = !empty($line['so_bkg']) ? trim($line['so_bkg']) : '';
  $record['nid_lai_xe'] = !empty($line['nid_lai_xe']) ? (int) $line['nid_lai_xe'] : 0;
  $record['nid_phuong_tien'] = !empty($line['nid_phuong_tien']) ? (int) $line['nid_phuong_tien'] : 0;
  $record['nid_mooc'] = !empty($line['nid_mooc']) ? (int) $line['nid_mooc'] : 0;
  $record['dia_chi_kho'] = !empty($line['dia_chi_kho']) ? trim($line['dia_chi_kho']) : '';
  $record['loai_cont'] = !empty($line['loai_cont']) ? trim($line['loai_cont']) : '';
  $record['so_cont'] = !empty($line['so_cont']) ? trim($line['so_cont']) : '';
  $record['so_seal_chinh'] = !empty($line['so_seal_chinh']) ? trim($line['so_seal_chinh']) : '';
  $record['so_seal_tam'] = !empty($line['so_seal_tam']) ? trim($line['so_seal_tam']) : '';
  $record['trang_thai_van_chuyen'] = !empty($line['trang_thai_van_chuyen']) ? trim($line['trang_thai_van_chuyen']) : 'Chưa xếp xe';
  $record['bai_lay_cont'] = !empty($line['bai_lay_cont']) ? trim($line['bai_lay_cont']) : '';
  $record['bai_ha_cont'] = !empty($line['bai_ha_cont']) ? trim($line['bai_ha_cont']) : '';
  $record['cang_xuat'] = !empty($line['cang_xuat']) ? trim($line['cang_xuat']) : '';
  $record['cut_off'] = !empty($line['cut_off']) ? trim($line['cut_off']) : '';
  $record['hinh_thuc_van_tai'] = !empty($line['hinh_thuc_van_tai']) ? trim($line['hinh_thuc_van_tai']) : '';
  $record['ke_hoach_cont_ref_nid'] = !empty($line['ke_hoach_cont_ref_nid']) ? (int) $line['ke_hoach_cont_ref_nid'] : 0;
  $record['da_cat_mooc'] = !empty($line['da_cat_mooc']) ? 1 : 0;
  $record['da_du_hang'] = !empty($line['da_du_hang']) ? 1 : 0;
  $record['ha_bai_ngoai'] = !empty($line['ha_bai_ngoai']) ? 1 : 0;
  $record['ha_cang'] = !empty($line['ha_cang']) ? 1 : 0;
  $json = !empty($line['thong_tin_json']) && is_array($line['thong_tin_json']) ? $line['thong_tin_json'] : array();
  if (isset($line['ghi_chu'])) {
    $json['ghi_chu'] = trim((string) $line['ghi_chu']);
  }
  $record['thong_tin_json'] = !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '';
  return $record;
}

function _ke_hoach_xep_xe_validate_common($input) {
  if (empty($input['nid_khach_hang'])) {
    return _ke_hoach_xep_xe_fail('Khách hàng bắt buộc');
  }
  return NULL;
}

function _ke_hoach_xep_xe_validate_lines($items) {
  if (empty($items) || !is_array($items)) {
    return _ke_hoach_xep_xe_fail('Danh sách phương tiện bắt buộc');
  }

  $seen_vehicle = array();
  $seen_driver = array();
  $allowed = _ke_hoach_xep_xe_hinh_thuc_options();

  foreach ($items as $index => $item) {
    $line_no = $index + 1;
    if (empty($item['so_bkg'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số BKG bắt buộc');
    }
    if (empty($item['nid_phuong_tien'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': phương tiện bắt buộc');
    }
    if (empty($item['so_cont'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số cont bắt buộc');
    }
    if (empty($item['nid_lai_xe'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': lái xe bắt buộc');
    }

    $vehicle_id = (int) $item['nid_phuong_tien'];
    $driver_id = (int) $item['nid_lai_xe'];
    if (isset($seen_vehicle[$vehicle_id])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': phương tiện đã được chọn ở dòng khác');
    }
    if (isset($seen_driver[$driver_id])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': lái xe đã được chọn ở dòng khác');
    }
    $seen_vehicle[$vehicle_id] = TRUE;
    $seen_driver[$driver_id] = TRUE;

    if (!empty($item['hinh_thuc_van_tai']) && !in_array($item['hinh_thuc_van_tai'], $allowed)) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải không hợp lệ');
    }
  }

  return NULL;
}

function _ke_hoach_xep_xe_enrich_row($row) {
  $result = (array) $row;
  $nid_khach_hang = !empty($result['nid_khach_hang']) ? (int) $result['nid_khach_hang'] : 0;
  $nid_lai_xe = !empty($result['nid_lai_xe']) ? (int) $result['nid_lai_xe'] : 0;
  $nid_phuong_tien = !empty($result['nid_phuong_tien']) ? (int) $result['nid_phuong_tien'] : 0;
  $nid_mooc = !empty($result['nid_mooc']) ? (int) $result['nid_mooc'] : 0;

  if ($nid_khach_hang) {
    $kh = db_query("SELECT nid, ten, ma_kh, phan_loai, cccd_mst, sdt, dia_chi, dob, ghi_chu FROM {khach_hang} WHERE nid = :nid", array(':nid' => $nid_khach_hang))->fetch();
    $result['khach_hang'] = $kh ? (array) $kh : NULL;
  }
  else {
    $result['khach_hang'] = NULL;
  }

  if ($nid_lai_xe) {
    $lx = db_query("SELECT nid, ten, ma_nhan_vien, sdt, cccd, so_bang_lai, loai_bang_lai, han_bang_lai FROM {lai_xe} WHERE nid = :nid", array(':nid' => $nid_lai_xe))->fetch();
    $result['lai_xe'] = $lx ? (array) $lx : NULL;
  }
  else {
    $result['lai_xe'] = NULL;
  }

  if ($nid_phuong_tien) {
    $pt = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_phuong_tien))->fetch();
    $result['phuong_tien'] = $pt ? (array) $pt : NULL;
  }
  else {
    $result['phuong_tien'] = NULL;
  }

  if ($nid_mooc) {
    $mooc = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_mooc))->fetch();
    $result['mooc'] = $mooc ? (array) $mooc : NULL;
  }
  elseif ($nid_phuong_tien && module_exists('phuong_tien_mooc') && db_table_exists('phuong_tien_mooc')) {
    $mooc = db_query("SELECT m.nid, m.bks, m.ma_tai_san, m.loai_phuong_tien, m.hang_xe, m.nam_san_xuat
      FROM {phuong_tien_mooc} ptm
      INNER JOIN {phuong_tien} m ON ptm.nid_mooc = m.nid
      WHERE ptm.nid_dau_keo = :nid AND ptm.hoat_dong = 1
      ORDER BY ptm.id DESC", array(':nid' => $nid_phuong_tien))->fetch();
    $result['mooc'] = $mooc ? (array) $mooc : NULL;
  }
  else {
    $result['mooc'] = NULL;
  }

  if (!empty($result['ke_hoach_cont_ref_nid'])) {
    $ref = db_query("SELECT nid, so_cont, so_bkg, dia_chi_kho, da_cat_mooc, da_du_hang, ha_bai_ngoai, ha_cang FROM {ke_hoach_xep_xe} WHERE nid = :nid", array(':nid' => $result['ke_hoach_cont_ref_nid']))->fetch();
    $result['cont_ref'] = $ref ? (array) $ref : NULL;
  }
  else {
    $result['cont_ref'] = NULL;
  }

  $result['is_cont_keo_ve'] = (bool) db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :nid AND hoat_dong = 1", array(':nid' => $result['nid']))->fetchField();
  $json = _ke_hoach_xep_xe_json_decode(isset($result['thong_tin_json']) ? $result['thong_tin_json'] : '');
  $result['ghi_chu'] = !empty($json['ghi_chu']) ? $json['ghi_chu'] : '';
  $result['hinh_thuc_status_text'] = _ke_hoach_xep_xe_hinh_thuc_status_text($result);
  unset($result['nid_khach_hang'], $result['nid_lai_xe'], $result['nid_phuong_tien'], $result['nid_mooc']);

  return $result;
}

function _ke_hoach_xep_xe_apply_cont_logic(&$record) {
  $record['da_cat_mooc'] = in_array($record['hinh_thuc_van_tai'], array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE) ? 1 : 0;
  if ($record['hinh_thuc_van_tai'] === 'dong_hang_trong_ngay') {
    $record['da_du_hang'] = 1;
  }
}

function _ke_hoach_xep_xe_hinh_thuc_status_text($row) {
  if (!empty($row['is_cont_keo_ve']) || (!empty($row['hinh_thuc_van_tai']) && $row['hinh_thuc_van_tai'] === 'dong_hang_trong_ngay')) {
    return 'Kéo về';
  }
  if (!empty($row['hinh_thuc_van_tai']) && in_array($row['hinh_thuc_van_tai'], array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE)) {
    return 'Kéo lên';
  }
  return '';
}

function _ke_hoach_xep_xe_statuses() {
  return array(
    'Chưa xếp xe',
    'Đi lấy cont',
    'Đang đến kho',
    'Thả mooc',
    'Đóng hàng',
    'Kéo về trong ngày',
    'Hạ cảng',
    'Hoàn thành',
  );
}

function ke_hoach_xep_xe_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_list();
    case 'POST':
      return _ke_hoach_xep_xe_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function _ke_hoach_xep_xe_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->fields('kh');
  $query->condition('kh.hoat_dong', 1);

  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.dia_chi_kho', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.bai_lay_cont', $like, 'LIKE')
      ->condition('kh.bai_ha_cont', $like, 'LIKE')
      ->condition('kh.cang_xuat', $like, 'LIKE');
    $query->condition($or);
  }
  if (!empty($_GET['trang_thai_van_chuyen'])) {
    $query->condition('kh.trang_thai_van_chuyen', $_GET['trang_thai_van_chuyen']);
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('kh.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $items = array();
  foreach ($rows as $row) {
    $items[] = _ke_hoach_xep_xe_enrich_row($row);
  }

  $total_pages = (int) ceil($total / $limit);
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _ke_hoach_xep_xe_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch');
  }

  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_xep_xe_validate_common($input);
  if ($validation) {
    return $validation;
  }
  $line_validation = _ke_hoach_xep_xe_validate_lines(isset($input['items']) ? $input['items'] : array());
  if ($line_validation) {
    return $line_validation;
  }

  $created_ids = array();

  $transaction = db_transaction();
  try {
    foreach ($input['items'] as $index => $line) {
      $record = _ke_hoach_xep_xe_build_record($input, $line);
      _ke_hoach_xep_xe_apply_cont_logic($record);
      $nid = db_insert('ke_hoach_xep_xe')
        ->fields(array(
          'ngay' => $record['ngay'],
          'nid_khach_hang' => $record['nid_khach_hang'],
          'nid_lai_xe' => $record['nid_lai_xe'],
          'so_bkg' => $record['so_bkg'],
          'dia_chi_kho' => $record['dia_chi_kho'],
          'loai_cont' => $record['loai_cont'],
          'so_cont' => $record['so_cont'],
          'nid_phuong_tien' => $record['nid_phuong_tien'],
          'nid_mooc' => $record['nid_mooc'],
          'so_seal_chinh' => $record['so_seal_chinh'],
          'so_seal_tam' => $record['so_seal_tam'],
          'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
          'bai_lay_cont' => $record['bai_lay_cont'],
          'bai_ha_cont' => $record['bai_ha_cont'],
          'cang_xuat' => $record['cang_xuat'],
          'cut_off' => $record['cut_off'],
          'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
          'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
          'da_cat_mooc' => $record['da_cat_mooc'],
          'da_du_hang' => $record['da_du_hang'],
          'ha_bai_ngoai' => $record['ha_bai_ngoai'],
          'ha_cang' => $record['ha_cang'],
          'thong_tin_json' => $record['thong_tin_json'],
          'created' => _ke_hoach_xep_xe_now(),
          'changed' => _ke_hoach_xep_xe_now(),
          'hoat_dong' => 1,
        ))
        ->execute();
      $created_ids[] = (int) $nid;
    }

    watchdog('ke_hoach_xep_xe', 'Tạo đợt kế hoạch gồm %count dòng', array(
      '%count' => count($created_ids),
    ));

    return _ke_hoach_xep_xe_success(array(
      'created_ids' => $created_ids,
      'created_count' => count($created_ids),
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi tạo nhóm kế hoạch: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi tạo kế hoạch');
  }
}

function ke_hoach_xep_xe_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    case 'PUT':
      return _ke_hoach_xep_xe_rest_update($id);
    case 'DELETE':
      return _ke_hoach_xep_xe_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

function _ke_hoach_xep_xe_rest_get($id) {
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

function _ke_hoach_xep_xe_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch');
  }

  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  $input = _ke_hoach_xep_xe_input();
  $common_validation = _ke_hoach_xep_xe_validate_common($input);
  if ($common_validation) {
    return $common_validation;
  }

  $line = isset($input['item']) && is_array($input['item']) ? $input['item'] : $input;
  $line_validation = _ke_hoach_xep_xe_validate_lines(array($line));
  if ($line_validation) {
    return $line_validation;
  }

  $record = _ke_hoach_xep_xe_build_record($input, $line);
  _ke_hoach_xep_xe_apply_cont_logic($record);

  $transaction = db_transaction();
  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array(
        'ngay' => $record['ngay'],
        'nid_khach_hang' => $record['nid_khach_hang'],
        'nid_lai_xe' => $record['nid_lai_xe'],
        'so_bkg' => $record['so_bkg'],
        'dia_chi_kho' => $record['dia_chi_kho'],
        'loai_cont' => $record['loai_cont'],
        'so_cont' => $record['so_cont'],
        'nid_phuong_tien' => $record['nid_phuong_tien'],
        'nid_mooc' => $record['nid_mooc'],
        'so_seal_chinh' => $record['so_seal_chinh'],
        'so_seal_tam' => $record['so_seal_tam'],
        'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
        'bai_lay_cont' => $record['bai_lay_cont'],
        'bai_ha_cont' => $record['bai_ha_cont'],
        'cang_xuat' => $record['cang_xuat'],
        'cut_off' => $record['cut_off'],
        'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
        'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
        'da_cat_mooc' => $record['da_cat_mooc'],
        'da_du_hang' => $record['da_du_hang'],
        'ha_bai_ngoai' => $record['ha_bai_ngoai'],
        'ha_cang' => $record['ha_cang'],
        'thong_tin_json' => $record['thong_tin_json'],
        'changed' => _ke_hoach_xep_xe_now(),
      ))
      ->condition('nid', $id)
      ->execute();

    if (!empty($record['ke_hoach_cont_ref_nid'])) {
      db_update('ke_hoach_xep_xe')
        ->fields(array('changed' => _ke_hoach_xep_xe_now()))
        ->condition('nid', $record['ke_hoach_cont_ref_nid'])
        ->execute();
    }

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
    watchdog('ke_hoach_xep_xe', 'Cập nhật kế hoạch #%id', array('%id' => $id));
    return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi cập nhật kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch');
  }
}

function _ke_hoach_xep_xe_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá kế hoạch');
  }

  $existing = db_query("SELECT nid, so_bkg FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
      ->condition('nid', $id)
      ->execute();

    watchdog('ke_hoach_xep_xe', 'Xoá (soft) kế hoạch #%id: %bkg', array(
      '%id' => $id,
      '%bkg' => $existing->so_bkg,
    ));

    return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    watchdog('ke_hoach_xep_xe', 'Lỗi xoá kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi xoá kế hoạch');
  }
}

function ke_hoach_cont_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_cont_rest_list();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET');
  }
}

function ke_hoach_cont_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'PUT':
      return _ke_hoach_cont_rest_update($id);
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT');
  }
}

function _ke_hoach_cont_rest_list() {
  $query = db_select('ke_hoach_xep_xe', 'kh')->fields('kh')->condition('kh.hoat_dong', 1)->orderBy('kh.nid', 'DESC');
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $query->condition(db_or()->condition('kh.so_bkg', $like, 'LIKE')->condition('kh.so_cont', $like, 'LIKE')->condition('kh.dia_chi_kho', $like, 'LIKE'));
  }
  if (!empty($_GET['nid_khach_hang'])) {
    $query->condition('kh.nid_khach_hang', (int) $_GET['nid_khach_hang']);
  }
  if (!empty($_GET['dia_chi_kho'])) {
    $query->condition('kh.dia_chi_kho', $_GET['dia_chi_kho']);
  }
  if (!empty($_GET['bai_lay_cont'])) {
    $query->condition('kh.bai_lay_cont', $_GET['bai_lay_cont']);
  }
  if (!empty($_GET['bai_ha_cont'])) {
    $query->condition('kh.bai_ha_cont', $_GET['bai_ha_cont']);
  }
  if (!empty($_GET['hinh_thuc_van_tai'])) {
    $query->condition('kh.hinh_thuc_van_tai', $_GET['hinh_thuc_van_tai']);
  }
  if (isset($_GET['da_cat_mooc']) && $_GET['da_cat_mooc'] !== '') {
    $query->condition('kh.da_cat_mooc', (int) $_GET['da_cat_mooc']);
  }
  if (isset($_GET['da_du_hang']) && $_GET['da_du_hang'] !== '') {
    $query->condition('kh.da_du_hang', (int) $_GET['da_du_hang']);
  }
  $items = array();
  foreach ($query->execute()->fetchAll() as $row) {
    $enriched = _ke_hoach_xep_xe_enrich_row($row);
    $enriched['trang_thai_cont'] = !empty($enriched['ha_cang']) ? 'Hạ cảng' : (!empty($enriched['ha_bai_ngoai']) ? 'Hạ bãi ngoài' : (!empty($enriched['da_du_hang']) ? 'Đủ hàng' : (!empty($enriched['ke_hoach_cont_ref_nid']) ? 'Kéo về' : (!empty($enriched['da_cat_mooc']) ? 'Đã cắt mooc' : 'Chưa cắt mooc'))));
    $items[] = $enriched;
  }
  return _ke_hoach_xep_xe_success(array('items' => $items, 'total' => count($items), 'current_page' => 1, 'total_pages' => 1));
}

function _ke_hoach_cont_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật quản lý cont');
  }
  $input = _ke_hoach_xep_xe_input();
  $fields = array('da_du_hang', 'ha_bai_ngoai', 'ha_cang');
  $update = array('changed' => _ke_hoach_xep_xe_now());
  foreach ($fields as $field) {
    if (array_key_exists($field, $input)) {
      $update[$field] = !empty($input[$field]) ? 1 : 0;
    }
  }
  if (array_key_exists('ghi_chu', $input)) {
    $existing = db_query("SELECT thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $json = _ke_hoach_xep_xe_json_decode($existing);
    $json['ghi_chu'] = trim((string) $input['ghi_chu']);
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
  }
  if (count($update) === 1) {
    return _ke_hoach_xep_xe_fail('Không có dữ liệu cập nhật');
  }
  db_update('ke_hoach_xep_xe')->fields($update)->condition('nid', $id)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

function ke_hoach_xep_xe_page_list() {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'statuses' => _ke_hoach_xep_xe_statuses(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  return theme('ke_hoach_xep_xe_list_page');
}

function ke_hoach_cont_page_list($mode = 'overall') {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));
  drupal_add_js(array('ke_hoach_cont' => array('mode' => $mode)), 'setting');
  if ($mode === 'cat_mooc') {
    return theme('ke_hoach_cont_list_page', array('mode' => $mode));
  }
  return theme('ke_hoach_cont_overall_page', array('mode' => $mode));
}

function ke_hoach_xep_xe_page_form($id = NULL) {
  if (!$id) {
    drupal_goto('ke-hoach-xep-xe');
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  $data = NULL;
  $mode = 'create';
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }
  $data = _ke_hoach_xep_xe_enrich_row($row);
  $mode = 'edit';

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'mode' => $mode,
    'data' => $data,
    'statuses' => _ke_hoach_xep_xe_statuses(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  if ($mode === 'edit') {
    return theme('ke_hoach_xep_xe_edit_page', array('mode' => $mode, 'data' => $data));
  }

  return theme('ke_hoach_xep_xe_form_page', array('mode' => $mode, 'data' => $data));
}

function ke_hoach_xep_xe_page_detail($id) {
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  $data = _ke_hoach_xep_xe_enrich_row($row);
  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'mode' => 'detail',
    'data' => $data,
    'permissions' => array(
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
