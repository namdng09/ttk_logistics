function ke_hoach_xep_xe_theme() {
  $path = drupal_get_path('module', 'ke_hoach_xep_xe') . '/templates';
  return array(
    'ke_hoach_xep_xe_list_page' => array(
      'template' => 'ke-hoach-xep-xe-list',
      'path' => $path,
      'variables' => array('plan_type' => 'thuong'),
    ),
    'ke_hoach_xep_xe_edit_page' => array(
      'template' => 'ke-hoach-xep-xe-edit',
      'path' => $path,
      'variables' => array('mode' => 'edit', 'data' => NULL),
    ),
    'ke_hoach_xep_xe_form_page' => array(
      'template' => 'ke-hoach-xep-xe-form-modal',
      'path' => $path,
      'variables' => array('plan_type' => 'thuong'),
    ),
    'ke_hoach_xep_xe_detail_page' => array(
      'template' => 'ke-hoach-xep-xe-detail',
      'path' => $path,
      'variables' => array('mode' => 'detail', 'data' => NULL),
    ),
    'ke_hoach_tuyen_xa_list_page' => array(
      'template' => 'ke-hoach-tuyen-xa-list',
      'path' => $path,
    ),
    'ke_hoach_cont_list_page' => array(
      'template' => 'ke-hoach-cont-list',
      'path' => $path,
      'variables' => array('mode' => 'overall'),
    ),
    'ke_hoach_cont_overall_page' => array(
      'template' => 'ke-hoach-cont-overall-list',
      'path' => $path,
      'variables' => array('mode' => 'overall'),
    ),
  );
}

function _ke_hoach_xep_xe_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

function _ke_hoach_xep_xe_now() {
  return date('Y-m-d H:i:s', REQUEST_TIME);
}

function _ke_hoach_xep_xe_success($data = NULL) {
  $response = array('status' => 'success');
  if ($data !== NULL) {
    $response['data'] = $data;
  }
  return $response;
}

function _ke_hoach_xep_xe_fail($message) {
  drupal_add_http_header('Status', '400 Bad Request');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_unauthorized($message) {
  drupal_add_http_header('Status', '401 Unauthorized');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_not_found($message) {
  drupal_add_http_header('Status', '404 Not Found');
  return array('status' => 'fail', 'message' => $message);
}

function _ke_hoach_xep_xe_error($message) {
  drupal_add_http_header('Status', '500 Internal Server Error');
  return array('status' => 'error', 'message' => $message);
}

function _ke_hoach_xep_xe_method_not_allowed($allowed) {
  drupal_add_http_header('Status', '405 Method Not Allowed');
  drupal_add_http_header('Allow', $allowed);
  return array('status' => 'fail', 'message' => 'Method không được hỗ trợ. Allowed: ' . $allowed);
}

function _ke_hoach_xep_xe_hinh_thuc_options() {
  return array('cat_keo', 'cat_keo_cheo', 'tha_mooc', 'rut_mooc', 'dong_hang_trong_ngay', 'roi_cont');
}

function _ke_hoach_xep_xe_default_record() {
  return array(
    'ngay' => '',
    'nid_khach_hang' => 0,
    'nid_lai_xe' => 0,
    'so_bkg' => '',
    'dia_chi_kho' => '',
    'loai_cont' => '',
    'so_cont' => '',
    'nid_phuong_tien' => 0,
    'nid_mooc' => 0,
    'so_seal_chinh' => '',
    'so_seal_tam' => '',
    'trang_thai_van_chuyen' => 'Chưa xếp xe',
    'bai_lay_cont' => '',
    'bai_lay_thuc_te' => '',
    'bai_ha_cont' => '',
    'bai_ha_thuc_te' => '',
    'cang_xuat' => '',
    'cut_off' => '',
    'hinh_thuc_van_tai' => '',
    'ke_hoach_cont_ref_nid' => 0,
    'da_cat_mooc' => 0,
    'da_du_hang' => 0,
    'ha_bai_ngoai' => 0,
    'ha_cang' => 0,
    'thong_tin_json' => '',
  );
}

function _ke_hoach_xep_xe_json_decode($value) {
  $data = json_decode((string) $value, TRUE);
  return is_array($data) ? $data : array();
}

function _ke_hoach_xep_xe_json_encode(array $data) {
  $options = defined('JSON_UNESCAPED_UNICODE') ? JSON_UNESCAPED_UNICODE : 0;
  return json_encode($data, $options);
}

function _ke_hoach_xep_xe_build_record($common, $line) {
  $record = _ke_hoach_xep_xe_default_record();
  $record['nid_khach_hang'] = !empty($line['nid_khach_hang']) ? (int) $line['nid_khach_hang'] : (!empty($common['nid_khach_hang']) ? (int) $common['nid_khach_hang'] : 0);
  $record['so_bkg'] = !empty($line['so_bkg']) ? trim($line['so_bkg']) : '';
  $record['nid_lai_xe'] = !empty($line['nid_lai_xe']) ? (int) $line['nid_lai_xe'] : 0;
  $record['nid_phuong_tien'] = !empty($line['nid_phuong_tien']) ? (int) $line['nid_phuong_tien'] : 0;
  $record['nid_mooc'] = !empty($line['nid_mooc']) ? (int) $line['nid_mooc'] : 0;
  $record['dia_chi_kho'] = !empty($line['dia_chi_kho']) ? trim($line['dia_chi_kho']) : '';
  $record['loai_cont'] = !empty($line['loai_cont']) ? trim($line['loai_cont']) : '';
  $record['so_cont'] = !empty($line['so_cont']) ? trim($line['so_cont']) : '';
  $record['so_seal_chinh'] = !empty($line['so_seal_chinh']) ? trim($line['so_seal_chinh']) : '';
  $record['so_seal_tam'] = !empty($line['so_seal_tam']) ? trim($line['so_seal_tam']) : '';
  $record['trang_thai_van_chuyen'] = !empty($line['trang_thai_van_chuyen']) ? trim($line['trang_thai_van_chuyen']) : 'Chưa xếp xe';
  $record['bai_lay_cont'] = !empty($line['bai_lay_cont']) ? trim($line['bai_lay_cont']) : '';
  $record['bai_lay_thuc_te'] = !empty($line['bai_lay_thuc_te']) ? trim($line['bai_lay_thuc_te']) : '';
  if ($record['bai_lay_thuc_te'] === $record['bai_lay_cont']) {
    $record['bai_lay_thuc_te'] = '';
  }
  $record['bai_ha_cont'] = !empty($line['bai_ha_cont']) ? trim($line['bai_ha_cont']) : '';
  $record['bai_ha_thuc_te'] = !empty($line['bai_ha_thuc_te']) ? trim($line['bai_ha_thuc_te']) : '';
  if ($record['bai_ha_thuc_te'] === $record['bai_ha_cont']) {
    $record['bai_ha_thuc_te'] = '';
  }
  $record['cang_xuat'] = !empty($line['cang_xuat']) ? trim($line['cang_xuat']) : '';
  $record['cut_off'] = !empty($line['cut_off']) ? trim($line['cut_off']) : '';
  $record['hinh_thuc_van_tai'] = !empty($line['hinh_thuc_van_tai']) ? trim($line['hinh_thuc_van_tai']) : '';
  $record['ke_hoach_cont_ref_nid'] = !empty($line['ke_hoach_cont_ref_nid']) ? (int) $line['ke_hoach_cont_ref_nid'] : 0;
  $record['da_cat_mooc'] = !empty($line['da_cat_mooc']) ? 1 : 0;
  $record['da_du_hang'] = !empty($line['da_du_hang']) ? 1 : 0;
  $record['ha_bai_ngoai'] = !empty($line['ha_bai_ngoai']) ? 1 : 0;
  $record['ha_cang'] = !empty($line['ha_cang']) ? 1 : 0;
  $json = !empty($line['thong_tin_json']) && is_array($line['thong_tin_json']) ? $line['thong_tin_json'] : array();
  if (isset($line['ghi_chu'])) {
    $json['ghi_chu'] = trim((string) $line['ghi_chu']);
  }
  $record['thong_tin_json'] = !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '';
  return $record;
}

function _ke_hoach_xep_xe_validate_common($input) {
  if (empty($input['nid_khach_hang'])) {
    return _ke_hoach_xep_xe_fail('Khách hàng bắt buộc');
  }
  return NULL;
}

function _ke_hoach_xep_xe_validate_lines($items, $require_vehicle_driver = TRUE, $require_container = TRUE) {
  if (empty($items) || !is_array($items)) {
    return _ke_hoach_xep_xe_fail('Danh sách phương tiện bắt buộc');
  }

  $allowed = _ke_hoach_xep_xe_hinh_thuc_options();

  foreach ($items as $index => $item) {
    $line_no = $index + 1;
    if (empty($item['so_bkg'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số BKG bắt buộc');
    }
    if ($require_vehicle_driver && empty($item['nid_phuong_tien'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': phương tiện bắt buộc');
    }
    if ($require_container && empty($item['so_cont'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số cont bắt buộc');
    }
    if ($require_vehicle_driver && empty($item['nid_lai_xe'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': lái xe bắt buộc');
    }

    if (!empty($item['hinh_thuc_van_tai']) && !in_array($item['hinh_thuc_van_tai'], $allowed)) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải không hợp lệ');
    }
  }

  return NULL;
}

function _ke_hoach_xep_xe_enrich_row($row, $with_related = TRUE) {
  $result = (array) $row;
  $nid_khach_hang = !empty($result['nid_khach_hang']) ? (int) $result['nid_khach_hang'] : 0;
  $nid_lai_xe = !empty($result['nid_lai_xe']) ? (int) $result['nid_lai_xe'] : 0;
  $nid_phuong_tien = !empty($result['nid_phuong_tien']) ? (int) $result['nid_phuong_tien'] : 0;
  $nid_mooc = !empty($result['nid_mooc']) ? (int) $result['nid_mooc'] : 0;

  if ($nid_khach_hang) {
    $kh = db_query("SELECT nid, ten, ma_kh, phan_loai, cccd_mst, sdt, dia_chi, dob, ghi_chu FROM {khach_hang} WHERE nid = :nid", array(':nid' => $nid_khach_hang))->fetch();
    $result['khach_hang'] = $kh ? (array) $kh : NULL;
  }
  else {
    $result['khach_hang'] = NULL;
  }

  if ($nid_lai_xe) {
    $lx = db_query("SELECT nid, ten, ma_nhan_vien, sdt, cccd, so_bang_lai, loai_bang_lai, han_bang_lai FROM {lai_xe} WHERE nid = :nid", array(':nid' => $nid_lai_xe))->fetch();
    $result['lai_xe'] = $lx ? (array) $lx : NULL;
  }
  else {
    $result['lai_xe'] = NULL;
  }

  if ($nid_phuong_tien) {
    $pt = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_phuong_tien))->fetch();
    $result['phuong_tien'] = $pt ? (array) $pt : NULL;
  }
  else {
    $result['phuong_tien'] = NULL;
  }

  if ($nid_mooc) {
    $mooc = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_mooc))->fetch();
    $result['mooc'] = $mooc ? (array) $mooc : NULL;
  }
  elseif ($nid_phuong_tien && module_exists('phuong_tien_mooc') && db_table_exists('phuong_tien_mooc')) {
    $mooc = db_query("SELECT m.nid, m.bks, m.ma_tai_san, m.loai_phuong_tien, m.hang_xe, m.nam_san_xuat
      FROM {phuong_tien_mooc} ptm
      INNER JOIN {phuong_tien} m ON ptm.nid_mooc = m.nid
      WHERE ptm.nid_dau_keo = :nid AND ptm.hoat_dong = 1
      ORDER BY ptm.id DESC", array(':nid' => $nid_phuong_tien))->fetch();
    $result['mooc'] = $mooc ? (array) $mooc : NULL;
  }
  else {
    $result['mooc'] = NULL;
  }

  if ($with_related && !empty($result['ke_hoach_cont_ref_nid'])) {
    $ref = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $result['ke_hoach_cont_ref_nid']))->fetch();
    $result['cont_ref'] = $ref ? _ke_hoach_xep_xe_enrich_row($ref, FALSE) : NULL;
  }
  else {
    $result['cont_ref'] = NULL;
  }

  if ($with_related) {
    $keo_ve = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :nid AND hoat_dong = 1 ORDER BY nid DESC", array(':nid' => $result['nid']))->fetch();
    $result['cont_keo_ve_by'] = $keo_ve ? _ke_hoach_xep_xe_enrich_row($keo_ve, FALSE) : NULL;
    $result['is_cont_keo_ve'] = !empty($result['cont_keo_ve_by']);
  }
  else {
    $result['cont_keo_ve_by'] = NULL;
    $result['is_cont_keo_ve'] = (bool) db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :nid AND hoat_dong = 1", array(':nid' => $result['nid']))->fetchField();
  }
  $json = _ke_hoach_xep_xe_json_decode(isset($result['thong_tin_json']) ? $result['thong_tin_json'] : '');
  $result['ghi_chu'] = !empty($json['ghi_chu']) ? $json['ghi_chu'] : '';
  $result['hinh_thuc_status_text'] = _ke_hoach_xep_xe_hinh_thuc_status_text($result);
  unset($result['nid_khach_hang'], $result['nid_lai_xe'], $result['nid_phuong_tien'], $result['nid_mooc']);

  return $result;
}

function _ke_hoach_xep_xe_apply_cont_logic(&$record) {
  $record['da_cat_mooc'] = in_array($record['hinh_thuc_van_tai'], array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE) ? 1 : 0;
  if ($record['hinh_thuc_van_tai'] === 'dong_hang_trong_ngay') {
    $record['da_du_hang'] = 1;
  }
}

function _ke_hoach_xep_xe_hinh_thuc_status_text($row) {
  if (!empty($row['is_cont_keo_ve']) || (!empty($row['hinh_thuc_van_tai']) && $row['hinh_thuc_van_tai'] === 'dong_hang_trong_ngay')) {
    return 'Kéo về';
  }
  if (!empty($row['hinh_thuc_van_tai']) && in_array($row['hinh_thuc_van_tai'], array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE)) {
    return 'Kéo lên';
  }
  return '';
}

function _ke_hoach_xep_xe_statuses() {
  return array(
    'Chưa xếp xe',
    'Đi lấy cont',
    'Đang đến kho',
    'Thả mooc',
    'Đóng hàng',
    'Kéo về trong ngày',
    'Hạ cảng',
    'Hoàn thành',
  );
}

function _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach = 'thuong', $alias = 'kh') {
  $loai_ke_hoach = $loai_ke_hoach === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
  if ($loai_ke_hoach === 'tuyen_xa') {
    $query->condition($alias . '.loai_ke_hoach', 'tuyen_xa');
    return;
  }
  $or = db_or();
  $or->condition($alias . '.loai_ke_hoach', 'thuong');
  $or->isNull($alias . '.loai_ke_hoach');
  $query->condition($or);
}

function _ke_hoach_xep_xe_query_condition_thuong($query, $alias = 'kh') {
  _ke_hoach_xep_xe_query_condition_loai($query, 'thuong', $alias);
}

function ke_hoach_xep_xe_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_list();
    case 'POST':
      return _ke_hoach_xep_xe_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function _ke_hoach_xep_xe_filter_date($value, $end_of_day = FALSE) {
  $value = trim((string) $value);
  if ($value === '') {
    return '';
  }
  if (preg_match('/^(\d{2})\/(\d{2})\/(\d{4})$/', $value, $m)) {
    return $m[3] . '-' . $m[2] . '-' . $m[1] . ($end_of_day ? ' 23:59:59' : ' 00:00:00');
  }
  if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $m)) {
    return $value . ($end_of_day ? ' 23:59:59' : ' 00:00:00');
  }
  return '';
}

function _ke_hoach_xep_xe_like_condition($query, $field, $param) {
  if (!empty($_GET[$param])) {
    $query->condition($field, '%' . db_like(trim($_GET[$param])) . '%', 'LIKE');
  }
}

function _ke_hoach_xep_xe_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;
  $loai_ke_hoach = !empty($_GET['loai_ke_hoach']) && $_GET['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';

  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->fields('kh');
  $query->condition('kh.hoat_dong', 1);
  _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach, 'kh');

  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.dia_chi_kho', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.bai_lay_cont', $like, 'LIKE')
      ->condition('kh.bai_ha_cont', $like, 'LIKE')
      ->condition('kh.cang_xuat', $like, 'LIKE');
    $query->condition($or);
  }
  if (!empty($_GET['trang_thai_van_chuyen'])) {
    $trang_thai_filter = trim((string) $_GET['trang_thai_van_chuyen']);
    if ($trang_thai_filter === 'Kéo lên') {
      $query->condition('kh.hinh_thuc_van_tai', array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), 'IN');
    }
    elseif ($trang_thai_filter === 'Kéo về') {
      $query->condition(db_or()
        ->condition('kh.ke_hoach_cont_ref_nid', 0, '>')
        ->condition('kh.hinh_thuc_van_tai', 'dong_hang_trong_ngay')
      );
    }
    elseif ($trang_thai_filter === 'Đã cắt mooc') {
      $query->condition('kh.da_cat_mooc', 1);
    }
    else {
      $query->condition('kh.trang_thai_van_chuyen', $trang_thai_filter);
    }
  }
  if (isset($_GET['da_du_hang']) && ($_GET['da_du_hang'] === '0' || $_GET['da_du_hang'] === '1')) {
    $query->condition('kh.da_du_hang', (int) $_GET['da_du_hang']);
  }
  if (!empty($_GET['khach_hang'])) {
    $query->leftJoin('khach_hang', 'khh_filter', 'khh_filter.nid = kh.nid_khach_hang');
    $query->condition('khh_filter.ten', '%' . db_like(trim($_GET['khach_hang'])) . '%', 'LIKE');
  }
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_bkg', 'so_bkg');
  _ke_hoach_xep_xe_like_condition($query, 'kh.dia_chi_kho', 'dia_chi_kho');
  _ke_hoach_xep_xe_like_condition($query, 'kh.loai_cont', 'loai_cont');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_cont', 'so_cont');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_seal_chinh', 'so_seal_chinh');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_seal_tam', 'so_seal_tam');
  if (!empty($_GET['bks_dau_keo'])) {
    $query->leftJoin('phuong_tien', 'pt_filter', 'pt_filter.nid = kh.nid_phuong_tien');
    $query->condition('pt_filter.bks', '%' . db_like(trim($_GET['bks_dau_keo'])) . '%', 'LIKE');
  }
  if (!empty($_GET['bks_mooc'])) {
    $query->leftJoin('phuong_tien', 'mooc_filter', 'mooc_filter.nid = kh.nid_mooc');
    $query->condition('mooc_filter.bks', '%' . db_like(trim($_GET['bks_mooc'])) . '%', 'LIKE');
  }
  $date_from = !empty($_GET['date_from']) ? _ke_hoach_xep_xe_filter_date($_GET['date_from']) : '';
  if ($date_from) {
    $query->condition('kh.created', $date_from, '>=');
  }
  $date_to = !empty($_GET['date_to']) ? _ke_hoach_xep_xe_filter_date($_GET['date_to'], TRUE) : '';
  if ($date_to) {
    $query->condition('kh.created', $date_to, '<=');
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('kh.nid', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $items = array();
  foreach ($rows as $row) {
    $items[] = _ke_hoach_xep_xe_enrich_row($row);
  }

  $total_pages = (int) ceil($total / $limit);
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _ke_hoach_xep_xe_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch');
  }

  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_xep_xe_validate_common($input);
  if ($validation) {
    return $validation;
  }
  $line_validation = _ke_hoach_xep_xe_validate_lines(isset($input['items']) ? $input['items'] : array(), FALSE, FALSE);
  if ($line_validation) {
    return $line_validation;
  }

  $created_ids = array();

  $transaction = db_transaction();
  try {
    foreach ($input['items'] as $index => $line) {
      $record = _ke_hoach_xep_xe_build_record($input, $line);
      $loai_ke_hoach = !empty($input['loai_ke_hoach']) && $input['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
      _ke_hoach_xep_xe_apply_cont_logic($record);
      $nid = db_insert('ke_hoach_xep_xe')
        ->fields(array(
          'nid_khach_hang' => $record['nid_khach_hang'],
          'nid_lai_xe' => $record['nid_lai_xe'],
          'so_bkg' => $record['so_bkg'],
          'dia_chi_kho' => $record['dia_chi_kho'],
          'loai_cont' => $record['loai_cont'],
          'so_cont' => $record['so_cont'],
          'nid_phuong_tien' => $record['nid_phuong_tien'],
          'nid_mooc' => $record['nid_mooc'],
          'so_seal_chinh' => $record['so_seal_chinh'],
          'so_seal_tam' => $record['so_seal_tam'],
          'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
          'bai_lay_cont' => $record['bai_lay_cont'],
          'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
          'bai_ha_cont' => $record['bai_ha_cont'],
          'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
          'cang_xuat' => $record['cang_xuat'],
          'cut_off' => $record['cut_off'],
          'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
          'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
          'da_cat_mooc' => $record['da_cat_mooc'],
          'da_du_hang' => $record['da_du_hang'],
          'ha_bai_ngoai' => $record['ha_bai_ngoai'],
          'ha_cang' => $record['ha_cang'],
          'thong_tin_json' => $record['thong_tin_json'],
          'loai_ke_hoach' => $loai_ke_hoach,
          'created' => _ke_hoach_xep_xe_now(),
          'changed' => _ke_hoach_xep_xe_now(),
          'hoat_dong' => 1,
        ))
        ->execute();
      $created_ids[] = (int) $nid;
    }

    watchdog('ke_hoach_xep_xe', 'Tạo đợt kế hoạch gồm %count dòng', array(
      '%count' => count($created_ids),
    ));

    return _ke_hoach_xep_xe_success(array(
      'created_ids' => $created_ids,
      'created_count' => count($created_ids),
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi tạo nhóm kế hoạch: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi tạo kế hoạch');
  }
}

function ke_hoach_xep_xe_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    case 'PUT':
      return _ke_hoach_xep_xe_rest_update($id);
    case 'DELETE':
      return _ke_hoach_xep_xe_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

function _ke_hoach_xep_xe_rest_get($id) {
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

function _ke_hoach_xep_xe_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch');
  }

  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  $input = _ke_hoach_xep_xe_input();
  $common_validation = _ke_hoach_xep_xe_validate_common($input);
  if ($common_validation) {
    return $common_validation;
  }

  $line = isset($input['item']) && is_array($input['item']) ? $input['item'] : $input;
  $line_validation = _ke_hoach_xep_xe_validate_lines(array($line), FALSE, FALSE);
  if ($line_validation) {
    return $line_validation;
  }

  $record = _ke_hoach_xep_xe_build_record($input, $line);
  _ke_hoach_xep_xe_apply_cont_logic($record);

  $transaction = db_transaction();
  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array(
        'nid_khach_hang' => $record['nid_khach_hang'],
        'nid_lai_xe' => $record['nid_lai_xe'],
        'so_bkg' => $record['so_bkg'],
        'dia_chi_kho' => $record['dia_chi_kho'],
        'loai_cont' => $record['loai_cont'],
        'so_cont' => $record['so_cont'],
        'nid_phuong_tien' => $record['nid_phuong_tien'],
        'nid_mooc' => $record['nid_mooc'],
        'so_seal_chinh' => $record['so_seal_chinh'],
        'so_seal_tam' => $record['so_seal_tam'],
        'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
        'bai_lay_cont' => $record['bai_lay_cont'],
        'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
        'bai_ha_cont' => $record['bai_ha_cont'],
        'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
        'cang_xuat' => $record['cang_xuat'],
        'cut_off' => $record['cut_off'],
        'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
        'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
        'da_cat_mooc' => $record['da_cat_mooc'],
        'da_du_hang' => $record['da_du_hang'],
        'ha_bai_ngoai' => $record['ha_bai_ngoai'],
        'ha_cang' => $record['ha_cang'],
        'thong_tin_json' => $record['thong_tin_json'],
        'changed' => _ke_hoach_xep_xe_now(),
      ))
      ->condition('nid', $id)
      ->execute();

    if (!empty($record['ke_hoach_cont_ref_nid'])) {
      db_update('ke_hoach_xep_xe')
        ->fields(array('changed' => _ke_hoach_xep_xe_now()))
        ->condition('nid', $record['ke_hoach_cont_ref_nid'])
        ->execute();
    }

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
    watchdog('ke_hoach_xep_xe', 'Cập nhật kế hoạch #%id', array('%id' => $id));
    return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi cập nhật kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch');
  }
}

function _ke_hoach_xep_xe_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá kế hoạch');
  }

  $existing = db_query("SELECT nid, so_bkg FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
      ->condition('nid', $id)
      ->execute();

    watchdog('ke_hoach_xep_xe', 'Xoá (soft) kế hoạch #%id: %bkg', array(
      '%id' => $id,
      '%bkg' => $existing->so_bkg,
    ));

    return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    watchdog('ke_hoach_xep_xe', 'Lỗi xoá kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi xoá kế hoạch');
  }
}

function ke_hoach_cont_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_cont_rest_list();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET');
  }
}

function ke_hoach_cont_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'PUT':
      return _ke_hoach_cont_rest_update($id);
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT');
  }
}

function _ke_hoach_cont_rest_list() {
  $loai_ke_hoach = !empty($_GET['loai_ke_hoach']) && $_GET['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
  $query = db_select('ke_hoach_xep_xe', 'kh')->fields('kh')->condition('kh.hoat_dong', 1)->orderBy('kh.nid', 'DESC');
  _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach, 'kh');
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $query->condition(db_or()->condition('kh.so_bkg', $like, 'LIKE')->condition('kh.so_cont', $like, 'LIKE')->condition('kh.dia_chi_kho', $like, 'LIKE'));
  }
  if (!empty($_GET['nid_khach_hang'])) {
    $query->condition('kh.nid_khach_hang', (int) $_GET['nid_khach_hang']);
  }
  if (!empty($_GET['dia_chi_kho'])) {
    $query->condition('kh.dia_chi_kho', $_GET['dia_chi_kho']);
  }
  if (!empty($_GET['bai_lay_cont'])) {
    $query->condition('kh.bai_lay_cont', $_GET['bai_lay_cont']);
  }
  if (!empty($_GET['bai_ha_cont'])) {
    $query->condition('kh.bai_ha_cont', $_GET['bai_ha_cont']);
  }
  if (!empty($_GET['hinh_thuc_van_tai'])) {
    $query->condition('kh.hinh_thuc_van_tai', $_GET['hinh_thuc_van_tai']);
  }
  if (isset($_GET['da_cat_mooc']) && $_GET['da_cat_mooc'] !== '') {
    $query->condition('kh.da_cat_mooc', (int) $_GET['da_cat_mooc']);
  }
  if (!empty($_GET['exclude_nid'])) {
    $query->condition('kh.nid', (int) $_GET['exclude_nid'], '<>');
  }
  if (isset($_GET['da_du_hang']) && $_GET['da_du_hang'] !== '') {
    $query->condition('kh.da_du_hang', (int) $_GET['da_du_hang']);
  }
  $items = array();
  foreach ($query->execute()->fetchAll() as $row) {
    $enriched = _ke_hoach_xep_xe_enrich_row($row);
    $enriched['trang_thai_cont'] = !empty($enriched['ha_cang']) ? 'Hạ cảng' : (!empty($enriched['ha_bai_ngoai']) ? 'Hạ bãi ngoài' : (!empty($enriched['da_du_hang']) ? 'Đủ hàng' : (!empty($enriched['ke_hoach_cont_ref_nid']) ? 'Kéo về' : (!empty($enriched['da_cat_mooc']) ? 'Đã cắt mooc' : 'Chưa cắt mooc'))));
    $items[] = $enriched;
  }
  return _ke_hoach_xep_xe_success(array('items' => $items, 'total' => count($items), 'current_page' => 1, 'total_pages' => 1));
}

function _ke_hoach_cont_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật quản lý cont');
  }
  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch cont không tồn tại');
  }
  $input = _ke_hoach_xep_xe_input();
  $fields = array('da_du_hang', 'ha_bai_ngoai', 'ha_cang');
  $update = array('changed' => _ke_hoach_xep_xe_now());
  foreach ($fields as $field) {
    if (array_key_exists($field, $input)) {
      $update[$field] = !empty($input[$field]) ? 1 : 0;
    }
  }
  if (array_key_exists('bai_lay_thuc_te', $input)) {
    $bai_lay_thuc_te = trim((string) $input['bai_lay_thuc_te']);
    $bai_lay_cont = db_query("SELECT bai_lay_cont FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $update['bai_lay_thuc_te'] = ($bai_lay_thuc_te && $bai_lay_thuc_te !== $bai_lay_cont) ? $bai_lay_thuc_te : '';
  }
  if (array_key_exists('bai_ha_thuc_te', $input)) {
    $bai_ha_thuc_te = trim((string) $input['bai_ha_thuc_te']);
    $bai_ha_cont = db_query("SELECT bai_ha_cont FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $update['bai_ha_thuc_te'] = ($bai_ha_thuc_te && $bai_ha_thuc_te !== $bai_ha_cont) ? $bai_ha_thuc_te : '';
  }
  if (array_key_exists('ghi_chu', $input)) {
    $existing = db_query("SELECT thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $json = _ke_hoach_xep_xe_json_decode($existing);
    $json['ghi_chu'] = trim((string) $input['ghi_chu']);
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
  }
  if (count($update) === 1) {
    return _ke_hoach_xep_xe_fail('Không có dữ liệu cập nhật');
  }
  db_update('ke_hoach_xep_xe')->fields($update)->condition('nid', $id)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

function ke_hoach_xep_xe_page_list() {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'plan_type' => 'thuong',
    'list_title' => 'Danh sách kế hoạch xếp xe',
    'create_title' => 'Tạo kế hoạch xếp xe',
    'create_button_text' => 'Tạo kế hoạch',
    'statuses' => _ke_hoach_xep_xe_statuses(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  return theme('ke_hoach_xep_xe_list_page', array('plan_type' => 'thuong'));
}

function ke_hoach_cont_page_list($mode = 'overall') {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));
  drupal_add_js(array('ke_hoach_cont' => array('mode' => $mode)), 'setting');
  if ($mode === 'cat_mooc') {
    return theme('ke_hoach_cont_list_page', array('mode' => $mode));
  }
  return theme('ke_hoach_cont_overall_page', array('mode' => $mode));
}

function ke_hoach_xep_xe_page_form($id = NULL) {
  if (!$id) {
    drupal_goto('ke-hoach-xep-xe');
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  $data = NULL;
  $mode = 'create';
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }
  $data = _ke_hoach_xep_xe_enrich_row($row);
  $mode = 'edit';

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'mode' => $mode,
    'plan_type' => !empty($data['loai_ke_hoach']) && $data['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong',
    'data' => $data,
    'statuses' => _ke_hoach_xep_xe_statuses(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  if ($mode === 'edit') {
    return theme('ke_hoach_xep_xe_edit_page', array('mode' => $mode, 'data' => $data));
  }

  return MENU_NOT_FOUND;
}

function ke_hoach_xep_xe_page_detail($id) {
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  $data = _ke_hoach_xep_xe_enrich_row($row);
  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'mode' => 'detail',
    'data' => $data,
    'permissions' => array(
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  return theme('ke_hoach_xep_xe_detail_page', array('mode' => 'detail', 'data' => $data));
}

function _ke_hoach_tuyen_xa_loai_chang_options() {
  return array('khoan', 'chuyen');
}

function _ke_hoach_tuyen_xa_loai_chi_phi_options() {
  return array(
    'cuoc_van_chuyen' => 'Cước vận chuyển',
    'phat_sinh' => 'Phát sinh',
    'chi_phi_cua_khau' => 'Chi phí cửa khẩu',
    'chi_phi_nha_may' => 'Chi phí nhà máy',
    'neo' => 'Neo',
    'hoa_hong' => 'Hoa hồng',
    'vat' => 'VAT',
    'khac' => 'Khác',
  );
}

function _ke_hoach_tuyen_xa_loai_dau_options() {
  return array(
    'do_duong' => 'Đổ dọc đường',
    've_bai_dau_keo' => 'Về bãi đầu kéo',
    've_bai_mooc' => 'Về bãi mooc',
    'dau_dau_cai' => 'Dầu đầu cái',
    'khac' => 'Khác',
  );
}

function _ke_hoach_tuyen_xa_json_text($value, $key = 'ghi_chu') {
  $json = _ke_hoach_xep_xe_json_decode($value);
  return !empty($json[$key]) ? $json[$key] : '';
}

function _ke_hoach_tuyen_xa_normalize_date($value) {
  $value = trim((string) $value);
  if ($value === '') {
    return '';
  }
  return substr($value, 0, 10);
}

function _ke_hoach_tuyen_xa_validate_input($input, $is_update = FALSE) {
  if (empty($input['nid_khach_hang'])) {
    return _ke_hoach_xep_xe_fail('Khách hàng bắt buộc');
  }
  if (empty($input['so_bkg'])) {
    return _ke_hoach_xep_xe_fail('Số BKG bắt buộc');
  }
  if (empty($input['so_cont'])) {
    return _ke_hoach_xep_xe_fail('Số cont bắt buộc');
  }
  if (empty($input['diem_di'])) {
    return _ke_hoach_xep_xe_fail('Điểm đi bắt buộc');
  }
  if (empty($input['diem_den'])) {
    return _ke_hoach_xep_xe_fail('Điểm đến bắt buộc');
  }
  $changs = !empty($input['changs']) && is_array($input['changs']) ? $input['changs'] : array();
  if (empty($changs)) {
    return _ke_hoach_xep_xe_fail('Cần ít nhất một chặng');
  }
  foreach ($changs as $index => $item) {
    $row_no = $index + 1;
    if (!empty($item['loai_chang']) && !in_array($item['loai_chang'], _ke_hoach_tuyen_xa_loai_chang_options(), TRUE)) {
      return _ke_hoach_xep_xe_fail('Loại chặng ở dòng #' . $row_no . ' không hợp lệ');
    }
    if (empty($item['diem_di']) || empty($item['diem_den'])) {
      return _ke_hoach_xep_xe_fail('Điểm đi/điểm đến của chặng #' . $row_no . ' bắt buộc');
    }
  }
  return NULL;
}

function _ke_hoach_tuyen_xa_build_parent_record($input) {
  $record = _ke_hoach_xep_xe_default_record();
  $first_chang = !empty($input['changs'][0]) && is_array($input['changs'][0]) ? $input['changs'][0] : array();
  $json = array();
  if (!empty($input['ghi_chu'])) {
    $json['ghi_chu'] = trim((string) $input['ghi_chu']);
  }
  if (!empty($input['thong_tin_json']) && is_array($input['thong_tin_json'])) {
    $json = array_merge($json, $input['thong_tin_json']);
  }

  $record['nid_khach_hang'] = (int) $input['nid_khach_hang'];
  $record['so_bkg'] = trim((string) $input['so_bkg']);
  $record['so_cont'] = !empty($input['so_cont']) ? trim((string) $input['so_cont']) : '';
  $record['loai_cont'] = !empty($input['loai_cont']) ? trim((string) $input['loai_cont']) : '';
  $record['dia_chi_kho'] = !empty($input['dia_chi_kho']) ? trim((string) $input['dia_chi_kho']) : '';
  $record['trang_thai_van_chuyen'] = !empty($input['trang_thai_van_chuyen']) ? trim((string) $input['trang_thai_van_chuyen']) : 'Mới tạo';
  $record['nid_phuong_tien'] = !empty($first_chang['nid_phuong_tien']) ? (int) $first_chang['nid_phuong_tien'] : 0;
  $record['nid_mooc'] = !empty($first_chang['nid_mooc']) ? (int) $first_chang['nid_mooc'] : 0;
  $record['nid_lai_xe'] = !empty($first_chang['nid_lai_xe']) ? (int) $first_chang['nid_lai_xe'] : 0;
  $record['thong_tin_json'] = !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '';

  return array(
    'parent' => $record,
    'loai_ke_hoach' => 'tuyen_xa',
    'diem_di' => trim((string) $input['diem_di']),
    'cua_khau' => !empty($input['cua_khau']) ? trim((string) $input['cua_khau']) : '',
    'diem_den' => trim((string) $input['diem_den']),
    'ngay_bat_dau' => !empty($input['ngay_bat_dau']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_bat_dau']) : '',
    'ngay_ket_thuc' => !empty($input['ngay_ket_thuc']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_ket_thuc']) : '',
  );
}

function _ke_hoach_tuyen_xa_save_changs($ke_hoach_id, array $items) {
  db_delete('ke_hoach_tuyen_xa_chang')->condition('ke_hoach_id', (int) $ke_hoach_id)->execute();
  $now = _ke_hoach_xep_xe_now();
  $key_map = array();
  foreach ($items as $index => $item) {
    $id = db_insert('ke_hoach_tuyen_xa_chang')
      ->fields(array(
        'ke_hoach_id' => (int) $ke_hoach_id,
        'thu_tu' => $index + 1,
        'loai_chang' => !empty($item['loai_chang']) ? trim((string) $item['loai_chang']) : '',
        'diem_di' => !empty($item['diem_di']) ? trim((string) $item['diem_di']) : '',
        'diem_den' => !empty($item['diem_den']) ? trim((string) $item['diem_den']) : '',
        'ngay_di' => !empty($item['ngay_di']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay_di']) : '',
        'ngay_den' => !empty($item['ngay_den']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay_den']) : '',
        'nid_phuong_tien' => !empty($item['nid_phuong_tien']) ? (int) $item['nid_phuong_tien'] : 0,
        'nid_mooc' => !empty($item['nid_mooc']) ? (int) $item['nid_mooc'] : 0,
        'nid_lai_xe' => !empty($item['nid_lai_xe']) ? (int) $item['nid_lai_xe'] : 0,
        'thong_tin_json' => '',
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
    $chang_key = !empty($item['chang_key']) ? (string) $item['chang_key'] : (string) ($index + 1);
    $key_map[$chang_key] = (int) $id;
  }
  return $key_map;
}

function _ke_hoach_tuyen_xa_save_chi_phi($ke_hoach_id, array $items, array $chang_key_map = array()) {
  db_delete('ke_hoach_tuyen_xa_chi_phi')->condition('ke_hoach_id', (int) $ke_hoach_id)->execute();
  $now = _ke_hoach_xep_xe_now();
  foreach ($items as $item) {
    if (empty($item['ten_chi_phi']) && empty($item['loai_chi_phi']) && empty($item['so_tien'])) {
      continue;
    }
    db_insert('ke_hoach_tuyen_xa_chi_phi')
      ->fields(array(
        'ke_hoach_id' => (int) $ke_hoach_id,
        'chang_id' => !empty($item['chang_key']) && isset($chang_key_map[(string) $item['chang_key']]) ? (int) $chang_key_map[(string) $item['chang_key']] : 0,
        'loai_chi_phi' => !empty($item['loai_chi_phi']) ? trim((string) $item['loai_chi_phi']) : '',
        'ten_chi_phi' => !empty($item['ten_chi_phi']) ? trim((string) $item['ten_chi_phi']) : '',
        'so_tien' => !empty($item['so_tien']) ? (int) $item['so_tien'] : 0,
        'ngay' => !empty($item['ngay']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay']) : '',
        'is_co_dinh' => !empty($item['is_co_dinh']) ? 1 : 0,
        'thong_tin_json' => '',
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
  }
}

function _ke_hoach_tuyen_xa_save_dau($ke_hoach_id, array $items, array $chang_key_map = array()) {
  db_delete('ke_hoach_tuyen_xa_dau')->condition('ke_hoach_id', (int) $ke_hoach_id)->execute();
  $now = _ke_hoach_xep_xe_now();
  foreach ($items as $item) {
    if (empty($item['ngay']) && empty($item['so_lit']) && empty($item['so_tien']) && empty($item['loai_dau'])) {
      continue;
    }
    db_insert('ke_hoach_tuyen_xa_dau')
      ->fields(array(
        'ke_hoach_id' => (int) $ke_hoach_id,
        'chang_id' => !empty($item['chang_key']) && isset($chang_key_map[(string) $item['chang_key']]) ? (int) $chang_key_map[(string) $item['chang_key']] : 0,
        'ngay' => !empty($item['ngay']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay']) : '',
        'loai_dau' => !empty($item['loai_dau']) ? trim((string) $item['loai_dau']) : '',
        'so_lit' => isset($item['so_lit']) && $item['so_lit'] !== '' ? (float) $item['so_lit'] : 0,
        'so_tien' => !empty($item['so_tien']) ? (int) $item['so_tien'] : 0,
        'thong_tin_json' => '',
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
  }
}

function _ke_hoach_tuyen_xa_load_changs($ke_hoach_id) {
  $items = array();
  $rows = db_select('ke_hoach_tuyen_xa_chang', 'c')
    ->fields('c')
    ->condition('c.ke_hoach_id', (int) $ke_hoach_id)
    ->condition('c.hoat_dong', 1)
    ->orderBy('c.thu_tu', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $item['chang_key'] = (string) $item['id'];
    if (!empty($item['nid_lai_xe'])) {
      $lx = db_query("SELECT nid, ten, ma_nhan_vien, sdt FROM {lai_xe} WHERE nid = :nid", array(':nid' => (int) $item['nid_lai_xe']))->fetch();
      $item['lai_xe'] = $lx ? (array) $lx : NULL;
    }
    else {
      $item['lai_xe'] = NULL;
    }
    if (!empty($item['nid_phuong_tien'])) {
      $pt = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien FROM {phuong_tien} WHERE nid = :nid", array(':nid' => (int) $item['nid_phuong_tien']))->fetch();
      $item['phuong_tien'] = $pt ? (array) $pt : NULL;
    }
    else {
      $item['phuong_tien'] = NULL;
    }
    if (!empty($item['nid_mooc'])) {
      $mooc = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien FROM {phuong_tien} WHERE nid = :nid", array(':nid' => (int) $item['nid_mooc']))->fetch();
      $item['mooc'] = $mooc ? (array) $mooc : NULL;
    }
    else {
      $item['mooc'] = NULL;
    }
    $item['ghi_chu'] = _ke_hoach_tuyen_xa_json_text(isset($item['thong_tin_json']) ? $item['thong_tin_json'] : '');
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_load_chi_phi($ke_hoach_id) {
  $items = array();
  $rows = db_select('ke_hoach_tuyen_xa_chi_phi', 'c')
    ->fields('c')
    ->condition('c.ke_hoach_id', (int) $ke_hoach_id)
    ->condition('c.hoat_dong', 1)
    ->orderBy('c.id', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $item['chang_key'] = !empty($item['chang_id']) ? (string) $item['chang_id'] : '';
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_load_dau($ke_hoach_id) {
  $items = array();
  $rows = db_select('ke_hoach_tuyen_xa_dau', 'd')
    ->fields('d')
    ->condition('d.ke_hoach_id', (int) $ke_hoach_id)
    ->condition('d.hoat_dong', 1)
    ->orderBy('d.id', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $item['so_lit'] = isset($item['so_lit']) ? (string) $item['so_lit'] : '0';
    $item['chang_key'] = !empty($item['chang_id']) ? (string) $item['chang_id'] : '';
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_enrich_row($row, $with_children = TRUE) {
  $result = _ke_hoach_xep_xe_enrich_row($row);
  $result['ghi_chu'] = _ke_hoach_tuyen_xa_json_text(isset($result['thong_tin_json']) ? $result['thong_tin_json'] : '');
  if ($with_children) {
    $result['changs'] = _ke_hoach_tuyen_xa_load_changs($result['nid']);
    $result['chi_phi'] = _ke_hoach_tuyen_xa_load_chi_phi($result['nid']);
    $result['dau'] = _ke_hoach_tuyen_xa_load_dau($result['nid']);
  }
  return $result;
}

function ke_hoach_tuyen_xa_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_tuyen_xa_rest_list();
    case 'POST':
      return _ke_hoach_tuyen_xa_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function ke_hoach_tuyen_xa_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_tuyen_xa_rest_get($id);
    case 'PUT':
      return _ke_hoach_tuyen_xa_rest_update($id);
    case 'DELETE':
      return _ke_hoach_tuyen_xa_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

function _ke_hoach_tuyen_xa_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->fields('kh');
  $query->condition('kh.hoat_dong', 1);
  $query->condition('kh.loai_ke_hoach', 'tuyen_xa');
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $query->condition(db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.diem_di', $like, 'LIKE')
      ->condition('kh.cua_khau', $like, 'LIKE')
      ->condition('kh.diem_den', $like, 'LIKE'));
  }
  $count = clone $query;
  $total = (int) $count->countQuery()->execute()->fetchField();
  $total_pages = $total > 0 ? (int) ceil($total / $limit) : 0;

  $query->orderBy('kh.nid', 'DESC');
  $query->range($offset, $limit);
  $items = array();
  foreach ($query->execute()->fetchAll() as $row) {
    $item = _ke_hoach_tuyen_xa_enrich_row($row, FALSE);
    $item['chang_count'] = (int) db_query("SELECT COUNT(*) FROM {ke_hoach_tuyen_xa_chang} WHERE ke_hoach_id = :id AND hoat_dong = 1", array(':id' => $item['nid']))->fetchField();
    $items[] = $item;
  }

  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _ke_hoach_tuyen_xa_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch tuyến xa');
  }
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_validate_input($input);
  if ($validation) {
    return $validation;
  }
  $built = _ke_hoach_tuyen_xa_build_parent_record($input);
  $record = $built['parent'];
  $transaction = db_transaction();
  try {
    $nid = db_insert('ke_hoach_xep_xe')
      ->fields(array(
        'nid_khach_hang' => $record['nid_khach_hang'],
        'nid_lai_xe' => $record['nid_lai_xe'],
        'so_bkg' => $record['so_bkg'],
        'dia_chi_kho' => $record['dia_chi_kho'],
        'loai_cont' => $record['loai_cont'],
        'so_cont' => $record['so_cont'],
        'nid_phuong_tien' => $record['nid_phuong_tien'],
        'nid_mooc' => $record['nid_mooc'],
        'so_seal_chinh' => $record['so_seal_chinh'],
        'so_seal_tam' => $record['so_seal_tam'],
        'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
        'bai_lay_cont' => $record['bai_lay_cont'],
        'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
        'bai_ha_cont' => $record['bai_ha_cont'],
        'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
        'cang_xuat' => $record['cang_xuat'],
        'hinh_thuc_van_tai' => '',
        'ke_hoach_cont_ref_nid' => 0,
        'da_cat_mooc' => 0,
        'da_du_hang' => 0,
        'ha_bai_ngoai' => 0,
        'ha_cang' => 0,
        'thong_tin_json' => $record['thong_tin_json'],
        'loai_ke_hoach' => 'tuyen_xa',
        'diem_di' => $built['diem_di'],
        'cua_khau' => $built['cua_khau'],
        'diem_den' => $built['diem_den'],
        'ngay_bat_dau' => $built['ngay_bat_dau'],
        'ngay_ket_thuc' => $built['ngay_ket_thuc'],
        'created' => _ke_hoach_xep_xe_now(),
        'changed' => _ke_hoach_xep_xe_now(),
        'hoat_dong' => 1,
      ))
      ->execute();

    $chang_key_map = _ke_hoach_tuyen_xa_save_changs($nid, $input['changs']);
    _ke_hoach_tuyen_xa_save_chi_phi($nid, !empty($input['chi_phi']) && is_array($input['chi_phi']) ? $input['chi_phi'] : array(), $chang_key_map);
    _ke_hoach_tuyen_xa_save_dau($nid, !empty($input['dau']) && is_array($input['dau']) ? $input['dau'] : array(), $chang_key_map);

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $nid))->fetch();
    watchdog('ke_hoach_tuyen_xa', 'Tạo kế hoạch tuyến xa #%id', array('%id' => $nid));
    return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_tuyen_xa', 'Lỗi tạo kế hoạch tuyến xa: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi tạo kế hoạch tuyến xa');
  }
}

function _ke_hoach_tuyen_xa_rest_get($id) {
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetch();
  if (!$row) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
}

function _ke_hoach_tuyen_xa_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch tuyến xa');
  }
  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_validate_input($input, TRUE);
  if ($validation) {
    return $validation;
  }
  $built = _ke_hoach_tuyen_xa_build_parent_record($input);
  $record = $built['parent'];
  $transaction = db_transaction();
  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array(
        'nid_khach_hang' => $record['nid_khach_hang'],
        'nid_lai_xe' => $record['nid_lai_xe'],
        'so_bkg' => $record['so_bkg'],
        'dia_chi_kho' => $record['dia_chi_kho'],
        'loai_cont' => $record['loai_cont'],
        'so_cont' => $record['so_cont'],
        'nid_phuong_tien' => $record['nid_phuong_tien'],
        'nid_mooc' => $record['nid_mooc'],
        'thong_tin_json' => $record['thong_tin_json'],
        'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
        'diem_di' => $built['diem_di'],
        'cua_khau' => $built['cua_khau'],
        'diem_den' => $built['diem_den'],
        'ngay_bat_dau' => $built['ngay_bat_dau'],
        'ngay_ket_thuc' => $built['ngay_ket_thuc'],
        'changed' => _ke_hoach_xep_xe_now(),
      ))
      ->condition('nid', $id)
      ->execute();

    $chang_key_map = _ke_hoach_tuyen_xa_save_changs($id, $input['changs']);
    _ke_hoach_tuyen_xa_save_chi_phi($id, !empty($input['chi_phi']) && is_array($input['chi_phi']) ? $input['chi_phi'] : array(), $chang_key_map);
    _ke_hoach_tuyen_xa_save_dau($id, !empty($input['dau']) && is_array($input['dau']) ? $input['dau'] : array(), $chang_key_map);

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
    return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_tuyen_xa', 'Lỗi cập nhật kế hoạch tuyến xa #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch tuyến xa');
  }
}

function _ke_hoach_tuyen_xa_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá kế hoạch tuyến xa');
  }
  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  db_update('ke_hoach_xep_xe')
    ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
    ->condition('nid', $id)
    ->execute();
  db_update('ke_hoach_tuyen_xa_chang')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('ke_hoach_id', $id)->execute();
  db_update('ke_hoach_tuyen_xa_chi_phi')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('ke_hoach_id', $id)->execute();
  db_update('ke_hoach_tuyen_xa_dau')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('ke_hoach_id', $id)->execute();
  return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
}

function ke_hoach_tuyen_xa_page_list() {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));
  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'plan_type' => 'tuyen_xa',
    'list_title' => 'Kế hoạch tuyến xa',
    'create_title' => 'Tạo kế hoạch tuyến xa',
    'create_button_text' => 'Thêm kế hoạch tuyến xa',
    'statuses' => _ke_hoach_xep_xe_statuses(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');
  return theme('ke_hoach_xep_xe_list_page', array('plan_type' => 'tuyen_xa'));
}
