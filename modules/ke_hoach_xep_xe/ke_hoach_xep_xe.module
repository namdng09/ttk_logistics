  return array(
    'ngay' => '',
    'nid_khach_hang' => 0,
    'nid_lai_xe' => 0,
    'so_bkg' => '',
    'dia_chi_kho' => '',
    'loai_cont' => '',
    'loai_hang' => '',
    'so_cont' => '',
    'nid_phuong_tien' => 0,
    'nid_mooc' => 0,
    'so_seal_chinh' => '',
    'so_seal_tam' => '',
    'trang_thai_van_chuyen' => 'Chưa xếp xe',
    'bai_lay_cont' => '',
    'bai_lay_thuc_te' => '',
    'bai_ha_cont' => '',
    'bai_ha_thuc_te' => '',
    'cang_xuat' => '',
    'cut_off' => '',
    'ngay_gio_ke_hoach' => '',
    'hinh_thuc_van_tai' => '',
    'ke_hoach_cont_ref_nid' => 0,
    'nid_ke_hoach_nguon' => 0,
    'da_cat_mooc' => 0,
    'da_du_hang' => 0,
    'bai_ha_ngoai' => '',
    'ha_cang' => 0,
