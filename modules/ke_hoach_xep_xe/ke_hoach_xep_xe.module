function ke_hoach_xep_xe_page_form($id = NULL) {
  if (!$id) {
    drupal_goto('ke-hoach-xep-xe');
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));

  if (module_exists('danh_muc') && function_exists('danh_muc_add_modal_assets')) {
    danh_muc_add_modal_assets();
  }
  if (module_exists('khach_hang') && function_exists('khach_hang_add_modal_assets')) {
    khach_hang_add_modal_assets();
  }

  $data = NULL;
  $mode = 'create';
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }
  $data = _ke_hoach_xep_xe_enrich_row($row);
  $mode = 'edit';

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'mode' => $mode,
    'plan_type' => !empty($data['loai_ke_hoach']) && $data['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong',
    'data' => $data,
    'statuses' => _ke_hoach_xep_xe_statuses(!empty($data['loai_ke_hoach']) && $data['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong'),
    'khach_hang_quick_create' => _ke_hoach_xep_xe_khach_hang_quick_create_settings(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');

  if ($mode === 'edit') {
    return theme('ke_hoach_xep_xe_edit_page', array('mode' => $mode, 'data' => $data));
  }

  return MENU_NOT_FOUND;
}

function ke_hoach_xep_xe_page_detail($id) {
  $id = (int) $id;
  if (!$id) {
    return MENU_NOT_FOUND;
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return MENU_NOT_FOUND;
  }

  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
