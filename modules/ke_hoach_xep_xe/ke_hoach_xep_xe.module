}

function _ke_hoach_xep_xe_has_loai_hang_field() {
  $exists = &drupal_static(__FUNCTION__);
  if (!isset($exists)) {
    $exists = db_field_exists('ke_hoach_xep_xe', 'loai_hang');
  }
  return $exists;
}

function _ke_hoach_xep_xe_json_decode($value) {
  if (is_array($value)) {
    return $value;
  }
  $data = json_decode((string) $value, TRUE);
  return is_array($data) ? $data : array();
}

function _ke_hoach_xep_xe_json_encode(array $data) {
  $options = defined('JSON_UNESCAPED_UNICODE') ? JSON_UNESCAPED_UNICODE : 0;
  return json_encode($data, $options);
}

function _ke_hoach_xep_xe_merge_json_text($existing, $incoming) {
  $existing_json = _ke_hoach_xep_xe_json_decode($existing);
  $incoming_json = _ke_hoach_xep_xe_json_decode($incoming);
  $merged = array_merge($existing_json, $incoming_json);
  return !empty($merged) ? _ke_hoach_xep_xe_json_encode($merged) : '';
}

function _ke_hoach_xep_xe_normalize_money_value($value) {
  return _ke_hoach_xep_xe_parse_money($value);
}

function _ke_hoach_xep_xe_normalize_tang_bo($value) {
  $value = is_array($value) ? $value : array();
  $enabled = !empty($value['enabled']) || !empty($value['bat']);
  return array(
    'enabled' => $enabled ? 1 : 0,
    'nid_khach_hang' => !empty($value['nid_khach_hang']) ? (int) $value['nid_khach_hang'] : 0,
    'dia_chi' => !empty($value['dia_chi']) ? trim((string) $value['dia_chi']) : '',
    'ghi_chu' => !empty($value['ghi_chu']) ? trim((string) $value['ghi_chu']) : '',
    'doanh_thu_khach_hang' => isset($value['doanh_thu_khach_hang']) ? _ke_hoach_xep_xe_normalize_money_value($value['doanh_thu_khach_hang']) : 0,
    'luong_lai_xe' => isset($value['luong_lai_xe']) ? _ke_hoach_xep_xe_normalize_money_value($value['luong_lai_xe']) : 0,
  );
}

function _ke_hoach_xep_xe_normalize_ket_hop($value) {
  $value = is_array($value) ? $value : array();
  $enabled = !empty($value['enabled']) && !empty($value['ke_hoach_cont_ref_nid']);
  return array(
    'enabled' => $enabled ? 1 : 0,
    'ke_hoach_cont_ref_nid' => !empty($value['ke_hoach_cont_ref_nid']) ? (int) $value['ke_hoach_cont_ref_nid'] : 0,
    'cont_thuc_hien_tu_index' => isset($value['cont_thuc_hien_tu_index']) ? (int) $value['cont_thuc_hien_tu_index'] : -1,
    'cont_thuc_hien_den_index' => isset($value['cont_thuc_hien_den_index']) ? (int) $value['cont_thuc_hien_den_index'] : -1,
    'cont_keo_ve_tu' => !empty($value['cont_keo_ve_tu']) ? trim((string) $value['cont_keo_ve_tu']) : '',
    'cont_keo_ve_den' => !empty($value['cont_keo_ve_den']) ? trim((string) $value['cont_keo_ve_den']) : '',
    'hoan_thanh' => !empty($value['hoan_thanh']) ? 1 : 0,
  );
}

/**
 * The canonical plan role is determined by the source-plan relation.  The
 * JSON role is retained for backwards compatibility/display only.
 */
function _ke_hoach_xep_xe_plan_role($item) {
  $item = is_object($item) ? (array) $item : (array) $item;
  $json = _ke_hoach_xep_xe_json_decode(isset($item['thong_tin_json']) ? $item['thong_tin_json'] : '');
  if (!empty($item['nid_ke_hoach_nguon']) || !empty($json['ke_hoach_ket_hop_hang'])) {
    return 'ke_hoach_ket_hop';
  }
  return !empty($item['ke_hoach_cont_ref_nid']) ? 'thuc_hien_chang' : 'ke_hoach_goc';
}

function _ke_hoach_xep_xe_file_groups() {
  return array(
    'lay_cont_rong' => 'Nhận cont rỗng',
    'tang_bo' => 'Tăng bo',
    'giao_cont_rong_cho_kho' => 'Giao cont rỗng',
    'nhan_cont_hang_tu_kho' => 'Nhận cont hàng',
    'ha_cont' => 'Hạ cont hàng',
  );
}

function _ke_hoach_xep_xe_file_group_label($group) {
  $groups = _ke_hoach_xep_xe_file_groups();
  return isset($groups[$group]) ? $groups[$group] : 'Khác';
}

function _ke_hoach_xep_xe_max_plan_files() {
  return 25;
}

function _ke_hoach_xep_xe_normalize_files(array $json) {
  if (empty($json['hinh_anh_chung_tu']) || !is_array($json['hinh_anh_chung_tu'])) {
    $json['hinh_anh_chung_tu'] = array();
  }
  foreach ($json['hinh_anh_chung_tu'] as &$file) {
    if (!empty($file['uri'])) {
      $file['url'] = file_create_url($file['uri']);
    }
    $file['nhom_label'] = _ke_hoach_xep_xe_file_group_label(!empty($file['nhom']) ? $file['nhom'] : '');
    $file['is_image'] = !empty($file['mime']) && strpos($file['mime'], 'image/') === 0;
  }
  unset($file);
  return $json;
}

function _ke_hoach_xep_xe_file_index($files, $file_id) {
  foreach ($files as $index => $file) {
    if (!empty($file['id']) && (string) $file['id'] === (string) $file_id) {
      return $index;
    }
  }
  return -1;
}

function _ke_hoach_xep_xe_upload_entries($field) {
  if (empty($_FILES[$field])) {
    return array();
  }
  $raw = $_FILES[$field];
  if (is_array($raw['name'])) {
    $items = array();
    foreach ($raw['name'] as $index => $name) {
      if ($name === '') continue;
      $items[] = array(
        'name' => $name,
        'type' => isset($raw['type'][$index]) ? $raw['type'][$index] : '',
        'tmp_name' => isset($raw['tmp_name'][$index]) ? $raw['tmp_name'][$index] : '',
        'error' => isset($raw['error'][$index]) ? $raw['error'][$index] : 0,
        'size' => isset($raw['size'][$index]) ? $raw['size'][$index] : 0,
      );
    }
    return $items;
  }
  return !empty($raw['name']) ? array($raw) : array();
}

function _ke_hoach_xep_xe_optimize_uploaded_image($uri, $mime) {
  if (strpos((string) $mime, 'image/') !== 0) {
    return FALSE;
  }

  if (!function_exists('image_get_info')) {
    require_once DRUPAL_ROOT . '/includes/image.inc';
  }

  $info = image_get_info($uri);
  if (empty($info['width']) || empty($info['height'])) {
    return FALSE;
  }

  $max_dimension = 2560;
  $width = (int) $info['width'];
  $height = (int) $info['height'];
  if ($width <= $max_dimension && $height <= $max_dimension) {
    return FALSE;
  }

  $image = image_load($uri);
  if (!$image) {
    return FALSE;
  }

  $target_width = $width >= $height ? $max_dimension : NULL;
  $target_height = $height > $width ? $max_dimension : NULL;
  if (!image_scale($image, $target_width, $target_height, FALSE)) {
    return FALSE;
  }

  $saved = image_save($image, $uri);
  if ($saved) {
    clearstatcache(TRUE, drupal_realpath($uri));
  }
  return (bool) $saved;
}

function _ke_hoach_xep_xe_save_upload_entry(array $upload, $dir) {
  if (empty($upload['name']) || !empty($upload['error'])) return NULL;
  $max_size = 10 * 1024 * 1024;
  $size = isset($upload['size']) ? (int) $upload['size'] : 0;
  if ($size <= 0 || $size > $max_size) return FALSE;

  $original = drupal_basename($upload['name']);
  $ext = strtolower(pathinfo($original, PATHINFO_EXTENSION));
  $allowed_ext = array('jpg', 'jpeg', 'png', 'webp', 'pdf');
  if (!in_array($ext, $allowed_ext)) return FALSE;
  if (empty($upload['tmp_name']) || !is_uploaded_file($upload['tmp_name'])) return FALSE;

  $safe_name = file_munge_filename($original, 'jpg jpeg png webp pdf', FALSE);
  $destination = file_unmanaged_save_data(file_get_contents($upload['tmp_name']), $dir . '/' . $safe_name, FILE_EXISTS_RENAME);
  if (!$destination) return FALSE;

  $mime = file_get_mimetype($destination);
  $allowed_mime = array('image/jpeg', 'image/png', 'image/webp', 'application/pdf');
  if ($mime && !in_array($mime, $allowed_mime)) {
    file_unmanaged_delete($destination);
    return FALSE;
  }
  if ($mime && strpos($mime, 'image/') === 0) {
    _ke_hoach_xep_xe_optimize_uploaded_image($destination, $mime);
    $mime = file_get_mimetype($destination);
  }

  global $user;
  $file = new stdClass();
  $file->uid = isset($user->uid) ? (int) $user->uid : 0;
  $file->filename = $original;
  $file->uri = $destination;
  $file->filemime = $mime ?: 'application/octet-stream';
  $file->filesize = filesize($destination);
  $file->status = FILE_STATUS_PERMANENT;
  return file_save($file);
}

function _ke_hoach_xep_xe_parse_money($value) {
  if (is_numeric($value)) {
    return (int) round($value);
  }
  $value = preg_replace('/[^\d-]/', '', (string) $value);
  return $value === '' || $value === '-' ? 0 : (int) $value;
}

function _ke_hoach_tuyen_xa_normalize_oil_type($type) {
  $type = trim((string) $type);
  if ($type === 've_bai_truoc_khi_xep' || $type === 've_bai_sau_chuyen') {
    return 'do_dau_bai_cong_ty';
  }
  return $type !== '' ? $type : 'do_dau_ngoai';
}

function _ke_hoach_xep_xe_normalize_percent($value, $default = 0) {
  $percent = is_numeric($value) ? (float) $value : (float) str_replace(',', '.', preg_replace('/[^\d,.\-]/', '', (string) $value));
  if (!is_finite($percent)) {
    $percent = (float) $default;
  }
  if ($percent < 0) {
    return 0;
  }
  if ($percent > 100) {
    return 100;
  }
  return $percent;
}

function _ke_hoach_chi_phi_mau_allowed_types() {
  return array('tinh_cho_khach', 'cong_ty_chi_tra', 'lai_xe_tu_chiu');
}

function _ke_hoach_chi_phi_mau_build_record(array $input, $existing = NULL) {
  $type = isset($input['loai_chi_phi']) ? trim((string) $input['loai_chi_phi']) : ($existing ? (string) $existing->loai_chi_phi : 'cong_ty_chi_tra');
  if (!in_array($type, _ke_hoach_chi_phi_mau_allowed_types(), TRUE)) $type = 'cong_ty_chi_tra';
  return array(
    'ten' => isset($input['ten']) ? trim((string) $input['ten']) : ($existing ? (string) $existing->ten : ''),
    'loai_chi_phi' => $type,
    'thu_tu' => isset($input['thu_tu']) ? max(0, (int) $input['thu_tu']) : ($existing ? (int) $existing->thu_tu : 0),
  );
}

function ke_hoach_chi_phi_mau_rest_collection() {
  if (!db_table_exists('ke_hoach_chi_phi_mau')) return _ke_hoach_xep_xe_error('Bảng chi phí mặc định chưa được tạo. Hãy chạy update database.');
  if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    if (!user_access('ke_hoach_xep_xe_view')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem chi phí mặc định');
    $items = db_select('ke_hoach_chi_phi_mau', 'm')->fields('m')->condition('m.hoat_dong', 1)->orderBy('m.thu_tu', 'ASC')->orderBy('m.nid', 'ASC')->execute()->fetchAll();
    return _ke_hoach_xep_xe_success(array('items' => array_values($items), 'total' => count($items)));
  }
  if ($_SERVER['REQUEST_METHOD'] !== 'POST') return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  if (!user_access('ke_hoach_xep_xe_create')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo chi phí mặc định');
  $input = _ke_hoach_xep_xe_input();
  $record = _ke_hoach_chi_phi_mau_build_record($input);
  if ($record['ten'] === '') return _ke_hoach_xep_xe_fail('Vui lòng nhập tên chi phí mặc định');
  if (!$record['thu_tu']) $record['thu_tu'] = (int) db_query("SELECT COALESCE(MAX(thu_tu), 0) + 1 FROM {ke_hoach_chi_phi_mau}")->fetchField();
  $now = _ke_hoach_xep_xe_now();
  $record += array('created' => $now, 'changed' => $now, 'hoat_dong' => 1);
  $nid = db_insert('ke_hoach_chi_phi_mau')->fields($record)->execute();
  return _ke_hoach_xep_xe_success((array) db_query("SELECT * FROM {ke_hoach_chi_phi_mau} WHERE nid = :nid", array(':nid' => $nid))->fetch());
}

function ke_hoach_chi_phi_mau_rest_item($nid) {
  if (!db_table_exists('ke_hoach_chi_phi_mau')) return _ke_hoach_xep_xe_error('Bảng chi phí mặc định chưa được tạo. Hãy chạy update database.');
  $nid = (int) $nid;
  $item = $nid ? db_query("SELECT * FROM {ke_hoach_chi_phi_mau} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $nid))->fetch() : FALSE;
  if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    if (!user_access('ke_hoach_xep_xe_view')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem chi phí mặc định');
    return $item ? _ke_hoach_xep_xe_success((array) $item) : _ke_hoach_xep_xe_not_found('Chi phí mặc định không tồn tại');
  }
  if (!user_access('ke_hoach_xep_xe_create')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật chi phí mặc định');
  if (!$item) return _ke_hoach_xep_xe_not_found('Chi phí mặc định không tồn tại');
  if ($_SERVER['REQUEST_METHOD'] === 'PUT') {
    $record = _ke_hoach_chi_phi_mau_build_record(_ke_hoach_xep_xe_input(), $item);
    if ($record['ten'] === '') return _ke_hoach_xep_xe_fail('Vui lòng nhập tên chi phí mặc định');
    $record['changed'] = _ke_hoach_xep_xe_now();
    db_update('ke_hoach_chi_phi_mau')->fields($record)->condition('nid', $nid)->execute();
    return _ke_hoach_xep_xe_success((array) db_query("SELECT * FROM {ke_hoach_chi_phi_mau} WHERE nid = :nid", array(':nid' => $nid))->fetch());
  }
  if ($_SERVER['REQUEST_METHOD'] === 'DELETE') {
    db_update('ke_hoach_chi_phi_mau')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('nid', $nid)->execute();
    return _ke_hoach_xep_xe_success(array('nid' => $nid, 'deleted' => TRUE));
  }
  return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
}

function _ke_hoach_chi_phi_build_record(array $input, $existing = NULL) {
  static $parents = array();
  $nid_ke_hoach = !empty($input['nid_ke_hoach']) ? (int) $input['nid_ke_hoach'] : ($existing && !empty($existing->nid_ke_hoach) ? (int) $existing->nid_ke_hoach : 0);
  if ($nid_ke_hoach && !array_key_exists($nid_ke_hoach, $parents)) {
    $parents[$nid_ke_hoach] = db_query("SELECT nid_lai_xe, loai_ke_hoach FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $nid_ke_hoach))->fetch();
  }
  $parent = $nid_ke_hoach ? $parents[$nid_ke_hoach] : NULL;
  $don_gia = array_key_exists('don_gia', $input) ? _ke_hoach_xep_xe_parse_money($input['don_gia']) : ($existing && isset($existing->don_gia) ? (int) $existing->don_gia : 0);
  $so_luong = array_key_exists('so_luong', $input) && $input['so_luong'] !== '' ? (float) $input['so_luong'] : ($existing && isset($existing->so_luong) ? (float) $existing->so_luong : 1);
  $tong_truoc_vat = array_key_exists('tong_truoc_vat', $input) ? _ke_hoach_xep_xe_parse_money($input['tong_truoc_vat']) : (int) round($don_gia * $so_luong);
  $vat_percent = array_key_exists('vat_percent', $input) && $input['vat_percent'] !== '' ? _ke_hoach_xep_xe_normalize_percent($input['vat_percent']) : ($existing && isset($existing->vat_percent) ? _ke_hoach_xep_xe_normalize_percent($existing->vat_percent) : 0);
  $tong_sau_vat = array_key_exists('tong_sau_vat', $input) ? _ke_hoach_xep_xe_parse_money($input['tong_sau_vat']) : (int) round($tong_truoc_vat * (1 + ($vat_percent / 100)));
  $json = array_key_exists('thong_tin_json', $input) && is_array($input['thong_tin_json']) ? $input['thong_tin_json'] : ($existing && !empty($existing->thong_tin_json) ? _ke_hoach_xep_xe_json_decode($existing->thong_tin_json) : array());

  return array(
    'nid_ke_hoach' => $nid_ke_hoach,
    'loai_ke_hoach' => !empty($input['loai_ke_hoach']) ? trim((string) $input['loai_ke_hoach']) : ($parent && !empty($parent->loai_ke_hoach) ? (string) $parent->loai_ke_hoach : ($existing && !empty($existing->loai_ke_hoach) ? (string) $existing->loai_ke_hoach : 'thuong')),
    'nid_lai_xe' => !empty($input['nid_lai_xe']) ? (int) $input['nid_lai_xe'] : ($parent && !empty($parent->nid_lai_xe) ? (int) $parent->nid_lai_xe : ($existing && !empty($existing->nid_lai_xe) ? (int) $existing->nid_lai_xe : 0)),
    'loai_chi_phi' => isset($input['loai_chi_phi']) ? trim((string) $input['loai_chi_phi']) : ($existing && isset($existing->loai_chi_phi) ? (string) $existing->loai_chi_phi : ''),
    'ten_chi_phi' => isset($input['ten_chi_phi']) ? trim((string) $input['ten_chi_phi']) : ($existing && isset($existing->ten_chi_phi) ? (string) $existing->ten_chi_phi : ''),
    'don_gia' => $don_gia,
    'so_luong' => $so_luong,
    'tong_truoc_vat' => $tong_truoc_vat,
    'vat_percent' => $vat_percent,
    'tong_sau_vat' => $tong_sau_vat,
    'trang_thai_duyet' => !empty($input['trang_thai_duyet']) ? trim((string) $input['trang_thai_duyet']) : ($existing && !empty($existing->trang_thai_duyet) ? (string) $existing->trang_thai_duyet : 'khong_can_duyet'),
    'nid_de_nghi_chi_phi' => !empty($input['nid_de_nghi_chi_phi']) ? (int) $input['nid_de_nghi_chi_phi'] : ($existing && !empty($existing->nid_de_nghi_chi_phi) ? (int) $existing->nid_de_nghi_chi_phi : 0),
    'nid_ledger' => !empty($input['nid_ledger']) ? (int) $input['nid_ledger'] : ($existing && !empty($existing->nid_ledger) ? (int) $existing->nid_ledger : 0),
    'ghi_chu' => isset($input['ghi_chu']) ? trim((string) $input['ghi_chu']) : ($existing && isset($existing->ghi_chu) ? (string) $existing->ghi_chu : ''),
    'thong_tin_json' => !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '',
  );
}

function _ke_hoach_chi_phi_validate_record(array $record) {
  if (in_array($record['loai_chi_phi'], array('doanh_thu', 'luong_lai_xe'), TRUE)) {
    return;
  }
  $has_money = !empty($record['don_gia']) || !empty($record['tong_truoc_vat']) || !empty($record['tong_sau_vat']);
  $cost_types = array('tinh_cho_khach', 'cong_ty_chi_tra', 'lai_xe_tu_chiu');
  if ($has_money && (empty($record['ten_chi_phi']) || !in_array($record['loai_chi_phi'], $cost_types, TRUE))) {
    throw new Exception('Vui lòng chọn tên chi phí và một phân loại chi trả cho dòng có số tiền');
  }
}

function ke_hoach_chi_phi_rest_collection() {
  if (!db_table_exists('ke_hoach_chi_phi')) {
    return _ke_hoach_xep_xe_error('Bảng ke_hoach_chi_phi chưa được tạo. Hãy chạy update database.');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_chi_phi_rest_list();
    case 'POST':
      return _ke_hoach_chi_phi_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function ke_hoach_chi_phi_rest_item($id) {
  if (!db_table_exists('ke_hoach_chi_phi')) {
    return _ke_hoach_xep_xe_error('Bảng ke_hoach_chi_phi chưa được tạo. Hãy chạy update database.');
  }
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_chi_phi_rest_get($id);
    case 'PUT':
      return _ke_hoach_chi_phi_rest_update($id);
    case 'DELETE':
      return _ke_hoach_chi_phi_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

function ke_hoach_chi_phi_rest_bulk() {
  if (!db_table_exists('ke_hoach_chi_phi')) {
    return _ke_hoach_xep_xe_error('Bảng ke_hoach_chi_phi chưa được tạo. Hãy chạy update database.');
  }
  if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    return _ke_hoach_xep_xe_method_not_allowed('POST');
  }
  return _ke_hoach_chi_phi_rest_bulk_save();
}

function _ke_hoach_chi_phi_rest_list() {
  if (!user_access('ke_hoach_xep_xe_view')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem chi phí kế hoạch');
  }
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 50;
  $query = db_select('ke_hoach_chi_phi', 'c')->fields('c')->condition('c.hoat_dong', 1);
  if (!empty($_GET['nid_ke_hoach'])) {
    $query->condition('c.nid_ke_hoach', (int) $_GET['nid_ke_hoach']);
  }
  if (!empty($_GET['loai_chi_phi'])) {
    $query->condition('c.loai_chi_phi', trim((string) $_GET['loai_chi_phi']));
  }
  if (!empty($_GET['trang_thai_duyet'])) {
    $query->condition('c.trang_thai_duyet', trim((string) $_GET['trang_thai_duyet']));
  }
  $count_query = clone $query;
  $total = (int) $count_query->countQuery()->execute()->fetchField();
  $rows = $query->orderBy('c.created', 'ASC')->orderBy('c.nid', 'ASC')->range(($page - 1) * $limit, $limit)->execute()->fetchAll();
  $items = array();
  foreach ($rows as $row) {
    $items[] = (array) $row;
  }
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => $total,
    'current_page' => $page,
    'total_pages' => max(1, (int) ceil($total / $limit)),
  ));
}

function _ke_hoach_chi_phi_rest_get($id) {
  if (!user_access('ke_hoach_xep_xe_view')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem chi phí kế hoạch');
  }
  $row = db_query("SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  return $row ? _ke_hoach_xep_xe_success((array) $row) : _ke_hoach_xep_xe_not_found('Chi phí kế hoạch không tồn tại');
}

function _ke_hoach_chi_phi_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo chi phí kế hoạch');
  }
  $input = _ke_hoach_xep_xe_input();
  if (empty($input['nid_ke_hoach']) || empty($input['ten_chi_phi'])) {
    return _ke_hoach_xep_xe_fail('Vui lòng nhập kế hoạch và tên chi phí');
  }
  $record = _ke_hoach_chi_phi_build_record($input);
  try {
    _ke_hoach_chi_phi_validate_record($record);
  }
  catch (Exception $e) {
    return _ke_hoach_xep_xe_fail($e->getMessage());
  }
  $record['created'] = _ke_hoach_xep_xe_now();
  $record['changed'] = $record['created'];
  $record['hoat_dong'] = 1;
  $nid = db_insert('ke_hoach_chi_phi')->fields($record)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id", array(':id' => $nid))->fetch();
  return _ke_hoach_xep_xe_success((array) $row);
}

function _ke_hoach_chi_phi_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật chi phí kế hoạch');
  }
  $existing = db_query("SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Chi phí kế hoạch không tồn tại');
  }
  $record = _ke_hoach_chi_phi_build_record(_ke_hoach_xep_xe_input(), $existing);
  try {
    _ke_hoach_chi_phi_validate_record($record);
  }
  catch (Exception $e) {
    return _ke_hoach_xep_xe_fail($e->getMessage());
  }
  $record['changed'] = _ke_hoach_xep_xe_now();
  db_update('ke_hoach_chi_phi')->fields($record)->condition('nid', $id)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success((array) $row);
}

function _ke_hoach_chi_phi_rest_bulk_save() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền lưu chi phí kế hoạch');
  }
  $input = _ke_hoach_xep_xe_input();
  $items = !empty($input['items']) && is_array($input['items']) ? $input['items'] : array();
  if (empty($items)) {
    return _ke_hoach_xep_xe_fail('Danh sách chi phí bắt buộc');
  }

  $now = _ke_hoach_xep_xe_now();
  $saved = array();
  $transaction = db_transaction();
  try {
    foreach ($items as $index => $item) {
      if (!is_array($item)) {
        throw new Exception('Dòng #' . ($index + 1) . ': dữ liệu không hợp lệ');
      }
      $id = !empty($item['nid']) ? (int) $item['nid'] : 0;
      $client_key = isset($item['client_key']) ? (string) $item['client_key'] : '';
      if (empty($item['nid_ke_hoach']) || empty($item['ten_chi_phi'])) {
        throw new Exception('Dòng #' . ($index + 1) . ': vui lòng nhập kế hoạch và tên chi phí');
      }

      if ($id) {
        $existing = db_query(
          "SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id AND nid_ke_hoach = :nid_ke_hoach AND hoat_dong = 1",
          array(':id' => $id, ':nid_ke_hoach' => (int) $item['nid_ke_hoach'])
        )->fetch();
        if (!$existing) {
          throw new Exception('Dòng #' . ($index + 1) . ': chi phí kế hoạch không tồn tại');
        }
        $record = _ke_hoach_chi_phi_build_record($item, $existing);
        _ke_hoach_chi_phi_validate_record($record);
        $record['changed'] = $now;
        db_update('ke_hoach_chi_phi')->fields($record)->condition('nid', $id)->execute();
      }
      else {
        $record = _ke_hoach_chi_phi_build_record($item);
        _ke_hoach_chi_phi_validate_record($record);
        $record['created'] = $now;
        $record['changed'] = $now;
        $record['hoat_dong'] = 1;
        $id = db_insert('ke_hoach_chi_phi')->fields($record)->execute();
      }

      $row = db_query("SELECT * FROM {ke_hoach_chi_phi} WHERE nid = :id", array(':id' => $id))->fetch();
      $row_data = (array) $row;
      $row_data['client_key'] = $client_key;
      $saved[] = $row_data;
    }
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Bulk save chi phí kế hoạch lỗi: @message', array('@message' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_fail($e->getMessage());
  }

  return _ke_hoach_xep_xe_success(array(
    'items' => $saved,
    'total' => count($saved),
  ));
}

function _ke_hoach_chi_phi_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá chi phí kế hoạch');
  }
  $existing = db_query("SELECT nid FROM {ke_hoach_chi_phi} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Chi phí kế hoạch không tồn tại');
  }
  db_update('ke_hoach_chi_phi')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('nid', $id)->execute();
  return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
}

function _ke_hoach_xep_xe_build_record($common, $line) {
  $record = _ke_hoach_xep_xe_default_record();
  $record['nid_khach_hang'] = !empty($line['nid_khach_hang']) ? (int) $line['nid_khach_hang'] : (!empty($common['nid_khach_hang']) ? (int) $common['nid_khach_hang'] : 0);
  $record['so_bkg'] = !empty($line['so_bkg']) ? trim($line['so_bkg']) : '';
  $record['nid_lai_xe'] = !empty($line['nid_lai_xe']) ? (int) $line['nid_lai_xe'] : 0;
  $record['nid_phuong_tien'] = !empty($line['nid_phuong_tien']) ? (int) $line['nid_phuong_tien'] : 0;
  $record['nid_mooc'] = !empty($line['nid_mooc']) ? (int) $line['nid_mooc'] : 0;
  $record['dia_chi_kho'] = !empty($line['dia_chi_kho']) ? trim($line['dia_chi_kho']) : '';
  $record['loai_cont'] = !empty($line['loai_cont']) ? trim($line['loai_cont']) : '';
  $record['loai_hang'] = !empty($line['loai_hang']) ? trim((string) $line['loai_hang']) : '';
  $record['so_cont'] = !empty($line['so_cont']) ? trim($line['so_cont']) : '';
  $record['so_seal_chinh'] = !empty($line['so_seal_chinh']) ? trim($line['so_seal_chinh']) : '';
  $record['so_seal_tam'] = !empty($line['so_seal_tam']) ? trim($line['so_seal_tam']) : '';
  $is_tuyen_xa = !empty($common['loai_ke_hoach']) && $common['loai_ke_hoach'] === 'tuyen_xa';
  $record['trang_thai_van_chuyen'] = !empty($line['trang_thai_van_chuyen']) ? trim($line['trang_thai_van_chuyen']) : ($is_tuyen_xa ? 'Chưa xếp xe' : 'Chờ duyệt');
  $record['bai_lay_cont'] = !empty($line['bai_lay_cont']) ? trim($line['bai_lay_cont']) : '';
  $record['bai_lay_thuc_te'] = !empty($line['bai_lay_thuc_te']) ? trim($line['bai_lay_thuc_te']) : '';
  $record['bai_ha_cont'] = !empty($line['bai_ha_cont']) ? trim($line['bai_ha_cont']) : '';
  $record['bai_ha_thuc_te'] = !empty($line['bai_ha_thuc_te']) ? trim($line['bai_ha_thuc_te']) : '';
  $record['cang_xuat'] = !empty($line['cang_xuat']) ? trim($line['cang_xuat']) : '';
  $record['cut_off'] = !empty($line['cut_off']) ? _ke_hoach_xep_xe_normalize_datetime($line['cut_off']) : '';
  $record['ngay_bat_dau'] = !empty($line['ngay_bat_dau']) ? substr(_ke_hoach_xep_xe_filter_date($line['ngay_bat_dau']), 0, 10) : '';
  $record['ngay_gio_ke_hoach'] = !empty($line['ngay_gio_ke_hoach']) ? _ke_hoach_xep_xe_normalize_datetime($line['ngay_gio_ke_hoach']) : '';
  $record['ngay_ket_thuc'] = !empty($line['ngay_ket_thuc']) ? substr(_ke_hoach_xep_xe_filter_date($line['ngay_ket_thuc']), 0, 10) : '';
  $record['hinh_thuc_van_tai'] = !empty($line['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($line['hinh_thuc_van_tai']) : '';
  $record['ke_hoach_cont_ref_nid'] = !empty($line['ke_hoach_cont_ref_nid']) ? (int) $line['ke_hoach_cont_ref_nid'] : 0;
  $record['nid_ke_hoach_nguon'] = !empty($line['nid_ke_hoach_nguon']) ? (int) $line['nid_ke_hoach_nguon'] : 0;
  $record['da_cat_mooc'] = !empty($line['da_cat_mooc']) ? 1 : 0;
  $record['da_du_hang'] = !empty($line['da_du_hang']) ? 1 : 0;
  // Bãi hạ ngoài (hàng cảng): tên bãi; rỗng = không hạ bãi ngoài.
  $record['bai_ha_ngoai'] = !empty($line['bai_ha_ngoai']) ? trim((string) $line['bai_ha_ngoai']) : '';
  $record['ha_cang'] = !empty($line['ha_cang']) ? 1 : 0;
  $json = !empty($line['thong_tin_json']) && is_array($line['thong_tin_json']) ? $line['thong_tin_json'] : array();
  if (isset($line['ghi_chu'])) {
    $json['ghi_chu'] = trim((string) $line['ghi_chu']);
  }
  // Keep the cargo type in thong_tin_json as the canonical fallback for
  // installations where the optional loai_hang column has not been added yet.
  $json['loai_hang'] = $record['loai_hang'];
  if (isset($line['tang_bo'])) {
    $json['tang_bo'] = _ke_hoach_xep_xe_normalize_tang_bo($line['tang_bo']);
  }
  if (isset($line['ket_hop'])) {
    $json['ket_hop'] = !empty($json['vai_tro_ke_hoach'])
      ? _ke_hoach_xep_xe_normalize_ket_hop($line['ket_hop'])
      : array('enabled' => !empty($line['ket_hop']['enabled']) ? 1 : 0);
  }
  // Keep the JSON mirror consistent with the canonical relation used by the
  // backend and future công nợ reports.
  $role_item = $record;
  $role_item['thong_tin_json'] = $json;
  $json['vai_tro_ke_hoach'] = _ke_hoach_xep_xe_plan_role($role_item);
  $record['thong_tin_json'] = !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '';
  return $record;
}

function _ke_hoach_xep_xe_validate_common($input) {
  if (empty($input['nid_khach_hang'])) {
    return _ke_hoach_xep_xe_fail('Khách hàng bắt buộc');
  }
  return NULL;
}

function _ke_hoach_xep_xe_validate_lines($items, $require_vehicle_driver = TRUE, $require_container = TRUE, $require_booking = TRUE) {
  if (empty($items) || !is_array($items)) {
    return _ke_hoach_xep_xe_fail('Danh sách phương tiện bắt buộc');
  }

  $allowed = _ke_hoach_xep_xe_hinh_thuc_options();

  foreach ($items as $index => $item) {
    $line_no = $index + 1;
    if ($require_booking && empty($item['so_bkg'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số BKG bắt buộc');
    }
    if ($require_vehicle_driver && empty($item['nid_phuong_tien'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': phương tiện bắt buộc');
    }
    if ($require_container && empty($item['so_cont'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': số cont bắt buộc');
    }
    if ($require_vehicle_driver && empty($item['nid_lai_xe'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': lái xe bắt buộc');
    }

    $hinh_thuc_van_tai = !empty($item['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($item['hinh_thuc_van_tai']) : '';
    if ($hinh_thuc_van_tai && !in_array($hinh_thuc_van_tai, $allowed, TRUE)) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải không hợp lệ');
    }
  }

  return NULL;
}

/**
 * Lộ trình tuyến xa là danh sách điểm có thứ tự. Không dùng tên địa điểm làm
 * khóa vì một địa điểm (ví dụ cửa khẩu) có thể xuất hiện nhiều lần.
 */
function _ke_hoach_xep_xe_tuyen_xa_route_points($row) {
  $row = (array) $row;
  $json = _ke_hoach_xep_xe_json_decode(isset($row['thong_tin_json']) ? $row['thong_tin_json'] : '');
  $raw = array(
    array('key' => 'bai_lay', 'label' => 'Bãi lấy', 'value' => !empty($row['bai_lay_thuc_te']) ? $row['bai_lay_thuc_te'] : (!empty($row['bai_lay_cont']) ? $row['bai_lay_cont'] : '')),
    array('key' => 'bai_ha_tam_1', 'label' => 'Bãi hạ tạm 1', 'value' => !empty($json['bai_ha_tam_1_enabled']) ? (!empty($json['bai_ha_tam_1']) ? $json['bai_ha_tam_1'] : '') : ''),
    array('key' => 'kho', 'label' => 'Kho', 'value' => !empty($row['dia_chi_kho']) ? $row['dia_chi_kho'] : ''),
    array('key' => 'bai_ha_tam_2', 'label' => 'Bãi hạ tạm 2', 'value' => !empty($json['bai_ha_tam_2_enabled']) ? (!empty($json['bai_ha_tam_2']) ? $json['bai_ha_tam_2'] : '') : ''),
    array('key' => 'bai_ha', 'label' => 'Bãi hạ', 'value' => !empty($row['bai_ha_thuc_te']) ? $row['bai_ha_thuc_te'] : (!empty($row['bai_ha_cont']) ? $row['bai_ha_cont'] : '')),
  );
  $points = array();
  foreach ($raw as $point) {
    if ($point['value'] !== '') {
      $point['index'] = count($points);
      $points[] = $point;
    }
  }
  return $points;
}

function _ke_hoach_xep_xe_tuyen_xa_route_segments($row) {
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($row);
  $segments = array();
  for ($i = 0; $i + 1 < count($points); $i++) {
    $key = $points[$i]['key'] . '>' . $points[$i + 1]['key'];
    $segments[] = array(
      'key' => $key,
      'from_index' => $i,
      'to_index' => $i + 1,
      'from' => $points[$i]['value'],
      'to' => $points[$i + 1]['value'],
    );
  }
  return $segments;
}

function _ke_hoach_xep_xe_tuyen_xa_current_point_index($row) {
  $row = (array) $row;
  $json = _ke_hoach_xep_xe_json_decode(isset($row['thong_tin_json']) ? $row['thong_tin_json'] : '');
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($row);
  if (!$points) return -1;
  if (isset($json['vi_tri_cont_index_hien_tai']) && is_numeric($json['vi_tri_cont_index_hien_tai'])) {
    $index = (int) $json['vi_tri_cont_index_hien_tai'];
    if (isset($points[$index])) return $index;
  }
  $location = !empty($json['vi_tri_cont_hien_tai']) ? $json['vi_tri_cont_hien_tai'] : (!empty($row['bai_ha_thuc_te']) ? $row['bai_ha_thuc_te'] : '');
  if ($location !== '') {
    $matches = array();
    foreach ($points as $point) if ($point['value'] === $location) $matches[] = $point['index'];
    if ($matches) return !empty($row['da_du_hang']) ? end($matches) : reset($matches);
  }
  return 0;
}

function _ke_hoach_xep_xe_cont_current_location($row) {
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($row);
  $index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($row);
  return isset($points[$index]['value']) ? $points[$index]['value'] : '';
}

function _ke_hoach_xep_xe_cont_next_location($row) {
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($row);
  $index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($row);
  return isset($points[$index + 1]['value']) ? $points[$index + 1]['value'] : '';
}

function _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($row) {
  $row = (array) $row;
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($row);
  if (count($points) < 2) return 0;
  $kho_index = -1;
  foreach ($points as $point) {
    if ($point['key'] === 'kho') $kho_index = (int) $point['index'];
  }
  if ($kho_index < 0) return 1;
  $hinh_thuc = !empty($row['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($row['hinh_thuc_van_tai']) : '';
  if ($hinh_thuc === 'dong_hang') return min(count($points) - 1, $kho_index + 1);
  $json = _ke_hoach_xep_xe_json_decode(isset($row['thong_tin_json']) ? $row['thong_tin_json'] : '');
  return !empty($json['bai_ha_tam_1_enabled']) && !empty($json['bai_ha_tam_1']) ? 1 : $kho_index;
}

function _ke_hoach_xep_xe_normalize_tuyen_xa_route_json(&$record) {
  $json = _ke_hoach_xep_xe_json_decode(isset($record['thong_tin_json']) ? $record['thong_tin_json'] : '');
  $record['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($record);
  $index = isset($json['vi_tri_cont_index_hien_tai']) && is_numeric($json['vi_tri_cont_index_hien_tai']) ? (int) $json['vi_tri_cont_index_hien_tai'] : _ke_hoach_xep_xe_tuyen_xa_current_point_index($record);
  if (!isset($points[$index])) $index = 0;
  $json['vi_tri_cont_index_hien_tai'] = $index;
  $json['vi_tri_cont_hien_tai'] = isset($points[$index]['value']) ? $points[$index]['value'] : '';
  if (!empty($record['ke_hoach_cont_ref_nid'])) {
    $source = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => (int) $record['ke_hoach_cont_ref_nid'], ':loai' => 'tuyen_xa'))->fetch();
    $start = isset($json['cont_thuc_hien_tu_index']) ? (int) $json['cont_thuc_hien_tu_index'] : -1;
    $end = isset($json['cont_thuc_hien_den_index']) ? (int) $json['cont_thuc_hien_den_index'] : -1;
    if ($source && $start >= 0 && $end > $start) {
      $source_points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
      $source_segments = _ke_hoach_xep_xe_tuyen_xa_route_segments($source);
      $json['cont_thuc_hien_chang'] = array_slice($source_segments, $start, $end - $start);
      $json['cont_keo_ve_tu'] = isset($source_points[$start]['value']) ? $source_points[$start]['value'] : '';
      $json['cont_keo_ve_den'] = isset($source_points[$end]['value']) ? $source_points[$end]['value'] : '';
    }
  }
  $record['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
}

function _ke_hoach_xep_xe_tuyen_xa_service_range($plan, $source) {
  $plan = (array) $plan;
  $json = _ke_hoach_xep_xe_json_decode(isset($plan['thong_tin_json']) ? $plan['thong_tin_json'] : '');
  if (isset($json['cont_thuc_hien_tu_index']) && isset($json['cont_thuc_hien_den_index'])) {
    $start = (int) $json['cont_thuc_hien_tu_index'];
    $end = (int) $json['cont_thuc_hien_den_index'];
    if ($start >= 0 && $end > $start) return array('start' => $start, 'end' => $end);
  }
  $from = !empty($json['cont_keo_ve_tu']) ? trim((string) $json['cont_keo_ve_tu']) : '';
  $to = !empty($json['cont_keo_ve_den']) ? trim((string) $json['cont_keo_ve_den']) : '';
  if ($from === '' || $to === '') return NULL;
  $points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
  for ($i = 0; $i + 1 < count($points); $i++) {
    if ($points[$i]['value'] === $from && $points[$i + 1]['value'] === $to) {
      return array('start' => $i, 'end' => $i + 1);
    }
  }
  return NULL;
}

function _ke_hoach_xep_xe_tuyen_xa_ket_hop($row) {
  $row = (array) $row;
  $json = _ke_hoach_xep_xe_json_decode(isset($row['thong_tin_json']) ? $row['thong_tin_json'] : '');
  return _ke_hoach_xep_xe_normalize_ket_hop(!empty($json['ket_hop']) ? $json['ket_hop'] : array());
}

function _ke_hoach_xep_xe_tuyen_xa_ket_hop_range($row) {
  $ket_hop = _ke_hoach_xep_xe_tuyen_xa_ket_hop($row);
  $start = (int) $ket_hop['cont_thuc_hien_tu_index'];
  $end = (int) $ket_hop['cont_thuc_hien_den_index'];
  return !empty($ket_hop['enabled']) && !empty($ket_hop['ke_hoach_cont_ref_nid']) && $start >= 0 && $end > $start
    ? array('start' => $start, 'end' => $end)
    : NULL;
}

/**
 * Các dải chặng đang được giữ bởi kế hoạch khác. Công việc chính và cont kéo
 * về là hai nhiệm vụ độc lập nên chỉ giữ chặng cho tới khi chính nhiệm vụ đó
 * được hoàn thành.
 */
function _ke_hoach_xep_xe_tuyen_xa_active_assignments($source_id, $exclude_id = 0) {
  $source = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => (int) $source_id, ':loai' => 'tuyen_xa'))->fetch();
  if (!$source) return array();
  $query = db_select('ke_hoach_xep_xe', 'kh')
    ->fields('kh', array('nid', 'so_bkg', 'so_cont', 'ke_hoach_cont_ref_nid', 'trang_thai_van_chuyen', 'thong_tin_json'))
    ->condition('kh.hoat_dong', 1)
    ->condition('kh.loai_ke_hoach', 'tuyen_xa');
  if ($exclude_id) $query->condition('kh.nid', (int) $exclude_id, '<>');
  $assignments = array();
  foreach ($query->execute()->fetchAll() as $plan) {
    $json = _ke_hoach_xep_xe_json_decode($plan->thong_tin_json);
    if ((int) $plan->ke_hoach_cont_ref_nid === (int) $source_id) {
      $is_done = array_key_exists('cong_viec_chinh_hoan_thanh', $json)
        ? !empty($json['cong_viec_chinh_hoan_thanh'])
        : $plan->trang_thai_van_chuyen === 'Hoàn thành';
      if (!$is_done) {
        $range = _ke_hoach_xep_xe_tuyen_xa_service_range($plan, $source);
        if ($range) $assignments[] = array('nid' => (int) $plan->nid, 'type' => 'cong_viec_chinh', 'start' => $range['start'], 'end' => $range['end'], 'so_bkg' => $plan->so_bkg, 'so_cont' => $plan->so_cont);
      }
    }
    $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($json['ket_hop']) ? $json['ket_hop'] : array());
    if (!empty($ket_hop['enabled']) && empty($ket_hop['hoan_thanh']) && (int) $ket_hop['ke_hoach_cont_ref_nid'] === (int) $source_id) {
      $range = _ke_hoach_xep_xe_tuyen_xa_ket_hop_range($plan);
      if ($range) $assignments[] = array('nid' => (int) $plan->nid, 'type' => 'cont_keo_ve', 'start' => $range['start'], 'end' => $range['end'], 'so_bkg' => $plan->so_bkg, 'so_cont' => $plan->so_cont);
    }
  }
  return $assignments;
}

function _ke_hoach_xep_xe_tuyen_xa_ranges_overlap($start, $end, $other_start, $other_end) {
  return $start < $other_end && $end > $other_start;
}

function _ke_hoach_xep_xe_validate_tuyen_xa_json($items) {
  foreach ((array) $items as $index => $item) {
    $json = !empty($item['thong_tin_json']) && is_array($item['thong_tin_json']) ? $item['thong_tin_json'] : array();
    $line_no = $index + 1;
    if (empty($item['bai_lay_cont']) || empty($item['dia_chi_kho']) || empty($item['bai_ha_cont'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': tuyến xa bắt buộc có bãi lấy, kho và bãi hạ');
    }
    if (!empty($json['bai_ha_tam_1_enabled']) && empty($json['bai_ha_tam_1'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': vui lòng chọn bãi hạ tạm 1');
    }
    if (!empty($json['bai_ha_tam_2_enabled']) && empty($json['bai_ha_tam_2'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': vui lòng chọn bãi hạ tạm 2');
    }
    $role = _ke_hoach_xep_xe_plan_role($item);
    if ($role === 'thuc_hien_chang' && empty($item['ke_hoach_cont_ref_nid'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': vui lòng chọn kế hoạch gốc và dải chặng thực hiện');
    }
    if ($role === 'ke_hoach_goc' && !empty($item['ke_hoach_cont_ref_nid'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': kế hoạch gốc không được tham chiếu cont nguồn khác');
    }
    $hinh_thuc = !empty($item['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($item['hinh_thuc_van_tai']) : '';
    if ($role === 'ke_hoach_goc' && $hinh_thuc === '') {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': kế hoạch gốc bắt buộc chọn hình thức vận tải');
    }
    if ($role === 'ke_hoach_goc' && $hinh_thuc === 'dong_hang' && !empty($json['bai_ha_tam_1_enabled'])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': kế hoạch gốc đóng hàng không sử dụng bãi hạ tạm 1');
    }
  }
  return NULL;
}

/**
 * Điều kiện SQL loại kế hoạch hàng cảng đã huỷ (dùng khi xác định ai đang kéo một cont).
 */
function _ke_hoach_port_not_cancelled_sql() {
  return " AND COALESCE(trang_thai_van_chuyen, '') <> 'Đã huỷ'";
}

/**
 * Kế hoạch A bị huỷ hoặc xoá thì cont kéo về B được giải phóng: nếu B đang "Đang kéo về"
 * vì A thì trả B về trạng thái ở kho (Đủ hàng nếu đã đánh dấu đủ hàng, không thì Đã cắt mooc).
 * Không đụng tới B khi còn kế hoạch khác đang kéo B.
 */
function _ke_hoach_port_release_ref_cont($plan) {
  $plan = (object) $plan;
  if (!_ke_hoach_xep_xe_has_cont_status_field() || empty($plan->ke_hoach_cont_ref_nid)) {
    return;
  }
  $ref = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => (int) $plan->ke_hoach_cont_ref_nid))->fetch();
  if (!$ref || (string) $ref->trang_thai_cont !== 'Đang kéo về') {
    return;
  }
  $other = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :ref AND hoat_dong = 1 AND nid <> :self" . _ke_hoach_port_not_cancelled_sql(), array(':ref' => (int) $ref->nid, ':self' => (int) $plan->nid))->fetchField();
  if ($other) {
    return;
  }
  db_update('ke_hoach_xep_xe')->fields(array(
    'trang_thai_cont' => !empty($ref->da_du_hang) ? 'Đủ hàng' : 'Đã cắt mooc',
    'changed' => _ke_hoach_xep_xe_now(),
  ))->condition('nid', (int) $ref->nid)->execute();
}

/**
 * Kiểm tra cont kéo về được chọn cho một kế hoạch hàng cảng (chỉ khi chọn cont mới hoặc đổi cont).
 *
 * - Cont phải là kế hoạch hàng cảng còn hoạt động, chưa huỷ, có cont ở kho.
 * - Cont phải đang ở kho: Đã cắt mooc hoặc Đủ hàng.
 * - Cắt kéo: cùng kho với cont. Cắt kéo chéo: khác kho với cont. Rút mooc: không ràng buộc kho.
 *
 * @return array|null
 *   Phản hồi lỗi, hoặc NULL nếu hợp lệ.
 */
function _ke_hoach_port_validate_return_cont($item, $line_no, $current_ref_id = 0) {
  $ref_id = !empty($item['ke_hoach_cont_ref_nid']) ? (int) $item['ke_hoach_cont_ref_nid'] : 0;
  if (!$ref_id || $ref_id === (int) $current_ref_id) {
    return NULL;
  }
  $prefix = 'Dòng #' . $line_no . ': ';
  $ref = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $ref_id))->fetch();
  if (!$ref || (!empty($ref->loai_ke_hoach) && $ref->loai_ke_hoach !== 'thuong')) {
    return _ke_hoach_xep_xe_fail($prefix . 'cont kéo về không tồn tại hoặc không phải kế hoạch hàng cảng');
  }
  if (empty($ref->da_cat_mooc)) {
    return _ke_hoach_xep_xe_fail($prefix . 'kế hoạch được chọn không có cont ở kho');
  }
  if ((string) $ref->trang_thai_van_chuyen === 'Đã huỷ') {
    return _ke_hoach_xep_xe_fail($prefix . 'kế hoạch của cont kéo về đã huỷ');
  }
  // Trạng thái cont (phải Đã cắt mooc/Đủ hàng) KHÔNG chặn lúc lưu: lưu chỉ là lập kế hoạch trước.
  // Chỉ chặn khi chạy xe, ở bước "Thực hiện kéo về" (_ke_hoach_port_keo_ve_blocker).
  $hinh_thuc = !empty($item['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($item['hinh_thuc_van_tai']) : '';
  $item_kho = !empty($item['dia_chi_kho']) ? trim((string) $item['dia_chi_kho']) : '';
  $ref_kho = trim((string) $ref->dia_chi_kho);
  if ($item_kho !== '') {
    if ($hinh_thuc === 'cat_keo' && $item_kho !== $ref_kho) {
      return _ke_hoach_xep_xe_fail($prefix . 'cắt kéo phải cùng kho với cont kéo về (kho của cont: ' . $ref_kho . ')');
    }
    if ($hinh_thuc === 'cat_keo_cheo' && $item_kho === $ref_kho) {
      return _ke_hoach_xep_xe_fail($prefix . 'cắt kéo chéo phải khác kho với cont kéo về (kho của cont: ' . $ref_kho . ')');
    }
  }
  return NULL;
}

function _ke_hoach_xep_xe_validate_cont_refs($items, $exclude_id = 0, $is_tuyen_xa = FALSE, $current_ref_id = 0) {
  if (empty($items) || !is_array($items)) {
    return NULL;
  }
  $seen = array();
  foreach ($items as $index => $item) {
    $line_no = $index + 1;
    $ref_id = !empty($item['ke_hoach_cont_ref_nid']) ? (int) $item['ke_hoach_cont_ref_nid'] : 0;
    if (!$ref_id && !$is_tuyen_xa) {
      // Rút mooc, cắt kéo và cắt kéo chéo có thể lưu khi chưa chọn cont (lập kế hoạch
      // trước). Chuyến chỉ bị khoá ở bước "Thực hiện kéo về" cho tới khi chọn cont.
      continue;
    }
    $hinh_thuc = !empty($item['hinh_thuc_van_tai']) ? trim((string) $item['hinh_thuc_van_tai']) : '';
    $allowed_ref_types = $is_tuyen_xa
      ? array('cat_keo', 'cat_keo_cheo', 'rut_mooc', 'tha_mooc', 'dong_hang')
      : array('cat_keo', 'cat_keo_cheo', 'rut_mooc');
    if ($ref_id && !in_array($hinh_thuc, $allowed_ref_types, TRUE)) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải không được chọn ' . ($is_tuyen_xa ? 'kế hoạch nguồn' : 'cont kéo về'));
    }
    if (!$is_tuyen_xa && !empty($seen[$ref_id])) {
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': cont kéo về đã được chọn ở dòng #' . $seen[$ref_id]);
    }
    if (!$is_tuyen_xa) $seen[$ref_id] = $line_no;

    if ($is_tuyen_xa && $ref_id) {
      if ($exclude_id && $ref_id === (int) $exclude_id) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': kế hoạch không thể tự chọn chính nó làm kế hoạch nguồn');
      }
      $source = db_query("SELECT nid, so_cont, dia_chi_kho, bai_lay_cont, bai_lay_thuc_te, bai_ha_cont, bai_ha_thuc_te, trang_thai_van_chuyen, da_du_hang, thong_tin_json, ke_hoach_cont_ref_nid FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => $ref_id, ':loai' => 'tuyen_xa'))->fetch();
      if (!$source) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': kế hoạch nguồn của cont không tồn tại hoặc không phải kế hoạch tuyến xa');
      }
      $source_json = _ke_hoach_xep_xe_json_decode($source->thong_tin_json);
      $source_role = _ke_hoach_xep_xe_plan_role($source);
      if ($source_role !== 'ke_hoach_goc') {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': chỉ được nhận chặng từ kế hoạch gốc');
      }
      $line_json = !empty($item['thong_tin_json']) && is_array($item['thong_tin_json']) ? $item['thong_tin_json'] : array();
      $segments = _ke_hoach_xep_xe_tuyen_xa_route_segments($source);
      $start = isset($line_json['cont_thuc_hien_tu_index']) ? (int) $line_json['cont_thuc_hien_tu_index'] : -1;
      $end = isset($line_json['cont_thuc_hien_den_index']) ? (int) $line_json['cont_thuc_hien_den_index'] : -1;
      if ($start < 0 || $end <= $start || $end > count($segments)) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': chưa chọn đúng dải chặng cont cần thực hiện');
      }
      $source_points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
      if ($end - $start > 2 || ($end - $start === 2 && (!isset($source_points[$start + 1]) || $source_points[$start + 1]['key'] !== 'kho'))) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': công việc chính chỉ gồm 2 điểm, hoặc 3 điểm đóng hàng với Kho ở giữa');
      }
      if (($end - $start === 2 && $hinh_thuc !== 'dong_hang') || ($end - $start === 1 && $hinh_thuc === 'dong_hang')) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải không khớp số điểm của công việc chính');
      }
      if (!empty($seen[$ref_id])) {
        foreach ($seen[$ref_id] as $seen_range) {
          if ($start < $seen_range['end'] && $end > $seen_range['start']) {
            return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': dải chặng cont trùng với dòng #' . $seen_range['line']);
          }
        }
      }
      $seen[$ref_id][] = array('start' => $start, 'end' => $end, 'line' => $line_no);
      $current_index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($source);
      $minimum_start = $current_index;
      if ($source_role === 'ke_hoach_goc' && empty($source_json['cong_viec_chinh_hoan_thanh'])) {
        $minimum_start = max($minimum_start, _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($source));
      }
      if (empty($line_json['cong_viec_chinh_hoan_thanh']) && $start < $minimum_start) {
        return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': chặng cont đã nằm trước vị trí hiện tại');
      }

      foreach (_ke_hoach_xep_xe_tuyen_xa_active_assignments($ref_id, $exclude_id) as $used) {
        if (_ke_hoach_xep_xe_tuyen_xa_ranges_overlap($start, $end, $used['start'], $used['end'])) {
          $label = !empty($used['so_bkg']) ? $used['so_bkg'] : ('#' . $used['nid']);
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': dải chặng cont đã được kế hoạch ' . $label . ' nhận thực hiện');
        }
      }
    }

    if ($is_tuyen_xa) {
      $line_json = !empty($item['thong_tin_json']) && is_array($item['thong_tin_json']) ? $item['thong_tin_json'] : array();
      $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($item['ket_hop']) ? $item['ket_hop'] : (!empty($line_json['ket_hop']) ? $line_json['ket_hop'] : array()));
      if (!empty($ket_hop['enabled'])) {
        if (!in_array($hinh_thuc, array('cat_keo', 'cat_keo_cheo', 'rut_mooc'), TRUE)) {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': hình thức vận tải này không được chọn cont kéo về');
        }
        $return_ref_id = (int) $ket_hop['ke_hoach_cont_ref_nid'];
        if (!$return_ref_id || ($exclude_id && $return_ref_id === (int) $exclude_id)) {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': cont kéo về không hợp lệ');
        }
        if ($ref_id && $return_ref_id === $ref_id) {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': cont kéo về phải khác cont của công việc chính');
        }
        $return_source = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => $return_ref_id, ':loai' => 'tuyen_xa'))->fetch();
        if (!$return_source) return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': không tìm thấy kế hoạch gốc của cont kéo về');
        $return_source_json = _ke_hoach_xep_xe_json_decode($return_source->thong_tin_json);
        if (_ke_hoach_xep_xe_plan_role($return_source) === 'thuc_hien_chang') {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': cont kéo về phải thuộc kế hoạch gốc');
        }
        $return_points = _ke_hoach_xep_xe_tuyen_xa_route_points($return_source);
        $return_start = (int) $ket_hop['cont_thuc_hien_tu_index'];
        $return_end = (int) $ket_hop['cont_thuc_hien_den_index'];
        if ($return_start < 0 || $return_end <= $return_start || !isset($return_points[$return_end])) {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': dải chặng cont kéo về không hợp lệ');
        }
        $main_end = '';
        if ($ref_id && isset($source)) {
          $main_points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
          $main_end = isset($main_points[$end]['value']) ? $main_points[$end]['value'] : '';
        }
        else {
          $own_record = _ke_hoach_xep_xe_build_record(array(), $item);
          $own_points = _ke_hoach_xep_xe_tuyen_xa_route_points($own_record);
          $own_end = _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($own_record);
          $main_end = isset($own_points[$own_end]['value']) ? $own_points[$own_end]['value'] : '';
        }
        if ($main_end === '' || $return_points[$return_start]['value'] !== $main_end) {
          return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': điểm lấy cont kéo về phải trùng điểm kết thúc công việc chính');
        }
        $return_current = _ke_hoach_xep_xe_tuyen_xa_current_point_index($return_source);
        $return_minimum = $return_current;
        if (empty($return_source_json['cong_viec_chinh_hoan_thanh'])) {
          $return_minimum = max($return_minimum, _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($return_source));
        }
        if (empty($ket_hop['hoan_thanh']) && $return_start < $return_minimum) return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': chặng cont kéo về đã nằm trước vị trí hiện tại');
        if (!empty($seen[$return_ref_id])) {
          foreach ($seen[$return_ref_id] as $seen_range) {
            if (_ke_hoach_xep_xe_tuyen_xa_ranges_overlap($return_start, $return_end, $seen_range['start'], $seen_range['end'])) {
              return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': dải chặng cont kéo về bị trùng trong lần xếp xe này');
            }
          }
        }
        foreach (_ke_hoach_xep_xe_tuyen_xa_active_assignments($return_ref_id, $exclude_id) as $used) {
          if (_ke_hoach_xep_xe_tuyen_xa_ranges_overlap($return_start, $return_end, $used['start'], $used['end'])) {
            return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': dải chặng cont kéo về đã được kế hoạch #' . $used['nid'] . ' nhận');
          }
        }
        $seen[$return_ref_id][] = array('start' => $return_start, 'end' => $return_end, 'line' => $line_no);
      }
      continue;
    }

    if (!$is_tuyen_xa && ($return_error = _ke_hoach_port_validate_return_cont($item, $line_no, $current_ref_id))) {
      return $return_error;
    }

    $query = db_select('ke_hoach_xep_xe', 'kh')
      ->fields('kh', array('nid', 'so_bkg', 'so_cont'))
      ->condition('kh.ke_hoach_cont_ref_nid', $ref_id)
      ->condition('kh.hoat_dong', 1);
    if ($exclude_id) {
      $query->condition('kh.nid', (int) $exclude_id, '<>');
    }
    if ($is_tuyen_xa) {
      $query->condition('kh.trang_thai_van_chuyen', 'Hoàn thành', '<>');
    }
    else {
      // Kế hoạch hàng cảng đã huỷ không còn giữ chỗ cont (khớp với danh sách chọn cont).
      $query->condition(db_or()->isNull('kh.trang_thai_van_chuyen')->condition('kh.trang_thai_van_chuyen', 'Đã huỷ', '<>'));
    }
    $used = $query->execute()->fetch();
    if ($used) {
      $label = !empty($used->so_bkg) ? $used->so_bkg : ('#' . $used->nid);
      if (!empty($used->so_cont)) {
        $label .= ' / ' . $used->so_cont;
      }
      return _ke_hoach_xep_xe_fail('Dòng #' . $line_no . ': cont kéo về đã được dùng bởi kế hoạch ' . $label);
    }
  }
  return NULL;
}

function _ke_hoach_xep_xe_related_summary($row) {
  if (!$row) {
    return NULL;
  }
  $item = (array) $row;
  return array(
    'nid' => !empty($item['nid']) ? (int) $item['nid'] : 0,
    'so_bkg' => !empty($item['so_bkg']) ? $item['so_bkg'] : '',
    'so_cont' => !empty($item['so_cont']) ? $item['so_cont'] : '',
    'dia_chi_kho' => !empty($item['dia_chi_kho']) ? $item['dia_chi_kho'] : '',
    'bai_lay_cont' => !empty($item['bai_lay_cont']) ? $item['bai_lay_cont'] : '',
    'bai_lay_thuc_te' => !empty($item['bai_lay_thuc_te']) ? $item['bai_lay_thuc_te'] : '',
    'bai_ha_cont' => !empty($item['bai_ha_cont']) ? $item['bai_ha_cont'] : '',
    'bai_ha_thuc_te' => !empty($item['bai_ha_thuc_te']) ? $item['bai_ha_thuc_te'] : '',
    'bai_ha_ngoai' => !empty($item['bai_ha_ngoai']) ? $item['bai_ha_ngoai'] : '',
  );
}

/**
 * Nạp sẵn dữ liệu liên quan cho cả trang danh sách bằng vài truy vấn IN (...)
 * thay vì 4-6 truy vấn cho mỗi dòng. Kết quả truyền vào
 * _ke_hoach_xep_xe_enrich_row() qua $options['cache'].
 *
 * Chỉ dùng cho related_mode = 'full' (mặc định) — cùng tập cột mà nhánh không
 * cache đang trả về.
 */
function _ke_hoach_xep_xe_enrich_cache(array $rows) {
  $cache = array('khach_hang' => array(), 'lai_xe' => array(), 'phuong_tien' => array(), 'cont_ref' => array(), 'keo_ve' => array(), 'referenced' => array());
  if (!$rows) {
    return $cache;
  }
  $plan_ids = array();
  $ref_ids = array();
  foreach ($rows as $row) {
    $plan_ids[(int) $row->nid] = (int) $row->nid;
    if (!empty($row->ke_hoach_cont_ref_nid)) {
      $ref_ids[(int) $row->ke_hoach_cont_ref_nid] = (int) $row->ke_hoach_cont_ref_nid;
    }
  }

  // Kế hoạch được chọn làm cont kéo về (cont_ref) và kế hoạch kéo cont này về.
  $related_rows = array();
  if ($ref_ids) {
    foreach (db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid IN (:ids) AND hoat_dong = 1", array(':ids' => array_values($ref_ids))) as $ref) {
      $cache['cont_ref'][(int) $ref->nid] = $ref;
      $related_rows[] = $ref;
    }
  }
  foreach (db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid IN (:ids) AND hoat_dong = 1" . _ke_hoach_port_not_cancelled_sql() . " ORDER BY nid DESC", array(':ids' => array_values($plan_ids))) as $keo_ve) {
    $key = (int) $keo_ve->ke_hoach_cont_ref_nid;
    if (!isset($cache['keo_ve'][$key])) {
      $cache['keo_ve'][$key] = $keo_ve;
      $related_rows[] = $keo_ve;
    }
  }

  // Các dòng lồng nhau được enrich với with_related = FALSE, cần biết cont của
  // chúng có đang được kế hoạch khác chọn hay không.
  $all_rows = array_merge($rows, $related_rows);
  $all_ids = array();
  $customer_ids = array();
  $driver_ids = array();
  $vehicle_ids = array();
  foreach ($all_rows as $row) {
    $all_ids[(int) $row->nid] = (int) $row->nid;
    if (!empty($row->nid_khach_hang)) $customer_ids[(int) $row->nid_khach_hang] = (int) $row->nid_khach_hang;
    if (!empty($row->nid_lai_xe)) $driver_ids[(int) $row->nid_lai_xe] = (int) $row->nid_lai_xe;
    if (!empty($row->nid_phuong_tien)) $vehicle_ids[(int) $row->nid_phuong_tien] = (int) $row->nid_phuong_tien;
    if (!empty($row->nid_mooc)) $vehicle_ids[(int) $row->nid_mooc] = (int) $row->nid_mooc;
  }
  foreach (db_query("SELECT DISTINCT ke_hoach_cont_ref_nid FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid IN (:ids) AND hoat_dong = 1" . _ke_hoach_port_not_cancelled_sql(), array(':ids' => array_values($all_ids))) as $referenced) {
    $cache['referenced'][(int) $referenced->ke_hoach_cont_ref_nid] = TRUE;
  }
  if ($customer_ids) {
    foreach (db_query("SELECT nid, ten, ma_kh, phan_loai, cccd_mst, sdt, dia_chi, dob, ghi_chu FROM {khach_hang} WHERE nid IN (:ids)", array(':ids' => array_values($customer_ids))) as $kh) {
      $cache['khach_hang'][(int) $kh->nid] = (array) $kh;
    }
  }
  if ($driver_ids) {
    foreach (db_query("SELECT nid, ten, ma_nhan_vien, sdt, cccd, so_bang_lai, loai_bang_lai, han_bang_lai FROM {lai_xe} WHERE nid IN (:ids)", array(':ids' => array_values($driver_ids))) as $lx) {
      $cache['lai_xe'][(int) $lx->nid] = (array) $lx;
    }
  }
  if ($vehicle_ids) {
    foreach (db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid IN (:ids)", array(':ids' => array_values($vehicle_ids))) as $pt) {
      $cache['phuong_tien'][(int) $pt->nid] = (array) $pt;
    }
  }
  return $cache;
}

function _ke_hoach_xep_xe_enrich_row($row, $with_related = TRUE, array $options = array()) {
  $related_mode = !empty($options['related_mode']) ? $options['related_mode'] : 'full';
  $result = (array) $row;
  $result['hinh_thuc_van_tai'] = !empty($result['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($result['hinh_thuc_van_tai']) : '';
  $nid_khach_hang = !empty($result['nid_khach_hang']) ? (int) $result['nid_khach_hang'] : 0;
  $nid_lai_xe = !empty($result['nid_lai_xe']) ? (int) $result['nid_lai_xe'] : 0;
  $nid_phuong_tien = !empty($result['nid_phuong_tien']) ? (int) $result['nid_phuong_tien'] : 0;
  $nid_mooc = !empty($result['nid_mooc']) ? (int) $result['nid_mooc'] : 0;
  // Danh sách truyền sẵn cache (xem _ke_hoach_xep_xe_enrich_cache) để không
  // phải truy vấn từng dòng. Không có cache thì hành vi giữ nguyên như cũ.
  $cache = !empty($options['cache']) ? $options['cache'] : NULL;
  $child_options = $cache ? array('cache' => $cache) : array();

  if ($nid_khach_hang) {
    if ($cache) {
      $result['khach_hang'] = isset($cache['khach_hang'][$nid_khach_hang]) ? $cache['khach_hang'][$nid_khach_hang] : NULL;
    }
    else {
      $kh = db_query("SELECT nid, ten, ma_kh, phan_loai, cccd_mst, sdt, dia_chi, dob, ghi_chu FROM {khach_hang} WHERE nid = :nid", array(':nid' => $nid_khach_hang))->fetch();
      $result['khach_hang'] = $kh ? (array) $kh : NULL;
    }
  }
  else {
    $result['khach_hang'] = NULL;
  }

  if ($nid_lai_xe) {
    if ($cache) {
      $result['lai_xe'] = isset($cache['lai_xe'][$nid_lai_xe]) ? $cache['lai_xe'][$nid_lai_xe] : NULL;
    }
    else {
      $lx = db_query("SELECT nid, ten, ma_nhan_vien, sdt, cccd, so_bang_lai, loai_bang_lai, han_bang_lai FROM {lai_xe} WHERE nid = :nid", array(':nid' => $nid_lai_xe))->fetch();
      $result['lai_xe'] = $lx ? (array) $lx : NULL;
    }
  }
  else {
    $result['lai_xe'] = NULL;
  }

  if ($nid_phuong_tien) {
    if ($cache) {
      $result['phuong_tien'] = isset($cache['phuong_tien'][$nid_phuong_tien]) ? $cache['phuong_tien'][$nid_phuong_tien] : NULL;
    }
    else {
      $pt = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_phuong_tien))->fetch();
      $result['phuong_tien'] = $pt ? (array) $pt : NULL;
    }
  }
  else {
    $result['phuong_tien'] = NULL;
  }

  if ($nid_mooc) {
    if ($cache) {
      $result['mooc'] = isset($cache['phuong_tien'][$nid_mooc]) ? $cache['phuong_tien'][$nid_mooc] : NULL;
    }
    else {
      $mooc = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien, hang_xe, nam_san_xuat FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid_mooc))->fetch();
      $result['mooc'] = $mooc ? (array) $mooc : NULL;
    }
  }
  else {
    $result['mooc'] = NULL;
  }

  $port_ref = NULL;
  if ($with_related && !empty($result['ke_hoach_cont_ref_nid'])) {
    if ($cache) {
      $ref = isset($cache['cont_ref'][(int) $result['ke_hoach_cont_ref_nid']]) ? $cache['cont_ref'][(int) $result['ke_hoach_cont_ref_nid']] : NULL;
    }
    else {
      $ref_fields = $related_mode === 'summary' ? 'nid, so_bkg, so_cont, dia_chi_kho, bai_lay_cont, bai_lay_thuc_te, bai_ha_cont, bai_ha_thuc_te, bai_ha_ngoai' : '*';
      $ref = db_query("SELECT $ref_fields FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $result['ke_hoach_cont_ref_nid']))->fetch();
    }
    $port_ref = $ref ? $ref : NULL;
    $result['cont_ref'] = $ref ? ($related_mode === 'summary' ? _ke_hoach_xep_xe_related_summary($ref) : _ke_hoach_xep_xe_enrich_row($ref, FALSE, $child_options)) : NULL;
  }
  else {
    $result['cont_ref'] = NULL;
  }

  if ($with_related) {
    if ($cache) {
      $keo_ve = isset($cache['keo_ve'][(int) $result['nid']]) ? $cache['keo_ve'][(int) $result['nid']] : NULL;
    }
    else {
      $keo_ve_fields = $related_mode === 'summary' ? 'nid, so_bkg, so_cont, dia_chi_kho, bai_lay_cont, bai_lay_thuc_te, bai_ha_cont, bai_ha_thuc_te, bai_ha_ngoai' : '*';
      $keo_ve = db_query("SELECT $keo_ve_fields FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :nid AND hoat_dong = 1" . _ke_hoach_port_not_cancelled_sql() . " ORDER BY nid DESC", array(':nid' => $result['nid']))->fetch();
    }
    $result['cont_keo_ve_by'] = $keo_ve ? ($related_mode === 'summary' ? _ke_hoach_xep_xe_related_summary($keo_ve) : _ke_hoach_xep_xe_enrich_row($keo_ve, FALSE, $child_options)) : NULL;
    $result['is_cont_keo_ve'] = !empty($result['cont_keo_ve_by']);
  }
  else {
    $result['cont_keo_ve_by'] = NULL;
    $result['is_cont_keo_ve'] = $cache
      ? !empty($cache['referenced'][(int) $result['nid']])
      : (bool) db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE ke_hoach_cont_ref_nid = :nid AND hoat_dong = 1" . _ke_hoach_port_not_cancelled_sql(), array(':nid' => $result['nid']))->fetchField();
  }
  $json = _ke_hoach_xep_xe_json_decode(isset($result['thong_tin_json']) ? $result['thong_tin_json'] : '');
  $json = _ke_hoach_xep_xe_normalize_files($json);
  if ($with_related && $related_mode !== 'summary' && !empty($json['ket_hop']) && is_array($json['ket_hop'])) {
    $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop($json['ket_hop']);
    if (!empty($ket_hop['enabled']) && !empty($ket_hop['ke_hoach_cont_ref_nid'])) {
      $ket_hop_row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => (int) $ket_hop['ke_hoach_cont_ref_nid']))->fetch();
      $ket_hop['cont_ref'] = $ket_hop_row ? _ke_hoach_xep_xe_enrich_row($ket_hop_row, FALSE) : NULL;
    }
    $json['ket_hop'] = $ket_hop;
  }
  $result['thong_tin_json'] = $json;
  if (empty($result['loai_hang']) && isset($json['loai_hang'])) {
    $result['loai_hang'] = (string) $json['loai_hang'];
  }
  $result['hinh_anh_chung_tu'] = $json['hinh_anh_chung_tu'];
  $result['ghi_chu'] = !empty($json['ghi_chu']) ? $json['ghi_chu'] : '';
  $result['hinh_thuc_tinh_luong_lai_xe'] = !empty($json['hinh_thuc_tinh_luong_lai_xe']) ? $json['hinh_thuc_tinh_luong_lai_xe'] : 'khoan';
  $result['hinh_thuc_status_text'] = _ke_hoach_xep_xe_hinh_thuc_status_text($result);
  // Hàng cảng: các bước tiếp theo của chuyến (một nguồn cho web và app) và
  // trạng thái cont, tách khỏi trạng thái chuyến.
  if ($with_related && $related_mode !== 'summary' && (empty($result['loai_ke_hoach']) || $result['loai_ke_hoach'] !== 'tuyen_xa')) {
    $result['trang_thai_cont'] = isset($result['trang_thai_cont']) ? (string) $result['trang_thai_cont'] : '';
    $result['hanh_dong_tiep_theo'] = _ke_hoach_port_trip_options($row, $port_ref);
  }
  unset($result['nid_khach_hang'], $result['nid_lai_xe'], $result['nid_phuong_tien'], $result['nid_mooc']);

  return $result;
}

function _ke_hoach_xep_xe_apply_cont_logic(&$record, $auto_full_on_dong_hang = TRUE) {
  $record['hinh_thuc_van_tai'] = _ke_hoach_xep_xe_normalize_hinh_thuc($record['hinh_thuc_van_tai']);
  $record['da_cat_mooc'] = in_array($record['hinh_thuc_van_tai'], array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE) ? 1 : 0;
  if ($auto_full_on_dong_hang && $record['hinh_thuc_van_tai'] === 'dong_hang') {
    $record['da_du_hang'] = 1;
  }
}

function _ke_hoach_xep_xe_hinh_thuc_status_text($row) {
  $hinh_thuc_van_tai = !empty($row['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($row['hinh_thuc_van_tai']) : '';
  if (!empty($row['is_cont_keo_ve'])) {
    return 'Kéo về';
  }
  if ($hinh_thuc_van_tai && in_array($hinh_thuc_van_tai, array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), TRUE)) {
    return 'Kéo lên';
  }
  return '';
}

// ---------------------------------------------------------------------------
// Hàng cảng: trạng thái chuyến (lái xe) và trạng thái cont là hai thứ khác nhau.
//
// - Trạng thái chuyến (trang_thai_van_chuyen) thuộc từng kế hoạch, theo việc lái
//   xe của kế hoạch đó làm.
// - Trạng thái cont (trang_thai_cont) thuộc cont, theo hành trình của cont.
//
// Kế hoạch A chọn cont kéo về = kế hoạch B (A.ke_hoach_cont_ref_nid = B.nid).
// Lái xe A "Thực hiện kéo về" => chuyến A: Đang kéo về; cont B: Đang kéo về.
// Lái xe A hoàn thành => chuyến A: Hoàn thành; cont B: Hoàn thành.
// Chuyến của B (lái xe của B) không bị đổi.
// ---------------------------------------------------------------------------

function _ke_hoach_xep_xe_has_cont_status_field() {
  $exists = &drupal_static(__FUNCTION__);
  if (!isset($exists)) {
    $exists = db_field_exists('ke_hoach_xep_xe', 'trang_thai_cont');
  }
  return $exists;
}

function _ke_hoach_port_cont_statuses() {
  return array('Chưa cắt mooc', 'Đã cắt mooc', 'Đủ hàng', 'Đang kéo về', 'Hoàn thành');
}

/**
 * Các chặng của một hình thức vận tải hàng cảng.
 *
 * keo_len: có chặng kéo lên hay không.
 * keo_ve: '' (không có) hoặc 'bat_buoc'. Rút mooc, cắt kéo và cắt kéo chéo đều có
 * chặng kéo về: được lưu khi chưa chọn cont, nhưng phải chọn cont trước khi
 * thực hiện kéo về (và không thể hoàn thành chuyến nếu bỏ qua chặng này).
 */
function _ke_hoach_port_legs($hinh_thuc) {
  $hinh_thuc = _ke_hoach_xep_xe_normalize_hinh_thuc($hinh_thuc);
  switch ($hinh_thuc) {
    case 'dong_hang':
      return array('keo_len' => FALSE, 'keo_ve' => '');
    case 'rut_mooc':
      return array('keo_len' => FALSE, 'keo_ve' => 'bat_buoc');
    case 'cat_keo':
    case 'cat_keo_cheo':
      return array('keo_len' => TRUE, 'keo_ve' => 'bat_buoc');
    default:
      // Thả mooc và dữ liệu cũ (Rời cont...): chỉ kéo lên.
      return array('keo_len' => TRUE, 'keo_ve' => '');
  }
}

/**
 * Trạng thái chuyến mà chuyến đã phải có lái xe. Chờ duyệt và Đã huỷ thì không.
 */
function _ke_hoach_port_statuses_need_driver() {
  return array('Chờ thực hiện', 'Đã nhận chuyến', 'Đang kéo lên', 'Đang kéo về', 'Hoàn thành');
}

/**
 * Lý do chưa thể thực hiện kéo về (chuỗi rỗng nếu được).
 */
function _ke_hoach_port_keo_ve_blocker($plan, $ref) {
  if (empty($plan->ke_hoach_cont_ref_nid)) {
    return 'Chưa chọn cont kéo về';
  }
  if (!$ref) {
    return 'Cont kéo về không còn tồn tại';
  }
  if (property_exists($ref, 'trang_thai_cont') && $ref->trang_thai_cont !== NULL) {
    $cont_status = (string) $ref->trang_thai_cont;
    if (!in_array($cont_status, array('Đã cắt mooc', 'Đủ hàng'), TRUE)) {
      $label = trim((string) (isset($ref->so_cont) ? $ref->so_cont : ''));
      return 'Cont ' . ($label !== '' ? $label . ' ' : '') . 'đang ở trạng thái "' . ($cont_status !== '' ? $cont_status : 'chưa xác định') . '", chưa thể kéo về';
    }
  }
  return '';
}

/**
 * Các bước tiếp theo hợp lệ của chuyến hàng cảng.
 *
 * Trả về mảng {to, label, ly_do}. ly_do khác rỗng nghĩa là bước này đang bị khoá.
 * Đây là nguồn duy nhất cho menu web, modal xếp xe và app lái xe.
 */
function _ke_hoach_port_trip_options($plan, $ref = NULL) {
  $plan = (object) $plan;
  $status = trim((string) (isset($plan->trang_thai_van_chuyen) ? $plan->trang_thai_van_chuyen : ''));
  if ($status === '') {
    $status = 'Chờ duyệt';
  }
  $legs = _ke_hoach_port_legs(isset($plan->hinh_thuc_van_tai) ? $plan->hinh_thuc_van_tai : '');
  $has_driver = !empty($plan->nid_lai_xe);
  $need_driver = _ke_hoach_port_statuses_need_driver();
  $options = array();
  $add = function ($to, $label, $blocker = '') use (&$options, $has_driver, $need_driver) {
    if ($blocker === '' && !$has_driver && in_array($to, $need_driver, TRUE)) {
      $blocker = 'Kế hoạch chưa có lái xe. Vào Xếp xe để chọn lái xe rồi lưu.';
    }
    $options[] = array('to' => $to, 'label' => $label, 'ly_do' => $blocker);
  };
  $has_keo_ve = $legs['keo_ve'] === 'bat_buoc';
  $keo_ve_blocker = $has_keo_ve ? _ke_hoach_port_keo_ve_blocker($plan, $ref) : '';

  switch ($status) {
    case 'Chờ duyệt':
      $add('Chờ thực hiện', 'Đẩy cho lái xe');
      $add('Đã huỷ', 'Huỷ chuyến');
      break;

    case 'Chờ thực hiện':
      $add('Đã nhận chuyến', 'Nhận chuyến');
      $add('Đã huỷ', 'Huỷ chuyến');
      break;

    case 'Đã nhận chuyến':
      if ($legs['keo_len']) {
        $add('Đang kéo lên', 'Thực hiện kéo lên');
      }
      elseif ($has_keo_ve) {
        $add('Đang kéo về', 'Thực hiện kéo về', $keo_ve_blocker);
      }
      else {
        $add('Hoàn thành', 'Hoàn thành');
      }
      $add('Đã huỷ', 'Huỷ chuyến');
      break;

    case 'Đang kéo lên':
      if ($has_keo_ve) {
        $add('Đang kéo về', 'Thực hiện kéo về', $keo_ve_blocker);
      }
      else {
        $add('Hoàn thành', 'Hoàn thành');
      }
      break;

    case 'Đang kéo về':
      $add('Hoàn thành', 'Hoàn thành');
      break;
  }
  return $options;
}

/**
 * Ghi mốc thời gian (và người thao tác) khi trạng thái cont đổi vào thong_tin_json.
 * Dùng để biết cont ở kho từ bao giờ; mỗi trạng thái chỉ ghi mốc lần đầu. Trả về json đã mã hoá.
 */
function _ke_hoach_port_json_with_cont_moc($json_text, $status) {
  $json = _ke_hoach_xep_xe_json_decode($json_text);
  if (empty($json['moc_trang_thai_cont']) || !is_array($json['moc_trang_thai_cont'])) {
    $json['moc_trang_thai_cont'] = array();
  }
  // Chỉ ghi lần đầu cont vào trạng thái này: bật/tắt đủ hàng qua lại không được làm đổi
  // thời điểm cont đã ở kho.
  if (empty($json['moc_trang_thai_cont'][$status]['thoi_gian'])) {
    $uid = !empty($GLOBALS['user']) && isset($GLOBALS['user']->uid) ? (int) $GLOBALS['user']->uid : 0;
    $json['moc_trang_thai_cont'][$status] = array('thoi_gian' => _ke_hoach_xep_xe_now(), 'uid' => $uid);
  }
  return _ke_hoach_xep_xe_json_encode($json);
}

function _ke_hoach_port_load_ref($plan) {
  $plan = (object) $plan;
  if (empty($plan->ke_hoach_cont_ref_nid)) {
    return NULL;
  }
  $ref = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => (int) $plan->ke_hoach_cont_ref_nid))->fetch();
  return $ref ? $ref : NULL;
}

/**
 * Chuyển trạng thái chuyến hàng cảng, đồng thời cập nhật trạng thái cont liên quan
 * trong cùng một transaction. Dùng chung cho web và app lái xe.
 *
 * @return array
 *   array('ok' => TRUE, 'row' => object) hoặc array('ok' => FALSE, 'message' => string).
 */
function _ke_hoach_port_trip_change($id, $to, $ngay_ket_thuc = '', array $audit = array()) {
  $plan = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => (int) $id))->fetch();
  if (!$plan) {
    return array('ok' => FALSE, 'message' => 'Kế hoạch không tồn tại');
  }
  if (!empty($plan->loai_ke_hoach) && $plan->loai_ke_hoach !== 'thuong') {
    return array('ok' => FALSE, 'message' => 'Chỉ dùng cho kế hoạch hàng cảng');
  }
  $ref = _ke_hoach_port_load_ref($plan);
  $chosen = NULL;
  foreach (_ke_hoach_port_trip_options($plan, $ref) as $option) {
    if ($option['to'] === $to) {
      $chosen = $option;
      break;
    }
  }
  if (!$chosen) {
    $from = trim((string) $plan->trang_thai_van_chuyen);
    return array('ok' => FALSE, 'message' => 'Không thể chuyển từ "' . ($from !== '' ? $from : 'Chờ duyệt') . '" sang "' . $to . '"');
  }
  if ($chosen['ly_do'] !== '') {
    return array('ok' => FALSE, 'message' => $chosen['ly_do']);
  }

  $now = _ke_hoach_xep_xe_now();
  $from = trim((string) $plan->trang_thai_van_chuyen);
  $has_cont_field = _ke_hoach_xep_xe_has_cont_status_field();
  $json = _ke_hoach_xep_xe_json_decode($plan->thong_tin_json);
  if (empty($json['moc_trang_thai']) || !is_array($json['moc_trang_thai'])) {
    $json['moc_trang_thai'] = array();
  }
  $json['moc_trang_thai'][$to] = $now;
  if ($audit) {
    $json = array_merge($json, $audit);
  }
  $update = array(
    'trang_thai_van_chuyen' => $to,
    'ngay_ket_thuc' => '',
    'changed' => $now,
  );
  if ($to === 'Hoàn thành') {
    $ngay = $ngay_ket_thuc ? substr(_ke_hoach_xep_xe_filter_date($ngay_ket_thuc), 0, 10) : '';
    $update['ngay_ket_thuc'] = $ngay ? $ngay : date('Y-m-d', REQUEST_TIME);
  }
  // Rời chặng kéo lên: cont của chính kế hoạch này đã được cắt mooc.
  $json_text = _ke_hoach_xep_xe_json_encode($json);
  if ($has_cont_field && $from === 'Đang kéo lên' && in_array($to, array('Đang kéo về', 'Hoàn thành'), TRUE) && !empty($plan->da_cat_mooc) && in_array((string) $plan->trang_thai_cont, array('', 'Chưa cắt mooc'), TRUE)) {
    // Cont đã được đánh dấu đủ hàng từ trước thì vào thẳng "Đủ hàng".
    $update['trang_thai_cont'] = !empty($plan->da_du_hang) ? 'Đủ hàng' : 'Đã cắt mooc';
    $json_text = _ke_hoach_port_json_with_cont_moc($json_text, $update['trang_thai_cont']);
  }
  $update['thong_tin_json'] = $json_text;

  $transaction = db_transaction();
  try {
    db_update('ke_hoach_xep_xe')->fields($update)->condition('nid', (int) $id)->execute();
    if ($has_cont_field && $ref) {
      $ref_cont_status = '';
      if ($to === 'Đang kéo về') {
        $ref_cont_status = 'Đang kéo về';
      }
      elseif ($to === 'Hoàn thành' && (string) $ref->trang_thai_cont === 'Đang kéo về') {
        $ref_cont_status = 'Hoàn thành';
      }
      elseif ($to === 'Đã huỷ') {
        // Huỷ chuyến: cont kéo về được giải phóng cho kế hoạch khác.
        _ke_hoach_port_release_ref_cont($plan);
      }
      if ($ref_cont_status !== '') {
        db_update('ke_hoach_xep_xe')->fields(array(
          'trang_thai_cont' => $ref_cont_status,
          'thong_tin_json' => _ke_hoach_port_json_with_cont_moc($ref->thong_tin_json, $ref_cont_status),
          'changed' => $now,
        ))->condition('nid', (int) $ref->nid)->execute();
      }
    }
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi chuyển trạng thái chuyến hàng cảng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return array('ok' => FALSE, 'message' => 'Lỗi hệ thống khi cập nhật trạng thái');
  }
  return array('ok' => TRUE, 'row' => db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => (int) $id))->fetch());
}

/**
 * Admin xác nhận trạng thái cont ngay trên web (phòng khi lái xe quên thao tác):
 * - "Đã cắt mooc": từ "Chưa cắt mooc" (vào thẳng "Đủ hàng" nếu đã đánh dấu đủ hàng).
 * - "Hoàn thành": từ "Đang kéo về" (cont đã về).
 * Chỉ đổi trạng thái cont, không đổi trạng thái chuyến của lái xe.
 */
function _ke_hoach_port_cont_confirm($id, $to = 'Hoàn thành') {
  if (!_ke_hoach_xep_xe_has_cont_status_field()) {
    return array('ok' => FALSE, 'message' => 'Chưa chạy update database cho trạng thái cont');
  }
  $required_from = array('Hoàn thành' => 'Đang kéo về', 'Đã cắt mooc' => 'Chưa cắt mooc');
  if (!isset($required_from[$to])) {
    return array('ok' => FALSE, 'message' => 'Chỉ hỗ trợ xác nhận "Đã cắt mooc" hoặc "Hoàn thành"');
  }
  $plan = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => (int) $id))->fetch();
  if (!$plan) {
    return array('ok' => FALSE, 'message' => 'Kế hoạch không tồn tại');
  }
  if (!empty($plan->loai_ke_hoach) && $plan->loai_ke_hoach !== 'thuong') {
    return array('ok' => FALSE, 'message' => 'Chỉ dùng cho kế hoạch hàng cảng');
  }
  if ((string) $plan->trang_thai_cont !== $required_from[$to]) {
    return array('ok' => FALSE, 'message' => 'Cont không ở trạng thái "' . $required_from[$to] . '"');
  }
  $new_status = ($to === 'Đã cắt mooc' && !empty($plan->da_du_hang)) ? 'Đủ hàng' : $to;
  db_update('ke_hoach_xep_xe')->fields(array(
    'trang_thai_cont' => $new_status,
    'thong_tin_json' => _ke_hoach_port_json_with_cont_moc($plan->thong_tin_json, $new_status),
    'changed' => _ke_hoach_xep_xe_now(),
  ))->condition('nid', (int) $id)->execute();
  return array('ok' => TRUE, 'row' => db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => (int) $id))->fetch());
}

/**
 * Trạng thái cont ban đầu khi lưu kế hoạch hàng cảng.
 *
 * $current là giá trị hiện có (NULL khi tạo mới). Chỉ hình thức có cont ở kho
 * (da_cat_mooc = 1) mới có trạng thái cont; các trạng thái sau "Đủ hàng" do luồng
 * chuyến quản lý nên không bị ghi đè ở đây.
 */
function _ke_hoach_port_cont_status_on_save($record, $current = NULL) {
  $current = $current === NULL ? '' : (string) $current;
  if (empty($record['da_cat_mooc'])) {
    return in_array($current, array('Đang kéo về', 'Hoàn thành'), TRUE) ? $current : '';
  }
  return $current !== '' ? $current : 'Chưa cắt mooc';
}


function _ke_hoach_xep_xe_statuses($loai_ke_hoach = '') {
  $hang_cang = array(
    'Chờ duyệt',
    'Chờ thực hiện',
    'Đã nhận chuyến',
    'Đang kéo lên',
    'Đang kéo về',
    'Hoàn thành',
    'Đã huỷ',
  );
  if ($loai_ke_hoach !== 'tuyen_xa') {
    return $loai_ke_hoach === 'thuong' ? $hang_cang : array_merge($hang_cang, _ke_hoach_xep_xe_statuses('tuyen_xa'));
  }
  return array(
    'Chưa xếp xe',
    'Đang vận chuyển',
    'Đi lấy cont',
    'Đang đến kho',
    'Thả mooc',
    'Đóng hàng',
    'Qua cửa khẩu TQ',
    'Về Việt Nam',
    'Hạ cảng',
    'Hoàn thành',
  );
}

function _ke_hoach_xep_xe_khach_hang_quick_create_settings() {
  if (!module_exists('khach_hang')) {
    return array();
  }

  $module_path = drupal_get_path('module', 'khach_hang');
  $js_path = $module_path . '/assets/js/khach_hang.js';
  $css_path = $module_path . '/assets/css/khach_hang.css';
  $js_version = file_exists($js_path) ? filemtime($js_path) . '-' . filesize($js_path) : REQUEST_TIME;
  $css_version = file_exists($css_path) ? filemtime($css_path) . '-' . filesize($css_path) : REQUEST_TIME;
  if (function_exists('khach_hang_modal_html')) {
    $modal_html = khach_hang_modal_html();
  }
  else {
    $modal_html = theme('khach_hang_modal');
    if (trim($modal_html) === '') {
      $template = $module_path . '/templates/khach-hang-modal.tpl.php';
      $modal_html = file_exists($template) ? file_get_contents($template) : '';
    }
  }

  return array(
    'modal_html' => $modal_html,
    'js_path' => base_path() . $js_path . '?v=' . rawurlencode($js_version),
    'css_path' => base_path() . $css_path . '?v=' . rawurlencode($css_version),
  );
}

function ke_hoach_xep_xe_file_collection($id) {
  $id = (int) $id;
  if (!$id) return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'POST':
      return _ke_hoach_xep_xe_file_upload($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('POST');
  }
}

function ke_hoach_xep_xe_file_item($id, $file_id) {
  $id = (int) $id;
  $file_id = trim((string) $file_id);
  if (!$id || $file_id === '') return _ke_hoach_xep_xe_fail('Thông tin file không hợp lệ');
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'DELETE':
      return _ke_hoach_xep_xe_file_delete($id, $file_id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('DELETE');
  }
}

function _ke_hoach_xep_xe_file_context($id) {
  $row = db_query("SELECT nid, loai_ke_hoach, thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => (int) $id))->fetch();
  if (!$row) return NULL;
  $json = _ke_hoach_xep_xe_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '');
  $json = _ke_hoach_xep_xe_normalize_files($json);
  $row->thong_tin_json = $json;
  return $row;
}

function _ke_hoach_xep_xe_save_file_context($id, array $json) {
  db_update('ke_hoach_xep_xe')
    ->fields(array(
      'thong_tin_json' => _ke_hoach_xep_xe_json_encode($json),
      'changed' => _ke_hoach_xep_xe_now(),
    ))
    ->condition('nid', (int) $id)
    ->execute();
}

function _ke_hoach_xep_xe_file_upload($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền upload chứng từ kế hoạch');
  }

  $context = _ke_hoach_xep_xe_file_context($id);
  if (!$context) return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');

  $nhom = !empty($_POST['nhom']) ? trim($_POST['nhom']) : 'lay_cont_rong';
  $groups = _ke_hoach_xep_xe_file_groups();
  if (!isset($groups[$nhom])) {
    return _ke_hoach_xep_xe_fail('Nhóm chứng từ không hợp lệ');
  }

  $uploads = _ke_hoach_xep_xe_upload_entries('plan_files');
  if (empty($uploads)) {
    return _ke_hoach_xep_xe_fail('Vui lòng chọn file cần upload');
  }

  $current_file_count = !empty($context->thong_tin_json['hinh_anh_chung_tu']) && is_array($context->thong_tin_json['hinh_anh_chung_tu']) ? count($context->thong_tin_json['hinh_anh_chung_tu']) : 0;
  $max_file_count = _ke_hoach_xep_xe_max_plan_files();
  if ($current_file_count >= $max_file_count) {
    return _ke_hoach_xep_xe_fail('Kế hoạch này đã đạt giới hạn tối đa ' . $max_file_count . ' file chứng từ');
  }
  if ($current_file_count + count($uploads) > $max_file_count) {
    return _ke_hoach_xep_xe_fail('Kế hoạch này chỉ được lưu tối đa ' . $max_file_count . ' file chứng từ. Hiện có ' . $current_file_count . ' file, bạn chỉ có thể upload thêm ' . ($max_file_count - $current_file_count) . ' file');
  }

  $dir = 'public://ke_hoach_xep_xe_files/' . (int) $id;
  if (!file_prepare_directory($dir, FILE_CREATE_DIRECTORY | FILE_MODIFY_PERMISSIONS)) {
    return _ke_hoach_xep_xe_error('Không thể tạo thư mục lưu chứng từ kế hoạch');
  }

  global $user;
  $json = $context->thong_tin_json;
  $saved = array();
  $failed = 0;
  foreach ($uploads as $upload) {
    $file = _ke_hoach_xep_xe_save_upload_entry($upload, $dir);
    if (!$file) {
      $failed++;
      continue;
    }
    $item = array(
      'id' => 'file_' . REQUEST_TIME . '_' . (int) $file->fid,
      'nhom' => $nhom,
      'nhom_label' => _ke_hoach_xep_xe_file_group_label($nhom),
      'ten_hien_thi' => !empty($_POST['ten_hien_thi']) ? trim($_POST['ten_hien_thi']) : $file->filename,
      'fid' => (int) $file->fid,
      'filename' => $file->filename,
      'uri' => $file->uri,
      'url' => file_create_url($file->uri),
      'mime' => $file->filemime,
      'size' => (int) $file->filesize,
      'is_image' => strpos($file->filemime, 'image/') === 0,
      'uploaded' => REQUEST_TIME,
      'uploaded_text' => date('d/m/Y H:i', REQUEST_TIME),
      'uid' => isset($user->uid) ? (int) $user->uid : 0,
    );
    $json['hinh_anh_chung_tu'][] = $item;
    $saved[] = $item;
  }

  if (empty($saved)) {
    return _ke_hoach_xep_xe_fail('File không hợp lệ. Chỉ hỗ trợ ảnh JPG, JPEG, PNG, WEBP hoặc PDF tối đa 10MB');
  }

  _ke_hoach_xep_xe_save_file_context($id, $json);
  $json = _ke_hoach_xep_xe_normalize_files($json);

  watchdog('ke_hoach_xep_xe', 'Upload %count chứng từ cho kế hoạch #%id', array('%count' => count($saved), '%id' => $id));

  return _ke_hoach_xep_xe_success(array(
    'nid' => $id,
    'uploaded' => $saved,
    'failed' => $failed,
    'hinh_anh_chung_tu' => $json['hinh_anh_chung_tu'],
  ));
}

function _ke_hoach_xep_xe_file_delete($id, $file_id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá chứng từ kế hoạch');
  }

  $context = _ke_hoach_xep_xe_file_context($id);
  if (!$context) return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');

  $json = $context->thong_tin_json;
  $index = _ke_hoach_xep_xe_file_index($json['hinh_anh_chung_tu'], $file_id);
  if ($index < 0) return _ke_hoach_xep_xe_not_found('File không tồn tại');

  $deleted = $json['hinh_anh_chung_tu'][$index];
  if (!empty($deleted['fid'])) {
    $file = file_load((int) $deleted['fid']);
    if ($file) file_delete($file, TRUE);
  }
  array_splice($json['hinh_anh_chung_tu'], $index, 1);
  _ke_hoach_xep_xe_save_file_context($id, $json);
  $json = _ke_hoach_xep_xe_normalize_files($json);

  return _ke_hoach_xep_xe_success(array(
    'nid' => $id,
    'deleted' => TRUE,
    'hinh_anh_chung_tu' => $json['hinh_anh_chung_tu'],
  ));
}

function _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach = 'thuong', $alias = 'kh') {
  $loai_ke_hoach = $loai_ke_hoach === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
  if ($loai_ke_hoach === 'tuyen_xa') {
    $query->condition($alias . '.loai_ke_hoach', 'tuyen_xa');
    return;
  }
  $or = db_or();
  $or->condition($alias . '.loai_ke_hoach', 'thuong');
  $or->isNull($alias . '.loai_ke_hoach');
  $query->condition($or);
}

function _ke_hoach_xep_xe_query_condition_thuong($query, $alias = 'kh') {
  _ke_hoach_xep_xe_query_condition_loai($query, 'thuong', $alias);
}

function ke_hoach_xep_xe_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_list();
    case 'POST':
      return _ke_hoach_xep_xe_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function _ke_hoach_xep_xe_filter_date($value, $end_of_day = FALSE) {
  $value = trim((string) $value);
  if ($value === '') {
    return '';
  }
  if (preg_match('/^(\d{2})\/(\d{2})\/(\d{4})$/', $value, $m)) {
    return $m[3] . '-' . $m[2] . '-' . $m[1] . ($end_of_day ? ' 23:59:59' : ' 00:00:00');
  }
  if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $m)) {
    return $value . ($end_of_day ? ' 23:59:59' : ' 00:00:00');
  }
  return '';
}

/**
 * Chuẩn hoá mốc ngày giờ nghiệp vụ về YYYY-MM-DD HH:MM:SS.
 */
function _ke_hoach_xep_xe_normalize_datetime($value) {
  $value = trim((string) $value);
  if ($value === '') return '';
  if (preg_match('/^(\d{2})\/(\d{2})\/(\d{4})$/', $value, $m)) {
    $year = (int) $m[3]; $month = (int) $m[2]; $day = (int) $m[1];
    return checkdate($month, $day, $year) ? sprintf('%04d-%02d-%02d', $year, $month, $day) : '';
  }
  if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $m)) {
    $year = (int) $m[1]; $month = (int) $m[2]; $day = (int) $m[3];
    return checkdate($month, $day, $year) ? sprintf('%04d-%02d-%02d', $year, $month, $day) : '';
  }
  if (preg_match('/^(\d{2})\/(\d{2})\/(\d{4})\s+(\d{1,2}):(\d{2})(?::(\d{2}))?$/', $value, $m)) {
    $year = (int) $m[3]; $month = (int) $m[2]; $day = (int) $m[1];
    $hour = (int) $m[4]; $minute = (int) $m[5]; $second = isset($m[6]) ? (int) $m[6] : 0;
    if (checkdate($month, $day, $year) && $hour <= 23 && $minute <= 59 && $second <= 59) {
      return sprintf('%04d-%02d-%02d %02d:%02d:%02d', $year, $month, $day, $hour, $minute, $second);
    }
  }
  if (preg_match('/^(\d{4})-(\d{2})-(\d{2})\s+(\d{1,2}):(\d{2})(?::(\d{2}))?$/', $value, $m)) {
    $year = (int) $m[1]; $month = (int) $m[2]; $day = (int) $m[3];
    $hour = (int) $m[4]; $minute = (int) $m[5]; $second = isset($m[6]) ? (int) $m[6] : 0;
    if (checkdate($month, $day, $year) && $hour <= 23 && $minute <= 59 && $second <= 59) {
      return sprintf('%04d-%02d-%02d %02d:%02d:%02d', $year, $month, $day, $hour, $minute, $second);
    }
  }
  return '';
}

function _ke_hoach_xep_xe_like_condition($query, $field, $param) {
  if (!empty($_GET[$param])) {
    $query->condition($field, '%' . db_like(trim($_GET[$param])) . '%', 'LIKE');
  }
}

function _ke_hoach_xep_xe_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;
  $loai_ke_hoach = !empty($_GET['loai_ke_hoach']) && $_GET['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';

  $status_counts = array();
  $status_total = 0;

  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->condition('kh.hoat_dong', 1);
  _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach, 'kh');

  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $or = db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.dia_chi_kho', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.bai_lay_cont', $like, 'LIKE')
      ->condition('kh.bai_ha_cont', $like, 'LIKE')
      ->condition('kh.cang_xuat', $like, 'LIKE');
    $query->condition($or);
  }
  if (isset($_GET['da_du_hang']) && ($_GET['da_du_hang'] === '0' || $_GET['da_du_hang'] === '1')) {
    $query->condition('kh.da_du_hang', (int) $_GET['da_du_hang']);
  }
  if (!empty($_GET['khach_hang'])) {
    // Hàng cảng gửi mảng nid từ Select2 multiple. Tuyến xa vẫn giữ filter
    // text cũ để không ảnh hưởng giao diện/logic hiện có.
    if (is_array($_GET['khach_hang'])) {
      $customer_ids = array();
      foreach ($_GET['khach_hang'] as $customer_id) {
        $customer_id = (int) $customer_id;
        if ($customer_id > 0) $customer_ids[$customer_id] = $customer_id;
      }
      if ($customer_ids) {
        $query->condition('kh.nid_khach_hang', array_values($customer_ids), 'IN');
      }
    }
    else {
      $query->leftJoin('khach_hang', 'khh_filter', 'khh_filter.nid = kh.nid_khach_hang');
      $query->condition('khh_filter.ten', '%' . db_like(trim($_GET['khach_hang'])) . '%', 'LIKE');
    }
  }
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_bkg', 'so_bkg');
  _ke_hoach_xep_xe_like_condition($query, 'kh.dia_chi_kho', 'dia_chi_kho');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_cont', 'so_cont');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_seal_chinh', 'so_seal_chinh');
  _ke_hoach_xep_xe_like_condition($query, 'kh.so_seal_tam', 'so_seal_tam');
  if ($loai_ke_hoach === 'thuong' && !empty($_GET['bkg_cont_seal'])) {
    $like = '%' . db_like(trim((string) $_GET['bkg_cont_seal'])) . '%';
    // Tìm cả kế hoạch đang mang số cont đó và kế hoạch đang chọn cont đó để
    // kéo về. Nhờ vậy tra một số cont sẽ thấy đủ hai phía của nghiệp vụ.
    $query->leftJoin('ke_hoach_xep_xe', 'kh_ref_keyword', 'kh_ref_keyword.nid = kh.ke_hoach_cont_ref_nid AND kh_ref_keyword.hoat_dong = 1');
    $query->condition(db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.so_seal_chinh', $like, 'LIKE')
      ->condition('kh_ref_keyword.so_cont', $like, 'LIKE')
    );
  }
  if ($loai_ke_hoach === 'thuong' && !empty($_GET['phuong_tien'])) {
    $vehicle_parts = explode(':', (string) $_GET['phuong_tien'], 2);
    $vehicle_type = isset($vehicle_parts[0]) ? $vehicle_parts[0] : '';
    $vehicle_nid = isset($vehicle_parts[1]) ? (int) $vehicle_parts[1] : 0;
    if ($vehicle_nid > 0 && $vehicle_type === 'dau_keo') {
      $query->condition('kh.nid_phuong_tien', $vehicle_nid);
    }
    elseif ($vehicle_nid > 0 && $vehicle_type === 'mooc') {
      $query->condition('kh.nid_mooc', $vehicle_nid);
    }
  }
  if (!empty($_GET['bks_dau_keo'])) {
    $query->leftJoin('phuong_tien', 'pt_filter', 'pt_filter.nid = kh.nid_phuong_tien');
    $query->condition('pt_filter.bks', '%' . db_like(trim($_GET['bks_dau_keo'])) . '%', 'LIKE');
  }
  if (!empty($_GET['bks_mooc'])) {
    $query->leftJoin('phuong_tien', 'mooc_filter', 'mooc_filter.nid = kh.nid_mooc');
    $query->condition('mooc_filter.bks', '%' . db_like(trim($_GET['bks_mooc'])) . '%', 'LIKE');
  }
  if (!empty($_GET['lai_xe'])) {
    $query->leftJoin('lai_xe', 'lx_filter', 'lx_filter.nid = kh.nid_lai_xe');
    $query->condition(db_or()
      ->condition('lx_filter.ten', '%' . db_like(trim($_GET['lai_xe'])) . '%', 'LIKE')
      ->condition('lx_filter.ma_nhan_vien', '%' . db_like(trim($_GET['lai_xe'])) . '%', 'LIKE')
    );
  }
  // Hàng cảng lọc/sắp xếp theo mốc nghiệp vụ Ngày kế hoạch; tuyến xa giữ
  // ngày tạo bản ghi để không ảnh hưởng màn hình hiện tại.
  $plan_date_field = $loai_ke_hoach === 'thuong' ? 'kh.ngay_gio_ke_hoach' : 'kh.created';
  $date_from = !empty($_GET['date_from']) ? _ke_hoach_xep_xe_filter_date($_GET['date_from']) : '';
  // Hàng cảng có thể lưu Ngày kế hoạch dạng ngày thuần (YYYY-MM-DD) hoặc
  // ngày kèm giờ. Dùng mốc đầu ngày không có phần giờ để cả hai dạng cùng
  // nằm trong khoảng lọc mà không cần bọc field bằng DATE().
  if ($loai_ke_hoach === 'thuong' && $date_from) {
    $date_from = substr($date_from, 0, 10);
  }
  if ($date_from) {
    $query->condition($plan_date_field, $date_from, '>=');
  }
  $date_to = !empty($_GET['date_to']) ? _ke_hoach_xep_xe_filter_date($_GET['date_to'], TRUE) : '';
  if ($date_to) {
    $query->condition($plan_date_field, $date_to, '<=');
  }

  // Badge trạng thái bám theo toàn bộ bộ lọc phía trên, nhưng không bám theo
  // tab trạng thái hiện đang chọn. Nhờ vậy vẫn thấy được phân bổ tiến độ của
  // chính tập kết quả đang tìm.
  if ($loai_ke_hoach === 'thuong') {
    $status_query = clone $query;
    $status_query->fields('kh', array('trang_thai_van_chuyen'));
    $status_query->addExpression('COUNT(*)', 'total');
    $status_query->groupBy('kh.trang_thai_van_chuyen');
    foreach ($status_query->execute() as $status_row) {
      $label = trim((string) $status_row->trang_thai_van_chuyen);
      $amount = (int) $status_row->total;
      $status_total += $amount;
      if ($label !== '') $status_counts[$label] = $amount;
    }
  }

  if (!empty($_GET['trang_thai_van_chuyen'])) {
    $trang_thai_filter = trim((string) $_GET['trang_thai_van_chuyen']);
    if ($trang_thai_filter === 'Kéo lên') {
      $query->condition('kh.hinh_thuc_van_tai', array('cat_keo', 'cat_keo_cheo', 'tha_mooc'), 'IN');
    }
    elseif ($trang_thai_filter === 'Kéo về') {
      $query->condition('kh.ke_hoach_cont_ref_nid', 0, '>');
    }
    elseif ($trang_thai_filter === 'Đã cắt mooc') {
      $query->condition('kh.da_cat_mooc', 1);
    }
    else {
      $query->condition('kh.trang_thai_van_chuyen', $trang_thai_filter);
    }
  }

  $query->fields('kh');

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  // Cả hai màn hình đều cho đảo thứ tự cột ngày. Hàng cảng dùng Ngày kế
  // hoạch, tuyến xa dùng Ngày tạo. Chỉ nhận hai giá trị whitelist.
  $sort_created = !empty($_GET['sort_created']) && strtolower($_GET['sort_created']) === 'asc' ? 'ASC' : 'DESC';
  $query->orderBy($plan_date_field, $sort_created);
  $query->orderBy('kh.nid', $sort_created);
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $items = array();
  $enrich_options = array('cache' => _ke_hoach_xep_xe_enrich_cache($rows));
  // Hàng cảng: người có quyền tạo/sửa nhận thêm thao tác đổi Đã cắt mooc <-> Đủ hàng để thẻ
  // trạng thái cont bấm được. Server quyết định, JS không tự kiểm tra quyền.
  $can_toggle_cont = $loai_ke_hoach === 'thuong' && user_access('ke_hoach_xep_xe_create');
  foreach ($rows as $row) {
    $item = _ke_hoach_xep_xe_enrich_row($row, TRUE, $enrich_options);
    if ($can_toggle_cont) {
      $item['hanh_dong_cont'] = _ke_hoach_port_cont_toggle_actions(isset($item['trang_thai_cont']) ? $item['trang_thai_cont'] : '');
    }
    $items[] = $item;
  }

  $total_pages = (int) ceil($total / $limit);
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
    'status_counts' => $status_counts,
    'status_total' => $status_total,
  ));
}

function _ke_hoach_xep_xe_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch');
  }

  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_xep_xe_validate_common($input);
  if ($validation) {
    return $validation;
  }
  $is_tuyen_xa = !empty($input['loai_ke_hoach']) && $input['loai_ke_hoach'] === 'tuyen_xa';
  $line_validation = _ke_hoach_xep_xe_validate_lines(isset($input['items']) ? $input['items'] : array(), FALSE, FALSE, !$is_tuyen_xa);
  if ($line_validation) {
    return $line_validation;
  }
  if ($is_tuyen_xa && ($json_validation = _ke_hoach_xep_xe_validate_tuyen_xa_json(isset($input['items']) ? $input['items'] : array()))) {
    return $json_validation;
  }
  $cont_ref_validation = _ke_hoach_xep_xe_validate_cont_refs(isset($input['items']) ? $input['items'] : array(), 0, $is_tuyen_xa);
  if ($cont_ref_validation) {
    return $cont_ref_validation;
  }

  $created_ids = array();

  $transaction = db_transaction();
  try {
    foreach ($input['items'] as $index => $line) {
      $record = _ke_hoach_xep_xe_build_record($input, $line);
      $loai_ke_hoach = !empty($input['loai_ke_hoach']) && $input['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
      if ($loai_ke_hoach === 'tuyen_xa') {
        _ke_hoach_xep_xe_normalize_tuyen_xa_route_json($record);
      }
      _ke_hoach_xep_xe_apply_cont_logic($record, !$is_tuyen_xa);
      $fields = array(
        'nid_khach_hang' => $record['nid_khach_hang'],
        'nid_lai_xe' => $record['nid_lai_xe'],
        'so_bkg' => $record['so_bkg'],
        'dia_chi_kho' => $record['dia_chi_kho'],
        'loai_cont' => $record['loai_cont'],
        'so_cont' => $record['so_cont'],
        'nid_phuong_tien' => $record['nid_phuong_tien'],
        'nid_mooc' => $record['nid_mooc'],
        'so_seal_chinh' => $record['so_seal_chinh'],
        'so_seal_tam' => $record['so_seal_tam'],
        'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
        'bai_lay_cont' => $record['bai_lay_cont'],
        'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
        'bai_ha_cont' => $record['bai_ha_cont'],
        'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
        'cang_xuat' => $record['cang_xuat'],
        'cut_off' => $record['cut_off'],
        'ngay_bat_dau' => $record['ngay_bat_dau'],
        'ngay_gio_ke_hoach' => $record['ngay_gio_ke_hoach'],
        'ngay_ket_thuc' => $record['ngay_ket_thuc'],
        'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
        'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
        'da_cat_mooc' => $record['da_cat_mooc'],
        'da_du_hang' => $record['da_du_hang'],
        'bai_ha_ngoai' => $record['bai_ha_ngoai'],
        'ha_cang' => $record['ha_cang'],
        'thong_tin_json' => $record['thong_tin_json'],
        'loai_ke_hoach' => $loai_ke_hoach,
        'created' => _ke_hoach_xep_xe_now(),
        'changed' => _ke_hoach_xep_xe_now(),
        'hoat_dong' => 1,
      );
      if (_ke_hoach_xep_xe_has_loai_hang_field()) {
        $fields['loai_hang'] = $record['loai_hang'];
      }
      if ($loai_ke_hoach !== 'tuyen_xa' && _ke_hoach_xep_xe_has_cont_status_field()) {
        $fields['trang_thai_cont'] = _ke_hoach_port_cont_status_on_save($record);
      }
      $nid = db_insert('ke_hoach_xep_xe')
        ->fields($fields)
        ->execute();
      $created_ids[] = (int) $nid;
    }

    watchdog('ke_hoach_xep_xe', 'Tạo đợt kế hoạch gồm %count dòng', array(
      '%count' => count($created_ids),
    ));

    return _ke_hoach_xep_xe_success(array(
      'created_ids' => $created_ids,
      'created_count' => count($created_ids),
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi tạo nhóm kế hoạch: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi tạo kế hoạch');
  }
}

/**
 * Định mức khoán lái xe của kế hoạch hàng cảng.
 * PUT /api/ke-hoach-xep-xe/{id}/dinh-muc  body: { items: [...] }
 *
 * Endpoint riêng của hàng cảng, không đi qua /api/quan-ly-cont (màn quản lý cont).
 */
function ke_hoach_xep_xe_dinh_muc_rest($id) {
  if ($_SERVER['REQUEST_METHOD'] !== 'PUT') {
    return _ke_hoach_xep_xe_method_not_allowed('PUT');
  }
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật định mức');
  }
  $id = (int) $id;
  $plan = $id ? db_query("SELECT nid, loai_ke_hoach, thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch() : FALSE;
  if (!$plan) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }
  if (!empty($plan->loai_ke_hoach) && $plan->loai_ke_hoach !== 'thuong') {
    return _ke_hoach_xep_xe_fail('Endpoint này chỉ dành cho kế hoạch hàng cảng');
  }
  $input = _ke_hoach_xep_xe_input();
  $json = _ke_hoach_xep_xe_json_decode($plan->thong_tin_json);
  $json['dinh_muc_khoan_lai_xe'] = _ke_hoach_xep_xe_normalize_dinh_muc_khoan($input);
  db_update('ke_hoach_xep_xe')
    ->fields(array('thong_tin_json' => _ke_hoach_xep_xe_json_encode($json), 'changed' => _ke_hoach_xep_xe_now()))
    ->condition('nid', $id)
    ->execute();
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

function ke_hoach_xep_xe_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    case 'PUT':
      return _ke_hoach_xep_xe_rest_update($id);
    case 'DELETE':
      return _ke_hoach_xep_xe_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

function _ke_hoach_xep_xe_rest_get($id) {
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$row) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }
  $options = array();
  if (!empty($_GET['context']) && $_GET['context'] === 'chi_phi') {
    $options['related_mode'] = 'summary';
  }
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row, TRUE, $options));
}

function _ke_hoach_xep_xe_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch');
  }

  $existing = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  $input = _ke_hoach_xep_xe_input();
  $common_validation = _ke_hoach_xep_xe_validate_common($input);
  if ($common_validation) {
    return $common_validation;
  }

  $line = isset($input['item']) && is_array($input['item']) ? $input['item'] : $input;
  if (!empty($existing->loai_ke_hoach) && $existing->loai_ke_hoach === 'tuyen_xa') {
    $old_json = _ke_hoach_xep_xe_json_decode($existing->thong_tin_json);
    $new_json_input = !empty($line['thong_tin_json']) && is_array($line['thong_tin_json']) ? $line['thong_tin_json'] : array();
    if (!empty($old_json['cong_viec_chinh_hoan_thanh'])) {
      $old_start = isset($old_json['cont_thuc_hien_tu_index']) ? (int) $old_json['cont_thuc_hien_tu_index'] : -1;
      $old_end = isset($old_json['cont_thuc_hien_den_index']) ? (int) $old_json['cont_thuc_hien_den_index'] : -1;
      $new_start = isset($new_json_input['cont_thuc_hien_tu_index']) ? (int) $new_json_input['cont_thuc_hien_tu_index'] : -1;
      $new_end = isset($new_json_input['cont_thuc_hien_den_index']) ? (int) $new_json_input['cont_thuc_hien_den_index'] : -1;
      if ((int) $existing->ke_hoach_cont_ref_nid !== (!empty($line['ke_hoach_cont_ref_nid']) ? (int) $line['ke_hoach_cont_ref_nid'] : 0) || $old_start !== $new_start || $old_end !== $new_end) {
        return _ke_hoach_xep_xe_fail('Công việc chính đã hoàn thành; hãy mở lại trước khi đổi kế hoạch nguồn hoặc dải chặng');
      }
      $old_role = _ke_hoach_xep_xe_plan_role($existing);
      $new_role = _ke_hoach_xep_xe_plan_role($line);
      $old_route = array($existing->bai_lay_cont, $existing->bai_lay_thuc_te, $existing->dia_chi_kho, $existing->bai_ha_cont, $existing->bai_ha_thuc_te, !empty($old_json['bai_ha_tam_1_enabled']) ? 1 : 0, !empty($old_json['bai_ha_tam_1']) ? $old_json['bai_ha_tam_1'] : '', !empty($old_json['bai_ha_tam_2_enabled']) ? 1 : 0, !empty($old_json['bai_ha_tam_2']) ? $old_json['bai_ha_tam_2'] : '');
      $new_route = array(!empty($line['bai_lay_cont']) ? trim($line['bai_lay_cont']) : '', !empty($line['bai_lay_thuc_te']) ? trim($line['bai_lay_thuc_te']) : '', !empty($line['dia_chi_kho']) ? trim($line['dia_chi_kho']) : '', !empty($line['bai_ha_cont']) ? trim($line['bai_ha_cont']) : '', !empty($line['bai_ha_thuc_te']) ? trim($line['bai_ha_thuc_te']) : '', !empty($new_json_input['bai_ha_tam_1_enabled']) ? 1 : 0, !empty($new_json_input['bai_ha_tam_1']) ? trim($new_json_input['bai_ha_tam_1']) : '', !empty($new_json_input['bai_ha_tam_2_enabled']) ? 1 : 0, !empty($new_json_input['bai_ha_tam_2']) ? trim($new_json_input['bai_ha_tam_2']) : '');
      $new_hinh_thuc = !empty($line['hinh_thuc_van_tai']) ? _ke_hoach_xep_xe_normalize_hinh_thuc($line['hinh_thuc_van_tai']) : '';
      if ($old_role !== $new_role || $old_route !== $new_route || _ke_hoach_xep_xe_normalize_hinh_thuc($existing->hinh_thuc_van_tai) !== $new_hinh_thuc) {
        return _ke_hoach_xep_xe_fail('Công việc chính đã hoàn thành; hãy mở lại trước khi đổi vai trò, lộ trình hoặc hình thức vận tải');
      }
    }
    $old_ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($old_json['ket_hop']) ? $old_json['ket_hop'] : array());
    if (!empty($old_ket_hop['hoan_thanh'])) {
      $new_ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($line['ket_hop']) ? $line['ket_hop'] : (!empty($new_json_input['ket_hop']) ? $new_json_input['ket_hop'] : array()));
      if (empty($new_ket_hop['enabled']) || (int) $old_ket_hop['ke_hoach_cont_ref_nid'] !== (int) $new_ket_hop['ke_hoach_cont_ref_nid'] || (int) $old_ket_hop['cont_thuc_hien_tu_index'] !== (int) $new_ket_hop['cont_thuc_hien_tu_index'] || (int) $old_ket_hop['cont_thuc_hien_den_index'] !== (int) $new_ket_hop['cont_thuc_hien_den_index']) {
        return _ke_hoach_xep_xe_fail('Cont kéo về đã hoàn thành; hãy mở lại trước khi thay đổi');
      }
    }
  }
  $line_validation = _ke_hoach_xep_xe_validate_lines(array($line), FALSE, FALSE, empty($existing->loai_ke_hoach) || $existing->loai_ke_hoach !== 'tuyen_xa');
  if ($line_validation) {
    return $line_validation;
  }
  if (!empty($existing->loai_ke_hoach) && $existing->loai_ke_hoach === 'tuyen_xa' && ($json_validation = _ke_hoach_xep_xe_validate_tuyen_xa_json(array($line)))) {
    return $json_validation;
  }
  $cont_ref_validation = _ke_hoach_xep_xe_validate_cont_refs(array($line), $id, !empty($existing->loai_ke_hoach) && $existing->loai_ke_hoach === 'tuyen_xa', (int) $existing->ke_hoach_cont_ref_nid);
  if ($cont_ref_validation) {
    return $cont_ref_validation;
  }

  $record = _ke_hoach_xep_xe_build_record($input, $line);
  if (!array_key_exists('trang_thai_van_chuyen', $line)) {
    $record['trang_thai_van_chuyen'] = $existing->trang_thai_van_chuyen;
  }
  $record['thong_tin_json'] = _ke_hoach_xep_xe_merge_json_text(isset($existing->thong_tin_json) ? $existing->thong_tin_json : '', $record['thong_tin_json']);
  if (!empty($existing->loai_ke_hoach) && $existing->loai_ke_hoach === 'tuyen_xa') {
    _ke_hoach_xep_xe_normalize_tuyen_xa_route_json($record);
  }
  _ke_hoach_xep_xe_apply_cont_logic($record, empty($existing->loai_ke_hoach) || $existing->loai_ke_hoach !== 'tuyen_xa');
  if (!empty($existing->loai_ke_hoach) && $existing->loai_ke_hoach === 'tuyen_xa') {
    $old_json = _ke_hoach_xep_xe_json_decode($existing->thong_tin_json);
    $new_json = _ke_hoach_xep_xe_json_decode($record['thong_tin_json']);
    $old_location = _ke_hoach_xep_xe_cont_current_location($existing);
    $new_location = _ke_hoach_xep_xe_cont_current_location($record);
    $old_location_index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($existing);
    $new_location_index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($record);
    $old_route_points = _ke_hoach_xep_xe_tuyen_xa_route_points($existing);
    $new_route_points = _ke_hoach_xep_xe_tuyen_xa_route_points($record);
    $old_route_signature = array();
    $new_route_signature = array();
    foreach ($old_route_points as $point) $old_route_signature[] = $point['key'] . '|' . $point['value'];
    foreach ($new_route_points as $point) $new_route_signature[] = $point['key'] . '|' . $point['value'];
    if ($old_location !== $new_location || $old_location_index !== $new_location_index || $old_route_signature !== $new_route_signature) {
      $active_assignments = _ke_hoach_xep_xe_tuyen_xa_active_assignments((int) $id);
      if ($active_assignments) {
        return _ke_hoach_xep_xe_fail('Cont đã có kế hoạch #' . $active_assignments[0]['nid'] . ' nhận chặng, chưa thể đổi vị trí hoặc cấu trúc lộ trình');
      }
    }
  }

  $transaction = db_transaction();
  try {
    $fields = array(
      'nid_khach_hang' => $record['nid_khach_hang'],
      'nid_lai_xe' => $record['nid_lai_xe'],
      'so_bkg' => $record['so_bkg'],
      'dia_chi_kho' => $record['dia_chi_kho'],
      'loai_cont' => $record['loai_cont'],
      'so_cont' => $record['so_cont'],
      'nid_phuong_tien' => $record['nid_phuong_tien'],
      'nid_mooc' => $record['nid_mooc'],
      'so_seal_chinh' => $record['so_seal_chinh'],
      'so_seal_tam' => $record['so_seal_tam'],
      'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
      'bai_lay_cont' => $record['bai_lay_cont'],
      'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
      'bai_ha_cont' => $record['bai_ha_cont'],
      'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
      'cang_xuat' => $record['cang_xuat'],
      'cut_off' => $record['cut_off'],
      'ngay_bat_dau' => $record['ngay_bat_dau'],
      'ngay_gio_ke_hoach' => $record['ngay_gio_ke_hoach'],
      'ngay_ket_thuc' => $record['ngay_ket_thuc'],
      'hinh_thuc_van_tai' => $record['hinh_thuc_van_tai'],
      'ke_hoach_cont_ref_nid' => $record['ke_hoach_cont_ref_nid'],
      'da_cat_mooc' => $record['da_cat_mooc'],
      'da_du_hang' => $record['da_du_hang'],
      'bai_ha_ngoai' => $record['bai_ha_ngoai'],
      'ha_cang' => $record['ha_cang'],
      'thong_tin_json' => $record['thong_tin_json'],
      'changed' => _ke_hoach_xep_xe_now(),
    );
    if (_ke_hoach_xep_xe_has_loai_hang_field()) {
      $fields['loai_hang'] = $record['loai_hang'];
    }
    if ((empty($existing->loai_ke_hoach) || $existing->loai_ke_hoach !== 'tuyen_xa') && _ke_hoach_xep_xe_has_cont_status_field()) {
      $fields['trang_thai_cont'] = _ke_hoach_port_cont_status_on_save($record, isset($existing->trang_thai_cont) ? $existing->trang_thai_cont : '');
    }
    db_update('ke_hoach_xep_xe')
      ->fields($fields)
      ->condition('nid', $id)
      ->execute();

    if (!empty($record['ke_hoach_cont_ref_nid'])) {
      db_update('ke_hoach_xep_xe')
        ->fields(array('changed' => _ke_hoach_xep_xe_now()))
        ->condition('nid', $record['ke_hoach_cont_ref_nid'])
        ->execute();
    }

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
    watchdog('ke_hoach_xep_xe', 'Cập nhật kế hoạch #%id', array('%id' => $id));
    return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi cập nhật kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch');
  }
}

function _ke_hoach_xep_xe_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá kế hoạch');
  }

  $existing = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch không tồn tại');
  }

  try {
    db_update('ke_hoach_xep_xe')
      ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
      ->condition('nid', $id)
      ->execute();
    // Kế hoạch hàng cảng bị xoá: giải phóng cont kéo về nó đang giữ.
    if (empty($existing->loai_ke_hoach) || $existing->loai_ke_hoach === 'thuong') {
      _ke_hoach_port_release_ref_cont($existing);
    }
    if (db_table_exists('ke_hoach_chi_phi')) {
      db_update('ke_hoach_chi_phi')
        ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
        ->condition('nid_ke_hoach', $id)
        ->execute();
    }

    watchdog('ke_hoach_xep_xe', 'Xoá (soft) kế hoạch #%id: %bkg', array(
      '%id' => $id,
      '%bkg' => $existing->so_bkg,
    ));

    return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    watchdog('ke_hoach_xep_xe', 'Lỗi xoá kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi xoá kế hoạch');
  }
}

function ke_hoach_cont_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_cont_rest_list();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET');
  }
}

function ke_hoach_cont_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'PUT':
      return _ke_hoach_cont_rest_update($id);
    case 'GET':
      return _ke_hoach_xep_xe_rest_get($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT');
  }
}

function _ke_hoach_cont_rest_list() {
  $loai_ke_hoach = !empty($_GET['loai_ke_hoach']) && $_GET['loai_ke_hoach'] === 'tuyen_xa' ? 'tuyen_xa' : 'thuong';
  // Lọc theo trạng thái cont (vd "Đã cắt mooc,Đủ hàng"): trạng thái cont chỉ có ở hàng
  // cảng nên luôn ép về hàng cảng, bất kể loai_ke_hoach được gửi lên.
  $cont_statuses = array();
  if (!empty($_GET['trang_thai_cont']) && _ke_hoach_xep_xe_has_cont_status_field()) {
    foreach (explode(',', (string) $_GET['trang_thai_cont']) as $status) {
      $status = trim($status);
      if (in_array($status, _ke_hoach_port_cont_statuses(), TRUE)) {
        $cont_statuses[$status] = $status;
      }
    }
    if ($cont_statuses) {
      $loai_ke_hoach = 'thuong';
    }
  }
  $query = db_select('ke_hoach_xep_xe', 'kh')->fields('kh')->condition('kh.hoat_dong', 1)->orderBy('kh.nid', 'DESC');
  _ke_hoach_xep_xe_query_condition_loai($query, $loai_ke_hoach, 'kh');
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $query->condition(db_or()->condition('kh.so_bkg', $like, 'LIKE')->condition('kh.so_cont', $like, 'LIKE')->condition('kh.dia_chi_kho', $like, 'LIKE'));
  }
  if (!empty($_GET['nid_khach_hang'])) {
    $query->condition('kh.nid_khach_hang', (int) $_GET['nid_khach_hang']);
  }
  if (!empty($_GET['dia_chi_kho'])) {
    $query->condition('kh.dia_chi_kho', $_GET['dia_chi_kho']);
  }
  if (!empty($_GET['bai_lay_cont'])) {
    $query->condition('kh.bai_lay_cont', $_GET['bai_lay_cont']);
  }
  if (!empty($_GET['bai_ha_cont'])) {
    $query->condition('kh.bai_ha_cont', $_GET['bai_ha_cont']);
  }
  if (!empty($_GET['hinh_thuc_van_tai'])) {
    $query->condition('kh.hinh_thuc_van_tai', $_GET['hinh_thuc_van_tai']);
  }
  if (isset($_GET['da_cat_mooc']) && $_GET['da_cat_mooc'] !== '') {
    $query->condition('kh.da_cat_mooc', (int) $_GET['da_cat_mooc']);
  }
  if (!empty($_GET['exclude_nid'])) {
    $query->condition('kh.nid', (int) $_GET['exclude_nid'], '<>');
  }
  if ($cont_statuses) {
    $query->condition('kh.trang_thai_cont', array_values($cont_statuses), 'IN');
    // Kế hoạch đã huỷ không còn cont nào để theo dõi.
    $query->condition(db_or()->isNull('kh.trang_thai_van_chuyen')->condition('kh.trang_thai_van_chuyen', 'Đã huỷ', '<>'));
  }
  if (!empty($_GET['available_keo_ve_for']) && $loai_ke_hoach !== 'tuyen_xa') {
    $current_ref_nid = (int) $_GET['available_keo_ve_for'];
    $join_condition = 'kh_ref.ke_hoach_cont_ref_nid = kh.nid AND kh_ref.hoat_dong = 1 AND kh_ref.nid <> :current_ref_nid AND COALESCE(kh_ref.trang_thai_van_chuyen, \'\') <> \'Đã huỷ\'';
    $query->leftJoin('ke_hoach_xep_xe', 'kh_ref', $join_condition, array(':current_ref_nid' => $current_ref_nid));
    $query->isNull('kh_ref.nid');
  }
  if (isset($_GET['da_du_hang']) && $_GET['da_du_hang'] !== '') {
    $query->condition('kh.da_du_hang', (int) $_GET['da_du_hang']);
  }
  $tx_assignments_by_source = array();
  if ($loai_ke_hoach === 'tuyen_xa') {
    $tx_rows = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE hoat_dong = 1 AND loai_ke_hoach = :loai", array(':loai' => 'tuyen_xa'))->fetchAll();
    $tx_rows_by_id = array();
    foreach ($tx_rows as $tx_row) $tx_rows_by_id[(int) $tx_row->nid] = $tx_row;
    foreach ($tx_rows as $tx_plan) {
      $tx_json = _ke_hoach_xep_xe_json_decode($tx_plan->thong_tin_json);
      $source_id = (int) $tx_plan->ke_hoach_cont_ref_nid;
      $main_done = array_key_exists('cong_viec_chinh_hoan_thanh', $tx_json) ? !empty($tx_json['cong_viec_chinh_hoan_thanh']) : $tx_plan->trang_thai_van_chuyen === 'Hoàn thành';
      if ($source_id && !$main_done && !empty($tx_rows_by_id[$source_id])) {
        $range = _ke_hoach_xep_xe_tuyen_xa_service_range($tx_plan, $tx_rows_by_id[$source_id]);
        if ($range) $tx_assignments_by_source[$source_id][] = array('nid' => (int) $tx_plan->nid, 'type' => 'cong_viec_chinh', 'start' => $range['start'], 'end' => $range['end'], 'so_bkg' => $tx_plan->so_bkg, 'so_cont' => $tx_plan->so_cont);
      }
      $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($tx_json['ket_hop']) ? $tx_json['ket_hop'] : array());
      $return_source_id = (int) $ket_hop['ke_hoach_cont_ref_nid'];
      if (!empty($ket_hop['enabled']) && empty($ket_hop['hoan_thanh']) && $return_source_id) {
        $range = _ke_hoach_xep_xe_tuyen_xa_ket_hop_range($tx_plan);
        if ($range) $tx_assignments_by_source[$return_source_id][] = array('nid' => (int) $tx_plan->nid, 'type' => 'cont_keo_ve', 'start' => $range['start'], 'end' => $range['end'], 'so_bkg' => $tx_plan->so_bkg, 'so_cont' => $tx_plan->so_cont);
      }
    }
  }
  $items = array();
  foreach ($query->execute()->fetchAll() as $row) {
    $enriched = _ke_hoach_xep_xe_enrich_row($row);
    if ($loai_ke_hoach === 'tuyen_xa') {
      $enriched['cont_chang_da_nhan'] = array();
      foreach (!empty($tx_assignments_by_source[(int) $row->nid]) ? $tx_assignments_by_source[(int) $row->nid] : array() as $assigned) {
        $enriched['cont_chang_da_nhan'][] = array(
          'nid' => (int) $assigned['nid'],
          'loai_nhiem_vu' => $assigned['type'],
          'so_bkg' => !empty($assigned['so_bkg']) ? $assigned['so_bkg'] : '',
          'so_cont' => !empty($assigned['so_cont']) ? $assigned['so_cont'] : '',
          'tu_index' => $assigned['start'],
          'den_index' => $assigned['end'],
        );
      }
    }
    // Kế hoạch hàng cảng đã có trạng thái cont lưu riêng thì dùng nó; còn lại suy ra từ các cờ như trước.
    if (empty($enriched['trang_thai_cont'])) $enriched['trang_thai_cont'] = !empty($enriched['ha_cang']) ? 'Hạ cảng' : ((!empty($enriched['da_du_hang']) ? 'Đủ hàng' : (!empty($enriched['ke_hoach_cont_ref_nid']) ? 'Kéo về' : (!empty($enriched['da_cat_mooc']) ? 'Đã cắt mooc' : 'Chưa cắt mooc'))));
    $items[] = $enriched;
  }
  return _ke_hoach_xep_xe_success(array('items' => $items, 'total' => count($items), 'current_page' => 1, 'total_pages' => 1));
}

/**
 * Chuẩn hoá danh sách định mức khoán lái xe (dùng chung cho mọi nơi lưu định mức).
 */
function _ke_hoach_xep_xe_normalize_dinh_muc_khoan($dm) {
  $dm = is_array($dm) ? $dm : array();
  $items = !empty($dm['items']) && is_array($dm['items']) ? $dm['items'] : array();
  $clean_items = array();
  $total = 0;
  foreach ($items as $index => $item) {
    if (!is_array($item)) continue;
    $diem_dau = isset($item['diem_dau']) ? trim((string) $item['diem_dau']) : '';
    $diem_cuoi = isset($item['diem_cuoi']) ? trim((string) $item['diem_cuoi']) : '';
    $trang_thai_xe = isset($item['trang_thai_xe']) ? trim((string) $item['trang_thai_xe']) : '';
    if (!in_array($trang_thai_xe, array('v', 'h', 't'), TRUE)) {
      $trang_thai_xe = 'v';
    }
    $dinh_muc = _ke_hoach_xep_xe_money_value(isset($item['dinh_muc']) ? $item['dinh_muc'] : 0);
    $total += $dinh_muc;
    $clean_items[] = array(
      'ten_chang' => isset($item['ten_chang']) ? trim((string) $item['ten_chang']) : 'Chặng ' . (count($clean_items) + 1),
      'trang_thai_xe' => $trang_thai_xe,
      'diem_dau' => $diem_dau,
      'diem_cuoi' => $diem_cuoi,
      'dinh_muc' => $dinh_muc,
      'manual' => !empty($item['manual']) ? 1 : 0,
    );
  }
  return array(
    'items' => $clean_items,
    'tong_khoan' => $total,
    'changed' => _ke_hoach_xep_xe_now(),
  );
}

/**
 * PUT /api/quan-ly-cont/{id}. Hàng cảng và tuyến xa là hai nghiệp vụ khác nhau
 * nên mỗi loại có hàm cập nhật riêng; hàm này chỉ kiểm tra quyền và điều hướng.
 */
function _ke_hoach_cont_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền cập nhật quản lý cont');
  }
  $existing_plan = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1", array(':id' => $id))->fetch();
  if (!$existing_plan) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch cont không tồn tại');
  }
  if (!empty($existing_plan->loai_ke_hoach) && $existing_plan->loai_ke_hoach === 'tuyen_xa') {
    return _ke_hoach_tuyen_xa_cont_rest_update($id, $existing_plan);
  }
  return _ke_hoach_port_cont_rest_update($id, $existing_plan);
}

/**
 * Cập nhật cont / trạng thái / chi phí khoán của kế hoạch hàng cảng.
 */
function _ke_hoach_port_cont_rest_update($id, $existing_plan) {
  $input = _ke_hoach_xep_xe_input();
  $did_action = FALSE;
  $update = array('changed' => _ke_hoach_xep_xe_now());
  foreach (array('da_du_hang', 'ha_cang') as $field) {
    if (array_key_exists($field, $input)) {
      $update[$field] = !empty($input[$field]) ? 1 : 0;
    }
  }
  // Đồng bộ trạng thái cont khi admin bật/tắt các cờ thủ công.
  if (_ke_hoach_xep_xe_has_cont_status_field() && (array_key_exists('da_du_hang', $input) || array_key_exists('ha_cang', $input))) {
    $cont_status = (string) $existing_plan->trang_thai_cont;
    if (array_key_exists('da_du_hang', $input)) {
      // "Đủ hàng" nghĩa là cont đã nằm ở kho và đủ hàng: chỉ chuyển từ "Đã cắt mooc".
      // Cont chưa cắt mooc vẫn lưu được cờ đủ hàng; khi cont được cắt mooc sẽ vào thẳng "Đủ hàng".
      if (!empty($input['da_du_hang']) && $cont_status === 'Đã cắt mooc') {
        $cont_status = 'Đủ hàng';
      }
      elseif (empty($input['da_du_hang']) && $cont_status === 'Đủ hàng') {
        $cont_status = 'Đã cắt mooc';
      }
    }
    if (!empty($input['ha_cang']) && in_array($cont_status, array('Đã cắt mooc', 'Đủ hàng', 'Đang kéo về'), TRUE)) {
      $cont_status = 'Hoàn thành';
    }
    if ($cont_status !== (string) $existing_plan->trang_thai_cont) {
      $update['trang_thai_cont'] = $cont_status;
    }
  }
  // Admin xác nhận cont đã về (Đang kéo về -> Hoàn thành).
  if (array_key_exists('trang_thai_cont', $input)) {
    $confirm = _ke_hoach_port_cont_confirm($id, trim((string) $input['trang_thai_cont']));
    if (empty($confirm['ok'])) {
      return _ke_hoach_xep_xe_fail($confirm['message']);
    }
    unset($update['trang_thai_cont']);
    $existing_plan = $confirm['row'];
    $did_action = TRUE;
  }
  // Chuyển trạng thái chuyến: đi qua engine để kiểm tra thứ tự bước và cập nhật
  // trạng thái cont liên quan trong cùng một transaction.
  if (array_key_exists('trang_thai_van_chuyen', $input)) {
    $to = trim((string) $input['trang_thai_van_chuyen']);
    if (!in_array($to, _ke_hoach_xep_xe_statuses('thuong'), TRUE)) {
      return _ke_hoach_xep_xe_fail('Trạng thái vận chuyển không hợp lệ');
    }
    $changed = _ke_hoach_port_trip_change($id, $to, !empty($input['ngay_ket_thuc']) ? trim((string) $input['ngay_ket_thuc']) : '');
    if (empty($changed['ok'])) {
      return _ke_hoach_xep_xe_fail($changed['message']);
    }
    $existing_plan = $changed['row'];
    $did_action = TRUE;
  }
  // Bãi hạ ngoài (modal chọn cont kéo về: "Hạ theo booking" = rỗng, chọn bãi khác = tên bãi).
  if (array_key_exists('bai_ha_ngoai', $input)) {
    $bai_ha_ngoai = trim((string) $input['bai_ha_ngoai']);
    $update['bai_ha_ngoai'] = ($bai_ha_ngoai !== '' && $bai_ha_ngoai !== trim((string) $existing_plan->bai_ha_cont)) ? $bai_ha_ngoai : '';
  }
  if (array_key_exists('ghi_chu', $input) || array_key_exists('dinh_muc_khoan_lai_xe', $input)) {
    $json = _ke_hoach_xep_xe_json_decode($existing_plan->thong_tin_json);
    if (array_key_exists('ghi_chu', $input)) {
      $json['ghi_chu'] = trim((string) $input['ghi_chu']);
    }
    if (array_key_exists('dinh_muc_khoan_lai_xe', $input)) {
      $json['dinh_muc_khoan_lai_xe'] = _ke_hoach_xep_xe_normalize_dinh_muc_khoan($input['dinh_muc_khoan_lai_xe']);
    }
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
  }
  // Bật/tắt đủ hàng làm đổi trạng thái cont: ghi mốc thời gian.
  if (isset($update['trang_thai_cont'])) {
    $moc_base = isset($update['thong_tin_json']) ? $update['thong_tin_json'] : $existing_plan->thong_tin_json;
    $update['thong_tin_json'] = _ke_hoach_port_json_with_cont_moc($moc_base, $update['trang_thai_cont']);
  }
  if (count($update) === 1 && !$did_action) {
    return _ke_hoach_xep_xe_fail('Không có dữ liệu cập nhật');
  }
  try {
    // Chỉ còn 'changed' nghĩa là mọi thay đổi đã được engine ghi xong.
    if (count($update) > 1) {
      db_update('ke_hoach_xep_xe')->fields($update)->condition('nid', $id)->execute();
    }
  }
  catch (Exception $e) {
    watchdog('ke_hoach_xep_xe', 'Lỗi cập nhật cont/trạng thái hàng cảng #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch');
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

/**
 * Cập nhật chặng / trạng thái / định mức của kế hoạch tuyến xa.
 */
function _ke_hoach_tuyen_xa_cont_rest_update($id, $existing_plan) {
  $input = _ke_hoach_xep_xe_input();
  $fields = array('da_du_hang', 'ha_cang');
  $update = array('changed' => _ke_hoach_xep_xe_now());
  $main_work_source_update = NULL;
  foreach ($fields as $field) {
    if (array_key_exists($field, $input)) {
      $update[$field] = !empty($input[$field]) ? 1 : 0;
    }
  }
  if (array_key_exists('hoan_thanh_cong_viec_chinh', $input) && $existing_plan->loai_ke_hoach === 'tuyen_xa') {
    $complete_main = !empty($input['hoan_thanh_cong_viec_chinh']);
    $plan_json = _ke_hoach_xep_xe_json_decode($existing_plan->thong_tin_json);
    $existing_ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($plan_json['ket_hop']) ? $plan_json['ket_hop'] : array());
    if (!$complete_main && !empty($existing_ket_hop['hoan_thanh'])) {
      return _ke_hoach_xep_xe_fail('Hãy mở lại cont kéo về trước khi mở lại công việc chính');
    }
    $role = _ke_hoach_xep_xe_plan_role($existing_plan);
    if ($role === 'ke_hoach_goc') {
      $plan_row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid", array(':nid' => $id))->fetch();
      $points = _ke_hoach_xep_xe_tuyen_xa_route_points($plan_row);
      $target = $complete_main ? _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($plan_row) : 0;
      if (!isset($points[$target])) return _ke_hoach_xep_xe_fail('Không xác định được điểm kết thúc công việc ban đầu');
      $current = _ke_hoach_xep_xe_tuyen_xa_current_point_index($plan_row);
      $expected = $complete_main ? 0 : _ke_hoach_xep_xe_tuyen_xa_root_initial_end_index($plan_row);
      if ($current !== $expected) {
        return _ke_hoach_xep_xe_fail($complete_main ? 'Cont không còn ở điểm bắt đầu của công việc ban đầu' : 'Cont đã được thực hiện chặng tiếp theo, không thể mở lại công việc ban đầu');
      }
      $plan_json['cong_viec_chinh_hoan_thanh'] = $complete_main ? 1 : 0;
      $plan_json['vi_tri_cont_index_hien_tai'] = $target;
      $plan_json['vi_tri_cont_hien_tai'] = $points[$target]['value'];
      $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($plan_json);
      $root_all_done = $complete_main && $target === count($points) - 1 && (empty($existing_ket_hop['enabled']) || !empty($existing_ket_hop['hoan_thanh']));
      $update['trang_thai_van_chuyen'] = $root_all_done ? 'Hoàn thành' : ($complete_main ? 'Đang vận chuyển' : 'Chưa xếp xe');
      $update['ngay_ket_thuc'] = $root_all_done ? date('Y-m-d', REQUEST_TIME) : '';
    }
    else {
      if (empty($existing_plan->ke_hoach_cont_ref_nid)) return _ke_hoach_xep_xe_fail('Kế hoạch thực hiện chưa chọn kế hoạch nguồn');
      $source = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => (int) $existing_plan->ke_hoach_cont_ref_nid, ':loai' => 'tuyen_xa'))->fetch();
      if (!$source) return _ke_hoach_xep_xe_fail('Không tìm thấy kế hoạch nguồn');
      $range = _ke_hoach_xep_xe_tuyen_xa_service_range($existing_plan, $source);
      if (!$range) return _ke_hoach_xep_xe_fail('Không xác định được dải chặng công việc chính');
      $source_points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
      $expected = $complete_main ? $range['start'] : $range['end'];
      $target = $complete_main ? $range['end'] : $range['start'];
      if (_ke_hoach_xep_xe_tuyen_xa_current_point_index($source) !== $expected) {
        return _ke_hoach_xep_xe_fail($complete_main ? 'Cont nguồn chưa ở đúng điểm bắt đầu công việc' : 'Cont nguồn đã được thực hiện chặng tiếp theo, không thể mở lại công việc');
      }
      if (!isset($source_points[$target])) return _ke_hoach_xep_xe_fail('Điểm kết thúc công việc không còn hợp lệ');
      $source_json = _ke_hoach_xep_xe_json_decode($source->thong_tin_json);
      $source_json['vi_tri_cont_index_hien_tai'] = $target;
      $source_json['vi_tri_cont_hien_tai'] = $source_points[$target]['value'];
      $main_work_source_update = array('nid' => (int) $source->nid, 'json' => $source_json, 'at_final' => $target === count($source_points) - 1);
      $plan_json['cong_viec_chinh_hoan_thanh'] = $complete_main ? 1 : 0;
      $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($plan_json);
    }
    $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($plan_json['ket_hop']) ? $plan_json['ket_hop'] : array());
    if ($complete_main && ($role === 'thuc_hien_chang' || ($role === 'ke_hoach_goc' && isset($points[$target]) && $target === count($points) - 1)) && (empty($ket_hop['enabled']) || !empty($ket_hop['hoan_thanh']))) {
      $update['trang_thai_van_chuyen'] = 'Hoàn thành';
      $update['ngay_ket_thuc'] = date('Y-m-d', REQUEST_TIME);
    }
    elseif ($complete_main) {
      $update['trang_thai_van_chuyen'] = 'Đang vận chuyển';
      $update['ngay_ket_thuc'] = '';
    }
    elseif (!$complete_main && $existing_plan->trang_thai_van_chuyen === 'Hoàn thành') {
      $update['trang_thai_van_chuyen'] = 'Đang vận chuyển';
      $update['ngay_ket_thuc'] = '';
    }
  }
  if (array_key_exists('hoan_thanh_cont_keo_ve', $input) && $existing_plan->loai_ke_hoach === 'tuyen_xa') {
    $complete_return = !empty($input['hoan_thanh_cont_keo_ve']);
    $plan_json = _ke_hoach_xep_xe_json_decode($existing_plan->thong_tin_json);
    $ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($plan_json['ket_hop']) ? $plan_json['ket_hop'] : array());
    if (empty($ket_hop['enabled']) || empty($ket_hop['ke_hoach_cont_ref_nid'])) return _ke_hoach_xep_xe_fail('Kế hoạch chưa chọn cont kéo về');
    if (empty($plan_json['cong_viec_chinh_hoan_thanh'])) return _ke_hoach_xep_xe_fail('Cần hoàn thành công việc chính trước khi hoàn thành cont kéo về');
    $return_source = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => (int) $ket_hop['ke_hoach_cont_ref_nid'], ':loai' => 'tuyen_xa'))->fetch();
    if (!$return_source) return _ke_hoach_xep_xe_fail('Không tìm thấy kế hoạch gốc của cont kéo về');
    $return_points = _ke_hoach_xep_xe_tuyen_xa_route_points($return_source);
    $return_start = (int) $ket_hop['cont_thuc_hien_tu_index'];
    $return_end = (int) $ket_hop['cont_thuc_hien_den_index'];
    $expected = $complete_return ? $return_start : $return_end;
    $target = $complete_return ? $return_end : $return_start;
    if (!isset($return_points[$target])) return _ke_hoach_xep_xe_fail('Dải chặng cont kéo về không còn hợp lệ');
    if (_ke_hoach_xep_xe_tuyen_xa_current_point_index($return_source) !== $expected) {
      return _ke_hoach_xep_xe_fail($complete_return ? 'Cont kéo về chưa ở đúng điểm bắt đầu' : 'Cont kéo về đã được chạy tiếp, không thể mở lại');
    }
    $return_json = _ke_hoach_xep_xe_json_decode($return_source->thong_tin_json);
    $return_json['vi_tri_cont_index_hien_tai'] = $target;
    $return_json['vi_tri_cont_hien_tai'] = $return_points[$target]['value'];
    $main_work_source_update = array('nid' => (int) $return_source->nid, 'json' => $return_json, 'at_final' => $target === count($return_points) - 1);
    $ket_hop['hoan_thanh'] = $complete_return ? 1 : 0;
    $plan_json['ket_hop'] = $ket_hop;
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($plan_json);
    $return_plan_role = _ke_hoach_xep_xe_plan_role($existing_plan);
    $root_at_final = FALSE;
    if ($return_plan_role === 'ke_hoach_goc') {
      $plan_after = (array) $existing_plan;
      $plan_after['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($plan_json);
      $plan_points = _ke_hoach_xep_xe_tuyen_xa_route_points($plan_after);
      $root_at_final = $plan_points && _ke_hoach_xep_xe_tuyen_xa_current_point_index($plan_after) === count($plan_points) - 1;
    }
    if ($complete_return && ($return_plan_role === 'thuc_hien_chang' || $root_at_final)) {
      $update['trang_thai_van_chuyen'] = 'Hoàn thành';
      $update['ngay_ket_thuc'] = date('Y-m-d', REQUEST_TIME);
    }
    else {
      $update['trang_thai_van_chuyen'] = 'Đang vận chuyển';
      $update['ngay_ket_thuc'] = '';
    }
  }
  if (array_key_exists('trang_thai_van_chuyen', $input)) {
    $status = trim((string) $input['trang_thai_van_chuyen']);
    if (!in_array($status, _ke_hoach_xep_xe_statuses($existing_plan->loai_ke_hoach), TRUE)) {
      return _ke_hoach_xep_xe_fail('Trạng thái vận chuyển không hợp lệ');
    }
    $update['trang_thai_van_chuyen'] = $status;
    if ($status === 'Hoàn thành') {
      $ngay_ket_thuc = !empty($input['ngay_ket_thuc']) ? trim((string) $input['ngay_ket_thuc']) : '';
      $ngay_ket_thuc = $ngay_ket_thuc ? substr(_ke_hoach_xep_xe_filter_date($ngay_ket_thuc), 0, 10) : '';
      $update['ngay_ket_thuc'] = $ngay_ket_thuc ?: date('Y-m-d', REQUEST_TIME);
    }
    else {
      $update['ngay_ket_thuc'] = '';
    }
  }
  if (array_key_exists('bai_lay_thuc_te', $input)) {
    $bai_lay_thuc_te = trim((string) $input['bai_lay_thuc_te']);
    $bai_lay_cont = db_query("SELECT bai_lay_cont FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $update['bai_lay_thuc_te'] = ($bai_lay_thuc_te && $bai_lay_thuc_te !== $bai_lay_cont) ? $bai_lay_thuc_te : '';
  }
  if (array_key_exists('bai_ha_thuc_te', $input)) {
    $bai_ha_thuc_te = trim((string) $input['bai_ha_thuc_te']);
    $bai_ha_cont = db_query("SELECT bai_ha_cont FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $update['bai_ha_thuc_te'] = ($bai_ha_thuc_te && $bai_ha_thuc_te !== $bai_ha_cont) ? $bai_ha_thuc_te : '';
  }
  if (array_key_exists('ghi_chu', $input)) {
    $existing = db_query("SELECT thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField();
    $json = _ke_hoach_xep_xe_json_decode($existing);
    $json['ghi_chu'] = trim((string) $input['ghi_chu']);
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($json);
  }
  if (array_key_exists('hinh_thuc_tinh_luong_lai_xe', $input)) {
    $existing_json = isset($json) ? $json : _ke_hoach_xep_xe_json_decode(db_query("SELECT thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField());
    $mode = trim((string) $input['hinh_thuc_tinh_luong_lai_xe']);
    if (!in_array($mode, array('khoan', 'theo_chuyen'), TRUE)) {
      return _ke_hoach_xep_xe_fail('Hình thức tính lương lái xe không hợp lệ');
    }
    $existing_json['hinh_thuc_tinh_luong_lai_xe'] = $mode;
    $json = $existing_json;
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($existing_json);
  }
  if (array_key_exists('dinh_muc_khoan_lai_xe', $input)) {
    $existing_json = isset($json) ? $json : _ke_hoach_xep_xe_json_decode(db_query("SELECT thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetchField());
    $existing_json['dinh_muc_khoan_lai_xe'] = _ke_hoach_xep_xe_normalize_dinh_muc_khoan($input['dinh_muc_khoan_lai_xe']);
    $json = $existing_json;
    $update['thong_tin_json'] = _ke_hoach_xep_xe_json_encode($existing_json);
  }
  if (count($update) === 1) {
    return _ke_hoach_xep_xe_fail('Không có dữ liệu cập nhật');
  }
  $transaction = db_transaction();
  try {
    db_update('ke_hoach_xep_xe')->fields($update)->condition('nid', $id)->execute();
    if ($main_work_source_update) {
      $source_fields = array('thong_tin_json' => _ke_hoach_xep_xe_json_encode($main_work_source_update['json']), 'changed' => _ke_hoach_xep_xe_now());
      $source_ket_hop = _ke_hoach_xep_xe_normalize_ket_hop(!empty($main_work_source_update['json']['ket_hop']) ? $main_work_source_update['json']['ket_hop'] : array());
      $source_can_complete = !empty($main_work_source_update['at_final']) && (empty($source_ket_hop['enabled']) || !empty($source_ket_hop['hoan_thanh']));
      if ($source_can_complete) {
        $source_fields['trang_thai_van_chuyen'] = 'Hoàn thành';
        $source_fields['ngay_ket_thuc'] = date('Y-m-d', REQUEST_TIME);
      }
      else {
        $source_fields['trang_thai_van_chuyen'] = 'Đang vận chuyển';
        $source_fields['ngay_ket_thuc'] = '';
      }
      db_update('ke_hoach_xep_xe')
        ->fields($source_fields)
        ->condition('nid', $main_work_source_update['nid'])
        ->execute();
    }
    if (!empty($update['trang_thai_van_chuyen']) && !array_key_exists('hoan_thanh_cong_viec_chinh', $input) && !array_key_exists('hoan_thanh_cont_keo_ve', $input) && $existing_plan->loai_ke_hoach === 'tuyen_xa' && !empty($existing_plan->ke_hoach_cont_ref_nid)) {
      $is_complete = $update['trang_thai_van_chuyen'] === 'Hoàn thành' && $existing_plan->trang_thai_van_chuyen !== 'Hoàn thành';
      $is_reopen = $existing_plan->trang_thai_van_chuyen === 'Hoàn thành' && $update['trang_thai_van_chuyen'] !== 'Hoàn thành';
      $source = db_query("SELECT nid, dia_chi_kho, bai_lay_cont, bai_lay_thuc_te, bai_ha_cont, bai_ha_thuc_te, trang_thai_van_chuyen, da_du_hang, thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':nid' => (int) $existing_plan->ke_hoach_cont_ref_nid, ':loai' => 'tuyen_xa'))->fetch();
      if (!$source) {
        throw new Exception('Không tìm thấy kế hoạch cont nguồn');
      }
      $service_range = _ke_hoach_xep_xe_tuyen_xa_service_range($existing_plan, $source);
      $from_index = $service_range ? $service_range['start'] : -1;
      $destination_index = $service_range ? $service_range['end'] : -1;
      $expected_index = $is_complete ? $from_index : ($is_reopen ? $destination_index : -1);
      $target_index = $is_complete ? $destination_index : ($is_reopen ? $from_index : -1);
      if ($target_index >= 0) {
        $source_index = _ke_hoach_xep_xe_tuyen_xa_current_point_index($source);
        if ($expected_index >= 0 && $source_index !== $expected_index) {
          throw new Exception($is_complete ? 'Vị trí cont nguồn đã thay đổi, không thể hoàn thành chặng cũ' : 'Cont nguồn đã được dùng cho chặng tiếp theo, không thể mở lại kế hoạch này');
        }
        $source_json = _ke_hoach_xep_xe_json_decode($source->thong_tin_json);
        $source_points = _ke_hoach_xep_xe_tuyen_xa_route_points($source);
        if (!isset($source_points[$target_index])) {
          throw new Exception('Dải chặng cont không còn hợp lệ');
        }
        $source_json['vi_tri_cont_index_hien_tai'] = $target_index;
        $source_json['vi_tri_cont_hien_tai'] = $source_points[$target_index]['value'];
        db_update('ke_hoach_xep_xe')
          ->fields(array('thong_tin_json' => _ke_hoach_xep_xe_json_encode($source_json), 'changed' => _ke_hoach_xep_xe_now()))
          ->condition('nid', (int) $existing_plan->ke_hoach_cont_ref_nid)
          ->execute();
      }
    }
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_xep_xe', 'Lỗi cập nhật trạng thái/chặng cont kế hoạch #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_fail($e->getMessage());
  }
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_xep_xe_enrich_row($row));
}

// ---------------------------------------------------------------------------
// /cat-mooc: cont đang ở kho (hàng cảng), theo trạng thái cont.
// ---------------------------------------------------------------------------

/**
 * Các tab của màn cat-mooc và trạng thái cont tương ứng.
 */
function _ke_hoach_cat_mooc_groups() {
  return array(
    'o_kho' => array('Đã cắt mooc', 'Đủ hàng'),
    'du_hang' => array('Đủ hàng'),
    'dang_keo_ve' => array('Đang kéo về'),
    'chua_cat_mooc' => array('Chưa cắt mooc'),
    'hoan_thanh' => array('Hoàn thành'),
  );
}

/**
 * Thao tác trên cont mà server cho phép ở trạng thái cont hiện tại.
 * Đây là nguồn duy nhất cho menu và nút bấm ở màn cat-mooc.
 */
function _ke_hoach_port_cont_actions($cont_status, $has_puller = FALSE) {
  // Cont đang ở kho mà chưa có kế hoạch kéo về đang hoạt động thì cho tạo kế hoạch kéo về.
  $create = $has_puller ? array() : array(array('action' => 'tao_ke_hoach_keo_ve', 'label' => 'Tạo kế hoạch kéo về'));
  switch ((string) $cont_status) {
    case 'Chưa cắt mooc':
      return array(array('action' => 'xac_nhan_cat_mooc', 'label' => 'Xác nhận đã cắt mooc'));
    case 'Đã cắt mooc':
      return array_merge(array(array('action' => 'danh_dau_du_hang', 'label' => 'Đánh dấu đủ hàng')), $create);
    case 'Đủ hàng':
      return array_merge(array(array('action' => 'bo_du_hang', 'label' => 'Bỏ đánh dấu đủ hàng')), $create);
    case 'Đang kéo về':
      return array(array('action' => 'xac_nhan_cont_ve', 'label' => 'Xác nhận cont đã về'));
  }
  return array();
}

/**
 * Mốc cont bắt đầu ở kho (ISO) hoặc '' nếu chưa rõ.
 * Ưu tiên mốc cont; dữ liệu cũ dùng mốc chuyến rời chặng kéo lên.
 */
function _ke_hoach_cat_mooc_at_kho_since($json) {
  foreach (array('Đã cắt mooc', 'Đủ hàng') as $status) {
    if (!empty($json['moc_trang_thai_cont'][$status]['thoi_gian'])) {
      return (string) $json['moc_trang_thai_cont'][$status]['thoi_gian'];
    }
  }
  foreach (array('Đang kéo về', 'Hoàn thành') as $status) {
    if (!empty($json['moc_trang_thai'][$status])) {
      return (string) $json['moc_trang_thai'][$status];
    }
  }
  return '';
}

/**
 * Chỉ thao tác đổi Đã cắt mooc <-> Đủ hàng (dùng cho thẻ trạng thái bấm được ở danh sách hàng cảng).
 */
function _ke_hoach_port_cont_toggle_actions($cont_status) {
  $toggle = array();
  foreach (_ke_hoach_port_cont_actions($cont_status, TRUE) as $action) {
    if (in_array($action['action'], array('danh_dau_du_hang', 'bo_du_hang'), TRUE)) {
      $toggle[] = $action;
    }
  }
  return $toggle;
}

function ke_hoach_cat_mooc_rest_collection() {
  if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
    return _ke_hoach_xep_xe_method_not_allowed('GET');
  }
  return _ke_hoach_cat_mooc_rest_list();
}

/**
 * Câu truy vấn nền: kế hoạch hàng cảng đang hoạt động có cont ở kho, chưa huỷ.
 */
function _ke_hoach_cat_mooc_base_query() {
  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->condition('kh.hoat_dong', 1);
  _ke_hoach_xep_xe_query_condition_loai($query, 'thuong', 'kh');
  $query->condition('kh.da_cat_mooc', 1);
  $all_statuses = _ke_hoach_port_cont_statuses();
  $query->condition('kh.trang_thai_cont', $all_statuses, 'IN');
  $query->condition(db_or()->isNull('kh.trang_thai_van_chuyen')->condition('kh.trang_thai_van_chuyen', 'Đã huỷ', '<>'));
  return $query;
}

function _ke_hoach_cat_mooc_apply_filters($query) {
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like(trim((string) $_GET['keyword'])) . '%';
    $or = db_or();
    foreach (array('so_bkg', 'so_cont', 'so_seal_chinh', 'so_seal_tam', 'dia_chi_kho', 'bai_lay_cont', 'bai_ha_cont', 'bai_ha_ngoai', 'cang_xuat') as $field) {
      $or->condition('kh.' . $field, $like, 'LIKE');
    }
    $query->condition($or);
  }
  if (!empty($_GET['khach_hang'])) {
    $raw = is_array($_GET['khach_hang']) ? $_GET['khach_hang'] : explode(',', (string) $_GET['khach_hang']);
    $ids = array();
    foreach ($raw as $id) {
      $id = (int) $id;
      if ($id > 0) $ids[$id] = $id;
    }
    if ($ids) {
      $query->condition('kh.nid_khach_hang', array_values($ids), 'IN');
    }
  }
  if (!empty($_GET['dia_chi_kho'])) {
    $query->condition('kh.dia_chi_kho', trim((string) $_GET['dia_chi_kho']));
  }
}

function _ke_hoach_cat_mooc_rest_list() {
  if (!user_access('ke_hoach_xep_xe_view')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem danh sách cont');
  }
  if (!_ke_hoach_xep_xe_has_cont_status_field()) {
    return _ke_hoach_xep_xe_error('Chưa chạy update database cho trạng thái cont. Hãy chạy update.php.');
  }
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 50;
  $groups = _ke_hoach_cat_mooc_groups();
  $group = !empty($_GET['nhom']) ? (string) $_GET['nhom'] : 'o_kho';

  // Số đếm từng tab: bám theo các bộ lọc nhưng không bám theo tab đang chọn.
  $count_query = _ke_hoach_cat_mooc_base_query();
  _ke_hoach_cat_mooc_apply_filters($count_query);
  $count_query->fields('kh', array('trang_thai_cont'));
  $count_query->addExpression('COUNT(*)', 'total');
  $count_query->groupBy('kh.trang_thai_cont');
  $by_status = array();
  foreach ($count_query->execute() as $count_row) {
    $by_status[(string) $count_row->trang_thai_cont] = (int) $count_row->total;
  }
  $group_counts = array();
  $all_total = 0;
  foreach ($groups as $key => $statuses) {
    $group_counts[$key] = 0;
    foreach ($statuses as $status) {
      $group_counts[$key] += isset($by_status[$status]) ? $by_status[$status] : 0;
    }
    $all_total += $group_counts[$key];
  }

  $query = _ke_hoach_cat_mooc_base_query();
  _ke_hoach_cat_mooc_apply_filters($query);
  if (isset($groups[$group])) {
    $query->condition('kh.trang_thai_cont', $groups[$group], 'IN');
  }
  $query->fields('kh');
  $total_query = clone $query;
  $total = (int) $total_query->countQuery()->execute()->fetchField();

  $direction = !empty($_GET['sort']) && strtolower($_GET['sort']) === 'asc' ? 'ASC' : 'DESC';
  $query->orderBy('kh.ngay_gio_ke_hoach', $direction);
  $query->orderBy('kh.nid', $direction);
  $query->range(($page - 1) * $limit, $limit);
  $rows = $query->execute()->fetchAll();

  $cache = _ke_hoach_xep_xe_enrich_cache($rows);
  // Chỉ người có quyền tạo/sửa mới nhận được thao tác đổi trạng thái cont; JS không tự kiểm tra quyền.
  $can_edit = user_access('ke_hoach_xep_xe_create');
  $items = array();
  foreach ($rows as $row) {
    $plan = _ke_hoach_xep_xe_enrich_row($row, TRUE, array('cache' => $cache));
    $json = is_array($plan['thong_tin_json']) ? $plan['thong_tin_json'] : array();
    $since = _ke_hoach_cat_mooc_at_kho_since($json);
    $in_kho = in_array($plan['trang_thai_cont'], array('Đã cắt mooc', 'Đủ hàng'), TRUE);
    $days = NULL;
    if ($in_kho && $since && ($since_ts = strtotime($since))) {
      $days = max(0, (int) floor((REQUEST_TIME - $since_ts) / 86400));
    }
    // Kế hoạch kéo về đã huỷ thì coi như chưa có kế hoạch kéo về.
    $puller = !empty($plan['cont_keo_ve_by']) && $plan['cont_keo_ve_by']['trang_thai_van_chuyen'] !== 'Đã huỷ' ? $plan['cont_keo_ve_by'] : NULL;
    $items[] = array(
      'nid' => (int) $plan['nid'],
      'so_bkg' => $plan['so_bkg'],
      'so_cont' => $plan['so_cont'],
      'loai_cont' => $plan['loai_cont'],
      'so_seal_chinh' => $plan['so_seal_chinh'],
      'so_seal_tam' => $plan['so_seal_tam'],
      'dia_chi_kho' => $plan['dia_chi_kho'],
      'bai_lay_cont' => $plan['bai_lay_cont'],
      'bai_ha_cont' => $plan['bai_ha_cont'],
      'bai_ha_ngoai' => $plan['bai_ha_ngoai'],
      'cang_xuat' => $plan['cang_xuat'],
      'hinh_thuc_van_tai' => $plan['hinh_thuc_van_tai'],
      'ngay_gio_ke_hoach' => $plan['ngay_gio_ke_hoach'],
      'trang_thai_van_chuyen' => $plan['trang_thai_van_chuyen'],
      'trang_thai_cont' => $plan['trang_thai_cont'],
      'da_du_hang' => (int) $plan['da_du_hang'],
      'khach_hang' => $plan['khach_hang'],
      'lai_xe' => $plan['lai_xe'],
      'phuong_tien' => $plan['phuong_tien'],
      'mooc' => $plan['mooc'],
      'o_kho_tu' => $since,
      'so_ngay_o_kho' => $days,
      'keo_ve' => $puller ? array(
        'nid' => (int) $puller['nid'],
        'so_bkg' => $puller['so_bkg'],
        'hinh_thuc_van_tai' => $puller['hinh_thuc_van_tai'],
        'trang_thai_van_chuyen' => $puller['trang_thai_van_chuyen'],
        'ngay_gio_ke_hoach' => $puller['ngay_gio_ke_hoach'],
        'lai_xe' => $puller['lai_xe'],
        'phuong_tien' => $puller['phuong_tien'],
        'mooc' => $puller['mooc'],
      ) : NULL,
      'hanh_dong_cont' => $can_edit ? _ke_hoach_port_cont_actions($plan['trang_thai_cont'], (bool) $puller) : array(),
    );
  }

  $total_pages = (int) ceil($total / $limit);
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
    'group_counts' => $group_counts,
    'group_total' => $all_total,
    'co_quyen_sua' => (bool) $can_edit,
  ));
}

