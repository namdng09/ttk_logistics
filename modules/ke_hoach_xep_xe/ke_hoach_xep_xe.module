<?php

/**
 * @file
 * Kế hoạch xếp xe — Cargo loading plan management.
 */

function ke_hoach_xep_xe_permission() {
  return array(
    'ke_hoach_xep_xe_view' => array('title' => t('Xem kế hoạch')),
    'ke_hoach_xep_xe_create' => array('title' => t('Tạo/sửa kế hoạch')),
    'ke_hoach_xep_xe_delete' => array('title' => t('Xoá kế hoạch')),
  );
}

function ke_hoach_xep_xe_init() {
  $path = current_path();
  if (strpos($path, 'api/ke-hoach-xep-xe') === 0 || strpos($path, 'api/ke-hoach-tuyen-xa') === 0 || strpos($path, 'api/ke-hoach-chi-phi') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

