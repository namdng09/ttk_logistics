function _ke_hoach_tuyen_xa_json_text($value, $key = 'ghi_chu') {
  $json = _ke_hoach_xep_xe_json_decode($value);
  return !empty($json[$key]) ? $json[$key] : '';
}

function _ke_hoach_tuyen_xa_normalize_date($value) {
  $value = trim((string) $value);
  if ($value === '') {
    return '';
  }
  return substr($value, 0, 10);
}

function _ke_hoach_tuyen_xa_validate_input($input, $is_update = FALSE) {
  if (empty($input['nid_khach_hang'])) {
    return _ke_hoach_xep_xe_fail('Khách hàng bắt buộc');
  }
  if (empty($input['so_cont'])) {
    return _ke_hoach_xep_xe_fail('Số cont bắt buộc');
  }
  if (empty($input['diem_di'])) {
    return _ke_hoach_xep_xe_fail('Điểm đi bắt buộc');
  }
  if (empty($input['diem_den'])) {
    return _ke_hoach_xep_xe_fail('Điểm đến bắt buộc');
  }
  $changs = !empty($input['changs']) && is_array($input['changs']) ? $input['changs'] : array();
  if (empty($changs)) {
    return _ke_hoach_xep_xe_fail('Cần ít nhất một chặng');
  }
  foreach ($changs as $index => $item) {
    $row_no = $index + 1;
    if (!empty($item['loai_chang']) && !in_array($item['loai_chang'], _ke_hoach_tuyen_xa_loai_chang_options(), TRUE)) {
      return _ke_hoach_xep_xe_fail('Loại chặng ở dòng #' . $row_no . ' không hợp lệ');
    }
    if (empty($item['diem_di']) || empty($item['diem_den'])) {
      return _ke_hoach_xep_xe_fail('Điểm đi/điểm đến của chặng #' . $row_no . ' bắt buộc');
    }
  }
  return NULL;
}

function _ke_hoach_tuyen_xa_build_parent_record($input) {
  $record = _ke_hoach_xep_xe_default_record();
  $first_chang = !empty($input['changs'][0]) && is_array($input['changs'][0]) ? $input['changs'][0] : array();
  $json = array();
  if (!empty($input['ghi_chu'])) {
    $json['ghi_chu'] = trim((string) $input['ghi_chu']);
  }
  if (!empty($input['thong_tin_json']) && is_array($input['thong_tin_json'])) {
    $json = array_merge($json, $input['thong_tin_json']);
  }

  $record['nid_khach_hang'] = (int) $input['nid_khach_hang'];
  $record['so_bkg'] = trim((string) $input['so_bkg']);
  $record['so_cont'] = !empty($input['so_cont']) ? trim((string) $input['so_cont']) : '';
  $record['loai_cont'] = !empty($input['loai_cont']) ? trim((string) $input['loai_cont']) : '';
  $record['loai_hang'] = !empty($input['loai_hang']) ? trim((string) $input['loai_hang']) : '';
  $record['dia_chi_kho'] = !empty($input['dia_chi_kho']) ? trim((string) $input['dia_chi_kho']) : '';
  $record['trang_thai_van_chuyen'] = !empty($input['trang_thai_van_chuyen']) ? trim((string) $input['trang_thai_van_chuyen']) : 'Mới tạo';
  $record['nid_phuong_tien'] = !empty($first_chang['nid_phuong_tien']) ? (int) $first_chang['nid_phuong_tien'] : 0;
  $record['nid_mooc'] = !empty($first_chang['nid_mooc']) ? (int) $first_chang['nid_mooc'] : 0;
  $record['nid_lai_xe'] = !empty($first_chang['nid_lai_xe']) ? (int) $first_chang['nid_lai_xe'] : 0;
  $json['vai_tro_ke_hoach'] = !empty($record['ke_hoach_cont_ref_nid']) ? 'thuc_hien_chang' : 'ke_hoach_goc';
  $json['loai_hang'] = $record['loai_hang'];
  $record['thong_tin_json'] = !empty($json) ? _ke_hoach_xep_xe_json_encode($json) : '';

  return array(
    'parent' => $record,
    'loai_ke_hoach' => 'tuyen_xa',
    'diem_di' => trim((string) $input['diem_di']),
    'cua_khau' => !empty($input['cua_khau']) ? trim((string) $input['cua_khau']) : '',
    'diem_den' => trim((string) $input['diem_den']),
    'ngay_bat_dau' => !empty($input['ngay_bat_dau']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_bat_dau']) : '',
    'ngay_ket_thuc' => !empty($input['ngay_ket_thuc']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_ket_thuc']) : '',
  );
}

function _ke_hoach_tuyen_xa_save_changs($ke_hoach_id, array $items) {
  db_delete('ke_hoach_tuyen_xa_chang')->condition('ke_hoach_id', (int) $ke_hoach_id)->execute();
  $now = _ke_hoach_xep_xe_now();
  $key_map = array();
  foreach ($items as $index => $item) {
    $id = db_insert('ke_hoach_tuyen_xa_chang')
      ->fields(array(
        'ke_hoach_id' => (int) $ke_hoach_id,
        'thu_tu' => $index + 1,
        'loai_chang' => !empty($item['loai_chang']) ? trim((string) $item['loai_chang']) : '',
        'diem_di' => !empty($item['diem_di']) ? trim((string) $item['diem_di']) : '',
        'diem_den' => !empty($item['diem_den']) ? trim((string) $item['diem_den']) : '',
        'ngay_di' => !empty($item['ngay_di']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay_di']) : '',
        'ngay_den' => !empty($item['ngay_den']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay_den']) : '',
        'nid_phuong_tien' => !empty($item['nid_phuong_tien']) ? (int) $item['nid_phuong_tien'] : 0,
        'nid_mooc' => !empty($item['nid_mooc']) ? (int) $item['nid_mooc'] : 0,
        'nid_lai_xe' => !empty($item['nid_lai_xe']) ? (int) $item['nid_lai_xe'] : 0,
        'thong_tin_json' => '',
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
    $chang_key = !empty($item['chang_key']) ? (string) $item['chang_key'] : (string) ($index + 1);
    $key_map[$chang_key] = (int) $id;
  }
  return $key_map;
}

function _ke_hoach_tuyen_xa_save_chi_phi($ke_hoach_id, array $items, array $chang_key_map = array()) {
  if (!db_table_exists('ke_hoach_chi_phi')) {
    throw new Exception('Bảng ke_hoach_chi_phi chưa được tạo');
  }

  $parent = db_query("SELECT nid_lai_xe, loai_ke_hoach FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => (int) $ke_hoach_id))->fetch();
  $parent_lai_xe = $parent && !empty($parent->nid_lai_xe) ? (int) $parent->nid_lai_xe : 0;
  $loai_ke_hoach = $parent && !empty($parent->loai_ke_hoach) ? (string) $parent->loai_ke_hoach : 'thuong';
  $now = _ke_hoach_xep_xe_now();

  db_update('ke_hoach_chi_phi')
    ->fields(array('hoat_dong' => 0, 'changed' => $now))
    ->condition('nid_ke_hoach', (int) $ke_hoach_id)
    ->condition('hoat_dong', 1)
    ->execute();

  foreach ($items as $item) {
    $don_gia = isset($item['don_gia']) ? _ke_hoach_xep_xe_parse_money($item['don_gia']) : (isset($item['so_tien']) ? _ke_hoach_xep_xe_parse_money($item['so_tien']) : 0);
    $so_luong = isset($item['so_luong']) && $item['so_luong'] !== '' ? (float) $item['so_luong'] : 1;
    $tong_truoc_vat = isset($item['tong_truoc_vat']) ? _ke_hoach_xep_xe_parse_money($item['tong_truoc_vat']) : (int) round($don_gia * $so_luong);
    $vat_percent = isset($item['vat_percent']) && $item['vat_percent'] !== '' ? _ke_hoach_xep_xe_normalize_percent($item['vat_percent']) : 0;
    $tong_sau_vat = isset($item['tong_sau_vat']) ? _ke_hoach_xep_xe_parse_money($item['tong_sau_vat']) : (int) round($tong_truoc_vat * (1 + ($vat_percent / 100)));

    if (empty($item['ten_chi_phi']) && empty($item['loai_chi_phi']) && !$tong_sau_vat) {
      continue;
    }

    $json = array(
      'ngay' => !empty($item['ngay']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay']) : '',
      'is_co_dinh' => !empty($item['is_co_dinh']) ? 1 : 0,
      'chang_key' => !empty($item['chang_key']) ? (string) $item['chang_key'] : '',
      'legacy_chang_id' => !empty($item['chang_key']) && isset($chang_key_map[(string) $item['chang_key']]) ? (int) $chang_key_map[(string) $item['chang_key']] : 0,
    );
    if (!empty($item['thong_tin_json']) && is_string($item['thong_tin_json'])) {
      $json['legacy_thong_tin_json'] = $item['thong_tin_json'];
    }

    db_insert('ke_hoach_chi_phi')
      ->fields(array(
        'nid_ke_hoach' => (int) $ke_hoach_id,
        'loai_ke_hoach' => $loai_ke_hoach,
        'nid_lai_xe' => !empty($item['nid_lai_xe']) ? (int) $item['nid_lai_xe'] : $parent_lai_xe,
        'loai_chi_phi' => !empty($item['loai_chi_phi']) ? trim((string) $item['loai_chi_phi']) : '',
        'ten_chi_phi' => !empty($item['ten_chi_phi']) ? trim((string) $item['ten_chi_phi']) : '',
        'don_gia' => $don_gia,
        'so_luong' => $so_luong,
        'tong_truoc_vat' => $tong_truoc_vat,
        'vat_percent' => $vat_percent,
        'tong_sau_vat' => $tong_sau_vat,
        'trang_thai_duyet' => !empty($item['trang_thai_duyet']) ? trim((string) $item['trang_thai_duyet']) : 'khong_can_duyet',
        'nid_de_nghi_chi_phi' => !empty($item['nid_de_nghi_chi_phi']) ? (int) $item['nid_de_nghi_chi_phi'] : 0,
        'nid_ledger' => !empty($item['nid_ledger']) ? (int) $item['nid_ledger'] : 0,
        'ghi_chu' => !empty($item['ghi_chu']) ? trim((string) $item['ghi_chu']) : '',
        'thong_tin_json' => _ke_hoach_xep_xe_json_encode($json),
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
  }
}

function _ke_hoach_tuyen_xa_save_dau($ke_hoach_id, array $items, array $chang_key_map = array()) {
  db_delete('ke_hoach_tuyen_xa_dau')->condition('ke_hoach_id', (int) $ke_hoach_id)->execute();
  $now = _ke_hoach_xep_xe_now();
  foreach ($items as $item) {
    if (empty($item['ngay']) && empty($item['so_lit']) && empty($item['so_tien']) && empty($item['loai_dau'])) {
      continue;
    }
    $loai_do_dau = _ke_hoach_tuyen_xa_normalize_oil_type(!empty($item['loai_do_dau']) ? $item['loai_do_dau'] : (!empty($item['loai_dau']) ? $item['loai_dau'] : ''));
    $so_lit_dau_cai = isset($item['so_lit_dau_cai']) && $item['so_lit_dau_cai'] !== '' ? (float) $item['so_lit_dau_cai'] : (isset($item['so_lit']) && $item['so_lit'] !== '' ? (float) $item['so_lit'] : 0);
    $so_lit_mooc = isset($item['so_lit_mooc']) && $item['so_lit_mooc'] !== '' ? (float) $item['so_lit_mooc'] : 0;
    $so_lit = isset($item['so_lit']) && $item['so_lit'] !== '' ? (float) $item['so_lit'] : ($so_lit_dau_cai + $so_lit_mooc);
    $json = array(
      'loai_do_dau' => $loai_do_dau,
      'bai_do_dau' => !empty($item['bai_do_dau']) ? trim((string) $item['bai_do_dau']) : '',
      'so_lit_dau_cai' => $so_lit_dau_cai,
      'so_lit_mooc' => $so_lit_mooc,
    );
    db_insert('ke_hoach_tuyen_xa_dau')
      ->fields(array(
        'ke_hoach_id' => (int) $ke_hoach_id,
        'chang_id' => !empty($item['chang_key']) && isset($chang_key_map[(string) $item['chang_key']]) ? (int) $chang_key_map[(string) $item['chang_key']] : 0,
        'ngay' => !empty($item['ngay']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay']) : '',
        'loai_dau' => $loai_do_dau,
        'so_lit' => $so_lit,
        'so_tien' => !empty($item['so_tien']) ? (int) $item['so_tien'] : 0,
        'thong_tin_json' => _ke_hoach_xep_xe_json_encode($json),
        'created' => $now,
        'changed' => $now,
        'hoat_dong' => 1,
      ))
      ->execute();
  }
}

function ke_hoach_tuyen_xa_dau_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_tuyen_xa_dau_rest_list();
    case 'POST':
      return _ke_hoach_tuyen_xa_dau_rest_save();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function _ke_hoach_tuyen_xa_dau_rest_list() {
  if (!user_access('ke_hoach_xep_xe_view')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xem nhật ký dầu');
  }
  $nid_ke_hoach = !empty($_GET['nid_ke_hoach']) ? (int) $_GET['nid_ke_hoach'] : 0;
  if (!$nid_ke_hoach) {
    return _ke_hoach_xep_xe_fail('Thiếu kế hoạch');
  }
  $exists = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $nid_ke_hoach, ':loai' => 'tuyen_xa'))->fetchField();
  if (!$exists) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  $items = _ke_hoach_tuyen_xa_load_dau($nid_ke_hoach);
  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => count($items),
    'current_page' => 1,
    'total_pages' => 1,
  ));
}

function _ke_hoach_tuyen_xa_dau_rest_save() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền lưu nhật ký dầu');
  }
  $input = _ke_hoach_xep_xe_input();
  $nid_ke_hoach = !empty($input['nid_ke_hoach']) ? (int) $input['nid_ke_hoach'] : 0;
  if (!$nid_ke_hoach) {
    return _ke_hoach_xep_xe_fail('Thiếu kế hoạch');
  }
  $exists = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $nid_ke_hoach, ':loai' => 'tuyen_xa'))->fetchField();
  if (!$exists) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }

  $items = !empty($input['items']) && is_array($input['items']) ? $input['items'] : array();
  $clean_items = array();
  foreach ($items as $index => $item) {
    if (!is_array($item)) continue;
    $ngay = !empty($item['ngay']) ? _ke_hoach_tuyen_xa_normalize_date($item['ngay']) : '';
    $so_lit_dau_cai = isset($item['so_lit_dau_cai']) && $item['so_lit_dau_cai'] !== '' ? (float) str_replace(',', '.', preg_replace('/[^\d,.\-]/', '', (string) $item['so_lit_dau_cai'])) : 0;
    $so_lit_mooc = isset($item['so_lit_mooc']) && $item['so_lit_mooc'] !== '' ? (float) str_replace(',', '.', preg_replace('/[^\d,.\-]/', '', (string) $item['so_lit_mooc'])) : 0;
    $so_lit = isset($item['so_lit']) && $item['so_lit'] !== '' ? (float) str_replace(',', '.', preg_replace('/[^\d,.\-]/', '', (string) $item['so_lit'])) : ($so_lit_dau_cai + $so_lit_mooc);
    $so_tien = !empty($item['so_tien']) ? _ke_hoach_xep_xe_parse_money($item['so_tien']) : 0;
    $loai_do_dau = _ke_hoach_tuyen_xa_normalize_oil_type(!empty($item['loai_do_dau']) ? $item['loai_do_dau'] : (!empty($item['loai_dau']) ? $item['loai_dau'] : ''));
    $bai_do_dau = !empty($item['bai_do_dau']) ? trim((string) $item['bai_do_dau']) : '';
    if (!$ngay && !$so_lit && !$so_tien) continue;
    if (!$so_lit_dau_cai && !$so_lit_mooc && $so_lit) {
      $so_lit_dau_cai = $so_lit;
    }
    $clean_items[] = array(
      'ngay' => $ngay,
      'loai_do_dau' => $loai_do_dau,
      'bai_do_dau' => $bai_do_dau,
      'so_lit_dau_cai' => $so_lit_dau_cai,
      'so_lit_mooc' => $so_lit_mooc,
      'so_lit' => $so_lit,
      'so_tien' => $so_tien,
    );
  }

  $transaction = db_transaction();
  try {
    _ke_hoach_tuyen_xa_save_dau($nid_ke_hoach, $clean_items);
    return _ke_hoach_xep_xe_success(array(
      'items' => _ke_hoach_tuyen_xa_load_dau($nid_ke_hoach),
      'total' => count($clean_items),
    ));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_tuyen_xa', 'Lỗi lưu nhật ký dầu kế hoạch #%id: @msg', array('%id' => $nid_ke_hoach, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi lưu nhật ký dầu');
  }
}

function _ke_hoach_tuyen_xa_load_changs($ke_hoach_id) {
  $items = array();
  $rows = db_select('ke_hoach_tuyen_xa_chang', 'c')
    ->fields('c')
    ->condition('c.ke_hoach_id', (int) $ke_hoach_id)
    ->condition('c.hoat_dong', 1)
    ->orderBy('c.thu_tu', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $item['chang_key'] = (string) $item['id'];
    if (!empty($item['nid_lai_xe'])) {
      $lx = db_query("SELECT nid, ten, ma_nhan_vien, sdt FROM {lai_xe} WHERE nid = :nid", array(':nid' => (int) $item['nid_lai_xe']))->fetch();
      $item['lai_xe'] = $lx ? (array) $lx : NULL;
    }
    else {
      $item['lai_xe'] = NULL;
    }
    if (!empty($item['nid_phuong_tien'])) {
      $pt = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien FROM {phuong_tien} WHERE nid = :nid", array(':nid' => (int) $item['nid_phuong_tien']))->fetch();
      $item['phuong_tien'] = $pt ? (array) $pt : NULL;
    }
    else {
      $item['phuong_tien'] = NULL;
    }
    if (!empty($item['nid_mooc'])) {
      $mooc = db_query("SELECT nid, bks, ma_tai_san, loai_phuong_tien FROM {phuong_tien} WHERE nid = :nid", array(':nid' => (int) $item['nid_mooc']))->fetch();
      $item['mooc'] = $mooc ? (array) $mooc : NULL;
    }
    else {
      $item['mooc'] = NULL;
    }
    $item['thong_tin_json'] = _ke_hoach_xep_xe_json_decode(isset($item['thong_tin_json']) ? $item['thong_tin_json'] : '');
    $item['ghi_chu'] = !empty($item['thong_tin_json']['ghi_chu']) ? $item['thong_tin_json']['ghi_chu'] : '';
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_load_chi_phi($ke_hoach_id) {
  $items = array();
  if (!db_table_exists('ke_hoach_chi_phi')) {
    return $items;
  }

  $rows = db_select('ke_hoach_chi_phi', 'c')
    ->fields('c')
    ->condition('c.nid_ke_hoach', (int) $ke_hoach_id)
    ->condition('c.hoat_dong', 1)
    ->orderBy('c.created', 'ASC')
    ->orderBy('c.nid', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $json = _ke_hoach_xep_xe_json_decode(isset($item['thong_tin_json']) ? $item['thong_tin_json'] : '');
    $item['thong_tin_json'] = $json;
    $item['id'] = $item['nid'];
    $item['ke_hoach_id'] = $item['nid_ke_hoach'];
    $item['so_tien'] = isset($item['tong_sau_vat']) ? (int) $item['tong_sau_vat'] : 0;
    $item['ngay'] = !empty($json['ngay']) ? $json['ngay'] : '';
    $item['is_co_dinh'] = !empty($json['is_co_dinh']) ? 1 : 0;
    $item['chang_key'] = !empty($json['chang_key']) ? (string) $json['chang_key'] : (!empty($json['legacy_chang_id']) ? (string) $json['legacy_chang_id'] : '');
    $item['chang_id'] = !empty($json['legacy_chang_id']) ? (int) $json['legacy_chang_id'] : 0;
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_load_dau($ke_hoach_id) {
  $items = array();
  $rows = db_select('ke_hoach_tuyen_xa_dau', 'd')
    ->fields('d')
    ->condition('d.ke_hoach_id', (int) $ke_hoach_id)
    ->condition('d.hoat_dong', 1)
    ->orderBy('d.id', 'ASC')
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    $item = (array) $row;
    $json = _ke_hoach_xep_xe_json_decode(isset($item['thong_tin_json']) ? $item['thong_tin_json'] : '');
    $item['thong_tin_json'] = $json;
    $item['loai_do_dau'] = _ke_hoach_tuyen_xa_normalize_oil_type(!empty($json['loai_do_dau']) ? $json['loai_do_dau'] : (!empty($item['loai_dau']) ? $item['loai_dau'] : ''));
    $item['bai_do_dau'] = !empty($json['bai_do_dau']) ? $json['bai_do_dau'] : '';
    $item['so_lit_dau_cai'] = isset($json['so_lit_dau_cai']) ? (string) $json['so_lit_dau_cai'] : (isset($item['so_lit']) ? (string) $item['so_lit'] : '0');
    $item['so_lit_mooc'] = isset($json['so_lit_mooc']) ? (string) $json['so_lit_mooc'] : '0';
    $item['so_lit'] = isset($item['so_lit']) ? (string) $item['so_lit'] : '0';
    $item['chang_key'] = !empty($item['chang_id']) ? (string) $item['chang_id'] : '';
    $items[] = $item;
  }
  return $items;
}

function _ke_hoach_tuyen_xa_enrich_row($row, $with_children = TRUE) {
  $result = _ke_hoach_xep_xe_enrich_row($row);
  $result['ghi_chu'] = _ke_hoach_tuyen_xa_json_text(isset($result['thong_tin_json']) ? $result['thong_tin_json'] : '');
  if ($with_children) {
    $result['changs'] = _ke_hoach_tuyen_xa_load_changs($result['nid']);
    $result['chi_phi'] = _ke_hoach_tuyen_xa_load_chi_phi($result['nid']);
    $result['dau'] = _ke_hoach_tuyen_xa_load_dau($result['nid']);
  }
  return $result;
}

function ke_hoach_tuyen_xa_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_tuyen_xa_rest_list();
    case 'POST':
      return _ke_hoach_tuyen_xa_rest_create();
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  }
}

function ke_hoach_tuyen_xa_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ke_hoach_xep_xe_fail('ID không hợp lệ');
  }
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ke_hoach_tuyen_xa_rest_get($id);
    case 'PUT':
      return _ke_hoach_tuyen_xa_rest_update($id);
    case 'DELETE':
      return _ke_hoach_tuyen_xa_rest_delete($id);
    default:
      return _ke_hoach_xep_xe_method_not_allowed('GET, PUT, DELETE');
  }
}

/**
 * Kế hoạch kết hợp (hàng vào) là một kế hoạch tuyến xa đầy đủ nhưng liên kết
 * một chiều về chuyến chính. Quan hệ này tuyệt đối không dùng chung với
 * ke_hoach_cont_ref_nid, vốn là quan hệ nhận chặng của container.
 */
function _ke_hoach_tuyen_xa_ket_hop_source($source_id) {
  return db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND hoat_dong = 1 AND loai_ke_hoach = :type AND nid_ke_hoach_nguon = 0", array(
    ':nid' => (int) $source_id,
    ':type' => 'tuyen_xa',
  ))->fetch();
}

function _ke_hoach_tuyen_xa_ket_hop_previous($source_id) {
  return db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid_ke_hoach_nguon = :source AND hoat_dong = 1 AND loai_ke_hoach = :type ORDER BY nid DESC", array(
    ':source' => (int) $source_id,
    ':type' => 'tuyen_xa',
  ))->fetch();
}

function _ke_hoach_tuyen_xa_ket_hop_start_location($source, $previous = NULL) {
  if ($previous) {
    return !empty($previous->bai_ha_thuc_te) ? $previous->bai_ha_thuc_te : (!empty($previous->bai_ha_cont) ? $previous->bai_ha_cont : $previous->diem_den);
  }
  return !empty($source->bai_ha_thuc_te) ? $source->bai_ha_thuc_te : (!empty($source->bai_ha_cont) ? $source->bai_ha_cont : $source->diem_den);
}

function _ke_hoach_tuyen_xa_ket_hop_validate($input) {
  if (empty($input['nid_khach_hang'])) return _ke_hoach_xep_xe_fail('Khách hàng của kế hoạch kết hợp bắt buộc');
  if (empty($input['dia_chi_kho'])) return _ke_hoach_xep_xe_fail('Địa chỉ kho của kế hoạch kết hợp bắt buộc');
  if (empty($input['bai_ha_cont'])) return _ke_hoach_xep_xe_fail('Bãi hạ của kế hoạch kết hợp bắt buộc');
  return NULL;
}

function _ke_hoach_tuyen_xa_ket_hop_fields($source, $previous, $input, $existing = NULL) {
  $start = $existing && !empty($existing->bai_lay_cont)
    ? $existing->bai_lay_cont
    : _ke_hoach_tuyen_xa_ket_hop_start_location($source, $previous);
  $old_json = $existing ? _ke_hoach_xep_xe_json_decode($existing->thong_tin_json) : array();
  $json = array_merge($old_json, !empty($input['thong_tin_json']) && is_array($input['thong_tin_json']) ? $input['thong_tin_json'] : array());
  $json['ke_hoach_ket_hop_hang'] = 1;
  $json['vai_tro_ke_hoach'] = 'ke_hoach_ket_hop';
  $json['nid_ke_hoach_truoc'] = $existing
    ? (!empty($old_json['nid_ke_hoach_truoc']) ? (int) $old_json['nid_ke_hoach_truoc'] : 0)
    : ($previous ? (int) $previous->nid : 0);
  $json['diem_xuat_phat_ket_hop'] = $start;
  $json['loai_hang'] = !empty($input['loai_hang']) ? trim((string) $input['loai_hang']) : '';
  if (array_key_exists('ghi_chu', $input)) $json['ghi_chu'] = trim((string) $input['ghi_chu']);

  $fields = array(
    'nid_khach_hang' => (int) $input['nid_khach_hang'],
    // Các thông tin phương tiện và cont là snapshot từ chuyến chính, không
    // cho người dùng sửa trong kế hoạch kết hợp.
    'nid_lai_xe' => !empty($source->nid_lai_xe) ? (int) $source->nid_lai_xe : 0,
    'nid_phuong_tien' => !empty($source->nid_phuong_tien) ? (int) $source->nid_phuong_tien : 0,
    'nid_mooc' => !empty($source->nid_mooc) ? (int) $source->nid_mooc : 0,
    'so_cont' => !empty($source->so_cont) ? (string) $source->so_cont : '',
    'loai_cont' => !empty($source->loai_cont) ? (string) $source->loai_cont : '',
    'loai_hang' => $json['loai_hang'],
    'dia_chi_kho' => trim((string) $input['dia_chi_kho']),
    'bai_lay_cont' => $start,
    'bai_lay_thuc_te' => $start,
    'bai_ha_cont' => trim((string) $input['bai_ha_cont']),
    'bai_ha_thuc_te' => trim((string) $input['bai_ha_cont']),
    'hinh_thuc_van_tai' => 'ket_hop',
    'ke_hoach_cont_ref_nid' => 0,
    'nid_ke_hoach_nguon' => (int) $source->nid,
    'trang_thai_van_chuyen' => !empty($input['trang_thai_van_chuyen']) ? trim((string) $input['trang_thai_van_chuyen']) : ($existing ? $existing->trang_thai_van_chuyen : 'Chưa xếp xe'),
    'diem_di' => $start,
    'diem_den' => trim((string) $input['bai_ha_cont']),
    'ngay_bat_dau' => !empty($input['ngay_bat_dau']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_bat_dau']) : ($existing ? $existing->ngay_bat_dau : ''),
    'ngay_ket_thuc' => !empty($input['ngay_ket_thuc']) ? _ke_hoach_tuyen_xa_normalize_date($input['ngay_ket_thuc']) : ($existing ? $existing->ngay_ket_thuc : ''),
    'thong_tin_json' => _ke_hoach_xep_xe_json_encode($json),
    'changed' => _ke_hoach_xep_xe_now(),
  );
  return $fields;
}

function ke_hoach_tuyen_xa_ket_hop_rest_collection($source_id) {
  $source_id = (int) $source_id;
  $source = _ke_hoach_tuyen_xa_ket_hop_source($source_id);
  if (!$source) return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa gốc không tồn tại');
  if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    $items = array();
    foreach (db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid_ke_hoach_nguon = :source AND hoat_dong = 1 ORDER BY nid ASC", array(':source' => $source_id))->fetchAll() as $row) {
      $items[] = _ke_hoach_tuyen_xa_enrich_row($row, FALSE);
    }
    return _ke_hoach_xep_xe_success(array('items' => $items, 'source_nid' => $source_id));
  }
  if ($_SERVER['REQUEST_METHOD'] !== 'POST') return _ke_hoach_xep_xe_method_not_allowed('GET, POST');
  if (!user_access('ke_hoach_xep_xe_create')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch kết hợp');
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_ket_hop_validate($input);
  if ($validation) return $validation;
  $fields = _ke_hoach_tuyen_xa_ket_hop_fields($source, _ke_hoach_tuyen_xa_ket_hop_previous($source_id), $input);
  $fields['loai_ke_hoach'] = 'tuyen_xa';
  $fields['created'] = _ke_hoach_xep_xe_now();
  $fields['hoat_dong'] = 1;
  if (!_ke_hoach_xep_xe_has_loai_hang_field()) unset($fields['loai_hang']);
  $nid = db_insert('ke_hoach_xep_xe')->fields($fields)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid", array(':nid' => $nid))->fetch();
  watchdog('ke_hoach_tuyen_xa', 'Tạo kế hoạch kết hợp #%id từ chuyến #%source', array('%id' => $nid, '%source' => $source_id));
  return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row, FALSE));
}

function ke_hoach_tuyen_xa_ket_hop_rest_item($source_id, $id) {
  $source_id = (int) $source_id;
  $id = (int) $id;
  $source = _ke_hoach_tuyen_xa_ket_hop_source($source_id);
  $existing = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid AND nid_ke_hoach_nguon = :source AND hoat_dong = 1", array(':nid' => $id, ':source' => $source_id))->fetch();
  if (!$source || !$existing) return _ke_hoach_xep_xe_not_found('Kế hoạch kết hợp không tồn tại');
  if ($_SERVER['REQUEST_METHOD'] === 'GET') return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($existing, FALSE));
  if ($_SERVER['REQUEST_METHOD'] !== 'PUT') return _ke_hoach_xep_xe_method_not_allowed('GET, PUT');
  if (!user_access('ke_hoach_xep_xe_create')) return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch kết hợp');
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_ket_hop_validate($input);
  if ($validation) return $validation;
  $fields = _ke_hoach_tuyen_xa_ket_hop_fields($source, NULL, $input, $existing);
  if (!_ke_hoach_xep_xe_has_loai_hang_field()) unset($fields['loai_hang']);
  db_update('ke_hoach_xep_xe')->fields($fields)->condition('nid', $id)->execute();
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :nid", array(':nid' => $id))->fetch();
  return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row, FALSE));
}

function _ke_hoach_tuyen_xa_rest_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = isset($_GET['limit']) ? max(1, min(100, (int) $_GET['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('ke_hoach_xep_xe', 'kh');
  $query->fields('kh');
  $query->condition('kh.hoat_dong', 1);
  $query->condition('kh.loai_ke_hoach', 'tuyen_xa');
  if (!empty($_GET['keyword'])) {
    $like = '%' . db_like($_GET['keyword']) . '%';
    $query->condition(db_or()
      ->condition('kh.so_bkg', $like, 'LIKE')
      ->condition('kh.so_cont', $like, 'LIKE')
      ->condition('kh.diem_di', $like, 'LIKE')
      ->condition('kh.cua_khau', $like, 'LIKE')
      ->condition('kh.diem_den', $like, 'LIKE'));
  }
  $count = clone $query;
  $total = (int) $count->countQuery()->execute()->fetchField();
  $total_pages = $total > 0 ? (int) ceil($total / $limit) : 0;

  $query->orderBy('kh.nid', 'DESC');
  $query->range($offset, $limit);
  $items = array();
  foreach ($query->execute()->fetchAll() as $row) {
    $item = _ke_hoach_tuyen_xa_enrich_row($row, FALSE);
    $item['chang_count'] = (int) db_query("SELECT COUNT(*) FROM {ke_hoach_tuyen_xa_chang} WHERE ke_hoach_id = :id AND hoat_dong = 1", array(':id' => $item['nid']))->fetchField();
    $items[] = $item;
  }

  return _ke_hoach_xep_xe_success(array(
    'items' => $items,
    'total' => $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _ke_hoach_tuyen_xa_rest_create() {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền tạo kế hoạch tuyến xa');
  }
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_validate_input($input);
  if ($validation) {
    return $validation;
  }
  $built = _ke_hoach_tuyen_xa_build_parent_record($input);
  $record = $built['parent'];
  $transaction = db_transaction();
  try {
    $fields = array(
      'nid_khach_hang' => $record['nid_khach_hang'],
      'nid_lai_xe' => $record['nid_lai_xe'],
      'so_bkg' => $record['so_bkg'],
      'dia_chi_kho' => $record['dia_chi_kho'],
      'loai_cont' => $record['loai_cont'],
      'so_cont' => $record['so_cont'],
      'nid_phuong_tien' => $record['nid_phuong_tien'],
      'nid_mooc' => $record['nid_mooc'],
      'so_seal_chinh' => $record['so_seal_chinh'],
      'so_seal_tam' => $record['so_seal_tam'],
      'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
      'bai_lay_cont' => $record['bai_lay_cont'],
      'bai_lay_thuc_te' => $record['bai_lay_thuc_te'],
      'bai_ha_cont' => $record['bai_ha_cont'],
      'bai_ha_thuc_te' => $record['bai_ha_thuc_te'],
      'cang_xuat' => $record['cang_xuat'],
      'hinh_thuc_van_tai' => '',
      'ke_hoach_cont_ref_nid' => 0,
      'da_cat_mooc' => 0,
      'da_du_hang' => 0,
      'bai_ha_ngoai' => '',
      'ha_cang' => 0,
      'thong_tin_json' => $record['thong_tin_json'],
      'loai_ke_hoach' => 'tuyen_xa',
      'diem_di' => $built['diem_di'],
      'cua_khau' => $built['cua_khau'],
      'diem_den' => $built['diem_den'],
      'ngay_bat_dau' => $built['ngay_bat_dau'],
      'ngay_ket_thuc' => $built['ngay_ket_thuc'],
      'created' => _ke_hoach_xep_xe_now(),
      'changed' => _ke_hoach_xep_xe_now(),
      'hoat_dong' => 1,
    );
    if (_ke_hoach_xep_xe_has_loai_hang_field()) {
      $fields['loai_hang'] = $record['loai_hang'];
    }
    $nid = db_insert('ke_hoach_xep_xe')
      ->fields($fields)
      ->execute();

    $chang_key_map = _ke_hoach_tuyen_xa_save_changs($nid, $input['changs']);
    _ke_hoach_tuyen_xa_save_chi_phi($nid, !empty($input['chi_phi']) && is_array($input['chi_phi']) ? $input['chi_phi'] : array(), $chang_key_map);
    _ke_hoach_tuyen_xa_save_dau($nid, !empty($input['dau']) && is_array($input['dau']) ? $input['dau'] : array(), $chang_key_map);

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $nid))->fetch();
    watchdog('ke_hoach_tuyen_xa', 'Tạo kế hoạch tuyến xa #%id', array('%id' => $nid));
    return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_tuyen_xa', 'Lỗi tạo kế hoạch tuyến xa: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi tạo kế hoạch tuyến xa');
  }
}

function _ke_hoach_tuyen_xa_rest_get($id) {
  $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetch();
  if (!$row) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
}

function _ke_hoach_tuyen_xa_rest_update($id) {
  if (!user_access('ke_hoach_xep_xe_create')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền sửa kế hoạch tuyến xa');
  }
  $existing = db_query("SELECT nid, trang_thai_van_chuyen, thong_tin_json FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetch();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  $input = _ke_hoach_xep_xe_input();
  $validation = _ke_hoach_tuyen_xa_validate_input($input, TRUE);
  if ($validation) {
    return $validation;
  }
  $built = _ke_hoach_tuyen_xa_build_parent_record($input);
  $record = $built['parent'];
  if (!array_key_exists('trang_thai_van_chuyen', $input)) {
    $record['trang_thai_van_chuyen'] = $existing->trang_thai_van_chuyen;
  }
  $record['thong_tin_json'] = _ke_hoach_xep_xe_merge_json_text(isset($existing->thong_tin_json) ? $existing->thong_tin_json : '', $record['thong_tin_json']);
  $transaction = db_transaction();
  try {
    $fields = array(
      'nid_khach_hang' => $record['nid_khach_hang'],
      'nid_lai_xe' => $record['nid_lai_xe'],
      'so_bkg' => $record['so_bkg'],
      'dia_chi_kho' => $record['dia_chi_kho'],
      'loai_cont' => $record['loai_cont'],
      'so_cont' => $record['so_cont'],
      'nid_phuong_tien' => $record['nid_phuong_tien'],
      'nid_mooc' => $record['nid_mooc'],
      'thong_tin_json' => $record['thong_tin_json'],
      'trang_thai_van_chuyen' => $record['trang_thai_van_chuyen'],
      'diem_di' => $built['diem_di'],
      'cua_khau' => $built['cua_khau'],
      'diem_den' => $built['diem_den'],
      'ngay_bat_dau' => $built['ngay_bat_dau'],
      'ngay_ket_thuc' => $built['ngay_ket_thuc'],
      'changed' => _ke_hoach_xep_xe_now(),
    );
    if (_ke_hoach_xep_xe_has_loai_hang_field()) {
      $fields['loai_hang'] = $record['loai_hang'];
    }
    db_update('ke_hoach_xep_xe')
      ->fields($fields)
      ->condition('nid', $id)
      ->execute();

    $chang_key_map = _ke_hoach_tuyen_xa_save_changs($id, $input['changs']);
    _ke_hoach_tuyen_xa_save_chi_phi($id, !empty($input['chi_phi']) && is_array($input['chi_phi']) ? $input['chi_phi'] : array(), $chang_key_map);
    _ke_hoach_tuyen_xa_save_dau($id, !empty($input['dau']) && is_array($input['dau']) ? $input['dau'] : array(), $chang_key_map);

    $row = db_query("SELECT * FROM {ke_hoach_xep_xe} WHERE nid = :id", array(':id' => $id))->fetch();
    return _ke_hoach_xep_xe_success(_ke_hoach_tuyen_xa_enrich_row($row));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('ke_hoach_tuyen_xa', 'Lỗi cập nhật kế hoạch tuyến xa #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ke_hoach_xep_xe_error('Lỗi hệ thống khi cập nhật kế hoạch tuyến xa');
  }
}

function _ke_hoach_tuyen_xa_rest_delete($id) {
  if (!user_access('ke_hoach_xep_xe_delete')) {
    return _ke_hoach_xep_xe_unauthorized('Bạn không có quyền xoá kế hoạch tuyến xa');
  }
  $existing = db_query("SELECT nid FROM {ke_hoach_xep_xe} WHERE nid = :id AND hoat_dong = 1 AND loai_ke_hoach = :loai", array(':id' => $id, ':loai' => 'tuyen_xa'))->fetchField();
  if (!$existing) {
    return _ke_hoach_xep_xe_not_found('Kế hoạch tuyến xa không tồn tại');
  }
  db_update('ke_hoach_xep_xe')
    ->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))
    ->condition('nid', $id)
    ->execute();
  db_update('ke_hoach_tuyen_xa_chang')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('ke_hoach_id', $id)->execute();
  if (db_table_exists('ke_hoach_chi_phi')) {
    db_update('ke_hoach_chi_phi')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('nid_ke_hoach', $id)->execute();
  }
  db_update('ke_hoach_tuyen_xa_dau')->fields(array('hoat_dong' => 0, 'changed' => _ke_hoach_xep_xe_now()))->condition('ke_hoach_id', $id)->execute();
  return _ke_hoach_xep_xe_success(array('nid' => $id, 'deleted' => TRUE));
}

function ke_hoach_tuyen_xa_page_list() {
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_xep_xe.css');
  drupal_add_css(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/css/ke_hoach_tuyen_xa_screen.css');
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_xep_xe.js', array('group' => JS_THEME, 'weight' => 2));
  drupal_add_js(drupal_get_path('module', 'ke_hoach_xep_xe') . '/assets/js/ke_hoach_chi_phi.js', array('group' => JS_THEME, 'weight' => 3));

  if (module_exists('danh_muc') && function_exists('danh_muc_add_modal_assets')) {
    danh_muc_add_modal_assets();
  }
  if (module_exists('khach_hang') && function_exists('khach_hang_add_modal_assets')) {
    khach_hang_add_modal_assets();
  }

  drupal_add_js(array('ke_hoach_xep_xe' => array(
    'plan_type' => 'tuyen_xa',
    'list_title' => 'Kế hoạch tuyến xa',
    'create_title' => 'Tạo kế hoạch tuyến xa',
    'create_button_text' => 'Thêm kế hoạch tuyến xa',
    'statuses' => _ke_hoach_xep_xe_statuses('tuyen_xa'),
    'khach_hang_quick_create' => _ke_hoach_xep_xe_khach_hang_quick_create_settings(),
    'permissions' => array(
      'view' => user_access('ke_hoach_xep_xe_view'),
      'create' => user_access('ke_hoach_xep_xe_create'),
      'delete' => user_access('ke_hoach_xep_xe_delete'),
    ),
  )), 'setting');
  return theme('ke_hoach_tuyen_xa_screen_list_page');
}
