}

function quan_ly_tai_chinh_theme() {
  $path = drupal_get_path('module', 'quan_ly_tai_chinh') . '/templates';
  return array(
    'quan_ly_tai_chinh_dashboard_page' => array(
      'template' => 'quan-ly-tai-chinh-dashboard',
      'path' => $path,
      'variables' => array('dashboard_actions' => ''),
    ),
    'quan_ly_tai_chinh_quy_page' => array(
      'template' => 'quan-ly-tai-chinh-quy',
      'path' => $path,
      'variables' => array('render_mode' => 'page', 'filter_html' => '', 'table_html' => '', 'quy' => NULL, 'history_html' => '', 'so_cai_html' => '', 'loai_options' => array(), 'old_balance' => 0),
    ),
  );
}

/**
 * Nạp CSS/JS của module.
 *
 * Lưu ý: theme hiện tại print $head và $styles riêng trong html.tpl.php.
 * Vì vậy ngoài drupal_add_css(), module còn đẩy thêm thẻ <link> vào
 * html head bằng drupal_add_html_head() để tránh trường hợp CSS module
 * không xuất hiện trong biến $styles khi render trang quản lý quỹ.
 */
function quan_ly_tai_chinh_add_assets() {
  static $added = FALSE;

  if ($added) {
    return;
  }

  $added = TRUE;
  $path = drupal_get_path('module', 'quan_ly_tai_chinh');
  $css_path = $path . '/css/quan_ly_tai_chinh.css';
  $js_path = $path . '/js/quan_ly_tai_chinh.js';

  /*
   * Cách chuẩn của Drupal: đưa CSS vào hệ thống css/js assets.
   * preprocess = FALSE giúp dễ kiểm tra trong view-source và tránh bị
   * gom vào file aggregate khi cần debug giao diện.
   */
  drupal_add_css($css_path, array(
    'type' => 'file',
    'group' => CSS_THEME,
    'weight' => 1000,
    'preprocess' => FALSE,
    'every_page' => FALSE,
  ));

  /*
   * Fallback bắt buộc: thêm trực tiếp link stylesheet vào $head.
   * Cách này xử lý trường hợp theme/html.tpl.php không in ra CSS từ
   * drupal_add_css() đúng thời điểm. Key cố định để không bị lặp link.
   */
  $query_string = variable_get('css_js_query_string', '');
  $css_url = base_path() . $css_path;
  if ($query_string !== '') {
    $css_url .= '?' . $query_string;
  }

  drupal_add_html_head(array(
    '#tag' => 'link',
    '#attributes' => array(
      'rel' => 'stylesheet',
      'type' => 'text/css',
      'media' => 'all',
      'href' => $css_url,
      'data-module' => 'quan_ly_tai_chinh',
    ),
  ), 'quan_ly_tai_chinh_css');

  drupal_add_js($js_path, array(
    'type' => 'file',
    'scope' => 'footer',
    'group' => JS_THEME,
    'weight' => 100,
    'preprocess' => FALSE,
    'every_page' => FALSE,
  ));
}

/**
 * Kiểm tra các trang cần nạp asset tài chính.
 */
function quan_ly_tai_chinh_should_load_assets($path = NULL) {
  if ($path === NULL) {
    $path = current_path();
  }

  return $path === 'quan-ly-tai-chinh'
    || $path === 'quan-ly-quy'
    || strpos($path, 'quan-ly-quy/') === 0;
}


/**
 * Machine name content type lưu thông tin quỹ.
 */
function quan_ly_tai_chinh_quy_bundle() {
  return 'quy_tai_chinh';
}

function quan_ly_tai_chinh_ensure_quy_table() {
  if (!function_exists('db_table_exists')) {
    return FALSE;
  }
  if (!db_table_exists('qltc_quy')) {
    $schema = drupal_get_schema('qltc_quy');
    if ($schema) {
      db_create_table('qltc_quy', $schema);
      return TRUE;
    }
    return FALSE;
  }
  return TRUE;
}

/**
 * Đảm bảo content type và các field lưu thông tin quỹ đã tồn tại.
 *
 * Cấu trúc lưu trữ quỹ:
 * - node.title: mã quỹ, được xem như khóa chính nghiệp vụ.
 * - field_thong_tin_json: lưu các thông tin dạng text như ten_quy,
 *   loai_quy, ghi_chu.
 * - field_so_du_dau_ky, field_so_du_hien_tai: số dư dạng số.
 * - field_hoat_dong: 1 = đang tồn tại, 0 = đã xóa mềm.
 * - node.status luôn được đặt 0 khi lưu.
 */
function quan_ly_tai_chinh_ensure_quy_content_type() {
  quan_ly_tai_chinh_ensure_quy_table();
}

/**
 * Tạo field storage nếu chưa tồn tại.
 */
function quan_ly_tai_chinh_ensure_field_definition($field_name, $type, array $settings = array()) {
  if (field_info_field($field_name)) {
    return;
  }

  $field = array(
    'field_name' => $field_name,
    'type' => $type,
    'cardinality' => 1,
    'settings' => $settings,
  );
  field_create_field($field);
}

/**
 * Gắn field vào content type quỹ nếu chưa có instance.
 */
function quan_ly_tai_chinh_ensure_field_instance($bundle, $field_name, $label) {
  if (field_info_instance('node', $field_name, $bundle)) {
    return;
  }

  $field = field_info_field($field_name);
  $type = !empty($field['type']) ? $field['type'] : 'text';
  $widget_type = quan_ly_tai_chinh_widget_type_from_field_type($type);

  $instance = array(
    'field_name' => $field_name,
    'entity_type' => 'node',
    'bundle' => $bundle,
    'label' => $label,
    'required' => FALSE,
    'widget' => array(
      'type' => $widget_type,
    ),
    'display' => array(
      'default' => array('label' => 'above', 'type' => 'hidden'),
      'teaser' => array('label' => 'above', 'type' => 'hidden'),
    ),
  );

  field_create_instance($instance);
}

/**
 * Chọn widget phù hợp với kiểu field hiện có.
 */
function quan_ly_tai_chinh_widget_type_from_field_type($type) {
  switch ($type) {
    case 'text_long':
    case 'text_with_summary':
      return 'text_textarea';

    case 'number_decimal':
    case 'number_integer':
    case 'number_float':
      return 'number';

    case 'list_boolean':
      return 'options_buttons';

    case 'list_integer':
    case 'list_text':
      return 'options_select';
  }

  return 'text_textfield';
}

/**
 * Đảm bảo storage quỹ sẵn sàng và tự migrate dữ liệu cũ nếu có.
 */
function quan_ly_tai_chinh_ensure_quy_hoat_dong_field() {
  quan_ly_tai_chinh_ensure_quy_content_type();
}

/**
 * Migrate dữ liệu quỹ cũ từ bảng qltc_quy sang node quy_tai_chinh.
 */
function quan_ly_tai_chinh_migrate_quy_table_to_nodes($force = FALSE) {
  if (!$force && variable_get('quan_ly_tai_chinh_quy_node_migrated', 0)) {
    return;
  }

  if (!db_table_exists('qltc_quy')) {
    variable_set('quan_ly_tai_chinh_quy_node_migrated', 1);
    return;
  }

  quan_ly_tai_chinh_ensure_quy_content_type();

  $map = array();
  $rows = db_select('qltc_quy', 'q')->fields('q')->execute()->fetchAll();
  foreach ($rows as $row) {
    $ma_quy = trim($row->ma_quy);
    if ($ma_quy === '') {
      continue;
    }

    $nid = quan_ly_tai_chinh_quy_find_nid_by_ma($ma_quy);
    if ($nid) {
      $node = node_load($nid);
    }
    else {
      $node = new stdClass();
      $node->type = quan_ly_tai_chinh_quy_bundle();
      node_object_prepare($node);
      $node->title = $ma_quy;
      $node->uid = 1;
      $node->created = !empty($row->created) ? intval($row->created) : REQUEST_TIME;
    }

    $info = array(
      'ten_quy' => isset($row->ten_quy) ? $row->ten_quy : '',
      'loai_quy' => isset($row->loai_quy) ? $row->loai_quy : 'tien_mat',
      'ghi_chu' => isset($row->ghi_chu) ? $row->ghi_chu : '',
    );

    $node->title = $ma_quy;
    $node->status = 0;
    $node->changed = !empty($row->changed) ? intval($row->changed) : REQUEST_TIME;
    quan_ly_tai_chinh_quy_node_set_text_info($node, $info);
    quan_ly_tai_chinh_node_set_field_value($node, 'field_so_du_dau_ky', quan_ly_tai_chinh_money_to_number(isset($row->so_du_dau_ky) ? $row->so_du_dau_ky : 0));
    quan_ly_tai_chinh_node_set_field_value($node, 'field_so_du_hien_tai', quan_ly_tai_chinh_money_to_number(isset($row->so_du_hien_tai) ? $row->so_du_hien_tai : 0));
    quan_ly_tai_chinh_node_set_field_value($node, 'field_hoat_dong', isset($row->field_hoat_dong) ? intval($row->field_hoat_dong) : 1);
    node_save($node);

    $map[intval($row->quy_id)] = intval($node->nid);
  }

  if (!empty($map) && db_table_exists('qltc_giao_dich')) {
    foreach ($map as $old_id => $new_nid) {
      db_update('qltc_giao_dich')->fields(array('quy_id' => -1 * $new_nid))->condition('quy_id', $old_id)->execute();
      db_update('qltc_giao_dich')->fields(array('quy_nhan_id' => -1 * $new_nid))->condition('quy_nhan_id', $old_id)->execute();
    }
    foreach ($map as $old_id => $new_nid) {
      db_update('qltc_giao_dich')->fields(array('quy_id' => $new_nid))->condition('quy_id', -1 * $new_nid)->execute();
      db_update('qltc_giao_dich')->fields(array('quy_nhan_id' => $new_nid))->condition('quy_nhan_id', -1 * $new_nid)->execute();
    }

    foreach ($map as $old_id => $new_nid) {
      quan_ly_tai_chinh_rebuild_quy_balance($new_nid);
    }
  }

  variable_set('quan_ly_tai_chinh_quy_node_migrated', 1);
}

/**
 * Tìm node quỹ theo mã quỹ đang lưu trong title.
 */
function quan_ly_tai_chinh_quy_find_nid_by_ma($ma_quy, $exclude_nid = 0) {
  quan_ly_tai_chinh_ensure_quy_table();
  $query = db_select('qltc_quy', 'q')
    ->fields('q', array('nid'))
    ->condition('ma_quy', trim($ma_quy));

  if ($exclude_nid) {
    $query->condition('nid', intval($exclude_nid), '<>');
  }

  return intval($query->range(0, 1)->execute()->fetchField());
}

/**
 * Đọc giá trị field đơn của node.
 */
function quan_ly_tai_chinh_node_get_field_value($node, $field_name, $default = '') {
  if (isset($node->{$field_name}[LANGUAGE_NONE][0]['value'])) {
    return $node->{$field_name}[LANGUAGE_NONE][0]['value'];
  }

  if (!empty($node->{$field_name}) && is_array($node->{$field_name})) {
    foreach ($node->{$field_name} as $lang_items) {
      if (isset($lang_items[0]['value'])) {
        return $lang_items[0]['value'];
      }
    }
  }

  return $default;
}

/**
 * Gán giá trị field đơn cho node.
 */
function quan_ly_tai_chinh_node_set_field_value(&$node, $field_name, $value) {
  $node->{$field_name}[LANGUAGE_NONE][0]['value'] = $value;
}

/**
 * Encode JSON có hỗ trợ tiếng Việt.
 */
function quan_ly_tai_chinh_json_encode(array $data) {
  $options = defined('JSON_UNESCAPED_UNICODE') ? JSON_UNESCAPED_UNICODE : 0;
  return json_encode($data, $options);
}

/**
 * Đọc toàn bộ JSON text của node quỹ, giữ cả lịch sử điều chỉnh nếu có.
 */
function quan_ly_tai_chinh_quy_node_get_json_data($node) {
  $raw = '';
  if (is_object($node) && isset($node->thong_tin_json)) {
    $raw = $node->thong_tin_json;
  }
  else {
    $raw = quan_ly_tai_chinh_node_get_field_value($node, 'field_thong_tin_json', '');
  }
  $data = $raw !== '' ? json_decode($raw, TRUE) : array();
  return is_array($data) ? $data : array();
}

/**
 * Lưu các thông tin dạng text của quỹ vào field_thong_tin_json.
 *
 * Hàm này chỉ cập nhật ten_quy, loai_quy, ghi_chu và giữ nguyên
 * các khóa khác trong JSON như lich_su_dieu_chinh_so_du.
 */
function quan_ly_tai_chinh_quy_node_set_text_info(&$node, array $info) {
  $data = quan_ly_tai_chinh_quy_node_get_json_data($node);
  $data['ten_quy'] = isset($info['ten_quy']) ? trim($info['ten_quy']) : '';
  $data['loai_quy'] = isset($info['loai_quy']) ? trim($info['loai_quy']) : 'tien_mat';
  $data['ghi_chu'] = isset($info['ghi_chu']) ? trim($info['ghi_chu']) : '';
  $json = quan_ly_tai_chinh_json_encode($data);
  if (is_object($node) && property_exists($node, 'thong_tin_json')) {
    $node->thong_tin_json = $json;
    $node->ten_quy = $data['ten_quy'];
    $node->loai_quy = $data['loai_quy'];
    $node->ghi_chu = $data['ghi_chu'];
    return;
  }
  quan_ly_tai_chinh_node_set_field_value($node, 'field_thong_tin_json', $json);
}

/**
 * Đọc field_thong_tin_json của node quỹ.
 */
function quan_ly_tai_chinh_quy_node_get_text_info($node) {
  $data = quan_ly_tai_chinh_quy_node_get_json_data($node);

  return array(
    'ten_quy' => isset($data['ten_quy']) ? $data['ten_quy'] : (isset($node->ten_quy) ? $node->ten_quy : (isset($node->title) ? $node->title : '')),
    'loai_quy' => isset($data['loai_quy']) ? $data['loai_quy'] : 'tien_mat',
    'ghi_chu' => isset($data['ghi_chu']) ? $data['ghi_chu'] : (isset($node->ghi_chu) ? $node->ghi_chu : ''),
  );
}

/**
 * Chuyển node quy_tai_chinh sang object tương thích code cũ.
 */
function quan_ly_tai_chinh_quy_node_to_object($node) {
  $info = quan_ly_tai_chinh_quy_node_get_text_info($node);
  $quy = new stdClass();
  $quy->quy_id = intval($node->nid);
  $quy->nid = intval($node->nid);
  $quy->ma_quy = isset($node->ma_quy) ? $node->ma_quy : $node->title;
  $quy->ten_quy = $info['ten_quy'];
  $quy->loai_quy = $info['loai_quy'];
  $quy->ghi_chu = $info['ghi_chu'];
  $quy->so_du_dau_ky = isset($node->so_du_dau_ky) ? quan_ly_tai_chinh_money_to_number($node->so_du_dau_ky) : quan_ly_tai_chinh_money_to_number(quan_ly_tai_chinh_node_get_field_value($node, 'field_so_du_dau_ky', 0));
  $quy->so_du_hien_tai = isset($node->so_du_hien_tai) ? quan_ly_tai_chinh_money_to_number($node->so_du_hien_tai) : quan_ly_tai_chinh_money_to_number(quan_ly_tai_chinh_node_get_field_value($node, 'field_so_du_hien_tai', 0));
  $quy->field_hoat_dong = isset($node->hoat_dong) ? intval($node->hoat_dong) : intval(quan_ly_tai_chinh_node_get_field_value($node, 'field_hoat_dong', 1));
  $quy->hoat_dong = $quy->field_hoat_dong;
  $quy->status = intval($node->status);
  $quy->uid = isset($node->uid) ? intval($node->uid) : 0;
  $quy->created = intval($node->created);
  $quy->changed = intval($node->changed);
  $quy->thong_tin_json = isset($node->thong_tin_json) ? $node->thong_tin_json : '';
  return $quy;
}

/**
 * Implements hook_init().
 *
 * Load asset sớm để $head/$styles trong html.tpl.php chắc chắn nhận được.
 */
function quan_ly_tai_chinh_init() {
  if (quan_ly_tai_chinh_should_load_assets()) {
    quan_ly_tai_chinh_ensure_quy_hoat_dong_field();
    quan_ly_tai_chinh_add_assets();
  }
}

/**
 * Implements hook_page_build().
 *
 * Giữ lại hook này để các trang render bằng callback/Ajax vẫn có asset.
 */
function quan_ly_tai_chinh_page_build(&$page) {
  if (quan_ly_tai_chinh_should_load_assets()) {
    quan_ly_tai_chinh_ensure_quy_hoat_dong_field();
    quan_ly_tai_chinh_add_assets();
  }
}

/**
 * Dashboard nhanh.
 */
function quan_ly_tai_chinh_dashboard() {
  quan_ly_tai_chinh_add_assets();

  $dashboard_actions = '';
  $dashboard_actions .= l('Quản lý quỹ', 'quan-ly-quy', array('attributes' => array('class' => array('btn', 'btn-primary'))));
  $dashboard_actions .= l('Thu chi', 'thu-chi', array('attributes' => array('class' => array('btn', 'btn-success'))));
  $dashboard_actions .= l('Thêm giao dịch', 'thu-chi/them', array('attributes' => array('class' => array('btn', 'btn-outline-primary', 'tc-thu-chi-open-modal'), 'data-url' => url('thu-chi/ajax-form'), 'data-title' => 'Tạo phiếu thu/chi')));

  return theme('quan_ly_tai_chinh_dashboard_page', array('dashboard_actions' => $dashboard_actions));
}

/**
 * Danh sách quỹ và số dư theo kỳ.
 */
function quan_ly_tai_chinh_quy_page() {
  quan_ly_tai_chinh_add_assets();

  $filters = quan_ly_tai_chinh_get_date_filters();

  return theme('quan_ly_tai_chinh_quy_page', array(
    'render_mode' => 'page',
    'action' => 'quan-ly-quy',
    'filters' => $filters,
    'table_items' => quan_ly_tai_chinh_quy_table_data($filters),
  ));
}

/**
 * Render riêng bảng danh sách quỹ để refresh bằng AJAX.
 */
function quan_ly_tai_chinh_quy_table_data($filters = NULL) {
  if (!$filters) {
    $filters = quan_ly_tai_chinh_get_date_filters();
  }

  $quys = quan_ly_tai_chinh_quy_get_all(TRUE);

  $items = array();
  $stt = 1;
  foreach ($quys as $quy) {
    $period = quan_ly_tai_chinh_quy_period_summary($quy->quy_id, $filters['from_time'], $filters['to_time']);

    $items[] = array(
      'stt' => $stt++,
      'quy' => $quy,
      'period' => $period,
    );
  }

  return $items;
}

function quan_ly_tai_chinh_quy_table_html($filters = NULL) {
  return theme('quan_ly_tai_chinh_quy_page', array(
    'render_mode' => 'table',
    'table_items' => quan_ly_tai_chinh_quy_table_data($filters),
  ));
}

/**
 * AJAX: trả về bảng quỹ mới nhất.
 */
function quan_ly_tai_chinh_quy_ajax_list() {
  return array(
    'success' => TRUE,
    'html' => quan_ly_tai_chinh_quy_table_html(),
  );
}


/**
 * AJAX: trả về chi tiết quỹ.
 */
function quan_ly_tai_chinh_quy_ajax_detail($quy_id) {
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy || intval($quy->field_hoat_dong) !== 1) {
    return array(
      'success' => FALSE,
      'message' => 'Không tìm thấy quỹ cần xem chi tiết.',
    );
  }

  return array(
    'success' => TRUE,
    'title' => 'Chi tiết quỹ',
    'size' => 'modal-xl',
    'html' => quan_ly_tai_chinh_quy_detail_modal_html($quy),
  );
}

/**
 * HTML chi tiết quỹ, bao gồm lịch sử điều chỉnh số dư đầu kỳ.
 */
function quan_ly_tai_chinh_quy_detail_modal_html($quy) {
  $json = quan_ly_tai_chinh_quy_node_get_json_data($quy);
  $histories = array();

  if (!empty($json['lich_su_dieu_chinh_so_du']) && is_array($json['lich_su_dieu_chinh_so_du'])) {
    $histories = $json['lich_su_dieu_chinh_so_du'];
    usort($histories, 'quan_ly_tai_chinh_quy_history_sort_desc');
  }

  $history_html = '';
  if (empty($histories)) {
    $history_html = '<div class="alert alert-info py-2 mb-0">Chưa có lịch sử điều chỉnh số dư đầu kỳ.</div>';
  }
  else {
    $header = array(
      array('data' => 'STT', 'class' => array('text-center')),
      'Ngày điều chỉnh',
      array('data' => 'Số dư cũ', 'class' => array('text-end')),
      array('data' => 'Số dư mới', 'class' => array('text-end')),
      array('data' => 'Chênh lệch', 'class' => array('text-end')),
      'Người thực hiện',
      'Lý do',
    );

    $rows = array();
    $stt = 1;
    foreach ($histories as $item) {
      $old_balance = isset($item['so_du_cu']) ? quan_ly_tai_chinh_money_to_number($item['so_du_cu']) : 0;
      $new_balance = isset($item['so_du_moi']) ? quan_ly_tai_chinh_money_to_number($item['so_du_moi']) : 0;
      $diff = isset($item['chenh_lech']) ? quan_ly_tai_chinh_money_to_number($item['chenh_lech']) : ($new_balance - $old_balance);
      $diff_text = ($diff > 0 ? '+' : '') . quan_ly_tai_chinh_format_money($diff);
      $diff_class = $diff > 0 ? 'text-success' : ($diff < 0 ? 'text-danger' : 'text-muted');
      $date_text = !empty($item['ngay_dieu_chinh_text']) ? $item['ngay_dieu_chinh_text'] : (!empty($item['ngay_dieu_chinh']) ? date('d/m/Y', intval($item['ngay_dieu_chinh'])) : '-');
      $user_name = quan_ly_tai_chinh_user_display_name(isset($item['nguoi_thuc_hien']) ? intval($item['nguoi_thuc_hien']) : 0);
      $reason = !empty($item['ly_do']) ? $item['ly_do'] : '-';

      $rows[] = array(
        array('data' => $stt++, 'class' => array('text-center')),
        check_plain($date_text),
        array('data' => quan_ly_tai_chinh_format_money($old_balance), 'class' => array('text-end')),
        array('data' => '<strong>' . quan_ly_tai_chinh_format_money($new_balance) . '</strong>', 'class' => array('text-end')),
        array('data' => '<span class="' . $diff_class . ' fw-semibold">' . check_plain($diff_text) . '</span>', 'class' => array('text-end')),
        check_plain($user_name),
        check_plain($reason),
      );
    }

    $history_html .= '<div class="table-responsive text-nowrap">';
    $history_html .= theme('table', array(
      'header' => $header,
      'rows' => $rows,
      'attributes' => array('class' => array('table', 'table-bordered', 'table-hover', 'align-middle', 'qltc-table', 'qltc-quy-history-table')),
    ));
    $history_html .= '</div>';
  }

  return theme('quan_ly_tai_chinh_quy_page', array(
    'render_mode' => 'detail',
    'quy' => $quy,
    'history_html' => $history_html,
    'so_cai_html' => quan_ly_tai_chinh_quy_thu_chi_history_html(intval($quy->quy_id), $json),
  ));
}

/**
 * Sắp xếp lịch sử điều chỉnh mới nhất lên đầu.
 */
function quan_ly_tai_chinh_quy_history_sort_desc($a, $b) {
  $time_a = quan_ly_tai_chinh_quy_history_time($a);
  $time_b = quan_ly_tai_chinh_quy_history_time($b);
  if ($time_a == $time_b) {
    return 0;
  }
  return $time_a > $time_b ? -1 : 1;
}


/**
 * Lấy mốc thời gian từ một item lịch sử quỹ.
 */
function quan_ly_tai_chinh_quy_history_time($item) {
  if (!empty($item['time'])) {
    return intval($item['time']);
  }
  if (!empty($item['thoi_gian'])) {
    return intval($item['thoi_gian']);
  }
  if (!empty($item['ngay_dieu_chinh'])) {
    return intval($item['ngay_dieu_chinh']);
  }
  return 0;
}

/**
 * Render lịch sử thu/chi quỹ từ sổ cái qltc_so_cai_quy.
 *
 * JSON trong quỹ chỉ còn là thông tin phụ/fallback, không dùng làm nguồn tính
 * số dư hay nguồn truy vấn chính.
 */
function quan_ly_tai_chinh_quy_thu_chi_history_html($quy_id, array $json = array()) {
  $quy_id = intval($quy_id);
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $histories = array();

  if ($quy_id && db_table_exists('qltc_so_cai_quy')) {
    $query = db_select('qltc_so_cai_quy', 'sc')
      ->fields('sc')
      ->condition('quy_nid', $quy_id)
      ->condition('status', 1)
      ->orderBy('ngay_giao_dich', 'DESC')
      ->orderBy('id', 'DESC')
      ->range(0, 200);
    $histories = $query->execute()->fetchAll();
  }

  $html = '<div class="d-flex align-items-center justify-content-between gap-2 mt-4 mb-2">';
  $html .= '<h6 class="mb-0 fw-semibold"><i class="icon-base ti tabler-receipt-2 me-1"></i>Lịch sử biến động sổ cái quỹ</h6>';
  $html .= '<span class="badge bg-label-primary">' . count($histories) . ' biến động</span>';
  $html .= '</div>';

  if (empty($histories)) {
    $html .= '<div class="alert alert-info py-2 mb-0">Chưa có biến động sổ cái quỹ.</div>';
    return $html;
  }

  $header = array(
    array('data' => 'STT', 'class' => array('text-center')),
    'Ngày giao dịch',
    'Mã chứng từ',
    'Loại',
    array('data' => 'Thu', 'class' => array('text-end')),
    array('data' => 'Chi', 'class' => array('text-end')),
    array('data' => 'Số dư trước', 'class' => array('text-end')),
    array('data' => 'Số dư sau', 'class' => array('text-end')),
    'Nguồn',
    'Người thực hiện',
  );

  $rows = array();
  $stt = 1;
  foreach ($histories as $item) {
    $delta = quan_ly_tai_chinh_money_to_number($item->bien_dong);
    $thu = $delta > 0 ? quan_ly_tai_chinh_format_money($delta) : '';
    $chi = $delta < 0 ? quan_ly_tai_chinh_format_money(abs($delta)) : '';
    $source = trim((string) $item->source_type) . (!empty($item->source_id) ? ' #' . intval($item->source_id) : '');

    $rows[] = array(
      array('data' => $stt++, 'class' => array('text-center')),
      check_plain(!empty($item->ngay_giao_dich) ? date('d/m/Y', intval($item->ngay_giao_dich)) : '-'),
      check_plain(!empty($item->ma_chung_tu) ? $item->ma_chung_tu : '-'),
      check_plain(!empty($item->loai_bien_dong) ? $item->loai_bien_dong : '-'),
      array('data' => $thu ? '<span class="text-success fw-semibold">' . $thu . '</span>' : '', 'class' => array('text-end')),
      array('data' => $chi ? '<span class="text-danger fw-semibold">' . $chi . '</span>' : '', 'class' => array('text-end')),
      array('data' => quan_ly_tai_chinh_format_money($item->so_du_truoc), 'class' => array('text-end')),
      array('data' => '<strong>' . quan_ly_tai_chinh_format_money($item->so_du_sau) . '</strong>', 'class' => array('text-end')),
      check_plain($source),
      check_plain(!empty($item->uid_thuc_hien) ? quan_ly_tai_chinh_user_display_name($item->uid_thuc_hien) : '-'),
    );
  }

  $html .= '<div class="table-responsive text-nowrap">';
  $html .= theme('table', array(
    'header' => $header,
    'rows' => $rows,
    'attributes' => array('class' => array('table', 'table-bordered', 'table-hover', 'align-middle', 'qltc-table', 'qltc-quy-history-table')),
  ));
  $html .= '</div>';
  return $html;
}

/**
 * Tên người dùng cho lịch sử thao tác.
 */
function quan_ly_tai_chinh_user_display_name($uid) {
  $uid = intval($uid);
  if ($uid <= 0) {
    return 'Hệ thống';
  }

  $account = user_load($uid);
  if (!$account) {
    return 'User #' . $uid;
  }

  if (!empty($account->name)) {
    return $account->name;
  }

  return 'User #' . $uid;
}

/**
 * AJAX: trả về form thêm/sửa quỹ.
 */
function quan_ly_tai_chinh_quy_ajax_form($quy_id = 0) {
  $quy_id = intval($quy_id);
  $quy = $quy_id ? quan_ly_tai_chinh_quy_load($quy_id) : NULL;

  if ($quy_id && !$quy) {
    return array(
      'success' => FALSE,
      'message' => 'Không tìm thấy quỹ cần sửa.',
    );
  }

  return array(
    'success' => TRUE,
    'title' => $quy_id ? 'Sửa thông tin quỹ' : 'Thêm quỹ',
    'size' => 'modal-lg',
    'html' => quan_ly_tai_chinh_quy_modal_form_html($quy),
  );
}

/**
 * HTML form thêm/sửa quỹ trong modal Bootstrap 5.
 */
function quan_ly_tai_chinh_quy_modal_form_html($quy = NULL) {
  return theme('quan_ly_tai_chinh_quy_page', array(
    'render_mode' => 'form',
    'quy' => $quy,
    'loai_options' => quan_ly_tai_chinh_loai_quy_options(),
  ));
}

/**
 * AJAX: lưu thông tin quỹ.
 */
function quan_ly_tai_chinh_quy_ajax_save() {
  global $user;

  quan_ly_tai_chinh_ensure_quy_content_type();

  $quy_id = isset($_POST['quy_id']) ? intval($_POST['quy_id']) : 0;
  $ma_quy = isset($_POST['ma_quy']) ? trim($_POST['ma_quy']) : '';
  $ten_quy = isset($_POST['ten_quy']) ? trim($_POST['ten_quy']) : '';
  $loai_quy = isset($_POST['loai_quy']) ? trim($_POST['loai_quy']) : 'tien_mat';
  $so_du_dau_ky = isset($_POST['so_du_dau_ky']) ? quan_ly_tai_chinh_money_to_number($_POST['so_du_dau_ky']) : 0;
  $ghi_chu = isset($_POST['ghi_chu']) ? trim($_POST['ghi_chu']) : '';

  if ($ma_quy === '') {
    return array('success' => FALSE, 'message' => 'Vui lòng nhập mã quỹ.');
  }

  if ($ten_quy === '') {
    return array('success' => FALSE, 'message' => 'Vui lòng nhập tên quỹ.');
  }

  $loai_options = quan_ly_tai_chinh_loai_quy_options();
  if (!isset($loai_options[$loai_quy])) {
    $loai_quy = 'tien_mat';
  }

  if (quan_ly_tai_chinh_quy_find_nid_by_ma($ma_quy, $quy_id)) {
    return array('success' => FALSE, 'message' => 'Mã quỹ đã tồn tại, vui lòng nhập mã khác.');
  }

  $now = REQUEST_TIME;
  $json_data = array(
    'ten_quy' => $ten_quy,
    'loai_quy' => $loai_quy,
    'ghi_chu' => $ghi_chu,
  );

  if ($quy_id) {
    $existing = quan_ly_tai_chinh_quy_load($quy_id);
    if (!$existing) {
      return array('success' => FALSE, 'message' => 'Không tìm thấy quỹ cần cập nhật.');
    }
    if (intval($existing->field_hoat_dong) !== 1) {
      return array('success' => FALSE, 'message' => 'Không tìm thấy quỹ cần cập nhật.');
    }

    $current_json = quan_ly_tai_chinh_quy_node_get_json_data($existing);
    $json_data = array_merge($current_json, $json_data);

    db_update('qltc_quy')
      ->fields(array(
        'ma_quy' => $ma_quy,
        'ten_quy' => $ten_quy,
        'loai_quy' => $loai_quy,
        'ghi_chu' => $ghi_chu,
        'thong_tin_json' => quan_ly_tai_chinh_json_encode($json_data),
        'uid' => isset($user->uid) ? intval($user->uid) : 0,
        'status' => 0,
        'hoat_dong' => 1,
        'changed' => $now,
      ))
      ->condition('nid', $quy_id)
      ->execute();

    $message = 'Đã cập nhật thông tin quỹ.';
  }
  else {
    $quy_id = db_insert('qltc_quy')
      ->fields(array(
        'ma_quy' => $ma_quy,
        'ten_quy' => $ten_quy,
        'loai_quy' => $loai_quy,
        'ghi_chu' => $ghi_chu,
        'thong_tin_json' => quan_ly_tai_chinh_json_encode($json_data),
        'so_du_dau_ky' => $so_du_dau_ky,
        'so_du_hien_tai' => $so_du_dau_ky,
        'uid' => isset($user->uid) ? intval($user->uid) : 0,
        'status' => 0,
        'hoat_dong' => 1,
        'created' => $now,
        'changed' => $now,
      ))
      ->execute();
    $message = 'Đã thêm quỹ mới.';
  }

  quan_ly_tai_chinh_rebuild_quy_balance($quy_id);

  return array(
    'success' => TRUE,
    'message' => $message,
    'quy_id' => intval($quy_id),
  );
}

/**
 * AJAX: trả về form điều chỉnh số dư đầu kỳ.
 */
function quan_ly_tai_chinh_quy_ajax_adjust_form($quy_id) {
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy || intval($quy->field_hoat_dong) !== 1) {
