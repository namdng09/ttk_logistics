<?php

// Tiện ích dùng chung (khuôn phản hồi, xác thực bằng token, phân trang): module api_common. Nạp thẳng file khi module chưa bật để
// API không hỏng nếu quên bật (bật module vẫn cần để xác thực bằng token hoạt động ở hook_init).
if (!function_exists('api_response_success')) {
  require_once dirname(__FILE__) . '/../api_common/api_common.module';
}

/**
 * @file
 * Quản lý quỹ (màn /quan-ly-quy) — hybrid như các màn mới: template rỗng (templates/quan-ly-quy-list.tpl.php) + JS
 * (assets/js/quan_ly_quy.js) gọi API /api/quan-ly-quy (quan_ly_tai_chinh.api.inc).
 *
 * Dữ liệu:
 * - qltc_quy: quỹ. so_du_hien_tai chỉ là bản lưu tạm, luôn tính lại từ sổ cái (quan_ly_tai_chinh_rebuild_quy_balance()).
 * - qltc_so_cai_quy: sổ cái — NGUỒN DUY NHẤT tính số dư. Phiếu thu/chi đã duyệt (Thu chi, công nợ, lương, ĐNTT…) và giao dịch
 *   nội bộ của module này (chuyển quỹ, điều chỉnh số dư) đều đồng bộ vào đây.
 * - qltc_giao_dich: giao dịch nội bộ của module (chuyen_quy, dieu_chinh) + bản sao cũ của phiếu thu chi (ref_type phieu_thu_chi,
 *   bỏ qua khi tính sổ cái).
 *
 * Các hàm lõi do module khác gọi giữ nguyên tên: quan_ly_tai_chinh_quy_get_all(), _quy_load(), _quy_options(),
 * _rebuild_quy_balance(), _sync_phieu_thu_chi_to_so_cai(), _sync_all_phieu_thu_chi_to_so_cai(), _parse_date().
 */

/**
 * Implements hook_menu().
 */
function quan_ly_tai_chinh_menu() {
  $api = array(
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
    'file' => 'quan_ly_tai_chinh.api.inc',
  );
  $items['api/quan-ly-quy'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_collection') + $api;
  $items['api/quan-ly-quy/tuy-chon'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_options') + $api;
  $items['api/quan-ly-quy/chuyen-tien'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_transfer') + $api;
  $items['api/quan-ly-quy/giao-dich/%/huy'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_cancel', 'page arguments' => array(3)) + $api;
  $items['api/quan-ly-quy/%'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_item', 'page arguments' => array(2)) + $api;
  $items['api/quan-ly-quy/%/so-quy'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_ledger', 'page arguments' => array(2)) + $api;
  $items['api/quan-ly-quy/%/so-du'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_balance_at', 'page arguments' => array(2)) + $api;
  $items['api/quan-ly-quy/%/dieu-chinh'] = array('page callback' => 'quan_ly_tai_chinh_quy_rest_adjust', 'page arguments' => array(2)) + $api;

  $items['quan-ly-quy'] = array(
    'title' => 'Quản lý quỹ',
    'page callback' => 'quan_ly_tai_chinh_quy_page',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );
  // Trang tổng quan cũ: chuyển về màn quỹ.
  $items['quan-ly-tai-chinh'] = array(
    'title' => 'Quản lý tài chính',
    'page callback' => 'drupal_goto',
    'page arguments' => array('quan-ly-quy'),
    'access callback' => 'user_is_logged_in',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Implements hook_permission().
 */
function quan_ly_tai_chinh_permission() {
  return array(
    'quan_ly_tai_chinh_view' => array(
      'title' => t('Xem quỹ'),
      'description' => t('Xem danh sách quỹ, số dư, sổ quỹ. Không thêm/sửa/xoá/chuyển tiền được.'),
      'entry' => array('/quan-ly-quy', 'GET /api/quan-ly-quy', 'GET /api/quan-ly-quy/{id}/so-quy'),
    ),
    // Giữ nguyên tên quyền cũ để không mất quyền đang cấp; nghĩa là "quản lý" (bao gồm xem).
    'quan ly tai chinh' => array(
      'title' => t('Quản lý quỹ (thêm/sửa/xoá/chuyển tiền/điều chỉnh)'),
      'description' => t('Bao gồm cả quyền xem quỹ.'),
      'entry' => array('POST/PUT/DELETE /api/quan-ly-quy', 'POST /api/quan-ly-quy/chuyen-tien', 'POST /api/quan-ly-quy/{id}/dieu-chinh', 'POST /api/quan-ly-quy/giao-dich/{id}/huy'),
    ),
  );
}

/** Xem quỹ: quyền xem hoặc quyền quản lý (quản lý bao gồm xem). */
function quan_ly_tai_chinh_view_access() {
  return api_has_permission('quan_ly_tai_chinh_view') || api_has_permission('quan ly tai chinh');
}

/** Thêm/sửa/xoá quỹ, chuyển tiền, điều chỉnh, huỷ giao dịch nội bộ. */
function quan_ly_tai_chinh_manage_access() {
  return api_has_permission('quan ly tai chinh');
}

/**
 * Implements hook_theme().
 */
function quan_ly_tai_chinh_theme() {
  return array(
    'quan_ly_tai_chinh_quy_list_page' => array(
      'template' => 'quan-ly-quy-list',
      'path' => drupal_get_path('module', 'quan_ly_tai_chinh') . '/templates',
      'variables' => array(),
    ),
  );
}

/**
 * Màn /quan-ly-quy: chỉ trả layout, dữ liệu do JS lấy qua API. CSS/JS nạp kèm version theo thời điểm sửa file.
 */
function quan_ly_tai_chinh_quy_page() {
  if (!quan_ly_tai_chinh_view_access()) {
    return api_denied_page('Bạn không có quyền xem quỹ');
  }
  $path = drupal_get_path('module', 'quan_ly_tai_chinh');
  foreach (array('css' => 'assets/css/quan_ly_quy.css', 'js' => 'assets/js/quan_ly_quy.js') as $type => $file) {
    $full = $path . '/' . $file;
    $version = file_exists($full) ? filemtime($full) . '-' . filesize($full) : REQUEST_TIME;
    if ($type === 'css') {
      drupal_add_css($full, array('type' => 'file', 'group' => CSS_THEME, 'preprocess' => FALSE, 'version' => $version));
    }
    else {
      drupal_add_js($full, array('type' => 'file', 'group' => JS_THEME, 'weight' => 5, 'preprocess' => FALSE, 'version' => $version));
    }
  }
  drupal_add_js(array('quan_ly_quy' => array('permissions' => array('view' => TRUE, 'manage' => quan_ly_tai_chinh_manage_access()))), 'setting');
  return theme('quan_ly_tai_chinh_quy_list_page');
}

/* ---------------------------------------------------------------------------
 * Nghiệp vụ quỹ (một nguồn cho API)
 * ------------------------------------------------------------------------- */

/**
 * Lý do không xoá được quỹ ('' = xoá được): còn số dư, hoặc còn phiếu thu chi chưa xử lý xong dùng quỹ này.
 */
function quan_ly_tai_chinh_quy_delete_blocker($quy) {
  $so_du = quan_ly_tai_chinh_quy_balance(intval($quy->nid_quy));
  if (abs($so_du) >= 1) {
    return 'Quỹ còn số dư ' . quan_ly_tai_chinh_format_money($so_du) . ' đ. Chuyển hết sang quỹ khác (hoặc điều chỉnh về 0) rồi mới xoá.';
  }
  if (db_table_exists('qltc_phieu_thu_chi')) {
    $pending = (int) db_query("SELECT COUNT(*) FROM {qltc_phieu_thu_chi} WHERE hoat_dong = 1 AND (nid_quy = :q OR nid_quy_nhan = :q)
      AND duyet_status NOT IN ('da_duyet', 'khong_duyet')", array(':q' => intval($quy->nid_quy)))->fetchField();
    if ($pending > 0) {
      return 'Còn ' . $pending . ' phiếu thu chi chưa duyệt xong dùng quỹ này. Xử lý xong ở màn Thu chi rồi mới xoá.';
    }
  }
  return '';
}

/**
 * Thao tác hợp lệ trên 1 quỹ — MỘT NGUỒN cho giao diện (JS chỉ hiện `hanh_dong`) và API (kiểm tra lại bằng hàm này).
 * Mỗi mục: action, label, (ly_do nếu bị chặn). $with_blockers = FALSE: bỏ qua kiểm tra xoá (danh sách, đỡ truy vấn).
 */
function quan_ly_tai_chinh_quy_actions($quy, $with_blockers = TRUE) {
  if (!quan_ly_tai_chinh_manage_access() || intval($quy->hoat_dong) !== 1) {
    return array();
  }
  $actions = array(
    array('action' => 'sua', 'label' => 'Sửa thông tin'),
    array('action' => 'dieu_chinh', 'label' => 'Điều chỉnh số dư'),
  );
  $xoa = array('action' => 'xoa', 'label' => 'Xoá quỹ');
  if ($with_blockers && ($reason = quan_ly_tai_chinh_quy_delete_blocker($quy))) {
    $xoa['ly_do'] = $reason;
  }
  $actions[] = $xoa;
  return $actions;
}

/**
 * Mã giao dịch nội bộ dạng PREFIX-yymmdd-NNNN (NNNN tăng theo ngày tạo, giao dịch đã huỷ vẫn giữ số).
 */
function quan_ly_tai_chinh_next_code($prefix) {
  $base = $prefix . '-' . date('ymd', REQUEST_TIME) . '-';
  $last = db_query("SELECT ma_giao_dich FROM {qltc_giao_dich} WHERE ma_giao_dich LIKE :p ORDER BY ma_giao_dich DESC", array(':p' => db_like($base) . '%'))->fetchField();
  $n = $last ? intval(substr($last, strlen($base))) + 1 : 1;
  return $base . str_pad($n, 4, '0', STR_PAD_LEFT);
}

/**
 * Chuyển tiền nội bộ. Chặn khi quỹ chuyển không đủ số dư. Trả array('gd_id' => …) hoặc chuỗi lỗi.
 */
function quan_ly_tai_chinh_transfer_create($nid_quy, $nid_quy_nhan, $so_tien, $ngay_text, $dien_giai) {
  $nid_quy = intval($nid_quy);
  $nid_quy_nhan = intval($nid_quy_nhan);
  $so_tien = round(quan_ly_tai_chinh_money_to_number($so_tien));
  $quy = $nid_quy ? quan_ly_tai_chinh_quy_load($nid_quy) : NULL;
  $quy_nhan = $nid_quy_nhan ? quan_ly_tai_chinh_quy_load($nid_quy_nhan) : NULL;
  if (!$quy || intval($quy->hoat_dong) !== 1 || !$quy_nhan || intval($quy_nhan->hoat_dong) !== 1) {
    return 'Quỹ chuyển hoặc quỹ nhận không hợp lệ.';
  }
  if ($nid_quy === $nid_quy_nhan) {
    return 'Quỹ nhận phải khác quỹ chuyển.';
  }
  if ($so_tien <= 0) {
    return 'Số tiền phải lớn hơn 0.';
  }
  if (!preg_match('/^\d{1,2}\/\d{1,2}\/\d{4}$/', trim((string) $ngay_text))) {
    return 'Ngày chuyển không hợp lệ (dd/mm/yyyy).';
  }
  $ngay = quan_ly_tai_chinh_parse_date($ngay_text, TRUE);
  if ($ngay > REQUEST_TIME) {
    return 'Ngày chuyển không được sau hôm nay.';
  }
  $so_du = quan_ly_tai_chinh_quy_balance($nid_quy);
  if ($so_du < $so_tien) {
    return 'Quỹ "' . $quy->ten_quy . '" không đủ tiền: số dư ' . quan_ly_tai_chinh_format_money($so_du) . ' đ, cần chuyển ' . quan_ly_tai_chinh_format_money($so_tien) . ' đ.';
  }
  $txn = db_transaction();
  try {
    $gd_id = db_insert('qltc_giao_dich')->fields(array(
      'ma_giao_dich' => quan_ly_tai_chinh_next_code('CQ'),
      'loai_giao_dich' => 'chuyen_quy',
      'nhom_giao_dich' => 'noi_bo',
      'nid_quy' => $nid_quy,
      'nid_quy_nhan' => $nid_quy_nhan,
      'so_tien' => $so_tien,
      'ngay_giao_dich' => $ngay,
      'thang_luong' => date('Ym', $ngay),
      'dien_giai' => trim((string) $dien_giai),
      'uid' => intval($GLOBALS['user']->uid),
      'status' => 1,
      'created' => REQUEST_TIME,
      'changed' => REQUEST_TIME,
    ))->execute();
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai(intval($gd_id));
    quan_ly_tai_chinh_rebuild_quy_balance($nid_quy, FALSE);
    quan_ly_tai_chinh_rebuild_quy_balance($nid_quy_nhan, FALSE);
  }
  catch (Exception $e) {
    $txn->rollback();
    watchdog('quan_ly_tai_chinh', 'Lỗi chuyển tiền nội bộ: %err', array('%err' => $e->getMessage()), WATCHDOG_ERROR);
    return 'Không lưu được giao dịch chuyển tiền.';
  }
  return array('gd_id' => intval($gd_id));
}

/**
 * Điều chỉnh số dư (kiểm quỹ): nhập số dư THỰC TẾ tại cuối ngày điều chỉnh, ghi 1 dòng "Điều chỉnh" vào sổ quỹ đúng bằng chênh lệch
 * so với số dư theo sổ tại ngày đó. Không sửa số dư đầu kỳ (gốc) của quỹ nên các kỳ trước không đổi. Trả array(gd_id, chenh_lech)
 * hoặc chuỗi lỗi.
 */
function quan_ly_tai_chinh_adjust_create($nid_quy, $so_du_thuc_te, $ngay_text, $ly_do) {
  $quy = quan_ly_tai_chinh_quy_load(intval($nid_quy));
  if (!$quy || intval($quy->hoat_dong) !== 1) {
    return 'Không tìm thấy quỹ cần điều chỉnh.';
  }
  $ly_do = trim((string) $ly_do);
  if ($ly_do === '') {
    return 'Vui lòng nhập lý do điều chỉnh.';
  }
  if (!preg_match('/^\d{1,2}\/\d{1,2}\/\d{4}$/', trim((string) $ngay_text))) {
    return 'Ngày điều chỉnh không hợp lệ (dd/mm/yyyy).';
  }
  $cuoi_ngay = quan_ly_tai_chinh_parse_date($ngay_text, FALSE);
  if (quan_ly_tai_chinh_parse_date($ngay_text, TRUE) > REQUEST_TIME) {
    return 'Ngày điều chỉnh không được sau hôm nay.';
  }
  $thuc_te = round(quan_ly_tai_chinh_money_to_number($so_du_thuc_te));
  $theo_so = round(quan_ly_tai_chinh_quy_balance(intval($quy->nid_quy), $cuoi_ngay));
  $chenh_lech = $thuc_te - $theo_so;
  if ($chenh_lech == 0) {
    return 'Số dư thực tế bằng số dư theo sổ (' . quan_ly_tai_chinh_format_money($theo_so) . ' đ), không cần điều chỉnh.';
  }
  $txn = db_transaction();
  try {
    $gd_id = db_insert('qltc_giao_dich')->fields(array(
      'ma_giao_dich' => quan_ly_tai_chinh_next_code('DC'),
      'loai_giao_dich' => 'dieu_chinh',
      'nhom_giao_dich' => 'noi_bo',
      'nid_quy' => intval($quy->nid_quy),
      'nid_quy_nhan' => 0,
      'so_tien' => $chenh_lech,
      // Cuối ngày: đứng sau mọi phát sinh trong ngày ⇒ số dư sau dòng này đúng bằng số thực tế.
      'ngay_giao_dich' => $cuoi_ngay,
      'thang_luong' => date('Ym', $cuoi_ngay),
      'dien_giai' => $ly_do . ' (theo sổ ' . quan_ly_tai_chinh_format_money($theo_so) . ' đ, thực tế ' . quan_ly_tai_chinh_format_money($thuc_te) . ' đ)',
      'uid' => intval($GLOBALS['user']->uid),
      'status' => 1,
      'created' => REQUEST_TIME,
      'changed' => REQUEST_TIME,
    ))->execute();
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai(intval($gd_id));
    quan_ly_tai_chinh_rebuild_quy_balance(intval($quy->nid_quy), FALSE);
  }
  catch (Exception $e) {
    $txn->rollback();
    watchdog('quan_ly_tai_chinh', 'Lỗi điều chỉnh số dư quỹ: %err', array('%err' => $e->getMessage()), WATCHDOG_ERROR);
    return 'Không lưu được điều chỉnh số dư.';
  }
  return array('gd_id' => intval($gd_id), 'chenh_lech' => $chenh_lech, 'theo_so' => $theo_so);
}

/**
 * Lý do không huỷ được giao dịch nội bộ ('' = huỷ được). Chỉ chuyển quỹ / điều chỉnh còn hiệu lực. Huỷ không được làm quỹ âm:
 * huỷ chuyển tiền trừ lại quỹ nhận, huỷ điều chỉnh tăng trừ lại quỹ đó.
 */
function quan_ly_tai_chinh_giao_dich_cancel_blocker($gd) {
  if (!$gd || intval($gd->status) !== 1 || !in_array($gd->loai_giao_dich, array('chuyen_quy', 'dieu_chinh'), TRUE) || $gd->ref_type === 'phieu_thu_chi') {
    return 'Giao dịch không tồn tại hoặc đã huỷ.';
  }
  $so_tien = quan_ly_tai_chinh_money_to_number($gd->so_tien);
  if ($gd->loai_giao_dich === 'chuyen_quy') {
    $nhan = quan_ly_tai_chinh_quy_load(intval($gd->nid_quy_nhan));
    $so_du = quan_ly_tai_chinh_quy_balance(intval($gd->nid_quy_nhan));
    if ($so_du < $so_tien) {
      return 'Quỹ nhận "' . ($nhan ? $nhan->ten_quy : '#' . intval($gd->nid_quy_nhan)) . '" chỉ còn ' . quan_ly_tai_chinh_format_money($so_du) . ' đ, không đủ để hoàn lại ' . quan_ly_tai_chinh_format_money($so_tien) . ' đ.';
    }
  }
  elseif ($so_tien > 0) {
    $so_du = quan_ly_tai_chinh_quy_balance(intval($gd->nid_quy));
    if ($so_du < $so_tien) {
      return 'Quỹ chỉ còn ' . quan_ly_tai_chinh_format_money($so_du) . ' đ, huỷ điều chỉnh tăng ' . quan_ly_tai_chinh_format_money($so_tien) . ' đ sẽ làm quỹ âm.';
    }
  }
  return '';
}

/**
 * Huỷ giao dịch nội bộ (chuyển quỹ / điều chỉnh): gỡ khỏi sổ quỹ (status = 0), ghi lý do + người huỷ vào diễn giải, tính lại số dư.
 * Trả NULL nếu thành công, không thì chuỗi lỗi.
 */
function quan_ly_tai_chinh_giao_dich_cancel($gd_id, $ly_do) {
  $gd = quan_ly_tai_chinh_giao_dich_load(intval($gd_id));
  if ($reason = quan_ly_tai_chinh_giao_dich_cancel_blocker($gd)) {
    return $reason;
  }
  $ly_do = trim((string) $ly_do);
  if ($ly_do === '') {
    return 'Vui lòng nhập lý do huỷ.';
  }
  $note = trim((string) $gd->dien_giai);
  $note .= ($note !== '' ? "\n" : '') . '[Đã huỷ ' . date('d/m/Y H:i', REQUEST_TIME) . ' bởi ' . quan_ly_tai_chinh_user_display_name($GLOBALS['user']->uid) . ': ' . $ly_do . ']';
  $txn = db_transaction();
  try {
    db_update('qltc_giao_dich')->fields(array('status' => 0, 'dien_giai' => $note, 'changed' => REQUEST_TIME))->condition('gd_id', intval($gd->gd_id))->execute();
    quan_ly_tai_chinh_void_so_cai_source('qltc_giao_dich', intval($gd->gd_id));
    foreach (array_unique(array_filter(array(intval($gd->nid_quy), intval($gd->nid_quy_nhan)))) as $qid) {
      quan_ly_tai_chinh_rebuild_quy_balance($qid, FALSE);
    }
  }
  catch (Exception $e) {
    $txn->rollback();
    watchdog('quan_ly_tai_chinh', 'Lỗi huỷ giao dịch quỹ #@id: %err', array('@id' => intval($gd_id), '%err' => $e->getMessage()), WATCHDOG_ERROR);
    return 'Không huỷ được giao dịch.';
  }
  return NULL;
}

/* ---------------------------------------------------------------------------
 * Lõi dữ liệu quỹ / sổ cái (module khác gọi — giữ tên)
 * ------------------------------------------------------------------------- */

function quan_ly_tai_chinh_ensure_quy_table() {
  if (!function_exists('db_table_exists')) {
    return FALSE;
  }
  if (!db_table_exists('qltc_quy')) {
    $schema = drupal_get_schema('qltc_quy');
    if ($schema) {
      db_create_table('qltc_quy', $schema);
      return TRUE;
    }
    return FALSE;
  }
  if (!db_field_exists('qltc_quy', 'uid_nguoi_quan_ly')) {
    db_add_field('qltc_quy', 'uid_nguoi_quan_ly', array(
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  if (!db_index_exists('qltc_quy', 'uid_nguoi_quan_ly')) {
    db_add_index('qltc_quy', 'uid_nguoi_quan_ly', array('uid_nguoi_quan_ly'));
  }
  return TRUE;
}

/**
 * Tìm node quỹ theo mã quỹ đang lưu trong title.
 */
function quan_ly_tai_chinh_quy_find_nid_by_ma($ma_quy, $exclude_nid = 0) {
  quan_ly_tai_chinh_ensure_quy_table();
  $query = db_select('qltc_quy', 'q')
    ->fields('q', array('nid'))
    ->condition('ma_quy', trim($ma_quy));

  if ($exclude_nid) {
    $query->condition('nid', intval($exclude_nid), '<>');
  }

  return intval($query->range(0, 1)->execute()->fetchField());
}

/**
 * Encode JSON có hỗ trợ tiếng Việt.
 */
function quan_ly_tai_chinh_json_encode(array $data) {
  $options = defined('JSON_UNESCAPED_UNICODE') ? JSON_UNESCAPED_UNICODE : 0;
  return json_encode($data, $options);
}

/**
 * JSON thông tin thêm của quỹ (lịch sử người quản lý, lịch sử điều chỉnh số dư đầu kỳ kiểu cũ).
 */
function quan_ly_tai_chinh_quy_node_get_json_data($quy) {
  $raw = is_object($quy) && isset($quy->thong_tin_json) ? (string) $quy->thong_tin_json : '';
  $data = $raw !== '' ? json_decode($raw, TRUE) : array();
  return is_array($data) ? $data : array();
}

/**
 * Dòng bảng qltc_quy → object quỹ (giữ tên thuộc tính cũ: nid_quy, field_hoat_dong… cho các module đang gọi).
 */
function quan_ly_tai_chinh_quy_node_to_object($row) {
  $json = quan_ly_tai_chinh_quy_node_get_json_data($row);
  $quy = new stdClass();
  $quy->nid_quy = intval($row->nid);
  $quy->nid = intval($row->nid);
  $quy->ma_quy = isset($row->ma_quy) ? (string) $row->ma_quy : '';
  $quy->ten_quy = isset($row->ten_quy) && $row->ten_quy !== '' ? (string) $row->ten_quy : (isset($json['ten_quy']) ? (string) $json['ten_quy'] : '');
  $quy->loai_quy = isset($row->loai_quy) && $row->loai_quy !== '' ? (string) $row->loai_quy : (isset($json['loai_quy']) ? (string) $json['loai_quy'] : 'tien_mat');
  $quy->ghi_chu = isset($row->ghi_chu) && $row->ghi_chu !== NULL ? (string) $row->ghi_chu : (isset($json['ghi_chu']) ? (string) $json['ghi_chu'] : '');
  $quy->so_du_dau_ky = quan_ly_tai_chinh_money_to_number(isset($row->so_du_dau_ky) ? $row->so_du_dau_ky : 0);
  $quy->so_du_hien_tai = quan_ly_tai_chinh_money_to_number(isset($row->so_du_hien_tai) ? $row->so_du_hien_tai : 0);
  $quy->uid_nguoi_quan_ly = isset($row->uid_nguoi_quan_ly) ? intval($row->uid_nguoi_quan_ly) : 0;
  $quy->field_hoat_dong = isset($row->hoat_dong) ? intval($row->hoat_dong) : 1;
  $quy->hoat_dong = $quy->field_hoat_dong;
  $quy->status = isset($row->status) ? intval($row->status) : 0;
  $quy->uid = isset($row->uid) ? intval($row->uid) : 0;
  $quy->created = isset($row->created) ? intval($row->created) : 0;
  $quy->changed = isset($row->changed) ? intval($row->changed) : 0;
  $quy->thong_tin_json = isset($row->thong_tin_json) ? (string) $row->thong_tin_json : '';
  return $quy;
}

/**
 * Sắp xếp lịch sử điều chỉnh mới nhất lên đầu.
 */
function quan_ly_tai_chinh_quy_history_sort_desc($a, $b) {
  $time_a = quan_ly_tai_chinh_quy_history_time($a);
  $time_b = quan_ly_tai_chinh_quy_history_time($b);
  if ($time_a == $time_b) {
    return 0;
  }
  return $time_a > $time_b ? -1 : 1;
}

/**
 * Lấy mốc thời gian từ một item lịch sử quỹ.
 */
function quan_ly_tai_chinh_quy_history_time($item) {
  if (!empty($item['time'])) {
    return intval($item['time']);
  }
  if (!empty($item['thoi_gian'])) {
    return intval($item['thoi_gian']);
  }
  if (!empty($item['ngay_dieu_chinh'])) {
    return intval($item['ngay_dieu_chinh']);
  }
  return 0;
}

/**
 * Tên hiển thị của tài khoản: {users}.ten (nhân viên) nếu có, không thì tên đăng nhập. 0 = "Hệ thống".
 */
function quan_ly_tai_chinh_user_display_name($uid) {
  $names = &drupal_static(__FUNCTION__, array());
  $uid = intval($uid);
  if ($uid <= 0) {
    return 'Hệ thống';
  }
  if (!isset($names[$uid])) {
    $sql = db_field_exists('users', 'ten') ? "SELECT name, ten FROM {users} WHERE uid = :u" : "SELECT name, '' AS ten FROM {users} WHERE uid = :u";
    $r = db_query($sql, array(':u' => $uid))->fetchObject();
    $names[$uid] = $r ? (trim((string) $r->ten) !== '' ? trim((string) $r->ten) : (string) $r->name) : ('User #' . $uid);
  }
  return $names[$uid];
}

/**
 * Lấy danh sách quỹ.
 */
function quan_ly_tai_chinh_quy_get_all($active_only = TRUE) {
  quan_ly_tai_chinh_ensure_quy_table();

  $query = db_select('qltc_quy', 'q')->fields('q');
  if ($active_only) {
    $query->condition('hoat_dong', 1);
  }
  $items = array();
  foreach ($query->execute() as $row) {
    $items[] = quan_ly_tai_chinh_quy_node_to_object($row);
  }

  usort($items, 'quan_ly_tai_chinh_quy_sort_by_name');
  return $items;
}

function quan_ly_tai_chinh_quy_sort_by_name($a, $b) {
  return strnatcasecmp($a->ten_quy, $b->ten_quy);
}

function quan_ly_tai_chinh_quy_load($nid_quy) {
  quan_ly_tai_chinh_ensure_quy_table();
  $row = db_select('qltc_quy', 'q')->fields('q')->condition('nid', intval($nid_quy))->execute()->fetchObject();
  if (!$row) {
    return FALSE;
  }
  return quan_ly_tai_chinh_quy_node_to_object($row);
}

function quan_ly_tai_chinh_giao_dich_load($gd_id) {
  return db_select('qltc_giao_dich', 'gd')->fields('gd')->condition('gd_id', intval($gd_id))->execute()->fetchObject();
}

function quan_ly_tai_chinh_quy_options($active_only = TRUE) {
  $options = array();
  foreach (quan_ly_tai_chinh_quy_get_all($active_only) as $quy) {
    $options[$quy->nid_quy] = $quy->ten_quy . ($quy->ma_quy ? ' (' . $quy->ma_quy . ')' : '');
  }
  return $options;
}

/**
 * Kiểm tra hệ thống có content type phiếu thu chi hay chưa.
 */
function quan_ly_tai_chinh_has_phieu_thu_chi_content_type() {
  return function_exists('db_table_exists') && db_table_exists('qltc_phieu_thu_chi');
}

/**
 * Schema bảng sổ cái quỹ dùng được cả trong hook_schema() và runtime fallback.
 */
function quan_ly_tai_chinh_so_cai_quy_schema_definition() {
  return array(
    'description' => 'Sổ cái biến động quỹ. Đây là nguồn dữ liệu chính để tính số dư quỹ theo thời gian.',
    'fields' => array(
      'id' => array('type' => 'serial', 'not null' => TRUE),
      'nid_quy' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'source_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'source_id' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'source_line' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'nid_phieu' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'ma_chung_tu' => array('type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''),
      'loai_bien_dong' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'ngay_giao_dich' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'thoi_gian_phat_sinh' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'so_tien' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'bien_dong' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'so_du_truoc' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'so_du_sau' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'doi_tuong_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'doi_tuong_id' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'uid_thuc_hien' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'ghi_chu' => array('type' => 'text', 'not null' => FALSE),
      'data_json' => array('type' => 'text', 'not null' => FALSE),
      'status' => array('type' => 'int', 'not null' => TRUE, 'default' => 1),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'changed' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('id'),
    'indexes' => array(
      'nid_quy' => array('nid_quy'),
      'source' => array('source_type', 'source_id'),
      'source_line' => array('source_type', 'source_id', 'source_line'),
      'nid_phieu' => array('nid_phieu'),
      'ngay_giao_dich' => array('ngay_giao_dich'),
      'status' => array('status'),
      'quy_ngay_status' => array('nid_quy', 'ngay_giao_dich', 'status'),
    ),
  );
}

/**
 * Đảm bảo bảng qltc_so_cai_quy tồn tại và có đủ cột/index cần thiết.
 */
function quan_ly_tai_chinh_ensure_so_cai_quy_table() {
  if (!function_exists('db_table_exists')) {
    return FALSE;
  }

  if (!db_table_exists('qltc_so_cai_quy')) {
    db_create_table('qltc_so_cai_quy', quan_ly_tai_chinh_so_cai_quy_schema_definition());
    return TRUE;
  }

  $schema = quan_ly_tai_chinh_so_cai_quy_schema_definition();
  foreach ($schema['fields'] as $field => $definition) {
    if (!db_field_exists('qltc_so_cai_quy', $field)) {
      db_add_field('qltc_so_cai_quy', $field, $definition);
    }
  }
  foreach ($schema['indexes'] as $name => $fields) {
    if (!db_index_exists('qltc_so_cai_quy', $name)) {
      db_add_index('qltc_so_cai_quy', $name, $fields);
    }
  }

  return TRUE;
}

/**
 * Chuyển một giá trị thành JSON an toàn.
 */
function quan_ly_tai_chinh_json_encode_safe($data) {
  if (function_exists('quan_ly_tai_chinh_json_encode')) {
    return quan_ly_tai_chinh_json_encode($data);
  }
  return json_encode($data);
}

/**
 * Xóa hiệu lực các dòng sổ cái cũ theo nguồn phát sinh.
 */
function quan_ly_tai_chinh_void_so_cai_source($source_type, $source_id) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $source_type = trim((string) $source_type);
  $source_id = intval($source_id);
  if ($source_type === '' || !$source_id || !db_table_exists('qltc_so_cai_quy')) {
    return 0;
  }

  return db_update('qltc_so_cai_quy')
    ->fields(array('status' => 0, 'changed' => REQUEST_TIME))
    ->condition('source_type', $source_type)
    ->condition('source_id', $source_id)
    ->execute();
}

/**
 * Ghi một dòng sổ cái quỹ.
 *
 * Mỗi dòng là một biến động độc lập: thu dương, chi âm. Số dư trước/sau sẽ
 * được rebuild theo thứ tự ngày sau khi ghi, không lấy JSON làm nguồn tính.
 */
function quan_ly_tai_chinh_insert_so_cai_quy(array $values) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (!db_table_exists('qltc_so_cai_quy')) {
    return FALSE;
  }

  $now = REQUEST_TIME;
  $fields = array(
    'nid_quy' => intval(isset($values['nid_quy']) ? $values['nid_quy'] : 0),
    'source_type' => trim((string) (isset($values['source_type']) ? $values['source_type'] : '')),
    'source_id' => intval(isset($values['source_id']) ? $values['source_id'] : 0),
    'source_line' => trim((string) (isset($values['source_line']) ? $values['source_line'] : '')),
    'nid_phieu' => intval(isset($values['nid_phieu']) ? $values['nid_phieu'] : 0),
    'ma_chung_tu' => trim((string) (isset($values['ma_chung_tu']) ? $values['ma_chung_tu'] : '')),
    'loai_bien_dong' => trim((string) (isset($values['loai_bien_dong']) ? $values['loai_bien_dong'] : '')),
    'ngay_giao_dich' => intval(isset($values['ngay_giao_dich']) ? $values['ngay_giao_dich'] : $now),
    'thoi_gian_phat_sinh' => intval(isset($values['thoi_gian_phat_sinh']) ? $values['thoi_gian_phat_sinh'] : $now),
    'so_tien' => quan_ly_tai_chinh_money_to_number(isset($values['so_tien']) ? $values['so_tien'] : 0),
    'bien_dong' => quan_ly_tai_chinh_money_to_number(isset($values['bien_dong']) ? $values['bien_dong'] : 0),
    'so_du_truoc' => 0,
    'so_du_sau' => 0,
    'doi_tuong_type' => trim((string) (isset($values['doi_tuong_type']) ? $values['doi_tuong_type'] : '')),
    'doi_tuong_id' => intval(isset($values['doi_tuong_id']) ? $values['doi_tuong_id'] : 0),
    'uid_thuc_hien' => intval(isset($values['uid_thuc_hien']) ? $values['uid_thuc_hien'] : 0),
    'ghi_chu' => isset($values['ghi_chu']) ? (string) $values['ghi_chu'] : '',
    'data_json' => isset($values['data_json']) ? (is_string($values['data_json']) ? $values['data_json'] : quan_ly_tai_chinh_json_encode_safe($values['data_json'])) : '',
    'status' => intval(isset($values['status']) ? $values['status'] : 1),
    'created' => intval(isset($values['created']) ? $values['created'] : $now),
    'changed' => $now,
  );

  if (!$fields['nid_quy'] || $fields['source_type'] === '' || !$fields['source_id'] || abs($fields['bien_dong']) < 0.00001) {
    return FALSE;
  }

  return db_insert('qltc_so_cai_quy')->fields($fields)->execute();
}

/**
 * Trạng thái phiếu thu chi nào còn hiệu lực hạch toán trong sổ cái quỹ.
 * Yêu cầu điều chỉnh chỉ là trạng thái chờ xét duyệt, nên giao dịch cũ vẫn được tính.
 */
function quan_ly_tai_chinh_phieu_status_counts_in_ledger($duyet_status) {
  return in_array(trim((string) $duyet_status), array('da_duyet', 'yeu_cau_dieu_chinh'), TRUE);
}

/**
 * Đồng bộ một phiếu thu/chi sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($nid_phieu, $duyet_status = NULL) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $nid_phieu = intval($nid_phieu);
  if (!$nid_phieu || !db_table_exists('qltc_so_cai_quy')) {
    return FALSE;
  }

  quan_ly_tai_chinh_void_so_cai_source('phieu_thu_chi', $nid_phieu);

  if (!function_exists('thu_chi_giao_dich_load')) {
    return FALSE;
  }

  $phieu = thu_chi_giao_dich_load($nid_phieu, TRUE);
  if (!$phieu) {
    return FALSE;
  }

  $active = intval($phieu->status) === 1;
  $duyet = $duyet_status === NULL ? trim((string) $phieu->duyet_status) : trim((string) $duyet_status);
  if (!$active || !quan_ly_tai_chinh_phieu_status_counts_in_ledger($duyet)) {
    return FALSE;
  }

  $json = !empty($phieu->json) ? $phieu->json : array();
  $loai = $phieu->loai_phieu;
  $amount = quan_ly_tai_chinh_money_to_number($phieu->so_tien);
  $ngay = intval($phieu->ngay_giao_dich);
  $nid_quy = intval($phieu->nid_quy);
  $nid_quy_nhan = intval($phieu->nid_quy_nhan);
  $uid = !empty($json['duyet_uid']) ? intval($json['duyet_uid']) : intval($phieu->uid);
  $time = !empty($json['duyet_time']) ? intval($json['duyet_time']) : REQUEST_TIME;

  $base = array(
    'source_type' => 'phieu_thu_chi',
    'source_id' => $nid_phieu,
    'nid_phieu' => $nid_phieu,
    'ma_chung_tu' => $phieu->ma_giao_dich,
    'ngay_giao_dich' => $ngay,
    'thoi_gian_phat_sinh' => $time,
    'so_tien' => $amount,
    'uid_thuc_hien' => $uid,
    'ghi_chu' => 'Duyệt phiếu thu chi',
    'data_json' => array('loai_phieu' => $loai, 'duyet' => $duyet),
    'status' => 1,
    'created' => intval($phieu->created),
  );

  $inserted = 0;
  if ($loai === 'thu' && $nid_quy) {
    $row = $base + array('nid_quy' => $nid_quy, 'source_line' => 'thu', 'loai_bien_dong' => 'thu', 'bien_dong' => $amount);
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
  }
  elseif ($loai === 'chi' && $nid_quy) {
    $row = $base + array('nid_quy' => $nid_quy, 'source_line' => 'chi', 'loai_bien_dong' => 'chi', 'bien_dong' => -1 * $amount);
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
  }
  elseif ($loai === 'chuyen_quy') {
    if ($nid_quy) {
      $row = $base + array('nid_quy' => $nid_quy, 'source_line' => 'chuyen_di', 'loai_bien_dong' => 'chuyen_di', 'bien_dong' => -1 * $amount);
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
    }
    if ($nid_quy_nhan) {
      $row = $base + array('nid_quy' => $nid_quy_nhan, 'source_line' => 'chuyen_den', 'loai_bien_dong' => 'chuyen_den', 'bien_dong' => $amount);
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
    }
  }

  return $inserted;
}

/**
 * Đồng bộ một dòng qltc_giao_dich cũ sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (is_numeric($gd)) {
    $gd = quan_ly_tai_chinh_giao_dich_load(intval($gd));
  }
  if (!$gd || !is_object($gd) || empty($gd->gd_id)) {
    return FALSE;
  }

  quan_ly_tai_chinh_void_so_cai_source('qltc_giao_dich', intval($gd->gd_id));

  if (intval($gd->status) !== 1) {
    return FALSE;
  }
  if (!empty($gd->ref_type) && $gd->ref_type === 'phieu_thu_chi') {
    return FALSE;
  }

  $amount = quan_ly_tai_chinh_money_to_number(isset($gd->so_tien) ? $gd->so_tien : 0);
  $nid_quy = intval(isset($gd->nid_quy) ? $gd->nid_quy : 0);
  $nid_quy_nhan = intval(isset($gd->nid_quy_nhan) ? $gd->nid_quy_nhan : 0);
  $loai = isset($gd->loai_giao_dich) ? trim((string) $gd->loai_giao_dich) : '';
  $base = array(
    'source_type' => 'qltc_giao_dich',
    'source_id' => intval($gd->gd_id),
    'nid_phieu' => 0,
    'ma_chung_tu' => isset($gd->ma_giao_dich) ? $gd->ma_giao_dich : ('GD' . intval($gd->gd_id)),
    'ngay_giao_dich' => !empty($gd->ngay_giao_dich) ? intval($gd->ngay_giao_dich) : REQUEST_TIME,
    'thoi_gian_phat_sinh' => !empty($gd->changed) ? intval($gd->changed) : REQUEST_TIME,
    'so_tien' => $amount,
    'uid_thuc_hien' => !empty($gd->uid) ? intval($gd->uid) : 0,
    'ghi_chu' => isset($gd->dien_giai) ? $gd->dien_giai : '',
    'data_json' => array('loai_giao_dich' => $loai, 'nhom_giao_dich' => isset($gd->nhom_giao_dich) ? $gd->nhom_giao_dich : ''),
    'status' => 1,
    'created' => !empty($gd->created) ? intval($gd->created) : REQUEST_TIME,
  );

  $inserted = 0;
  if ($loai === 'thu' && $nid_quy) {
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('nid_quy' => $nid_quy, 'source_line' => 'thu', 'loai_bien_dong' => 'thu', 'bien_dong' => $amount)) ? 1 : 0;
  }
  elseif (in_array($loai, array('chi', 'tam_ung_lai_xe'), TRUE) && $nid_quy) {
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('nid_quy' => $nid_quy, 'source_line' => 'chi', 'loai_bien_dong' => 'chi', 'bien_dong' => -1 * $amount)) ? 1 : 0;
  }
  elseif ($loai === 'dieu_chinh' && $nid_quy) {
    // Điều chỉnh số dư (kiểm quỹ): so_tien mang dấu = chênh lệch so với số dư theo sổ tại ngày điều chỉnh.
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy(array_merge($base, array('nid_quy' => $nid_quy, 'source_line' => 'dieu_chinh', 'loai_bien_dong' => 'dieu_chinh', 'so_tien' => abs($amount), 'bien_dong' => $amount))) ? 1 : 0;
  }
  elseif ($loai === 'chuyen_quy') {
    if ($nid_quy) {
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('nid_quy' => $nid_quy, 'source_line' => 'chuyen_di', 'loai_bien_dong' => 'chuyen_di', 'bien_dong' => -1 * $amount)) ? 1 : 0;
    }
    if ($nid_quy_nhan) {
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('nid_quy' => $nid_quy_nhan, 'source_line' => 'chuyen_den', 'loai_bien_dong' => 'chuyen_den', 'bien_dong' => $amount)) ? 1 : 0;
    }
  }

  return $inserted;
}

/**
 * Đồng bộ tất cả phiếu thu chi đã có sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_all_phieu_thu_chi_to_so_cai() {
  if (!db_table_exists('qltc_phieu_thu_chi')) {
    return 0;
  }

  $count = 0;
  $query = db_select('qltc_phieu_thu_chi', 'p')->fields('p', array('nid'))->range(0, 10000);
  foreach ($query->execute() as $row) {
    quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($row->nid);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ các phiếu thu chi liên quan một quỹ sang sổ cái.
 */
function quan_ly_tai_chinh_sync_phieu_thu_chi_by_quy_to_so_cai($nid_quy) {
  $nid_quy = intval($nid_quy);
  if (!$nid_quy || !db_table_exists('qltc_phieu_thu_chi')) {
    return 0;
  }

  $query = db_select('qltc_phieu_thu_chi', 'p');
  $query->fields('p', array('nid'));
  $query->condition(db_or()->condition('p.nid_quy', $nid_quy)->condition('p.nid_quy_nhan', $nid_quy));
  $query->range(0, 10000);
  $count = 0;
  foreach ($query->execute() as $row) {
    quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($row->nid);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ tất cả giao dịch cũ trong qltc_giao_dich sang sổ cái.
 */
function quan_ly_tai_chinh_sync_all_giao_dich_to_so_cai() {
  if (!db_table_exists('qltc_giao_dich')) {
    return 0;
  }
  $count = 0;
  $query = db_select('qltc_giao_dich', 'gd')->fields('gd')->range(0, 10000);
  foreach ($query->execute() as $gd) {
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ các giao dịch cũ liên quan một quỹ sang sổ cái.
 */
function quan_ly_tai_chinh_sync_giao_dich_by_quy_to_so_cai($nid_quy) {
  if (!db_table_exists('qltc_giao_dich')) {
    return 0;
  }
  $nid_quy = intval($nid_quy);
  $count = 0;
  $query = db_select('qltc_giao_dich', 'gd')
    ->fields('gd')
    ->condition(db_or()->condition('nid_quy', $nid_quy)->condition('nid_quy_nhan', $nid_quy))
    ->range(0, 10000);
  foreach ($query->execute() as $gd) {
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd);
    $count++;
  }
  return $count;
}

/**
 * Query các dòng sổ cái của một quỹ.
 */
function quan_ly_tai_chinh_so_cai_quy_rows($nid_quy, $from_time = NULL, $to_time = NULL, $active_only = TRUE, $limit = 0) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $rows = array();
  $nid_quy = intval($nid_quy);
  if (!$nid_quy || !db_table_exists('qltc_so_cai_quy')) {
    return $rows;
  }

  $query = db_select('qltc_so_cai_quy', 'sc')->fields('sc')->condition('nid_quy', $nid_quy);
  if ($active_only) {
    $query->condition('status', 1);
  }
  if ($from_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($from_time), '>=');
  }
  if ($to_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($to_time), '<=');
  }
  $query->orderBy('ngay_giao_dich', 'ASC')->orderBy('id', 'ASC');
  if ($limit > 0) {
    $query->range(0, intval($limit));
  }
  foreach ($query->execute() as $row) {
    $rows[] = $row;
  }
  return $rows;
}

/**
 * Rebuild số dư chạy trên sổ cái của một quỹ.
 */
function quan_ly_tai_chinh_rebuild_so_cai_quy_running_balance($nid_quy) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $quy = quan_ly_tai_chinh_quy_load($nid_quy);
  if (!$quy || !db_table_exists('qltc_so_cai_quy')) {
    return 0;
  }

  $balance = quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky);
  $rows = quan_ly_tai_chinh_so_cai_quy_rows($nid_quy, NULL, NULL, TRUE);
  foreach ($rows as $row) {
    $before = $balance;
    $balance += quan_ly_tai_chinh_money_to_number($row->bien_dong);
    db_update('qltc_so_cai_quy')
      ->fields(array('so_du_truoc' => $before, 'so_du_sau' => $balance, 'changed' => REQUEST_TIME))
      ->condition('id', intval($row->id))
      ->execute();
  }

  return $balance;
}

/**
 * Tính số dư quỹ tại một thời điểm từ sổ cái qltc_so_cai_quy.
 *
 * Số dư hiện tại trong node quy_tai_chinh chỉ là cache. Nguồn tính chính là
 * field_so_du_dau_ky + SUM(bien_dong) của các dòng sổ cái đang active.
 */
function quan_ly_tai_chinh_quy_balance($nid_quy, $to_time = NULL) {
  $quy = quan_ly_tai_chinh_quy_load($nid_quy);
  if (!$quy) {
    return 0;
  }

  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $nid_quy = intval($nid_quy);
  $balance = quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky);

  if (!db_table_exists('qltc_so_cai_quy')) {
    return $balance;
  }

  $query = db_select('qltc_so_cai_quy', 'sc')
    ->condition('nid_quy', $nid_quy)
    ->condition('status', 1);
  $query->addExpression('SUM(bien_dong)', 'total_delta');
  if ($to_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($to_time), '<=');
  }
  $delta = quan_ly_tai_chinh_money_to_number($query->execute()->fetchField());
  return $balance + $delta;
}

/**
 * Tóm tắt quỹ trong kỳ từ sổ cái qltc_so_cai_quy.
 */
function quan_ly_tai_chinh_quy_period_summary($nid_quy, $from_time, $to_time) {
  $nid_quy = intval($nid_quy);
  $dau_ky = quan_ly_tai_chinh_quy_balance($nid_quy, $from_time - 1);
  $summary = array('dau_ky' => $dau_ky, 'thu' => 0, 'chi' => 0, 'chuyen_den' => 0, 'chuyen_di' => 0, 'dieu_chinh' => 0, 'cuoi_ky' => $dau_ky);

  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (db_table_exists('qltc_so_cai_quy')) {
    $rows = db_select('qltc_so_cai_quy', 'sc')
      ->fields('sc', array('loai_bien_dong', 'bien_dong'))
      ->condition('nid_quy', $nid_quy)
      ->condition('status', 1)
      ->condition('ngay_giao_dich', intval($from_time), '>=')
      ->condition('ngay_giao_dich', intval($to_time), '<=')
      ->execute();

    foreach ($rows as $row) {
      $delta = quan_ly_tai_chinh_money_to_number($row->bien_dong);
      if ($row->loai_bien_dong === 'dieu_chinh') {
        $summary['dieu_chinh'] += $delta;
      }
      elseif ($delta >= 0) {
        if ($row->loai_bien_dong === 'chuyen_den') {
          $summary['chuyen_den'] += $delta;
        }
        else {
          $summary['thu'] += $delta;
        }
      }
      else {
        if ($row->loai_bien_dong === 'chuyen_di') {
          $summary['chuyen_di'] += abs($delta);
        }
        else {
          $summary['chi'] += abs($delta);
        }
      }
    }
  }

  $summary['cuoi_ky'] = $summary['dau_ky'] + $summary['thu'] - $summary['chi'] + $summary['chuyen_den'] - $summary['chuyen_di'] + $summary['dieu_chinh'];
  return $summary;
}

function quan_ly_tai_chinh_rebuild_quy_balance($nid_quy, $sync_sources = TRUE) {
  $nid_quy = intval($nid_quy);
  if (!$nid_quy) {
    return;
  }

  $quy = quan_ly_tai_chinh_quy_load($nid_quy);
  if (!$quy) {
    return;
  }

  quan_ly_tai_chinh_ensure_so_cai_quy_table();

  if ($sync_sources) {
    // Đồng bộ lại nguồn phát sinh trước khi tính số dư để khi sửa phiếu quá khứ,
    // toàn bộ số dư sau đó được rebuild theo sổ cái.
    quan_ly_tai_chinh_sync_phieu_thu_chi_by_quy_to_so_cai($nid_quy);
    quan_ly_tai_chinh_sync_giao_dich_by_quy_to_so_cai($nid_quy);
  }

  $current = quan_ly_tai_chinh_rebuild_so_cai_quy_running_balance($nid_quy);
  db_update('qltc_quy')
    ->fields(array('so_du_hien_tai' => $current, 'status' => 0, 'changed' => REQUEST_TIME))
    ->condition('nid', $nid_quy)
    ->execute();
}

/**
 * Helper dữ liệu hiển thị.
 */
function quan_ly_tai_chinh_loai_quy_options() {
  return array('tien_mat' => 'Tiền mặt', 'ngan_hang' => 'Ngân hàng', 'vi_noi_bo' => 'Ví nội bộ');
}

function quan_ly_tai_chinh_loai_quy_label($key) { $o = quan_ly_tai_chinh_loai_quy_options(); return isset($o[$key]) ? $o[$key] : $key; }

function quan_ly_tai_chinh_loai_giao_dich_options() {
  return array(
    'thu' => 'Thu',
    'chi' => 'Chi',
    'chuyen_quy' => 'Chuyển quỹ nội bộ',
    'tam_ung_lai_xe' => 'Tạm ứng lái xe',
    'khau_tru_tam_ung_luong' => 'Khấu trừ tạm ứng lương',
  );
}

/**
 * Helper ngày/tháng.
 */
function quan_ly_tai_chinh_parse_date($value, $start_day = TRUE) {
  $value = trim($value);
  if (preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $value, $m)) {
    return mktime($start_day ? 0 : 23, $start_day ? 0 : 59, $start_day ? 0 : 59, intval($m[2]), intval($m[1]), intval($m[3]));
  }
  $ts = strtotime($value);
  if ($ts) {
    return $start_day ? strtotime(date('Y-m-d 00:00:00', $ts)) : strtotime(date('Y-m-d 23:59:59', $ts));
  }
  return $start_day ? strtotime(date('Y-m-01 00:00:00')) : strtotime(date('Y-m-t 23:59:59'));
}

function quan_ly_tai_chinh_generate_code($prefix) {
  return $prefix . date('ymdHis') . mt_rand(10, 99);
}

function quan_ly_tai_chinh_json_decode($value) {
  $data = json_decode($value, TRUE);
  return is_array($data) ? $data : array();
}

function quan_ly_tai_chinh_money_to_number($value) {
  if (is_numeric($value)) { return floatval($value); }
  $value = trim((string) $value);
  if ($value === '') { return 0; }
  $is_negative = strpos($value, '-') === 0;
  $value = preg_replace('/[^0-9]/', '', $value);
  if ($value === '') { return 0; }
  $number = floatval($value);
  return $is_negative ? -$number : $number;
}

function quan_ly_tai_chinh_format_money($value) {
  return number_format(round(quan_ly_tai_chinh_money_to_number($value)), 0, ',', '.');
}
