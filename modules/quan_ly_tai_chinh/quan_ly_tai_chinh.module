      'success' => FALSE,
      'message' => 'Không tìm thấy quỹ cần điều chỉnh.',
    );
  }

  return array(
    'success' => TRUE,
    'title' => 'Điều chỉnh số dư đầu kỳ',
    'size' => 'modal-lg',
    'html' => quan_ly_tai_chinh_quy_adjust_modal_form_html($quy),
  );
}

/**
 * HTML form điều chỉnh số dư đầu kỳ trong modal.
 */
function quan_ly_tai_chinh_quy_adjust_modal_form_html($quy) {
  return theme('quan_ly_tai_chinh_quy_page', array(
    'render_mode' => 'adjust',
    'quy' => $quy,
    'old_balance' => quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky),
  ));
}

/**
 * AJAX: lưu điều chỉnh số dư đầu kỳ.
 */
function quan_ly_tai_chinh_quy_ajax_adjust_save() {
  global $user;

  quan_ly_tai_chinh_ensure_quy_content_type();

  $quy_id = isset($_POST['quy_id']) ? intval($_POST['quy_id']) : 0;
  $so_du_moi = isset($_POST['so_du_moi']) ? quan_ly_tai_chinh_money_to_number($_POST['so_du_moi']) : 0;
  $ly_do = isset($_POST['ly_do']) ? trim($_POST['ly_do']) : '';
  $ngay_text = isset($_POST['ngay_dieu_chinh']) ? trim($_POST['ngay_dieu_chinh']) : date('d/m/Y');
  $ngay_time = quan_ly_tai_chinh_parse_date($ngay_text, TRUE);

  if (!$quy_id) {
    return array('success' => FALSE, 'message' => 'Thiếu thông tin quỹ cần điều chỉnh.');
  }

  if ($ly_do === '') {
    return array('success' => FALSE, 'message' => 'Vui lòng nhập lý do điều chỉnh số dư.');
  }

  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy) {
    return array('success' => FALSE, 'message' => 'Không tìm thấy quỹ cần điều chỉnh.');
  }
  if (intval($quy->field_hoat_dong) !== 1) {
    return array('success' => FALSE, 'message' => 'Quỹ này đã bị xóa hoặc không còn hoạt động.');
  }

  $so_du_cu = quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky);
  $chenh_lech = $so_du_moi - $so_du_cu;

  if (round($chenh_lech, 2) == 0) {
    return array('success' => FALSE, 'message' => 'Số dư mới không thay đổi so với số dư hiện tại.');
  }

  $json = quan_ly_tai_chinh_quy_node_get_json_data($quy);
  if (empty($json['lich_su_dieu_chinh_so_du']) || !is_array($json['lich_su_dieu_chinh_so_du'])) {
    $json['lich_su_dieu_chinh_so_du'] = array();
  }

  $json['lich_su_dieu_chinh_so_du'][] = array(
    'loai' => 'dieu_chinh_so_du_dau_ky',
    'thoi_gian' => REQUEST_TIME,
    'ngay_dieu_chinh' => $ngay_time,
    'ngay_dieu_chinh_text' => $ngay_text,
    'nguoi_thuc_hien' => isset($user->uid) ? intval($user->uid) : 0,
    'so_du_cu' => $so_du_cu,
    'so_du_moi' => $so_du_moi,
    'chenh_lech' => $chenh_lech,
    'ly_do' => $ly_do,
  );

  db_update('qltc_quy')
    ->fields(array(
      'thong_tin_json' => quan_ly_tai_chinh_json_encode($json),
      'so_du_dau_ky' => $so_du_moi,
      'hoat_dong' => 1,
      'status' => 0,
      'changed' => REQUEST_TIME,
    ))
    ->condition('nid', $quy_id)
    ->execute();

  quan_ly_tai_chinh_rebuild_quy_balance($quy_id);

  return array(
    'success' => TRUE,
    'message' => 'Đã điều chỉnh số dư đầu kỳ của quỹ. Chênh lệch: ' . ($chenh_lech > 0 ? '+' : '') . quan_ly_tai_chinh_format_money($chenh_lech),
    'quy_id' => $quy_id,
  );
}

/**
 * AJAX: xóa mềm quỹ.
 */
function quan_ly_tai_chinh_quy_ajax_delete($quy_id) {
  $quy_id = intval($quy_id);
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy) {
    return array('success' => FALSE, 'message' => 'Không tìm thấy quỹ cần xóa.');
  }

  db_update('qltc_quy')
    ->fields(array('hoat_dong' => 0, 'status' => 0, 'changed' => REQUEST_TIME))
    ->condition('nid', $quy_id)
    ->execute();

  return array(
    'success' => TRUE,
    'message' => 'Đã xóa quỹ ' . $quy->ten_quy . '.',
  );
}

/**
 * Danh sách thu chi.
 */
function quan_ly_tai_chinh_thu_chi_page() {
  quan_ly_tai_chinh_add_assets();

  $filters = quan_ly_tai_chinh_get_date_filters();
  $query = db_select('qltc_giao_dich', 'gd')
    ->fields('gd')
    ->condition('status', 1)
    ->condition('ngay_giao_dich', $filters['from_time'], '>=')
    ->condition('ngay_giao_dich', $filters['to_time'], '<=')
    ->orderBy('ngay_giao_dich', 'DESC')
    ->orderBy('gd_id', 'DESC')
    ->extend('PagerDefault')
    ->limit(50);

  if (!empty($_GET['loai_giao_dich'])) {
    $query->condition('loai_giao_dich', $_GET['loai_giao_dich']);
  }
  if (!empty($_GET['nhom_giao_dich'])) {
    $query->condition('nhom_giao_dich', $_GET['nhom_giao_dich']);
  }

  $items = $query->execute()->fetchAll();
  $quy_map = quan_ly_tai_chinh_quy_options(FALSE);

  $header = array(
    array('data' => 'Ngày', 'class' => array('text-center')),
    'Mã GD',
    'Loại',
    'Nhóm',
    'Quỹ',
    'Đối tượng',
    array('data' => 'Số tiền', 'class' => array('text-end')),
    'Diễn giải',
    array('data' => 'Thao tác', 'class' => array('text-center')),
  );

  $rows = array();
  foreach ($items as $item) {
    $quy_text = isset($quy_map[$item->quy_id]) ? $quy_map[$item->quy_id] : '';
    if ($item->loai_giao_dich === 'chuyen_quy') {
      $quy_nhan = isset($quy_map[$item->quy_nhan_id]) ? $quy_map[$item->quy_nhan_id] : '';
      $quy_text .= ' → ' . $quy_nhan;
    }

    $rows[] = array(
      array('data' => format_date($item->ngay_giao_dich, 'custom', 'd/m/Y'), 'class' => array('text-center')),
      check_plain($item->ma_giao_dich),
      check_plain(quan_ly_tai_chinh_loai_giao_dich_label($item->loai_giao_dich)),
      check_plain(quan_ly_tai_chinh_nhom_giao_dich_label($item->nhom_giao_dich)),
      check_plain($quy_text),
      check_plain(quan_ly_tai_chinh_object_text($item)),
      array('data' => '<strong>' . quan_ly_tai_chinh_format_money($item->so_tien) . '</strong>', 'class' => array('text-end')),
      check_plain($item->dien_giai),
      array('data' => l('Sửa', 'thu-chi/sua/' . $item->gd_id) . ' | ' . l('Xóa', 'thu-chi/xoa/' . $item->gd_id), 'class' => array('text-center')),
    );
  }

  if (empty($rows)) {
    $rows[] = array(array('data' => 'Chưa có giao dịch trong kỳ.', 'colspan' => count($header), 'class' => array('text-center')));
  }

  $html = '<div class="qltc-page">';
  $html .= quan_ly_tai_chinh_render_date_filter('thu-chi', $filters, TRUE);
  $html .= '<div class="card"><div class="card-body">';
  $html .= '<div class="qltc-title-row"><h4>Thu chi</h4><div>';
  $html .= l('Thêm giao dịch', 'thu-chi/them', array('attributes' => array('class' => array('btn', 'btn-primary', 'btn-sm'))));
  $html .= '</div></div>';
  $html .= theme('table', array('header' => $header, 'rows' => $rows, 'attributes' => array('class' => array('table', 'table-bordered', 'table-sm', 'qltc-table'))));
  $html .= theme('pager');
  $html .= '</div></div></div>';

  return $html;
}

/**
 * Form thêm/sửa quỹ.
 */
function quan_ly_tai_chinh_quy_form($form, &$form_state, $quy_id = 0) {
  $quy_id = intval($quy_id);
  $quy = $quy_id ? quan_ly_tai_chinh_quy_load($quy_id) : NULL;

  $form['quy_id'] = array('#type' => 'hidden', '#value' => $quy_id);
  $form['ma_quy'] = array('#type' => 'textfield', '#title' => 'Mã quỹ', '#required' => TRUE, '#default_value' => $quy ? $quy->ma_quy : '');
  $form['ten_quy'] = array('#type' => 'textfield', '#title' => 'Tên quỹ', '#required' => TRUE, '#default_value' => $quy ? $quy->ten_quy : '');
  $form['loai_quy'] = array('#type' => 'select', '#title' => 'Loại quỹ', '#options' => quan_ly_tai_chinh_loai_quy_options(), '#default_value' => $quy ? $quy->loai_quy : 'tien_mat');
  $form['so_du_dau_ky'] = array('#type' => 'textfield', '#title' => 'Số dư đầu kỳ', '#default_value' => $quy ? quan_ly_tai_chinh_format_money($quy->so_du_dau_ky) : '0', '#description' => $quy_id ? 'Không cho sửa số dư đầu kỳ sau khi tạo quỹ.' : 'Có thể nhập dạng 1.000.000', '#disabled' => $quy_id ? TRUE : FALSE);
  $form['ghi_chu'] = array('#type' => 'textarea', '#title' => 'Ghi chú', '#default_value' => $quy ? $quy->ghi_chu : '');
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => $quy_id ? 'Cập nhật' : 'Thêm quỹ');

  return $form;
}

function quan_ly_tai_chinh_quy_form_submit($form, &$form_state) {
  global $user;

  quan_ly_tai_chinh_ensure_quy_content_type();

  $quy_id = intval($form_state['values']['quy_id']);
  $ma_quy = trim($form_state['values']['ma_quy']);
  $ten_quy = trim($form_state['values']['ten_quy']);
  $loai_quy = $form_state['values']['loai_quy'];
  $ghi_chu = $form_state['values']['ghi_chu'];

  if (quan_ly_tai_chinh_quy_find_nid_by_ma($ma_quy, $quy_id)) {
    form_set_error('ma_quy', 'Mã quỹ đã tồn tại, vui lòng nhập mã khác.');
    return;
  }

  if ($quy_id) {
    $existing = quan_ly_tai_chinh_quy_load($quy_id);
    if (!$existing) {
      drupal_set_message('Không tìm thấy quỹ cần cập nhật.', 'error');
      $form_state['redirect'] = 'quan-ly-quy';
      return;
    }
  }
  $payload = array(
    'quy_id' => $quy_id,
    'ma_quy' => $ma_quy,
    'ten_quy' => $ten_quy,
    'loai_quy' => $loai_quy,
    'ghi_chu' => $ghi_chu,
  );
  if (!$quy_id) {
    $payload['so_du_dau_ky'] = $form_state['values']['so_du_dau_ky'];
  }
  $response = array();
  $_POST = $payload;
  $response = quan_ly_tai_chinh_quy_ajax_save();
  if (empty($response['success'])) {
    form_set_error('ma_quy', isset($response['message']) ? $response['message'] : 'Lưu quỹ thất bại.');
    return;
  }

  quan_ly_tai_chinh_rebuild_quy_balance($response['quy_id']);
  drupal_set_message('Đã lưu thông tin quỹ.');
  $form_state['redirect'] = 'quan-ly-quy';
}

/**
 * Xóa mềm quỹ.
 */
function quan_ly_tai_chinh_quy_delete_form($form, &$form_state, $quy_id) {
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy) {
    drupal_not_found();
    return array();
  }

  $form['quy_id'] = array('#type' => 'hidden', '#value' => intval($quy_id));
  return confirm_form($form, 'Bạn có chắc chắn muốn xóa quỹ ' . check_plain($quy->ten_quy) . '?', 'quan-ly-quy', 'Quỹ sẽ được ẩn khỏi danh sách bằng field_hoat_dong = 0. Các giao dịch cũ vẫn được giữ để đối soát.', 'Xóa', 'Hủy');
}

function quan_ly_tai_chinh_quy_delete_form_submit($form, &$form_state) {
  db_update('qltc_quy')
    ->fields(array('hoat_dong' => 0, 'status' => 0, 'changed' => REQUEST_TIME))
    ->condition('nid', intval($form_state['values']['quy_id']))
    ->execute();
  drupal_set_message('Đã xóa quỹ.');
  $form_state['redirect'] = 'quan-ly-quy';
}

/**
 * Form chuyển tiền nội bộ.
 */
function quan_ly_tai_chinh_chuyen_quy_form($form, &$form_state) {
  $options = quan_ly_tai_chinh_quy_options(TRUE);
  $form['quy_id'] = array('#type' => 'select', '#title' => 'Quỹ chuyển', '#options' => $options, '#required' => TRUE);
  $form['quy_nhan_id'] = array('#type' => 'select', '#title' => 'Quỹ nhận', '#options' => $options, '#required' => TRUE);
  $form['so_tien'] = array('#type' => 'textfield', '#title' => 'Số tiền', '#required' => TRUE, '#description' => 'Có thể nhập dạng 1.000.000');
  $form['ngay_giao_dich'] = array('#type' => 'textfield', '#title' => 'Ngày chuyển', '#default_value' => date('d/m/Y'), '#required' => TRUE);
  $form['dien_giai'] = array('#type' => 'textarea', '#title' => 'Diễn giải', '#default_value' => 'Chuyển tiền nội bộ giữa các quỹ');
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => 'Lưu chuyển tiền');

  return $form;
}

function quan_ly_tai_chinh_chuyen_quy_form_validate($form, &$form_state) {
  if (intval($form_state['values']['quy_id']) === intval($form_state['values']['quy_nhan_id'])) {
    form_set_error('quy_nhan_id', 'Quỹ nhận phải khác quỹ chuyển.');
  }
  if (quan_ly_tai_chinh_money_to_number($form_state['values']['so_tien']) <= 0) {
    form_set_error('so_tien', 'Số tiền phải lớn hơn 0.');
  }
}

function quan_ly_tai_chinh_chuyen_quy_form_submit($form, &$form_state) {
  global $user;
  $now = REQUEST_TIME;
  $ngay = quan_ly_tai_chinh_parse_date($form_state['values']['ngay_giao_dich']);

  $fields = array(
    'ma_giao_dich' => quan_ly_tai_chinh_generate_code('CQ'),
    'loai_giao_dich' => 'chuyen_quy',
    'nhom_giao_dich' => 'noi_bo',
    'quy_id' => intval($form_state['values']['quy_id']),
    'quy_nhan_id' => intval($form_state['values']['quy_nhan_id']),
    'so_tien' => quan_ly_tai_chinh_money_to_number($form_state['values']['so_tien']),
    'ngay_giao_dich' => $ngay,
    'thang_luong' => date('Ym', $ngay),
    'dien_giai' => $form_state['values']['dien_giai'],
    'uid' => $user->uid,
    'status' => 1,
    'created' => $now,
    'changed' => $now,
  );

  db_insert('qltc_giao_dich')->fields($fields)->execute();
  quan_ly_tai_chinh_rebuild_quy_balance($fields['quy_id']);
  quan_ly_tai_chinh_rebuild_quy_balance($fields['quy_nhan_id']);
  drupal_set_message('Đã lưu giao dịch chuyển tiền nội bộ.');
  $form_state['redirect'] = 'quan-ly-quy';
}

/**
 * Form thêm/sửa giao dịch thu chi.
 */
function quan_ly_tai_chinh_giao_dich_form($form, &$form_state, $gd_id = 0) {
  $gd_id = intval($gd_id);
  $gd = $gd_id ? quan_ly_tai_chinh_giao_dich_load($gd_id) : NULL;

  $form['gd_id'] = array('#type' => 'hidden', '#value' => $gd_id);
  $form['loai_giao_dich'] = array('#type' => 'select', '#title' => 'Loại giao dịch', '#options' => quan_ly_tai_chinh_loai_giao_dich_options(), '#default_value' => $gd ? $gd->loai_giao_dich : 'chi', '#required' => TRUE);
  $form['nhom_giao_dich'] = array('#type' => 'select', '#title' => 'Nhóm giao dịch', '#options' => quan_ly_tai_chinh_nhom_giao_dich_options(), '#default_value' => $gd ? $gd->nhom_giao_dich : 'khac', '#required' => TRUE);
  $form['quy_id'] = array('#type' => 'select', '#title' => 'Quỹ chi/thu', '#options' => array(0 => '- Không ảnh hưởng quỹ -') + quan_ly_tai_chinh_quy_options(TRUE), '#default_value' => $gd ? $gd->quy_id : 0);
  $form['so_tien'] = array('#type' => 'textfield', '#title' => 'Số tiền', '#required' => TRUE, '#default_value' => $gd ? quan_ly_tai_chinh_format_money($gd->so_tien) : '');
  $form['ngay_giao_dich'] = array('#type' => 'textfield', '#title' => 'Ngày giao dịch', '#required' => TRUE, '#default_value' => $gd ? format_date($gd->ngay_giao_dich, 'custom', 'd/m/Y') : date('d/m/Y'));
  $form['thang_luong'] = array('#type' => 'textfield', '#title' => 'Tháng lương', '#default_value' => $gd ? $gd->thang_luong : date('Ym'), '#description' => 'Dạng YYYYMM, ví dụ 202606. Dùng cho giao dịch lương/tạm ứng.');

  $form['doi_tuong'] = array('#type' => 'fieldset', '#title' => 'Đối tượng liên quan', '#collapsible' => TRUE, '#collapsed' => FALSE);
  $form['doi_tuong']['lai_xe_nid'] = array('#type' => 'select', '#title' => 'Lái xe', '#options' => array(0 => '- Không chọn -') + quan_ly_tai_chinh_node_options('lai_xe'), '#default_value' => $gd ? $gd->lai_xe_nid : 0, '#description' => 'Bắt buộc nếu là tạm ứng lái xe hoặc khấu trừ tạm ứng.');
  $form['doi_tuong']['luong_lai_xe_nid'] = array('#type' => 'textfield', '#title' => 'NID lương lái xe', '#default_value' => $gd ? $gd->luong_lai_xe_nid : 0);
  $form['doi_tuong']['khach_hang_nid'] = array('#type' => 'textfield', '#title' => 'NID khách hàng', '#default_value' => $gd ? $gd->khach_hang_nid : 0);
  $form['doi_tuong']['nha_cung_cap_nid'] = array('#type' => 'textfield', '#title' => 'NID nhà cung cấp', '#default_value' => $gd ? $gd->nha_cung_cap_nid : 0);
  $form['doi_tuong']['chuyen_xe_nid'] = array('#type' => 'textfield', '#title' => 'NID chuyến xe', '#default_value' => $gd ? $gd->chuyen_xe_nid : 0);

  $form['dien_giai'] = array('#type' => 'textarea', '#title' => 'Diễn giải', '#default_value' => $gd ? $gd->dien_giai : '');
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => $gd_id ? 'Cập nhật giao dịch' : 'Thêm giao dịch');

  return $form;
}

function quan_ly_tai_chinh_giao_dich_form_validate($form, &$form_state) {
  $loai = $form_state['values']['loai_giao_dich'];
  $so_tien = quan_ly_tai_chinh_money_to_number($form_state['values']['so_tien']);
  if ($so_tien <= 0) {
    form_set_error('so_tien', 'Số tiền phải lớn hơn 0.');
  }

  if (in_array($loai, array('thu', 'chi', 'tam_ung_lai_xe'))) {
    if (intval($form_state['values']['quy_id']) <= 0) {
      form_set_error('quy_id', 'Vui lòng chọn quỹ.');
    }
  }

  if (in_array($loai, array('tam_ung_lai_xe', 'khau_tru_tam_ung_luong')) && intval($form_state['values']['lai_xe_nid']) <= 0) {
    form_set_error('lai_xe_nid', 'Vui lòng chọn lái xe.');
  }

  if (!preg_match('/^\d{6}$/', trim($form_state['values']['thang_luong']))) {
    form_set_error('thang_luong', 'Tháng lương phải có dạng YYYYMM.');
  }
}

function quan_ly_tai_chinh_giao_dich_form_submit($form, &$form_state) {
  global $user;
  $now = REQUEST_TIME;
  $gd_id = intval($form_state['values']['gd_id']);
  $old = $gd_id ? quan_ly_tai_chinh_giao_dich_load($gd_id) : NULL;

  $ngay = quan_ly_tai_chinh_parse_date($form_state['values']['ngay_giao_dich']);
  $loai = $form_state['values']['loai_giao_dich'];
  $prefix = $loai === 'thu' ? 'THU' : ($loai === 'tam_ung_lai_xe' ? 'UT' : ($loai === 'khau_tru_tam_ung_luong' ? 'KTU' : 'CHI'));

  $fields = array(
    'ma_giao_dich' => $old ? $old->ma_giao_dich : quan_ly_tai_chinh_generate_code($prefix),
    'loai_giao_dich' => $loai,
    'nhom_giao_dich' => $form_state['values']['nhom_giao_dich'],
    'quy_id' => intval($form_state['values']['quy_id']),
    'quy_nhan_id' => 0,
    'so_tien' => quan_ly_tai_chinh_money_to_number($form_state['values']['so_tien']),
    'ngay_giao_dich' => $ngay,
    'thang_luong' => trim($form_state['values']['thang_luong']),
    'lai_xe_nid' => intval($form_state['values']['lai_xe_nid']),
    'luong_lai_xe_nid' => intval($form_state['values']['luong_lai_xe_nid']),
    'khach_hang_nid' => intval($form_state['values']['khach_hang_nid']),
    'nha_cung_cap_nid' => intval($form_state['values']['nha_cung_cap_nid']),
    'chuyen_xe_nid' => intval($form_state['values']['chuyen_xe_nid']),
    'dien_giai' => $form_state['values']['dien_giai'],
    'uid' => $user->uid,
    'status' => 1,
    'changed' => $now,
  );

  if ($gd_id) {
    db_update('qltc_giao_dich')->fields($fields)->condition('gd_id', $gd_id)->execute();
  }
  else {
    $fields['created'] = $now;
    $gd_id = db_insert('qltc_giao_dich')->fields($fields)->execute();
  }

  $rebuild_ids = array($fields['quy_id']);
  if ($old) {
    $rebuild_ids[] = $old->quy_id;
    $rebuild_ids[] = $old->quy_nhan_id;
  }
  foreach (array_unique($rebuild_ids) as $quy_id) {
    if ($quy_id) {
      quan_ly_tai_chinh_rebuild_quy_balance($quy_id);
    }
  }

  if ($fields['luong_lai_xe_nid']) {
    quan_ly_tai_chinh_sync_luong_tam_ung_json($fields['luong_lai_xe_nid']);
  }

  drupal_set_message('Đã lưu giao dịch.');
  $form_state['redirect'] = 'thu-chi';
}

/**
 * Xóa mềm giao dịch.
 */
function quan_ly_tai_chinh_giao_dich_delete_form($form, &$form_state, $gd_id) {
  $gd = quan_ly_tai_chinh_giao_dich_load($gd_id);
  if (!$gd) {
    drupal_not_found();
    return array();
  }
  $form['gd_id'] = array('#type' => 'hidden', '#value' => intval($gd_id));
  return confirm_form($form, 'Bạn có chắc chắn muốn xóa giao dịch ' . check_plain($gd->ma_giao_dich) . '?', 'thu-chi', 'Giao dịch sẽ được ẩn khỏi danh sách, số dư quỹ sẽ được tính lại.', 'Xóa', 'Hủy');
}

function quan_ly_tai_chinh_giao_dich_delete_form_submit($form, &$form_state) {
  $gd = quan_ly_tai_chinh_giao_dich_load(intval($form_state['values']['gd_id']));
  if ($gd) {
    db_update('qltc_giao_dich')->fields(array('status' => 0, 'changed' => REQUEST_TIME))->condition('gd_id', $gd->gd_id)->execute();
    quan_ly_tai_chinh_rebuild_quy_balance($gd->quy_id);
    quan_ly_tai_chinh_rebuild_quy_balance($gd->quy_nhan_id);
    if (!empty($gd->luong_lai_xe_nid)) {
      quan_ly_tai_chinh_sync_luong_tam_ung_json($gd->luong_lai_xe_nid);
    }
  }
  drupal_set_message('Đã xóa giao dịch.');
  $form_state['redirect'] = 'thu-chi';
}

/**
 * API dùng cho module lương lái xe: tạo/cập nhật khoản khấu trừ tạm ứng theo kỳ lương.
 */
function quan_ly_tai_chinh_save_khau_tru_tam_ung_luong($lai_xe_nid, $luong_lai_xe_nid, $thang_luong, $so_tien, $ghi_chu = '') {
  global $user;

  $lai_xe_nid = intval($lai_xe_nid);
  $luong_lai_xe_nid = intval($luong_lai_xe_nid);
  $thang_luong = trim($thang_luong);
  $so_tien = max(0, quan_ly_tai_chinh_money_to_number($so_tien));
  $now = REQUEST_TIME;

  if (!$lai_xe_nid || !$luong_lai_xe_nid || !preg_match('/^\d{6}$/', $thang_luong)) {
    return FALSE;
  }

  $existing = db_select('qltc_giao_dich', 'gd')
    ->fields('gd')
    ->condition('loai_giao_dich', 'khau_tru_tam_ung_luong')
    ->condition('luong_lai_xe_nid', $luong_lai_xe_nid)
    ->condition('status', 1)
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $date = quan_ly_tai_chinh_month_end_time($thang_luong);
  $fields = array(
    'loai_giao_dich' => 'khau_tru_tam_ung_luong',
    'nhom_giao_dich' => 'tam_ung_lai_xe',
    'quy_id' => 0,
    'quy_nhan_id' => 0,
    'so_tien' => $so_tien,
    'ngay_giao_dich' => $date,
    'thang_luong' => $thang_luong,
    'lai_xe_nid' => $lai_xe_nid,
    'luong_lai_xe_nid' => $luong_lai_xe_nid,
    'dien_giai' => $ghi_chu ? $ghi_chu : 'Khấu trừ tạm ứng vào lương tháng ' . $thang_luong,
    'uid' => $user->uid,
    'status' => 1,
    'changed' => $now,
  );

  if ($existing) {
    db_update('qltc_giao_dich')->fields($fields)->condition('gd_id', $existing->gd_id)->execute();
    $gd_id = $existing->gd_id;
  }
  else {
    $fields['ma_giao_dich'] = quan_ly_tai_chinh_generate_code('KTU');
    $fields['created'] = $now;
    $gd_id = db_insert('qltc_giao_dich')->fields($fields)->execute();
  }

  quan_ly_tai_chinh_sync_luong_tam_ung_json($luong_lai_xe_nid);
  return $gd_id;
}

/**
 * API tính tóm tắt tạm ứng theo lương lái xe.
 */
function quan_ly_tai_chinh_luong_lai_xe_tam_ung_summary($lai_xe_nid, $thang_luong, $luong_lai_xe_nid = 0, $tong_luong = 0) {
  $lai_xe_nid = intval($lai_xe_nid);
  $luong_lai_xe_nid = intval($luong_lai_xe_nid);
  $tong_luong = quan_ly_tai_chinh_money_to_number($tong_luong);

  $start = quan_ly_tai_chinh_month_start_time($thang_luong);
  $end = quan_ly_tai_chinh_month_end_time($thang_luong);

  $so_du_dau_ky = quan_ly_tai_chinh_lai_xe_tam_ung_balance($lai_xe_nid, $start - 1);
  $ung_trong_ky = quan_ly_tai_chinh_lai_xe_tam_ung_sum($lai_xe_nid, 'tam_ung_lai_xe', $start, $end, 0, $thang_luong);
  $khau_tru = quan_ly_tai_chinh_lai_xe_tam_ung_sum($lai_xe_nid, 'khau_tru_tam_ung_luong', $start, $end, $luong_lai_xe_nid, $thang_luong);

  $so_du_cuoi_ky = max(0, $so_du_dau_ky + $ung_trong_ky - $khau_tru);
  $thuc_linh = $tong_luong - $khau_tru;

  return array(
    'so_du_dau_ky' => $so_du_dau_ky,
    'phat_sinh_ung_trong_ky' => $ung_trong_ky,
    'khau_tru_trong_ky' => $khau_tru,
    'so_du_cuoi_ky' => $so_du_cuoi_ky,
    'tong_luong' => $tong_luong,
    'thuc_linh' => $thuc_linh,
  );
}

/**
 * API lấy số dư tạm ứng hiện tại/cắt tại thời điểm.
 */
function quan_ly_tai_chinh_lai_xe_tam_ung_balance($lai_xe_nid, $to_time = NULL) {
  $lai_xe_nid = intval($lai_xe_nid);
  if (!$lai_xe_nid) {
    return 0;
  }

  $query = db_select('qltc_giao_dich', 'gd')
    ->fields('gd', array('loai_giao_dich', 'so_tien'))
    ->condition('status', 1)
    ->condition('lai_xe_nid', $lai_xe_nid)
    ->condition('loai_giao_dich', array('tam_ung_lai_xe', 'khau_tru_tam_ung_luong'), 'IN');

  if ($to_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($to_time), '<=');
  }

  $balance = 0;
  foreach ($query->execute() as $row) {
    if ($row->loai_giao_dich === 'tam_ung_lai_xe') {
      $balance += quan_ly_tai_chinh_money_to_number($row->so_tien);
    }
    elseif ($row->loai_giao_dich === 'khau_tru_tam_ung_luong') {
      $balance -= quan_ly_tai_chinh_money_to_number($row->so_tien);
    }
  }

  return max(0, $balance);
}

/**
 * Tổng tạm ứng hoặc khấu trừ trong kỳ.
 */
function quan_ly_tai_chinh_lai_xe_tam_ung_sum($lai_xe_nid, $loai, $from_time, $to_time, $luong_lai_xe_nid = 0, $thang_luong = '') {
  $query = db_select('qltc_giao_dich', 'gd')
    ->condition('status', 1)
    ->condition('lai_xe_nid', intval($lai_xe_nid))
    ->condition('loai_giao_dich', $loai);

  if ($luong_lai_xe_nid) {
    $query->condition('luong_lai_xe_nid', intval($luong_lai_xe_nid));
  }
  else {
    $query->condition('ngay_giao_dich', intval($from_time), '>=')
      ->condition('ngay_giao_dich', intval($to_time), '<=');
    if ($thang_luong) {
      $query->condition('thang_luong', $thang_luong);
    }
  }

  $query->addExpression('SUM(so_tien)', 'total');
  return quan_ly_tai_chinh_money_to_number($query->execute()->fetchField());
}

/**
 * Đồng bộ thông tin tạm ứng vào field_thong_tin_json của lương lái xe.
 */
function quan_ly_tai_chinh_sync_luong_tam_ung_json($luong_lai_xe_nid) {
  $node = node_load(intval($luong_lai_xe_nid));
  if (!$node || !is_object($node) || $node->type !== 'luong_lai_xe') {
    return FALSE;
  }

  $lai_xe_nid = quan_ly_tai_chinh_field_target_id($node, 'field_lai_xe');
  $thang_luong = trim(quan_ly_tai_chinh_field_value($node, 'field_thang_luong'));
  $json = quan_ly_tai_chinh_json_decode(quan_ly_tai_chinh_field_value($node, 'field_thong_tin_json'));
  $tong_luong = isset($json['tong']) ? quan_ly_tai_chinh_money_to_number($json['tong']) : 0;

  $tam_ung = quan_ly_tai_chinh_luong_lai_xe_tam_ung_summary($lai_xe_nid, $thang_luong, $node->nid, $tong_luong);
  $json['tam_ung'] = $tam_ung;
  $json['thuc_linh'] = $tam_ung['thuc_linh'];

  $node->field_thong_tin_json['und'][0]['value'] = json_encode($json);
  node_save($node);
  return TRUE;
}

/**
 * Lấy danh sách quỹ.
 */
function quan_ly_tai_chinh_quy_get_all($active_only = TRUE) {
  quan_ly_tai_chinh_ensure_quy_content_type();

  $query = db_select('qltc_quy', 'q')->fields('q');
  if ($active_only) {
    $query->condition('hoat_dong', 1);
  }
  $items = array();
  foreach ($query->execute() as $row) {
    $items[] = quan_ly_tai_chinh_quy_node_to_object($row);
  }

  usort($items, 'quan_ly_tai_chinh_quy_sort_by_name');
  return $items;
}

function quan_ly_tai_chinh_quy_sort_by_name($a, $b) {
  return strnatcasecmp($a->ten_quy, $b->ten_quy);
}

function quan_ly_tai_chinh_quy_load($quy_id) {
  quan_ly_tai_chinh_ensure_quy_table();
  $row = db_select('qltc_quy', 'q')->fields('q')->condition('nid', intval($quy_id))->execute()->fetchObject();
  if (!$row) {
    return FALSE;
  }
  return quan_ly_tai_chinh_quy_node_to_object($row);
}

function quan_ly_tai_chinh_giao_dich_load($gd_id) {
  return db_select('qltc_giao_dich', 'gd')->fields('gd')->condition('gd_id', intval($gd_id))->execute()->fetchObject();
}

function quan_ly_tai_chinh_quy_options($active_only = TRUE) {
  $options = array();
  foreach (quan_ly_tai_chinh_quy_get_all($active_only) as $quy) {
    $options[$quy->quy_id] = $quy->ten_quy . ($quy->ma_quy ? ' (' . $quy->ma_quy . ')' : '');
  }
  return $options;
}


/**
 * Kiểm tra hệ thống có content type phiếu thu chi hay chưa.
 */
function quan_ly_tai_chinh_has_phieu_thu_chi_content_type() {
  return function_exists('db_table_exists') && db_table_exists('qltc_phieu_thu_chi');
}

/**
 * Thêm điều kiện để bỏ qua các bản ghi qltc_giao_dich được đồng bộ từ node
 * phieu_thu_chi, tránh tính trùng khi module thu_chi đã lưu phiếu bằng node.
 */
function quan_ly_tai_chinh_query_exclude_synced_phieu(&$query) {
  if (db_table_exists('qltc_giao_dich') && db_field_exists('qltc_giao_dich', 'ref_type')) {
    $query->condition(db_or()
      ->condition('ref_type', 'phieu_thu_chi', '<>')
      ->isNull('ref_type')
      ->condition('ref_type', ''));
  }
}

/**
 * Lấy các phiếu thu chi đã duyệt đang liên kết với một quỹ quy_tai_chinh.
 *
 * Dữ liệu lấy trực tiếp từ content type phieu_thu_chi:
 * - field_tc_quy / field_tc_quy_nhan: entityreference tới quy_tai_chinh.
 * - field_tc_so_tien: số tiền.
 * - field_tc_ngay_phieu: ngày phiếu dạng timestamp.
 * - field_duyet = da_duyet.
 * - field_thong_tin_json.loai_phieu: thu / chi / chuyen_quy.
 */
function quan_ly_tai_chinh_phieu_thu_chi_by_quy($quy_id, $from_time = NULL, $to_time = NULL) {
  $items = array();
  $quy_id = intval($quy_id);
  if (!$quy_id || !quan_ly_tai_chinh_has_phieu_thu_chi_content_type()) {
    return $items;
  }

  $query = db_select('qltc_phieu_thu_chi', 'p');
  $query->fields('p', array('nid', 'ma_giao_dich', 'created', 'so_tien', 'ngay_giao_dich', 'quy_id', 'quy_nhan_id', 'thong_tin_json', 'loai_phieu'));
  $query->condition('p.hoat_dong', 1);
  $query->condition('p.duyet_status', array('da_duyet', 'yeu_cau_dieu_chinh'), 'IN');
  $query->condition(db_or()
    ->condition('p.quy_id', $quy_id)
    ->condition('p.quy_nhan_id', $quy_id));

  if ($from_time !== NULL) {
    $query->condition('p.ngay_giao_dich', intval($from_time), '>=');
  }
  if ($to_time !== NULL) {
    $query->condition('p.ngay_giao_dich', intval($to_time), '<=');
  }

  foreach ($query->execute() as $row) {
    $json = quan_ly_tai_chinh_json_decode(isset($row->thong_tin_json) ? $row->thong_tin_json : '');
    $loai_phieu = !empty($row->loai_phieu) ? trim((string) $row->loai_phieu) : (!empty($json['loai_phieu']) ? trim((string) $json['loai_phieu']) : 'chi');

    $item = new stdClass();
    $item->nid = intval($row->nid);
    $item->ma_phieu = (string) $row->ma_giao_dich;
    $item->loai_phieu = $loai_phieu;
    $item->quy_id = intval($row->quy_id);
    $item->quy_nhan_id = intval($row->quy_nhan_id);
    $item->so_tien = quan_ly_tai_chinh_money_to_number($row->so_tien);
    $item->ngay_phieu = intval($row->ngay_giao_dich);
    $items[] = $item;
  }

  return $items;
}


/**
 * Schema bảng sổ cái quỹ dùng được cả trong hook_schema() và runtime fallback.
 */
function quan_ly_tai_chinh_so_cai_quy_schema_definition() {
  return array(
    'description' => 'Sổ cái biến động quỹ. Đây là nguồn dữ liệu chính để tính số dư quỹ theo thời gian.',
    'fields' => array(
      'id' => array('type' => 'serial', 'not null' => TRUE),
      'quy_nid' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'source_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'source_id' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'source_line' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'phieu_nid' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'ma_chung_tu' => array('type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''),
      'loai_bien_dong' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'ngay_giao_dich' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'thoi_gian_phat_sinh' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'so_tien' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'bien_dong' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'so_du_truoc' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'so_du_sau' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'doi_tuong_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'doi_tuong_id' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'uid_thuc_hien' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'ghi_chu' => array('type' => 'text', 'not null' => FALSE),
      'data_json' => array('type' => 'text', 'not null' => FALSE),
      'status' => array('type' => 'int', 'not null' => TRUE, 'default' => 1),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'changed' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('id'),
    'indexes' => array(
      'quy_nid' => array('quy_nid'),
      'source' => array('source_type', 'source_id'),
      'source_line' => array('source_type', 'source_id', 'source_line'),
      'phieu_nid' => array('phieu_nid'),
      'ngay_giao_dich' => array('ngay_giao_dich'),
      'status' => array('status'),
      'quy_ngay_status' => array('quy_nid', 'ngay_giao_dich', 'status'),
    ),
  );
}

/**
 * Đảm bảo bảng qltc_so_cai_quy tồn tại và có đủ cột/index cần thiết.
 */
function quan_ly_tai_chinh_ensure_so_cai_quy_table() {
  if (!function_exists('db_table_exists')) {
    return FALSE;
  }

  if (!db_table_exists('qltc_so_cai_quy')) {
    db_create_table('qltc_so_cai_quy', quan_ly_tai_chinh_so_cai_quy_schema_definition());
    return TRUE;
  }

  $schema = quan_ly_tai_chinh_so_cai_quy_schema_definition();
  foreach ($schema['fields'] as $field => $definition) {
    if (!db_field_exists('qltc_so_cai_quy', $field)) {
      db_add_field('qltc_so_cai_quy', $field, $definition);
    }
  }
  foreach ($schema['indexes'] as $name => $fields) {
    if (!db_index_exists('qltc_so_cai_quy', $name)) {
      db_add_index('qltc_so_cai_quy', $name, $fields);
    }
  }

  return TRUE;
}

/**
 * Chuyển một giá trị thành JSON an toàn.
 */
function quan_ly_tai_chinh_json_encode_safe($data) {
  if (function_exists('quan_ly_tai_chinh_json_encode')) {
    return quan_ly_tai_chinh_json_encode($data);
  }
  return json_encode($data);
}

/**
 * Xóa hiệu lực các dòng sổ cái cũ theo nguồn phát sinh.
 */
function quan_ly_tai_chinh_void_so_cai_source($source_type, $source_id) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $source_type = trim((string) $source_type);
  $source_id = intval($source_id);
  if ($source_type === '' || !$source_id || !db_table_exists('qltc_so_cai_quy')) {
    return 0;
  }

  return db_update('qltc_so_cai_quy')
    ->fields(array('status' => 0, 'changed' => REQUEST_TIME))
    ->condition('source_type', $source_type)
    ->condition('source_id', $source_id)
    ->execute();
}

/**
 * Ghi một dòng sổ cái quỹ.
 *
 * Mỗi dòng là một biến động độc lập: thu dương, chi âm. Số dư trước/sau sẽ
 * được rebuild theo thứ tự ngày sau khi ghi, không lấy JSON làm nguồn tính.
 */
function quan_ly_tai_chinh_insert_so_cai_quy(array $values) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (!db_table_exists('qltc_so_cai_quy')) {
    return FALSE;
  }

  $now = REQUEST_TIME;
  $fields = array(
    'quy_nid' => intval(isset($values['quy_nid']) ? $values['quy_nid'] : 0),
    'source_type' => trim((string) (isset($values['source_type']) ? $values['source_type'] : '')),
    'source_id' => intval(isset($values['source_id']) ? $values['source_id'] : 0),
    'source_line' => trim((string) (isset($values['source_line']) ? $values['source_line'] : '')),
    'phieu_nid' => intval(isset($values['phieu_nid']) ? $values['phieu_nid'] : 0),
    'ma_chung_tu' => trim((string) (isset($values['ma_chung_tu']) ? $values['ma_chung_tu'] : '')),
    'loai_bien_dong' => trim((string) (isset($values['loai_bien_dong']) ? $values['loai_bien_dong'] : '')),
    'ngay_giao_dich' => intval(isset($values['ngay_giao_dich']) ? $values['ngay_giao_dich'] : $now),
    'thoi_gian_phat_sinh' => intval(isset($values['thoi_gian_phat_sinh']) ? $values['thoi_gian_phat_sinh'] : $now),
    'so_tien' => quan_ly_tai_chinh_money_to_number(isset($values['so_tien']) ? $values['so_tien'] : 0),
    'bien_dong' => quan_ly_tai_chinh_money_to_number(isset($values['bien_dong']) ? $values['bien_dong'] : 0),
    'so_du_truoc' => 0,
    'so_du_sau' => 0,
    'doi_tuong_type' => trim((string) (isset($values['doi_tuong_type']) ? $values['doi_tuong_type'] : '')),
    'doi_tuong_id' => intval(isset($values['doi_tuong_id']) ? $values['doi_tuong_id'] : 0),
    'uid_thuc_hien' => intval(isset($values['uid_thuc_hien']) ? $values['uid_thuc_hien'] : 0),
    'ghi_chu' => isset($values['ghi_chu']) ? (string) $values['ghi_chu'] : '',
    'data_json' => isset($values['data_json']) ? (is_string($values['data_json']) ? $values['data_json'] : quan_ly_tai_chinh_json_encode_safe($values['data_json'])) : '',
    'status' => intval(isset($values['status']) ? $values['status'] : 1),
    'created' => intval(isset($values['created']) ? $values['created'] : $now),
    'changed' => $now,
  );

  if (!$fields['quy_nid'] || $fields['source_type'] === '' || !$fields['source_id'] || abs($fields['bien_dong']) < 0.00001) {
    return FALSE;
  }

  return db_insert('qltc_so_cai_quy')->fields($fields)->execute();
}

/**
 * Trạng thái phiếu thu chi nào còn hiệu lực hạch toán trong sổ cái quỹ.
 * Yêu cầu điều chỉnh chỉ là trạng thái chờ xét duyệt, nên giao dịch cũ vẫn được tính.
 */
function quan_ly_tai_chinh_phieu_status_counts_in_ledger($duyet_status) {
  return in_array(trim((string) $duyet_status), array('da_duyet', 'yeu_cau_dieu_chinh'), TRUE);
}

/**
 * Đồng bộ một phiếu thu/chi sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($phieu_nid, $duyet_status = NULL) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $phieu_nid = intval($phieu_nid);
  if (!$phieu_nid || !db_table_exists('qltc_so_cai_quy')) {
    return FALSE;
  }

  quan_ly_tai_chinh_void_so_cai_source('phieu_thu_chi', $phieu_nid);

  if (!function_exists('thu_chi_giao_dich_load')) {
    return FALSE;
  }

  $phieu = thu_chi_giao_dich_load($phieu_nid, TRUE);
  if (!$phieu) {
    return FALSE;
  }

  $active = intval($phieu->status) === 1;
  $duyet = $duyet_status === NULL ? trim((string) $phieu->duyet_status) : trim((string) $duyet_status);
  if (!$active || !quan_ly_tai_chinh_phieu_status_counts_in_ledger($duyet)) {
    return FALSE;
  }

  $json = !empty($phieu->json) ? $phieu->json : array();
  $loai = $phieu->loai_phieu;
  $amount = quan_ly_tai_chinh_money_to_number($phieu->so_tien);
  $ngay = intval($phieu->ngay_giao_dich);
  $quy_id = intval($phieu->quy_id);
  $quy_nhan_id = intval($phieu->quy_nhan_id);
  $uid = !empty($json['duyet_uid']) ? intval($json['duyet_uid']) : intval($phieu->uid);
  $time = !empty($json['duyet_time']) ? intval($json['duyet_time']) : REQUEST_TIME;

  $base = array(
    'source_type' => 'phieu_thu_chi',
    'source_id' => $phieu_nid,
    'phieu_nid' => $phieu_nid,
    'ma_chung_tu' => $phieu->ma_giao_dich,
    'ngay_giao_dich' => $ngay,
    'thoi_gian_phat_sinh' => $time,
    'so_tien' => $amount,
    'uid_thuc_hien' => $uid,
    'ghi_chu' => 'Duyệt phiếu thu chi',
    'data_json' => array('loai_phieu' => $loai, 'duyet' => $duyet),
    'status' => 1,
    'created' => intval($phieu->created),
  );

  $inserted = 0;
  if ($loai === 'thu' && $quy_id) {
    $row = $base + array('quy_nid' => $quy_id, 'source_line' => 'thu', 'loai_bien_dong' => 'thu', 'bien_dong' => $amount);
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
  }
  elseif ($loai === 'chi' && $quy_id) {
    $row = $base + array('quy_nid' => $quy_id, 'source_line' => 'chi', 'loai_bien_dong' => 'chi', 'bien_dong' => -1 * $amount);
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
  }
  elseif ($loai === 'chuyen_quy') {
    if ($quy_id) {
      $row = $base + array('quy_nid' => $quy_id, 'source_line' => 'chuyen_di', 'loai_bien_dong' => 'chuyen_di', 'bien_dong' => -1 * $amount);
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
    }
    if ($quy_nhan_id) {
      $row = $base + array('quy_nid' => $quy_nhan_id, 'source_line' => 'chuyen_den', 'loai_bien_dong' => 'chuyen_den', 'bien_dong' => $amount);
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($row) ? 1 : 0;
    }
  }

  return $inserted;
}

/**
 * Đồng bộ một dòng qltc_giao_dich cũ sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (is_numeric($gd)) {
    $gd = quan_ly_tai_chinh_giao_dich_load(intval($gd));
  }
  if (!$gd || !is_object($gd) || empty($gd->gd_id)) {
    return FALSE;
  }

  quan_ly_tai_chinh_void_so_cai_source('qltc_giao_dich', intval($gd->gd_id));

  if (intval($gd->status) !== 1) {
    return FALSE;
  }
  if (!empty($gd->ref_type) && $gd->ref_type === 'phieu_thu_chi') {
    return FALSE;
  }

  $amount = quan_ly_tai_chinh_money_to_number(isset($gd->so_tien) ? $gd->so_tien : 0);
  $quy_id = intval(isset($gd->quy_id) ? $gd->quy_id : 0);
  $quy_nhan_id = intval(isset($gd->quy_nhan_id) ? $gd->quy_nhan_id : 0);
  $loai = isset($gd->loai_giao_dich) ? trim((string) $gd->loai_giao_dich) : '';
  $base = array(
    'source_type' => 'qltc_giao_dich',
    'source_id' => intval($gd->gd_id),
    'phieu_nid' => 0,
    'ma_chung_tu' => isset($gd->ma_giao_dich) ? $gd->ma_giao_dich : ('GD' . intval($gd->gd_id)),
    'ngay_giao_dich' => !empty($gd->ngay_giao_dich) ? intval($gd->ngay_giao_dich) : REQUEST_TIME,
    'thoi_gian_phat_sinh' => !empty($gd->changed) ? intval($gd->changed) : REQUEST_TIME,
    'so_tien' => $amount,
    'uid_thuc_hien' => !empty($gd->uid) ? intval($gd->uid) : 0,
    'ghi_chu' => isset($gd->dien_giai) ? $gd->dien_giai : '',
    'data_json' => array('loai_giao_dich' => $loai, 'nhom_giao_dich' => isset($gd->nhom_giao_dich) ? $gd->nhom_giao_dich : ''),
    'status' => 1,
    'created' => !empty($gd->created) ? intval($gd->created) : REQUEST_TIME,
  );

  $inserted = 0;
  if ($loai === 'thu' && $quy_id) {
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('quy_nid' => $quy_id, 'source_line' => 'thu', 'loai_bien_dong' => 'thu', 'bien_dong' => $amount)) ? 1 : 0;
  }
  elseif (in_array($loai, array('chi', 'tam_ung_lai_xe'), TRUE) && $quy_id) {
    $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('quy_nid' => $quy_id, 'source_line' => 'chi', 'loai_bien_dong' => 'chi', 'bien_dong' => -1 * $amount)) ? 1 : 0;
  }
  elseif ($loai === 'chuyen_quy') {
    if ($quy_id) {
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('quy_nid' => $quy_id, 'source_line' => 'chuyen_di', 'loai_bien_dong' => 'chuyen_di', 'bien_dong' => -1 * $amount)) ? 1 : 0;
    }
    if ($quy_nhan_id) {
      $inserted += quan_ly_tai_chinh_insert_so_cai_quy($base + array('quy_nid' => $quy_nhan_id, 'source_line' => 'chuyen_den', 'loai_bien_dong' => 'chuyen_den', 'bien_dong' => $amount)) ? 1 : 0;
    }
  }

  return $inserted;
}

/**
 * Đồng bộ tất cả phiếu thu chi đã có sang sổ cái quỹ.
 */
function quan_ly_tai_chinh_sync_all_phieu_thu_chi_to_so_cai() {
  if (!db_table_exists('qltc_phieu_thu_chi')) {
    return 0;
  }

  $count = 0;
  $query = db_select('qltc_phieu_thu_chi', 'p')->fields('p', array('nid'))->range(0, 10000);
  foreach ($query->execute() as $row) {
    quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($row->nid);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ các phiếu thu chi liên quan một quỹ sang sổ cái.
 */
function quan_ly_tai_chinh_sync_phieu_thu_chi_by_quy_to_so_cai($quy_id) {
  $quy_id = intval($quy_id);
  if (!$quy_id || !db_table_exists('qltc_phieu_thu_chi')) {
    return 0;
  }

  $query = db_select('qltc_phieu_thu_chi', 'p');
  $query->fields('p', array('nid'));
  $query->condition(db_or()->condition('p.quy_id', $quy_id)->condition('p.quy_nhan_id', $quy_id));
  $query->range(0, 10000);
  $count = 0;
  foreach ($query->execute() as $row) {
    quan_ly_tai_chinh_sync_phieu_thu_chi_to_so_cai($row->nid);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ tất cả giao dịch cũ trong qltc_giao_dich sang sổ cái.
 */
function quan_ly_tai_chinh_sync_all_giao_dich_to_so_cai() {
  if (!db_table_exists('qltc_giao_dich')) {
    return 0;
  }
  $count = 0;
  $query = db_select('qltc_giao_dich', 'gd')->fields('gd')->range(0, 10000);
  foreach ($query->execute() as $gd) {
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd);
    $count++;
  }
  return $count;
}

/**
 * Đồng bộ các giao dịch cũ liên quan một quỹ sang sổ cái.
 */
function quan_ly_tai_chinh_sync_giao_dich_by_quy_to_so_cai($quy_id) {
  if (!db_table_exists('qltc_giao_dich')) {
    return 0;
  }
  $quy_id = intval($quy_id);
  $count = 0;
  $query = db_select('qltc_giao_dich', 'gd')
    ->fields('gd')
    ->condition(db_or()->condition('quy_id', $quy_id)->condition('quy_nhan_id', $quy_id))
    ->range(0, 10000);
  foreach ($query->execute() as $gd) {
    quan_ly_tai_chinh_sync_giao_dich_to_so_cai($gd);
    $count++;
  }
  return $count;
}

/**
 * Query các dòng sổ cái của một quỹ.
 */
function quan_ly_tai_chinh_so_cai_quy_rows($quy_id, $from_time = NULL, $to_time = NULL, $active_only = TRUE, $limit = 0) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $rows = array();
  $quy_id = intval($quy_id);
  if (!$quy_id || !db_table_exists('qltc_so_cai_quy')) {
    return $rows;
  }

  $query = db_select('qltc_so_cai_quy', 'sc')->fields('sc')->condition('quy_nid', $quy_id);
  if ($active_only) {
    $query->condition('status', 1);
  }
  if ($from_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($from_time), '>=');
  }
  if ($to_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($to_time), '<=');
  }
  $query->orderBy('ngay_giao_dich', 'ASC')->orderBy('id', 'ASC');
  if ($limit > 0) {
    $query->range(0, intval($limit));
  }
  foreach ($query->execute() as $row) {
    $rows[] = $row;
  }
  return $rows;
}

/**
 * Rebuild số dư chạy trên sổ cái của một quỹ.
 */
function quan_ly_tai_chinh_rebuild_so_cai_quy_running_balance($quy_id) {
  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy || !db_table_exists('qltc_so_cai_quy')) {
    return 0;
  }

  $balance = quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky);
  $rows = quan_ly_tai_chinh_so_cai_quy_rows($quy_id, NULL, NULL, TRUE);
  foreach ($rows as $row) {
    $before = $balance;
    $balance += quan_ly_tai_chinh_money_to_number($row->bien_dong);
    db_update('qltc_so_cai_quy')
      ->fields(array('so_du_truoc' => $before, 'so_du_sau' => $balance, 'changed' => REQUEST_TIME))
      ->condition('id', intval($row->id))
      ->execute();
  }

  return $balance;
}

/**
 * Tính số dư quỹ tại một thời điểm từ sổ cái qltc_so_cai_quy.
 *
 * Số dư hiện tại trong node quy_tai_chinh chỉ là cache. Nguồn tính chính là
 * field_so_du_dau_ky + SUM(bien_dong) của các dòng sổ cái đang active.
 */
function quan_ly_tai_chinh_quy_balance($quy_id, $to_time = NULL) {
  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy) {
    return 0;
  }

  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  $quy_id = intval($quy_id);
  $balance = quan_ly_tai_chinh_money_to_number($quy->so_du_dau_ky);

  if (!db_table_exists('qltc_so_cai_quy')) {
    return $balance;
  }

  $query = db_select('qltc_so_cai_quy', 'sc')
    ->condition('quy_nid', $quy_id)
    ->condition('status', 1);
  $query->addExpression('SUM(bien_dong)', 'total_delta');
  if ($to_time !== NULL) {
    $query->condition('ngay_giao_dich', intval($to_time), '<=');
  }
  $delta = quan_ly_tai_chinh_money_to_number($query->execute()->fetchField());
  return $balance + $delta;
}

/**
 * Tóm tắt quỹ trong kỳ từ sổ cái qltc_so_cai_quy.
 */
function quan_ly_tai_chinh_quy_period_summary($quy_id, $from_time, $to_time) {
  $quy_id = intval($quy_id);
  $dau_ky = quan_ly_tai_chinh_quy_balance($quy_id, $from_time - 1);
  $summary = array('dau_ky' => $dau_ky, 'thu' => 0, 'chi' => 0, 'chuyen_den' => 0, 'chuyen_di' => 0, 'cuoi_ky' => $dau_ky);

  quan_ly_tai_chinh_ensure_so_cai_quy_table();
  if (db_table_exists('qltc_so_cai_quy')) {
    $rows = db_select('qltc_so_cai_quy', 'sc')
      ->fields('sc', array('loai_bien_dong', 'bien_dong'))
      ->condition('quy_nid', $quy_id)
      ->condition('status', 1)
      ->condition('ngay_giao_dich', intval($from_time), '>=')
      ->condition('ngay_giao_dich', intval($to_time), '<=')
      ->execute();

    foreach ($rows as $row) {
      $delta = quan_ly_tai_chinh_money_to_number($row->bien_dong);
      if ($delta >= 0) {
        if ($row->loai_bien_dong === 'chuyen_den') {
          $summary['chuyen_den'] += $delta;
        }
        else {
          $summary['thu'] += $delta;
        }
      }
      else {
        if ($row->loai_bien_dong === 'chuyen_di') {
          $summary['chuyen_di'] += abs($delta);
        }
        else {
          $summary['chi'] += abs($delta);
        }
      }
    }
  }

  $summary['cuoi_ky'] = $summary['dau_ky'] + $summary['thu'] - $summary['chi'] + $summary['chuyen_den'] - $summary['chuyen_di'];
  return $summary;
}

function quan_ly_tai_chinh_rebuild_quy_balance($quy_id, $sync_sources = TRUE) {
  $quy_id = intval($quy_id);
  if (!$quy_id) {
    return;
  }

  $quy = quan_ly_tai_chinh_quy_load($quy_id);
  if (!$quy) {
    return;
  }

  quan_ly_tai_chinh_ensure_so_cai_quy_table();

  if ($sync_sources) {
    // Đồng bộ lại nguồn phát sinh trước khi tính số dư để khi sửa phiếu quá khứ,
    // toàn bộ số dư sau đó được rebuild theo sổ cái.
    quan_ly_tai_chinh_sync_phieu_thu_chi_by_quy_to_so_cai($quy_id);
    quan_ly_tai_chinh_sync_giao_dich_by_quy_to_so_cai($quy_id);
  }

  $current = quan_ly_tai_chinh_rebuild_so_cai_quy_running_balance($quy_id);
  db_update('qltc_quy')
    ->fields(array('so_du_hien_tai' => $current, 'status' => 0, 'changed' => REQUEST_TIME))
    ->condition('nid', $quy_id)
    ->execute();
}

/**
 * Bộ lọc từ ngày đến ngày, mặc định tháng hiện tại.
 */
function quan_ly_tai_chinh_get_date_filters() {
  $from = isset($_GET['from_date']) ? $_GET['from_date'] : date('01/m/Y');
  $to = isset($_GET['to_date']) ? $_GET['to_date'] : date('t/m/Y');
  $from_time = quan_ly_tai_chinh_parse_date($from, TRUE);
  $to_time = quan_ly_tai_chinh_parse_date($to, FALSE);
  return array('from_date' => $from, 'to_date' => $to, 'from_time' => $from_time, 'to_time' => $to_time);
}

function quan_ly_tai_chinh_render_date_filter($action, array $filters, $include_type = FALSE) {
  return array('action' => $action, 'filters' => $filters, 'include_type' => $include_type);
}

/**
 * Helper dữ liệu hiển thị.
 */
function quan_ly_tai_chinh_loai_quy_options() {
  return array('tien_mat' => 'Tiền mặt', 'ngan_hang' => 'Ngân hàng', 'vi_noi_bo' => 'Ví nội bộ');
}
function quan_ly_tai_chinh_loai_quy_label($key) { $o = quan_ly_tai_chinh_loai_quy_options(); return isset($o[$key]) ? $o[$key] : $key; }

function quan_ly_tai_chinh_loai_giao_dich_options() {
  return array(
    'thu' => 'Thu',
    'chi' => 'Chi',
    'chuyen_quy' => 'Chuyển quỹ nội bộ',
    'tam_ung_lai_xe' => 'Tạm ứng lái xe',
    'khau_tru_tam_ung_luong' => 'Khấu trừ tạm ứng lương',
  );
}
function quan_ly_tai_chinh_loai_giao_dich_label($key) { $o = quan_ly_tai_chinh_loai_giao_dich_options(); return isset($o[$key]) ? $o[$key] : $key; }

function quan_ly_tai_chinh_nhom_giao_dich_options() {
  return array(
    'cong_no_khach_hang' => 'Thu công nợ khách hàng',
    'chi_phi_co_dinh' => 'Chi phí cố định',
    'luong' => 'Chi phí lương',
    'tam_ung_lai_xe' => 'Tạm ứng lái xe',
    'nha_cung_cap_xe_ngoai' => 'Chi nhà cung cấp / xe ngoài',
    'cuoc_vo' => 'Cược vỏ hàng nhập',
    'noi_bo' => 'Nội bộ',
    'khac' => 'Khác',
  );
}
function quan_ly_tai_chinh_nhom_giao_dich_label($key) { $o = quan_ly_tai_chinh_nhom_giao_dich_options(); return isset($o[$key]) ? $o[$key] : $key; }

function quan_ly_tai_chinh_object_text($gd) {
  $parts = array();
  if (!empty($gd->lai_xe_nid)) { $parts[] = 'LX #' . intval($gd->lai_xe_nid) . quan_ly_tai_chinh_node_title_suffix($gd->lai_xe_nid); }
  if (!empty($gd->luong_lai_xe_nid)) { $parts[] = 'Lương #' . intval($gd->luong_lai_xe_nid); }
  if (!empty($gd->khach_hang_nid)) { $parts[] = 'KH #' . intval($gd->khach_hang_nid) . quan_ly_tai_chinh_node_title_suffix($gd->khach_hang_nid); }
  if (!empty($gd->nha_cung_cap_nid)) { $parts[] = 'NCC #' . intval($gd->nha_cung_cap_nid) . quan_ly_tai_chinh_node_title_suffix($gd->nha_cung_cap_nid); }
  if (!empty($gd->chuyen_xe_nid)) { $parts[] = 'CX #' . intval($gd->chuyen_xe_nid); }
  return implode(' / ', $parts);
}

function quan_ly_tai_chinh_node_title_suffix($nid) {
  $node = node_load(intval($nid));
  return ($node && is_object($node)) ? ' - ' . $node->title : '';
}

function quan_ly_tai_chinh_node_options($type) {
  $options = array();
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')->entityCondition('bundle', $type)->propertyOrderBy('title', 'ASC')->range(0, 500);
  $result = $query->execute();
  if (!empty($result['node'])) {
    $nodes = node_load_multiple(array_keys($result['node']));
    foreach ($nodes as $node) {
      $options[$node->nid] = $node->title;
    }
  }
  return $options;
}

/**
 * Helper ngày/tháng.
 */
function quan_ly_tai_chinh_parse_date($value, $start_day = TRUE) {
  $value = trim($value);
  if (preg_match('/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/', $value, $m)) {
    return mktime($start_day ? 0 : 23, $start_day ? 0 : 59, $start_day ? 0 : 59, intval($m[2]), intval($m[1]), intval($m[3]));
  }
  $ts = strtotime($value);
  if ($ts) {
    return $start_day ? strtotime(date('Y-m-d 00:00:00', $ts)) : strtotime(date('Y-m-d 23:59:59', $ts));
  }
  return $start_day ? strtotime(date('Y-m-01 00:00:00')) : strtotime(date('Y-m-t 23:59:59'));
}

function quan_ly_tai_chinh_month_start_time($thang_luong) {
  $year = intval(substr($thang_luong, 0, 4));
  $month = intval(substr($thang_luong, 4, 2));
  if ($year <= 0 || $month <= 0) { $year = intval(date('Y')); $month = intval(date('n')); }
  return mktime(0, 0, 0, $month, 1, $year);
}

function quan_ly_tai_chinh_month_end_time($thang_luong) {
  $start = quan_ly_tai_chinh_month_start_time($thang_luong);
  return strtotime(date('Y-m-t 23:59:59', $start));
}

function quan_ly_tai_chinh_generate_code($prefix) {
  return $prefix . date('ymdHis') . mt_rand(10, 99);
}

/**
 * Field/json helpers.
 */
function quan_ly_tai_chinh_field_value($node, $field_name, $column = 'value') {
  if ($node && is_object($node) && isset($node->{$field_name}['und'][0][$column])) {
    return $node->{$field_name}['und'][0][$column];
  }
  return '';
}

function quan_ly_tai_chinh_field_target_id($node, $field_name) {
  if ($node && is_object($node) && isset($node->{$field_name}['und'][0]['target_id'])) {
    return intval($node->{$field_name}['und'][0]['target_id']);
  }
  return 0;
}

function quan_ly_tai_chinh_json_decode($value) {
  $data = json_decode($value, TRUE);
  return is_array($data) ? $data : array();
}

function quan_ly_tai_chinh_money_to_number($value) {
  if (is_numeric($value)) { return floatval($value); }
  $value = trim((string) $value);
  if ($value === '') { return 0; }
  $is_negative = strpos($value, '-') === 0;
  $value = preg_replace('/[^0-9]/', '', $value);
  if ($value === '') { return 0; }
  $number = floatval($value);
  return $is_negative ? -$number : $number;
}

function quan_ly_tai_chinh_format_money($value) {
  return number_format(round(quan_ly_tai_chinh_money_to_number($value)), 0, ',', '.');
}
