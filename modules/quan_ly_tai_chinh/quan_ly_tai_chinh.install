/**
 * Bổ sung cột field_hoat_dong cho bảng qltc_quy cũ nếu bảng này còn tồn tại.
 */
function quan_ly_tai_chinh_update_7101() {
  if (!db_table_exists('qltc_quy')) {
    return;
  }

  if (!db_field_exists('qltc_quy', 'field_hoat_dong')) {
    db_add_field('qltc_quy', 'field_hoat_dong', array(
      'type' => 'int',
      'not null' => TRUE,
      'default' => 1,
      'description' => '1 = quỹ đang tồn tại, 0 = quỹ đã bị xóa mềm.',
    ));
  }

  if (!db_index_exists('qltc_quy', 'field_hoat_dong')) {
    db_add_index('qltc_quy', 'field_hoat_dong', array('field_hoat_dong'));
  }

  db_update('qltc_quy')
    ->expression('field_hoat_dong', 'CASE WHEN status = 0 THEN 0 ELSE 1 END')
    ->execute();

  db_update('qltc_quy')
    ->fields(array('status' => 0))
    ->execute();
}

/**
 * Legacy update cũ, nay chỉ đảm bảo bảng quỹ tồn tại.
 */
function quan_ly_tai_chinh_update_7102() {
  module_load_include('module', 'quan_ly_tai_chinh');
  if (function_exists('quan_ly_tai_chinh_ensure_quy_table')) {
    quan_ly_tai_chinh_ensure_quy_table();
  }
}

/**
 * Rebuild lại số dư quỹ từ schema phiếu thu chi.
 */
function quan_ly_tai_chinh_update_7103() {
  module_load_include('module', 'quan_ly_tai_chinh');
  if (function_exists('quan_ly_tai_chinh_ensure_quy_table')) {
    quan_ly_tai_chinh_ensure_quy_table();
  }

  $count = 0;
  if (function_exists('quan_ly_tai_chinh_quy_get_all') && function_exists('quan_ly_tai_chinh_rebuild_quy_balance')) {
    foreach (quan_ly_tai_chinh_quy_get_all(FALSE) as $quy) {
      quan_ly_tai_chinh_rebuild_quy_balance($quy->nid_quy);
      $count++;
    }
  }

  return 'Đã rebuild số dư hiện tại cho ' . intval($count) . ' quỹ tài chính từ schema qltc_quy/qltc_phieu_thu_chi.';
}


/**
 * Tạo bảng sổ cái quỹ, đồng bộ dữ liệu hiện có và rebuild số dư quỹ.
 */
function quan_ly_tai_chinh_update_7104() {
  module_load_include('module', 'quan_ly_tai_chinh');

  if (function_exists('quan_ly_tai_chinh_ensure_so_cai_quy_table')) {
    quan_ly_tai_chinh_ensure_so_cai_quy_table();
  }

  $synced_phieu = 0;
  if (function_exists('quan_ly_tai_chinh_sync_all_phieu_thu_chi_to_so_cai')) {
    $synced_phieu = quan_ly_tai_chinh_sync_all_phieu_thu_chi_to_so_cai();
  }

  $synced_gd = 0;
  if (function_exists('quan_ly_tai_chinh_sync_all_giao_dich_to_so_cai')) {
    $synced_gd = quan_ly_tai_chinh_sync_all_giao_dich_to_so_cai();
  }

  $rebuilt = 0;
  if (function_exists('quan_ly_tai_chinh_quy_get_all') && function_exists('quan_ly_tai_chinh_rebuild_quy_balance')) {
    foreach (quan_ly_tai_chinh_quy_get_all(FALSE) as $quy) {
      quan_ly_tai_chinh_rebuild_quy_balance($quy->nid_quy, FALSE);
      $rebuilt++;
    }
  }

  return 'Đã tạo sổ cái quỹ, đồng bộ ' . intval($synced_phieu) . ' phiếu thu chi, ' . intval($synced_gd) . ' giao dịch cũ và rebuild ' . intval($rebuilt) . ' quỹ.';
}

/**
 * Đổi tên field khoá ngoại theo quy tắc nid_<entity> (VD: quy_id -> nid_quy, quy_nid -> nid_quy).
 */
function quan_ly_tai_chinh_update_7105() {
  $spec = array('type' => 'int', 'not null' => TRUE, 'default' => 0);

  $renames = array(
    'qltc_giao_dich' => array(
      'quy_id' => 'nid_quy',
      'quy_nhan_id' => 'nid_quy_nhan',
      'lai_xe_nid' => 'nid_lai_xe',
      'luong_lai_xe_nid' => 'nid_luong_lai_xe',
      'khach_hang_nid' => 'nid_khach_hang',
      'nha_cung_cap_nid' => 'nid_nha_cung_cap',
      'chuyen_xe_nid' => 'nid_chuyen_xe',
      'ref_id' => 'nid_ref',
    ),
    'qltc_so_cai_quy' => array(
      'quy_nid' => 'nid_quy',
      'phieu_nid' => 'nid_phieu',
    ),
  );

  $indexes = array(
    'qltc_giao_dich' => array(
      'nid_quy' => array('nid_quy'),
      'nid_quy_nhan' => array('nid_quy_nhan'),
      'nid_lai_xe' => array('nid_lai_xe'),
      'nid_luong_lai_xe' => array('nid_luong_lai_xe'),
    ),
    'qltc_so_cai_quy' => array(
      'nid_quy' => array('nid_quy'),
    ),
  );

  $renamed = 0;
  foreach ($renames as $table => $fields) {
    if (!db_table_exists($table)) {
      continue;
    }
    foreach ($fields as $old => $new) {
      if (db_field_exists($table, $old) && !db_field_exists($table, $new)) {
        db_change_field($table, $old, $new, $spec);
        $renamed++;
      }
    }
  }

  foreach ($indexes as $table => $defs) {
    if (!db_table_exists($table)) {
      continue;
    }
    foreach ($defs as $name => $columns) {
      if (!db_index_exists($table, $name)) {
        db_add_index($table, $name, $columns);
      }
    }
  }

  return 'Đã đổi tên ' . intval($renamed) . ' cột của bảng qltc_giao_dich / qltc_so_cai_quy theo quy tắc nid_<entity>.';
}

/**
 * Thêm người quản lý quỹ.
 */
function quan_ly_tai_chinh_update_7106() {
  if (!db_table_exists('qltc_quy')) {
    return 'Bảng qltc_quy chưa tồn tại.';
  }

  if (!db_field_exists('qltc_quy', 'uid_nguoi_quan_ly')) {
    db_add_field('qltc_quy', 'uid_nguoi_quan_ly', array(
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'UID người quản lý quỹ hiện tại.',
    ));
  }

  if (!db_index_exists('qltc_quy', 'uid_nguoi_quan_ly')) {
    db_add_index('qltc_quy', 'uid_nguoi_quan_ly', array('uid_nguoi_quan_ly'));
  }

  return 'Đã thêm uid_nguoi_quan_ly cho quỹ.';
}
