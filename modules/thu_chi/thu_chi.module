    'page arguments' => array(2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['thu-chi/ajax-approve/%'] = array(
    'title' => 'Duyệt phiếu thu chi AJAX',
    'page callback' => 'thu_chi_ajax_approve',
    'page arguments' => array(2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['thu-chi/ajax-request-adjust/%'] = array(
    'title' => 'Yêu cầu điều chỉnh phiếu thu chi AJAX',
    'page callback' => 'thu_chi_ajax_request_adjust',
    'page arguments' => array(2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['thu-chi/ajax-approve-adjust/%'] = array(
    'title' => 'Duyệt điều chỉnh phiếu thu chi AJAX',
    'page callback' => 'thu_chi_ajax_approve_adjust',
    'page arguments' => array(2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['thu-chi/ajax-category-search'] = array(
