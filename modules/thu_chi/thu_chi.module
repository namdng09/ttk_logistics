  $items['thu-chi/ajax-form/%'] = array(
    'title' => 'Form sửa phiếu thu chi AJAX',
    'page callback' => 'thu_chi_ajax_form',
    'page arguments' => array(2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['thu-chi/ajax-save'] = array(
    'title' => 'Lưu phiếu thu chi AJAX',
    'page callback' => 'thu_chi_ajax_save',
