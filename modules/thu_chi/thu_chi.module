<?php

/**
 * @file
 * Module Thu chi riêng: quản lý phiếu thu / phiếu chi bằng content type node.
 *
 * Dữ liệu phiếu thu chi lưu trong content type phieu_thu_chi:
 * - title: mã phiếu, đóng vai trò như khóa chính nghiệp vụ.
 * - field_thong_tin_json: các thông tin dạng text/phụ như loại phiếu, phân loại và chi tiết phiếu.
 * - các thông tin số / liên kết lưu thành field riêng để dễ lọc, tính toán.
 */

