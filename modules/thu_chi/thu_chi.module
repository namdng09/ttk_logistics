  );

  $items['thu-chi/sua/%'] = array(
    'title' => 'Sửa phiếu thu chi',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('thu_chi_giao_dich_form', 2),
    'access callback' => 'thu_chi_access',
    'type' => MENU_CALLBACK,
  );

  $items['thu-chi/xoa/%'] = array(
