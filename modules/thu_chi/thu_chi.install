/**
 * Update legacy: đồng bộ trạng thái duyệt mặc định trên schema.
 */
function thu_chi_update_7206() {
  thu_chi_ensure_content_type();
  $count = 0;
  if (db_table_exists('qltc_phieu_thu_chi')) {
    $count = db_update('qltc_phieu_thu_chi')
      ->fields(array('duyet_status' => 'cho_duyet'))
      ->isNull('duyet_status')
      ->execute();
  }
  menu_rebuild();
  return 'Đã đồng bộ trạng thái duyệt mặc định cho ' . intval($count) . ' phiếu schema.';
}

