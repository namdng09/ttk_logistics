<?php

/**
 * @file
 * Cài đặt cho module Thu chi.
 */

/**
 * Implements hook_schema().
 */
function thu_chi_schema() {
  $schema = array();

  $schema['qltc_phieu_thu_chi'] = array(
    'description' => 'Phieu thu chi luu bang schema thuong, khong dung content type.',
    'fields' => array(
      'nid' => array('type' => 'serial', 'not null' => TRUE),
      'ma_giao_dich' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'loai_phieu' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'thu'),
      'nhom_giao_dich' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => 'khac'),
      'nid_quy' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'nid_quy_nhan' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'so_tien' => array('type' => 'numeric', 'precision' => 18, 'scale' => 2, 'not null' => TRUE, 'default' => 0),
      'ngay_giao_dich' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'thang_luong' => array('type' => 'varchar', 'length' => 6, 'not null' => TRUE, 'default' => ''),
      'nid_khach_hang' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'nid_nha_cung_cap' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'nid_chuyen_xe' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'uid_nguoi_de_xuat' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'ref_type' => array('type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''),
      'nid_ref' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'loai_giao_dich_json' => array('type' => 'text', 'not null' => FALSE),
      'chi_tiet_json' => array('type' => 'text', 'not null' => FALSE),
      'thong_tin_json' => array('type' => 'text', 'not null' => FALSE),
      'duyet_status' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'cho_duyet'),
      'dong_phieu' => array('type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0),
      'hoat_dong' => array('type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1),
      'uid' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'status' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'created' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
      'changed' => array('type' => 'int', 'not null' => TRUE, 'default' => 0),
    ),
    'primary key' => array('nid'),
    'unique keys' => array(
      'ma_giao_dich' => array('ma_giao_dich'),
    ),
    'indexes' => array(
      'loai_phieu' => array('loai_phieu'),
      'duyet_status' => array('duyet_status'),
      'nid_quy' => array('nid_quy'),
      'nid_quy_nhan' => array('nid_quy_nhan'),
      'ngay_giao_dich' => array('ngay_giao_dich'),
      'hoat_dong' => array('hoat_dong'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 */
function thu_chi_install() {
  thu_chi_ensure_content_type();
  thu_chi_ensure_chuyen_xe_dong_field();
  thu_chi_set_default_dong_chuyen_xe_values();
}

