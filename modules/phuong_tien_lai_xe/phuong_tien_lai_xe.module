<?php

// Tiện ích dùng chung (khuôn phản hồi, xác thực bằng token, phân trang): module api_common. Nạp thẳng file khi module chưa bật để
// API không hỏng nếu quên bật (bật module vẫn cần để xác thực bằng token hoạt động ở hook_init).
if (!function_exists('api_response_success')) {
  require_once dirname(__FILE__) . '/../api_common/api_common.module';
}

/**
 * @file
 * Phương Tiện - Lái Xe — Gán tài xế cho xe. Custom schema, RESTful API.
 */

/**
 * Implements hook_permission().
 */
function phuong_tien_lai_xe_permission() {
  return array(
    'ptlx_view' => array('title' => t('Xem quan hệ PT-LX'), 'entry' => array('GET /api/phuong-tien-lai-xe', 'GET /api/phuong-tien-lai-xe/{id}')),
    'ptlx_create' => array('title' => t('Gán/sửa lái xe cho phương tiện'), 'entry' => array('/phuong-tien (Chọn lái xe)', 'POST /api/phuong-tien-lai-xe', 'PUT /api/phuong-tien-lai-xe/{id}')),
    'ptlx_delete' => array('title' => t('Bỏ gán lái xe khỏi phương tiện'), 'entry' => array('/phuong-tien (Chọn lái xe → để trống)', 'POST /api/phuong-tien-lai-xe (nid_lai_xe = 0)', 'DELETE /api/phuong-tien-lai-xe/{id}')),
  );
}

/**
 * Implements hook_init() — CORS for API routes.
 */
function phuong_tien_lai_xe_init() {
  $path = current_path();
  if (strpos($path, 'api/phuong-tien-lai-xe') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function phuong_tien_lai_xe_menu() {
  $items = array();

  $items['api/phuong-tien-lai-xe'] = array(
    'page callback' => 'ptlx_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/phuong-tien-lai-xe/%'] = array(
    'page callback' => 'ptlx_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  return $items;
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _ptlx_input() {
  return api_request_input();
}

function _ptlx_success($data = NULL) {
  return api_response_success($data);
}

function _ptlx_fail($message) {
  return api_response_fail($message);
}

function _ptlx_unauthorized($message) {
  return api_response_denied($message);
}

function _ptlx_not_found($message) {
  return api_response_not_found($message);
}

function _ptlx_error($message) {
  return api_response_error($message);
}

function _ptlx_method_not_allowed($allowed) {
  return api_response_method_not_allowed($allowed);
}

/*******************************************************************************
 * REST: COLLECTION — GET /api/phuong-tien-lai-xe, POST /api/phuong-tien-lai-xe
 ******************************************************************************/

function ptlx_rest_collection() {
  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ptlx_rest_list();
    case 'POST':
      return _ptlx_rest_create();
    default:
      return _ptlx_method_not_allowed('GET, POST');
  }
}

/**
 * Đọc quan hệ phương tiện – lái xe: ptlx_view, hoặc phuong_tien_view (danh sách phương tiện vốn đã hiện lái xe đang gán).
 */
function _ptlx_can_read() {
  return api_has_permission('ptlx_view') || api_has_permission('phuong_tien_view');
}

function _ptlx_rest_list() {
  if (!_ptlx_can_read()) {
    return _ptlx_unauthorized('Bạn không có quyền xem lái xe của phương tiện');
  }
  $params = array_merge($_GET, array());

  $page = isset($params['page']) ? max(1, (int) $params['page']) : 1;
  $limit = isset($params['limit']) ? max(1, min(100, (int) $params['limit'])) : 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('phuong_tien_lai_xe', 'ptlx');
  $query->fields('ptlx');

  // Filter by nid_phuong_tien (required for this module's use case)
  if (!empty($params['nid_phuong_tien'])) {
    $query->condition('ptlx.nid_phuong_tien', (int) $params['nid_phuong_tien']);
  }

  // By default only show active records; include_inactive=1 to show all
  $include_inactive = !empty($params['include_inactive']);
  if (!$include_inactive) {
    $query->condition('ptlx.hoat_dong', 1);
  }

  // Count total
  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('ptlx.id', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  // Join names
  foreach ($rows as &$row) {
    $row->ten_phuong_tien = _ptlx_get_bks($row->nid_phuong_tien);
    $lx_info = _ptlx_get_lai_xe_info($row->nid_lai_xe);
    $row->ten_lai_xe = $lx_info['ten'];
    $row->lai_xe_sdt = $lx_info['sdt'];
  }
  unset($row);

  $total_pages = (int) ceil($total / $limit);

  return _ptlx_success(array(
    'items' => $rows ?: array(),
    'total' => (int) $total,
    'current_page' => $total_pages > 0 ? $page : 0,
    'total_pages' => $total_pages,
    'limit' => $limit,
  ));
}

function _ptlx_get_bks($nid) {
  if (!$nid) return '';
  $bks = db_query("SELECT bks FROM {phuong_tien} WHERE nid = :nid", array(':nid' => $nid))->fetchField();
  return $bks !== FALSE ? $bks : '';
}

function _ptlx_get_lai_xe_name($nid) {
  if (!$nid) return '';
  $name = db_query("SELECT ten FROM {lai_xe} WHERE nid = :nid", array(':nid' => $nid))->fetchField();
  return $name !== FALSE ? $name : '';
}

function _ptlx_get_lai_xe_info($nid) {
  if (!$nid) return array('ten' => '', 'sdt' => '');
  $row = db_query("SELECT ten, sdt FROM {lai_xe} WHERE nid = :nid", array(':nid' => $nid))->fetch();
  if (!$row) return array('ten' => '', 'sdt' => '');
  return array('ten' => $row->ten, 'sdt' => $row->sdt);
}

/**
 * Deactivate all active records for a given vehicle.
 */
function _ptlx_deactivate_old($nid_phuong_tien, $exclude_id = 0) {
  $query = db_update('phuong_tien_lai_xe');
  $query->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)));
  $query->condition('nid_phuong_tien', (int) $nid_phuong_tien);
  $query->condition('hoat_dong', 1);
  if ($exclude_id > 0) {
    $query->condition('id', (int) $exclude_id, '!=');
  }
  $query->execute();
}

function _ptlx_rest_create() {
  if (!api_has_permission('ptlx_create')) {
    return _ptlx_unauthorized('Bạn không có quyền gán lái xe');
  }

  $input = _ptlx_input();
  $nid_pt = isset($input['nid_phuong_tien']) ? (int) $input['nid_phuong_tien'] : 0;
  $nid_lx = isset($input['nid_lai_xe']) ? (int) $input['nid_lai_xe'] : 0;

  if ($nid_pt <= 0) {
    return _ptlx_fail('Phương tiện là bắt buộc');
  }
  // Validate exists
  $pt_exists = db_query("SELECT nid FROM {phuong_tien} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $nid_pt))->fetchField();
  if (!$pt_exists) {
    return _ptlx_fail('Phương tiện không tồn tại hoặc đã bị xoá');
  }

  // Cho phép gửi lái xe rỗng để bỏ gán lái xe hiện tại — đây là xoá quan hệ nên cần thêm ptlx_delete.
  if ($nid_lx <= 0) {
    if (!api_has_permission('ptlx_delete')) {
      return _ptlx_unauthorized('Bạn không có quyền bỏ gán lái xe khỏi phương tiện');
    }
    $transaction = db_transaction();
    try {
      _ptlx_deactivate_old($nid_pt);
      return _ptlx_success(array(
        'nid_phuong_tien' => $nid_pt,
        'nid_lai_xe' => 0,
        'cleared' => TRUE,
      ));
    }
    catch (Exception $e) {
      $transaction->rollback();
      watchdog('phuong_tien_lai_xe', 'Lỗi bỏ gán lái xe: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
      return _ptlx_error('Lỗi hệ thống khi bỏ gán lái xe');
    }
  }

  $lx_exists = db_query("SELECT nid FROM {lai_xe} WHERE nid = :nid AND hoat_dong = 1", array(':nid' => $nid_lx))->fetchField();
  if (!$lx_exists) {
    return _ptlx_fail('Lái xe không tồn tại hoặc đã bị xoá');
  }

  $transaction = db_transaction();
  try {
    // Deactivate old assignment for this vehicle
    _ptlx_deactivate_old($nid_pt);

    $now = date('Y-m-d H:i:s', REQUEST_TIME);
    $id = db_insert('phuong_tien_lai_xe')
      ->fields(array(
        'nid_phuong_tien' => $nid_pt,
        'nid_lai_xe' => $nid_lx,
        'hoat_dong' => 1,
        'created' => $now,
        'changed' => $now,
      ))
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien_lai_xe} WHERE id = :id", array(':id' => $id))->fetch();
    $row->ten_phuong_tien = _ptlx_get_bks($nid_pt);
    $row->ten_lai_xe = _ptlx_get_lai_xe_name($nid_lx);

    watchdog('phuong_tien_lai_xe', 'Gán lái xe #%lx cho phương tiện #%pt', array(
      '%lx' => $nid_lx, '%pt' => $nid_pt,
    ));

    return _ptlx_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien_lai_xe', 'Lỗi gán lái xe: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ptlx_error('Lỗi hệ thống khi gán lái xe');
  }
}

/*******************************************************************************
 * REST: ITEM — GET /api/phuong-tien-lai-xe/{id}, PUT, DELETE
 ******************************************************************************/

function ptlx_rest_item($id) {
  $id = (int) $id;
  if (!$id) {
    return _ptlx_fail('ID không hợp lệ');
  }

  switch ($_SERVER['REQUEST_METHOD']) {
    case 'GET':
      return _ptlx_rest_get($id);
    case 'PUT':
      return _ptlx_rest_update($id);
    case 'DELETE':
      return _ptlx_rest_delete($id);
    default:
      return _ptlx_method_not_allowed('GET, PUT, DELETE');
  }
}

function _ptlx_rest_get($id) {
  if (!_ptlx_can_read()) {
    return _ptlx_unauthorized('Bạn không có quyền xem lái xe của phương tiện');
  }
  $row = db_query("SELECT * FROM {phuong_tien_lai_xe} WHERE id = :id", array(':id' => $id))->fetch();
  if (!$row) {
    return _ptlx_not_found('Không tìm thấy bản ghi');
  }
  $row->ten_phuong_tien = _ptlx_get_bks($row->nid_phuong_tien);
  $row->ten_lai_xe = _ptlx_get_lai_xe_name($row->nid_lai_xe);
  return _ptlx_success($row);
}

function _ptlx_rest_update($id) {
  if (!api_has_permission('ptlx_create')) {
    return _ptlx_unauthorized('Bạn không có quyền cập nhật');
  }

  $existing = db_query("SELECT * FROM {phuong_tien_lai_xe} WHERE id = :id", array(':id' => $id))->fetch();
  if (!$existing) {
    return _ptlx_not_found('Không tìm thấy bản ghi');
  }

  $input = _ptlx_input();
  $update = array('changed' => date('Y-m-d H:i:s', REQUEST_TIME));

  if (isset($input['nid_lai_xe'])) {
    $update['nid_lai_xe'] = (int) $input['nid_lai_xe'];
  }
  if (isset($input['nid_phuong_tien'])) {
    $update['nid_phuong_tien'] = (int) $input['nid_phuong_tien'];
  }
  if (isset($input['hoat_dong'])) {
    $update['hoat_dong'] = (int) $input['hoat_dong'];
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien_lai_xe')
      ->fields($update)
      ->condition('id', $id)
      ->execute();

    $row = db_query("SELECT * FROM {phuong_tien_lai_xe} WHERE id = :id", array(':id' => $id))->fetch();
    $row->ten_phuong_tien = _ptlx_get_bks($row->nid_phuong_tien);
    $row->ten_lai_xe = _ptlx_get_lai_xe_name($row->nid_lai_xe);

    watchdog('phuong_tien_lai_xe', 'Cập nhật PT-LX #%id', array('%id' => $id));

    return _ptlx_success($row);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien_lai_xe', 'Lỗi cập nhật PT-LX #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ptlx_error('Lỗi hệ thống khi cập nhật');
  }
}

function _ptlx_rest_delete($id) {
  if (!api_has_permission('ptlx_delete')) {
    return _ptlx_unauthorized('Bạn không có quyền xoá');
  }

  $existing = db_query("SELECT id FROM {phuong_tien_lai_xe} WHERE id = :id", array(':id' => $id))->fetchField();
  if (!$existing) {
    return _ptlx_not_found('Không tìm thấy bản ghi');
  }

  $transaction = db_transaction();
  try {
    db_update('phuong_tien_lai_xe')
      ->fields(array('hoat_dong' => 0, 'changed' => date('Y-m-d H:i:s', REQUEST_TIME)))
      ->condition('id', $id)
      ->execute();

    watchdog('phuong_tien_lai_xe', 'Xoá (soft) PT-LX #%id', array('%id' => $id));

    return _ptlx_success(array('id' => $id, 'deleted' => TRUE));
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('phuong_tien_lai_xe', 'Lỗi xoá PT-LX #%id: @msg', array('%id' => $id, '@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _ptlx_error('Lỗi hệ thống khi xoá');
  }
}
