<?php

// Tiện ích dùng chung (khuôn phản hồi, xác thực bằng token, phân trang): module api_common. Nạp thẳng file khi module chưa bật để
// API không hỏng nếu quên bật (bật module vẫn cần để xác thực bằng token hoạt động ở hook_init).
if (!function_exists('api_response_success')) {
  require_once dirname(__FILE__) . '/../api_common/api_common.module';
}

/**
 * @file
 * Theo dõi đổ dầu — phiếu đổ dầu của đầu kéo tại cây xăng (nhà cung cấp).
 *
 * Luồng (giống luồng của đề nghị thanh toán): tạo phiếu (Chờ duyệt) → "Duyệt" (điều vận) → Chờ duyệt TT → "Duyệt TT" (giám
 * đốc) → Chờ thanh toán. Bấm "Duyệt TT" tự tạo 1 đề nghị thanh toán cho đúng phiếu đó (1 phiếu = 1 đề nghị, không gom),
 * vào thẳng "Chờ thanh toán"; kế toán "Ghi nhận TT" hoặc "Trả lại" ở màn /de-nghi-thanh-toan. Không còn thu hồi sau khi
 * duyệt thanh toán. Trạng thái LƯU ở phiếu chỉ là phần trước thanh toán; sau khi có đề nghị, trạng thái hiển thị
 * (Chờ thanh toán / Đã thanh toán) lấy từ đề nghị được gắn (cột do_dau.nid_de_nghi), không sao chép.
 * _do_dau_display_status() là NƠI DUY NHẤT quyết định trạng thái hiển thị.
 * "Từ chối" (Chờ duyệt TT) hoặc "Trả lại" ở màn đề nghị (Chờ thanh toán, chưa trả tiền) thì phiếu về "Từ chối"
 * (do_dau_on_de_nghi_rejected()).
 *
 * - Tiền tính như ke_hoach_chi_phi: tong_truoc_vat = round(so_lit * don_gia),
 *   tong_sau_vat = round(tong_truoc_vat * (1 + vat_percent / 100)), số nguyên đồng.
 * - Hành động hợp lệ do _do_dau_actions() quyết định; giao diện chỉ hiển thị kết quả server trả về.
 */

/**
 * Implements hook_permission().
 */
function do_dau_permission() {
  return array(
    'do_dau_view_own' => array('title' => t('Xem phiếu đổ dầu của mình'), 'entry' => array('/theo-doi-do-dau', 'GET /api/do-dau')),
    'do_dau_view_all' => array('title' => t('Xem tất cả phiếu đổ dầu'), 'entry' => array('/theo-doi-do-dau', 'GET /api/do-dau')),
    'do_dau_create' => array('title' => t('Tạo/sửa/gửi duyệt/thu hồi phiếu đổ dầu'), 'entry' => array('POST /api/do-dau', 'PUT /api/do-dau/{id}', 'POST /api/do-dau/{id}/gui-duyet|thu-hoi|huy')),
    'do_dau_approve' => array('title' => t('Duyệt/từ chối phiếu đổ dầu'), 'entry' => array('POST /api/do-dau/{id}/duyet|tu-choi')),
    'do_dau_delete' => array('title' => t('Xoá phiếu đổ dầu'), 'entry' => array('DELETE /api/do-dau/{id}')),
  );
}

/**
 * Implements hook_init() — CORS cho route API.
 */
function do_dau_init() {
  $path = current_path();
  if (strpos($path, 'api/do-dau') === 0) {
    drupal_add_http_header('Access-Control-Allow-Origin', '*');
    drupal_add_http_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    drupal_add_http_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
    drupal_add_http_header('Access-Control-Max-Age', '86400');
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      drupal_add_http_header('Status', '204 No Content');
      drupal_exit();
    }
  }
}

/**
 * Implements hook_menu().
 */
function do_dau_menu() {
  $items = array();

  $items['api/do-dau'] = array(
    'page callback' => 'do_dau_rest_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  // Đường dẫn literal nên Drupal ưu tiên khớp trước api/do-dau/%.
  $items['api/do-dau/tuy-chon'] = array(
    'page callback' => 'do_dau_rest_options',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  $items['api/do-dau/%'] = array(
    'page callback' => 'do_dau_rest_item',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );
  // Hành động chuyển trạng thái: POST api/do-dau/{id}/{hanh-dong}.
  $items['api/do-dau/%/%'] = array(
    'page callback' => 'do_dau_rest_action',
    'page arguments' => array(2, 3),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  );

  $items['theo-doi-do-dau'] = array(
    'title' => 'Theo dõi đổ dầu',
    'page callback' => 'do_dau_page_list',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}

/**
 * Implements hook_theme().
 */
function do_dau_theme() {
  $path = drupal_get_path('module', 'do_dau') . '/templates';
  return array(
    'do_dau_list_page' => array(
      'template' => 'do-dau-list',
      'path' => $path,
    ),
  );
}

function do_dau_page_list() {
  if (!_do_dau_can_view_any($GLOBALS['user'])) {
    return api_denied_page('Bạn không có quyền xem phiếu đổ dầu');
  }
  $path = drupal_get_path('module', 'do_dau');
  drupal_add_css($path . '/assets/css/do_dau.css');
  drupal_add_js($path . '/assets/js/do_dau.js');
  drupal_add_js(array('do_dau' => array(
    'permissions' => array(
      'view_own' => api_has_permission('do_dau_view_own'),
      'view_all' => api_has_permission('do_dau_view_all'),
      'create' => api_has_permission('do_dau_create'),
      'approve' => api_has_permission('do_dau_approve'),
      'delete' => api_has_permission('do_dau_delete'),
      'duyet_tt' => api_has_permission('de_nghi_thanh_toan_approve_payment'),
    ),
    'uid' => (int) $GLOBALS['user']->uid,
  )), 'setting');
  return theme('do_dau_list_page');
}

