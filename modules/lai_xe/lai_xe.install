function lai_xe_update_7001() {
  drupal_install_schema('lai_xe');
}

function lai_xe_update_7004() {
  $field = db_query("SHOW COLUMNS FROM {lai_xe} LIKE 'phuong_tien_id'")->fetch();
  if ($field) {
    db_query("ALTER TABLE {lai_xe} CHANGE phuong_tien_id phuong_tien_lai_xe_id INT UNSIGNED");
  }
}

function lai_xe_update_7003() {
  db_update('lai_xe')
    ->fields(array('hoat_dong' => 1))
    ->condition('hoat_dong', 0)
    ->execute();
  db_query("ALTER TABLE {lai_xe} MODIFY COLUMN hoat_dong TINYINT NOT NULL DEFAULT 1");
}
