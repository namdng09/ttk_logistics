/**
 * Implements hook_theme().
 */
function crm_dntt_theme() {
  $path = drupal_get_path('module', 'crm_dntt') . '/templates';
  return array(
    'crm_dntt_form_page' => array(
      'template' => 'crm-dntt-form',
      'path' => $path,
      'variables' => array('dntt_id' => NULL),
    ),
    'crm_dntt_list_page' => array(
      'template' => 'crm-dntt-list',
      'path' => $path,
    ),
  );
}

/*******************************************************************************
 * PAGE CALLBACKS (Issue 04 + 05)
 ******************************************************************************/

function crm_dntt_page_form($dntt_id = NULL) {
  global $user;

  $is_editable = TRUE;
  $trang_thai = 'moi';

  if ($dntt_id) {
    $dntt_id = (int) $dntt_id;
    $entities = entity_load('dntt', array($dntt_id));
    if (empty($entities)) {
      drupal_not_found();
      return;
    }
    $entity = reset($entities);
    // ADR-0003: mọi user đăng nhập xem được mọi DNTT (minh bạch vận hành).
    // Mở readonly khi ngoài scope sửa; không chặn truy cập.
    $trang_thai = $entity->trang_thai;
    $is_editable = crm_dntt_is_editable($trang_thai)
      && crm_dntt_user_can_edit($entity, $user);
  }

  // ADR-0003 / Issue 01: nhận context khi nhập chi phí từ đơn hàng win.
  $lo_hang_nid = isset($_GET['lo_hang_nid']) ? (int) $_GET['lo_hang_nid'] : 0;
  $from = isset($_GET['from']) ? $_GET['from'] : '';

  drupal_add_js(array('crm_dntt' => array(
    'dntt_id' => $dntt_id,
    'is_editable' => $is_editable,
    'trang_thai' => $trang_thai,
    'lo_hang_nid' => $lo_hang_nid,
    'from' => $from,
    'permissions' => array(
      'dntt_create' => user_access('dntt_create'),
      'dntt_approve' => user_access('dntt_approve'),
      'dntt_approve_payment' => user_access('dntt_approve_payment'),
      'dntt_pay' => user_access('dntt_pay'),
    ),
  )), 'setting');

  return theme('crm_dntt_form_page', array('dntt_id' => $dntt_id));
}

function crm_dntt_page_list() {
  global $user;

  drupal_add_js(array('crm_dntt' => array(
    'permissions' => array(
      'dntt_create' => user_access('dntt_create'),
      'dntt_view_own' => user_access('dntt_view_own'),
      'dntt_view_all' => user_access('dntt_view_all'),
      'dntt_approve' => user_access('dntt_approve'),
      'dntt_approve_payment' => user_access('dntt_approve_payment'),
      'dntt_pay' => user_access('dntt_pay'),
    ),
  )), 'setting');

  return theme('crm_dntt_list_page');
}

/*******************************************************************************
 * DNTT ENTITY CONTROLLER
 ******************************************************************************/

class DnttController extends EntityAPIController {

  public function delete($ids, DatabaseTransaction $transaction = NULL) {
    if (!empty($ids)) {
      db_delete('dntt_chi_tiet')
        ->condition('dntt_id', $ids, 'IN')
        ->execute();
    }
    parent::delete($ids, $transaction);
  }
}

/*******************************************************************************
 * HELPERS
 ******************************************************************************/

function _crm_dntt_json_error($message, $code = 400) {
  return array('success' => FALSE, 'message' => $message);
}

function _crm_dntt_input() {
  return json_decode(file_get_contents('php://input'), TRUE) ?: array();
}

/**
 * Resolve DNTT visibility scope using the same role model as views_query_modifier.
 *
 * @return array|false
 *   FALSE means unrestricted. Otherwise an array of user IDs allowed to view.
 */
function crm_dntt_visible_uids_for_account($account = NULL) {
  if (!$account) {
    global $user;
    $account = $user;
  }

  if (empty($account->uid)) {
    return array();
  }

  if ((int) $account->uid === 1) {
    return FALSE;
  }

  $roles = isset($account->roles) ? $account->roles : array();

  // Giám đốc (rid=10) xem tất cả.
  if (isset($roles[10])) {
    return FALSE;
  }

  // Trưởng nhóm/phòng (rid=9): xem DNTT của mình và thành viên thuộc nhóm mình.
  if (isset($roles[9])) {
    $visible_uids = array((int) $account->uid);
    $loaded = user_load($account->uid);
    $nhom_ids = array();
    if ($loaded && !empty($loaded->field_nhom_sale[LANGUAGE_NONE])) {
      foreach ($loaded->field_nhom_sale[LANGUAGE_NONE] as $item) {
        if (!empty($item['target_id'])) {
          $nhom_ids[] = (int) $item['target_id'];
        }
      }
    }

    if (!empty($nhom_ids)) {
      $member_uids = db_select('field_data_field_nhom_sale', 'fns')
        ->fields('fns', array('entity_id'))
        ->condition('fns.entity_type', 'user')
        ->condition('fns.field_nhom_sale_target_id', $nhom_ids, 'IN')
        ->execute()
        ->fetchCol();
      foreach ($member_uids as $uid) {
        $visible_uids[] = (int) $uid;
      }
    }

    return array_values(array_unique($visible_uids));
  }

  // Nhân viên/default: chỉ xem DNTT của mình.
  return array((int) $account->uid);
}

function crm_dntt_apply_uid_visibility(&$query, $alias = 'd', $account = NULL) {
  $visible_uids = crm_dntt_visible_uids_for_account($account);
  if ($visible_uids === FALSE) {
    return;
  }
  if (empty($visible_uids)) {
    $query->where('1 = 0');
    return;
  }
  $query->condition($alias . '.uid', $visible_uids, 'IN');
}

function crm_dntt_user_can_view($dntt, $account = NULL) {
  if (!$dntt) {
    return FALSE;
  }
  $visible_uids = crm_dntt_visible_uids_for_account($account);
  if ($visible_uids === FALSE) {
    return TRUE;
  }
  return in_array((int) $dntt->uid, $visible_uids);
}

/**
 * Whether $account may EDIT (sửa/xóa/trình duyệt) a DNTT.
 *
 * ADR-0003: mọi user đăng nhập được XEM mọi DNTT (minh bạch vận hành), nhưng
 * quyền SỬA vẫn gate theo scope phân quyền — dùng đúng resolver visibility.
 */
function crm_dntt_user_can_edit($dntt, $account = NULL) {
  if (!$dntt) {
    return FALSE;
  }
  $visible_uids = crm_dntt_visible_uids_for_account($account);
  if ($visible_uids === FALSE) {
    return TRUE;
  }
  return in_array((int) $dntt->uid, $visible_uids);
}

/**
 * Auto-gen số DNTT: DNTT-{YYYYMMDD}-{STT}, STT reset theo ngày.
 */
function crm_dntt_generate_so_dntt() {
  $today = date('Ymd');
  $prefix = 'DNTT-' . $today . '-';

  $transaction = db_transaction();
  try {
    $max = db_query(
      "SELECT MAX(so_dntt) FROM {dntt} WHERE so_dntt LIKE :prefix",
      array(':prefix' => $prefix . '%')
    )->fetchField();

    if ($max) {
      $last_stt = (int) substr($max, -5);
      $stt = $last_stt + 1;
    }
    else {
      $stt = 1;
    }

    return $prefix . str_pad($stt, 5, '0', STR_PAD_LEFT);
  }
  catch (Exception $e) {
    $transaction->rollback();
    throw $e;
  }
}

/**
 * Auto-gen số Lô DNTT: LO-{YYYYMMDD}-{STT}, STT reset theo ngày.
 */
function crm_dntt_generate_so_lo() {
  $today = date('Ymd');
  $prefix = 'LO-' . $today . '-';

  $max = db_query(
    "SELECT MAX(so_lo) FROM {lo_dntt} WHERE so_lo LIKE :prefix",
    array(':prefix' => $prefix . '%')
  )->fetchField();

  if ($max) {
    $last_stt = (int) substr($max, -3);
    $stt = $last_stt + 1;
  }
  else {
    $stt = 1;
  }

  return $prefix . str_pad($stt, 3, '0', STR_PAD_LEFT);
}

/**
 * Recalculate dntt.tong_tien from SUM of chi tiết.
 */
function crm_dntt_recalculate_chi_tiet_converted($dntt_id) {
  $dntt_list = entity_load('dntt', array($dntt_id));
  if (empty($dntt_list)) {
    return 0;
  }
  $dntt = reset($dntt_list);
  $rate = isset($dntt->ti_gia) ? (float) $dntt->ti_gia : 1;

  $rows = db_query(
    "SELECT * FROM {dntt_chi_tiet} WHERE dntt_id = :id ORDER BY thu_tu, chi_tiet_id",
    array(':id' => $dntt_id)
  )->fetchAll();

  foreach ($rows as $row) {
    $calc = crm_dntt_calculate_chi_tiet(array(
      'don_gia' => isset($row->don_gia) ? $row->don_gia : 0,
      'loai_tien' => isset($row->loai_tien) ? $row->loai_tien : 'VND',
      'so_luong' => $row->so_luong,
      'vat_phan_tram' => $row->vat_phan_tram,
      'so_tien_vat' => $row->so_tien_vat,
    ), $rate);

    db_update('dntt_chi_tiet')
      ->fields(array(
        'tien_truoc_vat' => $calc['tien_truoc_vat'],
        'so_tien_vat' => $calc['so_tien_vat'],
        'tien_sau_vat' => $calc['tien_sau_vat'],
        'tien_sau_vat_vnd' => $calc['tien_sau_vat_vnd'],
      ))
      ->condition('chi_tiet_id', $row->chi_tiet_id)
      ->execute();
    entity_get_controller('dntt_chi_tiet')->resetCache(array($row->chi_tiet_id));
  }

  return crm_dntt_recalculate_tong_tien($dntt_id);
}

function crm_dntt_recalculate_lo_dntt_tong_tien($lo_dntt_id) {
  $total = db_query(
    "SELECT COALESCE(SUM(tong_tien), 0) FROM {dntt} WHERE lo_dntt_id = :id",
    array(':id' => $lo_dntt_id)
  )->fetchField();

  db_update('lo_dntt')
    ->fields(array('tong_tien' => $total))
    ->condition('lo_dntt_id', $lo_dntt_id)
    ->execute();
  entity_get_controller('lo_dntt')->resetCache(array($lo_dntt_id));

  return $total;
}


function crm_dntt_recalculate_tong_tien($dntt_id) {
  $total = db_query(
    "SELECT COALESCE(SUM(CASE WHEN tien_sau_vat_vnd > 0 THEN tien_sau_vat_vnd ELSE tien_sau_vat END), 0) FROM {dntt_chi_tiet} WHERE dntt_id = :id",
    array(':id' => $dntt_id)
  )->fetchField();

  db_update('dntt')
    ->fields(array('tong_tien' => $total, 'changed' => REQUEST_TIME))
    ->condition('dntt_id', $dntt_id)
    ->execute();

  entity_get_controller('dntt')->resetCache(array($dntt_id));

  return $total;
}

/**
 * Auto-calculate chi tiết amounts.
 *
 * @param array $values
 *   Input values (don_gia, so_luong, vat_phan_tram, optional so_tien_vat).
 *
 * @return array
 *   Computed values: tien_truoc_vat, so_tien_vat, tien_sau_vat.
 */
function crm_dntt_validate_chi_tiet_currency_price(array $values, $ti_gia = 1) {
  $don_gia = isset($values['don_gia']) ? (float) $values['don_gia'] : 0;
  $loai_tien = isset($values['loai_tien']) ? strtoupper((string) $values['loai_tien']) : '';

  if ($don_gia <= 0) {
    return array('success' => FALSE, 'message' => 'Đơn giá bắt buộc và phải lớn hơn 0.');
  }
  if (!in_array($loai_tien, array('VND', 'USD'))) {
    return array('success' => FALSE, 'message' => 'Loại tiền không hợp lệ.');
  }
  if ($loai_tien === 'USD' && (float) $ti_gia <= 1) {
    return array('success' => FALSE, 'message' => 'Dòng USD cần tỉ giá lớn hơn 1.');
  }

  $so_luong = isset($values['so_luong']) ? (float) $values['so_luong'] : 0;
  if ($so_luong <= 0) {
    return array('success' => FALSE, 'message' => 'Số lượng bắt buộc và phải lớn hơn 0.');
  }

  return array('success' => TRUE);
}

function crm_dntt_calculate_chi_tiet(array $values, $ti_gia = 1) {
  $don_gia = isset($values['don_gia']) ? (float) $values['don_gia'] : 0;
  $loai_tien = isset($values['loai_tien']) ? strtoupper((string) $values['loai_tien']) : 'VND';
  $rate = $loai_tien === 'USD' ? (float) $ti_gia : 1;

  $so_luong = isset($values['so_luong']) ? (float) $values['so_luong'] : 1;
  $vat_pct = isset($values['vat_phan_tram']) ? (float) $values['vat_phan_tram'] : 0;

  $tien_truoc_vat = $don_gia * $so_luong;

  $vat_override = isset($values['so_tien_vat']) && $values['so_tien_vat'] !== '' && $values['so_tien_vat'] !== NULL;
  if ($vat_override) {
    $so_tien_vat = round((float) $values['so_tien_vat'], 2);
  }
  else {
    $so_tien_vat = round($tien_truoc_vat * $vat_pct / 100, 2);
  }

  $tien_sau_vat = $tien_truoc_vat + $so_tien_vat;
  $tien_sau_vat_vnd = round($tien_sau_vat * $rate, 0);

  return array(
    'tien_truoc_vat' => $tien_truoc_vat,
    'so_tien_vat' => $so_tien_vat,
    'tien_sau_vat' => $tien_sau_vat,
    'tien_sau_vat_vnd' => $tien_sau_vat_vnd,
  );
}

/**
 * Auto-fill nhom_chi_phi_id from loai_chi_phi_id.
 */
function crm_dntt_resolve_nhom_chi_phi($loai_chi_phi_id) {
  return db_query(
    "SELECT nhom_id FROM {loai_chi_phi} WHERE id = :id",
    array(':id' => $loai_chi_phi_id)
  )->fetchField();
}

/*******************************************************************************
 * WORKFLOW (Issue 06)
 ******************************************************************************/

/**
 * Allowed transitions: from → array of to statuses.
 *
 * ADR-0004 / Issue 07: `da_tt` không còn là trạng thái workflow. "Đã trả đủ"
 * dẫn xuất từ Sổ thanh toán + Đối ứng (cong_no), không lưu trên DNTT.
 */
function crm_dntt_transitions() {
  return array(
    'moi' => array('cho_duyet'),
    'cho_duyet' => array('da_duyet', 'tu_choi', 'moi'),
    'da_duyet' => array('cho_thanh_toan', 'tu_choi_tt'),
    'cho_thanh_toan' => array('tu_choi_tt'),
    'tu_choi' => array('moi'),
    'tu_choi_tt' => array('moi'),
  );
}

/**
 * Permission required for certain transitions.
 */
function crm_dntt_transition_permissions() {
  return array(
    'cho_duyet:da_duyet' => 'dntt_approve',
    'cho_duyet:tu_choi' => 'dntt_approve',
    'cho_duyet:moi' => 'dntt_approve',
    'da_duyet:cho_thanh_toan' => 'dntt_approve_payment',
    'da_duyet:tu_choi_tt' => 'dntt_approve_payment',
    'cho_thanh_toan:tu_choi_tt' => 'dntt_pay',
  );
}

/**
 * Check if a DNTT status allows editing header/chi tiết.
 */
function crm_dntt_is_editable($trang_thai) {
  return in_array($trang_thai, array('moi', 'tu_choi', 'tu_choi_tt'));
}

/**
 * Execute a status transition on a DNTT.
 *
 * @return array
 *   Result with 'success' and optional 'message'.
 */
function crm_dntt_transition($dntt_id, $new_status) {
  $entities = entity_load('dntt', array($dntt_id));
  if (empty($entities)) {
    return array('success' => FALSE, 'message' => 'DNTT không tồn tại.');
  }
  $entity = reset($entities);
  if (!crm_dntt_user_can_edit($entity)) {
    return array('success' => FALSE, 'message' => 'Bạn không có quyền thao tác DNTT này.');
  }
  $old_status = $entity->trang_thai;

  if ($old_status === 'moi' && $new_status === 'cho_duyet') {
    return array(
      'success' => FALSE,
      'message' => 'Trình duyệt DNTT phải thông qua Lô DNTT. Vui lòng dùng chức năng Trình duyệt để tạo lô.',
    );
  }

  // Check valid transition.
  $transitions = crm_dntt_transitions();
  $allowed = isset($transitions[$old_status]) ? $transitions[$old_status] : array();
  if (!in_array($new_status, $allowed)) {
    return array('success' => FALSE, 'message' => "Không thể chuyển từ '$old_status' sang '$new_status'.");
  }

  // Check permission.
  $perm_map = crm_dntt_transition_permissions();
  $key = $old_status . ':' . $new_status;
  if (isset($perm_map[$key]) && !user_access($perm_map[$key])) {
    return array('success' => FALSE, 'message' => 'Bạn không có quyền thực hiện thao tác này.');
  }

  $entity->trang_thai = $new_status;
  $entity->changed = REQUEST_TIME;
  entity_save('dntt', $entity);

  return array('success' => TRUE, 'old_status' => $old_status, 'new_status' => $new_status);
}

/**
 * API endpoint: POST /api/dntt/transition
 */
function crm_dntt_api_transition() {
  $input = _crm_dntt_input();
  if (empty($input['dntt_id']) || empty($input['new_status'])) {
    return _crm_dntt_json_error('dntt_id và new_status bắt buộc.');
  }
  return crm_dntt_transition((int) $input['dntt_id'], $input['new_status']);
}

/*******************************************************************************
 * API: CHI PHÍ LÔ HÀNG (Issue 10)
 ******************************************************************************/

/**
 * Dòng chi phí phải trả của một lô, kèm cờ sửa-được của DNTT chứa chúng.
 *
 * Đường đọc DUY NHẤT của tab "Chi phí (DNTT)" trong modal đơn hàng (ADR-0016
 * của van-hanh: bảng phẳng chọn-rồi-gộp, thay UI ticket 15). Nó cũng là đường
 * đọc của panel chi phí ở trang Theo dõi booking.
 *
 * LEFT JOIN {dntt} (ADR-0016), không còn INNER JOIN: `ct.dntt_id` giờ NULLABLE
 * — dòng chi phí độc lập, chưa gộp vào DNTT nào. Dòng đó có `dntt_id`,
 * `so_dntt`, `trang_thai` NULL và `is_editable` luôn TRUE (chưa ai duyệt gì để
 * khoá).
 *
 * `doi_tac_nhan_tien_id` trả về là NCC HIỆU LỰC của dòng: của DNTT chứa nó nếu
 * đã gộp, hoặc của riêng dòng (`ct.doi_tac_nhan_tien_id`, ADR-0016) nếu chưa —
 * client dùng đúng một khoá này để so "cùng NCC" khi tick chọn (ticket 04),
 * không phải so tên (`doi_tac_ten`) vì tên có thể trùng giữa hai node khác id.
 *
 * Các khoá còn lại, và vì sao mỗi cái phải ở đây chứ không suy ở client:
 *
 * - `loai_chi_phi_id` / `nhom_chi_phi_id` — `api/dntt-chi-tiet/save` BẮT BUỘC
 *   `loai_chi_phi_id`. Trả về tên mà không trả id thì tab hiện được bảng nhưng
 *   không lưu được dòng nào, và lỗi nổi lên ở cú bấm Lưu chứ không ở lúc đọc.
 * - `is_editable` — cùng một `crm_dntt_is_editable()` mà cổng ghi
 *   (`crm_dntt_chi_tiet_api_save`) dùng. Client so chuỗi trạng thái là dựng bản
 *   thứ hai của cổng, và bản thứ hai lệch ngay lần thêm trạng thái sau.
 * - `tu_chuyen` — dòng gom từ một chuyến vận tải, tức chỉ đọc ở đây (quyết định
 *   Q13 của ticket 15: quan hệ chuyến → DNTT là một chiều một lần, cho sửa đầu
 *   dưới mà không ghi ngược là để hai đầu nói hai số).
 *
 * `tu_chuyen` phải THOÁI HOÁ ÊM: cột `dntt_chi_tiet.chuyen_id` do ticket 07 của
 * trucking thêm và nó chưa có ở đây. Kiểm bằng `property_exists()` trên chính
 * dòng vừa fetch — `SELECT ct.*` chỉ mang cột nào bảng THẬT có, nên phép kiểm
 * này miễn phí và không bao giờ lệch với schema. `isset()` KHÔNG dùng được:
 * cột tồn tại mà giá trị NULL (đúng nghĩa "nhập tay") thì isset trả FALSE, và
 * hai nghĩa "không có cột" với "có cột, giá trị rỗng" gộp lại thành một.
 *
 * - `so_cont` — số container của chuyến đã gom dòng, để chip "Nguồn" nói người
 *   duyệt đang ký tiền cho cont nào (mỗi cont một mức nâng hạ). Cont là NHÃN,
 *   không phải thực thể: không cột trên `dntt_chi_tiet`, không cộng chi phí
 *   theo cont — đọc sống qua `chuyen_id`. NULL = chưa biết, gộp cả ba nguyên
 *   nhân (dòng nhập tay · chuyến chưa nhập cont · không có bảng trucking), vì
 *   cả ba vẽ ra cùng một chip.
 *
 * `so_cont` thoái hoá êm theo CẢ HAI mảnh của đường đọc, và đây là ràng buộc
 * cứng chứ không phải phòng xa: `crm_dntt.info` khai duy nhất
 * `dependencies[] = entity`, còn `trucking.info` cố ý không khai ngược (màn vận
 * tải phải chạy đủ khi module tài chính tắt) — nên "bảng {trucking_chuyen}
 * vắng mặt" là một trạng thái HỢP LỆ của hệ thống, không phải một cài đặt hỏng.
 * Fail-OPEN có chủ ý, khác ô Địa chỉ đóng hàng (fail-closed): cont là nhãn để
 * đọc, không phải căn cứ để ghi. `db_field_exists()` + `db_table_exists()` gác
 * việc dựng JOIN; `property_exists()` gác việc đọc kết quả, cùng lý do với
 * `tu_chuyen` ở trên.
 *
 * @param int $lo_hang_nid
 *   nid của lô hàng.
 *
 * @return array
 *   Phong bì {success, lines, subtotals, tong_quy_doi_vnd}. `lines` phẳng, DNTT
 *   chỉ là nhãn trên mỗi dòng (ADR-0003) — nhóm hiển thị là việc của client.
 */
function crm_dntt_chi_phi_lo_hang($lo_hang_nid) {
  $lo_hang_nid = (int) $lo_hang_nid;
  if (!$lo_hang_nid) {
    return array('success' => FALSE, 'message' => 'lo_hang_nid bắt buộc.');
  }

  // ADR-0003: jobfile-centric — flat lines của lô (từ MỌI DNTT, mọi người tạo).
  // Sắp theo loại phí. KHÔNG group-by-DNTT (DNTT chỉ là nhãn trên mỗi dòng).
  //
  // ADR-0016: LEFT JOIN — `ct.dntt_id` có thể NULL. `d.doi_tac_nhan_tien_id`
  // đặt tên riêng (`dntt_doi_tac_id`) vì `ct.*` đã mang cột cùng tên của riêng
  // dòng (ADR-0016); hai cột trùng tên không alias thì driver chỉ giữ lại một.
  // Số cont của chuyến đã gom dòng — xem docblock hàm. JOIN chỉ dựng khi CẢ HAI
  // mảnh của đường đọc có mặt; thiếu mảnh nào thì cột vắng khỏi hàng vừa fetch
  // và `property_exists()` bên dưới đọc ra "không biết cont".
  //
  // Alias `chuyen_so_cont` vì cùng lý do với `dntt_doi_tac_id` ở trên: `ct.*`
  // mang mọi cột của `dntt_chi_tiet`, và ngày nào bảng đó có một cột tên
  // `so_cont` thì hai cột trùng tên sẽ chỉ còn một sau driver — `property_exists()`
  // vẫn đọc đúng khoá nhưng SAI cột, và im lặng.
  $co_cont = db_field_exists('dntt_chi_tiet', 'chuyen_id') && db_table_exists('trucking_chuyen');
  $chon_cont = $co_cont ? ', tc.so_cont AS chuyen_so_cont' : '';
  $join_cont = $co_cont ? 'LEFT JOIN {trucking_chuyen} tc ON tc.chuyen_id = ct.chuyen_id' : '';

  $rows = db_query("
    SELECT ct.*, d.so_dntt, d.trang_thai, d.doi_tac_nhan_tien_id AS dntt_doi_tac_id,
           lcp.ten AS loai_chi_phi_ten,
           ncp.ten AS nhom_chi_phi_ten,
           dt_node.title AS doi_tac_ten" . $chon_cont . "
    FROM {dntt_chi_tiet} ct
    LEFT JOIN {dntt} d ON d.dntt_id = ct.dntt_id
    LEFT JOIN {loai_chi_phi} lcp ON lcp.id = ct.loai_chi_phi_id
    LEFT JOIN {nhom_chi_phi} ncp ON ncp.id = ct.nhom_chi_phi_id
    LEFT JOIN {node} dt_node ON dt_node.nid = COALESCE(d.doi_tac_nhan_tien_id, ct.doi_tac_nhan_tien_id)
    " . $join_cont . "
    WHERE ct.lo_hang_nid = :nid
    ORDER BY lcp.ten, ct.chi_tiet_id
  ", array(':nid' => $lo_hang_nid))->fetchAll();

  $lines = array();
  // ADR-0002: loại tiền per-line, KHÔNG cộng chéo VND + USD.
  $subtotals = array('VND' => 0, 'USD' => 0);
  $tong_quy_doi_vnd = 0;

  foreach ($rows as $r) {
    // Per-line currency: đọc thẳng ct.loai_tien (ADR-0004).
    $loai_tien = strtoupper((string) $r->loai_tien) === 'USD' ? 'USD' : 'VND';
    $tien_sau_vat = (float) $r->tien_sau_vat;
    $co_dntt = $r->dntt_id !== NULL;
    $eff_doi_tac_id = $co_dntt
      ? (int) $r->dntt_doi_tac_id
      : ((int) $r->doi_tac_nhan_tien_id ?: NULL);

    $lines[] = array(
      'chi_tiet_id' => (int) $r->chi_tiet_id,
      // Id của danh mục phí đi cùng tên: đường ghi cần id, người đọc cần tên.
      'loai_chi_phi_id' => (int) $r->loai_chi_phi_id,
      'nhom_chi_phi_id' => (int) $r->nhom_chi_phi_id,
      'loai_chi_phi_ten' => $r->loai_chi_phi_ten ?: '',
      'nhom_chi_phi_ten' => $r->nhom_chi_phi_ten ?: '',
      'don_vi' => $r->don_vi,
      'don_gia' => (float) $r->don_gia,
      'so_luong' => (float) $r->so_luong,
      'vat_phan_tram' => (float) $r->vat_phan_tram,
      'so_tien_vat' => (float) $r->so_tien_vat,
      'tien_truoc_vat' => (float) $r->tien_truoc_vat,
      'tien_sau_vat' => $tien_sau_vat,
      'tien_sau_vat_vnd' => (float) $r->tien_sau_vat_vnd,
      'loai_tien' => $loai_tien,
      'ghi_chu' => $r->ghi_chu,
      // Nhãn DNTT chứa dòng (link mở form đầy đủ). NULL = chưa gộp (ADR-0016).
      'dntt_id' => $co_dntt ? (int) $r->dntt_id : NULL,
      'so_dntt' => $co_dntt ? $r->so_dntt : NULL,
      'trang_thai' => $co_dntt ? $r->trang_thai : NULL,
      // NCC hiệu lực — xem docblock hàm. Dùng để so "cùng NCC" (ticket 04).
      'doi_tac_nhan_tien_id' => $eff_doi_tac_id,
      'doi_tac_ten' => $r->doi_tac_ten ?: '',
      // Cờ của SERVER cho cổng sửa — xem docblock hàm. Dòng độc lập luôn sửa
      // được: chưa ai duyệt gì để khoá.
      'is_editable' => $co_dntt ? crm_dntt_is_editable($r->trang_thai) : TRUE,
      'tu_chuyen' => property_exists($r, 'chuyen_id') && $r->chuyen_id !== NULL,
      // Cont là NHÃN đi kèm `tu_chuyen`, không phải chiều dữ liệu để cộng
      // theo. Cont rỗng gộp vào NULL: "chuyến chưa nhập cont" và "chưa biết
      // có chuyến nào" vẽ ra cùng một chip, và client chỉ nhìn khoá này.
      'so_cont' => property_exists($r, 'chuyen_so_cont') && trim((string) $r->chuyen_so_cont) !== ''
        ? trim($r->chuyen_so_cont)
        : NULL,
    );

    $subtotals[$loai_tien] += $tien_sau_vat;
    $tong_quy_doi_vnd += (float) $r->tien_sau_vat_vnd;
  }

  return array(
    'success' => TRUE,
    'lines' => $lines,
    'subtotals' => $subtotals,
    'tong_quy_doi_vnd' => $tong_quy_doi_vnd,
  );
}

function crm_dntt_api_chi_phi_lo_hang() {
  $nid = isset($_GET['lo_hang_nid']) ? (int) $_GET['lo_hang_nid'] : 0;
  return crm_dntt_chi_phi_lo_hang($nid);
}

/**
 * Tổng Chi phí (trước VAT, quy đổi VND) ĐÃ LÀ NGHĨA VỤ THẬT của một đơn hàng.
 *
 * Khác `crm_dntt_chi_phi_lo_hang()`: hàm đó liệt kê MỌI dòng (kể cả nháp/độc
 * lập/chờ duyệt) cho tab hiển thị-sửa; hàm này chỉ cộng dòng DNTT từ trạng
 * thái Đã duyệt trở lên (`da_duyet`, `cho_thanh_toan`), trừ DNTT điều chỉnh
 * và Hoàn về đã ở trạng thái đó (đối xứng credit note bên Debit Note) — dùng
 * cho card Doanh thu/Chi phí/Lợi nhuận (ADR-0028, context Vận hành). Dòng độc
 * lập (`dntt_id` NULL, ADR-0016) không có trạng thái duyệt nào để đọc nên tự
 * động bị loại qua INNER JOIN.
 *
 * Quy đổi VND mirror đúng công thức lúc lưu dòng (`crm_dntt_calculate_chi_tiet()`):
 * VND dùng rate 1, USD dùng `ti_gia` của DNTT chứa dòng — vì `dntt_chi_tiet`
 * chỉ lưu sẵn VND cho phần SAU VAT (`tien_sau_vat_vnd`), không có cột trước
 * VAT quy đổi.
 *
 * @param int $lo_hang_nid
 *   Node ID lô hàng.
 *
 * @return float
 *   Chi phí quy đổi VND. 0.0 nếu lô chưa có DNTT nào đủ điều kiện.
 */
function crm_dntt_tong_chi_phi_da_duyet_lo_hang($lo_hang_nid) {
  $lo_hang_nid = (int) $lo_hang_nid;
  if (!$lo_hang_nid) {
    return 0.0;
  }

  $rows = db_query("
    SELECT ct.tien_truoc_vat, ct.loai_tien, d.ti_gia, d.loai_dntt
    FROM {dntt_chi_tiet} ct
    INNER JOIN {dntt} d ON d.dntt_id = ct.dntt_id
    WHERE ct.lo_hang_nid = :nid
      AND d.trang_thai IN (:da_duyet, :cho_thanh_toan)
  ", array(
    ':nid' => $lo_hang_nid,
    ':da_duyet' => 'da_duyet',
    ':cho_thanh_toan' => 'cho_thanh_toan',
  ))->fetchAll();

  $tong = 0.0;
  foreach ($rows as $r) {
    $rate = strtoupper((string) $r->loai_tien) === 'USD' ? (float) $r->ti_gia : 1;
    $truoc_vat_vnd = round((float) $r->tien_truoc_vat * $rate, 0);
    $tong += in_array($r->loai_dntt, array('dieu_chinh', 'hoan_ve')) ? -$truoc_vat_vnd : $truoc_vat_vnd;
  }

  return $tong;
}

/**
 * Adapter đọc trạng thái thanh toán dẫn xuất của một DNTT từ sổ cái Công nợ.
 *
 * ADR-0006 boundary exception (Issue 07): bình thường cong_no quan sát crm_dntt
 * một chiều. Riêng "đã trả đủ" là giá trị dẫn xuất read-only, crm_dntt hỏi
 * cong_no qua adapter mỏng này thay vì lưu cờ da_tt. Không nhúng nghiệp vụ sổ
 * cái vào đây.
 *
 * @param int $dntt_id
 *
 * @return array
 *   Map loai_tien => trạng thái (gồm da_tra_du, con_lai...). Rỗng nếu chưa ghi
 *   nợ hoặc module cong_no không khả dụng.
 */
function crm_dntt_get_payment_status($dntt_id) {
  $dntt_id = (int) $dntt_id;
  if (!$dntt_id || !module_exists('cong_no')) {
    return array();
  }

  module_load_include('inc', 'cong_no', 'includes/cong_no.service');
  if (!function_exists('cong_no_service_get_chung_tu_payment_status')) {
    return array();
  }

  return cong_no_service_get_chung_tu_payment_status('dntt', $dntt_id);
}

/**
 * DNTT đã trả đủ chưa, dẫn xuất từ Sổ thanh toán + Đối ứng (cong_no).
 *
 * Trả TRUE chỉ khi đã ghi nợ và mọi loại tiền đều đối ứng đủ. DNTT chưa ghi nợ
 * (không có dòng phát sinh nào) coi là chưa trả đủ.
 *
 * @param int $dntt_id
 *
 * @return bool
 */
function crm_dntt_is_fully_paid($dntt_id) {
  $status = crm_dntt_get_payment_status($dntt_id);
  if (empty($status)) {
    return FALSE;
  }

  foreach ($status as $row) {
    if (empty($row['da_tra_du'])) {
      return FALSE;
    }
  }

  return TRUE;
}

/**
 * Public read seam: dòng gắn lô hàng (JobFile) của nhiều DNTT.
 *
 * Dùng cho cong_no (ADR-0002) drilldown JobFile từ bút toán phải trả, tham
 * chiếu DNTT theo ID thay vì truy vấn trực tiếp bảng dntt_chi_tiet. ADR-0004:
 * lo_hang_nid theo dòng và có thể NULL (dòng chi phí không gắn lô hàng) — giữ
 * nguyên trạng để bên gọi tự bỏ qua.
 *
 * @param array $dntt_ids
 *   Danh sách dntt_id.
 *
 * @return array
 *   Map dntt_id => mảng dòng object {chi_tiet_id, dntt_id, lo_hang_nid
 *   (nullable), loai_tien, tien_sau_vat, thu_tu}. Rỗng nếu không có ID.
 */
function crm_dntt_get_jobfile_lines(array $dntt_ids) {
  if (empty($dntt_ids)) {
    return array();
  }

  $rows = db_select('dntt_chi_tiet', 'ct')
    ->fields('ct', array('chi_tiet_id', 'dntt_id', 'lo_hang_nid', 'loai_tien', 'tien_sau_vat', 'thu_tu'))
    ->condition('dntt_id', $dntt_ids, 'IN')
    ->orderBy('dntt_id', 'ASC')
    ->orderBy('thu_tu', 'ASC')
    ->orderBy('chi_tiet_id', 'ASC')
    ->execute()
    ->fetchAll();

  $map = array();
  foreach ($rows as $row) {
    $map[(int) $row->dntt_id][] = $row;
  }
  return $map;
}

/*******************************************************************************
 * API: DNTT HOÀN VỀ (Issue 09)
 ******************************************************************************/

/**
 * API endpoint mỏng: parse input rồi uỷ quyền sang service tạo hoàn về.
 */
function crm_dntt_api_create_hoan_ve() {
  $input = _crm_dntt_input();

  if (empty($input['dntt_goc_id'])) {
    return _crm_dntt_json_error('dntt_goc_id bắt buộc.');
  }

  return crm_dntt_create_hoan_ve((int) $input['dntt_goc_id']);
}

/**
 * Tạo DNTT hoàn về từ một DNTT gốc.
 *
 * Issue 07: guard "đã trả đủ" dẫn xuất từ Sổ thanh toán + Đối ứng (cong_no),
 * không còn đọc cờ trang_thai='da_tt'. Hoàn về bị chặn cho tới khi DNTT gốc đã
 * được đối ứng đủ ở mọi loại tiền.
 *
 * @param int $goc_id
 *
 * @return array
 *   JSON-shaped result (success + dntt_id/so_dntt, hoặc error).
 */
function crm_dntt_create_hoan_ve($goc_id) {
  $goc_id = (int) $goc_id;
  if (!$goc_id) {
    return _crm_dntt_json_error('dntt_goc_id bắt buộc.');
  }

  $goc_list = entity_load('dntt', array($goc_id));
  if (empty($goc_list)) {
    return _crm_dntt_json_error('DNTT gốc không tồn tại.');
  }
  $goc = reset($goc_list);

  if (!crm_dntt_is_fully_paid($goc_id)) {
    return _crm_dntt_json_error('DNTT gốc phải được đối ứng đủ (đã trả đủ trên Công nợ) mới tạo hoàn về được.');
  }

  $existing = db_query(
    "SELECT dntt_id FROM {dntt} WHERE dntt_goc_id = :goc AND loai_dntt = 'hoan_ve'",
    array(':goc' => $goc_id)
  )->fetchField();
  if ($existing) {
    return _crm_dntt_json_error('DNTT gốc này đã có DNTT hoàn về (ID: ' . $existing . ').');
  }

  _crm_dntt_load_include('service');
  $created = crm_dntt_service_create_dntt(
    crm_dntt_service_inherit_header_params($goc, 'hoan_ve'),
    crm_dntt_service_copy_chi_tiet_params($goc_id)
  );
  if (empty($created['success'])) {
    return _crm_dntt_json_error($created['message']);
  }

  return array('success' => TRUE, 'dntt_id' => $created['dntt_id'], 'so_dntt' => $created['so_dntt']);
}

/*******************************************************************************
 * API: DNTT ĐIỀU CHỈNH (Issue 13 — chứng từ điều chỉnh phải trả, ADR-0011)
 *
 * Đối xứng credit note phía thu: giảm nghĩa vụ phải trả SAI / giảm trừ khi chưa
 * trả đủ (duyệt nhầm, trùng, vendor giảm trừ) — KHÁC Hoàn về (refund sau khi đã
 * trả đủ). Khi duyệt ghi bút toán điều chỉnh ÂM vào sổ cái, DNTT gốc bất biến.
 ******************************************************************************/

/**
 * Phần còn được điều chỉnh của một DNTT gốc, theo từng nguyên tệ.
 *
 * = phần còn nợ (con_lai, dẫn xuất từ cong_no) TRỪ tổng các DNTT điều chỉnh đã
 * duyệt trước đó của cùng gốc. Phải trừ tường minh vì bút toán điều chỉnh keyed
 * theo doc điều chỉnh nên KHÔNG tự giảm con_lai của gốc. Guard "không vượt phần
 * chưa trả" (ADR-0011) dùng map này; cho nhiều lần điều chỉnh nên phải cộng dồn.
 *
 * @param int $goc_id
 *
 * @return array
 *   Map loai_tien => float remaining (>= 0). Rỗng nếu gốc chưa ghi nợ.
 */
function crm_dntt_get_dieu_chinh_remaining($goc_id) {
  $goc_id = (int) $goc_id;
  $status = crm_dntt_get_payment_status($goc_id);
  if (empty($status)) {
    return array();
  }

  // Tổng điều chỉnh đã duyệt trước đó của cùng gốc, theo nguyên tệ.
  $prior = db_query(
    "SELECT ct.loai_tien, SUM(ct.tien_sau_vat) AS tong
     FROM {dntt_chi_tiet} ct
     INNER JOIN {dntt} d ON d.dntt_id = ct.dntt_id
     WHERE d.dntt_goc_id = :goc AND d.loai_dntt = 'dieu_chinh' AND d.trang_thai = 'da_duyet'
     GROUP BY ct.loai_tien",
    array(':goc' => $goc_id)
  )->fetchAllKeyed();

  $remaining = array();
  foreach ($status as $loai_tien => $row) {
    $con_lai = (float) $row['con_lai'];
    $da_dieu_chinh = isset($prior[$loai_tien]) ? (float) $prior[$loai_tien] : 0;
    $remaining[$loai_tien] = max(0, $con_lai - $da_dieu_chinh);
  }
  return $remaining;
}

/**
 * Tạo một DNTT điều chỉnh (nháp) trỏ về DNTT gốc, copy chi tiết làm mức khởi
 * đầu để người dùng chỉnh xuống. Chưa ghi sổ — phải duyệt qua
 * crm_dntt_approve_dieu_chinh.
 *
 * @param int $goc_id
 *
 * @return array
 *   JSON-shaped result (success + dntt_id/so_dntt, hoặc error).
 */
function crm_dntt_create_dieu_chinh($goc_id) {
  $goc_id = (int) $goc_id;
  if (!$goc_id) {
    return _crm_dntt_json_error('dntt_goc_id bắt buộc.');
  }

  $goc_list = entity_load('dntt', array($goc_id));
  if (empty($goc_list)) {
    return _crm_dntt_json_error('DNTT gốc không tồn tại.');
  }
  $goc = reset($goc_list);

  // Chỉ điều chỉnh DNTT thanh toán thường — không điều chỉnh Hoàn về hoặc một
  // điều chỉnh khác (giữ cây hai cấp gốc → con, mirror credit note D3).
  if ($goc->loai_dntt !== 'thanh_toan') {
    return _crm_dntt_json_error('Chỉ tạo điều chỉnh từ DNTT thanh toán; không điều chỉnh Hoàn về hoặc một DNTT điều chỉnh.');
  }

  // Gốc phải đã ghi nợ phải trả (đã duyệt) và còn phần để điều chỉnh.
  $remaining = crm_dntt_get_dieu_chinh_remaining($goc_id);
  if (empty($remaining)) {
    return _crm_dntt_json_error('DNTT gốc chưa ghi nợ công nợ (chưa duyệt) nên không thể điều chỉnh.');
  }
  $con_dieu_chinh = FALSE;
  foreach ($remaining as $r) {
    if ($r > 0.00001) {
      $con_dieu_chinh = TRUE;
      break;
    }
  }
  if (!$con_dieu_chinh) {
    return _crm_dntt_json_error('DNTT gốc không còn phần nào để điều chỉnh (đã trả đủ hoặc đã điều chỉnh hết).');
  }

  _crm_dntt_load_include('service');
  $created = crm_dntt_service_create_dntt(
    crm_dntt_service_inherit_header_params($goc, 'dieu_chinh'),
    crm_dntt_service_copy_chi_tiet_params($goc_id)
  );
  if (empty($created['success'])) {
    return _crm_dntt_json_error($created['message']);
  }

  return array('success' => TRUE, 'dntt_id' => $created['dntt_id'], 'so_dntt' => $created['so_dntt']);
}

/**
 * Duyệt một DNTT điều chỉnh: guard "không vượt phần còn nợ" rồi bắn dntt_approved
 * để cong_no ghi bút toán điều chỉnh ÂM (ADR-0011).
 *
 * Đường duyệt trực tiếp, KHÔNG qua lô — điều chỉnh là chứng từ sửa sổ, không
 * phải yêu cầu chi. cong_no thấy loai_dntt='dieu_chinh' trong payload → ghi âm.
 *
 * @param int $dntt_id
 *
 * @return array
 */
function crm_dntt_approve_dieu_chinh($dntt_id) {
  $dntt_id = (int) $dntt_id;
  if (!$dntt_id) {
    return _crm_dntt_json_error('dntt_id bắt buộc.');
  }

  $list = entity_load('dntt', array($dntt_id));
  if (empty($list)) {
    return _crm_dntt_json_error('DNTT điều chỉnh không tồn tại.');
  }
  $dc = reset($list);

  if ($dc->loai_dntt !== 'dieu_chinh') {
    return _crm_dntt_json_error('Chỉ duyệt được DNTT điều chỉnh ở đây.');
  }
  if ($dc->trang_thai !== 'moi') {
    return _crm_dntt_json_error('DNTT điều chỉnh ở trạng thái "' . $dc->trang_thai . '", không thể duyệt.');
  }
  if (empty($dc->dntt_goc_id)) {
    return _crm_dntt_json_error('DNTT điều chỉnh thiếu DNTT gốc.');
  }

  // Tổng đề xuất điều chỉnh theo nguyên tệ.
  $proposed = db_query(
    "SELECT loai_tien, SUM(tien_sau_vat) AS tong FROM {dntt_chi_tiet} WHERE dntt_id = :id GROUP BY loai_tien",
    array(':id' => $dntt_id)
  )->fetchAllKeyed();
  if (empty($proposed)) {
    return _crm_dntt_json_error('DNTT điều chỉnh chưa có dòng chi phí nào.');
  }

  // Guard cộng dồn: mỗi nguyên tệ không vượt phần còn được điều chỉnh của gốc.
  $remaining = crm_dntt_get_dieu_chinh_remaining((int) $dc->dntt_goc_id);
  foreach ($proposed as $loai_tien => $tong) {
    $tong = (float) $tong;
    if ($tong <= 0) {
      continue;
    }
    $con = isset($remaining[$loai_tien]) ? (float) $remaining[$loai_tien] : 0;
    if ($tong > $con + 0.00001) {
      return _crm_dntt_json_error(
        'Số tiền điều chỉnh ' . $loai_tien . ' (' . number_format($tong, 2, '.', '') . ') vượt phần còn nợ của DNTT gốc (' . number_format($con, 2, '.', '') . ').'
      );
    }
  }

  $transaction = db_transaction();
  try {
    $dc->trang_thai = 'da_duyet';
    $dc->changed = REQUEST_TIME;
    entity_save('dntt', $dc);

    module_invoke_all('dntt_approved', crm_dntt_build_approved_event($dc, REQUEST_TIME));

    return array('success' => TRUE, 'dntt_id' => $dntt_id, 'trang_thai' => 'da_duyet');
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog('crm_dntt', 'Lỗi duyệt điều chỉnh: @msg', array('@msg' => $e->getMessage()), WATCHDOG_ERROR);
    return _crm_dntt_json_error('Lỗi hệ thống khi duyệt DNTT điều chỉnh.');
  }
}

/**
 * API endpoint mỏng: tạo DNTT điều chỉnh từ dntt_goc_id.
 */
function crm_dntt_api_create_dieu_chinh() {
  $input = _crm_dntt_input();
  if (empty($input['dntt_goc_id'])) {
    return _crm_dntt_json_error('dntt_goc_id bắt buộc.');
  }
  return crm_dntt_create_dieu_chinh((int) $input['dntt_goc_id']);
}

/**
 * API endpoint mỏng: duyệt DNTT điều chỉnh.
 */
function crm_dntt_api_approve_dieu_chinh() {
  $input = _crm_dntt_input();
  if (empty($input['dntt_id'])) {
    return _crm_dntt_json_error('dntt_id bắt buộc.');
  }
  return crm_dntt_approve_dieu_chinh((int) $input['dntt_id']);
}

/*******************************************************************************
 * API: Find or Create DNTT (Issue 13 — modal nhập chi phí)
 ******************************************************************************/

function crm_dntt_api_find_or_create() {
  $input = _crm_dntt_input();

  $doi_tac_id = isset($input['doi_tac_nhan_tien_id']) ? (int) $input['doi_tac_nhan_tien_id'] : 0;
  $lo_hang_nid = isset($input['lo_hang_nid']) ? (int) $input['lo_hang_nid'] : 0;
  $ben_phat_hanh_id = isset($input['ben_phat_hanh_id']) ? (int) $input['ben_phat_hanh_id'] : 0;

  if (!$doi_tac_id) {
    return _crm_dntt_json_error('doi_tac_nhan_tien_id bắt buộc.');
  }
  if (!$lo_hang_nid) {
    return _crm_dntt_json_error('lo_hang_nid bắt buộc.');
  }

  $node = node_load($lo_hang_nid);
  if (!$node) {
    return _crm_dntt_json_error('Lô hàng không tồn tại.');
  }

  // 1) Find DNTT moi that already has chi tiết for this (đối tác + lô hàng). Currency no longer splits DNTT.
  $dntt_id = db_query_range(
    "SELECT DISTINCT d.dntt_id FROM {dntt} d
     INNER JOIN {dntt_chi_tiet} ct ON ct.dntt_id = d.dntt_id
     WHERE d.doi_tac_nhan_tien_id = :doi_tac
       AND d.trang_thai = 'moi'
       AND ct.lo_hang_nid = :lo_hang
     ORDER BY d.created DESC",
    0, 1,
    array(':doi_tac' => $doi_tac_id, ':lo_hang' => $lo_hang_nid)
  )->fetchField();

  // 2) Fallback: find empty DNTT moi for this đối tác. Currency no longer splits DNTT.
  if (!$dntt_id) {
    $dntt_id = db_query_range(
      "SELECT d.dntt_id FROM {dntt} d
       LEFT JOIN {dntt_chi_tiet} ct ON ct.dntt_id = d.dntt_id
       WHERE d.doi_tac_nhan_tien_id = :doi_tac
         AND d.trang_thai = 'moi'
         AND ct.chi_tiet_id IS NULL
       ORDER BY d.created DESC",
      0, 1,
      array(':doi_tac' => $doi_tac_id)
    )->fetchField();
  }

  $is_new = FALSE;

  // 3) Auto-create if not found.
  if (!$dntt_id) {
    _crm_dntt_load_include('service');
    $created = crm_dntt_service_create_dntt(array(
      'ben_phat_hanh_id' => $ben_phat_hanh_id ? $ben_phat_hanh_id : $doi_tac_id,
      'doi_tac_nhan_tien_id' => $doi_tac_id,
      'ti_gia' => isset($input['ti_gia']) ? $input['ti_gia'] : 1,
    ));
    if (empty($created['success'])) {
      return _crm_dntt_json_error($created['message']);
    }
    $dntt_id = $created['dntt_id'];
    $is_new = TRUE;
  }

  // Load DNTT header.
  $dntt_list = entity_load('dntt', array($dntt_id));
  $dntt = reset($dntt_list);
  $editable = crm_dntt_is_editable($dntt->trang_thai);

  // Load chi tiết with resolved names.
  $chi_tiets = db_query("
    SELECT ct.*,
           lcp.ten AS loai_chi_phi_ten, lcp.ma AS loai_chi_phi_ma,
           ncp.ten AS nhom_chi_phi_ten, ncp.ma AS nhom_chi_phi_ma
    FROM {dntt_chi_tiet} ct
    LEFT JOIN {loai_chi_phi} lcp ON ct.loai_chi_phi_id = lcp.id
    LEFT JOIN {nhom_chi_phi} ncp ON ct.nhom_chi_phi_id = ncp.id
    WHERE ct.dntt_id = :dntt_id
    ORDER BY ct.thu_tu, ct.chi_tiet_id
  ", array(':dntt_id' => $dntt_id))->fetchAll();

  return array(
    'success' => TRUE,
    'dntt_id' => (int) $dntt_id,
    'so_dntt' => $dntt->so_dntt,
    'trang_thai' => $dntt->trang_thai,
    'is_new' => $is_new,
    'editable' => $editable,
    'so_hoa_don' => isset($dntt->so_hoa_don) ? $dntt->so_hoa_don : '',
    'no_hoa_don' => isset($dntt->no_hoa_don) ? (int) $dntt->no_hoa_don : 0,
    'ngay_hoa_don' => isset($dntt->ngay_hoa_don) ? $dntt->ngay_hoa_don : '',
    'han_thanh_toan' => isset($dntt->han_thanh_toan) ? $dntt->han_thanh_toan : '',
    'hinh_thuc_tt' => isset($dntt->hinh_thuc_tt) ? $dntt->hinh_thuc_tt : 'CK',
    'ti_gia' => isset($dntt->ti_gia) ? $dntt->ti_gia : 1,
    'chi_tiets' => $chi_tiets,
  );
}

/*******************************************************************************
 * API: LÔ DNTT (Issue 07)
 ******************************************************************************/

/**
 * POST /api/lo-dntt/create-batch
 * Input: {dntt_ids: [1, 2, 3]}
 * Groups by doi_tac_nhan_tien_id, creates lo_dntt per group.
 */
function crm_dntt_lo_create_batch() {
  global $user;
  $input = _crm_dntt_input();

  if (empty($input['dntt_ids']) || !is_array($input['dntt_ids'])) {
    return _crm_dntt_json_error('dntt_ids bắt buộc (mảng ID).');
  }

  $dntt_ids = array_unique(array_filter(array_map('intval', $input['dntt_ids'])));
  if (empty($dntt_ids)) {
    return _crm_dntt_json_error('dntt_ids không hợp lệ.');
  }

  $entities = entity_load('dntt', $dntt_ids);

  if (count($entities) !== count($dntt_ids)) {
    $missing = array_diff($dntt_ids, array_keys($entities));
    return _crm_dntt_json_error('DNTT không tồn tại: ' . implode(', ', $missing));
  }

  foreach ($entities as $e) {
    if (!crm_dntt_user_can_edit($e, $user)) {
      return _crm_dntt_json_error('Bạn không có quyền trình duyệt DNTT ' . $e->so_dntt . '.');
    }
    if ($e->trang_thai !== 'moi') {
      return _crm_dntt_json_error('DNTT ' . $e->so_dntt . ' đang ở trạng thái "' . $e->trang_thai . '", phải là "Mới".');
    }
    if (!empty($e->lo_dntt_id)) {
      return _crm_dntt_json_error('DNTT ' . $e->so_dntt . ' đã thuộc lô khác (ID: ' . $e->lo_dntt_id . ').');
    }
  }

  $groups = array();
  foreach ($entities as $e) {
    $groups[$e->doi_tac_nhan_tien_id][] = $e;
  }

  $transaction = db_transaction();
  try {
    $lo_ids = array();

    foreach ($groups as $doi_tac_id => $group_entities) {
      $so_lo = crm_dntt_generate_so_lo();

      $tong_tien = 0;
      foreach ($group_entities as $e) {
        $tong_tien += (float) $e->tong_tien;
      }

      $lo = entity_create('lo_dntt', array(
        'so_lo' => $so_lo,
        'doi_tac_nhan_tien_id' => $doi_tac_id,
        'tong_tien' => $tong_tien,
        'trang_thai' => 'cho_duyet',
        'nguoi_trinh' => $user->uid,
        'ngay_trinh' => REQUEST_TIME,
        'created' => REQUEST_TIME,
      ));
      entity_save('lo_dntt', $lo);
      $lo_ids[] = $lo->lo_dntt_id;

      foreach ($group_entities as $e) {
        $e->lo_dntt_id = $lo->lo_dntt_id;
        $e->trang_thai = 'cho_duyet';
        $e->changed = REQUEST_TIME;
        entity_save('dntt', $e);
      }
    }

    return array(
      'success' => TRUE,
      'lo_count' => count($lo_ids),
      'dntt_count' => count($dntt_ids),
      'lo_ids' => $lo_ids,
    );
  }
  catch (Exception $ex) {
    $transaction->rollback();
    watchdog('crm_dntt', 'Batch create-lo failed: @msg', array('@msg' => $ex->getMessage()), WATCHDOG_ERROR);
    return _crm_dntt_json_error('Lỗi hệ thống khi tạo lô: ' . $ex->getMessage());
  }
}

/*******************************************************************************
 * API: LÔ DNTT WORKFLOW (Issue 08)
 ******************************************************************************/

/**
 * Shared cascade: transition lô + all child DNTT atomically.
 *
 * @param int $lo_dntt_id
 * @param string $expected_status  Current lô status required.
 * @param string $new_lo_status    New lô status.
 * @param string $new_dntt_status  New status for all child DNTT.
 * @param array $meta_fields       Extra fields to set on lô (nguoi_duyet, ngay_duyet, etc.).
 * @param bool $detach_dntt        If TRUE, also set dntt.lo_dntt_id = NULL (for reject flows).
 */
function crm_dntt_lo_transition($lo_dntt_id, $expected_status, $new_lo_status, $new_dntt_status, $meta_fields = array(), $detach_dntt = FALSE) {
  $lo_list = entity_load('lo_dntt', array($lo_dntt_id));
  if (empty($lo_list)) {
    return array('success' => FALSE, 'message' => 'Lô DNTT không tồn tại.');
  }
  $lo = reset($lo_list);

  if ($lo->trang_thai !== $expected_status) {
    return array('success' => FALSE, 'message' => 'Lô đang ở trạng thái "' . $lo->trang_thai . '", không thể thực hiện.');
  }

  $dntts = entity_load('dntt', FALSE, array('lo_dntt_id' => $lo_dntt_id));
  $visible_uids = crm_dntt_visible_uids_for_account();
  if ($visible_uids !== FALSE) {
    foreach ($dntts as $dntt) {
      if (!in_array((int) $dntt->uid, $visible_uids)) {
        return array('success' => FALSE, 'message' => 'Bạn không có quyền thao tác toàn bộ DNTT trong lô này.');
      }
    }
  }

  $transaction = db_transaction();
  try {
    $lo->trang_thai = $new_lo_status;
    foreach ($meta_fields as $k => $v) {
      $lo->$k = $v;
    }
    entity_save('lo_dntt', $lo);

    $dntts = entity_load('dntt', FALSE, array('lo_dntt_id' => $lo_dntt_id));
    $count = 0;
    $approved_at = !empty($meta_fields['ngay_duyet']) ? (int) $meta_fields['ngay_duyet'] : REQUEST_TIME;
    foreach ($dntts as $d) {
      $d->trang_thai = $new_dntt_status;
      $d->changed = REQUEST_TIME;
      if ($detach_dntt) {
        $d->lo_dntt_id = NULL;
      }
      entity_save('dntt', $d);

      if ($new_dntt_status === 'da_duyet') {
        module_invoke_all('dntt_approved', crm_dntt_build_approved_event($d, $approved_at));
      }

      $count++;
    }

    return array('success' => TRUE, 'lo_dntt_id' => $lo_dntt_id, 'dntt_count' => $count);
  }
  catch (Exception $ex) {
    $transaction->rollback();
    watchdog('crm_dntt', 'Lo transition failed: @msg', array('@msg' => $ex->getMessage()), WATCHDOG_ERROR);
    return _crm_dntt_json_error('Lỗi hệ thống: ' . $ex->getMessage());
  }
}

/**
 * Build payload sự kiện DNTT đã duyệt cho sổ cái công nợ lắng nghe.
 *
 * Boundary một chiều (ADR-0006): crm_dntt chỉ mô tả "DNTT này đã duyệt" kèm
 * dòng chi tiết theo nguyên tệ; cong_no tự quyết cách ghi bút toán phải trả.
 *
 * @param object $dntt
 *   Entity DNTT vừa chuyển sang da_duyet.
 * @param int $approved_at
 *   Mốc thời gian duyệt.
 *
 * @return array
 *   Payload sự kiện dntt_approved.
 */
function crm_dntt_build_approved_event($dntt, $approved_at) {
  $rows = db_select('dntt_chi_tiet', 'ct')
    ->fields('ct', array('loai_tien', 'tien_sau_vat', 'tien_sau_vat_vnd'))
    ->condition('dntt_id', (int) $dntt->dntt_id)
    ->execute()
    ->fetchAll();

  $lines = array();
  foreach ($rows as $row) {
    $lines[] = array(
      'loai_tien' => !empty($row->loai_tien) ? $row->loai_tien : 'VND',
      'tien_sau_vat' => $row->tien_sau_vat,
      'tien_sau_vat_vnd' => $row->tien_sau_vat_vnd,
    );
  }

  return array(
    'dntt_id' => (int) $dntt->dntt_id,
    'doi_tac_nhan_tien_id' => (int) $dntt->doi_tac_nhan_tien_id,
    // Để sổ cái biết duyệt này là phát sinh (thanh_toan/hoan_ve) hay điều chỉnh
    // — cong_no tự quyết dấu bút toán (ADR-0011). Đối xứng phía thu.
    'loai_dntt' => isset($dntt->loai_dntt) ? $dntt->loai_dntt : 'thanh_toan',
    'dntt_goc_id' => !empty($dntt->dntt_goc_id) ? (int) $dntt->dntt_goc_id : NULL,
    'ti_gia' => isset($dntt->ti_gia) ? $dntt->ti_gia : '1.0000',
    'ngay_duyet' => (int) $approved_at,
    'lines' => $lines,
  );
}

function crm_dntt_lo_approve() {
  global $user;
  $input = _crm_dntt_input();
  if (empty($input['lo_dntt_id'])) {
    return _crm_dntt_json_error('lo_dntt_id bắt buộc.');
  }
  return crm_dntt_lo_transition(
    (int) $input['lo_dntt_id'],
    'cho_duyet',
    'da_duyet',
    'da_duyet',
    array('nguoi_duyet' => $user->uid, 'ngay_duyet' => REQUEST_TIME)
  );
}

function crm_dntt_lo_reject() {
  $input = _crm_dntt_input();
  if (empty($input['lo_dntt_id'])) {
    return _crm_dntt_json_error('lo_dntt_id bắt buộc.');
  }
  return crm_dntt_lo_transition(
    (int) $input['lo_dntt_id'],
    'cho_duyet',
    'tu_choi',
    'tu_choi',
    array(),
    TRUE
  );
}

function crm_dntt_lo_approve_payment() {
