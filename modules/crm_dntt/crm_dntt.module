/**
 * Load một include của module crm_dntt.
 *
 * @param string $name
 *   Tên include không kèm tiền tố module, ví dụ 'service'.
 */
function _crm_dntt_load_include($name) {
  module_load_include('inc', 'crm_dntt', 'includes/crm_dntt.' . $name);
}

/**
 * Implements hook_entity_info().
 */
function crm_dntt_entity_info() {
  $info = array();

  $info['dntt'] = array(
    'label' => t('DNTT'),
    'entity class' => 'Entity',
    'controller class' => 'DnttController',
    'base table' => 'dntt',
    'entity keys' => array(
      'id' => 'dntt_id',
      'label' => 'so_dntt',
    ),
    'module' => 'crm_dntt',
  );

  $info['dntt_chi_tiet'] = array(
    'label' => t('DNTT Chi tiết'),
    'entity class' => 'Entity',
    'controller class' => 'EntityAPIController',
    'base table' => 'dntt_chi_tiet',
    'entity keys' => array(
      'id' => 'chi_tiet_id',
    ),
    'module' => 'crm_dntt',
  );

  $info['lo_dntt'] = array(
    'label' => t('Lô DNTT'),
    'entity class' => 'Entity',
    'controller class' => 'EntityAPIController',
    'base table' => 'lo_dntt',
    'entity keys' => array(
      'id' => 'lo_dntt_id',
      'label' => 'so_lo',
    ),
    'module' => 'crm_dntt',
  );

  return $info;
}

