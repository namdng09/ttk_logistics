function crm_dntt_lo_account_is_admin($account = NULL) {
  if (!$account) {
    global $user;
    $account = $user;
  }

  if (empty($account->uid)) {
    return FALSE;
  }
  if ((int) $account->uid === 1) {
    return TRUE;
  }
  if (user_access('administer site configuration', $account)) {
    return TRUE;
  }

  return !empty($account->roles) && in_array('administrator', $account->roles);
}

function crm_dntt_lo_recall_batch($lo_dntt_id, $account = NULL) {
  if (!$account) {
    global $user;
    $account = $user;
  }

  $lo_list = entity_load('lo_dntt', array($lo_dntt_id));
  if (empty($lo_list)) {
    return _crm_dntt_json_error('Lô DNTT không tồn tại.');
  }
  $lo = reset($lo_list);

  if ($lo->trang_thai !== 'cho_duyet') {
    return _crm_dntt_json_error('Lô DNTT không còn ở trạng thái Chờ duyệt nên không thể thu hồi.');
  }

  $is_submitter = !empty($account->uid) && (int) $lo->nguoi_trinh === (int) $account->uid;
  if (!$is_submitter && !crm_dntt_lo_account_is_admin($account)) {
    return _crm_dntt_json_error('Bạn không có quyền thu hồi lô DNTT này.');
  }

  $transaction = db_transaction();
  try {
    $dntts = entity_load('dntt', FALSE, array('lo_dntt_id' => $lo_dntt_id));
    $count = 0;
    foreach ($dntts as $dntt) {
      $dntt->trang_thai = 'moi';
      $dntt->lo_dntt_id = NULL;
      $dntt->changed = REQUEST_TIME;
      entity_save('dntt', $dntt);
      $count++;
    }

    entity_delete('lo_dntt', $lo_dntt_id);

    return array('success' => TRUE, 'lo_dntt_id' => $lo_dntt_id, 'dntt_count' => $count);
  }
  catch (Exception $ex) {
    $transaction->rollback();
    watchdog('crm_dntt', 'Recall lo DNTT failed: @msg', array('@msg' => $ex->getMessage()), WATCHDOG_ERROR);
    return _crm_dntt_json_error('Lỗi hệ thống khi thu hồi lô: ' . $ex->getMessage());
  }
}

function crm_dntt_lo_recall() {
  global $user;
  $input = _crm_dntt_input();
  if (empty($input['lo_dntt_id'])) {
    return _crm_dntt_json_error('lo_dntt_id bắt buộc.');
  }

  return crm_dntt_lo_recall_batch((int) $input['lo_dntt_id'], $user);
}

function crm_dntt_lo_remove_dntt() {
  $input = _crm_dntt_input();
  if (empty($input['lo_dntt_id']) || empty($input['dntt_id'])) {
    return _crm_dntt_json_error('lo_dntt_id và dntt_id bắt buộc.');
  }

  $lo_id = (int) $input['lo_dntt_id'];
  $dntt_id = (int) $input['dntt_id'];

  $lo_list = entity_load('lo_dntt', array($lo_id));
  if (empty($lo_list)) {
    return _crm_dntt_json_error('Lô DNTT không tồn tại.');
  }
  $lo = reset($lo_list);

  if (!in_array($lo->trang_thai, array('cho_duyet', 'da_duyet'))) {
    return _crm_dntt_json_error('Lô đang ở trạng thái "' . $lo->trang_thai . '", không thể gỡ DNTT.');
  }

  $dntt_list = entity_load('dntt', array($dntt_id));
  if (empty($dntt_list)) {
    return _crm_dntt_json_error('DNTT không tồn tại.');
  }
  $dntt = reset($dntt_list);

  if ((int) $dntt->lo_dntt_id !== $lo_id) {
    return _crm_dntt_json_error('DNTT không thuộc lô này.');
  }

  $transaction = db_transaction();
  try {
    $dntt->lo_dntt_id = NULL;
    $dntt->trang_thai = 'moi';
    $dntt->changed = REQUEST_TIME;
    entity_save('dntt', $dntt);

    $remaining = db_query(
      "SELECT COUNT(*) FROM {dntt} WHERE lo_dntt_id = :lo_id",
      array(':lo_id' => $lo_id)
    )->fetchField();

    $lo_deleted = FALSE;
    if ($remaining == 0) {
      entity_delete('lo_dntt', $lo_id);
      $lo_deleted = TRUE;
    }
    else {
      $new_total = db_query(
        "SELECT COALESCE(SUM(tong_tien), 0) FROM {dntt} WHERE lo_dntt_id = :lo_id",
        array(':lo_id' => $lo_id)
      )->fetchField();
      $lo->tong_tien = $new_total;
      entity_save('lo_dntt', $lo);
    }

    return array('success' => TRUE, 'lo_deleted' => $lo_deleted, 'remaining_count' => (int) $remaining);
  }
  catch (Exception $ex) {
    $transaction->rollback();
    watchdog('crm_dntt', 'Remove DNTT from lo failed: @msg', array('@msg' => $ex->getMessage()), WATCHDOG_ERROR);
    return _crm_dntt_json_error('Lỗi hệ thống: ' . $ex->getMessage());
  }
}

/**
 * GET /api/lo-dntt/list?trang_thai=cho_duyet&page=1
 */
function crm_dntt_lo_api_list() {
  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = 20;
  $offset = ($page - 1) * $limit;
  $tab = isset($_GET['tab']) ? $_GET['tab'] : '';
  $trang_thai = isset($_GET['trang_thai']) ? $_GET['trang_thai'] : '';

  // Tab → trạng thái mặc định (chỉ để lọc hiển thị, không chặn quyền xem;
  // quyền thực thi nằm ở các action endpoint approve/pay).
  $tab_status = array(
    'approve' => 'cho_duyet',
    'payment_approve' => 'da_duyet',
    'pay' => 'cho_thanh_toan',
  );
  if (isset($tab_status[$tab]) && $trang_thai === '') {
    $trang_thai = $tab_status[$tab];
  }

  $query = db_select('lo_dntt', 'l');
  $query->fields('l');

  if ($trang_thai !== '') {
    $query->condition('l.trang_thai', $trang_thai);
  }

  $visible_uids = crm_dntt_visible_uids_for_account();
  if ($visible_uids !== FALSE) {
    if (empty($visible_uids)) {
      $query->where('1 = 0');
    }
    else {
      $visible_lo_subquery = db_select('dntt', 'd_vis')
        ->fields('d_vis', array('lo_dntt_id'))
        ->condition('d_vis.uid', $visible_uids, 'IN')
        ->isNotNull('d_vis.lo_dntt_id');
      $query->condition('l.lo_dntt_id', $visible_lo_subquery, 'IN');
    }
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('l.lo_dntt_id', 'DESC');
  $query->range($offset, $limit);
  $los = $query->execute()->fetchAll();

  if (empty($los)) {
    return array('data' => array(), 'total' => 0, 'page' => $page, 'pages' => 0);
  }

  $lo_ids = array();
  $dt_nids = array();
  $user_uids = array();
  foreach ($los as $l) {
    $lo_ids[] = $l->lo_dntt_id;
    $dt_nids[$l->doi_tac_nhan_tien_id] = $l->doi_tac_nhan_tien_id;
    $user_uids[$l->nguoi_trinh] = $l->nguoi_trinh;
  }

  $dt_names = array();
  if ($dt_nids) {
    $result = db_select('node', 'n')
      ->fields('n', array('nid', 'title'))
      ->condition('nid', $dt_nids, 'IN')
      ->execute();
    foreach ($result as $n) {
      $dt_names[$n->nid] = $n->title;
    }
  }

  $user_names = array();
  if ($user_uids) {
    $result = db_select('users', 'u')
      ->fields('u', array('uid', 'name'))
      ->condition('uid', $user_uids, 'IN')
      ->execute();
    foreach ($result as $u) {
      $user_names[$u->uid] = $u->name;
    }
  }

  $dntts_by_lo = array();
  $dntt_query = db_select('dntt', 'd')
    ->fields('d', array('dntt_id', 'lo_dntt_id', 'so_dntt', 'tong_tien', 'trang_thai'))
    ->condition('d.lo_dntt_id', $lo_ids, 'IN')
    ->orderBy('d.dntt_id');
  crm_dntt_apply_uid_visibility($dntt_query, 'd');
  $dntt_rows = $dntt_query->execute();
  foreach ($dntt_rows as $dr) {
    $dntts_by_lo[$dr->lo_dntt_id][] = $dr;
  }

  foreach ($los as &$l) {
    $l->doi_tac_nhan_tien_ten = isset($dt_names[$l->doi_tac_nhan_tien_id]) ? $dt_names[$l->doi_tac_nhan_tien_id] : '';
    $l->nguoi_trinh_ten = isset($user_names[$l->nguoi_trinh]) ? $user_names[$l->nguoi_trinh] : '';
    $l->dntts = isset($dntts_by_lo[$l->lo_dntt_id]) ? $dntts_by_lo[$l->lo_dntt_id] : array();
    $l->dntt_count = count($l->dntts);
  }

  return array(
    'data' => $los,
    'total' => (int) $total,
    'page' => $page,
    'pages' => ceil($total / $limit),
  );
}

/*******************************************************************************
 * API: DNTT HEADER (Issue 02)
 ******************************************************************************/

/**
 * Cửa ghi header DNTT (tạo mới, hoặc sửa của trang /quan-ly/dntt VÀ bảng DNTT
 * của tab Chi phí trong modal đơn hàng, ticket 05/ADR-0016).
 *
 * @param array|null $input
 *   Payload; NULL (mặc định, cách hook_menu gọi) thì đọc thân request. Truyền
 *   tường minh để test được — cùng lý do với `crm_dntt_chi_tiet_api_save()`:
 *   `php://input` rỗng dưới SimpleTest.
 *
 * @return array
 *   Phong bì {success, ...}.
 */
function crm_dntt_api_save($input = NULL) {
  $input = $input === NULL ? _crm_dntt_input() : $input;
  global $user;

  $is_update = !empty($input['dntt_id']);

  if ($is_update) {
    $entities = entity_load('dntt', array($input['dntt_id']));
    if (empty($entities)) {
      return _crm_dntt_json_error('DNTT không tồn tại.');
    }
    $entity = reset($entities);

    if (!crm_dntt_user_can_edit($entity, $user)) {
      return _crm_dntt_json_error('Bạn không có quyền sửa DNTT này.');
    }
    if (!crm_dntt_is_editable($entity->trang_thai)) {
      return _crm_dntt_json_error('DNTT ở trạng thái "' . $entity->trang_thai . '", không thể sửa.');
    }

    // Ticket 05 (ADR-0016): "Hạn thanh toán" bắt buộc khi sửa header từ bảng
    // DNTT của tab Chi phí — CHỈ kiểm khi lượt gọi có gửi khoá này (client
    // luôn gửi cả bốn field sửa nhanh cùng lúc), không chặn lượt sửa các field
    // khác mà không đụng tới ô này.
    if (array_key_exists('han_thanh_toan', $input) && empty($input['han_thanh_toan'])) {
      return _crm_dntt_json_error('Hạn thanh toán bắt buộc.');
    }

    $old_ti_gia = isset($entity->ti_gia) ? (float) $entity->ti_gia : 1;
    $fields = array(
      'ben_phat_hanh_id', 'doi_tac_nhan_tien_id', 'so_hoa_don',
      'ngay_hoa_don', 'no_hoa_don', 'hinh_thuc_tt', 'han_thanh_toan',
      'ti_gia',
    );
    foreach ($fields as $f) {
      if (array_key_exists($f, $input)) {
        $entity->$f = $input[$f];
      }
    }
    $entity->changed = REQUEST_TIME;
    entity_save('dntt', $entity);

    if (isset($input['ti_gia']) && (float) $input['ti_gia'] != $old_ti_gia) {
      crm_dntt_recalculate_chi_tiet_converted($entity->dntt_id);
    }

    return array('success' => TRUE, 'dntt_id' => $entity->dntt_id, 'so_dntt' => $entity->so_dntt);
  }

  // --- Create ---
  _crm_dntt_load_include('service');
  $created = crm_dntt_service_create_dntt(array(
    'loai_dntt' => isset($input['loai_dntt']) ? $input['loai_dntt'] : 'thanh_toan',
    'dntt_goc_id' => isset($input['dntt_goc_id']) ? $input['dntt_goc_id'] : NULL,
    'ben_phat_hanh_id' => isset($input['ben_phat_hanh_id']) ? $input['ben_phat_hanh_id'] : 0,
    'doi_tac_nhan_tien_id' => isset($input['doi_tac_nhan_tien_id']) ? $input['doi_tac_nhan_tien_id'] : 0,
    'so_hoa_don' => isset($input['so_hoa_don']) ? $input['so_hoa_don'] : NULL,
    'ngay_hoa_don' => isset($input['ngay_hoa_don']) ? $input['ngay_hoa_don'] : NULL,
    'no_hoa_don' => isset($input['no_hoa_don']) ? $input['no_hoa_don'] : 0,
    'hinh_thuc_tt' => isset($input['hinh_thuc_tt']) ? $input['hinh_thuc_tt'] : 'CK',
    'han_thanh_toan' => isset($input['han_thanh_toan']) ? $input['han_thanh_toan'] : NULL,
    'ti_gia' => isset($input['ti_gia']) ? $input['ti_gia'] : 1,
  ));
  if (empty($created['success'])) {
    return _crm_dntt_json_error($created['message']);
  }

  return array('success' => TRUE, 'dntt_id' => $created['dntt_id'], 'so_dntt' => $created['so_dntt']);
}

function crm_dntt_api_get($dntt_id) {
  $dntt_id = (int) $dntt_id;
  $entities = entity_load('dntt', array($dntt_id));
  if (empty($entities)) {
    return _crm_dntt_json_error('DNTT không tồn tại.');
  }
  $entity = reset($entities);
  // ADR-0003: mọi user đăng nhập xem được mọi DNTT (minh bạch vận hành).
  // Quyền sửa gate riêng qua crm_dntt_user_can_edit ở save/delete/transition.

  $data = (array) $entity;

  $bph = node_load($entity->ben_phat_hanh_id);
  $data['ben_phat_hanh_ten'] = $bph ? $bph->title : '';
  $data['ben_phat_hanh_mst'] = '';
  if ($bph) {
    $w = entity_metadata_wrapper('node', $bph);
    try { $data['ben_phat_hanh_mst'] = $w->field_ma_so_thue->value(); } catch (Exception $e) {}
  }

  $dtntt = node_load($entity->doi_tac_nhan_tien_id);
  $data['doi_tac_nhan_tien_ten'] = $dtntt ? $dtntt->title : '';

  // Hoàn về / Điều chỉnh: resolve gốc → link ngược về chứng từ gốc.
  if (($entity->loai_dntt === 'hoan_ve' || $entity->loai_dntt === 'dieu_chinh') && !empty($entity->dntt_goc_id)) {
    $goc = db_query(
      "SELECT so_dntt FROM {dntt} WHERE dntt_id = :id",
      array(':id' => $entity->dntt_goc_id)
    )->fetchField();
    $data['dntt_goc_so_dntt'] = $goc ? $goc : '';
  }

  $hoan_rows = db_query(
    "SELECT dntt_id, so_dntt FROM {dntt} WHERE dntt_goc_id = :id AND loai_dntt = 'hoan_ve'",
    array(':id' => $dntt_id)
  )->fetchAll();
  $data['dntt_hoan_ve'] = array();
  foreach ($hoan_rows as $hr) {
    $data['dntt_hoan_ve'][] = array('dntt_id' => $hr->dntt_id, 'so_dntt' => $hr->so_dntt);
  }

  // Các DNTT điều chỉnh con của gốc này (nhiều lần — ADR-0011), kèm trạng thái
  // để UI phân biệt nháp/đã duyệt.
  $dc_rows = db_query(
    "SELECT dntt_id, so_dntt, trang_thai FROM {dntt} WHERE dntt_goc_id = :id AND loai_dntt = 'dieu_chinh'",
    array(':id' => $dntt_id)
  )->fetchAll();
  $data['dntt_dieu_chinh'] = array();
  foreach ($dc_rows as $dr) {
    $data['dntt_dieu_chinh'][] = array('dntt_id' => $dr->dntt_id, 'so_dntt' => $dr->so_dntt, 'trang_thai' => $dr->trang_thai);
  }

  // Issue 07: trạng thái thanh toán dẫn xuất từ cong_no (không lưu cờ da_tt).
  // UI dùng co_the_tao_hoan_ve để quyết định hiện nút "Tạo DNTT hoàn về".
  $da_tra_du = ($entity->loai_dntt !== 'hoan_ve') ? crm_dntt_is_fully_paid($dntt_id) : FALSE;
  $data['thanh_toan_da_tra_du'] = $da_tra_du;
  $data['co_the_tao_hoan_ve'] = ($entity->loai_dntt !== 'hoan_ve' && $da_tra_du && empty($data['dntt_hoan_ve']));

  // Điều chỉnh (ADR-0011): chỉ từ DNTT thanh toán đã ghi nợ và còn phần điều
  // chỉnh > 0 ở ít nhất một nguyên tệ (đã trừ các điều chỉnh đã duyệt trước đó).
  $co_the_tao_dieu_chinh = FALSE;
  if ($entity->loai_dntt === 'thanh_toan') {
    foreach (crm_dntt_get_dieu_chinh_remaining($dntt_id) as $r) {
      if ($r > 0.00001) {
        $co_the_tao_dieu_chinh = TRUE;
        break;
      }
    }
  }
  $data['co_the_tao_dieu_chinh'] = $co_the_tao_dieu_chinh;

  return array('success' => TRUE, 'data' => $data);
}

function crm_dntt_api_delete() {
  $input = _crm_dntt_input();
  if (empty($input['dntt_id'])) {
    return _crm_dntt_json_error('dntt_id bắt buộc.');
  }

  $entities = entity_load('dntt', array($input['dntt_id']));
  if (empty($entities)) {
    return _crm_dntt_json_error('DNTT không tồn tại.');
  }
  $entity = reset($entities);

  if (!crm_dntt_user_can_edit($entity)) {
    return _crm_dntt_json_error('Bạn không có quyền xóa DNTT này.');
  }
  if (!crm_dntt_is_editable($entity->trang_thai)) {
    return _crm_dntt_json_error('DNTT ở trạng thái "' . $entity->trang_thai . '", không thể xóa.');
  }

  entity_delete('dntt', $entity->dntt_id);
  return array('success' => TRUE);
}

function crm_dntt_api_list() {
  global $user;

  $page = isset($_GET['page']) ? max(1, (int) $_GET['page']) : 1;
  $limit = 20;
  $offset = ($page - 1) * $limit;

  $query = db_select('dntt', 'd');
  $query->fields('d');

  // Ticket 05 (ADR-0016): lọc theo lô hàng — bảng "Đề nghị thanh toán (DNTT)"
  // của tab Chi phí trong modal đơn hàng dùng chính tham số này, không viết
  // endpoint mới. Một DNTT có dòng thuộc lô này thì DNTT đó vào danh sách.
  $lo_hang_nid = !empty($_GET['lo_hang_nid']) ? (int) $_GET['lo_hang_nid'] : 0;
  if ($lo_hang_nid) {
    $query->where(
      "EXISTS (SELECT 1 FROM {dntt_chi_tiet} ct_lo_filter WHERE ct_lo_filter.dntt_id = d.dntt_id AND ct_lo_filter.lo_hang_nid = :lo_hang_nid)",
      array(':lo_hang_nid' => $lo_hang_nid)
    );
  }
  else {
    // Phân quyền xem giống views_query_modifier — CHỈ khi KHÔNG lọc theo lô:
    // lọc theo lô là bề mặt jobfile-centric của ADR-0003 (như
    // crm_dntt_chi_phi_lo_hang(), không scope theo uid), còn danh sách chung
    // ở trang /quan-ly/dntt vẫn theo đúng phân quyền cũ. Nhân viên xem của
    // mình; trưởng nhóm xem mình + thành viên nhóm; giám đốc xem tất cả.
    crm_dntt_apply_uid_visibility($query, 'd', $user);
  }

  if (!empty($_GET['trang_thai'])) {
    $query->condition('d.trang_thai', $_GET['trang_thai']);
  }
  if (!empty($_GET['doi_tac_nhan_tien_id'])) {
    $query->condition('d.doi_tac_nhan_tien_id', (int) $_GET['doi_tac_nhan_tien_id']);
  }
  if (!empty($_GET['loai_dntt'])) {
    $query->condition('d.loai_dntt', $_GET['loai_dntt']);
  }
  if (!empty($_GET['loai_tien']) && in_array($_GET['loai_tien'], array('VND', 'USD'))) {
    $query->where("EXISTS (SELECT 1 FROM {dntt_chi_tiet} ct_currency_filter WHERE ct_currency_filter.dntt_id = d.dntt_id AND ct_currency_filter.loai_tien = :loai_tien)", array(':loai_tien' => $_GET['loai_tien']));
  }

  $count = clone $query;
  $total = $count->countQuery()->execute()->fetchField();

  $query->orderBy('d.dntt_id', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  if (empty($rows)) {
    return array('data' => array(), 'total' => 0, 'page' => $page, 'pages' => 0);
  }

  $dntt_ids = array();
  $nids = array();
  $uids = array();
  foreach ($rows as $r) {
    $dntt_ids[] = $r->dntt_id;
    $nids[$r->doi_tac_nhan_tien_id] = $r->doi_tac_nhan_tien_id;
    $nids[$r->ben_phat_hanh_id] = $r->ben_phat_hanh_id;
    $uids[$r->uid] = $r->uid;
  }

  $node_names = array();
  if ($nids) {
    $result = db_select('node', 'n')
      ->fields('n', array('nid', 'title'))
      ->condition('nid', $nids, 'IN')
      ->execute();
    foreach ($result as $n) {
      $node_names[$n->nid] = $n->title;
    }
  }

  $user_names = array();
  if ($uids) {
    $result = db_select('users', 'u')
      ->fields('u', array('uid', 'name'))
      ->condition('uid', $uids, 'IN')
      ->execute();
    foreach ($result as $u) {
      $user_names[$u->uid] = $u->name;
    }
  }

  $chi_tiet_map = array();
  $ct_rows = db_query("
    SELECT ct.dntt_id, COUNT(*) AS ct_count,
           GROUP_CONCAT(DISTINCT lcp.ten ORDER BY lcp.ten SEPARATOR ', ') AS loai_phi_list,
           MAX(CASE WHEN ct.loai_tien = 'VND' THEN 1 ELSE 0 END) AS has_vnd,
           MAX(CASE WHEN ct.loai_tien = 'USD' THEN 1 ELSE 0 END) AS has_usd
    FROM {dntt_chi_tiet} ct
    LEFT JOIN {loai_chi_phi} lcp ON ct.loai_chi_phi_id = lcp.id
    WHERE ct.dntt_id IN (:ids)
    GROUP BY ct.dntt_id
  ", array(':ids' => $dntt_ids));
  foreach ($ct_rows as $ct) {
    $chi_tiet_map[$ct->dntt_id] = $ct;
  }

  // Ticket 05: "Số dòng"/"Quy đổi VND" của bảng DNTT trong tab Chi phí phải
  // tính CHỈ trên các dòng thuộc LÔ ĐANG MỞ, không phải tổng toàn DNTT — một
  // DNTT về nguyên tắc có thể mang dòng của nhiều lô hàng (`lo_hang_nid` là
  // field của DÒNG, không của header). Tách riêng khỏi `chi_tiet_count` ở
  // trên (tổng toàn DNTT, dùng cho trang /quan-ly/dntt) để không đổi hành vi
  // đang chạy của trang đó.
  $lo_scope_map = array();
  if ($lo_hang_nid) {
    $lo_rows = db_query("
      SELECT dntt_id, COUNT(*) AS so_dong, COALESCE(SUM(tien_sau_vat_vnd), 0) AS quy_doi_vnd
      FROM {dntt_chi_tiet}
      WHERE dntt_id IN (:ids) AND lo_hang_nid = :lo_hang_nid
      GROUP BY dntt_id
    ", array(':ids' => $dntt_ids, ':lo_hang_nid' => $lo_hang_nid));
    foreach ($lo_rows as $lr) {
      $lo_scope_map[$lr->dntt_id] = $lr;
    }
  }

  foreach ($rows as &$r) {
    $r->doi_tac_nhan_tien_ten = isset($node_names[$r->doi_tac_nhan_tien_id]) ? $node_names[$r->doi_tac_nhan_tien_id] : '';
    $r->ben_phat_hanh_ten = isset($node_names[$r->ben_phat_hanh_id]) ? $node_names[$r->ben_phat_hanh_id] : '';
    $r->nguoi_tao_ten = isset($user_names[$r->uid]) ? $user_names[$r->uid] : '';
    // Ticket 05 (ADR-0016): bảng DNTT của tab Chi phí sửa nhanh tại chỗ và cần
    // đúng MỘT cờ này — cùng crm_dntt_is_editable() mà cổng ghi dùng, không so
    // chuỗi trạng thái ở client.
    $r->is_editable = crm_dntt_is_editable($r->trang_thai);
    $ct = isset($chi_tiet_map[$r->dntt_id]) ? $chi_tiet_map[$r->dntt_id] : NULL;
    $r->chi_tiet_count = $ct ? (int) $ct->ct_count : 0;
    $r->loai_phi_list = $ct ? $ct->loai_phi_list : '';
    if ($ct && !empty($ct->has_vnd) && !empty($ct->has_usd)) {
      $r->loai_tien = 'VND + USD';
    }
    elseif ($ct && !empty($ct->has_usd)) {
      $r->loai_tien = 'USD';
    }
    else {
      $r->loai_tien = 'VND';
    }

    if ($lo_hang_nid) {
      $lr = isset($lo_scope_map[$r->dntt_id]) ? $lo_scope_map[$r->dntt_id] : NULL;
      $r->so_dong_lo = $lr ? (int) $lr->so_dong : 0;
      $r->quy_doi_vnd_lo = $lr ? (float) $lr->quy_doi_vnd : 0;
    }
  }

  return array(
    'data' => $rows,
    'total' => (int) $total,
    'page' => $page,
    'pages' => ceil($total / $limit),
  );
}

/*******************************************************************************
 * API: DNTT CHI TIẾT (Issue 03)
 ******************************************************************************/

/**
 * Cửa ghi một dòng chi tiết DNTT.
 *
 * @param array|null $input
 *   Payload. NULL (mặc định, và là cách hook_menu gọi) thì đọc thân request qua
 *   `_crm_dntt_input()`. Truyền tường minh để gọi được cửa này ở nơi không có
 *   thân request — `php://input` rỗng dưới SimpleTest, nên không có tham số này
 *   thì phép thử buộc phải đi vòng qua `entity_save()` và bỏ qua đúng phần đáng
 *   đo: cổng trạng thái + phép tính tiền + việc KHÔNG ghi bút toán.
 *
 * @return array
 *   Phong bì {success, ...}.
 */
function crm_dntt_chi_tiet_api_save($input = NULL) {
  $input = $input === NULL ? _crm_dntt_input() : $input;

  if (empty($input['loai_chi_phi_id'])) {
    return _crm_dntt_json_error('loai_chi_phi_id bắt buộc.');
  }

  $is_update = !empty($input['chi_tiet_id']);
  $ct = NULL;
  if ($is_update) {
    $ct_list = entity_load('dntt_chi_tiet', array($input['chi_tiet_id']));
    if (empty($ct_list)) {
      return _crm_dntt_json_error('Chi tiết không tồn tại.');
    }
    $ct = reset($ct_list);
  }

  // ADR-0016: dntt_id KHÔNG còn bắt buộc — thiếu/rỗng/0 = dòng độc lập, chưa
  // gộp vào DNTT nào. Không gửi khoá này ở một lượt update thì giữ nguyên
  // dntt_id hiện có (sửa field khác của một dòng, không đụng chỗ gộp).
  $target_dntt_id = array_key_exists('dntt_id', $input)
    ? (!empty($input['dntt_id']) ? (int) $input['dntt_id'] : NULL)
    : ($ct ? $ct->dntt_id : NULL);

  // Check DNTT exists and is editable — CHỈ khi dòng đang/sẽ thuộc một DNTT
  // thật. Dòng độc lập không có header nào để kiểm và luôn sửa được (chưa ai
  // duyệt gì để khoá).
  $dntt = NULL;
  if ($target_dntt_id !== NULL) {
    $dntt_list = entity_load('dntt', array($target_dntt_id));
    if (empty($dntt_list)) {
      return _crm_dntt_json_error('DNTT không tồn tại.');
    }
    $dntt = reset($dntt_list);
    if (!crm_dntt_is_editable($dntt->trang_thai)) {
      return _crm_dntt_json_error('DNTT ở trạng thái "' . $dntt->trang_thai . '", không thể sửa chi tiết.');
    }
  }

  // NCC của riêng dòng (ADR-0016) — bắt buộc CHỈ khi dòng còn độc lập: đó là
  // chỗ DUY NHẤT giữ NCC lúc chưa có header DNTT nào. Không gửi lại field này
  // ở một lượt update thì giữ giá trị cũ trên dòng.
  $doi_tac_row_id = array_key_exists('doi_tac_nhan_tien_id', $input)
    ? (!empty($input['doi_tac_nhan_tien_id']) ? (int) $input['doi_tac_nhan_tien_id'] : NULL)
    : (($ct && isset($ct->doi_tac_nhan_tien_id)) ? (int) $ct->doi_tac_nhan_tien_id : NULL);
  if ($target_dntt_id === NULL && !$doi_tac_row_id) {
    return _crm_dntt_json_error('Đối tác nhận tiền (NCC) bắt buộc cho dòng chưa gộp vào DNTT.');
  }

  // Auto-fill nhom_chi_phi_id.
  $nhom_id = $input['nhom_chi_phi_id'] ?? NULL;
  if (empty($nhom_id)) {
    $nhom_id = crm_dntt_resolve_nhom_chi_phi($input['loai_chi_phi_id']);
  }
  if (empty($nhom_id)) {
    return _crm_dntt_json_error('Không tìm thấy nhóm chi phí cho loại chi phí đã chọn.');
  }

  // Tỉ giá: của DNTT chứa dòng nếu đã gộp (như cũ). Dòng còn độc lập không có
  // header nào để lấy — dùng `ti_gia` của CHÍNH lượt gọi này (ô "Tỉ giá xem
  // trước" của tab, ADR-0016): số ước tính, không phải tỉ giá chính thức, và
  // KHÔNG lưu vào đâu ngoài việc tính `tien_sau_vat_vnd` của dòng này.
  $rate = $dntt ? (isset($dntt->ti_gia) ? $dntt->ti_gia : 1)
    : (isset($input['ti_gia']) ? (float) $input['ti_gia'] : 1);
  $validation = crm_dntt_validate_chi_tiet_currency_price($input, $rate);
  if (!$validation['success']) {
    return _crm_dntt_json_error($validation['message']);
  }

  // Auto-calculate. USD detail lines use the DNTT header exchange rate.
  $calc = crm_dntt_calculate_chi_tiet($input, $rate);

  $loai_tien = strtoupper((string) $input['loai_tien']) === 'USD' ? 'USD' : 'VND';
  $don_gia = (float) $input['don_gia'];
  $old_dntt_id = NULL;

  if ($is_update) {
    $old_dntt_id = $ct->dntt_id;

    // ADR-0016: cho phép gán lại dntt_id khi update — cửa DUY NHẤT "gộp dòng
    // độc lập vào một DNTT vừa tạo/tìm được" (ticket 04's "Tạo DNTT từ dòng đã
    // chọn"), tái dùng chính cửa này thay vì viết endpoint gộp hàng loạt mới.
    $ct->dntt_id = $target_dntt_id;
    $ct->doi_tac_nhan_tien_id = $doi_tac_row_id;
    $ct->lo_hang_nid = isset($input['lo_hang_nid']) ? $input['lo_hang_nid'] : $ct->lo_hang_nid;
    $ct->nhom_chi_phi_id = $nhom_id;
    $ct->loai_chi_phi_id = $input['loai_chi_phi_id'];
    $ct->don_vi = isset($input['don_vi']) ? $input['don_vi'] : $ct->don_vi;
    $ct->don_gia = $don_gia;
    $ct->loai_tien = $loai_tien;
    $ct->so_luong = isset($input['so_luong']) ? (float) $input['so_luong'] : $ct->so_luong;
    $ct->vat_phan_tram = isset($input['vat_phan_tram']) ? (float) $input['vat_phan_tram'] : $ct->vat_phan_tram;
    $ct->so_tien_vat = $calc['so_tien_vat'];
    $ct->tien_truoc_vat = $calc['tien_truoc_vat'];
    $ct->tien_sau_vat = $calc['tien_sau_vat'];
    $ct->tien_sau_vat_vnd = $calc['tien_sau_vat_vnd'];
    $ct->ghi_chu = isset($input['ghi_chu']) ? $input['ghi_chu'] : $ct->ghi_chu;
    $ct->thu_tu = isset($input['thu_tu']) ? $input['thu_tu'] : $ct->thu_tu;

    entity_save('dntt_chi_tiet', $ct);
  }
  else {
    $ct = entity_create('dntt_chi_tiet', array(
      'dntt_id' => $target_dntt_id,
      'doi_tac_nhan_tien_id' => $doi_tac_row_id,
      'lo_hang_nid' => isset($input['lo_hang_nid']) ? $input['lo_hang_nid'] : NULL,
      'nhom_chi_phi_id' => $nhom_id,
      'loai_chi_phi_id' => $input['loai_chi_phi_id'],
      'don_vi' => isset($input['don_vi']) ? $input['don_vi'] : '',
      'don_gia' => $don_gia,
      'loai_tien' => $loai_tien,
      'so_luong' => isset($input['so_luong']) ? (float) $input['so_luong'] : 1,
      'vat_phan_tram' => isset($input['vat_phan_tram']) ? (float) $input['vat_phan_tram'] : 0,
      'so_tien_vat' => $calc['so_tien_vat'],
      'tien_truoc_vat' => $calc['tien_truoc_vat'],
      'tien_sau_vat' => $calc['tien_sau_vat'],
      'tien_sau_vat_vnd' => $calc['tien_sau_vat_vnd'],
      'ghi_chu' => isset($input['ghi_chu']) ? $input['ghi_chu'] : NULL,
      'thu_tu' => isset($input['thu_tu']) ? $input['thu_tu'] : 0,
    ));
    entity_save('dntt_chi_tiet', $ct);
  }

  // Recalculate header total(s). ADR-0016: dòng độc lập không có header nào
  // để tính — chỉ gọi khi có dntt_id thật. Dòng vừa ĐỔI dntt_id (ticket 04:
  // gộp dòng độc lập vào một DNTT) thì $old_dntt_id luôn NULL trong luồng đó;
  // vẫn recalc cả hai đầu khi khác nhau để đúng cho cả ca tổng quát hơn.
  $tong_tien = NULL;
  if ($target_dntt_id !== NULL) {
    $tong_tien = crm_dntt_recalculate_tong_tien($target_dntt_id);
  }
  if ($old_dntt_id !== NULL && $target_dntt_id !== (int) $old_dntt_id) {
    crm_dntt_recalculate_tong_tien($old_dntt_id);
  }

  return array(
    'success' => TRUE,
    'chi_tiet_id' => $ct->chi_tiet_id,
    'tien_truoc_vat' => $calc['tien_truoc_vat'],
    'so_tien_vat' => $calc['so_tien_vat'],
    'tien_sau_vat' => $calc['tien_sau_vat'],
    'tien_sau_vat_vnd' => $calc['tien_sau_vat_vnd'],
    'dntt_id' => $target_dntt_id,
    'dntt_tong_tien' => $tong_tien,
  );
}

/**
 * Cửa đọc dòng chi tiết của MỘT DNTT — bảng chi tiết trang `quan-ly/dntt/{id}`.
 *
 * Trả `ct.*` thô cộng vài tên đã giải, và đúng MỘT khoá dẫn xuất:
 *
 * - `so_cont` — số container của chuyến đã gom dòng, để người **ký trả tiền**
 *   biết đang trả cho container nào (mỗi cont một mức nâng hạ). Đây là màn của
 *   kế toán, khác chip "Nguồn" ở tab Chi phí trong modal (màn của điều độ/CS) —
 *   nên trang này KHÔNG có khái niệm "nguồn": dòng nhập tay để trống, không dấu
 *   gạch, không chữ "Nhập tay". NULL = chưa biết cont, gộp cả ba nguyên nhân
 *   (dòng nhập tay · chuyến chưa nhập cont · không có bảng trucking) vì cả ba
 *   vẽ ra cùng một ô trống.
 *
 * Cont là NHÃN, không phải thực thể: không cột trên `dntt_chi_tiet`, không cộng
 * chi phí theo cont — đọc sống qua `chuyen_id`. Cùng đường đọc, cùng cặp cửa
 * kiểm, cùng lý do fail-OPEN với `crm_dntt_chi_phi_lo_hang()`; xem docblock hàm
 * đó cho ràng buộc liên module đầy đủ.
 *
 * @return array
 *   Phong bì {success, data} — `data` là mảng dòng, mỗi dòng một stdClass.
 */
function crm_dntt_chi_tiet_api_list() {
  $dntt_id = isset($_GET['dntt_id']) ? (int) $_GET['dntt_id'] : 0;
  if (!$dntt_id) {
    return _crm_dntt_json_error('dntt_id bắt buộc.');
  }

  $dntt_list = entity_load('dntt', array($dntt_id));
  if (empty($dntt_list)) {
    return _crm_dntt_json_error('DNTT không tồn tại.');
  }
  // ADR-0003: xem được mọi DNTT; quyền sửa gate riêng qua crm_dntt_user_can_edit.

  // Số cont — xem docblock hàm. JOIN chỉ dựng khi CẢ HAI mảnh của đường đọc có
  // mặt; thiếu mảnh nào thì cột vắng khỏi hàng vừa fetch và vòng chuẩn hoá bên
  // dưới đọc ra "không biết cont". `db_table_exists()` một mình KHÔNG đủ: mệnh
  // đề `ON` tham chiếu `ct.chuyen_id`, nên thiếu cột thì nó vẫn ném.
  //
  // Alias `chuyen_so_cont` vì `ct.*` đã mang mọi cột của `dntt_chi_tiet`: ngày
  // nào bảng đó có một cột trùng tên thì hai cột chỉ còn một sau driver, và
  // khoá đọc đúng nhưng SAI cột, im lặng.
  $co_cont = db_field_exists('dntt_chi_tiet', 'chuyen_id') && db_table_exists('trucking_chuyen');
  $chon_cont = $co_cont ? ', tc.so_cont AS chuyen_so_cont' : '';
  $join_cont = $co_cont ? 'LEFT JOIN {trucking_chuyen} tc ON tc.chuyen_id = ct.chuyen_id' : '';

  $rows = db_query("
    SELECT ct.*,
           lcp.ten AS loai_chi_phi_ten, lcp.ma AS loai_chi_phi_ma,
           ncp.ten AS nhom_chi_phi_ten,
           COALESCE(jf.field_jobfile_value, n.title) AS lo_hang_ten" . $chon_cont . "
    FROM {dntt_chi_tiet} ct
    LEFT JOIN {loai_chi_phi} lcp ON ct.loai_chi_phi_id = lcp.id
    LEFT JOIN {nhom_chi_phi} ncp ON ct.nhom_chi_phi_id = ncp.id
    LEFT JOIN {node} n ON ct.lo_hang_nid = n.nid
    LEFT JOIN {field_data_field_jobfile} jf ON ct.lo_hang_nid = jf.entity_id AND jf.entity_type = 'node'
    " . $join_cont . "
    WHERE ct.dntt_id = :dntt_id
    ORDER BY ct.thu_tu, ct.chi_tiet_id
  ", array(':dntt_id' => $dntt_id))->fetchAll();

  // Chuẩn hoá thành ĐÚNG MỘT khoá, có mặt trên MỌI dòng. Cố ý không để client
  // đọc thẳng cột JOIN: một khoá VẮNG MẶT (bảng trucking không có) và một khoá
  // NULL (chuyến chưa nhập cont) là hai hình dạng payload khác nhau cho cùng
  // một câu trả lời, và client nào cũng sẽ chỉ nhớ một trong hai. `$r` là
  // handle tới object nên gán trong vòng lặp ghi thẳng vào hàng.
  foreach ($rows as $r) {
    $r->so_cont = property_exists($r, 'chuyen_so_cont') && trim((string) $r->chuyen_so_cont) !== ''
      ? trim($r->chuyen_so_cont)
      : NULL;
    unset($r->chuyen_so_cont);
  }

  return array('success' => TRUE, 'data' => $rows);
}

/**
 * Cửa xoá một dòng chi tiết DNTT.
 *
 * @param array|null $input
 *   Payload; NULL thì đọc thân request. Xem docblock
 *   crm_dntt_chi_tiet_api_save() cho lý do tham số này tồn tại.
 *
 * @return array
 *   Phong bì {success, ...}.
 */
function crm_dntt_chi_tiet_api_delete($input = NULL) {
  $input = $input === NULL ? _crm_dntt_input() : $input;
  if (empty($input['chi_tiet_id'])) {
    return _crm_dntt_json_error('chi_tiet_id bắt buộc.');
  }

  $ct_list = entity_load('dntt_chi_tiet', array($input['chi_tiet_id']));
  if (empty($ct_list)) {
    return _crm_dntt_json_error('Chi tiết không tồn tại.');
  }
  $ct = reset($ct_list);
  $dntt_id = $ct->dntt_id;

  // Check DNTT is editable. ADR-0016: dntt_id NULL = dòng độc lập, không có
  // header nào để kiểm — luôn xoá được (chưa ai duyệt gì để khoá).
  if ($dntt_id !== NULL) {
    $dntt_list = entity_load('dntt', array($dntt_id));
    if (!empty($dntt_list)) {
      $dntt = reset($dntt_list);
      if (!crm_dntt_is_editable($dntt->trang_thai)) {
        return _crm_dntt_json_error('DNTT ở trạng thái "' . $dntt->trang_thai . '", không thể xóa chi tiết.');
      }
    }
  }

  entity_delete('dntt_chi_tiet', $ct->chi_tiet_id);

  $tong_tien = $dntt_id !== NULL ? crm_dntt_recalculate_tong_tien($dntt_id) : NULL;

  return array('success' => TRUE, 'dntt_tong_tien' => $tong_tien);
}

/**
 * Seed: Tạo danh mục Đơn vị tính (chạy 1 lần).
 */
function crm_dntt_seed_don_vi() {
  global $user;
  $don_vi_list = array('Cont', 'CBM', 'Kg', 'Tấn', 'Kiện', 'Lần', 'Chuyến', 'Bộ', 'Cái');
  $created = array();

  foreach ($don_vi_list as $ten) {
    $existing = new EntityFieldQuery();
    $existing->entityCondition('entity_type', 'node')
      ->entityCondition('bundle', 'danh_muc')
      ->propertyCondition('title', $ten)
      ->fieldCondition('field_phan_loai_danh_muc', 'value', 'Đơn vị tính');
    $result = $existing->execute();

    if (!empty($result['node'])) {
      continue;
    }

    $node = new stdClass();
    $node->type = 'danh_muc';
    $node->title = $ten;
    node_object_prepare($node);
    $node->uid = $user->uid;
    $node->status = 1;
    $node->language = LANGUAGE_NONE;
    $node->field_phan_loai_danh_muc[LANGUAGE_NONE][0]['value'] = 'Đơn vị tính';
    $node->field_hoat_dong[LANGUAGE_NONE][0]['value'] = 1;
    node_save($node);
    $created[] = $ten;
  }

  return array('success' => TRUE, 'created' => $created, 'message' => count($created) . ' Đơn vị tính đã tạo.');
}

/**
 * API: Search lô hàng theo jobfile.
 */
function crm_dntt_search_jobfile() {
  while (ob_get_level()) {
    ob_end_clean();
  }

  $q = isset($_GET['term']) ? trim($_GET['term']) : '';
  // ADR-0003 / Issue 01: prefill Jobfile dòng đầu khi tạo DNTT từ đơn hàng win
  // → lookup trực tiếp theo nid (term rỗng). KHÔNG lọc status (node lo_hang
  // custom type thường status=0; lô đang xem chắc chắn tồn tại).
  $nid = isset($_GET['nid']) ? (int) $_GET['nid'] : 0;

  if (empty($q) && !$nid) {
    return array('results' => array());
  }

  $query = db_select('node', 'n');
  $query->fields('n', array('nid', 'title'));
  $query->leftJoin('field_data_field_jobfile', 'jf', 'n.nid = jf.entity_id AND jf.entity_type = :type_jf', array(':type_jf' => 'node'));
  $query->addField('jf', 'field_jobfile_value', 'jobfile');
  $query->condition('n.type', 'lo_hang');

  if ($nid) {
    $query->condition('n.nid', $nid);
  }
  else {
    $like = '%' . db_like($q) . '%';
    $query->condition('n.status', 1);
    $or = db_or()
      ->condition('n.title', $like, 'LIKE')
      ->condition('jf.field_jobfile_value', $like, 'LIKE');
    $query->condition($or);
  }
  $query->range(0, 20);

  $result = $query->execute();

  $results = array();
  foreach ($result as $row) {
    $label = !empty($row->jobfile) ? $row->jobfile : $row->title;
    $results[] = array(
      'id' => $row->nid,
      'text' => $label,
      'jobfile' => isset($row->jobfile) ? $row->jobfile : '',
    );
  }

  return array('results' => $results);
}
