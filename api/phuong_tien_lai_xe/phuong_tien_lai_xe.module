<?php

/**
 * @file
 * REST API cho content type phuong_tien_lai_xe (quan hệ PT-LX).
 * Endpoint prefix: /phuong-tien-lai-xe
 */

module_load_include('inc', 'phuong_tien_lai_xe', 'phuong_tien_lai_xe.helpers');
module_load_include('inc', 'phuong_tien_lai_xe', 'phuong_tien_lai_xe.controller');
module_load_include('inc', 'phuong_tien_lai_xe', 'phuong_tien_lai_xe.service');

function phuong_tien_lai_xe_init() {
  $path = current_path();
  if ($path === 'phuong-tien-lai-xe' || strpos($path, 'phuong-tien-lai-xe/') === 0) {
    ptlx_add_cors_headers();
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      ptlx_cors_preflight();
    }
  }
}

function phuong_tien_lai_xe_menu() {
  $items = array();

  $items['phuong-tien-lai-xe'] = array(
    'title' => 'Danh sách / tạo PT-LX',
    'page callback' => 'phuong_tien_lai_xe_route_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  $items['phuong-tien-lai-xe/%'] = array(
    'title' => 'Chi tiết / cập nhật / xoá PT-LX',
    'page callback' => 'phuong_tien_lai_xe_route_item',
    'page arguments' => array(1),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  return $items;
}
