<?php

/**
 * @file
 * REST API cho content type phuong_tien (phương tiện vận tải).
 * Endpoint prefix: /phuong-tien
 * Drupal tại subdirectory /api/ → URL đầy đủ: https://site.com/api/phuong-tien
 */

module_load_include('inc', 'phuong_tien', 'phuong_tien.helpers');
module_load_include('inc', 'phuong_tien', 'phuong_tien.controller');
module_load_include('inc', 'phuong_tien', 'phuong_tien.service');

/**
 * Implements hook_init().
 * Xử lý CORS preflight sớm.
 */
function phuong_tien_init() {
  $path = current_path();
  if ($path === 'phuong-tien' || strpos($path, 'phuong-tien/') === 0) {
    phuong_tien_add_cors_headers();
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
      phuong_tien_cors_preflight();
    }
  }
}

/**
 * Implements hook_menu().
 */
function phuong_tien_menu() {
  $items = array();

  $items['phuong-tien'] = array(
    'title' => 'Danh sách / tạo phương tiện',
    'page callback' => 'phuong_tien_route_collection',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  $items['phuong-tien/%'] = array(
    'title' => 'Chi tiết / cập nhật / xoá phương tiện',
    'page callback' => 'phuong_tien_route_item',
    'page arguments' => array(1),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  return $items;
}
